/** [F1-8] Circuito completo de alerta cuando alguien reprueba. */
function procesarAlertaCalificacion(datos) {
  const props = PropertiesService.getScriptProperties();
  const emailActivo = props.getProperty("ALERTAS_EMAIL_ACTIVO") === "true";
  const tgActivo = props.getProperty("ALERTAS_TELEGRAM_ACTIVO") === "true";
  const apoyoActivo = props.getProperty("ALERTAS_APOYO_ALUMNO_ACTIVO") !== "false";
  let emailTutor = props.getProperty("ALERTAS_EMAIL_DESTINO");
  if (!emailTutor) { try { emailTutor = Session.getActiveUser().getEmail(); } catch (e) { emailTutor = ""; } }

  if (emailActivo && emailTutor) {
    try { enviarAlertaEmailTutor(emailTutor, datos); } catch (e) { logWarn("Alerta", e.message); }
  }
  if (tgActivo) {
    try { enviarAlertaTelegram(datos); } catch (e) { logWarn("Alerta", e.message); }
  }
  if (apoyoActivo && datos.correo && datos.correo.indexOf("@") !== -1) {
    try {
      enviarEmailApoyoEstudiante(datos, obtenerRecomendacionesEstudio(datos.idFormulario, datos.moduloId || ""));
    } catch (e) { logWarn("Alerta", e.message); }
  }
  enviarNotificacionWebhook(`⚠️ ${datos.estudiante} reprobó ${datos.tituloExamen} (${datos.notaPorcentaje}%)`);
}

