function generarPestanaEstadisticasUso() {
  exigirOrigenInterno("generarPestanaEstadisticasUso");
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const stats = ss.getSheetByName("Estadísticas") || ss.insertSheet("Estadísticas", 2);
  stats.clear();
  stats.activate();

  const log = ss.getSheetByName("_Log_Actividad");
  if (!log || log.getLastRow() < 2) {
    stats.getRange("A1").setValue("Aún no hay actividad registrada en _Log_Actividad.");
    return;
  }

  const datos = log.getDataRange().getValues();
  const acc = {};
  const niveles = {};
  for (let i = 1; i < datos.length; i++) {
    const nivel = datos[i][1] || "INFO";
    const accion = datos[i][3] || datos[i][2];
    if (accion) acc[accion] = (acc[accion] || 0) + 1;
    niveles[nivel] = (niveles[nivel] || 0) + 1;
  }

  stats.getRange("A1:B1").setValues([["Acción del Sistema", "Frecuencia"]])
    .setBackground("#1f2937").setFontColor("#ffffff").setFontWeight("bold");
  const filas = Object.keys(acc).map(k => [k, acc[k]]).sort((a, b) => b[1] - a[1]);
  if (filas.length > 0) stats.getRange(2, 1, filas.length, 2).setValues(filas);

  stats.getRange("D1:E1").setValues([["Nivel de Severidad", "Eventos"]])
    .setBackground("#991b1b").setFontColor("#ffffff").setFontWeight("bold");
  const filasNiv = Object.keys(niveles).map(k => [k, niveles[k]]);
  if (filasNiv.length > 0) stats.getRange(2, 4, filasNiv.length, 2).setValues(filasNiv);

  stats.autoResizeColumns(1, 5);
  notificarUsuario("Estadísticas de actividad actualizadas.", "Analytics", 3);
}

function crearOActualizarGraficoRendimiento() {
  exigirOrigenInterno("crearOActualizarGraficoRendimiento");
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const hoja = ss.getSheetByName("_Historial_Efectividad");
  if (!hoja || hoja.getLastRow() < 3) {
    alertarUsuario("Datos insuficientes en '_Historial_Efectividad' (se requieren al menos 2 auditorías).", "Métricas");
    return;
  }

  hoja.showSheet();
  hoja.getCharts().forEach(g => hoja.removeChart(g));

  const ultimaFila = hoja.getLastRow();
  const chart = hoja.newChart()
    .setChartType(Charts.ChartType.LINE)
    .addRange(hoja.getRange(2, 4, ultimaFila - 1, 1))
    .setNumHeaders(1)
    .setXAxisTitle("Fecha de Auditoría")
    .setXAxisRange(hoja.getRange(2, 1, ultimaFila - 1, 1))
    .setPosition(2, 8, 10, 10)
    .setOption("title", "Evolución de la Tasa de Efectividad (%)")
    .setOption("curveType", "function")
    .setOption("colors", ["#0284c7"])
    .setOption("vAxis", { minValue: 0, maxValue: 100, gridlines: { count: 5 } })
    .setOption("legend", { position: "none" })
    .setOption("width", 750)
    .setOption("height", 400);

  hoja.insertChart(chart.build());
  notificarUsuario("📈 Gráfico de efectividad actualizado.", "Métricas", 4);
}

function generarReporteColaProcesamiento() {
  exigirOrigenInterno("generarReporteColaProcesamiento");
  const hoja = obtenerHojaDatos();
  if (hoja.getLastRow() < 2) { alertarUsuario(t("alert_catalogo_vacio")); return; }

  let totalVideos = 0, pendientesIngesta = 0, pendientesIA = 0, estudiados = 0, descartados = 0, errores = 0;
  const fallas = [];

  iterarCatalogoPorBloques(function (datos, filaInicio) {
    for (let i = 0; i < datos.length; i++) {
      const url = (datos[i][IDX.URL] || "").toString().trim();
      if (!url) continue;
      totalVideos++;
      if (!datos[i][IDX.ID] || !datos[i][IDX.TITULO]) pendientesIngesta++;

      const est = (datos[i][IDX.ESTADO] || "").toString().trim();
      const err = (datos[i][IDX.ERROR] || "").toString().trim();
      if (est === "🟡 Pendiente") pendientesIA++;
      else if (est === "🟢 Estudiado / Aplicado" || est === "⭐ Esencial / Referencia") estudiados++;
      else if (est === "⚪ Descartado") descartados++;
      else if (est === "❌ Error" || err) {
        errores++;
        if (err) fallas.push("• Fila " + (filaInicio + i) + ": " + err.slice(0, 120));
      }
    }
    return false;
  });

  const tasa = totalVideos > 0 ? ((estudiados / totalVideos) * 100) : 0;
  registrarHistoricoEnSheets(totalVideos, estudiados, tasa, errores, pendientesIA);
  registrarHistoricoEnDrive(totalVideos, estudiados, tasa, errores, pendientesIA);

  let report =
    "================================================\n" +
    `📊 DIAGNÓSTICO OPERATIVO DE COLA (${VERSION_SCRIPT})\n` +
    "================================================\n\n" +
    "• Total registros: " + totalVideos + "\n" +
    "• Procesados con éxito: " + estudiados + " (" + tasa.toFixed(2) + "%)\n" +
    "• Ingesta pendiente: " + pendientesIngesta + "\n" +
    "• IA pendiente: " + pendientesIA + "\n" +
    "• Descartados: " + descartados + "\n" +
    "• Errores técnicos: " + errores + "\n" +
    "• Checkpoint activo: " + (PropertiesService.getScriptProperties().getProperty("INGESTA_CHECKPOINT") || "ninguno") + "\n\n";
  if (errores > 0) report += "🚨 Últimos errores:\n" + fallas.slice(-5).join("\n") + "\n";

  alertarUsuario(report, "📋 Reporte Operativo");
}

function registrarHistoricoEnSheets(total, exitosos, tasa, errores, pendientes) {
  exigirOrigenInterno("registrarHistoricoEnSheets");
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let hoja = ss.getSheetByName("_Historial_Efectividad");
  if (!hoja) {
    hoja = ss.insertSheet("_Historial_Efectividad");
    hoja.appendRow(["Fecha y Hora", "Total Registros", "Procesados Exitosos", "Tasa de Efectividad (%)", "Errores Técnicos", "Pendientes IA"]);
    hoja.getRange("A1:F1").setFontWeight("bold").setBackground("#1F4E79").setFontColor("#FFFFFF").setHorizontalAlignment("center");
    hoja.setFrozenRows(1);
    hoja.getRange("A:A").setNumberFormat("yyyy-mm-dd hh:mm:ss");
    hoja.getRange("D:D").setNumberFormat("0.00%");
    hoja.hideSheet();
  }
  hoja.appendRow([new Date(), total, exitosos, tasa / 100, errores, pendientes]);
}

function registrarHistoricoEnDrive(total, exitosos, tasa, errores, pendientes) {
  exigirOrigenInterno("registrarHistoricoEnDrive");
  try {
    const carpeta = obtenerSubcarpeta("Logs_Efectividad");
    const nombre = "historico_efectividad.json";
    const archivos = carpeta.getFilesByName(nombre);
    let datos = [];
    let arch = null;

    if (archivos.hasNext()) {
      arch = archivos.next();
      const txt = arch.getAs("text/plain").getDataAsString();
      if (txt.trim()) datos = JSON.parse(txt);
    }
    datos.push({
      fechaHora: new Date().toISOString(),
      totalRegistros: total,
      procesadosExitosos: exitosos,
      tasaEfectividadPorcentaje: Number(tasa.toFixed(2)),
      erroresTecnicos: errores,
      pendientesIA: pendientes,
      version: VERSION_SCRIPT
    });
    // Conserva solo los últimos 500 puntos para no inflar el archivo.
    if (datos.length > 500) datos = datos.slice(datos.length - 500);

    if (arch) arch.setContent(JSON.stringify(datos, null, 2));
    else carpeta.createFile(nombre, JSON.stringify(datos, null, 2), "application/json");
  } catch (e) {
    logWarn("Histórico", "No se pudo escribir el histórico en Drive: " + e.message);
  }
}

function configurarGA4() {
  exigirOrigenInterno("configurarGA4");
  const ui = SpreadsheetApp.getUi();
  const props = PropertiesService.getScriptProperties();
  const midActual = props.getProperty("GA4_MEASUREMENT_ID") || "ninguno";

  const resp1 = ui.prompt("Google Analytics 4", "Measurement ID (actual: " + midActual + "):", ui.ButtonSet.OK_CANCEL);
  if (resp1.getSelectedButton() !== ui.Button.OK) return;
  const resp2 = ui.prompt("Google Analytics 4", "API Secret (Measurement Protocol):", ui.ButtonSet.OK_CANCEL);
  if (resp2.getSelectedButton() !== ui.Button.OK) return;

  props.setProperty("GA4_MEASUREMENT_ID", resp1.getResponseText().trim());
  props.setProperty("GA4_API_SECRET", resp2.getResponseText().trim());
  notificarUsuario("GA4 configurado correctamente.", "Analytics", 3);
}

