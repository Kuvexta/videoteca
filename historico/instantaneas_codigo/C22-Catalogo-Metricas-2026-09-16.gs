  } catch (e) {
    alertarUsuario("Error: " + e.message, "Certificaciones");
  }
}

// =====================================================================================
// 14.9 ACTIVIDAD RECIENTE, DISPOSITIVOS Y PANEL ÚNICO DE ADMINISTRACIÓN
//
// El encargo era «ver quién está conectado en vivo». Apps Script no puede
// sostener eso: no hay conexión persistente, no hay websocket, no hay latido.
// Lo único que un portal puede hacer es preguntar cada cierto tiempo, y lo único
// que el servidor sabe es CUÁNDO fue la última vez que alguien dejó rastro.
//
// Por eso aquí no se habla de «conectados» sino de ACTIVIDAD RECIENTE: personas
// con una señal en los últimos N minutos, cada una con su marca de tiempo y su
// «hace X minutos». El portal puede así decir la verdad («hace 3 min») en vez de
// pintar un punto verde que fingiría una presencia que nadie está midiendo.
//
// Y por eso tampoco se devuelve la IP ni el user-agent crudo: para administrar
// una capacitación basta con saber desde CUÁNTOS dispositivos entra alguien y de
// qué tipo son. El dato fino se queda en `_Dispositivos_Conocidos`, donde ya
// vive anonimizado; exponerlo al panel solo añadiría vigilancia sin añadir
// gestión.
// =====================================================================================

/** Ventana de actividad por defecto y sus topes. */
const ACTIVIDAD_MINUTOS_DEFECTO = 30;
const ACTIVIDAD_MINUTOS_MIN = 5;      // menos de 5 min solo produciría listas vacías
const ACTIVIDAD_MINUTOS_MAX = 1440;   // un día: más allá ya no es «reciente»
const DISPOSITIVO_RECIENTE_DIAS = 7;

/** Índices 0-based de las hojas que lee esta sección. Nunca números sueltos. */
const PVIS = { CORREO: 0, VIDEO: 1, SEGUNDO: 2, DURACION: 3, PORCENTAJE: 4, ACTUALIZADA: 5, COMPLETADO: 6, ORIGEN: 7 };
const PVIS_COLS = 8;
const DISPO = { CORREO: 0, FINGERPRINT: 1, PRIMERA: 2, ULTIMA: 3, USOS: 4, IP: 5, AGENTE: 6 };
const DISPO_COLS = 7;
const HCAL = { FECHA: 0, ESTUDIANTE: 1, CORREO: 2, EVALUACION: 3, FORM: 4, ACIERTOS: 5,
               MAXIMO: 6, NOTA: 7, ESTADO: 8, CERTIFICADO: 9, MODULO: 10, INTENTO: 11 };
const HCAL_COLS = 12;

/** Umbrales a partir de los cuales el panel considera que hay algo que mirar hoy. */
const PANEL_UMBRAL_SIN_CLASIFICAR = 25;
const PANEL_UMBRAL_SIN_CLASIFICAR_GRAVE = 100;
const PANEL_UMBRAL_COLA = 20;

/**
 * La ventana llega del cliente, así que se acota aquí y no se confía en el
 * portal: un `minutos` disparatado leería medio libro en cada sondeo.
 */
function acotarVentanaActividad(minutos) {
  const n = parseInt(minutos, 10);
  if (!n || isNaN(n)) return ACTIVIDAD_MINUTOS_DEFECTO;
  return Math.min(Math.max(n, ACTIVIDAD_MINUTOS_MIN), ACTIVIDAD_MINUTOS_MAX);
}

/** Milisegundos de una celda de fecha, o 0 si no hay fecha válida. */
function milisegundosDe(valor) {
  if (!valor) return 0;
  try {
    const d = valor instanceof Date ? valor : new Date(valor);
    const ms = d.getTime();
    return isNaN(ms) ? 0 : ms;
  } catch (e) {
    return 0;
  }
}

/**
 * Reduce un user-agent a «marca de navegador · sistema».
 *
 * El user-agent completo es una huella: dice versiones exactas de sistema y de
 * navegador, y sirve para identificar un equipo concreto. Para el panel no hace
 * falta nada de eso — solo distinguir «el portátil del trabajo» de «el móvil» —,
 * así que se recorta aquí, en el servidor, y lo largo no sale nunca de la hoja.
 *
 * El orden de las comprobaciones importa: Edge y Opera se anuncian TAMBIÉN como
 * Chrome, y Chrome se anuncia también como Safari. Hay que ir de lo más
 * específico a lo más genérico o todo el mundo acaba siendo «Chrome».
 */
function etiquetaDispositivo(agente) {
  const ua = (agente || "").toString();
  if (!ua.trim()) return "Desconocido";

  let navegador = "";
  if (/Edg[A-Z]?\//i.test(ua) || /\bEdge\//i.test(ua)) navegador = "Edge";
  else if (/OPR\//i.test(ua) || /\bOpera\//i.test(ua)) navegador = "Opera";
  else if (/SamsungBrowser\//i.test(ua)) navegador = "Samsung Internet";
  else if (/\bFirefox\//i.test(ua) || /\bFxiOS\//i.test(ua)) navegador = "Firefox";
  else if (/\bCriOS\//i.test(ua)) navegador = "Chrome";
  else if (/\bChrome\//i.test(ua) || /\bChromium\//i.test(ua)) navegador = "Chrome";
  else if (/\bSafari\//i.test(ua)) navegador = "Safari";

  let sistema = "";
  if (/\biPhone\b/i.test(ua)) sistema = "iPhone";
  else if (/\biPad\b/i.test(ua)) sistema = "iPad";
  else if (/\bAndroid\b/i.test(ua)) sistema = "Android";
  else if (/\bCrOS\b/i.test(ua)) sistema = "ChromeOS";
  else if (/Windows NT|\bWindows\b/i.test(ua)) sistema = "Windows";
  else if (/Mac OS X|\bMacintosh\b/i.test(ua)) sistema = "macOS";
  else if (/\bLinux\b/i.test(ua)) sistema = "Linux";

  if (navegador && sistema) return navegador + " · " + sistema;
  if (navegador) return navegador;
  if (sistema) return sistema;
  return "Desconocido";
}

/**
 * Dispositivos distintos por correo vistos dentro de una ventana.
 * Devuelve un mapa correo → nº de fingerprints distintos. Se cuenta, no se
 * lista: el panel necesita saber si alguien entra desde tres sitios a la vez,
 * no cuáles son.
 */
function contarDispositivosEnVentana(desdeMs) {
  const conteo = {};
  try {
    const hoja = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("_Dispositivos_Conocidos");
    if (!hoja || hoja.getLastRow() < 2) return conteo;
    const vistos = {};
    hoja.getRange(2, 1, hoja.getLastRow() - 1, DISPO_COLS).getValues().forEach(function (d) {
      const correo = (d[DISPO.CORREO] || "").toString().toLowerCase().trim();
      if (!correo) return;
      if (milisegundosDe(d[DISPO.ULTIMA]) < desdeMs) return;
      const fp = (d[DISPO.FINGERPRINT] || "").toString().trim() || "sin-huella";
      if (!vistos[correo]) vistos[correo] = {};
      if (vistos[correo][fp]) return;
      vistos[correo][fp] = true;
      conteo[correo] = (conteo[correo] || 0) + 1;
    });
  } catch (e) {
    logWarn("Actividad", "No se pudieron contar dispositivos: " + e.message);
  }
  return conteo;
}

/**
 * Intentos EN_CURSO por correo. Es lo que permite decir «está examinándose» sin
 * inventar un estado nuevo: la hoja `_Intentos` ya lo sabe.
 * Devuelve mapa correo → { moduloId, inicioMs }.
 */
function examenesEnCursoPorCorreo() {
  const abiertos = {};
  try {
    const hoja = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("_Intentos");
    if (!hoja || hoja.getLastRow() < 2) return abiertos;
    hoja.getRange(2, 1, hoja.getLastRow() - 1, INT_COLS).getValues().forEach(function (t) {
      if ((t[INT.ESTADO] || "").toString().trim() !== ESTADO_INTENTO.EN_CURSO) return;
      const correo = (t[INT.EMAIL] || "").toString().toLowerCase().trim();
      if (!correo) return;
      const inicioMs = milisegundosDe(t[INT.INICIO]);
      // Si alguien tuviera dos intentos abiertos (no debería), manda el último.
      if (abiertos[correo] && abiertos[correo].inicioMs >= inicioMs) return;
      abiertos[correo] = { moduloId: (t[INT.MODULO] || "").toString().trim(), inicioMs: inicioMs };
    });
  } catch (e) {
    logWarn("Actividad", "No se pudieron leer los intentos en curso: " + e.message);
  }
  return abiertos;
}

/**
 * [ADMIN] Quién ha dejado señal en los últimos `minutos` y sobre qué contenido.
 *
 * Una persona aparece UNA sola vez aunque tenga muchas filas de progreso: lo que
 * interesa administrar es la persona, no la fila. Su señal es la más reciente de
 * las que tenga, y `haceMinutos` viaja calculado desde el servidor para que el
 * portal no dependa del reloj del navegador.
 *
 * Un examen en curso también es una señal: quien está examinándose está activo
 * aunque no haya ningún video reproduciéndose.
 *
 * @param {string} token   token con scope admin
 * @param {number} minutos ventana; por defecto 30, acotada entre 5 y 1440
 */
function obtenerActividadReciente(token, minutos) {
  validarTokenConScope(token, "admin");

  const ventana = acotarVentanaActividad(minutos);
  const ahora = new Date();
  const corteMs = ahora.getTime() - ventana * 60000;

  const personas = {};   // correo → acumulador
  function acumulador(correo) {
    if (!personas[correo]) {
      personas[correo] = { correo: correo, senalMs: 0, videoId: "", porcentaje: 0, progresoMs: 0 };
    }
    return personas[correo];
  }

  // 1) Progreso de visualización: la señal más frecuente y la que dice QUÉ ve.
  try {
    const prog = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("_Progreso_Visualizacion");
    if (prog && prog.getLastRow() >= 2) {
      prog.getRange(2, 1, prog.getLastRow() - 1, PVIS_COLS).getValues().forEach(function (p) {
        const correo = (p[PVIS.CORREO] || "").toString().toLowerCase().trim();
        if (!correo) return;
        const ms = milisegundosDe(p[PVIS.ACTUALIZADA]);
        if (!ms || ms < corteMs) return;              // fuera de la ventana: no es «reciente»
        const a = acumulador(correo);
        if (ms > a.senalMs) a.senalMs = ms;
        // El video que se muestra es el de la fila de progreso MÁS reciente.
        if (ms >= a.progresoMs) {
          a.progresoMs = ms;
          a.videoId = (p[PVIS.VIDEO] || "").toString().trim();
          a.porcentaje = parseFloat(p[PVIS.PORCENTAJE]) || 0;
        }
      });
    }
  } catch (e) {
    logWarn("Actividad", "No se pudo leer el progreso: " + e.message);
  }

  /* 2) Apertura de videos. El progreso solo se escribe cuando ya hay segundos
        reproducidos —y con un mínimo de diez entre escrituras—, así que alguien
        que acaba de abrir un video no aparecía en la lista hasta pasado un rato
        largo: el administrador miraba y «no había nadie», cuando sí lo había.
        Esta hoja se escribe en el instante en que se abre el reproductor, así
        que es la señal más temprana que existe. El porcentaje sigue saliendo
        del progreso: aquí solo se sabe que lo abrió, no cuánto lleva visto. */
  try {
    const hist = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("_Historial_Visualizaciones");
    if (hist && hist.getLastRow() >= 2) {
      // Solo el final de la hoja: el historial crece sin tope y recorrerlo
      // entero en cada refresco del panel acabaría costando más que el panel.
      const filas = Math.min(hist.getLastRow() - 1, 400);
      const desde = hist.getLastRow() - filas + 1;
      hist.getRange(desde, 1, filas, 5).getValues().forEach(function (h) {
        const correo = (h[1] || "").toString().toLowerCase().trim();
        if (!correo) return;
        const ms = milisegundosDe(h[0]);
        if (!ms || ms < corteMs) return;
        const a = acumulador(correo);
        if (ms > a.senalMs) a.senalMs = ms;
        // Solo manda sobre el video mostrado si es MÁS reciente que la última
        // fila de progreso: si ya está reproduciendo, el progreso sabe más.
        if (ms > a.progresoMs) {
          a.progresoMs = ms;
          a.videoId = (h[3] || "").toString().trim();
          a.porcentaje = 0;
        }
      });
    }
  } catch (e) {
    logWarn("Actividad", "No se pudo leer el historial de visualizaciones: " + e.message);
  }

  // 3) Exámenes en curso. El flag es «ahora mismo»; para ENTRAR en la lista, en
  //    cambio, el intento tiene que haber empezado dentro de la ventana: un
  //    examen abierto hace seis horas es una sesión olvidada, no actividad.
  const enCurso = examenesEnCursoPorCorreo();
  Object.keys(enCurso).forEach(function (correo) {
    const inicioMs = enCurso[correo].inicioMs;
    if (!inicioMs || inicioMs < corteMs) return;
    const a = acumulador(correo);
    if (inicioMs > a.senalMs) a.senalMs = inicioMs;
  });

  const dispositivos = contarDispositivosEnVentana(corteMs);
  let catalogo = {};
  try { catalogo = obtenerIndiceCatalogo() || {}; } catch (e) { catalogo = {}; }

  const activos = Object.keys(personas).map(function (correo) {
    const a = personas[correo];
    const ficha = a.videoId ? catalogo[a.videoId] : null;
    const examen = enCurso[correo] || null;
    return {
      correo: correo,
      nombre: resolverNombreVisible(correo),
      videoId: a.videoId,
      // Un video retirado del catálogo no puede tumbar el panel: se muestra su
      // id, que sigue siendo un dato útil para rastrearlo.
      titulo: ficha && ficha.titulo ? ficha.titulo : a.videoId,
      porcentaje: Math.round(a.porcentaje * 10) / 10,
      ultimaSenal: formatearFecha(new Date(a.senalMs)),
      haceMinutos: Math.max(0, Math.round((ahora.getTime() - a.senalMs) / 60000)),
      dispositivos: dispositivos[correo] || 0,
      enExamen: Boolean(examen),
      moduloEnExamen: examen ? examen.moduloId : ""
    };
  });

  // Lo más reciente primero: es el orden en que un administrador mira una lista.
  activos.sort(function (x, y) { return x.haceMinutos - y.haceMinutos; });

  return {
    ventanaMinutos: ventana,
    generadoEn: formatearFecha(ahora),
    activos: activos,
    total: activos.length,
    resumen: {
      personas: activos.length,
      viendo: activos.filter(function (a) { return a.videoId !== ""; }).length,
      enExamen: activos.filter(function (a) { return a.enExamen; }).length
    }
  };
}

/**
 * [ADMIN] Desde qué dispositivos entra una persona.
 *
 * Devuelve etiquetas legibles, no huellas: ni la IP anonimizada ni el
 * user-agent completo salen de la hoja. Con «Chrome · Windows, usado hace dos
 * días» el administrador ya puede detectar una cuenta compartida, que es el
 * único motivo legítimo para mirar esto.
 */
function obtenerDispositivosUsuario(token, correo) {
  validarTokenConScope(token, "admin");

  const email = (correo || "").toString().toLowerCase().trim();
  const salida = { correo: email, total: 0, dispositivos: [] };
  if (!email) return salida;

  const limiteReciente = Date.now() - DISPOSITIVO_RECIENTE_DIAS * 86400000;

  try {
    const hoja = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("_Dispositivos_Conocidos");
    if (!hoja || hoja.getLastRow() < 2) return salida;

    hoja.getRange(2, 1, hoja.getLastRow() - 1, DISPO_COLS).getValues().forEach(function (d) {
      if ((d[DISPO.CORREO] || "").toString().toLowerCase().trim() !== email) return;
      const ultimaMs = milisegundosDe(d[DISPO.ULTIMA]);
      salida.dispositivos.push({
        etiqueta: etiquetaDispositivo(d[DISPO.AGENTE]),
        primeraVez: formatearFecha(d[DISPO.PRIMERA]),
        ultimaVez: formatearFecha(d[DISPO.ULTIMA]),
        usos: parseInt(d[DISPO.USOS], 10) || 0,
        esReciente: ultimaMs > 0 && ultimaMs >= limiteReciente,
        _orden: ultimaMs
      });
    });
  } catch (e) {
    logWarn("Actividad", "No se pudieron leer los dispositivos de " + email + ": " + e.message);
    return salida;
  }

  salida.dispositivos.sort(function (x, y) { return y._orden - x._orden; });
  salida.dispositivos.forEach(function (d) { delete d._orden; });
  salida.total = salida.dispositivos.length;
  return salida;
}

// -------------------------------------------------------------------------------------
// Panel de administración: una sola llamada
// -------------------------------------------------------------------------------------

/** Catálogo: total, clasificados y cuántos tienen examen generado. */
function panelSeccionCatalogo() {
  const s = { total: 0, clasificados: 0, sinClasificar: 0, conExamen: 0 };
  try {
    // El árbol de filtros ya está calculado y cacheado: recontarlo aquí sería
    // duplicar la definición de «sin clasificar» en dos sitios.
    const filtros = obtenerFiltrosCache();
    s.total = filtros.total || 0;
    const nodo = (filtros.arbol || {})[SIN_CLASIFICAR];
    s.sinClasificar = nodo ? (nodo.n || 0) : 0;
    s.clasificados = Math.max(0, s.total - s.sinClasificar);
  } catch (e) {
    logWarn("Panel", "Catálogo no disponible: " + e.message);
  }
  try {
    let conExamen = 0;
    iterarCatalogoPorBloques(function (bloque) {
      bloque.forEach(function (r) {
        if (!r[IDX.URL]) return;
        if ((r[IDX.ID_FORM] || "").toString().trim() || (r[IDX.URL_FORM] || "").toString().trim()) conExamen++;
      });
      return false;
    });
    s.conExamen = conExamen;
  } catch (e) {
    logWarn("Panel", "No se pudo contar exámenes del catálogo: " + e.message);
  }
  return s;
}

/** Certificados emitidos, en total y por módulo, de una sola lectura. */
function panelCertificados() {
  const r = { total: 0, porModulo: {} };
  try {
    const hoja = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("_Historial_Calificaciones");
    if (!hoja || hoja.getLastRow() < 2) return r;
    hoja.getRange(2, 1, hoja.getLastRow() - 1, HCAL_COLS).getValues().forEach(function (c) {
      if (!(c[HCAL.CERTIFICADO] || "").toString().trim()) return;
      r.total++;
      const mod = (c[HCAL.MODULO] || "").toString().trim();
      if (mod) r.porModulo[mod] = (r.porModulo[mod] || 0) + 1;
    });
  } catch (e) {
    logWarn("Panel", "No se pudo leer el historial de calificaciones: " + e.message);
  }
  return r;
}

/** Módulos con su banco validado y sus certificados. */
function panelSeccionModulos(certificados) {
  try {
    let bancos = {};
    try { bancos = obtenerBancosPorModulo() || {}; } catch (e) { bancos = {}; }
    return listarModulos().map(function (m) {
      const preguntas = parseInt(m.totalPreguntas, 10) || 0;
      const validadas = bancos[m.id] || 0;
      return {
        id: m.id,
        nombre: m.nombre || m.id,
        estado: m.estado || "ACTIVO",
        totalPreguntas: preguntas,
        // Un módulo con menos preguntas validadas de las que exige no puede
        // examinar a nadie: eso es lo que aquí significa «banco validado».
        bancoValidado: validadas >= preguntas && preguntas > 0,
        certificados: certificados.porModulo[m.id] || 0
      };
    });
  } catch (e) {
    logWarn("Panel", "Módulos no disponibles: " + e.message);
    return [];
  }
}

/** Personas: registradas, activas en 7 días y certificados emitidos. */
function panelSeccionPersonas(certificados) {
  const s = { registradas: 0, activas7d: 0, certificadosEmitidos: certificados.total || 0 };
  try {
    s.registradas = obtenerCorreosConocidos().length;
  } catch (e) {
    logWarn("Panel", "No se pudo contar el padrón: " + e.message);
  }
  try {
    // «Activa» = dejó señal de visualización. Es el rastro que todo el mundo
    // deja, mientras que examinarse solo lo hace una minoría cada semana.
    const prog = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("_Progreso_Visualizacion");
    if (prog && prog.getLastRow() >= 2) {
      const desde = Date.now() - 7 * 86400000;
      const vistos = {};
      prog.getRange(2, 1, prog.getLastRow() - 1, PVIS_COLS).getValues().forEach(function (p) {
        const correo = (p[PVIS.CORREO] || "").toString().toLowerCase().trim();
        if (!correo) return;
        if (milisegundosDe(p[PVIS.ACTUALIZADA]) < desde) return;
        vistos[correo] = true;
      });
      s.activas7d = Object.keys(vistos).length;
    }
  } catch (e) {
    logWarn("Panel", "No se pudo contar la actividad de 7 días: " + e.message);
  }
  return s;
}

/** Estado de la cola diferida: pendientes y agotadas (que piden mano humana). */
function panelEstadoCola() {
  const r = { pendientes: 0, agotadas: 0 };
  try {
    const hoja = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("_Tareas_Pendientes");
    if (!hoja || hoja.getLastRow() < 2) return r;
    hoja.getRange(2, COLA.ESTADO + 1, hoja.getLastRow() - 1, 1).getValues().forEach(function (e) {
      const estado = (e[0] || "").toString().trim();
      if (estado === ESTADO_TAREA.PENDIENTE) r.pendientes++;
      else if (estado === ESTADO_TAREA.AGOTADA) r.agotadas++;
    });
  } catch (e) {
    logWarn("Panel", "Cola no disponible: " + e.message);
  }
  return r;
}

/** Sistema: IA, sugerencias, cola y última auditoría de ingesta. */
function panelSeccionSistema(cola) {
  const s = { iaActiva: false, motivoIA: "", sugerenciasPendientes: 0, incidenciasAbiertas: 0,
              tareasEnCola: cola.pendientes || 0, ultimaFase1: "" };
  try {
    s.iaActiva = obtenerEstadoIA();
    s.motivoIA = motivoIANoDisponible();
  } catch (e) {
    s.motivoIA = "No se pudo comprobar el estado de la IA.";
  }
  try { s.sugerenciasPendientes = contarSugerenciasPendientes(); } catch (e) { s.sugerenciasPendientes = 0; }
  try { s.incidenciasAbiertas = contarIncidenciasAbiertas(); } catch (e) { s.incidenciasAbiertas = 0; }
  try {
    // No hay una propiedad «última Fase 1»; lo que sí queda es la última fila
    // del histórico de efectividad, que se escribe justo tras auditar la ingesta.
    const hoja = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("_Historial_Efectividad");
    if (hoja && hoja.getLastRow() >= 2) {
      s.ultimaFase1 = formatearFecha(hoja.getRange(hoja.getLastRow(), 1).getValue());
    }
  } catch (e) {
    s.ultimaFase1 = "";
  }
  return s;
}

/** Ordena las alertas por gravedad: lo grave arriba, lo informativo al final. */
function ordenarAlertas(alertas) {
  const peso = { crit: 0, warn: 1, info: 2 };
  return alertas.sort(function (a, b) { return peso[a.nivel] - peso[b.nivel]; });
}

/**
 * Lo que el administrador debe MIRAR hoy. Sin esto el panel sería una pared de
 * números en la que un módulo sin banco validado —que impide certificar a nadie—
 * pesa lo mismo que el total de videos.
 */
function panelAlertas(catalogo, modulos, sistema, cola) {
  const alertas = [];
  function alerta(nivel, texto, accion) { alertas.push({ nivel: nivel, texto: texto, accion: accion }); }

  if (catalogo.total === 0) {
    alerta("crit", "El catálogo está vacío.", "Importa videos y ejecuta la Fase 1.");
  } else if (catalogo.sinClasificar >= PANEL_UMBRAL_SIN_CLASIFICAR_GRAVE) {
    alerta("crit", catalogo.sinClasificar + " videos sin clasificar: el buscador y los filtros llegan rotos al portal.",
      "Ejecuta la Fase 2 de clasificación.");
  } else if (catalogo.sinClasificar >= PANEL_UMBRAL_SIN_CLASIFICAR) {
    alerta("warn", catalogo.sinClasificar + " videos sin clasificar.",
      "Ejecuta la Fase 2 de clasificación.");
  }

  const sinBanco = modulos.filter(function (m) {
    return m.estado !== "ARCHIVADO" && !m.bancoValidado;
  });
  if (sinBanco.length > 0) {
    const nombres = sinBanco.slice(0, 3).map(function (m) { return m.nombre; }).join(", ");
    alerta("crit", sinBanco.length + " módulo(s) sin banco de preguntas validado: " + nombres +
      (sinBanco.length > 3 ? "…" : "") + ". Nadie puede certificarse en ellos.",
      "Valida las preguntas del módulo.");
  }

  if (!sistema.iaActiva || sistema.motivoIA) {
    alerta("warn", sistema.motivoIA || "La IA está apagada.",
      "Actívala en el menú «IA Multi-Modelo».");
  }

  if (cola.agotadas > 0) {
    alerta("crit", cola.agotadas + " tarea(s) agotadas tras reintentar: nadie las va a volver a intentar.",
      "Revisa «_Tareas_Pendientes» y relánzalas.");
  }
  if (sistema.tareasEnCola >= PANEL_UMBRAL_COLA) {
    alerta("warn", sistema.tareasEnCola + " tareas esperando en la cola diferida.",
      "Procesa la cola o revisa la cuota del proveedor.");
  }

  if (sistema.sugerenciasPendientes > 0) {
    alerta("info", sistema.sugerenciasPendientes + " sugerencia(s) de video esperando revisión.",
      "Ábrelas en el buzón de sugerencias.");
  }

  /* Una incidencia abierta es alguien que ya avisó de que algo está roto. Pesa
     más que una sugerencia: mientras siga abierta, el video caído sigue caído y
     la pregunta mal planteada sigue penalizando a quien la responda. */
  if (sistema.incidenciasAbiertas > 0) {
    alerta("warn", sistema.incidenciasAbiertas + " incidencia(s) reportadas sin resolver.",
      "Ábrelas en la pestaña de incidencias.");
  }

  if (catalogo.total > 0 && catalogo.conExamen === 0) {
    alerta("info", "Ningún video del catálogo tiene examen generado.",
      "Genera exámenes desde el menú de LMS.");
  }

  return ordenarAlertas(alertas);
}

/**
 * [ADMIN] Todo lo que necesita el panel, en una sola llamada.
 *
 * Cada sección se calcula por separado y con su propia red: si falta una hoja o
 * una fuente falla, esa sección va con ceros y las demás se devuelven igual. Un
 * panel que revienta entero porque una hoja no existe no le sirve a nadie —
 * justo el día que algo se rompe es cuando hay que poder mirarlo.
 */
function obtenerPanelAdministracion(token) {
  validarTokenConScope(token, "admin");

  const catalogo = panelSeccionCatalogo();
  const certificados = panelCertificados();
  const modulos = panelSeccionModulos(certificados);
  const personas = panelSeccionPersonas(certificados);
  const cola = panelEstadoCola();
  const sistema = panelSeccionSistema(cola);

  return {
    // La versión viaja en el panel a propósito: es la pantalla que el
    // administrador abre a diario, y es donde se nota si el Codigo.gs
    // desplegado no es el que corresponde al portal que está viendo.
    version: VERSION_SCRIPT,
    catalogo: catalogo,
    modulos: modulos,
    personas: personas,
    sistema: sistema,
    alertas: panelAlertas(catalogo, modulos, sistema, cola)
  };
}

// -------------------------------------------------------------------------------------
// 14.10 Buzón de incidencias
//    Un colaborador que encuentra un video caído o una pregunta mal planteada
//    hoy no tiene dónde decirlo: o se lo cuenta a alguien de palabra, o no se
//    entera nadie. Y una pregunta mal planteada en un banco certificable
//    penaliza a todo el que la responda hasta que alguien la corrija.
// -------------------------------------------------------------------------------------

/** Índices 0-based de `_Incidencias`. */
const INC = {
  ID: 0, FECHA: 1, CORREO: 2, NOMBRE: 3, TIPO: 4, DESCRIPCION: 5,
  CONTEXTO: 6, REFERENCIA: 7, ESTADO: 8, ATENDIDA_POR: 9, FECHA_CIERRE: 10, RESPUESTA: 11
};

const TIPOS_INCIDENCIA = ["video", "pregunta", "sugerencia", "otro"];
const ESTADO_INCIDENCIA = { ABIERTA: "Abierta", CERRADA: "Cerrada" };

function obtenerHojaIncidencias() {
  return asegurarHojaSistema("_Incidencias");
}

/**
 * Registra una incidencia. La abre cualquier colaborador desde el reproductor
 * o desde su informe.
 *
 * `referencia` es lo que permite ACTUAR sobre el aviso: el id del video o el del
 * intento. Sin ella, un «la pregunta 7 está mal» obliga a adivinar de qué examen
 * hablaba, y el aviso se queda sin atender.
 */
function reportarIncidencia(token, tipo, descripcion, contexto, referencia) {
  validarTokenConScope(token, "read_only");
  const datos = obtenerDatosToken_(token);
  if (!datos) throw new Error(t("err_sin_token"));

  const texto = sanitizarTextoUsuario((descripcion || "").toString()).trim().slice(0, 2000);
  if (texto.length < 5) {
    return { exito: false, mensaje: "Cuéntanos un poco más de qué pasa." };
  }
  const clase = TIPOS_INCIDENCIA.indexOf((tipo || "").toString()) !== -1 ? tipo : "otro";

  const hoja = obtenerHojaIncidencias();
  const id = nuevoId("inc");
  const fila = new Array(Object.keys(INC).length).fill("");
  fila[INC.ID] = id;
  fila[INC.FECHA] = formatearFecha(new Date(), "yyyy-MM-dd HH:mm");
  fila[INC.CORREO] = (datos.email || "").toLowerCase();
  fila[INC.NOMBRE] = datos.client || resolverNombreVisible(datos.email) || "";
  fila[INC.TIPO] = clase;
  fila[INC.DESCRIPCION] = texto;
  fila[INC.CONTEXTO] = sanitizarTextoUsuario((contexto || "").toString()).slice(0, 300);
  fila[INC.REFERENCIA] = sanitizarTextoUsuario((referencia || "").toString()).slice(0, 120);
  fila[INC.ESTADO] = ESTADO_INCIDENCIA.ABIERTA;
  hoja.appendRow(fila);

  logInfo("Incidencias", `${clase} reportada por ${datos.email}: ${texto.slice(0, 60)}`);
  return { exito: true, idIncidencia: id, mensaje: "Gracias, lo revisaremos." };
}

/** Lista para el administrador. Por defecto solo las abiertas, que son las que piden acción. */
function listarIncidencias(token, estado) {
  validarTokenConScope(token, "admin");
  const hoja = obtenerHojaIncidencias();
  if (hoja.getLastRow() < 2) return [];

  const filtro = (estado || "").toString().trim();
  const filas = hoja.getRange(2, 1, hoja.getLastRow() - 1, Object.keys(INC).length).getValues();
  return filas
    .map(function (f, i) {
      return {
        id: (f[INC.ID] || "").toString(), fila: i + 2,
        fecha: (f[INC.FECHA] || "").toString(),
        correo: (f[INC.CORREO] || "").toString(),
        nombre: (f[INC.NOMBRE] || "").toString(),
        tipo: (f[INC.TIPO] || "otro").toString(),
        descripcion: (f[INC.DESCRIPCION] || "").toString(),
        contexto: (f[INC.CONTEXTO] || "").toString(),
        referencia: (f[INC.REFERENCIA] || "").toString(),
        estado: (f[INC.ESTADO] || ESTADO_INCIDENCIA.ABIERTA).toString(),
        atendidaPor: (f[INC.ATENDIDA_POR] || "").toString(),
        respuesta: (f[INC.RESPUESTA] || "").toString()
      };
    })
    .filter(function (x) { return x.id && (!filtro || x.estado === filtro); })
    .sort(function (a, b) { return (b.fecha || "").localeCompare(a.fecha || ""); });
}

/** Cierra una incidencia dejando constancia de quién y con qué respuesta. */
function cerrarIncidencia(token, idIncidencia, respuesta) {
  validarTokenConScope(token, "admin");
  const datos = obtenerDatosToken_(token) || {};
  const hoja = obtenerHojaIncidencias();
  if (hoja.getLastRow() < 2) return { exito: false, mensaje: "No hay incidencias." };

  const id = (idIncidencia || "").toString().trim();
  const filas = hoja.getRange(2, 1, hoja.getLastRow() - 1, Object.keys(INC).length).getValues();
  for (let i = 0; i < filas.length; i++) {
    if ((filas[i][INC.ID] || "").toString() !== id) continue;
    // Cerrar dos veces no es un error: se informa y no se pisa quién la cerró.
    if (filas[i][INC.ESTADO] === ESTADO_INCIDENCIA.CERRADA) {
      return { exito: true, yaCerrada: true, mensaje: "Ya estaba cerrada." };
    }
    hoja.getRange(i + 2, INC.ESTADO + 1, 1, 4).setValues([[
      ESTADO_INCIDENCIA.CERRADA,
      (datos.email || "").toLowerCase(),
      formatearFecha(new Date(), "yyyy-MM-dd HH:mm"),
      sanitizarTextoUsuario((respuesta || "").toString()).slice(0, 500)
    ]]);
    logInfo("Incidencias", `${id} cerrada por ${datos.email}.`);
    return { exito: true, mensaje: "Incidencia cerrada." };
  }
  return { exito: false, mensaje: "No se encontró esa incidencia." };
}

function contarIncidenciasAbiertas() {
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const hoja = ss.getSheetByName("_Incidencias");
    if (!hoja || hoja.getLastRow() < 2) return 0;
    return hoja.getRange(2, INC.ESTADO + 1, hoja.getLastRow() - 1, 1).getValues()
      .filter(function (f) { return f[0] === ESTADO_INCIDENCIA.ABIERTA; }).length;
  } catch (e) { return 0; }
}

/**
 * Contenido del documento maestro de un módulo, para leerlo dentro del portal.
 * Solo devuelve el texto de un módulo que exista; el id de Drive no viaja al
 * cliente, así que nadie puede pedir un documento arbitrario de la unidad.
 */
function obtenerDocumentoMaestro(token, moduloId) {
  validarTokenConScope(token, "read_only");
  const modulo = obtenerModulo((moduloId || "").toString().trim());
  if (!modulo) return { exito: false, mensaje: "Ese módulo no existe." };
  const driveId = (modulo.documentoMaestro || "").toString().trim();
  if (!driveId) {
    return { exito: false, mensaje: "Este módulo todavía no tiene documento maestro." };
  }
  const texto = recuperarTextoPesado_(driveId);
  if (!texto || texto.indexOf("[Error al leer archivo RAG") === 0) {
    return { exito: false, mensaje: "No se pudo leer el documento." };
  }
  return {
    exito: true, moduloId: modulo.id, modulo: modulo.nombre,
    texto: texto.slice(0, 120000),
    truncado: texto.length > 120000
  };
}

// -------------------------------------------------------------------------------------
// 14.6 FICHA DE ESTUDIO DE UN VIDEO
// -------------------------------------------------------------------------------------
//    Todo lo que el sistema ya sabía de un video pero no enseñaba en ninguna
//    parte: los enlaces que venían en su descripción, el resumen ampliado que
//    escribió la IA y la transcripción con marcas de tiempo. Estaba guardado en
//    Drive y en la columna de recursos, y la única forma de verlo era abrir la
//    hoja o salir del portal a Drive — justo mientras el video está sonando.
// -------------------------------------------------------------------------------------

/** Máximo de segmentos que se envían al portal de una vez. */
const FICHA_MAX_SEGMENTOS = 900;

/**
 * Ficha de estudio de un video para el reproductor del portal.
 *
 * El ID de Drive NO viaja al cliente. Antes sí: cada tarjeta del catálogo
 * llevaba `driveIdText`, y el reproductor lo convertía en un enlace público a
 * Drive. Con ese id, cualquiera a quien se le reenviara podía abrir el
 * documento, y además sacaba a la persona del portal a mitad de estudio. Aquí
 * se devuelve el CONTENIDO, y el id se queda en el servidor.
 *
 * Las tres piezas se devuelven siempre, vacías si no las hay: el portal pinta
 * las pestañas a partir de lo que llega, y una pestaña que aparece y desaparece
 * según el video es peor que una pestaña que dice que todavía no hay nada.
 *
 * @param {string} token
 * @param {string} idVideo
 * @return {{exito:boolean, idVideo:string, titulo:string, recursos:Array,
 *           tags:Array<string>, resumen:string, resumenAmpliado:string,
 *           segmentos:Array<{t:number, texto:string}>, transcripcion:string,
 *           esMusical:boolean, admiteTranscripcion:boolean, mensaje:string}}
 */
function obtenerFichaVideo(token, idVideo) {
  validarTokenConScope(token, "read_only");

  const id = (idVideo || "").toString().trim();
  const vacia = {
    exito: false, idVideo: id, titulo: "", recursos: [], tags: [],
    resumen: "", resumenAmpliado: "", segmentos: [], transcripcion: "",
    esMusical: false, admiteTranscripcion: false, truncado: false, mensaje: ""
  };
  if (!id) { vacia.mensaje = "Falta el ID del video."; return vacia; }

  const encontrado = buscarFilaCatalogoPorId(id);
  if (!encontrado || !encontrado.fila) {
    vacia.mensaje = "Ese video ya no está en el catálogo.";
    return vacia;
  }
  const r = encontrado.fila;

  /* Los recursos se guardan como texto con un enlace por línea. Se parten aquí
     y no en el navegador para que el portal no tenga que conocer el formato de
     una columna de la hoja: si mañana se guardan separados por comas, cambia
     este renglón y no la interfaz. */
  const recursos = (r[IDX.RECURSOS] || "").toString()
    .split(/[\n\r]+/)
    .map(function (x) { return x.trim(); })
    .filter(Boolean)
    .map(function (linea) {
      const m = linea.match(/https?:\/\/\S+/);
      const url = m ? m[0] : "";
      const etiqueta = linea.replace(url, "").replace(/^[\s·\-|:]+/, "").trim();
      return {
        url: url,
        // Sin etiqueta propia se usa el dominio: «github.com» dice mucho más
        // que una URL de ciento veinte caracteres cortada por la mitad.
        etiqueta: etiqueta || (url ? url.replace(/^https?:\/\//, "").split("/")[0] : linea)
      };
    })
    .filter(function (x) { return x.url || x.etiqueta; });

  const tags = (r[IDX.TAGS] || "").toString()
    .split(/[,;\n]+/).map(function (x) { return x.trim(); }).filter(Boolean);

  const ficha = {
    exito: true,
    idVideo: id,
    titulo: (r[IDX.TITULO] || "").toString(),
    recursos: recursos,
    tags: tags,
    resumen: (r[IDX.RESUMEN] || "").toString(),
    resumenAmpliado: "",
    segmentos: [],
    transcripcion: "",
    // La letra y la transcripción son textos DISTINTOS del mismo video: una es
    // lo que se oye —con sus errores de reconocimiento— y la otra el texto
    // original en versos. Viajan por separado porque se leen por separado.
    letra: "", letraFuente: "", tipoTexto: "",
    /* [v2] Responde solo a si el contenido ES musical. Antes se derivaba de
       «no certificable», y con la faceta Referencia eso pasó a ser falso: un
       documental sobre reactores SMR no certifica, pero llamarlo musical hace
       que el portal muestre «contenido musical sin transcripción». */
    esMusical: esFilaMusical(r),
    admiteTranscripcion: filaAdmiteTranscripcion(r),
    truncado: false,
    mensaje: ""
  };

  const driveId = (r[IDX.DRIVE_RAG] || "").toString().trim();
  if (!driveId) {
    ficha.mensaje = ficha.admiteTranscripcion
      ? "Este video todavía no tiene documento de estudio. Se genera en la Fase 2."
      : "Este contenido no lleva transcripción.";
    return ficha;
  }

  try {
    const texto = recuperarTextoPesado_(driveId);
    /* Drive contesta con un texto de error, no lanzando: sin mirarlo aquí, un
       documento que no se deja leer acababa contado como documento vacío. Son
       dos situaciones distintas y con dos salidas distintas —una se arregla
       reportándola y la otra esperando a la Fase 2—, así que no pueden
       compartir mensaje. */
    if (texto && texto.indexOf("[Error al leer archivo RAG") === 0) {
      ficha.mensaje = "El documento de estudio existe pero no se pudo leer.";
    } else if (texto) {
      ficha.resumenAmpliado = texto.slice(0, 120000);
      ficha.truncado = texto.length > 120000;
    }
    /* La letra se lee del MISMO documento, pero de su propio campo: es el texto
       oficial en versos, no lo que se oye. Se leía en otro sitio por error y al
       portal le llegaba siempre vacía, así que un musical con la letra pegada a
       mano se anunciaba como «documento vacío» y mandaba a esperar la Fase 2
       por un texto que ya estaba guardado. */
    const doc = recuperarDocumentoRAG_(driveId) || {};
    ficha.letra = (doc.letra || "").toString().slice(0, 40000);
    ficha.letraFuente = (doc.letraFuente || "").toString();
    ficha.tipoTexto = (doc.tipoTexto || "").toString();

    const segmentos = recuperarSegmentosRAG_(driveId) || [];
    /* Con marcas de tiempo la transcripción deja de ser un muro de texto y pasa
       a ser un índice: cada línea lleva a su minuto del video. Por eso los
       segmentos se devuelven aparte del texto plano, aunque digan lo mismo. */
    ficha.segmentos = segmentos.slice(0, FICHA_MAX_SEGMENTOS).map(function (s) {
      return {
        t: convertirTimestampASegundos(s.t !== undefined ? s.t : s.tiempo),
        texto: (s.texto || s.text || "").toString()
      };
    }).filter(function (s) { return s.texto; });
    if (segmentos.length > FICHA_MAX_SEGMENTOS) ficha.truncado = true;
  } catch (e) {
    logWarn("Ficha", "No se pudo leer el documento de " + id + ": " + e.message);
    ficha.mensaje = "El documento de estudio existe pero no se pudo leer.";
  }

  if (!ficha.resumenAmpliado && !ficha.segmentos.length && !ficha.letra && !ficha.mensaje) {
    ficha.mensaje = "El documento de estudio está vacío.";
  }
  return ficha;
}

// -------------------------------------------------------------------------------------
// 14.7 IDENTIDAD DEL PORTAL
// -------------------------------------------------------------------------------------
//    El portal decía «Videoteca» en todas partes, escrito a mano en el HTML. Para
//    ponerle el nombre de la empresa había que editar el archivo y volver a
//    implementar, cosa que quien administra la videoteca no tiene por qué hacer.
//    Y los rótulos de la cascada —Ecosistema, Área, Tema— son la taxonomía de
//    ESTA instalación: en otra casa se llaman de otra manera.
// -------------------------------------------------------------------------------------

/**
 * Identidad de fábrica. Cada campo es también la documentación de para qué sirve:
 * lo que se ve cuando nadie ha configurado nada.
 */
const MARCA_POR_DEFECTO = {
  nombre: "Videoteca",
  subtitulo: "Videoteca certificable",
  logoUrl: "",
  iniciales: "",
  color: "",
  rotuloEcosistema: "Ecosistema",
  rotuloArea: "Área",
  rotuloTema: "Tema",
  rotuloVersion: "Versión",
  rotuloDificultad: "Nivel",
  rotuloFuente: "Fuente",
  rotuloModulo: "Módulo",
  /* [v2.6.17] Crédito de autoría del pie. «Desarrollado por» es la fórmula
     habitual en software —«creado por» se usa más para obra gráfica o
     editorial—, y es la que se entiende sin pensarlo.
     Tiene valor de fábrica en vez de quedar vacío para que el crédito aparezca
     sin que nadie tenga que ir a ponerlo; y es un campo editable, no un texto
     fijo, porque el portal se instala también en casa de clientes y ahí la
     línea correcta puede ser otra —o ninguna: se borra y desaparece. */
  pie: "Desarrollado por Kuvexta Group"
};

/** Longitud máxima de cada campo de texto de la marca. */
const MARCA_MAX_TEXTO = 60;

/** Campos que se pueden dejar en blanco a propósito, sin que vuelva el de fábrica. */
const MARCA_VACIABLES = ["pie", "logoUrl", "color"];

/**
 * La identidad configurada, completada con los valores de fábrica.
 *
 * Se devuelve SIEMPRE entera, nunca a medias: si el portal recibiera solo los
 * campos guardados tendría que conocer los valores por defecto para rellenar el
 * resto, y esos valores acabarían escritos en dos sitios que se desincronizan.
 */
function obtenerMarcaPortal() {
  const salida = {};
  Object.keys(MARCA_POR_DEFECTO).forEach(function (k) { salida[k] = MARCA_POR_DEFECTO[k]; });
  try {
    const crudo = PropertiesService.getScriptProperties().getProperty("MARCA_PORTAL");
    if (crudo) {
      const guardado = JSON.parse(crudo);
      Object.keys(MARCA_POR_DEFECTO).forEach(function (k) {
        const v = guardado[k];
        if (v === undefined || v === null) return;
        /* [v2.6.17] Vaciar un campo tiene que poder significar «vacío», no
           «vuelve al de fábrica». Para el nombre o los rótulos eso no importa
           —dejarlos en blanco rompería el portal, y por eso el valor de
           fábrica los rescata—, pero el crédito del pie SÍ hay que poder
           quitarlo: si un cliente no quiere esa línea, la borra y se va. Sin
           esta excepción volvería a aparecer en la siguiente carga y no habría
           forma de entender por qué. */
        if (MARCA_VACIABLES.indexOf(k) !== -1) { salida[k] = v.toString(); return; }
        if (v.toString().trim() !== "") salida[k] = v.toString();
      });
    }
  } catch (e) {
    logWarn("Marca", "La identidad guardada no se pudo leer; se usan los valores de fábrica.");
  }
  // Las iniciales del cuadrito se deducen del nombre si nadie las puso.
  if (!salida.iniciales) {
    salida.iniciales = salida.nombre.trim().split(/\s+/).slice(0, 2)
      .map(function (p) { return p.charAt(0).toUpperCase(); }).join("") || "V";
  }
  return salida;
}

/**
 * [ADMIN] Guarda la identidad del portal.
 *
 * El logo se acepta como URL http(s) o como data URI. No se acepta cualquier
 * cadena: el valor acaba dentro de un atributo `src` del portal, y una cadena
 * arbitraria ahí es una vía de inyección. Lo que no encaje se descarta y se
 * dice cuál fue.
 */
function guardarMarcaPortal(token, marca) {
  validarTokenConScope(token, "admin");
  const entrada = marca || {};
  const guardado = {};
  const descartados = [];

  Object.keys(MARCA_POR_DEFECTO).forEach(function (k) {
    if (entrada[k] === undefined || entrada[k] === null) return;
    let v = sanitizarTextoUsuario(entrada[k]).slice(0, MARCA_MAX_TEXTO);

    if (k === "logoUrl") {
      // Aquí no se sanea con el saneador de texto: una URL válida lleva
      // caracteres que ese saneador quita, y además hay que validar la forma.
      v = (entrada[k] || "").toString().trim();
      if (v && !/^https:\/\/[^\s<>"']+$/i.test(v) && !/^data:image\/[a-z+]+;base64,[A-Za-z0-9+/=]+$/i.test(v)) {
        descartados.push("el logo (debe ser una URL https o una imagen en base64)");
        return;
      }
      // Un logo enorme viaja en cada carga del portal: se pone un tope.
      if (v.length > 200000) { descartados.push("el logo (demasiado pesado)"); return; }
    }

    if (k === "color") {
      v = (entrada[k] || "").toString().trim();
      if (v && !/^#[0-9a-f]{6}$/i.test(v)) {
        descartados.push("el color (debe ser un hexadecimal como #0f766e)");
        return;
      }
    }

    guardado[k] = v;
  });

  PropertiesService.getScriptProperties().setProperty("MARCA_PORTAL", JSON.stringify(guardado));
  logInfo("Marca", "Identidad del portal actualizada.");
  return {
    exito: true,
    marca: obtenerMarcaPortal(),
    descartados: descartados,
    mensaje: descartados.length
      ? "Guardado, pero se descartó " + descartados.join(" y ") + "."
      : "Identidad del portal actualizada."
  };
}

