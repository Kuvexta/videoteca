    let bloque = extraerBloqueMermaid(texto);
    if (!bloque) {
      const raw = llamarModeloIA(obtenerPrompt("mapa_mental", { titulo: tit, texto: texto.slice(0, 8000) }),
        obtenerConfigIA().proveedor, 2000);
      bloque = extraerBloqueMermaid(raw) || raw;
    }
    const arch = obtenerSubcarpeta("Mapas_Mentales")
      .createFile(`Mapa_${tit.replace(/[^a-zA-Z0-9]/g, "_")}.md`, "```mermaid\n" + bloque + "\n```", MimeType.PLAIN_TEXT);
