function obtenerHojaClaves() {
  exigirOrigenInterno("obtenerHojaClaves");
  return asegurarHojaSistema("_Claves_Examenes");
}

/**
 * Normaliza una pregunta cruda del modelo al registro de 24 columnas.
 * @param {Object} p pregunta cruda
 * @param {Object} ctx { examenId, moduloId, numero, videoId, fuente, procedencia, validacion }
 */
/**
 * [OPT-14] Invariante única de la trampa anti-IA.
 *
 * Una pregunta SOLO cuenta como trampa si existe una opción concreta en la que
 * se pueda caer. Si el cebo es inválido —fuera de rango, ausente, o igual a la
 * respuesta correcta— la pregunta se degrada a pregunta normal, NO a "trampa sin
 * cebo". La diferencia importa: `trampasPresentadas` es el denominador del
 * índice forense, y una trampa en la que nadie puede caer lo infla sin poder
 * aportar nunca al numerador, empujando la tasa hacia abajo y disfrazando de
 * BAJO un caso que no lo es.
 *
 * Vive en un solo lugar porque la comparten tres rutas que antes divergían:
 * la escritura al banco, la lectura del banco (incluidas las filas migradas de
 * esquemas antiguos) y la validación del banco recién generado.
 *
 * @return {{esTrampa:boolean, cebo:number, tipoTrampa:string}}
 */
function resolverTrampa(marcada, indiceCebo, correcta, opciones, tipo, tipoTrampaCrudo) {
  const lista = Array.isArray(opciones) ? opciones : [];
  const tipoTrampa = TIPOS_TRAMPA.indexOf((tipoTrampaCrudo || "").toString()) !== -1
    ? tipoTrampaCrudo.toString() : "";

  const cebo = parseInt(indiceCebo, 10);
  const idxCorrecta = parseInt(correcta, 10);

  const ceboUtilizable =
    !isNaN(cebo) && cebo >= 0 && cebo < lista.length && cebo !== idxCorrecta;

  // En "completar" no hay opciones donde poner un cebo: una trampa ahí no existe.
  const esTrampa = Boolean(marcada) && tipoTrampa !== "" && tipo !== "completar" && ceboUtilizable;

  return {
    esTrampa: esTrampa,
    cebo: esTrampa ? cebo : -1,
    tipoTrampa: esTrampa ? tipoTrampa : ""
  };
}

function normalizarPregunta(p, ctx) {
  const opciones = Array.isArray(p.opciones) ? p.opciones : [];
  let correcta = parseInt(p.correcta, 10);
  if (isNaN(correcta)) correcta = 0;

  const tipo = p.tipo || "multiple";
  const severidad = SEVERIDADES_RIESGO.indexOf((p.severidad_riesgo || "").toString().toUpperCase()) !== -1
    ? p.severidad_riesgo.toString().toUpperCase() : "BAJO";

  const trampa = resolverTrampa(p.es_trampa_ia, p.indice_cebo_ia, correcta, opciones, tipo, p.tipo_trampa);
  const esTrampa = trampa.esTrampa;
  const cebo = trampa.cebo;
  const tipoTrampa = trampa.tipoTrampa;

  return {
    examenId: ctx.examenId,
    moduloId: ctx.moduloId || "",
    numero: ctx.numero,
    texto: sanitizarEntrada(p.pregunta).slice(0, 900),
    tipo: tipo,
    opciones: opciones,
    correcta: correcta,
    respuestaTexto: (p.correcta_texto || (tipo === "completar" ? p.correcta : "") || "").toString(),
    configuracionCorrecta: (p.configuracion_correcta || "").toString().slice(0, 600),
    justificacion: (p.justificacion || "").toString().slice(0, 600),
    causaRaiz: (p.causa_raiz || p.justificacion || "").toString().slice(0, 400),
    riesgo: (p.riesgo_operativo || "").toString().slice(0, 600),
    severidad: severidad,
    caso: (p.caso_practico || "").toString().slice(0, 600),
    area: (p.area || p.area_competencia || "General").toString().slice(0, 120),
    fuente: (p.fuente || ctx.fuente || "").toString().slice(0, 60),
    videoId: (p.video_id || ctx.videoId || "").toString(),
    segundo: convertirTimestampASegundos(p.video_segundo !== undefined ? p.video_segundo : p.timestamp),
    esTrampa: esTrampa,
    cebo: cebo,
    tipoTrampa: tipoTrampa,
    peso: parseInt(p.peso_puntos, 10) > 0 ? parseInt(p.peso_puntos, 10) : 1,
    procedencia: ctx.procedencia || PROCEDENCIA.GENERADA,
    validacion: ctx.validacion || VALIDACION.BORRADOR
  };
}

/** Convierte el registro normalizado a la fila de 24 columnas. */
function preguntaAFila(q) {
  const fila = new Array(CABECERAS_CLAVES.length).fill("");
  fila[CLAVE.EXAMEN] = q.examenId;
  fila[CLAVE.MODULO] = q.moduloId;
  fila[CLAVE.NUMERO] = q.numero;
  fila[CLAVE.TEXTO] = q.texto;
  fila[CLAVE.TIPO] = q.tipo;
  fila[CLAVE.OPCIONES] = JSON.stringify(q.opciones || []);
  fila[CLAVE.CORRECTO] = q.correcta;
  fila[CLAVE.RESP_TEXTO] = q.respuestaTexto;
  fila[CLAVE.CONFIG_OK] = q.configuracionCorrecta;
  fila[CLAVE.JUSTIF] = q.justificacion;
  fila[CLAVE.CAUSA] = q.causaRaiz;
  fila[CLAVE.RIESGO] = q.riesgo;
  fila[CLAVE.SEVERIDAD] = q.severidad;
  fila[CLAVE.CASO] = q.caso;
  fila[CLAVE.AREA] = q.area;
  fila[CLAVE.FUENTE] = q.fuente;
  fila[CLAVE.VIDEO] = q.videoId;
  fila[CLAVE.SEGUNDO] = q.segundo;
  fila[CLAVE.TRAMPA] = q.esTrampa;
  fila[CLAVE.CEBO] = q.cebo;
  fila[CLAVE.TIPO_TRAMPA] = q.tipoTrampa;
  fila[CLAVE.PESO] = q.peso;
  fila[CLAVE.PROCEDENCIA] = q.procedencia;
  fila[CLAVE.VALIDACION] = q.validacion;
  return fila;
}

/** Escribe un conjunto de preguntas normalizadas en el banco (una sola operación). */
function guardarClavesEnSheet(examenId, videoId, preguntasNormalizadas) {
  exigirOrigenInterno("guardarClavesEnSheet");
  const sheet = obtenerHojaClaves();
  const filas = preguntasNormalizadas.map(q => preguntaAFila(q));
  if (filas.length > 0) {
    sheet.getRange(sheet.getLastRow() + 1, 1, filas.length, CABECERAS_CLAVES.length).setValues(filas);
  }
  // Toda escritura al banco invalida la caché de los módulos afectados.
  limpiarMemoEjecucion();
  const modulos = {};
  preguntasNormalizadas.forEach(q => { if (q.moduloId) modulos[q.moduloId] = true; });
  Object.keys(modulos).forEach(m => invalidarCacheBanco(m));
  return filas.length;
}

/** Elimina del banco todas las preguntas de un examen (para regenerarlo). */
function eliminarClavesDeExamen(examenId) {
  exigirOrigenInterno("eliminarClavesDeExamen");
  const sheet = obtenerHojaClaves();
  if (sheet.getLastRow() < 2) return 0;
  const ids = sheet.getRange(2, 1, sheet.getLastRow() - 1, 1).getValues();
  let eliminadas = 0;
  for (let i = ids.length - 1; i >= 0; i--) {
    if ((ids[i][0] || "").toString().trim() === examenId) { sheet.deleteRow(i + 2); eliminadas++; }
  }
  if (eliminadas > 0) { invalidarCacheBanco(); limpiarMemoEjecucion(); }
  return eliminadas;
}

/** Devuelve las preguntas del banco que cumplen un filtro. */
/**
 * [OPT-11] Lectura del banco con caché por módulo.
 * `obtenerEstadoModuloUsuario` se llama una vez por módulo y por persona: en la
 * matriz de certificación eso son N×M lecturas completas de la hoja de claves.
 * Cachear el banco validado de cada módulo 10 minutos convierte esa matriz de
 * cientos de lecturas en una por módulo.
 *
 * La caché solo cubre el caso repetitivo (moduloId + soloValidadas). Cualquier
 * escritura al banco la invalida con invalidarCacheBanco().
 */
function leerClavesExamen(filtro) {
  exigirOrigenInterno("leerClavesExamen");
  const f = filtro || {};
  const cacheable = Boolean(f.moduloId) && f.soloValidadas === true && !f.examenId;
  const clave = cacheable ? CLAVE_CACHE_BANCO + f.moduloId : null;

  if (clave) {
    try {
      const guardado = CacheService.getScriptCache().get(clave);
      if (guardado) return JSON.parse(guardado);
    } catch (e) { /* caché corrupta: se relee la hoja */ }
  }

  const sheet = obtenerHojaClaves();
  if (sheet.getLastRow() < 2) return [];
  const datos = sheet.getRange(2, 1, sheet.getLastRow() - 1, CABECERAS_CLAVES.length).getValues();
  const resultado = datos.filter(fila => {
    if (f.examenId && (fila[CLAVE.EXAMEN] || "").toString().trim() !== f.examenId) return false;
    if (f.moduloId && (fila[CLAVE.MODULO] || "").toString().trim() !== f.moduloId) return false;
    if (f.soloValidadas && (fila[CLAVE.VALIDACION] || "").toString().trim() !== VALIDACION.VALIDADA) return false;
    return true;
  }).map(fila => filaAPregunta(fila));

  if (clave) {
    try { CacheService.getScriptCache().put(clave, JSON.stringify(resultado), 600); }
    catch (e) { /* banco > 100 KB: se sirve siempre desde la hoja */ }
  }
  return resultado;
}

/** Convierte una fila del banco a objeto legible. */
function filaAPregunta(f) {
  let opciones = [];
  try { opciones = JSON.parse(f[CLAVE.OPCIONES] || "[]"); } catch (e) { opciones = []; }

  const trampaLeida = resolverTrampa(
    f[CLAVE.TRAMPA] === true || (f[CLAVE.TRAMPA] || "").toString().toLowerCase() === "true",
    f[CLAVE.CEBO],
    parseInt(f[CLAVE.CORRECTO], 10),
    opciones,
    (f[CLAVE.TIPO] || "multiple").toString(),
    f[CLAVE.TIPO_TRAMPA]
  );

  return {
    examenId: (f[CLAVE.EXAMEN] || "").toString(),
    moduloId: (f[CLAVE.MODULO] || "").toString(),
    numero: parseInt(f[CLAVE.NUMERO], 10) || 0,
    texto: (f[CLAVE.TEXTO] || "").toString(),
    tipo: (f[CLAVE.TIPO] || "multiple").toString(),
    opciones: opciones,
    correcta: parseInt(f[CLAVE.CORRECTO], 10),
    respuestaTexto: (f[CLAVE.RESP_TEXTO] || "").toString(),
    configuracionCorrecta: (f[CLAVE.CONFIG_OK] || "").toString(),
    justificacion: (f[CLAVE.JUSTIF] || "").toString(),
    causaRaiz: (f[CLAVE.CAUSA] || "").toString(),
    riesgo: (f[CLAVE.RIESGO] || "").toString(),
    severidad: (f[CLAVE.SEVERIDAD] || "BAJO").toString(),
    caso: (f[CLAVE.CASO] || "").toString(),
    area: (f[CLAVE.AREA] || "General").toString(),
    fuente: (f[CLAVE.FUENTE] || "").toString(),
    videoId: (f[CLAVE.VIDEO] || "").toString(),
    segundo: Number(f[CLAVE.SEGUNDO]) || 0,
    // [OPT-14] La invariante se reaplica AL LEER, no solo al escribir: las filas
    // migradas desde v2026.2.0 / v2026.4.0 pueden traer es_trampa=true con un
    // cebo inválido, y esas ya están en la hoja. Sin esto seguirían inflando el
    // denominador forense de por vida.
    esTrampa: trampaLeida.esTrampa,
    cebo: trampaLeida.cebo,
    tipoTrampa: trampaLeida.tipoTrampa,
    peso: parseInt(f[CLAVE.PESO], 10) || 1,
    procedencia: (f[CLAVE.PROCEDENCIA] || PROCEDENCIA.GENERADA).toString(),
    validacion: (f[CLAVE.VALIDACION] || VALIDACION.BORRADOR).toString()
  };
}

// -------------------------------------------------------------------------------------
// 9.2 Tests de práctica en Google Forms — CONGELADO
// -------------------------------------------------------------------------------------

function crearFormularioParaVideo(titulo, dificultad) {
  const form = FormApp.create(`Práctica: ${titulo} (${dificultad})`);
  form.setIsQuiz(true);
  form.setAllowResponseEdits(false);
  // setShowLinkToRespondAgain evita reenvíos sin exigir cuenta de Google,
  // a diferencia de setLimitOneResponsePerUser, que obliga a iniciar sesión.
  try { form.setShowLinkToRespondAgain(false); } catch (e) { /* API antigua */ }
  form.setDescription(
    `Test de práctica generado por la Videoteca (${VERSION_SCRIPT}).\n\n` +
    `• Video: ${titulo}\n• Dificultad: ${dificultad}\n` +
    `• Este test NO certifica: el examen oficial del módulo se presenta en el portal.`
  );
  form.addTextItem().setTitle("Nombre Completo del Alumno / Colaborador").setRequired(true);
  form.addTextItem().setTitle("Correo Electrónico Institucional").setRequired(true);
  return form;
}

/** Inserta las preguntas en el formulario y devuelve el detalle normalizado. */
function crearPreguntasEnForm(form, preguntas, ctx) {
  const normalizadas = [];
  const contexto = ctx || {};

  preguntas.forEach((p, idx) => {
    const tipo = p.tipo || "multiple";
    let item = null;

    if (tipo === "verdadero_falso") {
      item = form.addMultipleChoiceItem();
      item.setTitle(`${idx + 1}. ${p.pregunta}`).setRequired(true);
      const indice = (p.correcta === "verdadero" || p.correcta === true || p.correcta === 0) ? 0 : 1;
      item.setChoices([item.createChoice("Verdadero", indice === 0), item.createChoice("Falso", indice === 1)]);
      item.setPoints(1);
      p.opciones = ["Verdadero", "Falso"];
      p.correcta = indice;
    } else if (tipo === "completar") {
      item = form.addTextItem();
      item.setTitle(`${idx + 1}. ${p.pregunta}`).setRequired(true);
    } else {
      item = form.addMultipleChoiceItem();
      item.setTitle(`${idx + 1}. ${p.pregunta}`).setRequired(true);
      const opciones = p.opciones || [];
      let correcta = parseInt(p.correcta, 10);
      if (isNaN(correcta)) correcta = 0;
      item.setChoices(opciones.map((op, i) => item.createChoice(op, i === correcta)));
      item.setPoints(1);
    }

    if (item && typeof item.setFeedbackForCorrect === "function") {
      try {
        const fb = FormApp.createFeedback()
          .setText(`[Justificación]: ${p.justificacion || "Respuesta correcta."}`).build();
        item.setFeedbackForCorrect(fb);
        item.setFeedbackForIncorrect(fb);
      } catch (e) { /* los ítems de texto no admiten feedback */ }
    }

    normalizadas.push(normalizarPregunta(p, {
      examenId: contexto.examenId || form.getId(),
      moduloId: "",                       // la práctica nunca pertenece a un módulo
      numero: idx + 1,
      videoId: contexto.videoId || "",
      fuente: contexto.fuente || "",
      procedencia: PROCEDENCIA.GENERADA,  // marcado que impide que un examen la arrastre
      validacion: VALIDACION.BORRADOR
    }));
  });

  return normalizadas;
}

function vincularQuizEnCatalogo(filaCatalogo, formUrl, formId) {
  exigirOrigenInterno("vincularQuizEnCatalogo");
  const hoja = obtenerHojaDatos();
  hoja.getRange(filaCatalogo, IDX.URL_FORM + 1).setValue(formUrl);
  hoja.getRange(filaCatalogo, IDX.ID_FORM + 1).setValue(formId);
}

function obtenerContenidoEstudio(resumen, driveId) {
  if (driveId) {
    try {
      const txt = recuperarTextoPesado_(driveId);
      if (txt && txt.indexOf("[Error al leer archivo RAG") !== 0) return txt.slice(0, 12000);
    } catch (e) { /* usa el resumen */ }
  }
  return (resumen || "").toString();
}

/** Genera tests de práctica en lotes de LOTE_MAX_EXAMENES. */
function generarExamenesLote(limite = LOTE_MAX_EXAMENES) {
  let generados = 0;
  let pendientes = 0;

  iterarCatalogoPorBloques(function (datos, filaInicio) {
    let mutado = false;
    for (let i = 0; i < datos.length; i++) {
      const idVideo = (datos[i][IDX.ID] || "").toString().trim();
      const titulo = (datos[i][IDX.TITULO] || "").toString().trim();
      const urlForm = (datos[i][IDX.URL_FORM] || "").toString().trim();
      if (!idVideo || !titulo) continue;
      if (urlForm && urlForm.indexOf("https://docs.google.com/forms") === 0) continue;
      if (generados >= limite) { pendientes++; continue; }

      const filaNum = filaInicio + i;
      const dificultad = (datos[i][IDX.DIFICULTAD] || "").toString().trim() || "Principiante";
      try {
        const contenido = obtenerContenidoEstudio(datos[i][IDX.RESUMEN], (datos[i][IDX.DRIVE_RAG] || "").toString().trim());
        const cantidad = dificultad === "Principiante" ? 5 : (dificultad === "Intermedio" ? 8 : 10);

        const raw = llamarModeloIA(obtenerPrompt("evaluacion_educativa", {
          dificultad: dificultad, cantidad: cantidad.toString(), titulo: titulo, texto: contenido
        }), obtenerConfigIA().proveedor, 3500);

        const parsed = extraerJsonDesdeTexto(raw);
        if (!parsed || !parsed.preguntas || parsed.preguntas.length === 0) throw new Error(t("err_json_invalido"));

        const form = crearFormularioParaVideo(titulo, dificultad);
        const normalizadas = crearPreguntasEnForm(form, parsed.preguntas, { examenId: form.getId(), videoId: idVideo });
        guardarClavesEnSheet(form.getId(), idVideo, normalizadas);

        datos[i][IDX.URL_FORM] = form.getPublishedUrl();
        datos[i][IDX.ID_FORM] = form.getId();
        mutado = true;
        generados++;
        logInfo("Práctica", `Test creado para ${titulo} (${normalizadas.length} preguntas).`);
      } catch (err) {
        gestionarErrorFila(filaNum, `Error creando test: ${err.message}`, datos[i][IDX.URL], titulo, err.stack,
          deducirCodigoHttpDesdeError(err.message));
      }
    }
    return mutado;
  });

  return { generados: generados, pendientes: pendientes };
}

function generarExamenesPendientesParaCatalogo() {
  exigirOrigenInterno("generarExamenesPendientesParaCatalogo");
  const res = generarExamenesLote(LOTE_MAX_EXAMENES);
  if (res.generados === 0) { notificarUsuario(t("toast_examenes_al_dia"), "Práctica", 4); return res; }

  notificarUsuario(t("toast_examenes_lote", { generados: res.generados, pendientes: res.pendientes }), "Práctica", 6);
  invalidarCacheAPI();

  if (res.pendientes > 0 && hayInterfazDisponible()) {
    if (preguntarUsuario(t("alert_titulo_lms"),
      t("toast_examenes_lote", { generados: res.generados, pendientes: res.pendientes }) + "\n\n" +
      t("alert_examenes_mas", { lote: LOTE_MAX_EXAMENES }), false)) {
      return generarExamenesPendientesParaCatalogo();
    }
  }
  return res;
}

function generarSiguienteLoteExamenes() {
  exigirOrigenInterno("generarSiguienteLoteExamenes");
  const res = generarExamenesLote(LOTE_MAX_EXAMENES);
  notificarUsuario(res.generados > 0
    ? t("toast_examenes_lote", { generados: res.generados, pendientes: res.pendientes })
    : t("toast_examenes_al_dia"), "Práctica", 5);
  return res;
}

function generarExamenesPendientesBatchUI() {
  return generarExamenesPendientesParaCatalogo();
}

/**
 * Los tests de práctica ya NO instalan disparadores: liberan el presupuesto de 19
 * y evitan el defecto por el que, a partir del formulario ~17, nada se calificaba.
 * La función se conserva para quien mantenga formularios heredados y quiera
 * seguir registrándolos, con aviso explícito.
 */
function sincronizarTriggersFormularios() {
  exigirOrigenInterno("sincronizarTriggersFormularios");
  const seguir = preguntarUsuario("Triggers de formularios",
    "Los tests de práctica ya no necesitan disparadores: la certificación ocurre en el portal.\n\n" +
    "Instalar triggers consume el presupuesto de 19 y, superado ese número, las respuestas dejan de calificarse.\n\n" +
    "¿Deseas instalarlos igualmente para formularios heredados?", false);
  if (!seguir) {
    notificarUsuario("Sincronización omitida: los tests de práctica no requieren triggers.", "LMS", 5);
    return 0;
  }

  const hoja = obtenerHojaDatos();
  const ultimaFila = hoja.getLastRow();
  if (ultimaFila < 2) return 0;

  const conTrigger = {};
  ScriptApp.getProjectTriggers().forEach(trg => {
    if (trg.getHandlerFunction() === "registrarRespuestaFormularioCentralizado_") {
      try { const src = trg.getTriggerSourceId(); if (src) conTrigger[src] = true; } catch (e) { /* ignora */ }
    }
  });

  const ids = hoja.getRange(2, IDX.ID_FORM + 1, ultimaFila - 1, 1).getValues();
  let creados = 0;
  for (let i = 0; i < ids.length; i++) {
    const idForm = (ids[i][0] || "").toString().trim();
    if (!idForm || conTrigger[idForm]) continue;
    if (ScriptApp.getProjectTriggers().length >= LIMITE_TRIGGERS_SEGURO) {
      logWarn("LMS", t("err_triggers_limite", { limite: LIMITE_TRIGGERS_SEGURO }));
      break;
    }
    try {
      ScriptApp.newTrigger("registrarRespuestaFormularioCentralizado_").forForm(FormApp.openById(idForm)).onFormSubmit().create();
      conTrigger[idForm] = true;
      creados++;
    } catch (e) {
      logWarn("LMS", `No se pudo vincular trigger para ${idForm}: ${e.message}`);
    }
  }
  notificarUsuario(`Triggers sincronizados: ${creados}.`, "LMS", 4);
  return creados;
}

/**
 * Recepción de respuestas de formularios heredados.
 * Calificación por porcentaje de aciertos y alerta al tutor SOLO si reprueba.
 */
function registrarRespuestaFormularioCentralizado_(e) {
  marcarOrigenConfiable();   // [SEC-1] entrada legítima del servidor
  try {
    const resp = e.response;
    const form = e.source;
    const formId = form.getId();

    let nombre = "";
    let correo = "";
    try { correo = resp.getRespondentEmail() || ""; } catch (err) { correo = ""; }

    resp.getItemResponses().forEach(it => {
      const tit = it.getItem().getTitle().toLowerCase();
      if (tit.indexOf("nombre completo") !== -1) nombre = it.getResponse();
      if (!correo && (tit.indexOf("correo") !== -1 || tit.indexOf("email") !== -1)) correo = it.getResponse();
    });
    correo = (correo || "").toString().trim().toLowerCase();

    // Numeración leída del prefijo del enunciado: el índice de iteración se desfasa
    // cuando el examen tiene preguntas de completar (no calificables en Forms).
    const detalle = [];
    let aciertos = 0;
    let evaluadas = 0;

    resp.getGradableItemResponses().forEach(rg => {
      const titulo = rg.getItem().getTitle();
      const m = titulo.match(/^\s*(\d+)\s*\./);
      const numero = m ? parseInt(m[1], 10) : (detalle.length + 1);
      const score = rg.getScore() || 0;
      const correcta = score > 0;
      if (correcta) aciertos++;
      evaluadas++;
      detalle.push({ numeroPregunta: numero, esCorrecta: correcta, resultado: correcta ? RESULTADO.ACIERTO : RESULTADO.ERROR });
    });

    const total = evaluadas || 1;
    const notaPct = parseFloat(((aciertos / total) * 100).toFixed(1));
    const escala = resolverNivelDesempeno(notaPct);

    let urlCertificado = "";
    if (escala.certifica && correo) {
      urlCertificado = generarCertificadoAprobado({
        estudiante: nombre || "Estudiante", correo: correo,
        tituloExamen: form.getTitle(), notaPorcentaje: notaPct,
        nivel: escala.nivel, formId: formId
      });
    }
    if (escala.refuerzo && correo) generarPlanDeRefuerzo(correo, formId, detalle);

    registrarCalificacion({
      fecha: resp.getTimestamp(), estudiante: nombre || "Estudiante", correo: correo || "Sin correo",
      evaluacion: form.getTitle(), formId: formId, aciertos: aciertos, total: total,
      porcentaje: notaPct, nivel: escala.nivel, certifica: escala.certifica,
      urlCertificado: urlCertificado, moduloId: "", intentoId: ""
    });

    logInfo("Calificación", `${nombre || "Estudiante"}: ${notaPct}% en ${form.getTitle()}`);

    // [F1-8] La alerta al tutor se dispara SOLO al reprobar, no en cada entrega.
    if (!escala.certifica) {
      procesarAlertaCalificacion({
        estudiante: nombre || "Estudiante", correo: correo, tituloExamen: form.getTitle(),
        notaPorcentaje: notaPct, nivel: escala.nivel, idFormulario: formId
      });
    }
  } catch (err) {
    logError("LMS", "Error procesando respuesta de formulario: " + err.message);
  }
}

/** Escritura unificada del historial de calificaciones (12 columnas). */
function registrarCalificacion(d) {
  exigirOrigenInterno("registrarCalificacion");
  const hist = asegurarHojaSistema("_Historial_Calificaciones");
  hist.insertRowBefore(2);
  hist.getRange(2, 1, 1, 12).setValues([[
    d.fecha || new Date(), d.estudiante, d.correo, d.evaluacion, d.formId || "",
    d.aciertos, d.total, (Number(d.porcentaje) || 0) / 100,
    d.certifica ? "🟢 APROBADO" : (Number(d.porcentaje) >= 60 ? "🟡 APROBADO CON RESERVAS" : "❌ REPROBADO"),
    d.urlCertificado || "", d.moduloId || "", d.intentoId || ""
  ]]);
  hist.getRange(2, 8).setNumberFormat("0.0%");
  return true;
}

/** Escribe a posteriori la URL de un certificado en su fila de historial. */
function indexarCertificadoEnSheets(correo, referencia, urlCertificado) {
  exigirOrigenInterno("indexarCertificadoEnSheets");
  const hist = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("_Historial_Calificaciones");
  if (!hist || hist.getLastRow() < 2) return false;
  const datos = hist.getRange(2, 1, hist.getLastRow() - 1, 12).getValues();
  for (let i = 0; i < datos.length; i++) {
    const coincideRef = (datos[i][4] || "").toString().trim() === referencia ||
                        (datos[i][11] || "").toString().trim() === referencia;
    if (coincideRef && (datos[i][2] || "").toString().trim().toLowerCase() === (correo || "").toLowerCase()) {
      hist.getRange(i + 2, 10).setValue(urlCertificado).setHorizontalAlignment("center");
      return true;
    }
  }
  return false;
}

// -------------------------------------------------------------------------------------
// 9.3 Refuerzo, recomendaciones y reevaluación
// -------------------------------------------------------------------------------------

function generarPlanDeRefuerzo(correoEstudiante, examenId, respuestasItem, moduloId = "") {
  exigirOrigenInterno("generarPlanDeRefuerzo");
  const claves = leerClavesExamen(moduloId ? { moduloId: moduloId } : { examenId: examenId });
  if (claves.length === 0) return 0;

  const refuerzoSheet = asegurarHojaSistema("_Progreso_Refuerzo");
  const mapaUrls = {};
  iterarCatalogoPorBloques(function (datos) {
    datos.forEach(r => { if (r[IDX.ID]) mapaUrls[r[IDX.ID].toString().trim()] = r[IDX.URL]; });
    return false;
  });

  const nuevas = [];
  (respuestasItem || []).forEach(r => {
    if (r.esCorrecta) return;
    const q = claves.find(c => c.numero === r.numeroPregunta);
    if (!q) return;
    const urlBase = mapaUrls[q.videoId] || "";
    nuevas.push([
      nuevoId("tsk"),
      (correoEstudiante || "").toString().toLowerCase().trim(),
      moduloId || examenId,
      r.numeroPregunta,
      (q.area || "General") + ": " + q.texto.slice(0, 60),
      `${q.fuente || q.videoId} @ ${formatearSegundos(q.segundo)}`,
      construirEnlaceConSegundo(urlBase, q.segundo),
      q.causaRaiz || (r.resultado === RESULTADO.OMISION ? "Omisión: posible visualización incompleta" : "Refuerzo automático"),
      new Date(), "PENDIENTE", "", 0
    ]);
  });

  if (nuevas.length > 0) {
    refuerzoSheet.getRange(refuerzoSheet.getLastRow() + 1, 1, nuevas.length, 12).setValues(nuevas);
    enviarEmailRefuerzo(correoEstudiante, examenId, nuevas.length);
    logInfo("Refuerzo", `${nuevas.length} tareas asignadas a ${correoEstudiante}.`);
  }
  return nuevas.length;
}

function marcarTareaRefuerzoVista(token, idTarea) {
  validarTokenConScope(token, "read_only");
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("_Progreso_Refuerzo");
  if (!sheet || sheet.getLastRow() < 2) return { exito: false };

  const datos = sheet.getRange(2, 1, sheet.getLastRow() - 1, 12).getValues();
  for (let i = 0; i < datos.length; i++) {
    if (datos[i][0] === idTarea) {
      sheet.getRange(i + 2, 10).setValue("VISTO");
      sheet.getRange(i + 2, 11).setValue(new Date());
      sheet.getRange(i + 2, 12).setValue((parseInt(datos[i][11], 10) || 0) + 1);
      return { exito: true };
    }
  }
  return { exito: false, mensaje: "Tarea no encontrada." };
}

