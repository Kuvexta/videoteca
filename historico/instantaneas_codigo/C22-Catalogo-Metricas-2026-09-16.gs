/**
 * [v2.6.10] «Sincronizar Todo», pero empezando por la fila que se le diga.
 *
 * Existe porque en un catálogo de miles de filas el ciclo completo casi nunca
 * cabe en una ejecución, y volver a lanzarlo desde el principio significa pagar
 * otra vez por las tres mil filas que ya estaban bien para llegar a las que
 * faltan. Con el número de fila delante, retomar cuesta lo que falta.
 *
 * Qué acota y qué NO, que es la parte que importa:
 *   ACOTADO   Fase 1, dificultad, reclasificación y métricas. Son las etapas
 *             que trabajan fila a fila; ahí «desde la 500» significa algo.
 *   COMPLETO  El tablero, las exportaciones a JSON y la caducidad de intentos.
 *             Son resúmenes de TODO el catálogo: calcularlos con un trozo
 *             daría un tablero que dice que existen 200 videos porque solo se
 *             miraron 200. Van después y sin ventana, a propósito.
 *
 * @param {number} desde  primera fila de datos.
 * @param {number} hasta  última fila, o 0 para llegar hasta el final.
 */
function actualizarTodoDesdeFila(desde, hasta) {
  exigirOrigenInterno("actualizarTodoDesdeFila");
  const props = PropertiesService.getScriptProperties();
  const checkpointPrevio = props.getProperty("INGESTA_CHECKPOINT");
  let resultado = { desde: desde, hasta: hasta, completado: false };

  try {
    /* Fase 1 no se recorre con iterarCatalogoPorBloques: lleva su propio bucle y
       arranca donde diga INGESTA_CHECKPOINT. Así que la fila de inicio se le
       comunica por ahí, que es el mecanismo que ya tenía, en vez de inventarle
       otro al lado. */
    limpiarTriggersIngesta();
    props.setProperty("INGESTA_CHECKPOINT", String(desde));

    conVentanaDeFilas(desde, hasta, function () {
      procesarColaConAntiTimeout_(true);
      actualizarDificultadCatalogo();
      reevaluarClasificacionYResumen(true);
      actualizarSoloMetricas(true);
    });

    /* Sin ventana: los agregados miran el catálogo entero. */
    crearDashboardTiempoReal();
    exportarCatalogoAJsonSilencioso_();
    caducarIntentosAbandonados();
    try { exportarCertificacionesAJson(); } catch (e) { logWarn("Sincronizar desde fila", "Certificaciones: " + e.message); }
    invalidarCacheAPI();

    resultado.completado = true;
    logInfo("Sincronizar desde fila",
      `Ciclo ejecutado sobre las filas ${desde}–${hasta || "final"}.`);
  } catch (e) {
    logError("Sincronizar desde fila", e.message);
    throw e;
  } finally {
    /* Con fila final, la continuación automática de Fase 1 sería una trampa: el
       disparador encadenado se ejecuta en OTRA invocación, donde la ventana ya
       no existe, así que seguiría desde el checkpoint hasta el final del
       catálogo — justo lo que se pidió no hacer. Se corta la cadena y se
       devuelve el checkpoint a como estaba, para no llevarse por delante una
       ingesta completa que estuviera a medias. */
    if (hasta) {
      limpiarTriggersIngesta();
      if (checkpointPrevio) props.setProperty("INGESTA_CHECKPOINT", checkpointPrevio);
      else props.deleteProperty("INGESTA_CHECKPOINT");
    }
  }
  return resultado;
}

/** Pide la fila (o el rango) y ejecuta el ciclo acotado. */
function actualizarTodoDesdeFilaUI() {
  exigirOrigenInterno("actualizarTodoDesdeFilaUI");
  const hoja = obtenerHojaDatos();
  const ultima = hoja.getLastRow();
  if (ultima < 2) { alertarUsuario(t("alert_catalogo_vacio")); return; }

  const texto = solicitarTexto("🔢 Sincronizar desde una fila",
    "Número de la fila por la que empezar (la 2 es la primera con datos).\n\n" +
    "También admite un rango: «500-800».\n\n" +
    "El catálogo llega hasta la fila " + ultima + ".");
  if (!texto) return;

  /* Se acepta «500» y «500-800». Un solo campo en vez de dos diálogos: pedir dos
     veces para un caso que casi siempre es «desde aquí hasta el final» convierte
     en trámite lo que debería ser escribir un número. */
  const m = texto.replace(/\s/g, "").match(/^(\d+)(?:[-–](\d+))?$/);
  if (!m) {
    alertarUsuario("No entendí «" + texto.slice(0, 40) + "».\n\n" +
      "Escribe un número de fila (por ejemplo 500) o un rango (500-800).", "Sincronizar");
    return;
  }

  const desde = parseInt(m[1], 10);
  const hasta = m[2] ? parseInt(m[2], 10) : 0;

  if (desde < 2) {
    alertarUsuario("La fila 1 es la de los títulos de columna.\n\n" +
      "La primera fila con datos es la 2.", "Sincronizar");
    return;
  }
  if (desde > ultima) {
    alertarUsuario("La fila " + desde + " está más allá del final del catálogo, " +
      "que termina en la " + ultima + ".\n\nNo habría nada que procesar.", "Sincronizar");
    return;
  }
  if (hasta && hasta < desde) {
    alertarUsuario("El rango está al revés: " + desde + "-" + hasta + ".", "Sincronizar");
    return;
  }

  const finReal = hasta ? Math.min(hasta, ultima) : ultima;
  const ui = SpreadsheetApp.getUi();
  const r = ui.alert("Sincronizar desde una fila",
    `Filas ${desde} a ${finReal}  (${finReal - desde + 1} de ${ultima - 1})\n\n` +
    "Se ejecutará sobre ese tramo:\n" +
    "  • Fase 1 (metadatos, sin IA)\n" +
    "  • Dificultad\n" +
    "  • Reclasificación y resumen (SIN forzar)\n" +
    "  • Métricas de vistas y likes\n\n" +
    "Y después, sobre el catálogo COMPLETO —son resúmenes y no tendrían\n" +
    "sentido calculados a trozos—:\n" +
    "  • Tablero, exportaciones JSON y caducidad de intentos\n\n" +
    (hasta
      ? "Al indicar fila final, la ingesta NO se encadena sola: si el tramo no\ncabe en una ejecución, vuelve a lanzarlo.\n\n"
      : "Si el tramo no cabe en una ejecución, la ingesta se encadena sola.\n\n") +
    "¿Continuar?", ui.ButtonSet.YES_NO);
  if (r !== ui.Button.YES) return;

  try {
    actualizarTodoDesdeFila(desde, hasta);
    alertarUsuario(
      `Ciclo ejecutado sobre las filas ${desde}–${finReal}.\n\n` +
      "Revisa el registro para el detalle de cada etapa.",
      "Sincronizar desde fila");
  } catch (e) {
    alertarUsuario("Fallo durante el ciclo: " + e.message, "Sincronizar desde fila");
  }
}

/**
 * La huella con la que se decide si dos filas son el mismo video.
 *
 * [v2.6.15] Antes se miraba solo el ID, y las filas SIN ID se saltaban con un
 * `continue`. Eso dejaba fuera justo a las duplicadas que cuestan dinero: una
 * fila tiene ID porque ya se ingirió bien, así que el deduplicador solo veía a
 * las que ya no daban problema. En el catálogo real eso significaba 4.500 filas
 * revisadas y 4.069 invisibles, con 1.651 sobrantes entre ellas.
 *
 * Sin ID se usa la URL normalizada: sin protocolo, sin «www.», sin barra final,
 * sin parámetros de campaña ni marca de tiempo. `youtu.be/X?t=30` y
 * `youtu.be/X` son la misma fila para una persona, y deben serlo aquí.
 */
function huellaDeFila(id, url) {
  const idLimpio = (id || "").toString().trim();
  if (idLimpio) return "id:" + idLimpio;
  let u = (url || "").toString().trim().toLowerCase();
  if (!u) return "";
  u = u.replace(/^https?:\/\//, "").replace(/^www\./, "");
  u = u.replace(/[?&](utm_[^=&]+|feature|si|t|start|list_index)=[^&]*/g, "");
  u = u.replace(/[?&]$/, "").replace(/\/+$/, "");
  return "url:" + u;
}

/**
 * Cuenta las filas repetidas sin tocar nada. Se usa para la vista previa y para
 * las pruebas: borrar filas del catálogo de alguien no es una operación que
 * deba estrenarse a ciegas.
 */
function analizarDuplicados() {
  const hoja = obtenerHojaDatos();
  const ultFila = hoja.getLastRow();
  if (ultFila < 2) return { sobrantes: 0, grupos: 0, porId: 0, porUrl: 0, ejemplos: [] };

  const datos = hoja.getRange(2, 1, ultFila - 1, TOTAL_COLUMNAS).getValues();
  const cuenta = {};
  datos.forEach(f => {
    const h = huellaDeFila(f[IDX.ID], f[IDX.URL]);
    if (!h) return;
    if (!cuenta[h]) cuenta[h] = { n: 0, muestra: f[IDX.TITULO] || f[IDX.URL] };
    cuenta[h].n++;
  });

  let sobrantes = 0, grupos = 0, porId = 0, porUrl = 0;
  const ejemplos = [];
  Object.keys(cuenta).forEach(h => {
    if (cuenta[h].n < 2) return;
    grupos++;
    sobrantes += cuenta[h].n - 1;
    if (h.indexOf("id:") === 0) porId += cuenta[h].n - 1; else porUrl += cuenta[h].n - 1;
    if (ejemplos.length < 8) {
      ejemplos.push(cuenta[h].n + "× " + (cuenta[h].muestra || "").toString().slice(0, 70));
    }
  });
  return { sobrantes: sobrantes, grupos: grupos, porId: porId, porUrl: porUrl, ejemplos: ejemplos };
}

/**
 * Borra las filas repetidas, conservando SIEMPRE la primera de cada grupo.
 *
 * `confirmado` existe para que la versión con interfaz pueda enseñar antes lo
 * que va a pasar. Llamarla sin confirmar no borra nada: devuelve el análisis.
 */
function eliminarVideosDuplicados(confirmado) {
  exigirOrigenInterno("eliminarVideosDuplicados");
  const hoja = obtenerHojaDatos();
  const ultFila = hoja.getLastRow();
  if (ultFila < 2) return 0;

  if (confirmado === false) return analizarDuplicados();

  const datos = hoja.getRange(2, 1, ultFila - 1, TOTAL_COLUMNAS).getValues();
  const vistos = {};
  let borradas = 0;

  /* De abajo arriba: al borrar una fila, las de encima no cambian de número.
     Recorrer al revés y quedarse con la PRIMERA aparición son dos cosas que
     hay que hacer a la vez, y por eso se marca lo visto en una pasada previa
     de arriba abajo en vez de fiarse del orden del bucle. */
  const primeraAparicion = {};
  datos.forEach((f, i) => {
    const h = huellaDeFila(f[IDX.ID], f[IDX.URL]);
    if (h && !(h in primeraAparicion)) primeraAparicion[h] = i;
  });

  for (let i = datos.length - 1; i >= 0; i--) {
    const h = huellaDeFila(datos[i][IDX.ID], datos[i][IDX.URL]);
    if (!h) continue;
    if (primeraAparicion[h] !== i) {
      hoja.deleteRow(i + 2);
      borradas++;
    }
    vistos[h] = true;
  }

  invalidarCacheAPI();
  logInfo("Limpieza", `Eliminadas ${borradas} filas duplicadas (por ID y por URL).`);
  notificarUsuario(t("toast_duplicados", { total: borradas }), "Limpieza", 4);
  return borradas;
}

/** Enseña lo que se va a borrar y solo borra si la persona dice que sí. */
function eliminarVideosDuplicadosUI() {
  exigirOrigenInterno("eliminarVideosDuplicadosUI");
  const ui = SpreadsheetApp.getUi();
  const a = analizarDuplicados();
  if (a.sobrantes === 0) {
    alertarUsuario("No hay filas repetidas en el catálogo.", "Limpieza");
    return 0;
  }
  const resp = ui.alert("Filas repetidas",
    `Hay ${a.sobrantes} filas de más, repartidas en ${a.grupos} videos repetidos.\n` +
    `  · ${a.porId} se detectan por ID (ya ingeridas)\n` +
    `  · ${a.porUrl} por URL (aún sin ID)\n\n` +
    (a.ejemplos.length ? "Por ejemplo:\n" + a.ejemplos.join("\n") + "\n\n" : "") +
    "Se conserva siempre la primera de cada grupo. ¿Borrar el resto?",
    ui.ButtonSet.YES_NO);
  if (resp !== ui.Button.YES) return 0;
  return eliminarVideosDuplicados(true);
}

function limpiarFilasInvalidas() {
  exigirOrigenInterno("limpiarFilasInvalidas");
  const hoja = obtenerHojaDatos();
  const ultFila = hoja.getLastRow();
  if (ultFila < 2) return 0;

  // Se lee la fila entera y se comprueban los tres campos por IDX. Leer «las
  // tres primeras columnas» funcionaba solo mientras URL, ID y Título siguieran
  // siendo las tres primeras: al mover una, esta limpieza empezaría a borrar
  // filas mirando campos que no son.
  const datos = hoja.getRange(2, 1, ultFila - 1, TOTAL_COLUMNAS).getValues();
  let borradas = 0;
  for (let i = datos.length - 1; i >= 0; i--) {
    const vacio = !(datos[i][IDX.URL] || "").toString().trim() &&
                  !(datos[i][IDX.ID] || "").toString().trim() &&
                  !(datos[i][IDX.TITULO] || "").toString().trim();
    if (vacio) { hoja.deleteRow(i + 2); borradas++; }
  }
  notificarUsuario(t("toast_invalidas", { total: borradas }), "Limpieza", 4);
  return borradas;
}

