/** Crea o repara una hoja concreta según ESQUEMAS_HOJAS. Devuelve la hoja. */
function asegurarHojaSistema(nombre) {
  exigirOrigenInterno("asegurarHojaSistema");
  const cfg = ESQUEMAS_HOJAS[nombre];
  if (!cfg) throw new Error("Hoja no declarada en el esquema: " + nombre);

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let hoja = ss.getSheetByName(nombre);

  if (!hoja) {
    hoja = ss.insertSheet(nombre);
    hoja.getRange(1, 1, 1, cfg.headers.length).setValues([cfg.headers])
      .setFontWeight("bold").setBackground(cfg.color).setFontColor("#ffffff");
    if (cfg.semilla && cfg.semilla.length > 0) {
      hoja.getRange(2, 1, cfg.semilla.length, cfg.headers.length).setValues(cfg.semilla);
    }
    hoja.setFrozenRows(1);
    if (cfg.oculta) { try { hoja.hideSheet(); } catch (e) { /* la última visible no se puede ocultar */ } }
    logInfo("Config", `Hoja ${nombre} creada.`);
    return hoja;
  }

  // Reparación no destructiva de cabeceras faltantes o incompletas.
  if (hoja.getMaxColumns() < cfg.headers.length) {
    hoja.insertColumnsAfter(hoja.getMaxColumns(), cfg.headers.length - hoja.getMaxColumns());
  }
  const actual = hoja.getRange(1, 1, 1, cfg.headers.length).getValues()[0];
  let requiereFix = false;
  for (let c = 0; c < cfg.headers.length; c++) {
    if (!actual[c]) { requiereFix = true; break; }
  }
  if (requiereFix) {
    hoja.getRange(1, 1, 1, cfg.headers.length).setValues([cfg.headers])
      .setFontWeight("bold").setBackground(cfg.color).setFontColor("#ffffff");
    hoja.setFrozenRows(1);
    logWarn("Config", `Cabeceras reparadas en ${nombre}.`);
  }
  return hoja;
}

/**
 * [F0-3] Verifica y repara TODAS las hojas del sistema. Se invoca en onOpen.
 * Incluye la migración del banco de preguntas si detecta un esquema antiguo.
 */
function verificarYEstructurarHojasConfig(silencioso = true) {
  let reparadas = 0;
  Object.keys(ESQUEMAS_HOJAS).forEach(nombre => {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const existia = Boolean(ss.getSheetByName(nombre));
    try {
      asegurarHojaSistema(nombre);
      if (!existia) reparadas++;
    } catch (e) {
      logError("Config", `No se pudo asegurar ${nombre}: ${e.message}`);
    }
  });

  // Semillas enriquecidas que no caben en una tabla plana.
  crearPestanaConfigPrompts();
  crearPestanaConfigTaxonomia();

  // [F0-2] Migración del banco de preguntas si hace falta.
  try { migrarBancoPreguntas(true); } catch (e) { logError("Migración", e.message); }

  /* [v2.6.10] El filtro de la fila 1. Va aquí y no en un botón que haya que
     acordarse de pulsar, porque su momento de romperse es justo el que nadie
     mira: al importar filas nuevas el filtro se queda cubriendo el rango viejo,
     y a partir de ahí filtrar «Alcance = Pendiente» deja fuera las últimas
     importadas sin avisar de nada. Es no-operación cuando ya está bien, así que
     no cuesta nada en cada apertura. */
  try { asegurarFiltroCatalogo(); } catch (e) { logWarn("Filtro", e.message); }

  if (!silencioso && reparadas > 0) {
    notificarUsuario(t("toast_config_reparada", { reparadas: reparadas }), "Config", 4);
  }
  return reparadas;
}

/**
 * [F0-2] Detecta el esquema instalado de _Claves_Examenes y lo migra al unificado.
 * Reconoce: v2026.2.0 (13 columnas, col4 = Opciones_JSON) y v2026.4.0 (14 columnas, col4 = Tipo).
 * Escribir sin migrar desplazaría las columnas y corrompería la calificación en silencio.
 */
function migrarBancoPreguntas(silencioso = false) {
  exigirOrigenInterno("migrarBancoPreguntas");
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let hoja = ss.getSheetByName("_Claves_Examenes");
  if (!hoja) { asegurarHojaSistema("_Claves_Examenes"); return { migradas: 0, esquema: "nuevo" }; }

  const ancho = Math.max(1, hoja.getLastColumn());
  const cabecera = hoja.getRange(1, 1, 1, ancho).getValues()[0].map(c => (c || "").toString().trim());

  // Ya está en el esquema unificado.
  if (cabecera[1] === "Modulo_Id" && cabecera[23] === "Estado_Validacion") {
    return { migradas: 0, esquema: "unificado" };
  }

  let esquema = null;
  if (cabecera[3] === "Opciones_JSON") esquema = "v2026.2.0";
  else if (cabecera[3] === "Tipo") esquema = "v2026.4.0";
  else if (!cabecera[0]) { asegurarHojaSistema("_Claves_Examenes"); return { migradas: 0, esquema: "vacio" }; }

  if (!esquema) {
    logWarn("Migración", "Esquema de _Claves_Examenes no reconocido; se deja intacto.");
    return { migradas: 0, esquema: "desconocido" };
  }

  const ultima = hoja.getLastRow();
  const filasViejas = ultima >= 2 ? hoja.getRange(2, 1, ultima - 1, ancho).getValues() : [];
  const nuevas = filasViejas.map(f => mapearFilaClaveAlEsquemaNuevo(f, esquema));

  // Reescritura completa con el esquema nuevo.
  hoja.clear();
  hoja.getRange(1, 1, 1, CABECERAS_CLAVES.length).setValues([CABECERAS_CLAVES])
    .setFontWeight("bold").setBackground("#0f766e").setFontColor("#ffffff");
  hoja.setFrozenRows(1);
  if (nuevas.length > 0) {
    hoja.getRange(2, 1, nuevas.length, CABECERAS_CLAVES.length).setValues(nuevas);
  }

  logWarn("Migración", `_Claves_Examenes migrada desde ${esquema}: ${nuevas.length} filas.`);
  if (!silencioso) notificarUsuario(t("toast_migracion_claves", { filas: nuevas.length }), "Migración", 6);
  return { migradas: nuevas.length, esquema: esquema };
}

/** Traduce una fila de cualquiera de los dos esquemas antiguos al unificado de 24 columnas. */
function mapearFilaClaveAlEsquemaNuevo(f, esquema) {
  const nueva = new Array(CABECERAS_CLAVES.length).fill("");

  if (esquema === "v2026.2.0") {
    // ID_Examen, Numero, Texto, Opciones, Indice_Correcto, Tipo_Trampa_IA, Indice_Cebo_IA,
    // Area, Video_Referencia, Timestamp, Causa_Raiz, Riesgo_Operativo, Peso_Puntos
    nueva[CLAVE.EXAMEN] = f[0] || "";
    nueva[CLAVE.NUMERO] = f[1] || "";
    nueva[CLAVE.TEXTO] = f[2] || "";
    nueva[CLAVE.TIPO] = "multiple";
    nueva[CLAVE.OPCIONES] = f[3] || "[]";
    nueva[CLAVE.CORRECTO] = f[4] === "" || f[4] === null ? -1 : f[4];
    nueva[CLAVE.TIPO_TRAMPA] = TIPOS_TRAMPA.indexOf((f[5] || "").toString()) !== -1 ? f[5] : "";
    nueva[CLAVE.TRAMPA] = f[5] ? true : false;
    nueva[CLAVE.CEBO] = (f[6] === "" || f[6] === null) ? -1 : f[6];
    nueva[CLAVE.AREA] = f[7] || "General";
    nueva[CLAVE.VIDEO] = f[8] || "";
    nueva[CLAVE.SEGUNDO] = convertirTimestampASegundos(f[9]);
    nueva[CLAVE.CAUSA] = f[10] || "";
    nueva[CLAVE.RIESGO] = f[11] || "";
    nueva[CLAVE.PESO] = f[12] || 1;
  } else {
    // v2026.4.0: ID_Examen, Numero, Texto, Tipo, Opciones, Indice_Correcto,
    // Respuesta_Correcta_Texto, Justificacion, Area, Video_Referencia, Timestamp,
    // Causa_Raiz, Riesgo_Operativo, Peso_Puntos
    nueva[CLAVE.EXAMEN] = f[0] || "";
    nueva[CLAVE.NUMERO] = f[1] || "";
    nueva[CLAVE.TEXTO] = f[2] || "";
    nueva[CLAVE.TIPO] = f[3] || "multiple";
    nueva[CLAVE.OPCIONES] = f[4] || "[]";
    nueva[CLAVE.CORRECTO] = (f[5] === "" || f[5] === null) ? -1 : f[5];
    nueva[CLAVE.RESP_TEXTO] = f[6] || "";
    nueva[CLAVE.JUSTIF] = f[7] || "";
    nueva[CLAVE.AREA] = f[8] || "General";
    nueva[CLAVE.VIDEO] = f[9] || "";
    nueva[CLAVE.SEGUNDO] = convertirTimestampASegundos(f[10]);
    nueva[CLAVE.CAUSA] = f[11] || "";
    nueva[CLAVE.RIESGO] = f[12] || "";
    nueva[CLAVE.PESO] = f[13] || 1;
    nueva[CLAVE.CEBO] = -1;
    nueva[CLAVE.TRAMPA] = false;
  }

  // Campos que ningún esquema antiguo tenía.
  nueva[CLAVE.MODULO] = "";
  nueva[CLAVE.CONFIG_OK] = nueva[CLAVE.CONFIG_OK] || "";
  nueva[CLAVE.SEVERIDAD] = nueva[CLAVE.SEVERIDAD] || "BAJO";
  nueva[CLAVE.CASO] = "";
  nueva[CLAVE.FUENTE] = "";
  // El material heredado entra como práctica hasta que una persona lo valide.
  nueva[CLAVE.PROCEDENCIA] = PROCEDENCIA.GENERADA;
  nueva[CLAVE.VALIDACION] = VALIDACION.BORRADOR;
  return nueva;
}

function migrarBancoPreguntasUI() {
  exigirOrigenInterno("migrarBancoPreguntasUI");
  const res = migrarBancoPreguntas(false);
  alertarUsuario(
    res.esquema === "unificado" ? "El banco ya está en el esquema unificado de 24 columnas."
      : `Migración desde ${res.esquema}: ${res.migradas} filas reescritas.\n\nLas preguntas heredadas quedaron como GENERADA / BORRADOR: revísalas antes de usarlas para certificar.`,
    "Banco de Preguntas");
}

