function obtenerRolFamiliar(email, scopeMaster) {
  if (scopeMaster === "admin") return "admin";
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("_Miembros_Familia");
  if (!sheet || sheet.getLastRow() < 2) return "member";

  const emailSanitizado = (email || "").toString().toLowerCase().trim();
  const datos = sheet.getRange(2, 1, sheet.getLastRow() - 1, 3).getValues();
  for (let i = 0; i < datos.length; i++) {
    if ((datos[i][0] || "").toString().toLowerCase().trim() === emailSanitizado) {
      return (datos[i][2] || "member").toString().toLowerCase().trim();
    }
  }
  return "member";
}

/**
 * [SEC-5] Acredita a una persona y le emite su credencial de acceso.
 *
 * Esta función nació para invitar a un familiar de paso y por eso emitía un token
 * de 7 días de un solo uso. Como credencial de un colaborador que cursa módulos
 * durante meses, eso significaba que el acceso moría a la semana, en silencio y
 * probablemente a mitad de un módulo. Ahora:
 *   · la vigencia es configurable, con 365 días por defecto;
 *   · el scope emitido es `exam`, que es lo que la persona realmente hace;
 *   · Usos_Max queda en 0 (sin tope) y Usos_Actual pasa a ser telemetría.
 */
function invitarMiembroFamilia(tokenAdmin, correo, nombre, rol = "member", diasVigencia = 365) {
  validarTokenConScope(tokenAdmin, "admin");
  const sheetMiembros = asegurarHojaSistema("_Miembros_Familia");

  const emailSanitizado = (correo || "").toString().trim().toLowerCase();
  const nombreLimpio = (nombre || "").toString().trim();
  const rolesPermitidos = ["admin", "editor", "gestor_eventos", "member"];
  if (rolesPermitidos.indexOf(rol) === -1) throw new Error(t("err_rol_invalido", { rol: rol }));
  if (!emailSanitizado) throw new Error(t("err_correo_requerido"));

  if (sheetMiembros.getLastRow() >= 2) {
    const correos = sheetMiembros.getRange(2, 1, sheetMiembros.getLastRow() - 1, 1).getValues().flat()
      .map(c => (c || "").toString().toLowerCase());
    if (correos.indexOf(emailSanitizado) !== -1) throw new Error(`El usuario ${emailSanitizado} ya está registrado.`);
  }

  const datosAdmin = obtenerDatosToken_(tokenAdmin) || { email: "Admin" };
  sheetMiembros.appendRow([emailSanitizado, nombreLimpio, rol, "FAM_DEFAULT", new Date(), datosAdmin.email || "Admin"]);

  const dias = parseInt(diasVigencia, 10);
  const diasValidos = (isNaN(dias) || dias < 0) ? 365 : dias;

  const tokenInvitacion = "inv_" + Utilities.getUuid().replace(/-/g, "").slice(0, 20);
  const scopeEmitido = rol === "admin" ? "admin" : "exam";

  const mapa = obtenerMapaTokens_();
  mapa[tokenInvitacion] = {
    scope: scopeEmitido,
    client: nombreLimpio || emailSanitizado,
    email: emailSanitizado
  };
  if (diasValidos > 0) mapa[tokenInvitacion].expira = new Date().getTime() + diasValidos * 86400000;
  guardarMapaTokens_(mapa);

  const sheetTokens = asegurarHojaSistema("_Tokens_Invitacion");
  const expiracion = diasValidos > 0 ? new Date(mapa[tokenInvitacion].expira) : "";
  // Usos_Max = 0 → sin tope. Usos_Actual se incrementa en cada canje como
  // telemetría: un token usado desde muchos accesos es una señal, no un bloqueo.
  sheetTokens.appendRow([tokenInvitacion, "FAM_DEFAULT", rol, expiracion, 0, 0, "activo"]);

  logInfo("Modo Familiar",
    `Acreditado ${nombreLimpio} (${emailSanitizado}) con rol ${rol}, scope ${scopeEmitido}, ` +
    (diasValidos > 0 ? `${diasValidos} días de vigencia.` : "sin caducidad."));
  return {
    exito: true,
    tokenAcceso: tokenInvitacion,
    rolAsignado: rol,
    scope: scopeEmitido,
    caduca: diasValidos > 0 ? formatearFecha(expiracion, "yyyy-MM-dd") : "nunca",
    enlace: construirEnlaceAcceso(tokenInvitacion)
  };
}

/** Enlace personal listo para enviar por correo o WhatsApp. */
function construirEnlaceAcceso(token) {
  try {
    const base = ScriptApp.getService().getUrl();
    return base ? base + "?token=" + encodeURIComponent(token) : "";
  } catch (e) {
    return "";
  }
}

/** Invitación asistida desde el menú. */
function invitarMiembroFamiliaUI() {
  exigirOrigenInterno("invitarMiembroFamiliaUI");
  const ui = SpreadsheetApp.getUi();
  const adminToken = obtenerTokenAdministrador_();
  if (!adminToken) { ui.alert(t("alert_sin_admin_token")); return; }

  const correo = ui.prompt("👨‍👩‍👧 Invitar Miembro", "Correo electrónico del invitado:", ui.ButtonSet.OK_CANCEL);
  if (correo.getSelectedButton() !== ui.Button.OK) return;
  const nombre = ui.prompt("Nombre", "Nombre visible del invitado:", ui.ButtonSet.OK_CANCEL);
  if (nombre.getSelectedButton() !== ui.Button.OK) return;
  const rol = ui.prompt("Rol", "admin, editor, gestor_eventos o member:", ui.ButtonSet.OK_CANCEL);
  if (rol.getSelectedButton() !== ui.Button.OK) return;

  const dias = ui.prompt("Vigencia del acceso",
    "Días de validez de la credencial.\n\nSugerido: 365 · Escribe 0 para que no caduque.",
    ui.ButtonSet.OK_CANCEL);
  if (dias.getSelectedButton() !== ui.Button.OK) return;

  try {
    const res = invitarMiembroFamilia(adminToken, correo.getResponseText(), nombre.getResponseText(),
      (rol.getResponseText() || "member").trim().toLowerCase(), dias.getResponseText().trim());

    ui.alert("Acceso creado",
      "Envía este enlace personal a " + correo.getResponseText().trim() + ":\n\n" +
      (res.enlace || "(publica primero la aplicación web para generar el enlace)") +
      "\n\nToken: " + res.tokenAcceso +
      "\nScope: " + res.scope + " · Caduca: " + res.caduca +
      "\n\nEs personal e intransferible: el correo va grabado en el token, así que " +
      "todo lo que haga con él queda a su nombre.", ui.ButtonSet.OK);
  } catch (e) {
    ui.alert("Error", e.message, ui.ButtonSet.OK);
  }
}

function crearListaFamiliar(token, nombre, descripcion) {
  validarTokenConScope(token, "read_only");
  const data = obtenerDatosToken_(token) || {};
  const email = (data.email || "").toLowerCase().trim();
  const rol = obtenerRolFamiliar(email, data.scope);

  const sheet = asegurarHojaSistema("_Listas_Familia");

  const idLista = "lst_" + Utilities.getUuid().slice(0, 8);
  sheet.appendRow([idLista, (nombre || "Lista").toString().trim(), descripcion || "Sin descripción", email, new Date(), true]);
  logInfo("Modo Familiar", `Lista creada por [${rol}]: ${nombre}`);
  return { id: idLista, nombre: nombre };
}

function obtenerListasUsuario(token) {
  validarTokenConScope(token, "read_only");
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("_Listas_Familia");
  if (!sheet || sheet.getLastRow() < 2) return [];
  return sheet.getRange(2, 1, sheet.getLastRow() - 1, 6).getValues().map(f => ({
    id: f[0], nombre: f[1], descripcion: f[2], creador: f[3],
    fechaCreacion: f[4] ? Utilities.formatDate(new Date(f[4]), obtenerZonaHoraria(), "yyyy-MM-dd") : "",
    compartida: f[5]
  }));
}

function obtenerVideosDeLista(token, idLista) {
  validarTokenConScope(token, "read_only");
  const relSheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("_Listas_Videos");
  if (!relSheet || relSheet.getLastRow() < 2) return [];

  const vIds = {};
  relSheet.getRange(2, 1, relSheet.getLastRow() - 1, 2).getValues().forEach(r => {
    if (r[0] === idLista && r[1]) vIds[r[1].toString()] = true;
  });
  if (Object.keys(vIds).length === 0) return [];

  const videos = [];
  iterarCatalogoPorBloques(function (datos) {
    datos.forEach(r => {
      const id = (r[IDX.ID] || "").toString();
      if (!vIds[id]) return;
      videos.push({
        id: id, url: r[IDX.URL], titulo: r[IDX.TITULO], resumen: r[IDX.RESUMEN], dominio: r[IDX.ECOSISTEMA], subcategoria: r[IDX.AREA],
        duracion: r[IDX.DURACION] || 0, estado: r[IDX.ESTADO],
        tieneFicha: Boolean((r[IDX.DRIVE_RAG] || "").toString().trim()),
        dificultad: r[IDX.DIFICULTAD] || "Principiante", urlExamen: r[IDX.URL_FORM] || ""
      });
    });
    return false;
  });
  return videos;
}

function añadirVideoALista(token, idLista, idVideo) {
  validarTokenConScope(token, "read_only");
  const relSheet = asegurarHojaSistema("_Listas_Videos");
  relSheet.appendRow([idLista, idVideo, new Date()]);
  return { exito: true };
}

/** Alias ASCII (sin ñ) para clientes que no manejan caracteres especiales. */
function anadirVideoALista(token, idLista, idVideo) {
  return añadirVideoALista(token, idLista, idVideo);
}

function eliminarVideoDeLista(token, idLista, idVideo) {
  validarTokenConScope(token, "read_only");
  const relSheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("_Listas_Videos");
  if (!relSheet || relSheet.getLastRow() < 2) return { exito: false };

  const datos = relSheet.getRange(2, 1, relSheet.getLastRow() - 1, 2).getValues();
  for (let i = datos.length - 1; i >= 0; i--) {
    if (datos[i][0] === idLista && datos[i][1] === idVideo) {
      relSheet.deleteRow(i + 2);
      return { exito: true };
    }
  }
  return { exito: false };
}

function eliminarListaFamiliar(token, idLista) {
  validarTokenConScope(token, "read_only");
  const listasSheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("_Listas_Familia");
  if (!listasSheet || listasSheet.getLastRow() < 2) return { exito: false };

  const datos = listasSheet.getRange(2, 1, listasSheet.getLastRow() - 1, 4).getValues();
  for (let i = 0; i < datos.length; i++) {
    if (datos[i][0] === idLista) {
      listasSheet.deleteRow(i + 2);
      return { exito: true };
    }
  }
  return { exito: false };
}

function crearEventoCalendarioFamilia(token, idLista, fechaHoraIso, duracionMin, correosInvitados) {
  validarTokenConScope(token, "read_only");
  const fechaInicio = new Date(fechaHoraIso);
  const fechaFin = new Date(fechaInicio.getTime() + (parseInt(duracionMin, 10) || 60) * 60000);
  const invitados = (correosInvitados || "").toString().split(",").map(c => c.trim()).filter(Boolean);

  const eventoCal = CalendarApp.getDefaultCalendar().createEvent(
    "Videoteca Técnica - Sesión de Estudio",
    fechaInicio, fechaFin,
    { description: "Sesión programada desde el Portal IA (" + (idLista || "general") + ").", guests: invitados.join(",") }
  );
  logInfo("Calendario", "Evento de estudio creado: " + eventoCal.getId());
  return { exito: true, googleCalId: eventoCal.getId() };
}

/**
 * [Recuperado de v2026.0.0 y ampliado] Agenda un recordatorio de estudio o de
 * examen en Google Calendar. Si el módulo tiene deadline, el recordatorio se
 * ancla 24 h antes del plazo; si no, se usa la fecha recibida.
 */
function agendarRecordatorioEnCalendar(token, opciones) {
  try {
    validarTokenConScope(token, "read_only");
    const datos = obtenerDatosToken_(token) || {};
    const correo = (datos.email || "").toLowerCase().trim();
    const opts = opciones || {};

    let inicio = opts.fechaIso ? new Date(opts.fechaIso) : null;
    const modulo = opts.moduloId ? obtenerModulo(opts.moduloId) : null;

    if (!inicio && modulo && modulo.deadline) {
      const dl = new Date(modulo.deadline);
      if (!isNaN(dl.getTime())) inicio = new Date(dl.getTime() - 24 * 3600000);
    }
    if (!inicio || isNaN(inicio.getTime())) {
      inicio = new Date(Date.now() + 24 * 3600000);
    }

    const duracion = parseInt(opts.duracionMin, 10) || 45;
    const fin = new Date(inicio.getTime() + duracion * 60000);
    const titulo = opts.titulo ||
      (modulo ? "Estudio y certificación: " + modulo.nombre : "Sesión de estudio — Videoteca Técnica");

    const descripcion = [
      opts.descripcion || "Recordatorio generado desde el Portal de Videoteca Certificable.",
      modulo ? "Módulo: " + modulo.nombre + " (" + modulo.id + ")" : "",
      modulo && modulo.documentoMaestro ? "Documento maestro: " + modulo.documentoMaestro : "",
      opts.link ? "Enlace: " + opts.link : ""
    ].filter(Boolean).join("\n");

    const cal = CalendarApp.getDefaultCalendar();
    const evento = cal.createEvent(titulo, inicio, fin, {
      description: descripcion,
      guests: correo || undefined,
      sendInvites: Boolean(correo)
    });
    // Aviso 1 día antes y 30 minutos antes: cubre planificación y arranque.
    try {
      evento.addEmailReminder(24 * 60);
      evento.addPopupReminder(30);
    } catch (eRem) { /* algunos calendarios limitan los avisos */ }

    logInfo("Calendario", `Recordatorio agendado para ${correo || "usuario"}: ${titulo}`);
    return {
      exito: true,
      eventoId: evento.getId(),
      inicio: inicio.toISOString(),
      fin: fin.toISOString(),
      titulo: titulo
    };
  } catch (e) {
    logWarn("Calendario", "No se pudo agendar el recordatorio: " + e.message);
    return { exito: false, mensaje: e.message };
  }
}

/** Agenda desde la hoja: recuerda a cada usuario los módulos con plazo próximo. */
/**
 * [6.25] Esto estaba al revés, y lo puse yo en la 6.23.
 *
 * Razoné «es para un disparador, y un disparador no tiene interfaz, así que
 * que marque origen confiable». Pero `marcarOrigenConfiable()` no comprueba
 * nada: lo declara. Una función global que se declara confiable a sí misma es
 * una función que cualquiera puede ejecutar desde el portal — y esta crea
 * eventos de calendario e invita por correo a las personas del padrón.
 *
 * Ahora es privada y exige origen, como todo lo demás. No se le instala ningún
 * disparador: si hace falta desde la hoja, está en el panel de herramientas
 * envuelta en `…UI`; si algún día hace falta automática, se migra como
 * cualquier manejador, con su nombre privado y su horario declarado.
 */
function agendarRecordatoriosDeModulosVencidos_() {
  exigirOrigenInterno("agendarRecordatoriosDeModulosVencidos_");
  const adminToken = obtenerTokenAdministrador_();
  if (!adminToken) return { agendados: 0 };

  const hoy = Date.now();
  let agendados = 0;
  listarModulos().forEach(m => {
    if (!m.deadline || m.estado === "ARCHIVADO") return;
    const dl = new Date(m.deadline).getTime();
    if (isNaN(dl) || dl < hoy) return;
    const diasRestantes = (dl - hoy) / 86400000;
    if (diasRestantes > 3) return;   // solo avisamos en la recta final

    obtenerCorreosConocidos().forEach(correo => {
      const estado = obtenerEstadoModuloUsuario(correo, m.id);
      if (!estado || estado.examenAprobado) return;
      try {
        CalendarApp.getDefaultCalendar().createEvent(
          "⏳ Cierre de módulo: " + m.nombre,
          new Date(dl - 3600000), new Date(dl),
          { description: "Tu plazo para certificar «" + m.nombre + "» está por vencer.", guests: correo }
        );
        agendados++;
      } catch (e) { /* el calendario puede rechazar invitados externos */ }
    });
  });
  if (agendados > 0) logInfo("Calendario", `Recordatorios de cierre agendados: ${agendados}`);
  return { agendados: agendados };
}

/**
 * Entrada desde el panel de herramientas. Avisa de lo que va a hacer porque
 * manda invitaciones de calendario a personas reales, y eso no se deshace
 * borrando el evento: ya recibieron el correo.
 *
 * PENDIENTE, y conviene saberlo antes de usarla dos veces: no hay deduplicación
 * por módulo, persona y fecha de cierre. Ejecutarla otra vez sobre el mismo
 * plazo vuelve a crear los eventos. Por eso no lleva disparador.
 */
function agendarRecordatoriosDeModulosVencidosUI() {
  exigirContextoHoja_("agendarRecordatoriosDeModulosVencidosUI");
  if (!preguntarUsuario("📅 Avisar de los módulos que vencen",
      "Se crearán eventos de calendario, con invitación por correo, para quien no haya " +
      "certificado un módulo que cierra en menos de tres días.\n\n" +
      "No hay control de repetidos: si ya lo ejecutaste para este plazo, se crearán otra vez." +
      "\n\n¿Continuar?", false)) return;
  marcarOrigenConfiable();
  const r = agendarRecordatoriosDeModulosVencidos_();
  alertarUsuario("Recordatorios creados: " + r.agendados, "📅 Calendario");
}

