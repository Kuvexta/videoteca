function crearHojaControlMovil() {
  exigirOrigenInterno("crearHojaControlMovil");
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const movil = ss.getSheetByName("Acciones Movil") || ss.insertSheet("Acciones Movil");
  movil.clear();
  movil.getRange("A1:C1").setValues([["Ejecutar", "Acción Operativa", "Último Resultado"]])
    .setFontWeight("bold").setBackground("#0f766e").setFontColor("#ffffff");

  const acciones = [
    [false, "⚡ Ejecutar Fase 1 (Ingesta Rápida)", "Listo"],
    [false, "⏭️ Continuar Ingesta desde Checkpoint", "Listo"],
    [false, "🧠 Ejecutar Fase 2 (Procesamiento IA)", "Listo"],
    [false, "🔄 Actualizar Métricas (Vistas/Likes)", "Listo"],
    [false, "🎓 Evaluar Dificultad del Catálogo", "Listo"],
    [false, "📝 Generar Lote de Exámenes (10)", "Listo"],
    [false, "🧬 Indexar Fragmentos RAG", "Listo"],
    [false, "📊 Reconstruir Dashboard Reactivo", "Listo"],
    [false, "🎓 Panel de Módulos Certificables", "Listo"],
    [false, "🏅 Matriz de Certificación", "Listo"],
    [false, "📤 Exportar Certificaciones a Drive", "Listo"],
    [false, "⏳ Caducar Intentos Abandonados", "Listo"],
    [false, "🧹 Ejecutar Mantenimiento (>30 días)", "Listo"],
    [false, "💾 Crear Backup Ahora", "Listo"]
  ];
  movil.getRange(2, 1, acciones.length, 3).setValues(acciones);
  movil.getRange(2, 1, acciones.length, 1).insertCheckboxes();
  movil.autoResizeColumns(1, 3);

  instalarTriggerMovilManual();
  notificarUsuario("Panel de control móvil configurado.", "Móvil", 4);
}

function onEditControlMovilTrigger_(e) {
  marcarOrigenConfiable();   // [SEC-1] entrada legítima del servidor
  if (!e || !e.range) return;
  const hoja = e.range.getSheet();

  // [OPT-12] El mismo disparador audita las ediciones del catálogo, sin gastar
  // otro de los 19 cupos de trigger.
  if (hoja.getName() === NOMBRE_HOJA_DATOS) { auditarEdicionCatalogo(e); return; }
  if (hoja.getName() !== "Acciones Movil") return;

  const fila = e.range.getRow();
  const col = e.range.getColumn();
  if (col !== 1 || fila < 2 || e.value !== "TRUE") return;

  const accion = hoja.getRange(fila, 2).getValue().toString();
  hoja.getRange(fila, 3).setValue("⏳ En ejecución…");
  let detalle = "";

  try {
    if (accion.indexOf("Fase 1") !== -1) ejecutarFase1Rapida();
    else if (accion.indexOf("Continuar Ingesta") !== -1) continuarIngestaDesdeCheckpoint();
    else if (accion.indexOf("Fase 2") !== -1) ejecutarFase2Profunda();
    else if (accion.indexOf("Métricas") !== -1) actualizarSoloMetricas(true);
    else if (accion.indexOf("Dificultad") !== -1) actualizarDificultadCatalogo();
    else if (accion.indexOf("Exámenes") !== -1) generarSiguienteLoteExamenes();
    else if (accion.indexOf("Fragmentos") !== -1) indexarFragmentosCatalogo();
    else if (accion.indexOf("Dashboard") !== -1) crearDashboardTiempoReal();
    else if (accion.indexOf("Panel de Módulos") !== -1) generarPanelModulos();
    else if (accion.indexOf("Matriz de Certificación") !== -1) generarPestanaCertificaciones();
    else if (accion.indexOf("Caducar Intentos") !== -1) detalle = " · " + caducarIntentosAbandonados() + " caducados";
    else if (accion.indexOf("Exportar Certificaciones") !== -1) detalle = " · " + exportarCertificacionesAJson() + " registros";
    else if (accion.indexOf("Mantenimiento") !== -1) ejecutarMantenimientoSemanal_();
    else if (accion.indexOf("Backup") !== -1) crearBackupAutomatico_();

    hoja.getRange(fila, 3).setValue("✅ Éxito @ " +
      Utilities.formatDate(new Date(), obtenerZonaHoraria(), "HH:mm:ss") + detalle);
    logInfo("Móvil", "Acción ejecutada: " + accion);
  } catch (err) {
    hoja.getRange(fila, 3).setValue("❌ Error: " + err.message.slice(0, 180));
    logError("Móvil", `${accion} → ${err.message}`);
  } finally {
    hoja.getRange(fila, 1).setValue(false);
  }
}

/**
 * [OPT-12] Auditoría de ediciones manuales del catálogo.
 * El log registraba lo que hacía el SISTEMA, pero no quién cambiaba a mano el
 * estado de un video, su módulo o su dificultad — justo los campos que deciden
 * qué se certifica. Se registra en _Log_Actividad, no en una columna nueva:
 * mantiene intacto el esquema de 25 columnas y no compite por el ancho de la hoja.
 *
 * Solo se auditan las columnas que cambian el comportamiento del sistema; editar
 * un resumen o un tag no genera ruido.
 */
// Las claves son números de columna 1-based y se derivan de IDX: escritas a
// mano, al mover una columna la auditoría empieza a registrar el campo de al
// lado con el nombre del anterior, que es peor que no auditar.
const COLUMNAS_AUDITADAS = (function () {
  const mapa = {};
  mapa[IDX.URL + 1] = "URL";
  mapa[IDX.ID + 1] = "ID_Video";
  mapa[IDX.ESTADO + 1] = "Estado";
  mapa[IDX.DIFICULTAD + 1] = "Dificultad";
  mapa[IDX.URL_FORM + 1] = "URL_Examen";
  mapa[IDX.MODULO + 1] = "Modulo_Id";
  return mapa;
})();

function auditarEdicionCatalogo(e) {
  try {
    if (PropertiesService.getScriptProperties().getProperty("AUDITORIA_EDICIONES") !== "true") return;
    if (!e || !e.range) return;

    const col = e.range.getColumn();
    const nombreCol = COLUMNAS_AUDITADAS[col];
    if (!nombreCol) return;                      // columna sin interés operativo
    const fila = e.range.getRow();
    if (fila < 2) return;                        // cabecera

    let usuario = "desconocido";
    try { usuario = Session.getActiveUser().getEmail() || "desconocido"; } catch (err) { /* sin permiso */ }

    const hoja = e.range.getSheet();
    const idVideo = (hoja.getRange(fila, IDX.ID + 1).getValue() || "").toString().trim() || `fila ${fila}`;
    const antes = (e.oldValue === undefined || e.oldValue === null) ? "(vacío)" : e.oldValue.toString().slice(0, 80);
    const ahora = (e.value === undefined || e.value === null) ? "(vacío)" : e.value.toString().slice(0, 80);
    if (antes === ahora) return;

    registrarLogActividad("Auditoría",
      `${usuario} cambió ${nombreCol} de «${idVideo}»: "${antes}" → "${ahora}"`, "INFO");

    // Cambiar el módulo de un video altera qué cuenta para certificar: hay que
    // invalidar los agregados aunque la edición sea manual.
    if (col === IDX.MODULO + 1 || col === IDX.ESTADO + 1) invalidarCacheAPI();
  } catch (err) {
    // La auditoría jamás debe interferir con la edición del usuario.
    try { logWarn("Auditoría", err.message); } catch (e2) { /* silencio */ }
  }
}

/** Activa o desactiva la auditoría de ediciones desde el menú. */
function alternarAuditoriaEdiciones() {
  exigirOrigenInterno("alternarAuditoriaEdiciones");
  const props = PropertiesService.getScriptProperties();
  const activa = props.getProperty("AUDITORIA_EDICIONES") === "true";
  props.setProperty("AUDITORIA_EDICIONES", activa ? "false" : "true");

  if (!activa) {
    // Necesita el disparador onEdit, el mismo del panel móvil.
    const existe = ScriptApp.getProjectTriggers()
      .some(trg => trg.getHandlerFunction() === "onEditControlMovilTrigger_");
    if (!existe) instalarTriggerMovilManual();
  }

  alertarUsuario(activa
    ? "Auditoría de ediciones DESACTIVADA."
    : "Auditoría de ediciones ACTIVADA.\n\nSe registrará en _Log_Actividad quién cambia URL, ID, Estado, " +
      "Dificultad, URL de examen o Módulo de cualquier fila del catálogo.",
    "Auditoría");
}

// =====================================================================================
// 17. MANTENIMIENTO OPERATIVO, MÉTRICAS, DUPLICADOS Y BACKUPS
// =====================================================================================

function actualizarSoloMetricas(silencioso = false) {
  exigirOrigenInterno("actualizarSoloMetricas");
  if (typeof YouTube === "undefined") {
    logWarn("Métricas", "Servicio YouTube no habilitado; se omite la actualización.");
    return 0;
  }

  let actualizados = 0;
  iterarCatalogoPorBloques(function (datos) {
    // Agrupa IDs de YouTube del bloque y consulta en lotes de 50 (1 unidad de cuota).
    const indicePorId = {};
    const ids = [];
    for (let i = 0; i < datos.length; i++) {
      const videoId = (datos[i][IDX.ID] || "").toString().trim();
      const plataforma = (datos[i][IDX.ECOSISTEMA] || "").toString();
      if (!videoId) continue;
      if (plataforma && plataforma !== "YouTube" && plataforma.indexOf("YouTube") === -1) continue;
      if (!/^[\w-]{11}$/.test(videoId)) continue;
      indicePorId[videoId] = i;
      ids.push(videoId);
    }
    if (ids.length === 0) return false;

    let mutado = false;
    for (let k = 0; k < ids.length; k += BATCH_YOUTUBE_API) {
      const chunk = ids.slice(k, k + BATCH_YOUTUBE_API);
      try {
        verificarCuotaDisponible(1, "YOUTUBE");
        const resp = YouTube.Videos.list("statistics", { id: chunk.join(",") });
        (resp.items || []).forEach(item => {
          const idx = indicePorId[item.id];
          if (idx === undefined) return;
          datos[idx][IDX.VISTAS] = Number(item.statistics.viewCount || 0);
          datos[idx][IDX.LIKES] = Number(item.statistics.likeCount || 0);
          actualizados++;
          mutado = true;
        });
      } catch (e) {
        logWarn("Métricas", `Lote fallido (HTTP ${deducirCodigoHttpDesdeError(e.message)}): ${e.message}`);
      }
    }
    return mutado;
  });

  if (!silencioso) notificarUsuario(t("toast_metricas", { total: actualizados }), "Métricas", 4);
  logInfo("Métricas", `Actualizadas métricas de ${actualizados} videos.`);
  return actualizados;
}

/**
 * Reclasifica el catálogo con las reglas de _Config_Taxonomia.
 *
 * `forzar = false` (lo que hace el menú normal) respeta lo que ya esté puesto:
 * solo rellena lo vacío o lo que quedó como «Sin clasificar». Con `forzar = true`
 * reescribe también lo clasificado, que es lo que se quiere después de cambiar
 * las reglas — pero pisa las correcciones hechas a mano, así que el menú lo
 * pregunta antes.
 */
function reevaluarClasificacionYResumen(silencioso = false, forzar = false) {
  let actualizados = 0;
  let sinClasificar = 0;

  /* Releer las reglas de la hoja antes de tocar nada. El caché dura seis horas
     y guarda las reglas ya interpretadas: sin esta línea, quien corrige una
     regla y reclasifica acto seguido obtiene exactamente el mismo resultado que
     quería corregir, y no tiene forma de saber por qué. */
  invalidarCacheTaxonomiaSilencioso();

  function vacioOSinClasificar(v) {
    const s = (v || "").toString().trim();
    return !s || s === "General" || s === SIN_CLASIFICAR;
  }

  iterarCatalogoPorBloques(function (datos) {
    let mutado = false;
    for (let i = 0; i < datos.length; i++) {
      const titulo = (datos[i][IDX.TITULO] || "").toString();
      if (!titulo) continue;

      /* NUNCA se le pasa al motor un resumen que escribió una regla.
         Esto era un bucle que se alimentaba solo, y es la razón de que
         reclasificar no arreglara nada: la regla «Proxy y certificados»
         escribe «Proxy inverso y certificados.» en la fila; en la siguiente
         reclasificación ese texto entra como descripción; el motor compara
         palabra por palabra, no la frase entera, así que encuentra «proxy» e
         «inverso» y vuelve a elegir exactamente la misma regla. La etiqueta
         falsa se votaba a sí misma indefinidamente, y por eso había videos de
         Luke Combs en «Linux y Despliegue» y reactores nucleares en «Punto de
         Venta». Lo mismo con «atencion al huesped», «salida huesped»,
         «punto de venta» y «conciliacion bancaria».
         Un resumen escrito por la IA sí describe el video de verdad, así que
         ese sí ayuda a clasificar y se conserva. */
      const resumenActual = (datos[i][IDX.RESUMEN] || "").toString();
      const descripcionFiable = descripcionFiableDeFila(datos[i]);
      const clasif = motorClasificacionUniversal(titulo, descripcionFiable, datos[i][IDX.CATEGORIA_YT]);

      /* El resumen tiene que seguir a la clasificación. Escribirlo solo cuando
         está vacío deja filas que dicen «Proxy inverso y certificados» encima
         de un área de Odoo: el resumen viejo sobrevive a la corrección y es lo
         primero que se lee en la ficha, así que el catálogo sigue pareciendo
         mal clasificado aunque ya no lo esté. Solo se pisa forzando, y solo si
         lo que hay es un resumen que puso una regla —los escritos por la IA o
         a mano llevan otro texto y no se tocan. */
      if (!resumenActual) datos[i][IDX.RESUMEN] = clasif.resumen;
      else if (forzar && descripcionFiable === "") {
        /* `descripcionFiable === ""` ya significa «lo que hay lo puso una regla»:
           se reemplaza por el de la regla que gana ahora. Si ahora no gana
           ninguna, se vacía en vez de dejar puesto el texto de la regla vieja —
           una fila «Sin clasificar» que sigue diciendo «Proxy inverso y
           certificados.» es peor que una sin resumen, porque parece correcta. */
        datos[i][IDX.RESUMEN] = clasif.ecosistema !== SIN_CLASIFICAR ? clasif.resumen : "";
      }

      /* Ecosistema y área se escriben SIEMPRE juntos. Rellenar solo el área
         dejaría pares que no existen en ninguna regla —«Hotelería / Inventario
         y Almacén»— y el árbol de filtros ofrecería ramas que no llevan a nada.
         Si cualquiera de los dos está sin clasificar, se toma el par de la regla. */
      const faltaAlguno = vacioOSinClasificar(datos[i][IDX.ECOSISTEMA]) ||
                          vacioOSinClasificar(datos[i][IDX.AREA]);
      if ((forzar || faltaAlguno) && clasif.ecosistema !== SIN_CLASIFICAR) {
        datos[i][IDX.ECOSISTEMA] = clasif.ecosistema;
        datos[i][IDX.AREA] = clasif.area;
      } else if (forzar) {
        /* Forzar tiene que poder BORRAR, no solo sobrescribir. Cuando una regla
           mal puesta se llevó medio catálogo y luego se corrige, esas filas ya
           no coinciden con nada: si aquí se conservara lo que hay «porque la
           regla nueva no propone nada», la etiqueta falsa se quedaría puesta
           para siempre y reclasificar no arreglaría nunca lo que vino a
           arreglar. Se marcan como sin clasificar, que es la verdad, y quedan
           visibles para «Proponer reglas» o para la Fase 2. */
        datos[i][IDX.ECOSISTEMA] = SIN_CLASIFICAR;
        datos[i][IDX.AREA] = SIN_CLASIFICAR;
      } else if (faltaAlguno) {
        // Ninguna regla reconoció la fila: se marca, no se inventa.
        if (vacioOSinClasificar(datos[i][IDX.ECOSISTEMA])) datos[i][IDX.ECOSISTEMA] = SIN_CLASIFICAR;
        if (vacioOSinClasificar(datos[i][IDX.AREA])) datos[i][IDX.AREA] = SIN_CLASIFICAR;
      }
      /* El tema sigue al par ecosistema/área: dejar el tema viejo colgando de
         un área nueva produce ramas que no existen en ninguna regla. */
      if (forzar) datos[i][IDX.TEMA] = clasif.ecosistema !== SIN_CLASIFICAR ? (clasif.tema || "") : "";
      else if (!datos[i][IDX.TEMA] && clasif.tema) datos[i][IDX.TEMA] = clasif.tema;
      // La fuente sale de la URL: no depende de ninguna regla ni de la IA.
      if (!datos[i][IDX.FUENTE]) datos[i][IDX.FUENTE] = deducirFuenteDesdeUrl(datos[i][IDX.URL]);
      if (!datos[i][IDX.VERSION]) datos[i][IDX.VERSION] = clasif.version;
      /* El idioma se recalcula también cuando ya hay algo escrito, porque lo
         que hay casi siempre es «ES» puesto por la versión anterior, que
         respondía «ES» a todo lo que no reconocía. Conservarlo sería conservar
         una columna entera que dice lo mismo en todas las filas y con la que no
         se puede filtrar nada. Lo que ya está detectado y NO es «ES» se
         respeta salvo forzando: puede haberlo puesto la plataforma o una
         persona, y eso vale más que una heurística. */
      const idiomaActual = (datos[i][IDX.IDIOMA] || "").toString().trim();
      if (forzar || !idiomaActual || idiomaActual === "ES" || idiomaActual === IDIOMA_INDETERMINADO) {
        datos[i][IDX.IDIOMA] = clasif.idioma;
      }
      /* [v2] FACETAS. Se escriben solo si están vacías, o si se fuerza. Son
         columnas que una persona puede corregir a mano —«esto en realidad es de
         hotelería»— y una reclasificación normal no tiene por qué deshacerlo.
         Alcance es la excepción de criterio: si la regla dice que algo NO es
         certificable, eso manda siempre, porque de ahí cuelgan los exámenes. */
      const ponerFaceta = (col, valor, porDefecto) => {
        const actual = (datos[i][col] || "").toString().trim();
        if (forzar || !actual || actual === porDefecto) datos[i][col] = valor;
      };
      ponerFaceta(IDX.HERRAMIENTA,    clasif.herramienta || "", "");
      ponerFaceta(IDX.INDUSTRIA,      clasif.industria || INDUSTRIA_TRANSVERSAL, INDUSTRIA_TRANSVERSAL);
      ponerFaceta(IDX.JURISDICCION,   clasif.jurisdiccion || JURISDICCION_GLOBAL, JURISDICCION_GLOBAL);
      ponerFaceta(IDX.TIPO_CONTENIDO, clasif.tipoContenido || "Tutorial", "Tutorial");
      const alcanceActual = (datos[i][IDX.ALCANCE] || "").toString().trim();
      if (forzar || !alcanceActual || clasif.alcance === ALCANCE_NO_CERTIFICABLE) {
        datos[i][IDX.ALCANCE] = clasif.alcance || ALCANCE_PENDIENTE;
      }

      /* Las etiquetas se generan con el ecosistema que quedó ESCRITO en la fila,
         no con el que propuso la regla: si se respetó una corrección manual, las
         etiquetas tienen que hablar de esa corrección y no de la propuesta. */
      datos[i][IDX.TAGS] = generarTags(titulo, datos[i][IDX.RESUMEN],
                                       datos[i][IDX.ECOSISTEMA], clasif.version);

      if (datos[i][IDX.ECOSISTEMA] === SIN_CLASIFICAR) sinClasificar++;
      actualizados++;
      mutado = true;
    }
    return mutado;
  });

  invalidarCacheAPI();
  logInfo("Reclasificación",
    `${actualizados} filas revisadas, ${sinClasificar} sin coincidencia de reglas.`);
  if (!silencioso) {
    notificarUsuario(
      `Reclasificados ${actualizados} registros` +
      (sinClasificar ? ` · ${sinClasificar} sin coincidencia` : ""),
      "Reclasificación", 5);
  }
  return { actualizados: actualizados, sinClasificar: sinClasificar };
}

/**
 * Rellena la columna «Idioma» de todo el catálogo.
 *
 * Está separado de la reclasificación porque son dos preguntas distintas y
 * arreglarlas juntas obliga a aceptar el riesgo de las dos. Reclasificar pisa
 * ecosistema, área, tema y resumen; esto solo toca una columna, no puede
 * estropear nada más, y es lo único que hace falta para que el filtro por
 * idioma del portal deje de estar vacío.
 *
 * @param {boolean} rehacerTodo  true = recalcular también lo ya escrito.
 *   Es lo que se quiere la primera vez: la versión anterior escribía «ES» en
 *   todas las filas que no reconocía, así que «lo ya escrito» no es un dato,
 *   es el valor por defecto de un detector que apenas miraba siete palabras.
 */
function detectarIdiomasDelCatalogo(rehacerTodo = false, silencioso = false) {
  const conteo = {};
  let tocadas = 0, revisadas = 0;

  iterarCatalogoPorBloques(function (datos) {
    let mutado = false;
    for (let i = 0; i < datos.length; i++) {
      const titulo = (datos[i][IDX.TITULO] || "").toString();
      if (!titulo) continue;
      revisadas++;
      const actual = (datos[i][IDX.IDIOMA] || "").toString().trim();
      /* Sin `rehacerTodo` se respeta lo que ya diga algo distinto de «ES» o
         «Indeterminado»: eso lo puso la plataforma, la IA o una persona, y
         cualquiera de los tres sabe más que esta heurística. */
      if (!rehacerTodo && actual && actual !== "ES" && actual !== IDIOMA_INDETERMINADO) {
        conteo[actual] = (conteo[actual] || 0) + 1;
        continue;
      }
      /* La descripción del video no se guarda en la hoja; lo más parecido que
         hay es el resumen, y solo sirve si lo escribió la IA —el de una regla
         está siempre en español y votaría español en todas las filas. */
      const detectado = detectarIdioma(titulo, null, descripcionFiableDeFila(datos[i]));
      conteo[detectado] = (conteo[detectado] || 0) + 1;
      if (detectado !== actual) { datos[i][IDX.IDIOMA] = detectado; tocadas++; mutado = true; }
    }
    return mutado;
  });

  invalidarCacheAPI();
  const resumen = IDIOMAS_CONTENIDO
    .filter(c => conteo[c])
    .map(c => nombreIdioma(c) + ": " + conteo[c])
    .join(" · ");
  logInfo("Idioma", `${revisadas} filas revisadas, ${tocadas} actualizadas. ${resumen}`);
  if (!silencioso) notificarUsuario(resumen || "Sin filas que revisar", "Idioma detectado", 8);
  return { revisadas: revisadas, tocadas: tocadas, conteo: conteo, resumen: resumen };
}

/** Detección de idioma desde el menú, preguntando si rehace lo ya escrito. */
function detectarIdiomasDelCatalogoUI() {
  exigirOrigenInterno("detectarIdiomasDelCatalogoUI");
  const ui = SpreadsheetApp.getUi();
  const rep = ui.alert(
    "Detectar el idioma de cada video",
    "Rellena la columna «Idioma» para que el portal pueda filtrar por idioma.\n\n" +
    "SÍ — recalcular TODAS las filas. Es lo recomendable la primera vez: la " +
    "versión anterior escribía «ES» en casi todo el catálogo sin comprobarlo.\n\n" +
    "NO — tocar solo las filas vacías, las que dicen «ES» y las «Indeterminado».\n\n" +
    "Solo se toca esa columna. Nada más del catálogo cambia.",
    ui.ButtonSet.YES_NO_CANCEL);
  if (rep === ui.Button.CANCEL || rep === ui.Button.CLOSE) return;

  const r = detectarIdiomasDelCatalogo(rep === ui.Button.YES, true);
  ui.alert(
    "Idioma detectado",
    `${r.revisadas} filas revisadas · ${r.tocadas} actualizadas.\n\n${r.resumen}\n\n` +
    "«Indeterminado» no es un fallo: son títulos demasiado cortos o sin " +
    "palabras que delaten el idioma («Odoo 18 POS»). Se pueden filtrar en el " +
    "portal para corregirlos a mano, y la Fase 2 (IA) también los resuelve.",
    ui.ButtonSet.OK);
}

/**
 * Reclasificación desde el menú, preguntando si debe pisar lo ya clasificado.
 * La diferencia importa: quien acaba de corregir 40 filas a mano no quiere que
 * un «reevaluar» se las borre sin avisar.
 */
function reevaluarClasificacionUI() {
  exigirOrigenInterno("reevaluarClasificacionUI");
  const ui = SpreadsheetApp.getUi();

  /* Antes de tocar 600 filas, comprobar que las reglas están sanas. Sin esto,
     una hoja de taxonomía corrida producía «602 de 603 sin clasificar» y el
     mensaje culpaba a los títulos —«añade palabras clave»— cuando el problema
     era que las reglas no se estaban leyendo de las columnas correctas. */
  migrarConfigTaxonomia();
  let diag = diagnosticarTaxonomia();
  if (!diag.sana) {
    const rep = ui.alert(
      "Las reglas de taxonomía no están usables",
      `Se leyeron ${diag.reglas} reglas, ${diag.conKeywords} con palabras clave` +
      (diag.sospechosas ? `, ${diag.sospechosas} con texto que parece un resumen y no palabras clave` : "") +
      ".\n\nCon las reglas así, TODO el catálogo saldría «" + SIN_CLASIFICAR + "».\n\n" +
      "¿Añado las reglas de fábrica que falten? No borra ni modifica las tuyas.",
      ui.ButtonSet.YES_NO);
    if (rep === ui.Button.YES) {
      const puestas = reponerReglasDeFabrica();
      diag = diagnosticarTaxonomia();
      notificarUsuario(`${puestas.anadidas} reglas añadidas.`, "Taxonomía", 4);
    }
  }

  const r = ui.alert(
    "Reclasificar taxonomía",
    `${diag.reglas} reglas cargadas.\n\n` +
    "¿Reescribir TAMBIÉN las filas que ya tienen ecosistema y área?\n\n" +
    "Sí = aplica las reglas a todo el catálogo (PISA las correcciones manuales,\n" +
    "     incluidas las que la migración a la v2 conservó: es lo que se usa para\n" +
    "     fijar una línea base, no para retocar).\n" +
    "     Lo que ninguna regla reconozca queda como «" + SIN_CLASIFICAR + "»:\n" +
    "     es la opción que hay que usar para quitar etiquetas equivocadas.\n" +
    "No = solo rellena lo vacío o lo marcado como «" + SIN_CLASIFICAR + "».",
    ui.ButtonSet.YES_NO_CANCEL);
  if (r === ui.Button.CANCEL) return;

  const res = reevaluarClasificacionYResumen(true, r === ui.Button.YES);
  const proporcion = res.actualizados ? res.sinClasificar / res.actualizados : 0;

  let consejo;
  if (!res.sinClasificar) {
    consejo = "Todo el catálogo quedó clasificado.";
  } else if (proporcion > 0.5) {
    // Que más de la mitad falle no se arregla escribiendo palabras clave a mano:
    // o las reglas no cubren este catálogo, o los títulos no dicen de qué van.
    consejo =
      "Más de la mitad sin clasificar con " + diag.reglas + " reglas activas.\n" +
      "Eso no se arregla regla a regla: ejecuta «Cargar Fase 2 (IA)», que clasifica\n" +
      "por el contenido y no por palabras clave, y escribe además el resumen.";
  } else {
    consejo = "Ejecuta «Cargar Fase 2 (IA)» para clasificar el resto por contenido, " +
              "o añade palabras clave en «Configurar Taxonomía».";
  }

  alertarUsuario(
    `${res.actualizados} filas procesadas.\n` +
    `${res.sinClasificar} quedaron como «${SIN_CLASIFICAR}».\n\n` + consejo,
    "Reclasificación");
}

