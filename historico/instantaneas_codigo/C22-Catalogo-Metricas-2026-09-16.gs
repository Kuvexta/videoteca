/**
 * Migra _Config_Taxonomia de 4 columnas a 5, insertando el «Tema».
 *
 * Sin esto, un libro que ya tenía la hoja quedaba CORRIDO y en silencio: la
 * reparación automática de cabeceras reescribe los rótulos a los cinco nuevos,
 * pero las filas siguen teniendo cuatro valores. Resultado: «Tema» se lee de la
 * columna de palabras clave, y las «palabras clave» se leen del resumen — una
 * frase entera que no coincide con ningún título. Ninguna regla puede acertar
 * nunca, y el catálogo entero sale «Sin clasificar» sin que nada falle.
 *
 * La detección es por DATOS, no por la cabecera: cuando la reparación ya pasó,
 * el rótulo miente. La señal es que la quinta columna esté vacía teniendo
 * contenido la tercera.
 */
function migrarConfigTaxonomia() {
  exigirOrigenInterno("migrarConfigTaxonomia");
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const hoja = ss.getSheetByName("_Config_Taxonomia");
  if (!hoja || hoja.getLastRow() < 2) return { migradas: 0, motivo: "sin datos" };

  const filas = hoja.getLastRow() - 1;
  const ancho = Math.max(hoja.getLastColumn(), 5);
  asegurarColumnas(hoja, 5);
  const datos = hoja.getRange(2, 1, filas, 5).getValues();

  const texto = (v) => (v || "").toString().trim();
  const conC = datos.filter(f => texto(f[2])).length;
  const conE = datos.filter(f => texto(f[4])).length;
  // Formato viejo: la 3ª columna lleva las palabras clave y la 5ª no existe.
  const corrida = conC > 0 && conE === 0;
  if (!corrida) return { migradas: 0, motivo: "ya estaba alineada" };

  const nuevas = datos.map(f => [
    // En el modelo viejo el «Dominio» era una etiqueta abstracta («Tecnología &
    // Software») y la Subcategoría era el ecosistema real («Odoo ERP»), igual
    // que pasaba en el catálogo. Se desplaza del mismo modo.
    texto(f[1]) || texto(f[0]) || "General",   // Ecosistema ← vieja subcategoría
    "General",                                  // Área: se reparte luego a mano
    "",                                         // Tema: nuevo, vacío
    texto(f[2]),                                // Palabras clave, en su sitio
    texto(f[3]) || "Guía técnica.",             // Resumen sugerido
    // [v2] Facetas por defecto: transversal, global y certificable, que es
    // exactamente cómo se comportaban estas reglas antes de que existieran.
    "", INDUSTRIA_TRANSVERSAL, JURISDICCION_GLOBAL, ALCANCE_CERTIFICABLE, "Tutorial"
  ]);
  hoja.getRange(2, 1, nuevas.length, ANCHO_TAXONOMIA).setValues(nuevas);
  hoja.getRange(1, 1, 1, CABECERAS_TAXONOMIA.length).setValues([CABECERAS_TAXONOMIA])
    .setFontWeight("bold").setBackground("#1e293b").setFontColor("#ffffff");

  invalidarCacheTaxonomiaSilencioso();
  logWarn("Taxonomía",
    `Hoja de reglas realineada: ${nuevas.length} filas pasaron de 4 a 5 columnas ` +
    `(ancho previo ${ancho}).`);
  return { migradas: nuevas.length, motivo: "realineada" };
}

/**
 * Pone al día las reglas de fábrica de la hoja.
 *
 * Dos modos, porque son dos problemas distintos:
 *
 * - AÑADIR (por defecto): mete solo lo que falte y no toca nada de lo que el
 *   administrador haya ajustado. Es lo correcto cuando la hoja está sana.
 *
 * - REEMPLAZAR: borra las reglas y escribe la semilla entera. Es lo correcto
 *   cuando la hoja arrastra reglas ANTIGUAS QUE HACEN DAÑO y que «añadir» nunca
 *   quitaría: el caso real fue «https» dentro de «Certificados y proxy», que se
 *   llevaba cientos de videos ajenos. Una regla mala no se arregla añadiendo
 *   otra buena al lado; el motor sigue viendo las dos.
 *
 * La clave de comparación incluye el TEMA, no solo ecosistema+área. Sin eso, de
 * las siete reglas de «Inventario y Almacén» solo entraba la primera y las seis
 * específicas —conteos, trazabilidad, valoración— se perdían en silencio.
 */
function reponerReglasDeFabrica(reemplazar) {
  exigirOrigenInterno("reponerReglasDeFabrica");
  const hoja = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("_Config_Taxonomia") ||
               crearPestanaConfigTaxonomia();
  asegurarColumnas(hoja, 5);

  const claveDe = f => normalizarBusqueda((f[0] || "") + " " + (f[1] || "") + " " + (f[2] || ""));

  if (reemplazar) {
    const habia = Math.max(0, hoja.getLastRow() - 1);
    if (habia > 0) hoja.getRange(2, 1, habia, 5).clearContent();
    hoja.getRange(2, 1, SEMILLA_TAXONOMIA.length, ANCHO_TAXONOMIA).setValues(SEMILLA_TAXONOMIA);
    invalidarCacheTaxonomiaSilencioso();
    logInfo("Taxonomía", `Reglas reemplazadas por la semilla de fábrica: ${habia} fuera, ${SEMILLA_TAXONOMIA.length} dentro.`);
    return { anadidas: SEMILLA_TAXONOMIA.length, borradas: habia, reemplazo: true };
  }

  const existentes = {};
  if (hoja.getLastRow() >= 2) {
    hoja.getRange(2, 1, hoja.getLastRow() - 1, 5).getValues().forEach(f => {
      const clave = claveDe(f);
      if (clave.trim()) existentes[clave] = true;
    });
  }

  const faltantes = SEMILLA_TAXONOMIA.filter(f => !existentes[claveDe(f)]);
  if (faltantes.length === 0) return { anadidas: 0, borradas: 0, reemplazo: false };

  hoja.getRange(hoja.getLastRow() + 1, 1, faltantes.length, ANCHO_TAXONOMIA).setValues(faltantes);
  invalidarCacheTaxonomiaSilencioso();
  logInfo("Taxonomía", `${faltantes.length} reglas de fábrica añadidas.`);
  return { anadidas: faltantes.length, borradas: 0, reemplazo: false };
}

/** Invalida el caché de taxonomía sin avisar por pantalla. */
function invalidarCacheTaxonomiaSilencioso() {
  try { CacheService.getScriptCache().remove(CLAVE_CACHE_TAXONOMIA); } catch (e) { /* best-effort */ }
  /* [v2.6.8] Y el índice de facetas por ruta, que se deriva de esas mismas
     reglas. Si se olvidara aquí, editar una regla dejaría al sistema aplicando
     las facetas de la versión anterior durante el resto de la ejecución, que es
     el peor momento posible: justo cuando alguien acaba de corregir algo. */
  _facetasPorRutaCache = null;
  _rutasV2Cache = null;
}

/**
 * Radiografía de las reglas cargadas. Es lo que convierte un «602 de 603 sin
 * clasificar» en un diagnóstico: distingue «tus títulos no encajan» de «tus
 * reglas están rotas», que son problemas completamente distintos.
 */
function diagnosticarTaxonomia() {
  const reglas = obtenerTaxonomiaConfig();
  const conKeywords = reglas.filter(r => r.keywords && r.keywords.length > 0).length;
  // Una «palabra clave» de más de 40 caracteres es una frase: señal de que la
  // hoja está corrida y se está leyendo la columna del resumen.
  const sospechosas = reglas.filter(r =>
    (r.keywords || []).some(k => k.length > 40)).length;
  return {
    reglas: reglas.length,
    conKeywords: conKeywords,
    sospechosas: sospechosas,
    sana: reglas.length > 0 && conKeywords > 0 && sospechosas === 0
  };
}

function crearPestanaConfigTaxonomia() {
  exigirOrigenInterno("crearPestanaConfigTaxonomia");
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let hoja = ss.getSheetByName("_Config_Taxonomia");
  if (!hoja) hoja = ss.insertSheet("_Config_Taxonomia", ss.getSheets().length);
  // La hoja ya existe con contenido: no se resiembra, pero SÍ se comprueba que
  // sus columnas no hayan quedado corridas por el cambio de esquema.
  if (hoja.getLastRow() > 1) { migrarConfigTaxonomia(); return hoja; }
  hoja.clear();

  hoja.getRange(1, 1, 1, CABECERAS_TAXONOMIA.length).setValues([CABECERAS_TAXONOMIA])
    .setFontWeight("bold").setBackground("#1e293b").setFontColor("#ffffff");

  const datosSemilla = SEMILLA_TAXONOMIA;
  hoja.getRange(2, 1, datosSemilla.length, CABECERAS_TAXONOMIA.length).setValues(datosSemilla);
  hoja.setFrozenRows(1);
  hoja.hideSheet();
  return hoja;
}

function obtenerTaxonomiaConfig() {
  const cache = CacheService.getScriptCache();
  const cacheKey = CLAVE_CACHE_TAXONOMIA;
  const cachedData = cache.get(cacheKey);
  if (cachedData) {
    /* El filtro de palabras inútiles se vuelve a aplicar sobre lo cacheado.
       Subir la clave de caché ya evita heredar la interpretación vieja, pero
       este segundo pase es lo que garantiza que una clave como «https» no
       pueda volver a colarse por un caché escrito por otra versión del script
       —o por una ejecución que empezó antes de actualizar. Cuesta recorrer unas
       pocas decenas de claves; equivocarse cuesta el catálogo entero. */
    try {
      const guardadas = JSON.parse(cachedData);
      if (Array.isArray(guardadas)) {
        return guardadas.map(r => ({
          ecosistema: r.ecosistema, area: r.area, tema: r.tema,
          keywords: (r.keywords || []).filter(esClaveDiscriminante),
          resumenSugerido: r.resumenSugerido,
          herramienta: r.herramienta || "", industria: r.industria || INDUSTRIA_TRANSVERSAL,
          jurisdiccion: r.jurisdiccion || JURISDICCION_GLOBAL,
          alcance: r.alcance || ALCANCE_CERTIFICABLE,
          tipoContenido: r.tipoContenido || "Tutorial"
        }));
      }
    } catch (e) { /* cache corrupta */ }
  }

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let hoja = ss.getSheetByName("_Config_Taxonomia");
  if (!hoja) hoja = crearPestanaConfigTaxonomia();

  const ultimaFila = hoja.getLastRow();
  let reglas = [];
  if (ultimaFila >= 2) {
    /* Tres formatos posibles conviviendo:
         4 columnas  → la original, sin Tema (la 3ª eran las palabras clave)
         5 columnas  → con Tema
        10 columnas  → v2, con las cinco facetas al final
       Se lee el ancho real y se rellenan por defecto las que no estén, para que
       una hoja a medio migrar siga clasificando en vez de romperse. */
    const anchoReal = Math.max(hoja.getLastColumn(), 4);
    const esFormatoNuevo = anchoReal >= 5;
    const tieneFacetas = anchoReal >= 10;
    const anchoLeer = tieneFacetas ? 10 : (esFormatoNuevo ? 5 : 4);
    const valores = hoja.getRange(2, 1, ultimaFila - 1, anchoLeer).getValues();
    const descartadas = [];
    reglas = valores.map(fila => {
      const crudas = (esFormatoNuevo ? fila[3] : fila[2])
        ? (esFormatoNuevo ? fila[3] : fila[2]).toString().toLowerCase().split(",").map(k => k.trim()).filter(Boolean)
        : [];
      /* Se filtran aquí y no al clasificar: una clave como «https» coincide con
         todo el catálogo y, si además su regla aporta Tema, se lo lleva entero.
         Mejor perder una palabra que perder la clasificación. */
      const utiles = crudas.filter(k => {
        if (esClaveDiscriminante(k)) return true;
        descartadas.push(k);
        return false;
      });
      return {
        ecosistema: fila[0] ? fila[0].toString().trim() : "General",
        area: fila[1] ? fila[1].toString().trim() : "General",
        tema: esFormatoNuevo && fila[2] ? fila[2].toString().trim() : "",
        keywords: utiles,
        resumenSugerido: (esFormatoNuevo ? fila[4] : fila[3])
          ? (esFormatoNuevo ? fila[4] : fila[3]).toString().trim() : "Guía técnica.",
        // [v2] Facetas. Sin ellas, todo se comporta como antes: transversal,
        // global y certificable, que es exactamente lo que hacía la v1.
        herramienta:  tieneFacetas && fila[5] ? fila[5].toString().trim() : "",
        industria:    tieneFacetas && fila[6] ? fila[6].toString().trim() : INDUSTRIA_TRANSVERSAL,
        jurisdiccion: tieneFacetas && fila[7] ? fila[7].toString().trim() : JURISDICCION_GLOBAL,
        alcance:      tieneFacetas && fila[8] ? fila[8].toString().trim() : ALCANCE_CERTIFICABLE,
        tipoContenido:tieneFacetas && fila[9] ? fila[9].toString().trim() : "Tutorial"
      };
    });
    if (descartadas.length > 0) {
      logWarn("Taxonomía", "Palabras clave ignoradas por no distinguir nada: " +
        descartadas.filter((k, i, a) => a.indexOf(k) === i).join(", "));
    }
  }
  if (reglas.length > 0) cache.put(cacheKey, JSON.stringify(reglas), 21600);
  return reglas;
}

