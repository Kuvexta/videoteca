function obtenerTareasRefuerzoUsuario(token) {
  validarTokenConScope(token, "read_only");
  const datosToken = obtenerDatosToken_(token) || {};
  const email = (datosToken.email || "").toLowerCase().trim();
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("_Progreso_Refuerzo");
  if (!sheet || sheet.getLastRow() < 2 || !email) return [];

  return sheet.getRange(2, 1, sheet.getLastRow() - 1, 12).getValues()
    .filter(f => (f[1] || "").toString().toLowerCase().trim() === email && f[9] === "PENDIENTE")
    .map(f => ({
      idTarea: f[0], modulo: f[2], numeroPregunta: f[3], concepto: f[4],
      videoReferencia: f[5], urlVideo: f[6], motivo: f[7],
      fechaAsignacion: formatearFecha(f[8], "yyyy-MM-dd")
    }));
}

/**
 * [F1-9] Recomienda contenidos afines ya estudiados. Complementa al plan de refuerzo:
 * este apunta a la pregunta fallada; aquel amplía por afinidad temática.
 */
function obtenerRecomendacionesEstudio(referencia, moduloId = "") {
  // El refuerzo busca videos del MISMO sitio de la jerarquía: primero la misma
  // área, y si no, el mismo ecosistema. Con el tema afinamos un nivel más.
  let ecosistema = "", area = "", tema = "", idOrigen = "";

  iterarCatalogoPorBloques(function (datos) {
    for (let i = 0; i < datos.length; i++) {
      const coincide = (moduloId && (datos[i][IDX.MODULO] || "").toString().trim() === moduloId) ||
                       (datos[i][IDX.ID_FORM] || "").toString().trim() === referencia ||
                       (datos[i][IDX.ID] || "").toString().trim() === referencia;
      if (coincide) {
        idOrigen = (datos[i][IDX.ID] || "").toString();
        ecosistema = (datos[i][IDX.ECOSISTEMA] || "").toString();
        area = (datos[i][IDX.AREA] || "").toString();
        tema = (datos[i][IDX.TEMA] || "").toString();
        return false;
      }
    }
    return false;
  });

  const recs = [];
  iterarCatalogoPorBloques(function (datos) {
    for (let i = 0; i < datos.length; i++) {
      if (recs.length >= 3) return false;
      const url = datos[i][IDX.URL];
      const id = (datos[i][IDX.ID] || "").toString();
      const est = (datos[i][IDX.ESTADO] || "").toString();
      if (!url || !id || id === idOrigen) continue;
      if (est.indexOf("Estudiado") === -1 && est.indexOf("Esencial") === -1) continue;
      const mismoTema = tema && (datos[i][IDX.TEMA] || "") === tema;
      const mismaArea = area && (datos[i][IDX.AREA] || "") === area;
      const mismoEco  = ecosistema && (datos[i][IDX.ECOSISTEMA] || "") === ecosistema;
      if (mismoTema || mismaArea || mismoEco) {
        recs.push({
          titulo: datos[i][IDX.TITULO], url: url,
          tema: (datos[i][IDX.TEMA] || datos[i][IDX.AREA] || ecosistema)
        });
      }
    }
    return false;
  });
  return recs;
}

function verificarDesbloqueoReevaluacion(token, referencia) {
  const tokenData = obtenerDatosToken_(token);
  if (!tokenData) throw new Error(t("err_sin_token"));
  const email = (tokenData.email || "").toLowerCase().trim();

  const props = PropertiesService.getScriptProperties();
  const maxAttempts = parseInt(props.getProperty("MAX_REEVALUATION_ATTEMPTS") || DEFAULT_MAX_REEVALUATION_ATTEMPTS, 10);

  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("_Progreso_Refuerzo");
  if (!sheet || sheet.getLastRow() < 2) {
    // Sin tareas registradas no hay nada que completar: desbloqueado.
    return { desbloqueado: true, totalTareas: 0, tareasPendientes: 0, intentosUsados: 0, maxIntentos: maxAttempts };
  }

  const datos = sheet.getRange(2, 1, sheet.getLastRow() - 1, 12).getValues();
  let pendientes = 0, totalModulo = 0, intentosUsados = 0;

  datos.forEach(f => {
    if ((f[1] || "").toString().toLowerCase().trim() !== email) return;
    if ((f[2] || "").toString().trim() !== referencia) return;
    totalModulo++;
    if (f[9] !== "VISTO" && f[9] !== "EXENTO") pendientes++;
    if (f[9] === "REINTENTO") intentosUsados++;
  });

  // Corrección: sin tareas asignadas el alumno queda desbloqueado, no bloqueado para siempre.
  const desbloqueado = (totalModulo === 0 || pendientes === 0) && intentosUsados < maxAttempts;

  return {
    desbloqueado: desbloqueado,
    totalTareas: totalModulo,
    tareasPendientes: pendientes,
    intentosUsados: intentosUsados,
    maxIntentos: maxAttempts,
    motivo: desbloqueado ? "" :
      (pendientes > 0 ? `Tienes ${pendientes} tareas de refuerzo pendientes.`
        : `Agotaste los ${maxAttempts} intentos de reevaluación.`)
  };
}

function generarFormularioReevaluacionFocalizada(token, referencia) {
  exigirOrigenInterno("generarFormularioReevaluacionFocalizada");
  const status = verificarDesbloqueoReevaluacion(token, referencia);
  if (!status.desbloqueado) throw new Error(status.motivo);

  const claves = leerClavesExamen({ examenId: referencia });
  const base = (claves.length > 0 ? claves : leerClavesExamen({ moduloId: referencia })).slice(0, 4);
  if (base.length === 0) throw new Error(t("err_examen_sin_preguntas"));

  const prompt = obtenerPrompt("reevaluacion", {
    texto: JSON.stringify(base.map(p => ({ pregunta: p.texto, causa: p.causaRaiz })))
  });
  const parsed = extraerJsonDesdeTexto(llamarModeloIA(prompt, obtenerConfigIA().proveedor, 2500));
  if (!parsed || !parsed.preguntas || parsed.preguntas.length === 0) throw new Error(t("err_json_invalido"));

  const form = FormApp.create(`Re-evaluación Focalizada (Intento ${status.intentosUsados + 1})`);
  form.setIsQuiz(true);
  try { form.setShowLinkToRespondAgain(false); } catch (e) { /* API antigua */ }
  form.setDescription(`Examen focalizado de reevaluación adaptativa.\nIntento ${status.intentosUsados + 1} de ${status.maxIntentos}.`);
  form.addTextItem().setTitle("Correo Institucional").setRequired(true);

  const normalizadas = crearPreguntasEnForm(form, parsed.preguntas, { examenId: form.getId(), videoId: "" });
  guardarClavesEnSheet(form.getId(), "reevaluacion_" + referencia, normalizadas);

  const refuerzoSheet = asegurarHojaSistema("_Progreso_Refuerzo");
  const datosToken = obtenerDatosToken_(token) || {};
  refuerzoSheet.appendRow([
    nuevoId("reeval"), (datosToken.email || "").toLowerCase().trim(), referencia, 0,
    "Reevaluación intento " + (status.intentosUsados + 1), "", "",
    "Reevaluación automática", new Date(), "REINTENTO", new Date(), 0
  ]);

  logInfo("LMS", `Reevaluación generada para ${referencia}.`);
  return { urlExamen: form.getPublishedUrl(), formId: form.getId() };
}

