function inicializarEstructuraHoja(forzar = false) {
  exigirOrigenInterno("inicializarEstructuraHoja");
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const props = PropertiesService.getScriptProperties();
  if (!forzar && props.getProperty("ESTRUCTURA_INICIALIZADA") === "true") return;

  let hoja = ss.getSheetByName(NOMBRE_HOJA_DATOS);
  if (!hoja) {
    const primera = ss.getSheets()[0];
    const nombresGenericos = ["Hoja 1", "Hoja1", "Sheet1", "Sheet 1"];
    if (primera.getLastRow() <= 1 && nombresGenericos.indexOf(primera.getName()) !== -1) {
      hoja = primera;
      hoja.setName(NOMBRE_HOJA_DATOS);
    } else {
      hoja = ss.insertSheet(NOMBRE_HOJA_DATOS, 0);
    }
  }

  asegurarColumnas(hoja, TOTAL_COLUMNAS);
  hoja.getRange(1, 1, 1, TOTAL_COLUMNAS).setValues([CABECERAS_CATALOGO])
    .setFontWeight("bold").setBackground("#1f2937").setFontColor("#ffffff").setHorizontalAlignment("center");

  hoja.setFrozenRows(1);
  hoja.setFrozenColumns(2);
  // Columnas de trabajo interno: el ID de Drive, el registro de error y el ID
  // del formulario. Se ocultan por IDX y no por número, para que sigan siendo
  // las correctas si el orden de columnas cambia.
  try {
    [IDX.DRIVE_RAG, IDX.ERROR, IDX.ID_FORM].forEach(i => hoja.hideColumns(i + 1));
  } catch (e) { /* ignora */ }

  aplicarValidacionURLs();
  aplicarTodasLasConfiguraciones();
  verificarYEstructurarHojasConfig(true);

  props.setProperty("ESTRUCTURA_INICIALIZADA", "true");
  props.setProperty("INIT_OK", "true");
  logInfo("Inicialización", `Estructura de ${TOTAL_COLUMNAS} columnas configurada.`);
  notificarUsuario(t("toast_estructura_ok", { cols: TOTAL_COLUMNAS }), "Init", 4);
}

function forzarInicializacionEstructura() {
  exigirOrigenInterno("forzarInicializacionEstructura");
  inicializarEstructuraHoja(true);
}

