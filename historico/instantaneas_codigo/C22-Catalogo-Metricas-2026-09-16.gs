/** Índices 0-based de la hoja _Intentos. */
const INT = {
  ID: 0, MODULO: 1, EMAIL: 2, NOMBRE: 3, INICIO: 4, FIN: 5, SEGUNDOS: 6, ESTADO: 7,
  SEMILLA: 8, TOTAL: 9, ACIERTOS: 10, ERRORES: 11, OMISIONES: 12, PORCENTAJE: 13,
  NIVEL: 14, TRAMPAS: 15, CAIDAS: 16, FORENSE: 17, NUMERO: 18, PREGUNTAS: 19
};
const INT_COLS = 20;
const DET_COLS = 10;

const ESTADO_INTENTO = { EN_CURSO: "EN_CURSO", ENTREGADO: "ENTREGADO", VENCIDO: "VENCIDO", ANULADO: "ANULADO" };

// -------------------------------------------------------------------------------------
// 9B.1 Definición de módulos
// -------------------------------------------------------------------------------------

/**
 * [OPT-15] Memoria de ejecución para las lecturas repetitivas.
 *
 * El problema medido: obtenerEstadoModuloUsuario() llamaba a listarModulos(),
 * listarFuentesModulo(), leerClavesExamen(), leía _Progreso_Visualizacion entera
 * y recorría _Intentos DOS veces. En la matriz de certificación eso se ejecuta
 * una vez por persona y por módulo: con 10 módulos y 50 personas eran ~500
 * pasadas, cada una releyendo hojas completas. Miles de lecturas para responder
 * una pregunta que cabe en tres.
 *
 * Este memo vive solo durante la ejecución actual (no es CacheService: no cruza
 * invocaciones ni usuarios) y cachea únicamente lecturas, nunca escrituras.
 * Cualquier función que escriba llama a limpiarMemoEjecucion().
 */
let _MEMO = null;

function memo(clave, calcular) {
  if (!_MEMO) _MEMO = {};
  if (Object.prototype.hasOwnProperty.call(_MEMO, clave)) return _MEMO[clave];
  const valor = calcular();
  _MEMO[clave] = valor;
  return valor;
}

/** Invalida la memoria de ejecución. La llama todo lo que escribe en estas hojas. */
function limpiarMemoEjecucion() { _MEMO = null; }

/** _Intentos completa, leída UNA vez por ejecución e indexada por correo. */
function obtenerIntentosIndexados() {
  exigirOrigenInterno("obtenerIntentosIndexados");
  return memo("intentos", function () {
    const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("_Intentos");
    const porCorreo = {};
    if (!sheet || sheet.getLastRow() < 2) return porCorreo;
    sheet.getRange(2, 1, sheet.getLastRow() - 1, INT_COLS).getValues().forEach((f, i) => {
      const correo = (f[INT.EMAIL] || "").toString().toLowerCase().trim();
      if (!correo) return;
      if (!porCorreo[correo]) porCorreo[correo] = [];
      porCorreo[correo].push({ fila: i + 2, datos: f });
    });
    Object.keys(porCorreo).forEach(c => {
      porCorreo[c].sort((a, b) => new Date(b.datos[INT.INICIO]) - new Date(a.datos[INT.INICIO]));
    });
    return porCorreo;
  });
}

/** _Progreso_Visualizacion completa, leída UNA vez e indexada por correo. */
function obtenerProgresoIndexado() {
  exigirOrigenInterno("obtenerProgresoIndexado");
  return memo("progreso", function () {
    const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("_Progreso_Visualizacion");
    const porCorreo = {};
    if (!sheet || sheet.getLastRow() < 2) return porCorreo;
    sheet.getRange(2, 1, sheet.getLastRow() - 1, 7).getValues().forEach(f => {
      const correo = (f[0] || "").toString().toLowerCase().trim();
      if (!correo) return;
      if (!porCorreo[correo]) porCorreo[correo] = {};
      porCorreo[correo][(f[1] || "").toString().trim()] =
        f[6] === true || (f[6] || "").toString().toLowerCase() === "true";
    });
    return porCorreo;
  });
}

/**
 * Título y URL de cada video, con una sola pasada del catálogo por ejecución.
 * Las fuentes de un módulo solo guardan el videoId; sin esto, «te faltan 3 videos»
 * no podría decir CUÁLES ni permitir ir a verlos, que es lo único útil del aviso.
 */
function obtenerIndiceCatalogo() {
  return memo("catalogo_idx", function () {
    const idx = {};
    iterarCatalogoPorBloques(function (datos) {
      datos.forEach(r => {
        const id = (r[IDX.ID] || "").toString().trim();
        if (!id) return;
        idx[id] = {
          titulo: (r[IDX.TITULO] || "").toString(),
          url: (r[IDX.URL] || "").toString(),
          duracion: parseFloat(r[IDX.DURACION]) || 0,
          dificultad: (r[IDX.DIFICULTAD] || "").toString()
        };
      });
      return false;
    });
    return idx;
  });
}

/** Banco validado de TODOS los módulos, con una sola lectura de _Claves_Examenes. */
function obtenerBancosPorModulo() {
  exigirOrigenInterno("obtenerBancosPorModulo");
  return memo("bancos", function () {
    const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("_Claves_Examenes");
    const porModulo = {};
    if (!sheet || sheet.getLastRow() < 2) return porModulo;
    sheet.getRange(2, 1, sheet.getLastRow() - 1, CABECERAS_CLAVES.length).getValues().forEach(f => {
      if ((f[CLAVE.VALIDACION] || "").toString().trim() !== VALIDACION.VALIDADA) return;
      const mod = (f[CLAVE.MODULO] || "").toString().trim();
      if (!mod) return;
      if (!porModulo[mod]) porModulo[mod] = 0;
      porModulo[mod]++;
    });
    return porModulo;
  });
}

function obtenerHojaModulos() { return asegurarHojaSistema("_Modulos"); }
function obtenerHojaFuentes() { return asegurarHojaSistema("_Modulos_Fuentes"); }
function obtenerHojaIntentos() { return asegurarHojaSistema("_Intentos"); }
function obtenerHojaDetalle() { return asegurarHojaSistema("_Respuestas_Detalle"); }

/** Devuelve todos los módulos definidos. Memoizado por ejecución [OPT-15]. */
function listarModulos() {
  return memo("modulos", leerModulosDeHoja);
}

function leerModulosDeHoja() {
  const sheet = obtenerHojaModulos();
  if (sheet.getLastRow() < 2) return [];
  return sheet.getRange(2, 1, sheet.getLastRow() - 1, 16).getValues()
    .filter(f => f[0])
    .map(f => ({
      id: (f[0] || "").toString().trim(),
      nombre: (f[1] || "").toString(),
      descripcion: (f[2] || "").toString(),
      rol: (f[3] || "").toString(),
      totalPreguntas: parseInt(f[4], 10) || 20,
      umbralVisualizacion: parseFloat(f[5]) || MODULO_UMBRAL_VISUALIZACION,
      ratioTrampas: parseFloat(f[6]) || MODULO_RATIO_MIN_TRAMPAS,
      permitirBlancos: f[7] === true || (f[7] || "").toString().toLowerCase() === "true",
      deadline: f[8] || "",
      umbralVelocidad: parseInt(f[9], 10) || MODULO_UMBRAL_VELOCIDAD_SEG,
      umbralIAMedio: parseFloat(f[10]) || MODULO_UMBRAL_IA_MEDIO,
      umbralIAAlto: parseFloat(f[11]) || MODULO_UMBRAL_IA_ALTO,
      maxIntentos: parseInt(f[12], 10) || MODULO_MAX_INTENTOS,
      estado: (f[13] || "ACTIVO").toString(),
      documentoMaestro: (f[14] || "").toString(),
      fechaCreacion: f[15] || ""
    }));
}

function obtenerModulo(moduloId) {
  if (!moduloId) return null;
  const encontrado = listarModulos().filter(m => m.id === moduloId.toString().trim());
  return encontrado.length > 0 ? encontrado[0] : null;
}

/** Crea o actualiza un módulo. Devuelve el módulo resultante. */
function guardarModulo(m) {
  exigirOrigenInterno("guardarModulo");
  limpiarMemoEjecucion();
  const sheet = obtenerHojaModulos();
  const fila = [
    m.id, m.nombre || m.id, m.descripcion || "", m.rol || "",
    parseInt(m.totalPreguntas, 10) || 20,
    parseFloat(m.umbralVisualizacion) || MODULO_UMBRAL_VISUALIZACION,
    parseFloat(m.ratioTrampas) || MODULO_RATIO_MIN_TRAMPAS,
    m.permitirBlancos === true,
    m.deadline || "",
    parseInt(m.umbralVelocidad, 10) || MODULO_UMBRAL_VELOCIDAD_SEG,
    parseFloat(m.umbralIAMedio) || MODULO_UMBRAL_IA_MEDIO,
    parseFloat(m.umbralIAAlto) || MODULO_UMBRAL_IA_ALTO,
    parseInt(m.maxIntentos, 10) || MODULO_MAX_INTENTOS,
    m.estado || "ACTIVO",
    m.documentoMaestro || "",
    m.fechaCreacion || new Date()
  ];

  if (sheet.getLastRow() >= 2) {
    const ids = sheet.getRange(2, 1, sheet.getLastRow() - 1, 1).getValues();
    for (let i = 0; i < ids.length; i++) {
      if ((ids[i][0] || "").toString().trim() === m.id) {
        sheet.getRange(i + 2, 1, 1, 16).setValues([fila]);
        return obtenerModulo(m.id);
      }
    }
  }
  sheet.appendRow(fila);
  logInfo("Módulos", `Módulo ${m.id} guardado.`);
  return obtenerModulo(m.id);
}

/** Fuentes (videos) de un módulo, ordenadas. */
/** Fuentes de un módulo. La hoja se lee una sola vez por ejecución [OPT-15]. */
function listarFuentesModulo(moduloId) {
  const todas = memo("fuentes", function () {
    const sheet = obtenerHojaFuentes();
    const porModulo = {};
    if (sheet.getLastRow() < 2) return porModulo;
    sheet.getRange(2, 1, sheet.getLastRow() - 1, 8).getValues().forEach(f => {
      const mod = (f[0] || "").toString().trim();
      if (!mod) return;
      if (!porModulo[mod]) porModulo[mod] = [];
      porModulo[mod].push({
        moduloId: f[0], identificador: (f[1] || "").toString(), videoId: (f[2] || "").toString().trim(),
        esPrimaria: f[3] === true || (f[3] || "").toString().toLowerCase() === "true",
        tema: (f[4] || "").toString(), alcance: (f[5] || "").toString(),
        preguntas: parseInt(f[6], 10) || 0, orden: parseInt(f[7], 10) || 0
      });
    });
    Object.keys(porModulo).forEach(m => porModulo[m].sort((a, b) => a.orden - b.orden));
    return porModulo;
  });
  return todas[(moduloId || "").toString().trim()] || [];
}

/** Reemplaza por completo las fuentes de un módulo. */
function guardarFuentesModulo(moduloId, fuentes) {
  exigirOrigenInterno("guardarFuentesModulo");
  limpiarMemoEjecucion();
  const sheet = obtenerHojaFuentes();
  if (sheet.getLastRow() >= 2) {
    const ids = sheet.getRange(2, 1, sheet.getLastRow() - 1, 1).getValues();
    for (let i = ids.length - 1; i >= 0; i--) {
      if ((ids[i][0] || "").toString().trim() === moduloId) sheet.deleteRow(i + 2);
    }
  }
  const filas = (fuentes || []).map((f, i) => ([
    moduloId, f.identificador || ("Video " + (i + 1)), f.videoId, f.esPrimaria === true,
    f.tema || "", f.alcance || "", parseInt(f.preguntas, 10) || 0, i + 1
  ]));
  if (filas.length > 0) sheet.getRange(sheet.getLastRow() + 1, 1, filas.length, 8).setValues(filas);
  return filas.length;
}

/** Escribe el Modulo_Id en la columna Y del catálogo para los videos indicados. */
/**
 * @return {{etiquetados:number, rechazados:Array<string>}} `etiquetados` cuenta
 *   solo los videos que CAMBIARON de módulo; los rechazados son videos que no
 *   pueden formar parte de un módulo certificable.
 */
function etiquetarVideosConModulo(moduloId, idsVideos) {
  exigirOrigenInterno("etiquetarVideosConModulo");
  const objetivo = {};
  (idsVideos || []).forEach(id => { objetivo[id.toString().trim()] = true; });
  let etiquetados = 0;
  const rechazados = [];

  iterarCatalogoPorBloques(function (datos) {
    let mutado = false;
    for (let i = 0; i < datos.length; i++) {
      const id = (datos[i][IDX.ID] || "").toString().trim();
      if (!objetivo[id]) continue;
      /* Un musical dentro de un módulo acaba generando preguntas de examen sobre
         la letra de una canción, y el certificado deja de significar nada. Se
         rechaza aquí, que es el único punto por el que se entra a un módulo. */
      if (!filaEsCertificable(datos[i])) {
        rechazados.push((datos[i][IDX.TITULO] || id).toString());
        continue;
      }
      /* Los que YA eran de este módulo no se vuelven a contar ni obligan a
         reescribir el bloque. Contarlos hacía que el informe dijera «2 videos
         asignados» cada vez que se repetía la misma asignación, sin que hubiera
         cambiado nada: quien lo lee no puede distinguir entre «funcionó» y «no
         hizo falta». Y marcar el bloque como mutado por una escritura que deja
         el mismo valor cuesta un setValues() y un flush() por cada bloque del
         catálogo en una operación que muchas veces no cambia ni una celda. */
      if ((datos[i][IDX.MODULO] || "").toString().trim() === moduloId) continue;
      datos[i][IDX.MODULO] = moduloId;
      etiquetados++;
      mutado = true;
    }
    return mutado;
  });

  if (rechazados.length) {
    logWarn("Módulos",
      `${rechazados.length} videos no certificables quedaron fuera de ${moduloId}.`);
  }
  return { etiquetados: etiquetados, rechazados: rechazados };
}

/**
 * Reparte `total` preguntas entre `n` fuentes sin que a ninguna le toque un
 * número negativo.
 *
 * El reparto anterior daba a la última fuente «lo que sobra», calculado como
 * `total - porFuente*(n-1)` con `porFuente` forzado a un mínimo de 1. Mientras
 * hubo más preguntas que videos eso cuadraba; en cuanto un módulo tiene más
 * videos que preguntas —cosa que la asignación masiva hace trivial: 40 videos
 * en un módulo de 20— la última fuente se lleva un número NEGATIVO, que acaba
 * escrito en `_Modulos_Fuentes` y de ahí en la generación del banco.
 *
 * Aquí el resto se reparte de uno en uno entre las primeras fuentes: la suma
 * sigue siendo exactamente `total`, ninguna baja de cero, y cuando hay más
 * videos que preguntas las últimas fuentes se quedan con cero. Una fuente sin
 * preguntas NO es un error: sigue siendo material de estudio del módulo y
 * sigue entrando en el contexto; simplemente no aporta preguntas al examen.
 */
function repartirPreguntas(total, n) {
  const cuantas = Math.max(0, parseInt(total, 10) || 0);
  const fuentes = Math.max(1, parseInt(n, 10) || 1);
  const base = Math.floor(cuantas / fuentes);
  const resto = cuantas - base * fuentes;
  const reparto = [];
  for (let i = 0; i < fuentes; i++) reparto.push(base + (i < resto ? 1 : 0));
  return reparto;
}

/** Asistente de creación de módulos desde el menú. */
function crearModuloUI() {
  const id = sanitizarEntrada(solicitarTexto("Nuevo módulo", "Identificador corto sin espacios (ej. odoo_kit_pos):"))
    .toLowerCase().replace(/[^a-z0-9_]/g, "_");
  if (!id) return;

  const existente = obtenerModulo(id);
  const nombre = solicitarTexto("Nombre visible", "Nombre del módulo:", existente ? existente.nombre : "") ||
    (existente ? existente.nombre : id);
  const rol = solicitarTexto("Rol objetivo", "¿A quién va dirigido? (ej. Personal de cocina, barra y salón):",
    existente ? existente.rol : "");
  const cantidad = parseInt(solicitarTexto("Tamaño del examen", "Número de preguntas del examen certificable:",
    existente ? String(existente.totalPreguntas) : "20"), 10) || 20;
  const umbral = parseInt(solicitarTexto("Umbral de visualización",
    "% de videos que hay que ver para habilitar el examen (por defecto 80):",
    existente ? String(existente.umbralVisualizacion) : "80"), 10) || MODULO_UMBRAL_VISUALIZACION;

  const modulo = guardarModulo({
    id: id, nombre: nombre, rol: rol, totalPreguntas: cantidad, umbralVisualizacion: umbral,
    descripcion: existente ? existente.descripcion : "",
    estado: "ACTIVO", fechaCreacion: existente ? existente.fechaCreacion : new Date()
  });

  const asignados = asignarVideosModuloUI(id);
  aplicarTodasLasConfiguraciones();
  notificarUsuario(t("toast_modulo_creado", { nombre: modulo.nombre, videos: asignados }), "Módulos", 6);
}

/**
 * Asigna al módulo los videos seleccionados en la hoja, o los que compartan
 * subcategoría si no hay selección.
 */
function asignarVideosModuloUI(moduloIdOpcional) {
  let moduloId = moduloIdOpcional;
  if (!moduloId) {
    const modulos = listarModulos();
    if (modulos.length === 0) { alertarUsuario(t("alert_sin_modulos")); return 0; }
    moduloId = solicitarTexto("Módulo", "Identificador del módulo:\n\n" + modulos.map(m => "• " + m.id).join("\n"));
    if (!moduloId) return 0;
  }
  const modulo = obtenerModulo(moduloId);
  if (!modulo) { alertarUsuario(t("err_modulo_no_existe", { modulo: moduloId })); return 0; }

  const hoja = obtenerHojaDatos();
  const rango = hoja.getActiveRange();
  const seleccion = [];

  if (rango && rango.getRow() >= 2 && rango.getNumRows() >= 1) {
    const valores = hoja.getRange(rango.getRow(), 1, rango.getNumRows(), TOTAL_COLUMNAS).getValues();
    // Se filtra ya en la selección: así el módulo no se construye con fuentes
    // que luego el etiquetado rechaza, y el reparto de preguntas cuadra.
    const descartados = [];
    valores.forEach(v => {
      const id = (v[IDX.ID] || "").toString().trim();
      if (!id) return;
      if (!filaEsCertificable(v)) { descartados.push((v[IDX.TITULO] || id).toString()); return; }
      seleccion.push({ videoId: id, titulo: (v[IDX.TITULO] || "").toString(), url: v[IDX.URL] });
    });
    if (descartados.length) {
      alertarUsuario(
        `${descartados.length} de los videos seleccionados no son certificables y se dejaron fuera:\n\n` +
        descartados.slice(0, 8).map(t => "· " + t.slice(0, 70)).join("\n") +
        (descartados.length > 8 ? `\n… y ${descartados.length - 8} más.` : "") +
        "\n\nUn examen sobre contenido musical no certifica nada. Cámbiales el " +
        "ecosistema si crees que sí son material de capacitación.",
        "Módulos");
    }
  }

  if (seleccion.length === 0) {
    alertarUsuario("Selecciona en la hoja las filas de los videos que componen el módulo y vuelve a ejecutar.", "Módulos");
    return 0;
  }

  const reparto = repartirPreguntas(modulo.totalPreguntas, seleccion.length);
  const fuentes = seleccion.map((s, i) => ({
    identificador: "Video " + (i + 1),
    videoId: s.videoId,
    esPrimaria: i === 0,
    tema: s.titulo.slice(0, 120),
    alcance: "",
    preguntas: reparto[i]
  }));

  guardarFuentesModulo(moduloId, fuentes);
  etiquetarVideosConModulo(moduloId, seleccion.map(s => s.videoId));
  logInfo("Módulos", `${fuentes.length} fuentes asignadas al módulo ${moduloId}.`);
  return fuentes.length;
}

/**
 * Videos del catálogo que encajan con unos filtros de la cascada.
 *
 * Reutiliza EXACTAMENTE los mismos campos que el catálogo del portal —
 * ecosistema, área, tema, versión, dificultad, fuente— para que «lo que veo
 * filtrado» y «lo que voy a asignar» sean el mismo conjunto. Si esto tuviera su
 * propia forma de filtrar, el administrador vería 30 videos en el catálogo y
 * asignaría 34 sin enterarse.
 *
 * @return {{coinciden:Array, rechazados:Array<string>, ocupados:Array}}
 *   coinciden  → certificables y libres, o ya de este módulo
 *   rechazados → no certificables (musicales): nunca entran en un módulo
 *   ocupados   → ya pertenecen a OTRO módulo
 */
function buscarVideosParaModulo(moduloId, filtros) {
  const f = filtros || {};
  const coinciden = [], rechazados = [], ocupados = [];

  function encaja(fila, campo, valor) {
    if (!valor) return true;
    return (fila[campo] || "").toString().trim() === valor.toString().trim();
  }

  iterarCatalogoPorBloques(function (datos) {
    datos.forEach(function (r) {
      const id = (r[IDX.ID] || "").toString().trim();
      if (!id) return;
      if (!encaja(r, IDX.ECOSISTEMA, f.ecosistema)) return;
      if (!encaja(r, IDX.AREA, f.area)) return;
      if (!encaja(r, IDX.TEMA, f.tema)) return;
      if (!encaja(r, IDX.VERSION, f.version)) return;
      if (!encaja(r, IDX.DIFICULTAD, f.dificultad)) return;
      if (!encaja(r, IDX.FUENTE, f.fuente)) return;

      const titulo = (r[IDX.TITULO] || id).toString();
      if (!filaEsCertificable(r)) { rechazados.push(titulo); return; }

      const suyo = (r[IDX.MODULO] || "").toString().trim();
      if (suyo && suyo !== moduloId) {
        ocupados.push({ videoId: id, titulo: titulo, modulo: suyo });
        return;
      }
      coinciden.push({ videoId: id, titulo: titulo });
    });
    return false;   // solo lectura
  });

  return { coinciden: coinciden, rechazados: rechazados, ocupados: ocupados };
}

/**
 * [ADMIN] Asigna en bloque al módulo todos los videos que cumplan unos filtros,
 * en vez de uno por uno. Con 788 videos en la hoja, seleccionar a mano las
 * filas de un módulo es el paso que hace que los módulos no se creen.
 *
 * `simular: true` NO escribe nada: devuelve el mismo recuento para poder
 * enseñarlo antes de tocar el catálogo. Asignar en bloque es difícil de
 * deshacer —hay que volver a buscar qué videos se movieron—, así que la vista
 * previa no es un adorno.
 *
 * Los videos de OTRO módulo se dejan fuera salvo que se pida `reemplazar`:
 * moverlos rompe el reparto de preguntas del módulo del que salen, y ese daño
 * no se ve hasta que alguien presenta ese otro examen.
 *
 * @param {string} token
 * @param {string} moduloId
 * @param {Object} filtros    ecosistema/area/tema/version/dificultad/fuente
 * @param {Object} opciones   {simular:boolean, reemplazar:boolean}
 */
function asignarVideosPorFiltros(token, moduloId, filtros, opciones) {
  validarTokenConScope(token, "admin");
  marcarOrigenConfiable();
  const op = opciones || {};

  const modulo = obtenerModulo((moduloId || "").toString().trim());
  if (!modulo) return { exito: false, mensaje: "Ese módulo no existe." };

  const f = filtros || {};
  const hayFiltro = Boolean(f.ecosistema || f.area || f.tema || f.version || f.dificultad || f.fuente);
  if (!hayFiltro) {
    // Sin filtros esto asignaría el catálogo entero a un módulo de un clic.
    return { exito: false, mensaje: "Elige al menos un filtro: sin ninguno entraría todo el catálogo." };
  }

  const hallazgo = buscarVideosParaModulo(modulo.id, f);
  const seleccion = op.reemplazar === true
    ? hallazgo.coinciden.concat(hallazgo.ocupados.map(function (o) {
        return { videoId: o.videoId, titulo: o.titulo };
      }))
    : hallazgo.coinciden;

  const informe = {
    exito: true,
    simulado: op.simular === true,
    moduloId: modulo.id,
    modulo: modulo.nombre,
    aAsignar: seleccion.length,
    noCertificables: hallazgo.rechazados.length,
    ejemplosNoCertificables: hallazgo.rechazados.slice(0, 5),
    enOtroModulo: hallazgo.ocupados.length,
    ejemplosEnOtroModulo: hallazgo.ocupados.slice(0, 5),
    asignados: 0
  };

  if (seleccion.length === 0) {
    informe.mensaje = hallazgo.ocupados.length
      ? "Todos los que coinciden ya pertenecen a otro módulo."
      : "Ningún video del catálogo coincide con esos filtros.";
    return informe;
  }
  if (op.simular === true) {
    informe.mensaje = seleccion.length + " video(s) se asignarían a " + modulo.nombre + ".";
    return informe;
  }

  /* Las fuentes se REESCRIBEN con el conjunto completo del módulo, no solo con
     lo que entra ahora: `guardarFuentesModulo` sustituye las filas del módulo,
     así que pasarle únicamente lo nuevo dejaría fuera del examen los videos que
     ya estaban. Por eso se relee el catálogo después de etiquetar. */
  const etiquetado = etiquetarVideosConModulo(modulo.id, seleccion.map(function (s) { return s.videoId; }));

  const delModulo = [];
  iterarCatalogoPorBloques(function (datos) {
    datos.forEach(function (r) {
      if ((r[IDX.MODULO] || "").toString().trim() !== modulo.id) return;
      delModulo.push({
        videoId: (r[IDX.ID] || "").toString().trim(),
        titulo: (r[IDX.TITULO] || "").toString()
      });
    });
    return false;
  });

  const total = modulo.totalPreguntas || 20;
  const reparto = repartirPreguntas(total, delModulo.length);
  guardarFuentesModulo(modulo.id, delModulo.map(function (v, i) {
    return {
      identificador: "Video " + (i + 1),
      videoId: v.videoId,
      esPrimaria: i === 0,
      tema: v.titulo.slice(0, 120),
      alcance: "",
      preguntas: reparto[i]
    };
  }));

  informe.asignados = etiquetado.etiquetados;
  informe.totalEnModulo = delModulo.length;
  informe.mensaje = etiquetado.etiquetados + " video(s) asignados. El módulo tiene ahora " +
    delModulo.length + ".";
  logInfo("Módulos", `Asignación masiva a ${modulo.id}: ${etiquetado.etiquetados} videos.`);
  return informe;
}

