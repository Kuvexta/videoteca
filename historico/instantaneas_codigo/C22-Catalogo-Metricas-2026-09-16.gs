function enviarMensajeTelegram(chatId, mensajeTexto) {
  const props = PropertiesService.getScriptProperties();
  const botToken = props.getProperty("TELEGRAM_BOT_TOKEN");
  const destino = chatId || props.getProperty("TELEGRAM_CHAT_ID");
  if (!botToken || !destino) return { exito: false };

  const r = ejecutarFetchSeguro(URL_TELEGRAM_BOT_BASE + botToken + "/sendMessage", {
    method: "POST",
    contentType: "application/json",
    payload: JSON.stringify({ chat_id: destino, text: mensajeTexto, parse_mode: "HTML" })
  }, "Telegram");
  if (!r.ok) logWarn("Telegram", "HTTP " + r.codigo);
  return { exito: r.ok };
}

function enviarMensajeWhatsApp(telefono, mensajeTexto) {
  const webhookUrl = PropertiesService.getScriptProperties().getProperty("WEBHOOK_NOTIFICACIONES_URL");
  if (!webhookUrl) return { exito: false };
  const res = enviarWebhookConReintento(webhookUrl, { canal: "whatsapp", telefono: telefono, mensaje: mensajeTexto });
  return { exito: res.success };
}

function enviarWebhookConReintento(url, payload, config = WEBHOOK_RETRY_CONFIG) {
  let attempt = 0;
  let delay = config.baseDelay;
  let lastError = null;

  while (attempt < config.maxAttempts) {
    const r = ejecutarFetchSeguro(url, {
      method: "POST",
      contentType: "application/json",
      payload: JSON.stringify(payload)
    }, "Webhook");

    if (r.ok) return { success: true, attempt: attempt + 1 };
    lastError = `HTTP ${r.codigo}: ${(r.cuerpo || r.error || "").toString().slice(0, 200)}`;

    attempt++;
    if (attempt < config.maxAttempts) {
      Utilities.sleep(delay);
      delay *= config.backoffFactor;
    }
  }
  logError("Webhook", `Fallo definitivo hacia ${url}: ${lastError}`);
  return { success: false, error: lastError };
}

/**
 * [OPT-10] Envío garantizado: si los reintentos inmediatos no bastan, la entrega
 * NO se pierde — pasa a la cola diferida y se reintenta con espera creciente.
 * Es la diferencia entre "el webhook estaba caído 30 segundos" y "esa alerta
 * nunca llegó y nadie se enteró".
 */
function enviarWebhookGarantizado(url, payload) {
  if (!url) return { success: false, error: "URL vacía" };
  const res = enviarWebhookConReintento(url, payload);
  if (!res.success) {
    encolarTareaDiferida("webhook", { url: url, payload: payload }, res.error || "Webhook no entregado");
  }
  return res;
}

function notificarEvento(evento, datos) {
  exigirOrigenInterno("notificarEvento");
  const props = PropertiesService.getScriptProperties();

  const webhookUrl = props.getProperty("WEBHOOK_NOTIFICACIONES_URL");
  if (webhookUrl) {
    enviarWebhookGarantizado(webhookUrl,
      { evento: evento, datos: datos, timestamp: new Date().toISOString(), version: VERSION_SCRIPT });
  }
  const webhookAgentes = props.getProperty("WEBHOOK_AGENTES_URL");
  if (webhookAgentes) {
    enviarWebhookGarantizado(webhookAgentes, { evento: evento, datos: datos, timestamp: new Date().toISOString() });
  }
  if (props.getProperty("ALERTAS_TELEGRAM_ACTIVO") === "true") {
    const mensajeTg = `<b>${evento}</b>\n<pre>${JSON.stringify(datos).slice(0, 500)}</pre>`;
    const rTg = enviarMensajeTelegram(null, mensajeTg);
    // Evita el bucle: un fallo notificando "tarea_agotada" no vuelve a la cola.
    if (!rTg.exito && evento !== "tarea_agotada") {
      encolarTareaDiferida("telegram", { mensaje: mensajeTg }, "Telegram no disponible");
    }
  }
  if (props.getProperty("ALERTAS_EMAIL_ACTIVO") === "true") {
    let destinatario = props.getProperty("ALERTAS_EMAIL_DESTINO");
    if (!destinatario) { try { destinatario = Session.getActiveUser().getEmail(); } catch (e) { destinatario = ""; } }
    if (destinatario) {
      try {
        MailApp.sendEmail({
          to: destinatario,
          subject: t("mail_evento_asunto", { evento: evento }),
          htmlBody: `<p>Evento del Sistema: <b>${evento}</b></p><pre>${JSON.stringify(datos, null, 2)}</pre>`
        });
      } catch (e) {
        logWarn("Correo", "No se pudo enviar la alerta: " + e.message);
        if (evento !== "tarea_agotada") {
          encolarTareaDiferida("email", {
            to: destinatario,
            subject: t("mail_evento_asunto", { evento: evento }),
            htmlBody: `<p>Evento del Sistema: <b>${evento}</b></p><pre>${JSON.stringify(datos, null, 2)}</pre>`
          }, "Cuota de correo o destinatario rechazado");
        }
      }
    }
  }
}

function enviarEmailRefuerzo(correo, formId, numTareas) {
  exigirOrigenInterno("enviarEmailRefuerzo");
  const apoyoActivo = PropertiesService.getScriptProperties().getProperty("ALERTAS_APOYO_ALUMNO_ACTIVO") !== "false";
  if (!apoyoActivo || !correo) return false;
  try {
    MailApp.sendEmail({
      to: correo,
