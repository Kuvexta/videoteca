// 9B.3 Progreso del alumno dentro del módulo
// -------------------------------------------------------------------------------------

/** [F1-2] Progreso real: se lee de _Progreso_Visualizacion, que no se purga. */
function verificarProgresoModulo(email, moduloId) {
  const fuentes = listarFuentesModulo(moduloId);
  const modulo = obtenerModulo(moduloId);
  const total = fuentes.length;
  if (total === 0) return { total: 0, vistos: 0, porcentaje: 0, habilitado: false, requeridos: 0 };

  const correo = (email || "").toString().toLowerCase().trim();
  // [OPT-15] Antes esto releía _Progreso_Visualizacion entera por cada módulo
  // y por cada persona; ahora la hoja se lee una vez por ejecución.
  const vistosPorId = obtenerProgresoIndexado()[correo] || {};

  const vistos = fuentes.filter(f => vistosPorId[f.videoId]).length;
  const porcentaje = Math.round((vistos / total) * 100);
  const umbral = modulo ? modulo.umbralVisualizacion : MODULO_UMBRAL_VISUALIZACION;
  const requeridos = Math.ceil((umbral / 100) * total);

  return {
    total: total, vistos: vistos, porcentaje: porcentaje,
    requeridos: requeridos, umbral: umbral,
    habilitado: vistos >= requeridos,
    detalle: fuentes.map(function (f) {
      const meta = obtenerIndiceCatalogo()[f.videoId] || {};
      return {
        identificador: f.identificador,
        videoId: f.videoId,
        titulo: meta.titulo || f.identificador || f.videoId,
        url: meta.url || "",
        duracion: meta.duracion || 0,
        tema: f.tema || "",
        visto: Boolean(vistosPorId[f.videoId])
      };
    })
  };
}

/** Intentos de un usuario en un módulo, del más reciente al más antiguo. */
/** Intentos de un usuario, del índice memoizado y ya ordenados [OPT-15]. */
function listarIntentosUsuario(email, moduloId) {
  const correo = (email || "").toString().toLowerCase().trim();
  const suyos = obtenerIntentosIndexados()[correo] || [];
  if (!moduloId) return suyos;
  const mod = moduloId.toString().trim();
  return suyos.filter(r => (r.datos[INT.MODULO] || "").toString().trim() === mod);
}

function leerIntento(intentoId) {
  exigirOrigenInterno("leerIntento");
  const sheet = obtenerHojaIntentos();
  if (sheet.getLastRow() < 2) return null;
  const datos = sheet.getRange(2, 1, sheet.getLastRow() - 1, INT_COLS).getValues();
  for (let i = 0; i < datos.length; i++) {
    if ((datos[i][INT.ID] || "").toString().trim() === intentoId) {
      return { fila: i + 2, datos: datos[i] };
    }
  }
  return null;
}

function actualizarIntento(fila, datos) {
  exigirOrigenInterno("actualizarIntento");
  obtenerHojaIntentos().getRange(fila, 1, 1, INT_COLS).setValues([datos]);
  limpiarMemoEjecucion();   // el índice memoizado ya no refleja la hoja
}

/** Marca como VENCIDO los intentos abandonados. Lo invoca el mantenimiento semanal. */
function caducarIntentosAbandonados() {
  exigirOrigenInterno("caducarIntentosAbandonados");
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("_Intentos");
  if (!sheet || sheet.getLastRow() < 2) return 0;
  const rango = sheet.getRange(2, 1, sheet.getLastRow() - 1, INT_COLS);
  const datos = rango.getValues();
  const limite = Date.now() - (INTENTO_VIGENCIA_HORAS * 60 * 60 * 1000);
  let caducados = 0;

  for (let i = 0; i < datos.length; i++) {
    if ((datos[i][INT.ESTADO] || "") !== ESTADO_INTENTO.EN_CURSO) continue;
    const inicio = new Date(datos[i][INT.INICIO]).getTime();
    if (!isNaN(inicio) && inicio < limite) {
      datos[i][INT.ESTADO] = ESTADO_INTENTO.VENCIDO;
      datos[i][INT.FIN] = new Date();
      caducados++;
    }
  }
  if (caducados > 0) { rango.setValues(datos); limpiarMemoEjecucion(); }
  return caducados;
}

/** Estado completo de un módulo para un usuario (alimenta la pestaña «Mis Módulos»). */
function obtenerEstadoModuloUsuario(email, moduloId) {
  exigirOrigenInterno("obtenerEstadoModuloUsuario");
  const modulo = obtenerModulo(moduloId);
  if (!modulo) return null;

  const progreso = verificarProgresoModulo(email, moduloId);

  // [OPT-15] Un único recorrido: antes se listaba dos veces para separar
  // entregados de en curso.
  const todos = listarIntentosUsuario(email, moduloId);
  const intentos = [];
  const enCurso = [];
  todos.forEach(r => {
    const est = r.datos[INT.ESTADO];
    if (est === ESTADO_INTENTO.ENTREGADO) intentos.push(r);
    else if (est === ESTADO_INTENTO.EN_CURSO) enCurso.push(r);
  });
  const ultimo = intentos.length > 0 ? intentos[0].datos : null;

  const porcentaje = ultimo ? Number(ultimo[INT.PORCENTAJE]) || 0 : 0;
  const escala = ultimo ? resolverNivelDesempeno(porcentaje) : null;

  let estado = "SIN_EMPEZAR";
  if (ultimo) {
    if (escala.certifica) estado = "CERTIFICADO";
    else if (porcentaje >= 60) estado = "APROBADO_SIN_CERTIFICAR";
    else estado = "REQUIERE_REFUERZO";
  } else if (progreso.habilitado) estado = "LISTO_PARA_EXAMEN";
  else if (progreso.vistos > 0) estado = "EN_PROGRESO";

  // [OPT-15] Solo hace falta el CONTEO, no las preguntas: se toma del índice
  // agregado en vez de materializar el banco entero por módulo y por persona.
  const preguntasDisponibles = obtenerBancosPorModulo()[moduloId] || 0;

  // [F1-2] Motivo del bloqueo, resuelto en el servidor.
  // El portal no debe deducirlo: si la regla cambia aquí, el mensaje cambia solo,
  // y no acaban divergiendo lo que el sistema hace y lo que la pantalla dice.
  let plazoVencido = false;
  let fechaLimite = "";
  if (modulo.deadline) {
    const dl = new Date(modulo.deadline);
    if (!isNaN(dl.getTime())) {
      fechaLimite = formatearFecha(dl, "yyyy-MM-dd");
      plazoVencido = dl.getTime() < Date.now();
    }
  }

  const intentosAgotados = intentos.length >= modulo.maxIntentos;
  let motivoBloqueo = "";
  if (enCurso.length > 0) motivoBloqueo = "";                       // hay uno abierto: se continúa
  else if (plazoVencido) motivoBloqueo = "plazo_vencido";
  else if (intentosAgotados) motivoBloqueo = "intentos_agotados";
  else if (preguntasDisponibles < modulo.totalPreguntas) motivoBloqueo = "banco_incompleto";
  else if (!progreso.habilitado) motivoBloqueo = "falta_visualizacion";

  return {
    moduloId: modulo.id,
    nombre: modulo.nombre,
    descripcion: modulo.descripcion,
    rol: modulo.rol,
    totalVideos: progreso.total,
    videosVistos: progreso.vistos,
    porcentajeAvance: progreso.porcentaje,
    umbralRequerido: progreso.umbral,
    habilitadoExamen: progreso.habilitado && preguntasDisponibles > 0 && !plazoVencido && !intentosAgotados,
    preguntasDisponibles: preguntasDisponibles,
    totalPreguntas: modulo.totalPreguntas,
    intentosUsados: intentos.length,
    maxIntentos: modulo.maxIntentos,
    intentoEnCurso: enCurso.length > 0 ? enCurso[0].datos[INT.ID] : "",
    ultimoPorcentaje: porcentaje,
    ultimoNivel: ultimo ? (ultimo[INT.NIVEL] || "") : "",
    ultimoIntentoId: ultimo ? ultimo[INT.ID] : "",
    examenCompletado: Boolean(ultimo),
    examenAprobado: escala ? escala.certifica : false,
    // Solo SI lo tiene, nunca el id de Drive. Con el id en el navegador, un
    // enlace a Drive deja el documento al alcance de cualquiera a quien se le
    // reenvíe; y además ese id nunca fue un enlace válido, así que el botón
    // «Documento maestro» del portal llevaba a ninguna parte. El contenido se
    // pide ahora por `documento_maestro`, que solo acepta un id de módulo.
    tieneDocumentoMaestro: Boolean((modulo.documentoMaestro || "").toString().trim()),
    estado: estado,
    videos: progreso.detalle,
    videosRequeridos: progreso.requeridos,
    deadline: fechaLimite,
    plazoVencido: plazoVencido,
    intentosAgotados: intentosAgotados,
    motivoBloqueo: motivoBloqueo,
    puedeIniciar: motivoBloqueo === "" && (enCurso.length > 0 || (progreso.habilitado && preguntasDisponibles >= modulo.totalPreguntas))
  };
}

/** Lista los módulos con el avance del usuario autenticado (portal). */
function obtenerModulosUsuario(token) {
  validarTokenConScope(token, "read_only");
  const datos = obtenerDatosToken_(token) || {};
  const email = (datos.email || "").toLowerCase().trim();
  return listarModulos()
    .filter(m => m.estado !== "ARCHIVADO")
    .map(m => obtenerEstadoModuloUsuario(email, m.id))
    .filter(Boolean);
}

// -------------------------------------------------------------------------------------
// 9B.4 [F1-2] QUIZ NATIVO · las tres acciones
// -------------------------------------------------------------------------------------

/**
 * ACCIÓN 1 — Inicia un intento. Valida identidad, progreso, plazo e intentos,
 * crea la fila en _Intentos con la hora del servidor y devuelve las preguntas
 * SIN la clave: nunca viajan indice correcto, justificación, cebo ni segundo.
 */
function iniciarIntentoModulo(token, moduloId) {
  validarTokenConScope(token, "read_only");
  const datosToken = obtenerDatosToken_(token);
  if (!datosToken) throw new Error(t("err_sin_token"));
  const email = (datosToken.email || "").toLowerCase().trim();
  if (!email) throw new Error(t("err_sin_correo_token"));

  const modulo = obtenerModulo(moduloId);
  if (!modulo || modulo.estado === "ARCHIVADO") throw new Error(t("err_modulo_no_existe", { modulo: moduloId }));

  const previos = listarIntentosUsuario(email, moduloId);

  // [F1-2] REANUDACIÓN PRIMERO, antes de cualquier otra puerta.
  //
  // Un intento dura hasta 6 h y un plazo puede vencer justo en medio. Si el plazo
  // se comprobara antes, quien empezó a tiempo perdería el trabajo hecho Y el
  // intento consumido, por un límite que respetó al empezar. Lo mismo vale para
  // el progreso: ya se validó al abrirlo, no tiene sentido volver a exigirlo.
  const abierto = previos.filter(r => r.datos[INT.ESTADO] === ESTADO_INTENTO.EN_CURSO);
  if (abierto.length > 0) {
    const r = abierto[0];
    const inicio = new Date(r.datos[INT.INICIO]).getTime();
    if (!isNaN(inicio) && (Date.now() - inicio) < INTENTO_VIGENCIA_HORAS * 3600 * 1000) {
      logInfo("Quiz", `Reanudando intento ${r.datos[INT.ID]} de ${email}.`);
      return reconstruirIntentoAbierto(r, modulo);
    }
    r.datos[INT.ESTADO] = ESTADO_INTENTO.VENCIDO;
    r.datos[INT.FIN] = new Date();
    actualizarIntento(r.fila, r.datos);
  }

  // A partir de aquí se abre uno NUEVO, y ahí sí aplican todas las puertas.

  // Plazo.
  if (modulo.deadline) {
    const limite = new Date(modulo.deadline);
    if (!isNaN(limite.getTime()) && new Date() > limite) {
      throw new Error(t("err_deadline", { fecha: formatearFecha(limite, "yyyy-MM-dd HH:mm") }));
    }
  }

  // Progreso: se revalida en el servidor; el botón del portal no es control de acceso.
  const progreso = verificarProgresoModulo(email, moduloId);
  if (!progreso.habilitado) {
    throw new Error(t("err_progreso_insuficiente", {
      requeridos: progreso.requeridos, total: progreso.total, vistos: progreso.vistos
    }));
  }

  // Intentos disponibles.
  const entregados = previos.filter(r => r.datos[INT.ESTADO] === ESTADO_INTENTO.ENTREGADO);
  if (entregados.length >= modulo.maxIntentos) {
    throw new Error(t("err_intentos_agotados", { max: modulo.maxIntentos }));
  }

  // Banco validado.
  const banco = leerClavesExamen({ moduloId: moduloId, soloValidadas: true });
  if (banco.length === 0) {
    throw new Error(t("err_banco_insuficiente", { disponibles: 0, requeridas: modulo.totalPreguntas }));
  }

  const semilla = Utilities.getUuid().slice(0, 8);
  const seleccion = barajarConSemilla(banco, semilla).slice(0, Math.min(modulo.totalPreguntas, banco.length));
  const intentoId = nuevoId("int");

  const fila = new Array(INT_COLS).fill("");
  fila[INT.ID] = intentoId;
  fila[INT.MODULO] = moduloId;
  fila[INT.EMAIL] = email;
  fila[INT.NOMBRE] = datosToken.client || resolverNombreVisible(email);
  fila[INT.INICIO] = new Date();
  fila[INT.ESTADO] = ESTADO_INTENTO.EN_CURSO;
  fila[INT.SEMILLA] = semilla;
  fila[INT.TOTAL] = seleccion.length;
  fila[INT.NUMERO] = entregados.length + 1;
  fila[INT.PREGUNTAS] = JSON.stringify(seleccion.map(q => q.numero));
  obtenerHojaIntentos().appendRow(fila);

  logInfo("Quiz", `Intento ${intentoId} iniciado por ${email} en ${moduloId} (${seleccion.length} preguntas).`);

  return {
    intentoId: intentoId,
    moduloId: moduloId,
    modulo: modulo.nombre,
    numeroIntento: entregados.length + 1,
    maxIntentos: modulo.maxIntentos,
    permitirBlancos: modulo.permitirBlancos,
    totalPreguntas: seleccion.length,
    preguntas: seleccion.map(q => filtrarPreguntaParaCliente(q, semilla))
  };
}

/** Reconstruye la vista de un intento aún abierto, con el mismo barajado. */
function reconstruirIntentoAbierto(registro, modulo) {
  const intentoId = registro.datos[INT.ID];
  const semilla = registro.datos[INT.SEMILLA];
  let numeros = [];
  try { numeros = JSON.parse(registro.datos[INT.PREGUNTAS] || "[]"); } catch (e) { numeros = []; }

  const banco = leerClavesExamen({ moduloId: registro.datos[INT.MODULO], soloValidadas: true });
  const porNumero = {};
  banco.forEach(q => { porNumero[q.numero] = q; });
  const seleccion = numeros.map(n => porNumero[n]).filter(Boolean);

  const respondidas = leerRespuestasIntento(intentoId);
  const mapa = {};
  respondidas.forEach(r => { mapa[r.numero] = r; });

  return {
    intentoId: intentoId,
    moduloId: registro.datos[INT.MODULO],
    modulo: modulo.nombre,
    numeroIntento: registro.datos[INT.NUMERO],
    maxIntentos: modulo.maxIntentos,
    permitirBlancos: modulo.permitirBlancos,
    totalPreguntas: seleccion.length,
    reanudado: true,
    preguntas: seleccion.map(q => {
      const vista = filtrarPreguntaParaCliente(q, semilla);
      if (mapa[q.numero]) {
        vista.respuestaPrevia = mapa[q.numero].indiceElegido;
        vista.textoPrevio = mapa[q.numero].textoRespuesta;
      }
      return vista;
    })
  };
}

/**
 * Filtra una pregunta para el navegador. Regla de seguridad del sistema:
 * la clave, la justificación, la causa raíz, el cebo y el segundo NUNCA viajan.
 */
function filtrarPreguntaParaCliente(q, semilla) {
  // Las opciones también se barajan, con permutación estable por pregunta.
  const indices = barajarConSemilla(q.opciones.map((_, i) => i), semilla + "_" + q.numero);
  return {
    numero: q.numero,
    texto: q.texto,
    tipo: q.tipo,
    opciones: indices.map(i => q.opciones[i]),
    // Mapa de presentación → original. Se guarda en el cliente solo para devolverlo tal cual.
    orden: indices,
    area: q.area
  };
}

/** ACCIÓN 2 — Guarda una respuesta parcial para permitir reanudar. */
function guardarAvanceIntento(token, intentoId, respuesta) {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(5000)) throw new Error(t("err_sistema_ocupado"));
  try {
  validarTokenConScope(token, "read_only");
  const datosToken = obtenerDatosToken_(token);
  if (!datosToken) throw new Error(t("err_sin_token"));

  const registro = leerIntento(intentoId);
  if (!registro || registro.datos[INT.ESTADO] !== ESTADO_INTENTO.EN_CURSO) {
    return { exito: false, mensaje: t("err_intento_no_existe") };
  }
  if ((registro.datos[INT.EMAIL] || "").toLowerCase() !== (datosToken.email || "").toLowerCase()) {
    throw new Error(t("err_intento_ajeno"));
  }

  escribirRespuestaParcial(intentoId, registro.datos[INT.EMAIL], registro.datos[INT.MODULO], respuesta);
  return { exito: true };
  } finally { lock.releaseLock(); }
}

/** Guarda o actualiza una respuesta parcial en _Respuestas_Detalle. */
function escribirRespuestaParcial(intentoId, email, moduloId, respuesta) {
  exigirOrigenInterno("escribirRespuestaParcial");
  const sheet = obtenerHojaDetalle();
  const numero = parseInt(respuesta.numeroPregunta, 10);
  if (isNaN(numero)) return false;

  if (sheet.getLastRow() >= 2) {
    const datos = sheet.getRange(2, 1, sheet.getLastRow() - 1, 4).getValues();
    for (let i = 0; i < datos.length; i++) {
      if ((datos[i][0] || "").toString() === intentoId && parseInt(datos[i][3], 10) === numero) {
        sheet.getRange(i + 2, 5, 1, 2).setValues([[
          respuesta.indiceElegido === undefined ? -1 : respuesta.indiceElegido,
          respuesta.textoRespuesta || ""
        ]]);
        return true;
      }
    }
  }

  sheet.appendRow([
    intentoId, email, moduloId, numero,
    respuesta.indiceElegido === undefined ? -1 : respuesta.indiceElegido,
    respuesta.textoRespuesta || "", "", false, "", new Date()
  ]);
  return true;
}

function leerRespuestasIntento(intentoId) {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("_Respuestas_Detalle");
  if (!sheet || sheet.getLastRow() < 2) return [];
  return sheet.getRange(2, 1, sheet.getLastRow() - 1, DET_COLS).getValues()
    .filter(f => (f[0] || "").toString() === intentoId)
    .map(f => ({
      numero: parseInt(f[3], 10), indiceElegido: parseInt(f[4], 10),
      textoRespuesta: (f[5] || "").toString(), resultado: (f[6] || "").toString(),
      cayoEnCebo: f[7] === true, area: (f[8] || "").toString()
    }));
}

/**
 * ACCIÓN 3 — Entrega y califica el intento.
 * Toma un bloqueo breve para que una doble pulsación no genere dos calificaciones.
 */
function entregarIntentoModulo(token, intentoId, respuestas) {
  validarTokenConScope(token, "read_only");
  const datosToken = obtenerDatosToken_(token);
  if (!datosToken) throw new Error(t("err_sin_token"));

  const lock = LockService.getScriptLock();
  try {
    lock.waitLock(20000);
  } catch (e) {
    throw new Error(t("err_sistema_ocupado"));
  }

  try {
    const registro = leerIntento(intentoId);
    if (!registro) throw new Error(t("err_intento_no_existe"));
    if ((registro.datos[INT.EMAIL] || "").toLowerCase() !== (datosToken.email || "").toLowerCase()) {
      throw new Error(t("err_intento_ajeno"));
    }
    if (registro.datos[INT.ESTADO] === ESTADO_INTENTO.ENTREGADO) {
      // Idempotencia: si ya se calificó, se devuelve el informe existente.
      return obtenerInformeIntento(intentoId);
    }

    /* [6.23] EL ESTADO Y EL RELOJ, que aquí no se miraban.
       Solo se trataba el caso ENTREGADO; VENCIDO y ANULADO caían por el mismo
       sitio que un intento vivo y se calificaban igual, certificado incluido.
       Y la vigencia se comprobaba únicamente al ABRIR el examen: quien empezaba
       uno, lo dejaba caducar y lo entregaba tres días después era calificado
       como si lo hubiera hecho en la hora que le tocaba. Las dos puertas van
       aquí, que es donde se decide si algo cuenta o no cuenta. */
    if (registro.datos[INT.ESTADO] !== ESTADO_INTENTO.EN_CURSO) {
      throw new Error(t("err_intento_no_entregable", {
        estado: registro.datos[INT.ESTADO] || "desconocido"
      }));
    }
    const inicioMs = new Date(registro.datos[INT.INICIO]).getTime();
    if (!isNaN(inicioMs) && (Date.now() - inicioMs) > INTENTO_VIGENCIA_HORAS * 3600 * 1000) {
      const d = registro.datos;
      d[INT.ESTADO] = ESTADO_INTENTO.VENCIDO;
      d[INT.FIN] = new Date();
      actualizarIntento(registro.fila, d);
      limpiarMemoEjecucion();
      logWarn("Quiz", `Intento ${intentoId} entregado fuera de plazo; se marca VENCIDO sin calificar.`);
      throw new Error(t("err_intento_vencido", { horas: INTENTO_VIGENCIA_HORAS }));
    }

    const moduloId = (registro.datos[INT.MODULO] || "").toString();
    const modulo = obtenerModulo(moduloId);
    const banco = leerClavesExamen({ moduloId: moduloId, soloValidadas: true });

    let numeros = [];
    try { numeros = JSON.parse(registro.datos[INT.PREGUNTAS] || "[]"); } catch (e) { numeros = []; }
    const porNumero = {};
    banco.forEach(q => { porNumero[q.numero] = q; });
    const presentadas = numeros.length > 0 ? numeros.map(n => porNumero[n]).filter(Boolean) : banco;

    // Normaliza las respuestas devolviendo el índice al orden original de las opciones.
    const normalizadas = (respuestas || []).map(r => {
      const orden = Array.isArray(r.orden) ? r.orden : null;
      let indice = (r.indiceElegido === undefined || r.indiceElegido === null) ? -1 : parseInt(r.indiceElegido, 10);
      if (orden && indice >= 0 && indice < orden.length) indice = orden[indice];
      return {
        numeroPregunta: parseInt(r.numeroPregunta, 10),
        indiceElegido: isNaN(indice) ? -1 : indice,
        textoRespuesta: (r.textoRespuesta || "").toString()
      };
    });

    const resultado = calificarContraClaves(presentadas, normalizadas);
    const escala = resolverNivelDesempeno(resultado.porcentaje);
    const segundos = Math.max(0, Math.round((Date.now() - new Date(registro.datos[INT.INICIO]).getTime()) / 1000));
    const forense = calcularIndiceForense(resultado, segundos, presentadas.length, modulo);

    // Persistencia del detalle.
    persistirDetalleIntento(intentoId, registro.datos[INT.EMAIL], moduloId, resultado.detalle);

    // Cierre del intento.
    const d = registro.datos;
    d[INT.FIN] = new Date();
    d[INT.SEGUNDOS] = segundos;
    d[INT.ESTADO] = ESTADO_INTENTO.ENTREGADO;
    d[INT.TOTAL] = presentadas.length;
    d[INT.ACIERTOS] = resultado.aciertos;
    d[INT.ERRORES] = resultado.errores;
    d[INT.OMISIONES] = resultado.omisiones;
    d[INT.PORCENTAJE] = resultado.porcentaje;
    d[INT.NIVEL] = escala.nivel;
    d[INT.TRAMPAS] = forense.trampasPresentadas;
    d[INT.CAIDAS] = forense.trampasCaidas;
    d[INT.FORENSE] = forense.indice;
    actualizarIntento(registro.fila, d);

    // Certificado, refuerzo, historial y bono.
    let urlCertificado = "";
    if (escala.certifica) {
      urlCertificado = generarCertificadoAprobado({
        estudiante: d[INT.NOMBRE], correo: d[INT.EMAIL],
        tituloExamen: modulo ? modulo.nombre : moduloId,
        notaPorcentaje: resultado.porcentaje, nivel: escala.nivel, formId: intentoId
      });
    }

    registrarCalificacion({
      fecha: new Date(), estudiante: d[INT.NOMBRE], correo: d[INT.EMAIL],
      evaluacion: modulo ? modulo.nombre : moduloId, formId: "",
      aciertos: resultado.aciertos, total: presentadas.length,
      porcentaje: resultado.porcentaje, nivel: escala.nivel, certifica: escala.certifica,
      urlCertificado: urlCertificado, moduloId: moduloId, intentoId: intentoId
    });

    if (escala.refuerzo || resultado.omisiones > 0) {
      generarPlanDeRefuerzo(d[INT.EMAIL], intentoId,
        resultado.detalle.map(x => ({ numeroPregunta: x.numero, esCorrecta: x.resultado === RESULTADO.ACIERTO, resultado: x.resultado })),
        moduloId);
    }
    if (escala.bono) causarBonoSiAplica(d[INT.EMAIL], moduloId, escala.nivel);

    if (!escala.certifica) {
      procesarAlertaCalificacion({
        estudiante: d[INT.NOMBRE], correo: d[INT.EMAIL],
        tituloExamen: modulo ? modulo.nombre : moduloId,
        notaPorcentaje: resultado.porcentaje, nivel: escala.nivel,
        idFormulario: intentoId, moduloId: moduloId
      });
    }

    enviarMensajePedagogico(d[INT.EMAIL], d[INT.NOMBRE], modulo, resultado, escala);
    notificarEvento("examen_modulo_calificado", {
      modulo: moduloId, porcentaje: resultado.porcentaje, nivel: escala.nivel, certificado: escala.certifica
    });
    logInfo("Quiz", `Intento ${intentoId} calificado: ${resultado.porcentaje}% (${escala.nivel}).`);

    return obtenerInformeIntento(intentoId);
  } finally {
    try { lock.releaseLock(); } catch (e) { /* ignora */ }
  }
}

/** [F1-3] Califica un conjunto de respuestas contra las claves: acierto / error / omisión. */
function calificarContraClaves(claves, respuestas) {
  const porNumero = {};
  (respuestas || []).forEach(r => { porNumero[r.numeroPregunta] = r; });

  let aciertos = 0, errores = 0, omisiones = 0;
  const detalle = [];
  const porArea = {};

  claves.forEach(q => {
    const r = porNumero[q.numero];
    let resultado = RESULTADO.OMISION;
    let indiceElegido = -1;
    let textoRespuesta = "";
    let cayoEnCebo = false;

    if (r) {
      indiceElegido = (r.indiceElegido === undefined || r.indiceElegido === null) ? -1 : parseInt(r.indiceElegido, 10);
      textoRespuesta = (r.textoRespuesta || "").toString();
      const respondio = (q.tipo === "completar") ? Boolean(textoRespuesta.trim()) : indiceElegido >= 0;

      if (respondio) {
        let correcto = false;
        if (q.tipo === "completar") {
          correcto = textoRespuesta.toLowerCase().trim() === (q.respuestaTexto || "").toLowerCase().trim();
        } else {
          correcto = indiceElegido === q.correcta;
          if (q.esTrampa && q.cebo >= 0 && indiceElegido === q.cebo) cayoEnCebo = true;
        }
        resultado = correcto ? RESULTADO.ACIERTO : RESULTADO.ERROR;
      }
    }

    if (resultado === RESULTADO.ACIERTO) aciertos++;
    else if (resultado === RESULTADO.ERROR) errores++;
    else omisiones++;

    const area = q.area || "General";
    if (!porArea[area]) porArea[area] = { total: 0, aciertos: 0 };
    porArea[area].total++;
    if (resultado === RESULTADO.ACIERTO) porArea[area].aciertos++;

    detalle.push({
      numero: q.numero, resultado: resultado, indiceElegido: indiceElegido,
      textoRespuesta: textoRespuesta, cayoEnCebo: cayoEnCebo, area: area,
      esTrampa: q.esTrampa, tipoTrampa: q.tipoTrampa,
      pregunta: q.texto,
      respuestaEmitida: indiceElegido >= 0 && q.opciones[indiceElegido] !== undefined
        ? q.opciones[indiceElegido] : (textoRespuesta || "En blanco (no respondida)"),
      respuestaCorrecta: q.opciones[q.correcta] !== undefined ? q.opciones[q.correcta] : q.respuestaTexto,
      configuracionCorrecta: q.configuracionCorrecta,
      justificacion: q.justificacion,
      causaRaiz: q.causaRaiz || (resultado === RESULTADO.OMISION
        ? "Omisión: evasión, distracción o visualización incompleta" : ""),
      riesgo: q.riesgo, severidad: q.severidad, caso: q.caso,
      fuente: q.fuente, videoId: q.videoId, segundo: q.segundo
    });
  });

  const total = claves.length || 1;
  const desempenoAreas = {};
  Object.keys(porArea).forEach(a => {
    desempenoAreas[a] = Math.round((porArea[a].aciertos / porArea[a].total) * 100);
  });

  return {
    total: claves.length,
    aciertos: aciertos,
    errores: errores,
    omisiones: omisiones,
    porcentaje: parseFloat(((aciertos / total) * 100).toFixed(1)),
    desempenoAreas: desempenoAreas,
    detalle: detalle
  };
}

/** Persiste el detalle definitivo de un intento (reemplaza lo parcial). */
function persistirDetalleIntento(intentoId, email, moduloId, detalle) {
  exigirOrigenInterno("persistirDetalleIntento");
  const sheet = obtenerHojaDetalle();
  if (sheet.getLastRow() >= 2) {
    const ids = sheet.getRange(2, 1, sheet.getLastRow() - 1, 1).getValues();
    for (let i = ids.length - 1; i >= 0; i--) {
      if ((ids[i][0] || "").toString() === intentoId) sheet.deleteRow(i + 2);
    }
  }
  const filas = detalle.map(d => ([
    intentoId, email, moduloId, d.numero, d.indiceElegido, d.textoRespuesta,
    d.resultado, d.cayoEnCebo === true, d.area, new Date()
  ]));
  if (filas.length > 0) sheet.getRange(sheet.getLastRow() + 1, 1, filas.length, DET_COLS).setValues(filas);
  return filas.length;
}

// -------------------------------------------------------------------------------------
// 9B.5 [F2-2] Índice forense — señal interna, nunca veredicto automático
// -------------------------------------------------------------------------------------

function calcularIndiceForense(resultado, segundosTotales, totalPreguntas, modulo) {
  // [OPT-14] `esTrampa` ya garantiza cebo utilizable (ver resolverTrampa), así
  // que el denominador solo cuenta reactivos en los que era posible caer.
  const trampasPresentadas = resultado.detalle.filter(d => d.esTrampa).length;
  const trampasCaidas = resultado.detalle.filter(d => d.cayoEnCebo).length;

  // Sin trampas presentadas no hay evidencia: se informa NO_APLICA, jamás un falso BAJO.
  if (trampasPresentadas === 0) {
    return {
      indice: "NO_APLICA", trampasPresentadas: 0, trampasCaidas: 0, tasa: 0,
      segundosPorPregunta: totalPreguntas ? Math.round(segundosTotales / totalPreguntas) : 0,
      velocidadSospechosa: false,
      dictamen: "Este examen no incluyó reactivos trampa, por lo que no es posible emitir un índice de presunción."
    };
  }

  const tasa = (trampasCaidas / trampasPresentadas) * 100;
  const umbralMedio = modulo ? modulo.umbralIAMedio : MODULO_UMBRAL_IA_MEDIO;
  const umbralAlto = modulo ? modulo.umbralIAAlto : MODULO_UMBRAL_IA_ALTO;
  const segPorPregunta = totalPreguntas ? Math.round(segundosTotales / totalPreguntas) : 0;
  const umbralVel = modulo ? modulo.umbralVelocidad : MODULO_UMBRAL_VELOCIDAD_SEG;
  const velocidadSospechosa = segPorPregunta > 0 && segPorPregunta < umbralVel;

  let indice = "BAJO";
  if (tasa >= umbralAlto) indice = "ALTO";
  else if (tasa >= umbralMedio) indice = "MEDIO";
  // La velocidad no eleva el índice por sí sola: solo refuerza una caída ya existente.
  if (indice === "MEDIO" && velocidadSospechosa && tasa >= umbralAlto * 0.8) indice = "ALTO";

  const tipos = {};
  resultado.detalle.filter(d => d.cayoEnCebo).forEach(d => {
    const tt = d.tipoTrampa || "sin_tipificar";
    tipos[tt] = (tipos[tt] || 0) + 1;
  });

  let dictamen;
  if (indice === "BAJO") {
    dictamen = "Los fallos corresponden a errores humanos habituales de operación, sin coincidencia relevante con los cebos diseñados.";
  } else {
    const detalleTipos = Object.keys(tipos).map(k => `${k} (${tipos[k]})`).join(", ");
    dictamen = `Se detectó coincidencia con reactivos trampa en ${tasa.toFixed(1)}% de los casos: ${detalleTipos}. ` +
      (velocidadSospechosa ? `El tiempo por pregunta (${segPorPregunta}s) está por debajo del umbral de ${umbralVel}s. ` : "") +
      "Señal interna para revisión humana: no constituye por sí sola una conclusión sobre la integridad del examen.";
  }

  return {
    indice: indice,
    trampasPresentadas: trampasPresentadas,
    trampasCaidas: trampasCaidas,
    tasa: parseFloat(tasa.toFixed(1)),
    segundosPorPregunta: segPorPregunta,
    velocidadSospechosa: velocidadSospechosa,
    tiposCaidos: tipos,
    dictamen: dictamen
  };
}

