// 6.1 Metadatos por plataforma
// -------------------------------------------------------------------------------------

/**
 * [MEJORA 9] Lotes de 50 IDs de YouTube. Un lote que falla no interrumpe el
 * resto: se anota en el registro y el proceso continúa con el siguiente.
 */
/* [v2.6.19] «No vino en la respuesta» y «no hubo respuesta» son cosas distintas.
 *
 * Esta función devolvía un mapa, y el que la llama daba por sentado que un id
 * ausente significaba «ese video no existe». Pero el id también falta cuando la
 * petición entera se cayó: cuota agotada, 403, un 5xx, o el servicio avanzado
 * sin habilitar. En ese caso hasta 50 videos perfectamente públicos entraban
 * como «privado, eliminado o inexistente» — y desde 6.13 esa rama además marca
 * la fila para no volver a intentarla. Un fallo de diez minutos dejaba
 * cincuenta filas muertas de forma permanente.
 *
 * Ahora el mapa se rellena SIEMPRE con una entrada por id: los que respondieron,
 * con sus metadatos; los de un lote que falló, con el resultado que les
 * corresponda; y solo los ausentes de una respuesta CORRECTA se quedan sin
 * entrada, que es la única forma legítima de concluir que el video no está. */
/**
 * @param {string[]} idsArray  ids de YouTube, en orden de fila
 * @param {number}   limiteMs  [6.27] instante a partir del cual no se lanza otra
 *   consulta. 0 = sin límite.
 *
 * Los ids que se queden sin consultar por falta de tiempo vuelven marcados con
 * `sinTiempo`, que NO es lo mismo que «consultado y no está»: el primero es una
 * fila que hay que volver a intentar, el segundo un video muerto. Confundirlos
 * es escribir «privado, eliminado o inexistente» en filas perfectamente sanas.
 */
function obtenerMetadatosYouTubeLote50(idsArray, limiteMs = 0) {
  const mapa = {};
  if (!idsArray || idsArray.length === 0) return mapa;
  if (typeof YouTube === "undefined") {
    logError("YouTube", "Servicio avanzado YouTube Data API v3 no habilitado en el proyecto.");
    registrarFallaEnDLQ(0, "servicio:youtube", "YouTube Data API v3", "Servicio avanzado no habilitado", 501);
    /* Falta una casilla por marcar en el proyecto, no faltan los videos. Con
       `configuracion` la fila se queda como está y la recoge la siguiente
       pasada en cuanto alguien habilite el servicio. */
    idsArray.filter(Boolean).forEach(id => {
      mapa[id] = { _error: true, configuracion: true, httpCode: 501,
                   mensaje: "Habilita el servicio avanzado «YouTube Data API v3» en el proyecto de Apps Script." };
    });
    return mapa;
  }

  for (let i = 0; i < idsArray.length; i += BATCH_YOUTUBE_API) {
    const chunk = idsArray.slice(i, i + BATCH_YOUTUBE_API).filter(Boolean);
    if (chunk.length === 0) continue;
    /* [6.27] Cien filas de YouTube son DOS consultas de cincuenta, y se hacían
       las dos antes de que el bucle de filas llegara a mirar el reloj: el corte
       por fila no servía de nada para el caso más común del catálogo. Aquí se
       mira antes de cada lote, y lo que no se consulta se devuelve dicho. */
    if (limiteMs && Date.now() > limiteMs) {
      idsArray.slice(i).filter(Boolean).forEach(id => {
        mapa[id] = { _error: true, sinTiempo: true, httpCode: 0,
                     mensaje: "No consultado en esta pasada: se acabó el tiempo." };
      });
      logInfo("YouTube", `Se dejan ${idsArray.length - i} ids sin consultar: se acabó el tiempo de la pasada.`);
      break;
    }
    try {
      verificarCuotaDisponible(1, "YOUTUBE");
      const resp = YouTube.Videos.list("snippet,contentDetails,statistics", { id: chunk.join(",") });
      if (resp && resp.items) {
        resp.items.forEach(item => {
          mapa[item.id] = {
            titulo: item.snippet.title,
            descripcion: item.snippet.description || "",
            canal: item.snippet.channelTitle,
            duracion: convertirDuracionAMinutos(item.contentDetails ? item.contentDetails.duration : ""),
            fechaPublicacion: item.snippet.publishedAt ? item.snippet.publishedAt.slice(0, 10) : "",
            vistas: Number((item.statistics && item.statistics.viewCount) || 0),
            likes: Number((item.statistics && item.statistics.likeCount) || 0),
            categoriaId: item.snippet.categoryId || "",
            /* `defaultAudioLanguage` es lo mejor, pero muchos canales no lo
               rellenan; `defaultLanguage` (el idioma del título y la
               descripción) sí suele estar y responde igual de bien a la
               pregunta «¿en qué idioma está este video?». */
            audioLang: item.snippet.defaultAudioLanguage || item.snippet.defaultLanguage || null,
            plataforma: "YouTube"
          };
        });
      }
    } catch (e) {
      const httpCode = deducirCodigoHttpDesdeError(e.message);
      logWarn("YouTube", `Lote ${i / BATCH_YOUTUBE_API + 1} falló (HTTP ${httpCode}): ${e.message}`);
      /* [v2.6.20] SIEMPRE _error, sea cual sea el código. Aquí NO se llama a
       * `resultadoDeFallo`, y no es un descuido: esa función traduce el fallo de
       * una consulta POR VIDEO, donde un 404 sí significa «ese video no está».
       * Esto es una consulta POR LOTE, y si la petición entera se cayó no hay
       * nada que sepamos de ninguno de los 50 videos que iban dentro —ni
       * siquiera con un 400 o un 410—. El código describe lo que le pasó a la
       * PETICIÓN, no a cada video.
       *
       * La única prueba admisible de que un video de YouTube no está sigue
       * siendo la de arriba: la consulta terminó bien y ese id no vino en
       * `resp.items`.
       *
       * Tampoco se registra en la DLQ. Se hacía con fila 0 —una fila que no
       * existe—, así que la cola se llenaba de entradas que «Reprocesar DLQ» no
       * puede devolver a ningún sitio, y además contradecía lo que acabábamos de
       * decidir: si el fallo es transitorio, la fila no está aislada. Cada fila
       * real pasa después por `gestionarErrorFila`, que es el único sitio que
       * decide cuándo algo entra en la cola. */
      chunk.forEach(id => {
        mapa[id] = { _error: true, httpCode: Number(httpCode) || 0,
                     mensaje: "YouTube lote: " + e.message };
      });
    }
  }
  return mapa;
}

/**
 * Metadatos de Vimeo por la vía pública (oEmbed).
 *
 * No necesita clave ni consume cuota, y devuelve título, autor, descripción,
 * duración y fecha de subida — que es justo lo que faltaba en el catálogo
 * cuando la API con clave respondía 401. Da menos que la API oficial: no trae
 * reproducciones ni «me gusta». Por eso es la red de seguridad y no la vía
 * principal: es mejor un video con fecha y sin contador que uno sin nada.
 */
function obtenerMetadatosVimeoPublico(videoId) {
  const url = URL_VIMEO_OEMBED + encodeURIComponent(PROTO + "vimeo.com/" + videoId);
  const r = ejecutarFetchSeguro(url, { method: "GET" }, "Vimeo oEmbed");
  if (!r.ok) return null;
  try {
    const d = JSON.parse(r.cuerpo);
    if (!d || !d.title) return null;
    return {
      titulo: d.title,
      descripcion: d.description || "",
      canal: d.author_name || "Vimeo Creator",
      duracion: Math.round((d.duration || 0) / 60),
      // `upload_date` llega como "2025-07-17 15:04:12"; nos quedamos con el día.
      fechaPublicacion: (d.upload_date || "").toString().slice(0, 10),
      vistas: 0,
      likes: 0,
      categoriaId: "",
      audioLang: null,
      plataforma: "Vimeo",
      origenMetadatos: "oembed"
    };
  } catch (e) {
    return null;
  }
}

/**
 * [v2.6.11] Metadatos de una charla de TED, por oEmbed.
 *
 * Lo que oEmbed da y lo que NO, porque conviene saberlo antes de importar mil
 * charlas: da el título y el ponente con total fiabilidad. NO da vistas, likes
 * ni fecha de publicación —el contrato oEmbed no los contempla—, y la
 * descripción solo si TED decide incluirla. Esas columnas quedan vacías, que es
 * la verdad; rellenarlas con ceros inventados sería peor.
 *
 * La consecuencia práctica está en la clasificación: sin descripción, el motor
 * solo tiene el título, y los títulos de TED son deliberadamente enigmáticos.
 * Muchas charlas caerán en «Sin clasificar» y de ahí a Fase 2. Es el precio de
 * haber elegido que el tema decida, y es el correcto: inventarle un ecosistema
 * a una charla por venir de TED sería exactamente la etiqueta plausible y falsa
 * contra la que está construido el resto del sistema.
 */
function obtenerMetadatosTED(url) {
  const limpia = (url || "").toString().trim();
  if (!limpia) return null;

  /* Se normaliza a la URL canónica de la charla. Un enlace con «?language=es» o
     terminado en «/transcript» es la misma charla, pero oEmbed puede no
     reconocerlo, y entonces una charla ya presente entraría como una fila
     distinta al pegarla de otra forma. */
  const m = limpia.match(/(ted\.com\/talks\/[A-Za-z0-9_\-]+)/i);
  const canonica = m ? PROTO + "www." + m[1].replace(/^www\./i, "") : limpia;

  const intentar = (base) => {
    const r = ejecutarFetchSeguro(base + encodeURIComponent(canonica),
      { method: "GET" }, "TED oEmbed");
    if (!r.ok) return { fallo: r.codigo };
    try {
      const d = JSON.parse(r.cuerpo);
      return (d && d.title) ? { datos: d } : { fallo: 0 };
    } catch (e) {
      /* Respuesta que no es JSON: casi siempre una página de error servida con
         200. Se trata como fallo del endpoint, no como charla inexistente. */
      return { fallo: 0 };
    }
  };

  let res = intentar(URL_TED_OEMBED);
  if (!res.datos) res = intentar(URL_TED_OEMBED_ALT);

  if (!res.datos) {
    const codigo = res.fallo || 502;
    logWarn("TED", `No se obtuvieron metadatos de ${canonica} (HTTP ${codigo}).`);
    return resultadoDeFallo("TED", codigo, "TED oEmbed HTTP " + codigo);
  }

  const d = res.datos;
  return {
    titulo: (d.title || "").toString().trim(),
    // oEmbed no promete descripción; si viene, se aprovecha para clasificar.
    descripcion: (d.description || "").toString().trim(),
    // `author_name` es el ponente. Si no viene, la charla sigue siendo de TED.
    canal: (d.author_name || "TED").toString().trim(),
    duracion: d.duration ? Math.round(Number(d.duration) / 60) : 0,
    fechaPublicacion: "",
    vistas: 0,
    likes: 0,
    categoriaId: "",
    audioLang: null,
    plataforma: "TED",
    origenMetadatos: "oembed"
  };
}

/**
 * [v2.6.12] Metadatos de un video de Bilibili.
 *
 * Se pide a la API web del sitio. La premisa de todo lo que hay debajo es que
 * esta llamada PUEDE dejar de funcionar en cualquier momento y sin aviso, por
 * tres motivos distintos: Bilibili está añadiendo firma WBI a sus endpoints web;
 * aplica control de riesgo por IP, y las peticiones de Apps Script salen de
 * servidores de Google, fuera de China; y la propia ruta no está publicada por
 * ellos, así que pueden moverla.
 *
 * Por eso NINGÚN fallo devuelve `_error`. Un `_error` aísla la fila y la marca
 * como video roto, y el video no está roto: lo que falla es nuestro acceso a sus
 * datos. Confundir las dos cosas llenaría la cola de incidencias de videos
 * perfectamente vivos, y el día que Bilibili cierre el endpoint pasaría de golpe
 * con todos a la vez. Se degrada a «falta el título», que es exactamente lo que
 * ocurre y lo que una persona puede resolver en diez segundos.
 */
function obtenerMetadatosBilibili(videoId) {
  const id = (videoId || "").toString().trim();
  const degradado = { _sinMetadatos: true, plataforma: "Bilibili" };
  if (!id) return degradado;
  /* Un id nacido de un enlace corto no es un identificador de Bilibili: es el
     código del acortador. Pedirlo devolvería un error garantizado, así que no se
     gasta la petición ni se ensucia el registro con un fallo previsible. */
  if (id.indexOf("b23_") === 0) return degradado;

  // La API distingue las dos numeraciones por el nombre del parámetro.
  const parametro = /^av\d+$/i.test(id) ? "aid=" + id.slice(2) : "bvid=" + id;

  const r = ejecutarFetchSeguro(URL_BILIBILI_VIEW + parametro,
    { method: "GET", headers: { "User-Agent": "Mozilla/5.0", "Referer": PROTO + "www.bilibili.com" } },
    "Bilibili");
  if (!r.ok) {
    logWarn("Bilibili", `HTTP ${r.codigo} al consultar ${id}; la fila entra sin título.`);
    return degradado;
  }

  let d;
  try {
    const json = JSON.parse(r.cuerpo);
    /* Bilibili responde 200 con un `code` propio distinto de cero cuando bloquea
       o cuando el video no es visible. Leer solo el HTTP daría por buena una
       respuesta que no trae ningún dato. */
    if (!json || json.code !== 0 || !json.data) {
      logWarn("Bilibili", `Respuesta code=${json ? json.code : "?"} para ${id}` +
        (json && json.message ? ` (${json.message})` : "") + "; la fila entra sin título.");
      return degradado;
    }
    d = json.data;
  } catch (e) {
    logWarn("Bilibili", `Respuesta no interpretable para ${id}; la fila entra sin título.`);
    return degradado;
  }

  const est = d.stat || {};
  return {
    titulo: (d.title || "").toString().trim(),
    descripcion: (d.desc || "").toString().trim(),
    canal: (d.owner && d.owner.name ? d.owner.name : "Bilibili").toString().trim(),
    duracion: d.duration ? Math.round(Number(d.duration) / 60) : 0,
    // `pubdate` viene en segundos desde época; la hoja quiere una fecha legible.
    fechaPublicacion: d.pubdate
      ? Utilities.formatDate(new Date(Number(d.pubdate) * 1000), Session.getScriptTimeZone(), "yyyy-MM-dd")
      : "",
    vistas: Number(est.view || 0),
    likes: Number(est.like || 0),
    categoriaId: "",
    /* Se declara el idioma en lugar de dejar que lo adivine la heurística: el
       texto viene en caracteres chinos y el detector está afinado para español e
       inglés. Sin esto, todo el contenido de Bilibili entraría marcado como ES y
       el filtro por idioma del portal dejaría de significar nada. */
    audioLang: "zh",
    plataforma: "Bilibili",
    origenMetadatos: "api-web"
  };
}

function obtenerMetadatosVimeo(videoId) {
  if (!videoId) return null;

  const token = proveedorApiKey("VIMEO");
  /* Sin clave configurada no se gasta ni una llamada a la API oficial: se va
     derecho a la vía pública. Antes se intentaba igual, y el 401 resultante
     aislaba la fila como si el video no existiera. */
  if (!token) return obtenerMetadatosVimeoPublico(videoId);

  try { verificarCuotaDisponible(1, "VIMEO"); }
  catch (e) {
    logWarn("Vimeo", e.message + " Se usa la vía pública.");
    return obtenerMetadatosVimeoPublico(videoId);
  }

  const r = ejecutarFetchSeguro(URL_VIMEO_API + videoId,
    { method: "GET", headers: { "Authorization": "Bearer " + token } }, "Vimeo");

  if (!r.ok) {
    /* 401 y 403 significan «esta clave no sirve», no «este video no existe».
       Aislar la fila por eso dejaba el catálogo con videos perfectamente
       públicos marcados como error, y sin fecha. Se reintenta por oEmbed, que
       no depende de ninguna clave. */
    if (r.codigo === 401 || r.codigo === 403 || r.codigo === 429) {
      logWarn("Vimeo", `HTTP ${r.codigo} con la clave configurada; se usa la vía pública.`);
      const publico = obtenerMetadatosVimeoPublico(videoId);
      if (publico) return publico;
    }
    logWarn("Vimeo", `HTTP ${r.codigo} al consultar ${videoId}.`);
    return resultadoDeFallo("Vimeo", r.codigo, "Vimeo HTTP " + r.codigo);
  }

  try {
    const data = JSON.parse(r.cuerpo);
    return {
      titulo: data.name,
      descripcion: data.description || "",
      canal: data.user ? data.user.name : "Vimeo Creator",
      duracion: Math.round((data.duration || 0) / 60),
      // `release_date` es la fecha de publicación; si el video nunca se
      // publicó formalmente, Vimeo solo da `created_time`. Sin este respaldo,
      // la columna de fecha se quedaba vacía sin motivo aparente.
      fechaPublicacion: (data.release_date || data.created_time || "").toString().slice(0, 10),
      vistas: (data.stats && data.stats.plays) || 0,
      likes: (data.metadata && data.metadata.connections && data.metadata.connections.likes && data.metadata.connections.likes.total) || 0,
      categoriaId: "",
      audioLang: null,
      plataforma: "Vimeo"
    };
  } catch (e) {
    // El JSON vino roto, pero el video puede estar perfectamente: se intenta
    // la vía pública antes de dar la fila por perdida.
    const publico = obtenerMetadatosVimeoPublico(videoId);
    if (publico) return publico;
    return { _error: true, httpCode: 500, mensaje: "Vimeo JSON inválido" };
  }
}

/**
 * =====================================================================================
 * [TT-1] TIKTOK HÍBRIDO: oEmbed público + API oficial v2 (Display API)
 * =====================================================================================
 *
 * QUÉ PUEDE Y QUÉ NO PUEDE HACER ESTA INTEGRACIÓN — léelo antes de configurar nada.
 *
 * TikTok tiene dos APIs y NINGUNA devuelve metadatos de un video ajeno cualquiera:
 *
 *   · Display API (la que implementamos): POST /v2/video/query/ devuelve duración,
 *     vistas, likes, comentarios y fecha, pero SOLO de los videos de la cuenta que
 *     autoriza. Sirve si la videoteca cataloga contenido propio de la empresa.
 *
 *   · Research API: sí permite consultar videos de terceros, pero TikTok excluye
 *     explícitamente a usuarios comerciales, creadores y anunciantes, y solo está
 *     disponible en determinados países. Una SAS colombiana no califica, así que
 *     NO se implementa aquí: sería código muerto que nunca obtendría credenciales.
 *
 * En consecuencia:
 *   · Videos de terceros  → oEmbed (título, autor, miniatura). Sin duración ni métricas.
 *   · Videos propios      → API oficial con métricas completas, si se autoriza la cuenta.
 *
 * El sistema decide solo: si hay token y el video pertenece a la cuenta autorizada usa
 * la API; en cualquier otro caso cae a oEmbed sin romperse.
 */

/** Credenciales de la app de TikTok (portal de desarrolladores). */
function configurarTikTokCredenciales() {
  exigirOrigenInterno("configurarTikTokCredenciales");
  const ui = SpreadsheetApp.getUi();
  const aviso = ui.alert("App de TikTok",
    "Antes de continuar, ten presente el alcance real:\n\n" +
    "• La API oficial SOLO devuelve duración, vistas y likes de los videos de la " +
    "cuenta que autorices.\n" +
    "• Para videos de terceros seguirás obteniendo únicamente título y autor vía oEmbed.\n\n" +
    "¿Continuar?", ui.ButtonSet.YES_NO);
  if (aviso !== ui.Button.YES) return;

  if (!solicitarYGuardarClave("TikTok Client Key",
    "Pega el Client Key de tu app en developers.tiktok.com:", "TIKTOK_CLIENT_KEY")) return;
  solicitarYGuardarClave("TikTok Client Secret",
    "Pega el Client Secret de tu app:", "TIKTOK_CLIENT_SECRET");
  CacheService.getScriptCache().remove("TIKTOK_ACCESS_TOKEN");

  notificarUsuario("Credenciales guardadas. Ahora usa «Conectar Cuenta de TikTok».", "TikTok", 5);
}

/**
 * Paso 1 de la autorización: muestra la URL a la que debe entrar el dueño de la
 * cuenta de TikTok. El callback vuelve a este mismo script (doGet), que canjea el
 * código por un refresh_token de larga duración.
 *
 * El `state` es un valor aleatorio de un solo uso: sin él, cualquiera podría
 * inducir el canje de un código ajeno (CSRF sobre el callback de OAuth).
 */
function validarRetornoTikTok_(valor) {
  const url = String(valor || "").trim();
  if (!/^https:\/\/script\.google\.com\/macros\/s\/[A-Za-z0-9_-]+\/exec$/.test(url)) {
    throw new Error("Configura TIKTOK_REDIRECT_URI con la URL pública exacta de Apps Script terminada en /exec, sin parámetros.");
  }
  return url;
}

function obtenerRetornoTikTok_() {
  exigirOrigenInterno("obtenerRetornoTikTok_");
  return validarRetornoTikTok_(PropertiesService.getScriptProperties().getProperty("TIKTOK_REDIRECT_URI"));
}

function iniciarAutorizacionTikTok() {
  exigirOrigenInterno("iniciarAutorizacionTikTok");
  const ui = SpreadsheetApp.getUi();
  const clientKey = proveedorApiKey("TIKTOK_CLIENT_KEY");
  if (!clientKey) { ui.alert("Configura primero el Client Key de TikTok."); return; }

  let redirect = "";
  try { redirect = obtenerRetornoTikTok_(); } catch (e) {
    ui.alert("Configurar retorno de TikTok", e.message, ui.ButtonSet.OK);
    return;
  }

  const estado = Utilities.getUuid().replace(/-/g, "").slice(0, 24);
  // Conserva la URL utilizada: el callback no debe recalcularla ni leer una propiedad modificada después.
  CacheService.getScriptCache().put("TIKTOK_OAUTH_CONTEXT_V2", JSON.stringify({
    estado: estado, redirect: redirect, clientKey: clientKey
  }), 900); // 15 min; iniciar otra autorización sustituye la anterior.

  const url = URL_TIKTOK_AUTORIZAR +
    "?client_key=" + encodeURIComponent(clientKey) +
    "&scope=" + encodeURIComponent(TIKTOK_SCOPE) +
    "&response_type=code" +
    "&redirect_uri=" + encodeURIComponent(redirect) +
    "&state=" + estado;

  ui.alert("Autorizar TikTok",
    "1. En developers.tiktok.com registra esta URL de retorno EXACTA:\n\n" + redirect +
    "\n\n2. Abre este enlace en el navegador, con la sesión de la cuenta de TikTok " +
    "cuyos videos quieres catalogar:\n\n" + url +
    "\n\nEl enlace caduca en 15 minutos.", ui.ButtonSet.OK);
}

/**
 * Paso 2: canje del código por tokens. Lo invoca doGet cuando TikTok redirige.
 * Guarda el refresh_token (larga duración) y cachea el access_token.
 */
function completarAutorizacionTikTok(codigo, estadoRecibido) {
  exigirOrigenInterno("completarAutorizacionTikTok");
  const cache = CacheService.getScriptCache();
  let contexto = null;
  try { contexto = JSON.parse(cache.get("TIKTOK_OAUTH_CONTEXT_V2") || "null"); } catch (e) { contexto = null; }
  const esperado = contexto && contexto.estado;
  if (!esperado || !estadoRecibido || !compararEnTiempoConstante(estadoRecibido, esperado)) {
    logWarn("TikTok", "Callback OAuth con estado inválido: descartado.");
    return { exito: false, mensaje: "Estado de autorización inválido o caducado." };
  }
  cache.remove("TIKTOK_OAUTH_CONTEXT_V2");

  const clientKey = proveedorApiKey("TIKTOK_CLIENT_KEY");
  const clientSecret = proveedorApiKey("TIKTOK_CLIENT_SECRET");
  if (!clientKey || !clientSecret) return { exito: false, mensaje: "Faltan credenciales de TikTok." };

  let redirect = "";
  try { redirect = validarRetornoTikTok_(contexto.redirect); } catch (e) {
    return { exito: false, mensaje: "Retorno de autorización inválido. Inicia una autorización nueva." };
  }
  if (contexto.clientKey !== clientKey) {
    return { exito: false, mensaje: "La aplicación TikTok cambió. Inicia una autorización nueva." };
  }

  const r = ejecutarFetchSeguro(URL_TIKTOK_OAUTH_TOKEN, {
    method: "POST",
    contentType: "application/x-www-form-urlencoded",
    payload: {
      client_key: clientKey,
      client_secret: clientSecret,
      code: codigo,
      grant_type: "authorization_code",
      redirect_uri: redirect
    }
  }, "TikTok OAuth");

  if (!r.ok) {
    logError("TikTok", "Canje de código fallido: HTTP " + r.codigo + " " + (r.cuerpo || "").slice(0, 200));
    return { exito: false, mensaje: "TikTok rechazó el código (HTTP " + r.codigo + ")." };
  }

  try {
    const d = JSON.parse(r.cuerpo);
    if (!d.access_token) return { exito: false, mensaje: d.error_description || "Respuesta sin token." };

    guardarApiKey_("TIKTOK_REFRESH_TOKEN", d.refresh_token || "");
    cache.put("TIKTOK_ACCESS_TOKEN", d.access_token, Math.min((d.expires_in || 86400) - 300, 21000));
    PropertiesService.getScriptProperties().setProperty("TIKTOK_OPEN_ID", d.open_id || "");
    logInfo("TikTok", "Cuenta autorizada correctamente (open_id " + (d.open_id || "?").slice(0, 8) + "…).");
    return { exito: true, mensaje: "Cuenta de TikTok conectada." };
  } catch (e) {
    return { exito: false, mensaje: "Respuesta de TikTok ilegible." };
  }
}

/**
 * Access token vigente. Se cachea porque dura 24 h y renovarlo en cada video
 * gastaría una petición por fila. Si caducó, se renueva con el refresh_token
 * sin intervención humana.
 */
function obtenerTokenTikTok_() {
  exigirOrigenInterno("obtenerTokenTikTok_");
  const cache = CacheService.getScriptCache();
  const cacheado = cache.get("TIKTOK_ACCESS_TOKEN");
  if (cacheado) return cacheado;

  const refresh = obtenerApiKey_("TIKTOK_REFRESH_TOKEN");
  const clientKey = proveedorApiKey("TIKTOK_CLIENT_KEY");
  const clientSecret = proveedorApiKey("TIKTOK_CLIENT_SECRET");
  if (!refresh || !clientKey || !clientSecret) return "";

  const r = ejecutarFetchSeguro(URL_TIKTOK_OAUTH_TOKEN, {
    method: "POST",
    contentType: "application/x-www-form-urlencoded",
    payload: {
      client_key: clientKey,
      client_secret: clientSecret,
      grant_type: "refresh_token",
      refresh_token: refresh
    }
  }, "TikTok Refresh");

  if (!r.ok) {
    logWarn("TikTok", "No se pudo renovar el token: HTTP " + r.codigo + ". Se seguirá con oEmbed.");
    return "";
  }
  try {
    const d = JSON.parse(r.cuerpo);
    if (!d.access_token) return "";
    // TikTok rota el refresh_token en cada renovación: si no se guarda el nuevo,
    // la siguiente renovación falla y hay que reautorizar a mano.
    if (d.refresh_token) guardarApiKey_("TIKTOK_REFRESH_TOKEN", d.refresh_token);
    cache.put("TIKTOK_ACCESS_TOKEN", d.access_token, Math.min((d.expires_in || 86400) - 300, 21000));
    return d.access_token;
  } catch (e) {
    return "";
  }
}

/**
 * Metadatos completos vía API oficial. Acepta hasta 20 ids por petición.
 * Devuelve un mapa id → metadatos; los ids que no pertenecen a la cuenta
 * autorizada simplemente no aparecen en el resultado (no es un error).
 */
function obtenerMetadatosTikTokAvanzadoLote(videoIds, diagnostico) {
  const diag = diagnostico || {};
  diag.consultados = 0;
  diag.errores = [];
  const ids = (videoIds || []).map(x => (x || "").toString().trim()).filter(Boolean);
  if (ids.length === 0) return {};

  const token = obtenerTokenTikTok_();
  if (!token) { diag.errores.push("No hay token de acceso disponible."); return {}; }

  const salida = {};
  for (let i = 0; i < ids.length; i += TIKTOK_MAX_IDS_POR_LOTE) {
    const tanda = ids.slice(i, i + TIKTOK_MAX_IDS_POR_LOTE);
    try { verificarCuotaDisponible(1, "TIKTOK"); } catch (e) { diag.errores.push("Cuota de consultas agotada."); logWarn("TikTok", e.message); break; }

    const r = ejecutarFetchSeguro(
      URL_TIKTOK_API_BASE + "video/query/?fields=" + encodeURIComponent(TIKTOK_CAMPOS), {
        method: "POST",
        contentType: "application/json",
        headers: { "Authorization": "Bearer " + token },
        payload: JSON.stringify({ filters: { video_ids: tanda } })
      }, "TikTok API");

    if (!r.ok) {
      diag.errores.push("Consulta HTTP " + r.codigo + ".");
      // 401 → token revocado; el resto → problema puntual. En ambos casos se
      // devuelve lo que ya se tenga y el llamador cae a oEmbed.
      if (r.codigo === 401) CacheService.getScriptCache().remove("TIKTOK_ACCESS_TOKEN");
      logWarn("TikTok", "Consulta por lote HTTP " + r.codigo + "; se recurre a oEmbed.");
      break;
    }

    try {
      const json = JSON.parse(r.cuerpo);
      if (!json.error || json.error.code !== "ok") {
        diag.errores.push("TikTok no confirmó una respuesta válida.");
        break;
      }
      if (!json.data || !Array.isArray(json.data.videos)) {
        diag.errores.push("Respuesta sin lista de videos válida.");
        break;
      }
      const videos = json.data.videos;
      diag.consultados += tanda.length;
      videos.forEach(v => {
        const vid = (v.id || "").toString();
        if (!vid) return;
        salida[vid] = {
          titulo: v.title || v.video_description || "Video TikTok",
          descripcion: v.video_description || v.title || "",
          canal: "TikTok Creator",
          // La API da segundos; el catálogo guarda minutos, como el resto de plataformas.
          duracion: v.duration ? parseFloat((Number(v.duration) / 60).toFixed(2)) : 0,
          fechaPublicacion: v.create_time
            ? Utilities.formatDate(new Date(Number(v.create_time) * 1000), obtenerZonaHoraria(), "yyyy-MM-dd")
            : "",
          vistas: Number(v.view_count) || 0,
          likes: Number(v.like_count) || 0,
          categoriaId: "",
          audioLang: null,
          plataforma: "TikTok",
          origenMetadatos: "api"
        };
      });
    } catch (e) {
      diag.errores.push("Respuesta de TikTok ilegible.");
      logWarn("TikTok", "Respuesta de la API ilegible: " + e.message);
      break;
    }
  }
  return salida;
}

/** Metadatos por API de un solo video. Devuelve null si no está disponible. */
function obtenerMetadatosTikTokAvanzado(videoId) {
  const mapa = obtenerMetadatosTikTokAvanzadoLote([videoId]);
  return mapa[(videoId || "").toString().trim()] || null;
}

/**
 * Punto de entrada híbrido. Intenta la API oficial y cae a oEmbed sin ruido.
 * El campo `origenMetadatos` deja constancia de por dónde vino cada dato, para
 * que un reporte de duraciones en cero se pueda explicar sin adivinar.
 */
function obtenerMetadatosTikTok(url) {
  if (!url) return null;

  // 1) Vía preferente: API oficial, solo si hay cuenta autorizada.
  const videoId = obtenerIdTikTok(url);
  if (videoId && obtenerApiKey_("TIKTOK_REFRESH_TOKEN")) {
    try {
      const avanzado = obtenerMetadatosTikTokAvanzado(videoId);
      if (avanzado) return avanzado;
      logInfo("TikTok", `La API no devolvió datos del video ${videoId}: se usa oEmbed.`);
    } catch (e) {
      logWarn("TikTok", "API avanzada no disponible (" + e.message + "); se usa oEmbed.");
    }
  }

  // 2) Respaldo público: sin credenciales, sin duración ni métricas.
  try { verificarCuotaDisponible(1, "TIKTOK"); } catch (e) { logWarn("TikTok", e.message); return null; }

  /* Un enlace corto se resuelve antes de preguntar: el oEmbed no los acepta. */
  let urlConsulta = url;
  if (esEnlaceCortoTikTok(url)) {
    const largo = resolverEnlaceCortoTikTok(url);
    if (!largo) {
      /* [v2.6.13] Esto es lo mismo que un b23.tv que no resuelve: el acortador
         ya no apunta a nada. Nueve rondas de reintentos no lo van a resucitar. */
      return resultadoDeFallo("TikTok", 404,
               "El enlace corto de TikTok ya no lleva a ningún video.");
    }
    urlConsulta = largo;
  }

  const r = ejecutarFetchSeguro(URL_TIKTOK_OEMBED + encodeURIComponent(urlConsulta), { method: "GET" }, "TikTok");
  if (!r.ok) return resultadoDeFallo("TikTok", r.codigo, "TikTok HTTP " + r.codigo);
  try {
    const data = JSON.parse(r.cuerpo);
    return {
      titulo: data.title || "Video TikTok",
      descripcion: data.title || "",
      canal: data.author_name || "TikTok Creator",
      duracion: 0,
      fechaPublicacion: "",
      vistas: 0,
      likes: 0,
      categoriaId: "",
      audioLang: null,
      plataforma: "TikTok",
      // El id real del video, que en un enlace corto no estaba en la URL. Es lo
      // que permite que la fila quede con su ID y no con el código del atajo.
      idResuelto: (data.embed_product_id || obtenerIdTikTok(urlConsulta) || "").toString(),
      origenMetadatos: "oembed"
    };
  } catch (e) {
    return { _error: true, httpCode: 500, mensaje: "TikTok JSON inválido" };
  }
}

/**
 * Reprocesa en bloque los TikTok ya catalogados con duración en cero, usando la
 * API oficial. Útil justo después de autorizar la cuenta: rellena de golpe lo
 * que la ingesta original no pudo obtener.
 */
function completarMetadatosTikTokDelCatalogo() {
  exigirOrigenInterno("completarMetadatosTikTokDelCatalogo");
  if (!obtenerApiKey_("TIKTOK_REFRESH_TOKEN")) {
    alertarUsuario("No hay una cuenta de TikTok autorizada.\n\n" +
      "Usa «Conectar cuenta de TikTok» primero. Sin ella, TikTok solo entrega " +
      "título y autor, nunca duración ni métricas.", "TikTok");
    return { actualizados: 0 };
  }

  const pendientes = [];
  iterarCatalogoPorBloques(function (datos, filaInicio) {
    for (let i = 0; i < datos.length; i++) {
      const plataforma = (datos[i][IDX.FUENTE] || deducirFuenteDesdeUrl(datos[i][IDX.URL])).toString();
      if (plataforma.indexOf("TikTok") === -1) continue;
      if (parseFloat(datos[i][IDX.DURACION]) > 0) continue;
      const id = (datos[i][IDX.ID] || "").toString().trim();
      if (id) pendientes.push({ id: id, fila: filaInicio + i });
    }
    return false;
  });

  if (pendientes.length === 0) {
    notificarUsuario("No hay TikToks con duración pendiente.", "TikTok", 4);
    return { actualizados: 0 };
  }

  const diagnostico = {};
  const mapa = obtenerMetadatosTikTokAvanzadoLote(pendientes.map(p => p.id), diagnostico);
  const hoja = obtenerHojaDatos();
  let actualizados = 0;

  pendientes.forEach(p => {
    const m = mapa[p.id];
    if (!m) return;
    hoja.getRange(p.fila, IDX.DURACION + 1).setValue(m.duracion);
    hoja.getRange(p.fila, IDX.VISTAS + 1).setValue(m.vistas);
    hoja.getRange(p.fila, IDX.LIKES + 1).setValue(m.likes);
    if (m.fechaPublicacion) hoja.getRange(p.fila, IDX.FECHA_PUB + 1).setValue(m.fechaPublicacion);
    actualizados++;
  });

  if (actualizados > 0) invalidarCacheAPI();
  const sinDatos = pendientes.length - actualizados;
  logInfo("TikTok", `Metadatos completados: ${actualizados} de ${pendientes.length}.`);
  alertarUsuario(
    `Actualizados: ${actualizados} de ${pendientes.length} videos.` +
    (sinDatos > 0 ? `\n\n${sinDatos} siguen sin datos de la API; sus valores no se modificaron. ` +
      "Esto no demuestra que sean ajenos. Esta API solo consulta videos de la cuenta autorizada." : "") +
    (diagnostico.errores.length ? "\n\nConsulta incompleta: " + diagnostico.errores.join(" ") :
      "\n\nTikTok respondió correctamente a todas las consultas."),
    "TikTok");
  return { actualizados: actualizados, sinDatos: sinDatos, consultados: diagnostico.consultados, errores: diagnostico.errores };
}

/** Estado de la integración, para el diagnóstico. */
function estadoIntegracionTikTok() {
  const tieneApp = Boolean(proveedorApiKey("TIKTOK_CLIENT_KEY") && proveedorApiKey("TIKTOK_CLIENT_SECRET"));
  const autorizada = Boolean(obtenerApiKey_("TIKTOK_REFRESH_TOKEN"));
  return {
    credenciales: tieneApp,
    cuentaAutorizada: autorizada,
    openId: PropertiesService.getScriptProperties().getProperty("TIKTOK_OPEN_ID") || "",
    modo: autorizada ? "API oficial (videos propios) + oEmbed" : "solo oEmbed",
    limitacion: "La API de TikTok nunca devuelve métricas de videos de terceros."
  };
}

/** [MEJORA 13] Dailymotion vía API pública (con respaldo oEmbed). */
function obtenerMetadatosDailymotion(videoIdOUrl) {
  if (!videoIdOUrl) return null;
  try { verificarCuotaDisponible(1, "DAILYMOTION"); } catch (e) { logWarn("Dailymotion", e.message); return null; }

  const id = obtenerIdDailymotion(videoIdOUrl) || videoIdOUrl;
  const campos = "id,title,description,owner.screenname,duration,created_time,views_total,likes_total";
  const r = ejecutarFetchSeguro(URL_DAILYMOTION_API + id + "?fields=" + campos, { method: "GET" }, "Dailymotion");
  if (r.ok) {
    try {
      const d = JSON.parse(r.cuerpo);
      return {
        titulo: d.title || "Video Dailymotion",
        descripcion: d.description || "",
        canal: d["owner.screenname"] || "Dailymotion Creator",
        duracion: Number(((d.duration || 0) / 60).toFixed(2)),
        fechaPublicacion: d.created_time ? Utilities.formatDate(new Date(d.created_time * 1000), obtenerZonaHoraria(), "yyyy-MM-dd") : "",
        vistas: Number(d.views_total || 0),
        likes: Number(d.likes_total || 0),
        categoriaId: "",
        audioLang: null,
        plataforma: "Dailymotion"
      };
    } catch (e) { /* cae al respaldo oEmbed */ }
  }

  const oe = ejecutarFetchSeguro(URL_DAILYMOTION_OEMBED + encodeURIComponent("https://www.dailymotion.com/video/" + id), { method: "GET" }, "Dailymotion oEmbed");
  if (!oe.ok) return resultadoDeFallo("Dailymotion", r.codigo || oe.codigo, "Dailymotion HTTP " + (r.codigo || oe.codigo));
  try {
    const d = JSON.parse(oe.cuerpo);
    return {
      titulo: d.title || "Video Dailymotion",
      descripcion: d.description || "",
      canal: d.author_name || "Dailymotion Creator",
      duracion: 0, fechaPublicacion: "", vistas: 0, likes: 0,
      categoriaId: "", audioLang: null, plataforma: "Dailymotion"
    };
  } catch (e) {
    return { _error: true, httpCode: 500, mensaje: "Dailymotion JSON inválido" };
  }
}

/** [MEJORA 13] Facebook Watch vía oEmbed público (sin token) o Graph API si hay token. */
function obtenerMetadatosFacebook(url) {
  if (!url) return null;
  try { verificarCuotaDisponible(1, "FACEBOOK"); } catch (e) { logWarn("Facebook", e.message); return null; }

  const tokenGraph = proveedorApiKey("FACEBOOK");
  if (tokenGraph) {
    const idFb = obtenerIdFacebook(url);
    const graph = ejecutarFetchSeguro(
      PROTO + "graph.facebook.com/v19.0/" + idFb + "?fields=title,description,from,length,created_time&access_token=" + encodeURIComponent(tokenGraph),
      { method: "GET" }, "Facebook Graph");
    if (graph.ok) {
      try {
        const d = JSON.parse(graph.cuerpo);
        return {
          titulo: d.title || d.description || "Video Facebook",
          descripcion: d.description || "",
          canal: (d.from && d.from.name) || "Facebook Page",
          duracion: Number(((d.length || 0) / 60).toFixed(2)),
          fechaPublicacion: d.created_time ? d.created_time.slice(0, 10) : "",
          vistas: 0, likes: 0, categoriaId: "", audioLang: null, plataforma: "Facebook"
        };
      } catch (e) { /* respaldo oEmbed */ }
    }
  }

  const r = ejecutarFetchSeguro(URL_FACEBOOK_OEMBED + encodeURIComponent(url), { method: "GET" }, "Facebook oEmbed");
  if (!r.ok) return resultadoDeFallo("Facebook", r.codigo, "Facebook HTTP " + r.codigo);
  try {
    const d = JSON.parse(r.cuerpo);
    return {
      titulo: d.title || "Video Facebook Watch",
      descripcion: d.title || "",
      canal: d.author_name || "Facebook Creator",
      duracion: 0, fechaPublicacion: "", vistas: 0, likes: 0,
      categoriaId: "", audioLang: null, plataforma: "Facebook"
    };
  } catch (e) {
    return { _error: true, httpCode: 500, mensaje: "Facebook JSON inválido" };
  }
}

/** Obtiene (y cachea 50 min) el App Access Token de Twitch mediante client credentials. */
function obtenerTokenTwitch() {
  const cache = CacheService.getScriptCache();
  const cacheado = cache.get("TWITCH_APP_TOKEN");
  if (cacheado) return cacheado;

  const clientId = proveedorApiKey("TWITCH_CLIENT_ID");
  const clientSecret = proveedorApiKey("TWITCH_CLIENT_SECRET");
  if (!clientId || !clientSecret) return "";

  const r = ejecutarFetchSeguro(URL_TWITCH_OAUTH, {
    method: "POST",
    payload: { client_id: clientId, client_secret: clientSecret, grant_type: "client_credentials" }
  }, "Twitch OAuth");
  if (!r.ok) {
    logWarn("Twitch", "No se pudo obtener token de aplicación: HTTP " + r.codigo);
    return "";
  }
  try {
    const d = JSON.parse(r.cuerpo);
    if (d.access_token) {
      cache.put("TWITCH_APP_TOKEN", d.access_token, 3000);
      return d.access_token;
    }
  } catch (e) { /* ignora */ }
  return "";
}

/** [MEJORA 13] Metadatos de VOD de Twitch mediante Helix. */
function obtenerMetadatosTwitch(videoId) {
  if (!videoId) return null;
  try { verificarCuotaDisponible(1, "TWITCH"); } catch (e) { logWarn("Twitch", e.message); return null; }

  const clientId = proveedorApiKey("TWITCH_CLIENT_ID");
  const token = obtenerTokenTwitch();
  if (!clientId || !token) {
    /* `configuracion` distingue «falta configurar algo» de «este video está
       roto». Antes las dos cosas contaban igual y, tras tres pasadas, un video
       de Twitch perfectamente público acababa aislado en la cola de fallos por
       una credencial que nadie había puesto todavía. */
    return {
      _error: true, httpCode: 401, configuracion: true,
      mensaje: "Twitch necesita Client-ID y Client-Secret. Configúralos en «IA Multi-Modelo y Seguridad»."
    };
  }

  const r = ejecutarFetchSeguro(URL_TWITCH_HELIX_VIDEOS + encodeURIComponent(videoId), {
    method: "GET",
    headers: { "Client-ID": clientId, "Authorization": "Bearer " + token }
  }, "Twitch Helix");
  if (!r.ok) return resultadoDeFallo("Twitch", r.codigo, "Twitch HTTP " + r.codigo);

  try {
    const d = JSON.parse(r.cuerpo);
    const v = d.data && d.data[0];
    /* [v2.6.13] Helix contestó 200 con la lista vacía: el VOD caducó o se borró.
       Twitch expira los VODs por diseño, así que esto es la vejez normal de un
       enlace, no una avería. */
    if (!v) return resultadoDeFallo("Twitch", 404, "VOD de Twitch no encontrado");
    let minutos = 0;
    const dur = (v.duration || "").match(/(?:(\d+)h)?(?:(\d+)m)?(?:(\d+)s)?/);
    if (dur) minutos = Number(((parseInt(dur[1] || 0, 10) * 60) + parseInt(dur[2] || 0, 10) + (parseInt(dur[3] || 0, 10) / 60)).toFixed(2));
    return {
      titulo: v.title || "VOD Twitch",
      descripcion: v.description || "",
      canal: v.user_name || "Twitch Creator",
      duracion: minutos,
      fechaPublicacion: v.published_at ? v.published_at.slice(0, 10) : "",
      vistas: Number(v.view_count || 0),
      likes: 0, categoriaId: "", audioLang: v.language || null, plataforma: "Twitch"
    };
  } catch (e) {
    return { _error: true, httpCode: 500, mensaje: "Twitch JSON inválido" };
  }
}

/** Enrutador de metadatos por plataforma. */
function obtenerMetadatosPorPlataforma(parseado, url, mapaYT) {
  if (!parseado) return null;
  switch (parseado.plataforma) {
    case "YouTube": return (mapaYT && mapaYT[parseado.id]) ? mapaYT[parseado.id] : null;
    case "Vimeo": return obtenerMetadatosVimeo(parseado.id);
    case "TikTok": return obtenerMetadatosTikTok(url);
    case "Dailymotion": return obtenerMetadatosDailymotion(parseado.id);
    case "Facebook": return obtenerMetadatosFacebook(url);
    case "Twitch": return obtenerMetadatosTwitch(parseado.id);
    case "TED": return obtenerMetadatosTED(url);
    case "Bilibili": return obtenerMetadatosBilibili(parseado.id);
    /* Tencent no publica ninguna interfaz de metadatos. No se intenta y no se
       finge intentarlo: se declara de entrada que esta fila necesita un título
       escrito a mano. Gastar una petición para descubrir cada vez lo que ya
       sabemos sería ruido en el registro y latencia en cada pasada. */
    case "Tencent Video": return { _sinMetadatos: true, plataforma: "Tencent Video" };
    default: return null;
  }
}

// -------------------------------------------------------------------------------------
// 6.2 Ingesta masiva con checkpoint anti-timeout (bloques de 100) — [MEJORA 1]
// -------------------------------------------------------------------------------------

/** Enriquece un único bloque ya leído en memoria. Devuelve cuántas filas se completaron. */
/**
 * Enriquece un bloque ya leído en memoria.
 *
 * [v2.6.16] Devuelve { procesados, tocadas }. Antes devolvía solo el número de
 * filas completadas, y la llamante volcaba el bloque únicamente si ese número
 * era mayor que cero. Un bloque de 100 filas donde todas fallaron daba cero,
 * no se volcaba nada, y el trabajo de marcarlas se perdía: a la pasada
 * siguiente volvían a intentarse desde el principio. `tocadas` cuenta también
 * las que solo cambiaron de Estado o de Error.
 */
/**
 * @param {Array[]} datos     filas del bloque, se modifican en el sitio
 * @param {number}  startRow  fila real de la hoja donde empieza el bloque
 * @param {number}  limiteMs  [6.26] instante (Date.now()) en el que hay que
 *   soltar el bloque aunque queden filas. 0 = sin límite, para los llamadores
 *   que no corren contra reloj.
 * @param {Function} volcar   [6.27] opcional: persiste `datos` tal y como estén.
 *   Se llama cada pocas filas para que un corte duro de Apps Script no se lleve
 *   el trabajo del bloque entero.
 * @return {{procesados:number, tocadas:number, detenidoEn:number,
 *           falloPersistencia:boolean}} `detenidoEn` es la fila REAL de la hoja
 *   por la que habría que seguir; 0 si terminó el bloque entero.
 *   `falloPersistencia` es true cuando se paró porque la hoja no aceptó una
 *   escritura: el que llama NO debe tratarlo como un corte normal.
 */
function enriquecerBloqueIngesta(datos, startRow, limiteMs = 0, volcar = null) {
  const pendientes = [];
  const idsYouTube = [];
  let tocadas = 0;

  for (let i = 0; i < datos.length; i++) {
    const url = (datos[i][IDX.URL] || "").toString().trim();
    const id = (datos[i][IDX.ID] || "").toString().trim();
    const tit = (datos[i][IDX.TITULO] || "").toString().trim();
    if (!url || (id && tit)) continue;
    /* Una fila descartada ya no se toca: o la apartó el administrador, o la
       apartó `marcarEnlaceNoProcesable` porque su URL no es un video. Sin esto,
       cada pasada la volvía a intentar, a fallar y a aislar. */
    /* [v2.6.16] «❌ Error» también se salta.
       Antes solo se excluía «⚪ Descartado», así que cada Fase 1 volvía a
       atacar videos ya declarados muertos: por eso la DLQ tenía filas con 7, 8
       y 9 intentos — no eran nueve reintentos de una pasada, eran nueve pasadas
       repitiendo el mismo error. Reactivarlas es una decisión deliberada y ya
       tiene su herramienta: «♻️ Reprocesar registros de la DLQ», que las
       devuelve a 🟡 Pendiente. La ingesta normal no debe tomarla sola. */
    const estadoFila = (datos[i][IDX.ESTADO] || "").toString().trim();
    if (estadoFila === "⚪ Descartado" || estadoFila === "❌ Error") continue;
    /* [v2.6.12] Fila de una plataforma sin metadatos que ya recibió su id. No se
       vuelve a consultar: la respuesta sería la misma, y lo único que falta —el
       título— no lo puede traer ninguna petición, lo tiene que escribir una
       persona. Sin este corte, cada pasada de la ingesta volvería a pedirlos
       eternamente para descubrir cada vez que no hay nada que pedir.
       En cuanto alguien escribe el título, la condición de arriba (`id && tit`)
       ya la salta por la vía normal; y si además borra esta nota, la fila vuelve
       a intentarse como cualquier otra. */
    /* [v2.6.19] La marca basta por sí sola; antes se exigía además que la fila
       tuviera id, y hay filas degradadas que precisamente no lo tienen: un
       enlace corto de TikTok que ya no resuelve nunca llega a dar uno. Esas se
       volvían a consultar en cada pasada para descubrir cada vez lo mismo.
       Para rescatar una fila se cambia el enlace y se borra la nota, que es una
       acción deliberada y visible. */
    if (esFilaDegradada(datos[i][IDX.ERROR])) continue;

    const parseado = parsearVideoUniversal(url);
    if (!parseado) {
      /* [v2.6.15] Antes, lo que no encajaba en ninguna forma conocida iba a
         `gestionarErrorFila` con un 400, o sea: reintento, reincidente, cola de
         fallos. Pero que el parser no reconozca una URL no es un tropiezo — es
         una respuesta, y la misma las tres veces. Se aparta igual que las
         demás, con el dominio escrito al lado para poder decidir. */
      marcarEnlaceNoProcesable(startRow + i,
        clasificarEnlaceNoVideo(url) || motivoUrlNoIngerible(url), datos[i]);
      tocadas++;
      continue;
    }
    pendientes.push({ index: i, parseado: parseado, url: url });
    if (parseado.plataforma === "YouTube") idsYouTube.push(parseado.id);
  }

  if (pendientes.length === 0) {
    return { procesados: 0, tocadas: tocadas, detenidoEn: 0, falloPersistencia: false };
  }

  const mapaYT = idsYouTube.length > 0 ? obtenerMetadatosYouTubeLote50(idsYouTube, limiteMs) : {};
  let totalProcesados = 0;

  /* [v2.6.15] Memoria de la pasada: plataforma+id → metadatos.
   *
   * El mismo video aparece en varias filas más de lo que parece — en el
   * aislamiento del 10/9, 75 filas eran 58 videos, y un VOD de Twitch se
   * preguntó tres veces seguidas en el mismo lote. YouTube ya se libraba de
   * esto porque va por lotes de 50, pero Vimeo, Twitch y TikTok preguntaban una
   * vez por fila. Se pregunta una vez por video y la respuesta se reparte.
   *
   * Vive solo mientras dura el bloque, a propósito: no es una caché con
   * caducidad que haya que invalidar cuando un título cambia, es no repetir la
   * misma pregunta en el mismo minuto. */
  const memoria = {};
  let ahorradas = 0;

  /* [6.26] El corte fila a fila, no bloque a bloque.
   *
   * Mirar el reloj antes de EMPEZAR un bloque evita empezar uno que no cabe,
   * pero no acorta el que ya empezó: cien filas con una llamada de red cada
   * una pueden pasarse del límite de seis minutos ellas solas, y ahí Apps
   * Script corta sin dejar guardar nada. Así que el bloque también se suelta
   * por la mitad: las filas ya resueltas se escriben igual —el llamador vuelca
   * el bloque entero, y las que no se tocaron están tal cual estaban— y el
   * checkpoint apunta a la primera que quedó sin hacer, no al final del bloque.
   *
   * Lo que esto NO arregla, y conviene no venderlo: una sola llamada de red
   * colgada. `UrlFetchApp` no admite tiempo de espera, así que si un proveedor
   * deja la conexión abierta cuatro minutos, esa fila se los lleva y Apps
   * Script corta en seco. El corte por reloj impide EMPEZAR más trabajo; quien
   * acota lo que se pierde es el volcado parcial de más abajo, no este. */
  /* [6.27] Volcado parcial, cada pocas filas.
   *
   * El corte por reloj impide EMPEZAR más trabajo, pero no garantiza que el
   * hecho quede guardado: hasta ahora las filas resueltas vivían en memoria
   * hasta que el bloque terminaba, así que un corte duro —una llamada de red
   * colgada que agota los seis minutos— se llevaba el bloque entero por
   * delante. Guardar cada fila costaría cien escrituras por bloque; guardar
   * cada veinticinco acota la pérdida a veinticinco filas con cuatro. */
  const VOLCAR_CADA = 25;
  let desdeUltimoVolcado = 0;
  /* [6.28] La fila por la que se puede reanudar SIN PERDER NADA: la siguiente a
     la del último volcado que salió bien. Mientras no haya volcado ninguno es
     el principio del bloque, porque nada de lo hecho está a salvo todavía. */
  let filaSegura = startRow;
  /**
   * @return {boolean} false si el volcado falló. Y si falla, el que llama TIENE
   *   que parar: seguir enriqueciendo después de que la persistencia deje de
   *   funcionar es acumular en memoria trabajo que ya se sabe que no se está
   *   guardando. Antes esto solo escribía una advertencia y continuaba, y con
   *   eso la promesa de «se pierden como mucho 25 filas» era mentira: con la
   *   hoja rechazando escrituras se podían perder las cien.
   */
  const volcarSiToca = (forzar, filaActual) => {
    if (!volcar || desdeUltimoVolcado === 0) return true;
    if (!forzar && desdeUltimoVolcado < VOLCAR_CADA) return true;
    try {
      volcar();
      desdeUltimoVolcado = 0;
      filaSegura = filaActual;
      return true;
    } catch (e) {
      logError("Ingesta", "No se pudo guardar el avance parcial; se detiene el bloque. " +
        "Se reanudará desde la fila " + filaSegura + ". Causa: " + e.message);
      return false;
    }
  };

  let detenidoEn = 0;
  let falloPersistencia = false;
  for (let p = 0; p < pendientes.length; p++) {
    const item = pendientes[p];
    const idx = item.index;
    const filaSheet = startRow + idx;
    /* [6.27] Una fila cuyo id se quedó sin consultar no se procesa: `mapaYT` no
       sabe nada de ella y seguir adelante la marcaría como video inexistente.
       Es el mismo corte que el del reloj, por otro motivo. */
    const sinConsultar = item.parseado.plataforma === "YouTube" &&
      mapaYT[item.parseado.id] && mapaYT[item.parseado.id].sinTiempo;
    if (sinConsultar) {
      detenidoEn = filaSheet;
      logInfo("Ingesta", `Bloque soltado en la fila ${filaSheet}: su video no se llegó a consultar.`);
      /* [6.29] El volcado de salida también puede fallar, y entonces la fila por
         la que se reanuda NO es esta: es la última que quedó escrita. Ignorar
         este resultado devolvía un número que parecía bueno y no lo era. */
      if (!volcarSiToca(true, filaSheet)) { detenidoEn = filaSegura; falloPersistencia = true; }
      break;
    }
    if (limiteMs && Date.now() > limiteMs) {
      detenidoEn = filaSheet;
      logInfo("Ingesta", `Bloque soltado en la fila ${filaSheet}: se acabó el tiempo de esta pasada. ` +
        `Quedan ${pendientes.length - p} filas para la siguiente.`);
      if (!volcarSiToca(true, filaSheet)) { detenidoEn = filaSegura; falloPersistencia = true; }
      break;
    }
    try {
      const llave = item.parseado.plataforma + " " + item.parseado.id;
      let videoData;
      if (Object.prototype.hasOwnProperty.call(memoria, llave)) {
        videoData = memoria[llave];
        ahorradas++;
      } else {
        videoData = obtenerMetadatosPorPlataforma(item.parseado, item.url, mapaYT);
        memoria[llave] = videoData;
      }

      if (videoData && !videoData._error) {
        // La categoría llega en el mismo lote de metadatos: se pasa al
        // clasificador para que aparte los musicales sin gastar una llamada de IA.
        const categoriaYT = videoData.categoriaId ? traducirCategoriaYouTube(videoData.categoriaId) : "";
        const clasif = motorClasificacionUniversal(videoData.titulo, videoData.descripcion, categoriaYT);
        /* Un enlace corto de TikTok no trae el id en la URL: lo devuelve el
           proveedor. Sin este respaldo la fila se quedaba sin ID y todo lo que
           se apoya en él —progreso, favoritos, apuntes, módulos— quedaba
           colgando de una cadena vacía. */
        datos[idx][IDX.ID] = item.parseado.id || (videoData.idResuelto || "").toString();
        datos[idx][IDX.TITULO] = videoData.titulo;
        datos[idx][IDX.RESUMEN] = datos[idx][IDX.RESUMEN] || clasif.resumen;
        // La plataforma va a SU columna. Escribirla en el ecosistema, como se
        // hacía antes, borraba la clasificación que acaba de calcularse.
        datos[idx][IDX.FUENTE] = videoData.plataforma || deducirFuenteDesdeUrl(item.url);
        // Lo que ya estuviera clasificado a mano no se pisa: solo se rellena.
        if (!datos[idx][IDX.ECOSISTEMA] || datos[idx][IDX.ECOSISTEMA] === SIN_CLASIFICAR) {
          datos[idx][IDX.ECOSISTEMA] = clasif.ecosistema;
        }
        if (!datos[idx][IDX.AREA] || datos[idx][IDX.AREA] === SIN_CLASIFICAR) {
          datos[idx][IDX.AREA] = clasif.area;
        }
        if (!datos[idx][IDX.TEMA] && clasif.tema) datos[idx][IDX.TEMA] = clasif.tema;
        datos[idx][IDX.VERSION] = clasif.version;
        /* La descripción entra en la detección de idioma: un título como
           «Odoo 18 POS» no tiene ni una palabra funcional que delate el idioma,
           y la descripción sí. Es el momento en que la tenemos —después no se
           guarda—, así que si aquí no se aprovecha, se pierde. */
        datos[idx][IDX.IDIOMA] = detectarIdioma(videoData.titulo, videoData.audioLang, videoData.descripcion);
        // [v2] Facetas: solo si la fila no las trae ya de una corrección manual.
        if (!datos[idx][IDX.HERRAMIENTA])    datos[idx][IDX.HERRAMIENTA] = clasif.herramienta || "";
        if (!datos[idx][IDX.INDUSTRIA])      datos[idx][IDX.INDUSTRIA] = clasif.industria || INDUSTRIA_TRANSVERSAL;
        if (!datos[idx][IDX.JURISDICCION])   datos[idx][IDX.JURISDICCION] = clasif.jurisdiccion || JURISDICCION_GLOBAL;
        if (!datos[idx][IDX.ALCANCE])        datos[idx][IDX.ALCANCE] = clasif.alcance || ALCANCE_PENDIENTE;
        if (!datos[idx][IDX.TIPO_CONTENIDO]) datos[idx][IDX.TIPO_CONTENIDO] = clasif.tipoContenido || "Tutorial";
        datos[idx][IDX.CANAL] = videoData.canal;
        datos[idx][IDX.FECHA_PUB] = videoData.fechaPublicacion;
        datos[idx][IDX.DURACION] = videoData.duracion;
        datos[idx][IDX.VISTAS] = videoData.vistas;
        datos[idx][IDX.LIKES] = videoData.likes;
        datos[idx][IDX.CATEGORIA_YT] = categoriaYT || "General";
        if (!datos[idx][IDX.ESTADO]) datos[idx][IDX.ESTADO] = "🟡 Pendiente";
        // [F1-10] Recursos útiles extraídos de la descripción (columna P).
        if (!datos[idx][IDX.RECURSOS]) datos[idx][IDX.RECURSOS] = extraerLinkUtil(videoData.descripcion);
        datos[idx][IDX.TAGS] = generarTags(videoData.titulo, videoData.descripcion, clasif.ecosistema, clasif.version);
        datos[idx][IDX.ERROR] = "";
        if (!datos[idx][IDX.DIFICULTAD]) datos[idx][IDX.DIFICULTAD] = "Principiante";
        totalProcesados++;
        tocadas++;
      } else if (videoData && videoData._error && videoData.configuracion) {
        /* Falta una credencial, no falla el video. Se anota el motivo y la fila
           se queda como está para que la siguiente pasada la recoja en cuanto
           se configure; contarla como fallo la acabaría aislando por algo que
           no tiene que ver con ella. */
        anotarPendienteDeConfiguracion(filaSheet, videoData.mensaje, datos[idx]);
        tocadas++;
      } else if (videoData && videoData._sinMetadatos) {
        /* [v2.6.12] La plataforma no nos da metadatos, pero el video es válido.
           Es un tercer desenlace que antes no existía, y por no existir estas
           filas caían en el `else` de abajo y se aislaban como «privado,
           eliminado o inexistente» — tres cosas que no son ciertas.
           Se guarda lo que SÍ sabemos —id, fuente, estado— y se deja el título
           vacío a propósito. Vacío no es un descuido: es lo que mantiene la fila
           fuera de la Fase 2, que exige título, y así no se gasta una llamada de
           IA pidiéndole a un modelo que adivine de qué trata «BV1xx411c7mD». La
           nota en «Error» dice qué hacer, y en cuanto alguien escriba el título
           la fila sigue su curso normal como cualquier otra. */
        datos[idx][IDX.ID] = item.parseado.id || datos[idx][IDX.ID] || "";
        datos[idx][IDX.FUENTE] = videoData.plataforma || deducirFuenteDesdeUrl(item.url);
        if (!datos[idx][IDX.ESTADO]) datos[idx][IDX.ESTADO] = "🟡 Pendiente";
        if (!datos[idx][IDX.DIFICULTAD]) datos[idx][IDX.DIFICULTAD] = "Principiante";
        datos[idx][IDX.ERROR] = MARCA_SIN_METADATOS + " " +
          (videoData.plataforma || "esta plataforma") + " no publica metadatos. " +
          "Escribe el título a mano y el resto seguirá solo.";
        logInfo("Ingesta", `${videoData.plataforma}: fila ${filaSheet} aceptada sin metadatos.`);
        tocadas++;
      } else if (videoData && videoData._error) {
        // [MEJORA 9] Error controlado de API: se aísla con su código HTTP, sin excepción.
        gestionarErrorFila(filaSheet, videoData.mensaje || "Error de proveedor", item.url,
          datos[idx][IDX.TITULO] || "", "", videoData.httpCode || 0, datos[idx]);
        tocadas++;
      } else {
        /* Sin resultado en la API = video privado, eliminado o inexistente.
         *
         * [v2.6.13] Esto es un 404 lógico, y por la regla de 6.13 un 404 es
         * definitivo: la API entendió la pregunta y contestó que ese video no
         * está. Hasta ahora caía en `gestionarErrorFila`, o sea reintento,
         * reincidente y cola de fallos — 44 de las 75 filas del aislamiento del
         * 10/9 entraron por aquí, algunas tras ocho rondas de preguntarle a
         * YouTube por un video borrado.
         *
         * Se degrada como las demás, pero NO con el mismo texto: que Bilibili no
         * publique metadatos y que un video esté borrado son dos cosas distintas
         * y la nota tiene que distinguirlas, o el catálogo se llena de filas
         * muertas que parecen trabajo pendiente. Aquí la acción no es «escribe el
         * título»: es «descarta la fila o cambia el enlace». */
        datos[idx][IDX.ID] = (item.parseado && item.parseado.id) || datos[idx][IDX.ID] || "";
        datos[idx][IDX.FUENTE] = deducirFuenteDesdeUrl(item.url);
        if (!datos[idx][IDX.ESTADO]) datos[idx][IDX.ESTADO] = "🟡 Pendiente";
        if (!datos[idx][IDX.DIFICULTAD]) datos[idx][IDX.DIFICULTAD] = "Principiante";
        datos[idx][IDX.ERROR] = MARCA_VIDEO_NO_DISPONIBLE + " privado, eliminado o inexistente. " +
          "Escribirle un título NO lo arregla: cambia el enlace o marca la fila como ⚪ Descartado.";
        logInfo("Ingesta", `Fila ${filaSheet}: video no disponible, aceptada sin metadatos y sin reintento.`);
        tocadas++;
      }
    } catch (errF) {
      gestionarErrorFila(filaSheet, errF.message, item.url, datos[idx][IDX.TITULO] || "", errF.stack,
        deducirCodigoHttpDesdeError(errF.message), datos[idx]);
      tocadas++;
    }
    desdeUltimoVolcado++;
    if (!volcarSiToca(false, filaSheet + 1)) {
      /* No se apunta a la fila en curso sino a la última a salvo: lo procesado
         desde el último volcado bueno no está en la hoja, así que hay que
         volver a hacerlo. Repetir trabajo es barato —una fila ya resuelta se
         salta sola en la pasada siguiente—; saltárselo, no. */
      detenidoEn = filaSegura;
      falloPersistencia = true;
      break;
    }
  }

  if (ahorradas > 0) {
    logInfo("Ingesta", `${ahorradas} consultas evitadas: filas repetidas del mismo video en este bloque.`);
  }

  return { procesados: totalProcesados, tocadas: tocadas, detenidoEn: detenidoEn,
           falloPersistencia: falloPersistencia };
}

/**
 * [MEJORA 1] Ingesta con checkpoint anti-timeout.
 * Recorre bloques de BATCH_TAMANO_BLOQUE filas: los bloques ya completos se saltan
 * dentro de la misma ejecución (coste mínimo) y el trabajo pesado se detiene al
 * alcanzar el presupuesto de tiempo, encadenando un trigger de continuación.
 */
function procesarColaConAntiTimeout_(silencioso = false) {
  marcarOrigenConfiable();   // [SEC-1] entrada legítima del servidor
  const inicioEjecucion = new Date().getTime();
  /* [6.25] El presupuesto se miraba DESPUÉS de procesar cada bloque, y ese es
     el orden que no protege: si un bloque tarda dos minutos y medio —una
     llamada a la API de un proveedor que se queda colgada basta—, la pasada ya
     está fuera de tiempo cuando llega a mirar el reloj. En la ejecución del
     10/9 esto acabó en «tiempo de espera» a los 360,8 s, o sea el límite duro
     de Apps Script, que corta sin dejar guardar el checkpoint ni encadenar la
     continuación: el trabajo del último bloque se pierde y nadie reprograma.

     Ahora se mira ANTES de empezar cada bloque y se exige sitio para lo que
     tardó el bloque anterior más el cierre. El cierre no es gratis: guardar el
     checkpoint, invalidar la caché y crear el disparador de continuación son
     llamadas a servicios de Google. */
  const PRESUPUESTO_MS = 4 * 60 * 1000;      // margen frente al límite de 6 minutos
  const RESERVA_CIERRE_MS = 90 * 1000;       // guardar estado y reprogramar
  let duracionUltimoBloque = 0;

  const hoja = obtenerHojaDatos();
  asegurarColumnas(hoja, TOTAL_COLUMNAS);
  const ultFilaReal = hoja.getLastRow();
  if (ultFilaReal < 2) {
    if (!silencioso) notificarUsuario(t("alert_catalogo_vacio"), "Ingesta", 4);
    return { procesados: 0, fin: true };
  }

  /* [v2.6.10] Esta función no usa iterarCatalogoPorBloques —lleva su propio
     bucle con presupuesto de tiempo y checkpoint—, así que la ventana hay que
     aplicarla aquí a mano. Se hace: dejarla fuera significaría que «sincronizar
     desde la fila 500 hasta la 800» acota tres etapas y la cuarta se va hasta el
     final del catálogo. Una regla que se aplica en tres de cuatro sitios es peor
     que no tenerla, porque parece que está. */
  const ultFila = limitesRecorridoCatalogo(ultFilaReal).hasta;

  const props = PropertiesService.getScriptProperties();
  let startRow = parseInt(props.getProperty("INGESTA_CHECKPOINT") || "2", 10);
  if (!startRow || startRow < 2) startRow = 2;

  let totalProcesados = 0;
  let primerBloque = startRow;
  let ultimoBloque = startRow;
  /* [6.30] «No hubo nada que escribir» no es «la hoja volvió a funcionar».
     Antes el contador de fallos se borraba en cada vuelta, tuviera o no
     escrituras: bastaba un bloque sin cambios entre dos fallos para que la
     cuenta volviera a cero y los reintentos fueran infinitos de hecho. */
  let huboEscrituraCorrecta = false;

  while (startRow <= ultFila) {
    /* Sitio para OTRO bloque como el anterior, más el cierre. En la primera
       vuelta no hay medida todavía, así que se usa la reserva como estimación:
       prudente, y solo cuesta una pasada de más en el peor caso. */
    const transcurrido = new Date().getTime() - inicioEjecucion;
    const coste = duracionUltimoBloque || RESERVA_CIERRE_MS;
    if (transcurrido + coste + RESERVA_CIERRE_MS > PRESUPUESTO_MS) {
      logInfo("Ingesta", `Se para en la fila ${startRow}: quedan ${Math.round((PRESUPUESTO_MS - transcurrido) / 1000)} s ` +
        `y el último bloque tardó ${Math.round(coste / 1000)} s. Continúa la próxima pasada.`);
      break;
    }

    const arranqueBloque = new Date().getTime();
    const endRow = Math.min(startRow + BATCH_TAMANO_BLOQUE - 1, ultFila);
    const rango = hoja.getRange(startRow, 1, endRow - startRow + 1, TOTAL_COLUMNAS);
    const datos = rango.getValues();

    /* [6.26] El bloque también tiene hora de cierre: se le pasa el instante
       límite para que suelte lo que esté haciendo y devuelva por dónde iba. */
    const limiteBloque = inicioEjecucion + PRESUPUESTO_MS - RESERVA_CIERRE_MS;
    /* [6.31] El volcado parcial también es una escritura, y hasta ahora no
       contaba: solo el guardado FINAL marcaba «la hoja responde». Con eso, una
       pasada que escribía veinticinco filas y fallaba en las siguientes sumaba
       un fallo más a los anteriores como si no hubiera escrito nada, y la
       cadena se paraba por unos fallos que no eran consecutivos.
       La marca va DESPUÉS de `flush()`: un `setValues` que no llega a vaciarse
       no es una escritura confirmada. */
    const res = enriquecerBloqueIngesta(datos, startRow, limiteBloque,
      function () {
        rango.setValues(datos);
        SpreadsheetApp.flush();
        huboEscrituraCorrecta = true;
      });
    const procesadosBloque = res.procesados;
    /* [v2.6.16] Se vuelca si cambió ALGO, no solo si algo salió bien. Un bloque
       entero de filas apartadas o aisladas también es trabajo hecho, y antes se
       tiraba: `procesados` era 0, no había `setValues`, y la pasada siguiente
       empezaba de cero con las mismas filas. */
    /* [6.29] El volcado final, que también puede fallar.
       Antes se hacía siempre y sin red: si el enriquecedor ya había parado
       porque la hoja rechazaba escrituras, esto volvía a intentarlo, volvía a
       lanzar, y la excepción se llevaba por delante el resto de la función —el
       checkpoint se quedaba como estaba y, sobre todo, NADIE programaba la
       continuación—. Un fallo de escritura pasajero rompía la cadena
       automática de la ingesta y no volvía a arrancar sola. */
    if (res.tocadas > 0 && !res.falloPersistencia) {
      try {
        rango.setValues(datos);
        SpreadsheetApp.flush();
        totalProcesados += procesadosBloque;
        huboEscrituraCorrecta = true;
        logInfo("Ingesta", `Bloque ${startRow}-${endRow}: ${procesadosBloque} enriquecidos, ${res.tocadas} filas actualizadas.`);
      } catch (eVolcado) {
        logError("Ingesta", "Falló el guardado final del bloque: " + eVolcado.message);
        res.falloPersistencia = true;
        // Lo único a salvo es lo que ya estuviera volcado por el camino.
        if (!res.detenidoEn) res.detenidoEn = startRow;
      }
    }

    if (res.falloPersistencia) {
      return cerrarPorFalloDeEscritura_(props, res.detenidoEn || startRow,
        totalProcesados, silencioso, huboEscrituraCorrecta);
    }
    if (huboEscrituraCorrecta) {
      // Solo una escritura confirmada prueba que la hoja responde otra vez.
      props.deleteProperty("INGESTA_FALLOS_ESCRITURA");
      props.deleteProperty("INGESTA_DETENIDA");
    }

    duracionUltimoBloque = new Date().getTime() - arranqueBloque;

    /* Si el bloque se soltó por la mitad, el checkpoint apunta a la fila por la
       que iba, NO al final del bloque: lo contrario se saltaría en silencio las
       filas que no dio tiempo a mirar, que es peor que tardar una pasada más.
       Las ya resueltas quedan escritas porque el volcado de arriba es del
       bloque entero y las no tocadas conservan su valor original. */
    if (res.detenidoEn > 0) {
      ultimoBloque = res.detenidoEn - 1;
      startRow = res.detenidoEn;
      props.setProperty("INGESTA_CHECKPOINT", startRow.toString());
      break;
    }

    ultimoBloque = endRow;
    startRow = endRow + 1;
    props.setProperty("INGESTA_CHECKPOINT", startRow.toString());

    // Se detiene tras trabajo real o al agotar el presupuesto de tiempo.
    const tiempoAgotado = (new Date().getTime() - inicioEjecucion) > PRESUPUESTO_MS;
    if ((procesadosBloque > 0 || tiempoAgotado) && startRow <= ultFila) break;
  }

  invalidarCacheAPI();

  if (startRow > ultFila) {
    /* [6.32] Terminar la VENTANA no es terminar el catálogo, y borrar el
       checkpoint global afirma lo segundo. Hoy no se nota porque
       `actualizarTodoDesdeFila` lo restaura en su `finally`, pero eso es una
       función arreglando lo que otra estropea: en cuanto alguien llame a la
       cola con una ventana desde otro sitio, la ingesta a medias del catálogo
       se pierde sin que nadie lo vea. Se borra solo cuando de verdad no queda
       nada por recorrer; si fue una ventana, el checkpoint dice hasta dónde
       llegó. */
    if (ultFila >= ultFilaReal) props.deleteProperty("INGESTA_CHECKPOINT");
    else props.setProperty("INGESTA_CHECKPOINT", String(startRow));
    /* Cierre explícito: no queda nada pendiente, así que no puede quedar nada
       bloqueado. Aquí sí se limpia aunque no se haya escrito, porque es el fin
       del recorrido y no una vuelta más.
       [6.31] Pero solo si el recorrido llegó al final DE VERDAD. Una pasada
       acotada —«sincroniza de la 500 a la 800»— termina su ventana sin decir
       nada sobre el resto del catálogo, y dar por buena la hoja porque un trozo
       se recorrió sin trabajo es exactamente el error que se acaba de corregir
       en el contador, un piso más arriba. */
    if (ultFila >= ultFilaReal) {
      props.deleteProperty("INGESTA_FALLOS_ESCRITURA");
      props.deleteProperty("INGESTA_DETENIDA");
    }
    limpiarTriggersIngesta();
    if (!silencioso) {
      notificarUsuario(totalProcesados > 0
        ? t("toast_ingesta_bloque", { inicio: primerBloque, fin: ultimoBloque, total: totalProcesados }) + " " + t("toast_ingesta_completa")
        : t("toast_ingesta_completa"), "Ingesta", 5);
    }
    return { procesados: totalProcesados, fin: true };
  }

  programarContinuacionIngesta();
  if (!silencioso) {
    notificarUsuario(t("toast_ingesta_bloque", { inicio: primerBloque, fin: ultimoBloque, total: totalProcesados }), "Ingesta", 4);
  }
  return { procesados: totalProcesados, fin: false };
}

/**
 * [6.29] Qué hacer cuando la hoja no deja escribir.
 *
 * Lo importante no es el reintento: es que el checkpoint quede en la última
 * fila REALMENTE guardada y que la cadena siga viva. Un fallo de escritura suele
 * ser pasajero —la hoja bloqueada por otra ejecución, una cuota momentánea— y lo
 * peor que puede pasar es que la ingesta se pare para siempre sin que nadie se
 * entere, que es exactamente lo que pasaba.
 *
 * Los reintentos van contados: encadenar un disparador cada minuto contra una
 * hoja que no acepta escrituras solo sirve para llenar el registro.
 *
 * Con `<=`, la cuenta es: el fallo 1, 2 y 3 encadenan continuación; el 4.º ya
 * no. Es decir, UN intento inicial más TRES reintentos, y por eso la constante
 * se llama reintentos y no fallos — el nombre anterior decía «3 fallos» y el
 * código paraba al cuarto, que es la clase de discrepancia que luego alguien
 * cita en un informe creyendo que el código miente.
 */
const MAX_REINTENTOS_ESCRITURA_INGESTA = 3;

function cerrarPorFalloDeEscritura_(props, filaSegura, totalProcesados, silencioso,
                                    huboEscrituraCorrecta) {
  props.setProperty("INGESTA_CHECKPOINT", String(filaSegura));
  /* [6.31] La cuenta es de fallos CONSECUTIVOS. Si en esta misma pasada la hoja
     llegó a aceptar una escritura, lo de antes ya no cuenta: entre aquellos
     fallos y este hubo una que funcionó. Sin esto, «cuatro fallos seguidos» era
     en realidad «cuatro fallos, con escrituras correctas entre medias», y la
     ingesta se paraba por una hoja que estaba respondiendo. */
  if (huboEscrituraCorrecta) props.deleteProperty("INGESTA_FALLOS_ESCRITURA");
  const fallos = (parseInt(props.getProperty("INGESTA_FALLOS_ESCRITURA") || "0", 10) || 0) + 1;
  props.setProperty("INGESTA_FALLOS_ESCRITURA", String(fallos));

  if (fallos <= MAX_REINTENTOS_ESCRITURA_INGESTA) {
    logError("Ingesta", `La hoja no aceptó una escritura (reintento ${fallos} de ` +
      `${MAX_REINTENTOS_ESCRITURA_INGESTA}). Se reanudará desde la fila ${filaSegura}.`);
    programarContinuacionIngesta();
    if (!silencioso) {
      notificarUsuario(t("toast_ingesta_reintento", { fila: filaSegura }), "Ingesta", 6);
    }
    return { procesados: totalProcesados, fin: false, falloPersistencia: true, reintentando: true };
  }

  limpiarTriggersIngesta();
  logError("Ingesta", `La escritura ha fallado ${fallos} veces seguidas: se detiene la cadena. ` +
    `El checkpoint queda en la fila ${filaSegura}; arranca la ingesta a mano cuando la hoja responda.`);

  /* [6.30] Dejar constancia NO es avisar.
     Esto se para casi siempre en una ejecución automática, sin nadie delante:
     `alertarUsuario` sin interfaz solo escribe en el registro, y con
     `silencioso` ni lo intenta. O sea que el código «avisaba» a un sitio donde
     nadie mira. Ahora quedan tres rastros distintos, y ninguno depende de que
     haya alguien mirando en ese momento:
       · una propiedad que dice que la ingesta está parada y desde cuándo,
       · una fila en el panel de configuración, que es donde se mira cuando algo
         va raro,
       · y el canal de notificaciones que ya existe —webhook, Telegram o correo,
         lo que esté configurado—, que es el único que llega solo. */
  props.setProperty("INGESTA_DETENIDA", JSON.stringify({
    fila: filaSegura, fallos: fallos, cuando: new Date().toISOString(),
    motivo: "La hoja no acepta escrituras."
  }));
  try {
    notificarEvento("ingesta_detenida", { fila: filaSegura, fallos: fallos });
  } catch (eAviso) {
    logWarn("Ingesta", "No se pudo notificar la parada: " + eAviso.message);
  }
  if (!silencioso) alertarUsuario(t("err_ingesta_escritura", { fila: filaSegura }), "❌ Ingesta detenida");
  return { procesados: totalProcesados, fin: false, falloPersistencia: true, reintentando: false };
}

/** [MEJORA 2] Encadena la continuación de la ingesta con gestión centralizada de triggers. */
function programarContinuacionIngesta() {
  exigirOrigenInterno("programarContinuacionIngesta");
  const trig = registrarTriggerSeguro(
    ScriptApp.newTrigger("procesarColaConAntiTimeout_").timeBased().after(60 * 1000),
    "procesarColaConAntiTimeout_"
  );
  if (trig) {
    PropertiesService.getScriptProperties().setProperty("INGESTA_TRIGGER_ID", trig.getUniqueId());
  } else {
    logWarn("Ingesta", "No fue posible encadenar la continuación automática: ejecuta 'Continuar Ingesta' manualmente.");
  }
}

/** Reinicia el checkpoint y arranca la ingesta desde la fila 2. */
function ejecutarFase1Rapida() {
  exigirOrigenInterno("ejecutarFase1Rapida");
  limpiarTriggersIngesta();
  PropertiesService.getScriptProperties().setProperty("INGESTA_CHECKPOINT", "2");
  procesarColaConAntiTimeout_(false);
}

/** Continúa la ingesta desde el último checkpoint sin reiniciarlo. */
function continuarIngestaDesdeCheckpoint() {
  exigirOrigenInterno("continuarIngestaDesdeCheckpoint");
  const fila = PropertiesService.getScriptProperties().getProperty("INGESTA_CHECKPOINT") || "2";
  notificarUsuario(t("toast_ingesta_reanudada", { fila: fila }), "Ingesta", 3);
  procesarColaConAntiTimeout_(false);
}

/** Borra el checkpoint de ingesta y sus triggers encadenados. */
function reiniciarCheckpointIngesta() {
  exigirOrigenInterno("reiniciarCheckpointIngesta");
  PropertiesService.getScriptProperties().deleteProperty("INGESTA_CHECKPOINT");
  limpiarTriggersIngesta();
  notificarUsuario(t("toast_checkpoint_reset"), "Ingesta", 4);
}

/** Alias retrocompatible del panel móvil / menús anteriores. */
function procesarColaPorBloquesUI() {
  procesarColaConAntiTimeout_(false);
}

// -------------------------------------------------------------------------------------
// 6.3 Importación de playlists completas de YouTube
// -------------------------------------------------------------------------------------

function importarVideosDesdePlaylistUI() {
  const ui = SpreadsheetApp.getUi();
  const resp = ui.prompt("📥 Ingesta Masiva de Playlist",
    "Pega la URL completa de la playlist de YouTube o su ID:", ui.ButtonSet.OK_CANCEL);
  if (resp.getSelectedButton() !== ui.Button.OK) return;

  const playlistId = extraerIdPlaylist(resp.getResponseText().trim());
  if (!playlistId) {
    ui.alert("❌ Error", "No se pudo identificar un ID de playlist válido.", ui.ButtonSet.OK);
    return;
  }

  notificarUsuario("Consultando videos de la playlist…", "Playlist", 5);
  try {
    const total = importarPlaylistCompleta(playlistId);
    if (total > 0) {
      ui.alert("✅ Ingesta Exitosa",
        `Se agregaron ${total} videos nuevos al catálogo.\nEjecuta ahora 'Fase 1' para extraer sus metadatos.`, ui.ButtonSet.OK);
    } else {
      ui.alert("Información", "No se encontraron videos nuevos o todos ya existían en la hoja.", ui.ButtonSet.OK);
    }
  } catch (e) {
    logError("Playlist", e.message);
    ui.alert("Error importando playlist", e.message, ui.ButtonSet.OK);
  }
}

function importarPlaylistCompleta(playlistId) {
  exigirOrigenInterno("importarPlaylistCompleta");
  if (typeof YouTube === "undefined") {
    throw new Error("El servicio avanzado 'YouTube Data API v3' debe estar habilitado.");
  }
  const hoja = obtenerHojaDatos();
  asegurarColumnas(hoja, TOTAL_COLUMNAS);

  const idsExistentes = {};
  const ultimaFila = hoja.getLastRow();
  if (ultimaFila >= 2) {
    hoja.getRange(2, IDX.ID + 1, ultimaFila - 1, 1).getValues().forEach(r => {
      if (r[0]) idsExistentes[r[0].toString().trim()] = true;
    });
  }

  let nextPageToken = "";
  let filasNuevas = [];
  let insertados = 0;

  do {
    verificarCuotaDisponible(1, "YOUTUBE");
    const res = YouTube.PlaylistItems.list("snippet,contentDetails", {
      playlistId: playlistId, maxResults: 50, pageToken: nextPageToken
    });

    if (res.items && res.items.length > 0) {
      res.items.forEach(item => {
        const videoId = item.contentDetails ? item.contentDetails.videoId : (item.snippet.resourceId || {}).videoId;
        if (!videoId || idsExistentes[videoId]) return;
        const titulo = item.snippet.title;
        if (titulo === "Private video" || titulo === "Deleted video") return;

        const fila = new Array(TOTAL_COLUMNAS).fill("");
        fila[IDX.URL] = "https://www.youtube.com/watch?v=" + videoId;
        fila[IDX.ID] = videoId;
        fila[IDX.TITULO] = titulo;
        fila[IDX.FUENTE] = "YouTube";
        fila[IDX.ESTADO] = "🟡 Pendiente";
        fila[IDX.DIFICULTAD] = "Principiante";
        filasNuevas.push(fila);
        idsExistentes[videoId] = true;
      });
    }

    // [MEJORA 1] Volcado por bloques para no acumular memoria en playlists enormes.
    if (filasNuevas.length >= BATCH_TAMANO_BLOQUE) {
      hoja.getRange(hoja.getLastRow() + 1, 1, filasNuevas.length, TOTAL_COLUMNAS).setValues(filasNuevas);
      insertados += filasNuevas.length;
      filasNuevas = [];
      SpreadsheetApp.flush();
    }

    nextPageToken = res.nextPageToken;
  } while (nextPageToken);

  if (filasNuevas.length > 0) {
    hoja.getRange(hoja.getLastRow() + 1, 1, filasNuevas.length, TOTAL_COLUMNAS).setValues(filasNuevas);
    insertados += filasNuevas.length;
  }

  if (insertados > 0) {
    invalidarCacheAPI();
    logInfo("Playlist", `Insertados ${insertados} videos desde la playlist ${playlistId}.`);
  }
  return insertados;
}

// -------------------------------------------------------------------------------------
// 6.3b Expansión de contenedores que ya están DENTRO del catálogo
// -------------------------------------------------------------------------------------

/**
 * Una lista de reproducción no es un video roto: es una caja llena de videos.
 *
 * El catálogo tiene filas cuya URL es una playlist, un canal o un perfil. La
 * ingesta las trataba como videos que no responden: las reintentaba, las
 * aislaba en la DLQ y volvía a empezar, indefinidamente. «Apartar enlaces que
 * no son videos» las callaba, pero callarlas tira a la basura justo lo que el
 * administrador quería: una playlist de 60 tutoriales de Odoo es la razón por
 * la que pegó ese enlace, no un descuido.
 *
 * Esto hace lo contrario: abre la caja. Cada contenedor se sustituye por sus
 * videos como filas nuevas, y la fila del contenedor queda descartada con la
 * cuenta de lo que aportó, para que se vea que se aprovechó y no se perdió.
 *
 * Lo que NO tiene API pública que enumere (perfiles de TikTok, colecciones de
 * Vimeo) se aparta con el motivo escrito: ahí sí hay que pegar los enlaces a
 * mano, y decirlo es más honesto que reintentarlo para siempre.
 *
 * Idempotente: los videos ya presentes no se duplican y los contenedores ya
 * expandidos quedan en «⚪ Descartado», que esta pasada se salta.
 */
function expandirContenedoresDelCatalogo() {
  const hoja = obtenerHojaDatos();
  const ultima = hoja.getLastRow();
  const res = { revisadas: 0, expandidos: 0, videos: 0, apartados: 0, fallos: 0, detalle: [] };
  if (ultima < 2) return res;

  const datos = hoja.getRange(2, 1, ultima - 1, TOTAL_COLUMNAS).getValues();
  res.revisadas = datos.length;

  for (let i = 0; i < datos.length; i++) {
    const url = (datos[i][IDX.URL] || "").toString().trim();
    if (!url) continue;
    /* Solo filas que la ingesta seguiría intentando: con id y título ya es un
       video resuelto, y «Descartado» es una decisión ya tomada. */
    if ((datos[i][IDX.ID] || "").toString().trim() && (datos[i][IDX.TITULO] || "").toString().trim()) continue;
    if ((datos[i][IDX.ESTADO] || "").toString().trim() === "⚪ Descartado") continue;
    if (parsearVideoUniversal(url)) continue;

    const fila = i + 2;
    const tipo = tipoDeContenedor(url);
    if (!tipo) continue;

    if (!tipo.expandible) {
      marcarEnlaceNoProcesable(fila, tipo.motivo);
      res.apartados++;
      res.detalle.push("· " + url.slice(0, 58) + " → apartado: " + tipo.motivo);
      continue;
    }

    try {
      const traidos = expandirUnContenedor(tipo);
      res.expandidos++;
      res.videos += traidos;
      marcarEnlaceNoProcesable(fila,
        traidos > 0
          ? "Contenedor expandido: " + traidos + " videos añadidos al catálogo."
          : "Contenedor expandido: sus videos ya estaban todos en el catálogo.");
      res.detalle.push("✔ " + url.slice(0, 58) + " → " + traidos + " videos");
    } catch (e) {
      /* Un fallo aquí NO aparta la fila: apartarla escondería una playlist
         perfectamente buena por un error de cuota o una credencial ausente. */
      res.fallos++;
      res.detalle.push("✖ " + url.slice(0, 58) + " → " + e.message);
      logWarn("Expandir", "Fila " + fila + ": " + e.message);
    }
  }

  if (res.videos > 0) invalidarCacheAPI();
  return res;
}

/**
 * ¿Qué clase de contenedor es esta URL, y se puede enumerar su contenido?
 * Devuelve null si no es un contenedor.
 */
function tipoDeContenedor(url) {
  const str = (url || "").toString().trim();
  if (!str) return null;

  if (!/^https?:\/\//i.test(str)) {
    return { expandible: false, motivo: "Esto no es una URL. La celda debe llevar el enlace del video, no una nota." };
  }

  const lista = str.match(/[?&]list=([a-zA-Z0-9_-]+)/i);
  if (lista && !/[?&]v=/i.test(str)) {
    return { expandible: true, clase: "yt_playlist", ref: lista[1], url: str };
  }

  const canalId = str.match(/youtube\.com\/channel\/(UC[\w-]+)/i);
  if (canalId) return { expandible: true, clase: "yt_canal_id", ref: canalId[1], url: str };

  const handle = str.match(/youtube\.com\/@([\w.\-]+)/i);
  if (handle) return { expandible: true, clase: "yt_handle", ref: "@" + handle[1], url: str };

  const usuario = str.match(/youtube\.com\/(?:user|c)\/([\w.\-]+)/i);
  if (usuario) return { expandible: true, clase: "yt_usuario", ref: usuario[1], url: str };

  /* twitch.tv/algo y twitch.tv/algo/videos, pero nunca twitch.tv/videos/123. */
  const twitch = str.match(/twitch\.tv\/(?!videos\/)([\w]+)(?:\/videos)?\/?(?:\?.*)?$/i);
  if (twitch) return { expandible: true, clase: "twitch_canal", ref: twitch[1], url: str };

  const motivo = clasificarEnlaceNoVideo(str);
  return motivo ? { expandible: false, motivo: motivo } : null;
}

/** Trae los videos de un contenedor concreto. Devuelve cuántos se insertaron. */
function expandirUnContenedor(tipo) {
  switch (tipo.clase) {
    case "yt_playlist":
      return importarPlaylistCompleta(tipo.ref);
    case "yt_canal_id":
    case "yt_handle":
    case "yt_usuario":
      return importarPlaylistCompleta(resolverPlaylistDeSubidas(tipo));
    case "twitch_canal":
      return importarVodsDeCanalTwitch(tipo.ref);
    default:
      throw new Error("Contenedor no soportado.");
  }
}

/**
 * Traduce un canal de YouTube a su playlist de «subidas».
 *
 * Todo canal tiene una playlist implícita con todo lo que ha publicado, así que
 * expandir un canal es exactamente el mismo problema que expandir una lista una
 * vez que se conoce ese id. Se intenta por handle/usuario/id directo, y solo si
 * eso falla se recurre a la búsqueda, que cuesta 100 unidades de cuota frente a 1.
 */
function resolverPlaylistDeSubidas(tipo) {
  if (typeof YouTube === "undefined") {
    throw new Error("El servicio avanzado 'YouTube Data API v3' debe estar habilitado.");
  }
  verificarCuotaDisponible(1, "YOUTUBE");

  const params = { yt_canal_id: { id: tipo.ref },
                   yt_handle: { forHandle: tipo.ref },
                   yt_usuario: { forUsername: tipo.ref } }[tipo.clase];

  let resp = null;
  try {
    resp = YouTube.Channels.list("contentDetails", params);
  } catch (e) {
    /* `forHandle` es reciente; si esta versión del servicio avanzado no lo
       admite, la excepción no significa que el canal no exista. */
    resp = null;
  }

  let canal = resp && resp.items && resp.items[0];

  if (!canal) {
    verificarCuotaDisponible(100, "YOUTUBE");
    const busq = YouTube.Search.list("snippet", {
      q: tipo.ref.replace(/^@/, ""), type: "channel", maxResults: 1
    });
    const hallado = busq && busq.items && busq.items[0];
    const idCanal = hallado && (hallado.id.channelId || (hallado.snippet || {}).channelId);
    if (!idCanal) throw new Error("No se encontró el canal " + tipo.ref + ".");
    verificarCuotaDisponible(1, "YOUTUBE");
    const detalle = YouTube.Channels.list("contentDetails", { id: idCanal });
    canal = detalle && detalle.items && detalle.items[0];
  }

  const subidas = canal && canal.contentDetails && canal.contentDetails.relatedPlaylists
    ? canal.contentDetails.relatedPlaylists.uploads : "";
  if (!subidas) throw new Error("El canal " + tipo.ref + " no expone su lista de subidas.");
  return subidas;
}

/**
 * Trae los VODs guardados de un canal de Twitch.
 *
 * Twitch borra los VODs a los 7, 14 o 60 días según la cuenta, así que un canal
 * puede devolver cero sin que nada esté roto: simplemente ya no queda nada
 * guardado. Eso se informa como cero, no como fallo.
 */
function importarVodsDeCanalTwitch(login) {
  exigirOrigenInterno("importarVodsDeCanalTwitch");
  const clientId = proveedorApiKey("TWITCH_CLIENT_ID");
  const token = obtenerTokenTwitch();
  if (!clientId || !token) {
    throw new Error("Twitch necesita Client-ID y Client-Secret. Configúralos en «IA Multi-Modelo y Seguridad».");
  }
  const cabeceras = { "Client-ID": clientId, "Authorization": "Bearer " + token };

  verificarCuotaDisponible(1, "TWITCH");
  const ru = ejecutarFetchSeguro(URL_TWITCH_HELIX_USERS + encodeURIComponent(login),
    { method: "GET", headers: cabeceras }, "Twitch Users");
  if (!ru.ok) throw new Error("Twitch HTTP " + ru.codigo + " al resolver el canal " + login + ".");
  const usuario = (JSON.parse(ru.cuerpo).data || [])[0];
  if (!usuario) throw new Error("El canal de Twitch " + login + " no existe.");

  const hoja = obtenerHojaDatos();
  asegurarColumnas(hoja, TOTAL_COLUMNAS);
  const idsExistentes = {};
  const ultima = hoja.getLastRow();
  if (ultima >= 2) {
    hoja.getRange(2, IDX.ID + 1, ultima - 1, 1).getValues().forEach(r => {
      if (r[0]) idsExistentes[r[0].toString().trim()] = true;
    });
  }

  const nuevas = [];
  let cursor = "";
  let paginas = 0;
  do {
    verificarCuotaDisponible(1, "TWITCH");
    const r = ejecutarFetchSeguro(
      URL_TWITCH_HELIX_VIDEOS_USER + encodeURIComponent(usuario.id) + (cursor ? "&after=" + cursor : ""),
      { method: "GET", headers: cabeceras }, "Twitch Videos");
    if (!r.ok) throw new Error("Twitch HTTP " + r.codigo + " al listar los VODs de " + login + ".");
    const d = JSON.parse(r.cuerpo);
    (d.data || []).forEach(v => {
      if (!v.id || idsExistentes[v.id]) return;
      const fila = new Array(TOTAL_COLUMNAS).fill("");
      fila[IDX.URL] = PROTO + "www.twitch.tv/videos/" + v.id;
      fila[IDX.ID] = v.id;
      fila[IDX.TITULO] = v.title || "VOD Twitch";
      fila[IDX.CANAL] = v.user_name || login;
      fila[IDX.FUENTE] = "Twitch";
      fila[IDX.ESTADO] = "🟡 Pendiente";
      fila[IDX.DIFICULTAD] = "Principiante";
      nuevas.push(fila);
      idsExistentes[v.id] = true;
    });
    cursor = (d.pagination || {}).cursor || "";
    paginas++;
  } while (cursor && paginas < 20);   // tope de seguridad: 2.000 VODs

  if (nuevas.length > 0) {
    hoja.getRange(hoja.getLastRow() + 1, 1, nuevas.length, TOTAL_COLUMNAS).setValues(nuevas);
    logInfo("Twitch", "Insertados " + nuevas.length + " VODs del canal " + login + ".");
  }
  return nuevas.length;
}

