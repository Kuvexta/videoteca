   para que su desaparición NO rompa nada: si no responde, la fila entra igual y
   se pide el título a mano. Nunca se aísla como si el video estuviera roto. */
const URL_BILIBILI_VIEW = PROTO + "api.bilibili.com/x/web-interface/view?";

/* Texto con el que se marca una fila cuya plataforma no publica metadatos. El
   prefijo es estable porque la ingesta lo LEE para no reintentar la fila en cada
   pasada: sin eso, un video de Tencent se consultaría eternamente para volver a
   descubrir cada vez que no hay nada que consultar. */
const MARCA_SIN_METADATOS = "Falta el título:";

/* [v2.6.20] El segundo marcador. Hasta ahora los dos desenlaces degradados
 * compartían prefijo, y el informe acababa diciéndole al operario «solo
 * necesitan que alguien escriba el título» también sobre videos borrados. Eso
 * invita a inventarle un título a un enlace muerto, que es la peor reparación
 * posible: la fila vuelve al catálogo con aspecto de sana.
 *
 *   «Falta el título:»      la plataforma no publica metadatos (Tencent,
 *                           Bilibili caída). El video existe → escribir el
 *                           título a mano y la fila sigue su curso.
 *   «Video no disponible:»  privado, eliminado o inexistente. Un título no lo
 *                           arregla → cambiar el enlace o descartar la fila. */
const MARCA_VIDEO_NO_DISPONIBLE = "Video no disponible:";

/**
 * Qué clase de fila degradada es, mirando su nota de error.
 * Devuelve "titulo", "no-disponible" o "" si no está degradada.
 *
 * Reconoce también las filas marcadas ANTES de 6.20, cuando los dos casos
 * compartían prefijo: se distinguen por el texto que sigue. Sin esto, las filas
 * ya marcadas en la hoja se contarían para siempre como «falta el título»
 * —nadie las va a reescribir, porque la ingesta ya no las toca—.
 */
function claseDeFilaDegradada(textoError) {
  const t = (textoError || "").toString();
  if (t.indexOf(MARCA_VIDEO_NO_DISPONIBLE) === 0) return "no-disponible";
  if (t.indexOf(MARCA_SIN_METADATOS) === 0) {
    return t.indexOf("no está disponible") !== -1 ? "no-disponible" : "titulo";
  }
  return "";
}

/** ¿Esta fila ya fue degradada? Si lo fue, la ingesta no debe reintentarla. */
function esFilaDegradada(textoError) {
  return claseDeFilaDegradada(textoError) !== "";
}

/* [v2.6.13] La diferencia entre «este video no existe» y «hoy no puedo verlo».
 *
 * Hasta 6.12 esta distinción solo existía dentro de Bilibili y Tencent. El resto
 * de plataformas devolvía _error ante cualquier tropiezo, y _error significa
 * «fila rota»: reintento, reincidente, cola de fallos. En el aislamiento del
 * 10/9 eso puso 58 videos en la cola por nueve rondas de peticiones que jamás
 * podían salir bien — un enlace corto de TikTok que ya no lleva a ningún sitio
 * no lleva a ningún sitio la novena vez tampoco.
 *
 * DEFINITIVO (400, 404, 410): el servidor entendió la pregunta y contestó que
 * ese video no está. Reintentar no cambia nada. La fila entra degradada, sin
 * título, y una persona decide qué hacer con ella.
 *
 * TRANSITORIO (401, 403, 429, 5xx, timeout, JSON roto): lo que falla es nuestro
 * acceso, no el video. Aquí SÍ hay que reintentar, y sobre todo NO hay que
 * degradar: si el día que Vimeo se cae durante media hora esto degradara, el
 * catálogo se llenaría de cientos de filas sin título y el sistema informaría
 * de que todo va bien. Un incidente ruidoso es preferible a un daño callado.
 */
const CODIGOS_FALLO_DEFINITIVO = [400, 404, 410];

function esFalloDefinitivo(codigo) {
  return CODIGOS_FALLO_DEFINITIVO.indexOf(Number(codigo)) !== -1;
}

/**
 * Traduce un fallo de plataforma al resultado que le corresponde.
 * Punto único: si mañana cambia el criterio, cambia aquí y no en once sitios.
 */
function resultadoDeFallo(plataforma, codigo, mensaje) {
  if (esFalloDefinitivo(codigo)) {
    return { _sinMetadatos: true, plataforma: plataforma, httpCode: Number(codigo), mensaje: mensaje };
  }
  return { _error: true, httpCode: Number(codigo), mensaje: mensaje };
}

