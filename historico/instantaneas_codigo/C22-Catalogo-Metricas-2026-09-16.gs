/** Opciones de filtro del portal y del buscador (cacheadas 6h). */
/**
 * [OPT-1] Opciones de filtro del portal. El recorrido O(n) del catálogo solo
 * ocurre cuando la revisión cambió; si el caché expiró pero nadie tocó el
 * catálogo, se sirve el respaldo persistente sin leer una sola fila.
 */
/**
 * Opciones de filtrado del catálogo, como ÁRBOL en vez de listas sueltas.
 *
 * Antes esto devolvía cuatro listas independientes con todos los valores que
 * existen en la hoja, y el portal las pintaba tal cual. Por eso los filtros «no
 * funcionaban»: elegir un ecosistema no cambiaba nada en el desplegable de área,
 * así que se podían combinar un ecosistema y un área que no coexisten en ningún
 * video, y el resultado era una pantalla vacía sin explicación.
 *
 * [v2] La jerarquía es ECOSISTEMA → ÁREA → TEMA, y ahí termina. Cada nodo lleva
 * su conteo (`n`) para poder mostrar «Inventario (12)» y, sobre todo, para no
 * ofrecer nunca una opción que devolvería cero resultados.
 *
 * Todo lo demás queda FUERA del árbol a propósito, porque responde a preguntas
 * distintas de «¿de qué trata?»: la FUENTE es dónde está alojado el video, el
 * IDIOMA en qué se habla, la VERSIÓN y la DIFICULTAD cómo es, y las cinco
 * facetas —herramienta, industria, jurisdicción, alcance y tipo— con qué, para
 * quién, bajo qué normativa y para qué sirve. Se filtran en paralelo y se
 * combinan libremente entre sí.
 */
function obtenerFiltrosCache(forzar = false) {
  return obtenerAgregadoConRevision(CLAVE_CACHE_FILTROS, function () {
    const vacio = {
      arbol: {}, ecosistemas: [], fuentes: [], idiomas: [], modulos: [],
      herramientas: [], industrias: [], jurisdicciones: [], alcances: [], tiposContenido: [],
      dificultades: DIFICULTADES_ESTANDAR, total: 0,
      // Listas planas: las conserva quien no necesita la cascada (exportaciones,
      // el buscador de la hoja) y evita romper lo que ya las consumía.
      dominios: [], subcategorias: [], temas: [], versiones: []
    };
    const hoja = obtenerHojaDatos();
    if (hoja.getLastRow() < 2) return vacio;

    const arbol = {};
    const fuentes = {};
    const modulos = {};
    const idiomas = {};
    // [v2] Las facetas se cuentan igual que el idioma: GLOBALES, no colgando
    // del ecosistema. Quien busca «todo lo de hotelería» no quiere entrar
    // primero en Odoo — es exactamente el problema que las facetas resuelven.
    const herramientas = {}, industrias = {}, jurisdicciones = {}, alcances = {};
    const tiposContenido = {};
    const planos = { eco: {}, area: {}, tema: {}, ver: {}, dif: {} };
    let total = 0;

    function nodo(contenedor, clave) {
      if (!contenedor[clave]) contenedor[clave] = { n: 0, hijos: {} };
      contenedor[clave].n++;
      return contenedor[clave];
    }

    iterarCatalogoPorBloques(function (datos) {
      datos.forEach(r => {
        if (!r[IDX.URL] || !r[IDX.TITULO]) return;
        total++;

        const eco = (r[IDX.ECOSISTEMA] || "").toString().trim() || SIN_CLASIFICAR;
        const area = (r[IDX.AREA] || "").toString().trim() || SIN_CLASIFICAR;
        const tema = (r[IDX.TEMA] || "").toString().trim();
        const ver = (r[IDX.VERSION] || "").toString().trim();
        const dif = (r[IDX.DIFICULTAD] || "").toString().trim();

        const nEco = nodo(arbol, eco);
        const nArea = nodo(nEco.hijos, area);
        // El tema es opcional: un área sin temas es un final de rama legítimo,
        // no un hueco que haya que rellenar con "General".
        if (tema) nodo(nArea.hijos, tema);

        // Versión y dificultad cuelgan del ECOSISTEMA: las versiones de Odoo no
        // tienen nada que ver con las resoluciones de la DIAN, y mezclarlas en un
        // único desplegable es justamente lo que hacía que el filtro no sirviera.
        if (!nEco.versiones) nEco.versiones = {};
        if (!nEco.dificultades) nEco.dificultades = {};
        if (ver && ver !== "General") nEco.versiones[ver] = (nEco.versiones[ver] || 0) + 1;
        if (dif) nEco.dificultades[dif] = (nEco.dificultades[dif] || 0) + 1;

        const fuente = (r[IDX.FUENTE] || "").toString().trim() || deducirFuenteDesdeUrl(r[IDX.URL]);
        if (fuente) fuentes[fuente] = (fuentes[fuente] || 0) + 1;

        /* El idioma es GLOBAL, no cuelga del ecosistema: quien busca «lo que
           hay en inglés» lo busca en todo el catálogo, no dentro de una rama.
           Una fila sin idioma escrito cuenta como «Indeterminado» en vez de
           desaparecer del desplegable: si no aparece, nadie la corrige. */
        const idioma = (r[IDX.IDIOMA] || "").toString().trim() || IDIOMA_INDETERMINADO;
        idiomas[idioma] = (idiomas[idioma] || 0) + 1;
        const herr = (r[IDX.HERRAMIENTA] || "").toString().trim();
        if (herr) herramientas[herr] = (herramientas[herr] || 0) + 1;
        const ind = (r[IDX.INDUSTRIA] || "").toString().trim();
        if (ind && ind !== INDUSTRIA_TRANSVERSAL) industrias[ind] = (industrias[ind] || 0) + 1;
        const jur = (r[IDX.JURISDICCION] || "").toString().trim();
        if (jur && jur !== JURISDICCION_GLOBAL) jurisdicciones[jur] = (jurisdicciones[jur] || 0) + 1;
        const alc = (r[IDX.ALCANCE] || "").toString().trim();
        if (alc) alcances[alc] = (alcances[alc] || 0) + 1;
        const tipo = (r[IDX.TIPO_CONTENIDO] || "").toString().trim();
        if (tipo) tiposContenido[tipo] = (tiposContenido[tipo] || 0) + 1;
        if (r[IDX.MODULO]) modulos[r[IDX.MODULO].toString().trim()] = true;

        planos.eco[eco] = true;
        planos.area[area] = true;
        if (tema) planos.tema[tema] = true;
        if (ver && ver !== "General") planos.ver[ver] = (planos.ver[ver] || 0) + 1;
        const difFila = (r[IDX.DIFICULTAD] || "").toString().trim();
        if (difFila) planos.dif[difFila] = (planos.dif[difFila] || 0) + 1;
      });
      return false;
    });

    return {
      arbol: arbol,
      ecosistemas: Object.keys(arbol).sort(ordenarConSinClasificarAlFinal),
      fuentes: Object.keys(fuentes).sort().map(f => ({ nombre: f, n: fuentes[f] })),
      /* Ordenados por IDIOMAS_CONTENIDO y no alfabéticamente: el español va
         primero porque es el idioma de la casa, e «Indeterminado» al final
         porque es lo que hay que revisar, no una opción de igual rango. */
      idiomas: IDIOMAS_CONTENIDO.filter(c => idiomas[c])
        .map(c => ({ codigo: c, nombre: nombreIdioma(c), n: idiomas[c] }))
        .concat(Object.keys(idiomas).filter(c => IDIOMAS_CONTENIDO.indexOf(c) === -1).sort()
          .map(c => ({ codigo: c, nombre: nombreIdioma(c), n: idiomas[c] }))),
      modulos: Object.keys(modulos).sort(),
      /* [v2] Versión y Dificultad salieron del árbol, así que sus listas dejan
         de colgar del ecosistema elegido. Si siguieran colgando, elegir versión
         sin haber elegido ecosistema ofrecería una lista vacía: el filtro
         existiría en el hash pero no en la pantalla. */
      versionesGlobal: Object.keys(planos.ver).sort()
        .map(v => ({ codigo: v, nombre: v, n: planos.ver[v] })),
      dificultadesGlobal: DIFICULTADES_ESTANDAR.filter(d => planos.dif && planos.dif[d])
        .map(d => ({ codigo: d, nombre: d, n: planos.dif[d] })),
      /* Se ordenan por el vocabulario y no por frecuencia: una lista que cambia
         de orden cada vez que se reclasifica obliga a leerla entera cada vez. */
      herramientas: Object.keys(herramientas).sort()
        .map(x => ({ codigo: x, nombre: x, n: herramientas[x] })),
      industrias: INDUSTRIAS.filter(x => industrias[x])
        .map(x => ({ codigo: x, nombre: x, n: industrias[x] })),
      jurisdicciones: JURISDICCIONES.filter(x => jurisdicciones[x])
        .map(x => ({ codigo: x, nombre: x, n: jurisdicciones[x] })),
      alcances: ALCANCES.filter(x => alcances[x])
        .map(x => ({ codigo: x, nombre: x, n: alcances[x] })),
      tiposContenido: TIPOS_CONTENIDO.filter(x => tiposContenido[x])
        .map(x => ({ codigo: x, nombre: x, n: tiposContenido[x] })),
      dificultades: DIFICULTADES_ESTANDAR,
      total: total,
      // Compatibilidad con lo que ya leía listas planas.
      dominios: Object.keys(planos.eco).sort(ordenarConSinClasificarAlFinal),
      subcategorias: Object.keys(planos.area).sort(ordenarConSinClasificarAlFinal),
      temas: Object.keys(planos.tema).sort(),
      versiones: Object.keys(planos.ver).sort()
    };
  }, 21600, forzar);
}

/**
 * Resúmenes que escribieron reglas de taxonomía de versiones anteriores.
 *
 * Sin esta lista, cambiar las reglas deja el catálogo mintiendo: la fila se
 * reclasifica bien, pero conserva el resumen que le puso la regla vieja porque
 * ese texto ya no está en ninguna regla actual y `esResumenProvisional` lo toma
 * por un resumen escrito por la IA. Así es como quedaron filas de IA diciendo
