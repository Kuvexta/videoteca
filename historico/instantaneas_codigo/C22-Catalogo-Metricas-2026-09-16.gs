// =====================================================================================
// 18.1 [OPT-13] PRUEBAS DE INTEGRACIÓN — flujos completos, no funciones sueltas
// =====================================================================================
//
// Las pruebas unitarias validan piezas. Estas validan que las piezas encajen:
// crean un módulo desechable, siembran su banco, simulan un intento de punta a
// punta contra los endpoints REALES (doGet/doPost) y verifican tanto el
// resultado como que la clave nunca salga del servidor. Al terminar, borran
// todo lo que crearon.

const PREFIJO_PRUEBA = "ZZTEST_";

/** Ejecuta doPost con un payload, como lo haría un cliente HTTP. */
function simularPost(payload) {
  const e = { postData: { contents: JSON.stringify(payload || {}) } };
  return JSON.parse(doPost(e).getContent());
}

/** Ejecuta doGet con parámetros, como lo haría un cliente HTTP. */
function simularGet(params) {
  const salida = doGet({ parameter: params || {} });
  const contenido = salida.getContent();
  try { return JSON.parse(contenido); } catch (e) { return { __html: true, largo: contenido.length }; }
}

function ejecutarPruebasIntegracion() {
  const r = [];
  const ejecutar = function (fn) {
    try { r.push(fn()); } catch (e) { r.push(t("test_fallo", { prueba: "Integración", detalle: e.message })); }
  };

  const moduloId = PREFIJO_PRUEBA + "MOD";
  const examenId = PREFIJO_PRUEBA + "EXA";
  let tokenPrueba = null;
  let intentoId = null;
  let correoPrueba = "";

  try {
    // ---------- Preparación ----------
    try { correoPrueba = Session.getActiveUser().getEmail() || "prueba@local"; } catch (e) { correoPrueba = "prueba@local"; }

    ejecutar(function () {
      // Se comprueba lo que de verdad usan el menú y los disparadores: que
      // EXISTA un token admin utilizable, no que esté escrita una propiedad.
      const admin = obtenerTokenAdministrador_();
      return assert(Boolean(admin), "Hay un token de administración utilizable",
        "ejecuta primero «Administrar Tokens y Scopes API»");
    });

    ejecutar(function () {
      guardarModulo({
        id: moduloId, nombre: "Módulo de prueba automática", descripcion: "Se borra al terminar",
        rol: "QA", totalPreguntas: 4, umbralVisualizacion: 0, maxIntentos: 3, estado: "ACTIVO"
      });
      return assert(Boolean(obtenerModulo(moduloId)), "Alta de módulo de prueba");
    });

    ejecutar(function () {
      // Banco sembrado a mano: cuatro reactivos, uno de ellos trampa.
      const preguntas = [1, 2, 3, 4].map(n => normalizarPregunta({
        pregunta: `Pregunta de prueba ${n}`,
        opciones: ["Opción A", "Opción B", "Opción C", "Opción D"],
        correcta: (n - 1) % 4,
        justificacion: "SECRETO_JUSTIFICACION",
        causa_raiz: "Brecha simulada",
        riesgo_operativo: "Ninguno: es una prueba",
        severidad_riesgo: "BAJO",
        area: "QA",
        video_segundo: 60 * n,
        es_trampa_ia: n === 2,
        indice_cebo_ia: n === 2 ? 3 : -1,
        tipo_trampa: n === 2 ? TIPOS_TRAMPA[0] : ""
      }, { examenId: examenId, moduloId: moduloId, numero: n, videoId: PREFIJO_PRUEBA + "VID" }));

      guardarClavesEnSheet(examenId, PREFIJO_PRUEBA + "VID", preguntas);
      const validadas = promoverBancoAValidado(moduloId);
      return assertIgual(validadas, 4, "Banco sembrado y validado");
    });

    ejecutar(function () {
      const disponibles = leerClavesExamen({ moduloId: moduloId, soloValidadas: true });
      return assertIgual(disponibles.length, 4, "Lectura del banco tras invalidar caché");
    });

    // ---------- Sesión ----------
    ejecutar(function () {
      tokenPrueba = generarSesionCorta_(correoPrueba, 15, "exam");
      return assert(Boolean(tokenPrueba) && tokenPrueba.indexOf("sess_") === 0,
        "Emisión de sesión efímera con scope exam");
    });

    ejecutar(function () {
      return assert(validarTokenConScope(tokenPrueba, "read_only") === true,
        "El scope exam alcanza read_only (jerarquía de niveles)");
    });

    ejecutar(function () {
      let bloqueado = false;
      try { validarTokenConScope(tokenPrueba, "admin"); } catch (e) { bloqueado = true; }
      return assert(bloqueado, "El scope exam NO alcanza admin");
    });

    // ---------- Flujo del examen contra los endpoints reales ----------
    ejecutar(function () {
      const res = simularPost({ action: "intento_iniciar", token: tokenPrueba, moduloId: moduloId });
      if (res.status !== "success") throw new Error(res.message || "sin éxito");
      intentoId = res.data.intentoId;
      return assert(Boolean(intentoId) && res.data.preguntas.length === 4,
        "POST intento_iniciar entrega 4 preguntas");
    });

    ejecutar(function () {
      const res = simularPost({ action: "intento_iniciar", token: tokenPrueba, moduloId: moduloId });
      // Reabrir devuelve el MISMO intento, no uno nuevo: si no, se regalarían intentos.
      return assertIgual(res.data.intentoId, intentoId, "Reabrir devuelve el intento en curso");
    });

    ejecutar(function () {
      const crudo = JSON.stringify(simularPost({
        action: "intento_iniciar", token: tokenPrueba, moduloId: moduloId
      }));
      return assert(crudo.indexOf("SECRETO_JUSTIFICACION") === -1 &&
                    crudo.indexOf('"correcta"') === -1 &&
                    crudo.indexOf('"cebo"') === -1,
        "El endpoint nunca filtra la clave", "se encontró material sensible en la respuesta");
    });

    ejecutar(function () {
      const res = simularPost({
        action: "intento_guardar", token: tokenPrueba, intentoId: intentoId,
        respuesta: { numeroPregunta: 1, indiceElegido: 0 }
      });
      return assert(res.exito === true || res.status === "success", "POST intento_guardar acepta el avance");
    });

    ejecutar(function () {
      // Tres aciertos y una omisión → 75 %, banda «Aprobado con reservas».
      const claves = leerClavesExamen({ moduloId: moduloId, soloValidadas: true });
      const respuestas = claves.slice(0, 3).map(q => ({ numeroPregunta: q.numero, indiceElegido: q.correcta }));
      respuestas.push({ numeroPregunta: claves[3].numero, indiceElegido: -1 });

      const res = simularPost({
        action: "intento_entregar", token: tokenPrueba, intentoId: intentoId, respuestas: respuestas
      });
      if (res.status !== "success") throw new Error(res.message || "sin éxito");
      const d = res.data;
      return assert(d.aciertos === 3 && d.omisiones === 1 && d.porcentaje === 75 && d.certificado === false,
        "POST intento_entregar califica correctamente",
        `A:${d.aciertos} O:${d.omisiones} ${d.porcentaje}% certifica:${d.certificado}`);
    });

    ejecutar(function () {
      const res = simularPost({ action: "intento_entregar", token: tokenPrueba, intentoId: intentoId, respuestas: [] });
      return assert(res.status === "error", "Un intento ya entregado no se puede reentregar");
    });

    ejecutar(function () {
      const res = simularPost({ action: "notas", token: tokenPrueba });
      return assert(res.exito === true && res.registros.length >= 1,
        "POST notas devuelve el historial del propio usuario");
    });

    ejecutar(function () {
      const res = simularPost({ action: "notas", token: tokenPrueba, correo: "ajeno@ejemplo.com" });
      return assert(res.exito === false, "Un token sin admin NO puede leer notas ajenas");
    });

    ejecutar(function () {
      const res = simularGet({ token: tokenPrueba, modulo: moduloId });
      return assert(res.status === "success" && res.data.moduloId === moduloId,
        "GET ?modulo= devuelve el estado del módulo");
    });

    ejecutar(function () {
      const res = simularPost({ action: "login", email: "x@y.z" });
      return assert(res.status === "error" || res.exito === false,
        "El validador de payload rechaza un login sin contraseña");
    });

    ejecutar(function () {
      const res = simularPost({ action: "accion_que_no_existe", token: tokenPrueba });
      return assert(res.status === "error", "Una acción desconocida devuelve error, no excepción");
    });

    // ---------- Blindaje del portal [SEC-1..5] ----------
    ejecutar(function () {
      const r = apiPortal("leerClavesExamen", { token: tokenPrueba, moduloId: moduloId });
      return assert(r.ok === false && r.codigo === 403,
        "apiPortal rechaza una función fuera de la lista blanca",
        "devolvió " + JSON.stringify(r).slice(0, 120));
    });

    ejecutar(function () {
      const r = apiPortal("modulos_list", { token: tokenPrueba });
      return assert(r.ok === true && Array.isArray(r.data),
        "apiPortal sirve una acción permitida con token válido");
    });

    ejecutar(function () {
      const r = apiPortal("stats", { token: tokenPrueba });
      return assert(r.ok === false && r.codigo === 403,
        "apiPortal exige admin donde corresponde", "devolvió código " + r.codigo);
    });

    ejecutar(function () {
      const r = apiPortal("modulo_estado", { token: tokenPrueba });
      return assert(r.ok === false, "apiPortal rechaza un cuerpo sin los campos exigidos");
    });

    ejecutar(function () {
      // El correo sale de la sesión: pasarlo en el cuerpo no debe cambiar nada.
      const r = apiPortal("modulo_estado", {
        token: tokenPrueba, moduloId: moduloId, email: "ajeno@ejemplo.com"
      });
      return assert(r.ok === true && r.data.moduloId === moduloId,
        "El correo del cuerpo se ignora: manda la sesión");
    });

    ejecutar(function () {
      const r = apiPortal("informe_intento", { token: tokenPrueba, intentoId: intentoId });
      return assert(r.ok === true && r.data.forense === undefined,
        "El informe por portal NO incluye el anexo forense sin scope admin",
        "el anexo llegó al colaborador");
    });

    ejecutar(function () {
      const admin = obtenerTokenAdministrador_();
      const invitado = invitarMiembroFamilia(admin, PREFIJO_PRUEBA + "alta@ejemplo.com",
        "Alta de prueba", "member", 30);
      const canje = canjearTokenPorSesion(invitado.tokenAcceso);
      const ok = invitado.scope === "exam" &&
                 canje.email === (PREFIJO_PRUEBA + "alta@ejemplo.com").toLowerCase() &&
                 canje.token.indexOf("sess_") === 0;
      try { revocarSesionCorta_(canje.token); } catch (e) { /* ya caducó */ }
      try {
        const mapa = obtenerMapaTokens_();
        delete mapa[invitado.tokenAcceso];
        guardarMapaTokens_(mapa);
      } catch (e) { /* limpieza opcional */ }
      return assert(ok, "Alta de colaborador: scope exam y canje devuelve su correo",
        `scope ${invitado.scope}, correo ${canje.email}`);
    });

    ejecutar(function () {
      const informe = obtenerInformeIntento(intentoId, true);
      return assert(informe.hallazgos.length === 1 &&
                    informe.hallazgos[0].urlConSegundo !== undefined &&
                    informe.forense.indice === "BAJO",
        "El informe reconstruye la falencia y el índice forense",
        `hallazgos:${informe.hallazgos.length} forense:${informe.forense.indice}`);
    });

  } finally {
    // ---------- Limpieza: no se deja basura en el libro ----------
    try { if (tokenPrueba) revocarSesionCorta_(tokenPrueba); } catch (e) { /* ya expiró */ }
    try { eliminarClavesDeExamen(examenId); } catch (e) { /* nada que borrar */ }
    try { limpiarRastroPruebas(moduloId, PREFIJO_PRUEBA); } catch (e) { logWarn("Pruebas", "Limpieza parcial: " + e.message); }
  }

  const superadas = r.filter(x => x.indexOf("✅") === 0).length;
  const resumen = `${superadas}/${r.length} pruebas de integración superadas\n\n` + r.join("\n");
  logInfo("Pruebas", `Integración: ${superadas}/${r.length}.`);
  alertarUsuario(resumen, "Pruebas de Integración (" + VERSION_SCRIPT + ")");
  return { total: r.length, superadas: superadas, detalle: r };
}

/** Borra módulo, intentos, respuestas y calificaciones creados por las pruebas. */
function limpiarRastroPruebas(moduloId, prefijo) {
  exigirOrigenInterno("limpiarRastroPruebas");
  const ss = SpreadsheetApp.getActiveSpreadsheet();

  const borrarPorColumna = function (nombreHoja, columna, valor, exacto = true) {
    const sheet = ss.getSheetByName(nombreHoja);
    if (!sheet || sheet.getLastRow() < 2) return 0;
    const datos = sheet.getRange(2, columna + 1, sheet.getLastRow() - 1, 1).getValues();
    let borradas = 0;
    for (let i = datos.length - 1; i >= 0; i--) {
      const v = (datos[i][0] || "").toString().trim();
      const coincide = exacto ? v === valor : v.indexOf(valor) === 0;
      if (coincide) { sheet.deleteRow(i + 2); borradas++; }
    }
    return borradas;
  };

  borrarPorColumna("_Respuestas_Detalle", 2, moduloId);
  borrarPorColumna("_Intentos", INT.MODULO, moduloId);
  borrarPorColumna("_Historial_Calificaciones", 10, moduloId);
  borrarPorColumna("_Modulos_Fuentes", 0, moduloId);
  borrarPorColumna("_Modulos", 0, moduloId);
  borrarPorColumna("_Claves_Examenes", CLAVE.MODULO, moduloId);
  borrarPorColumna("_Tareas_Pendientes", COLA.TIPO, prefijo, false);
  borrarPorColumna("_Miembros_Familia", 0, prefijo.toLowerCase(), false);
  borrarPorColumna("_Tokens_Invitacion", 1, "FAM_DEFAULT_" + prefijo, false);
  invalidarCacheBanco(moduloId);
  logInfo("Pruebas", "Rastro de pruebas eliminado (" + moduloId + ").");
}

/** Ejecuta ambas suites en una sola pasada. */
function ejecutarTodasLasPruebas() {
  exigirOrigenInterno("ejecutarTodasLasPruebas");
  const unit = ejecutarPruebasUnitarias();
  const integ = ejecutarPruebasIntegracion();
  const total = unit.total + integ.total;
  const ok = unit.superadas + integ.superadas;
  alertarUsuario(
    `RESUMEN GLOBAL\n\n` +
    `• Unitarias:   ${unit.superadas}/${unit.total}\n` +
    `• Integración: ${integ.superadas}/${integ.total}\n` +
    `• TOTAL:       ${ok}/${total}\n\n` +
    (ok === total ? "✅ El despliegue está sano." : "⚠️ Revisa el detalle de cada suite."),
    "Suite Completa (" + VERSION_SCRIPT + ")");
  return { total: total, superadas: ok };
}

