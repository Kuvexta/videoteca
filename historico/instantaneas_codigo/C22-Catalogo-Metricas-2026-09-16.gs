// =====================================================================================
// 6. PARSER MULTIPLATAFORMA E INGESTA MASIVA POR BLOQUES — [MEJORAS 1, 9, 13]
//    Plataformas: YouTube, Vimeo, TikTok, Facebook Watch, Twitch y Dailymotion.
// =====================================================================================

function obtenerIdYouTube(url) {
  if (!url) return "";
  const m = url.toString().match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=|shorts\/|live\/))([\w-]{11})/i);
  return m ? m[1] : "";
}

function obtenerIdVimeo(url) {
  if (!url) return "";
  const m = url.toString().match(/vimeo\.com\/(?:video\/)?(\d+)/i);
  return m ? m[1] : "";
}

function obtenerIdTikTok(url) {
  if (!url) return "";
  const m = url.toString().match(/tiktok\.com\/@[\w.\-]+\/video\/(\d+)/i);
  return m ? m[1] : "";
}

/**
 * ¿Es un enlace CORTO de TikTok (`vm.tiktok.com/…`, `vt.tiktok.com/…`)?
 *
 * Es la forma que da el botón «Compartir» de la app, así que es la que pega la
 * gente. No lleva el id del video dentro —solo un código que redirige—, y por
 * eso el parser universal lo daba por «URL no reconocida» y la fila se aislaba
 * como si el video no existiera. El id se obtiene de oEmbed, que sí acepta el
 * enlace corto y devuelve `embed_product_id`.
 */
function esEnlaceCortoTikTok(url) {
  return /^https?:\/\/(?:vm|vt)\.tiktok\.com\/[\w]+/i.test((url || "").toString().trim());
}

function obtenerIdFacebook(url) {
  if (!url) return "";
  const m = url.toString().match(/(?:facebook\.com\/(?:watch\/?\?v=|video\.php\?v=|[\w.\-]+\/videos\/)|fb\.watch\/)([\w\-]+)/i);
  return m ? m[1] : "";
}

function obtenerIdTwitch(url) {
  if (!url) return "";
  const m = url.toString().match(/twitch\.tv\/(?:videos\/(\d+)|[\w]+\/(?:v|video)\/(\d+))/i);
  return m ? (m[1] || m[2]) : "";
}

function obtenerIdDailymotion(url) {
  if (!url) return "";
  const m = url.toString().match(/(?:dailymotion\.com\/video\/|dai\.ly\/)([a-zA-Z0-9]+)/i);
  return m ? m[1] : "";
}

/**
 * [MEJORA 13] Parser universal: identifica plataforma e ID desde cualquier URL soportada.
 * @return {{plataforma:string, id:string}|null}
 */
function parsearVideoUniversal(url) {
  if (!url) return null;
  const str = url.toString().trim();

  const yt = obtenerIdYouTube(str);
  if (yt) return { plataforma: "YouTube", id: yt };
  const vim = obtenerIdVimeo(str);
  if (vim) return { plataforma: "Vimeo", id: vim };
  const tik = obtenerIdTikTok(str);
  if (tik) return { plataforma: "TikTok", id: tik };
  /* Enlace corto: se reconoce la plataforma pero todavía no el video. El id
     llega al pedir los metadatos; hasta entonces `id` va vacío y `corta` marca
     que hay que resolverlo. Devolver null aquí, como antes, convertía el enlace
     que más se comparte en un error de catálogo. */
  if (esEnlaceCortoTikTok(str)) return { plataforma: "TikTok", id: "", corta: str };
  const fb = obtenerIdFacebook(str);
  if (fb) return { plataforma: "Facebook", id: fb };
  const tw = obtenerIdTwitch(str);
  if (tw) return { plataforma: "Twitch", id: tw };
  const dm = obtenerIdDailymotion(str);
  if (dm) return { plataforma: "Dailymotion", id: dm };
  const ted = obtenerIdTED(str);
  if (ted) return { plataforma: "TED", id: ted };
  const bili = obtenerIdBilibili(str);
  if (bili) return { plataforma: "Bilibili", id: bili };
  const qq = obtenerIdTencent(str);
  if (qq) return { plataforma: "Tencent Video", id: qq };

  return null;
}

/**
 * [v2.6.12] Identificador de un video de Bilibili.
 *
 * Dos numeraciones conviven: el BV («BV1xx411c7mD»), que es el actual y viaja en
 * la URL, y el av antiguo («av170001»), que sigue apareciendo en enlaces viejos.
 * Se reconocen los dos y se conserva la forma original: convertir entre ellos
 * requiere una tabla que aquí no tenemos, y adivinar produciría un id que no
 * corresponde a ningún video.
 *
 * `b23.tv` es el acortador. No trae el id, así que se devuelve como enlace corto
 * —igual que hace TikTok— en vez de rechazarlo: es la forma en que la gente
 * comparte, y tratarla como error de catálogo sería castigar el uso normal.
 */
function obtenerIdBilibili(url) {
  const str = (url || "").toString().trim();
  if (!str) return "";
  const bv = str.match(/bilibili\.com\/video\/(BV[A-Za-z0-9]+)/i);
  if (bv && bv[1]) return bv[1];
  const av = str.match(/bilibili\.com\/video\/av(\d+)/i);
  if (av && av[1]) return "av" + av[1];
  /* El acortador b23.tv no lleva el BV dentro, y resolverlo exigiría seguir el
     redirect —una petición más contra el mismo sitio que ya puede estar
     bloqueándonos—. Se le da identidad propia con el código del enlace: no sirve
     para pedir metadatos, pero SÍ es un identificador estable, que es lo que
     necesitan el resto de columnas y lo que impide que la fila se reintente para
     siempre por no tener id. Quien quiera metadatos pega el enlace largo. */
  const corto = str.match(/b23\.tv\/([A-Za-z0-9]+)/i);
  if (corto && corto[1]) return "b23_" + corto[1];
  return "";
}

/**
 * [v2.6.12] Identificador de un video de Tencent (v.qq.com).
 *
 * El «vid» aparece en dos formas de URL: la de página suelta
 * (v.qq.com/x/page/<vid>.html) y la de episodio dentro de una serie
 * (v.qq.com/x/cover/<cid>/<vid>.html). En la segunda se toma el SEGUNDO
 * identificador: el primero es la serie entera, y quedarse con él haría que
 * todos los episodios compartieran fila.
 */
function obtenerIdTencent(url) {
  const str = (url || "").toString().trim();
  if (!str) return "";
  const cover = str.match(/v\.qq\.com\/x\/cover\/[A-Za-z0-9]+\/([A-Za-z0-9]+)\.html/i);
  if (cover && cover[1]) return cover[1];
  const page = str.match(/v\.qq\.com\/x\/page\/([A-Za-z0-9]+)\.html/i);
  if (page && page[1]) return page[1];
  const vid = str.match(/[?&]vid=([A-Za-z0-9]+)/i);
  if (vid && vid[1] && /v\.qq\.com/i.test(str)) return vid[1];
  return "";
}

/**
 * [v2.6.11] Identificador de una charla de TED.
 *
 * En TED el identificador estable es el «slug» de la URL —el trozo que va
 * después de /talks/—, no un número. Se conserva ENTERO y no recortado a unos
 * pocos caracteres: los slugs empiezan por el nombre del ponente, así que dos
 * charlas de la misma persona comparten prefijo y truncarlos las fusionaría en
 * una sola fila. Un id largo no molesta a nadie; dos charlas convertidas en una
 * se descubre tarde y a mano.
 *
 * Se admite lo que la gente copia de verdad: con o sin «www», con el idioma
 * detrás (?language=es), y las subrutas /transcript y /discussion, que son la
 * misma charla vista de otra manera. El prefijo «ted_» evita que un slug choque
 * con el id de otra plataforma.
 */
function obtenerIdTED(url) {
  const str = (url || "").toString().trim();
  if (!str) return "";
  const m = str.match(/ted\.com\/talks\/([A-Za-z0-9_\-]+)/i);
  if (!m || !m[1]) return "";
  return "ted_" + m[1].toLowerCase();
}

/**
 * Explica por qué una URL no es un video, cuando no lo es.
 *
 * La cola de fallos estaba llena de cosas que nunca fueron videos: listas de
 * reproducción, canales, colecciones de Vimeo y hasta una nota que alguien
 * escribió en la celda de la URL. El sistema las trataba como videos rotos:
 * las reintentaba, las aislaba, y volvía a empezar. Un video roto se arregla;
 * un canal no se arregla nunca, porque no está roto — está mal pegado.
 *
 * Devuelve null si la URL sí parece un video (o algo que no se reconoce como
 * ninguna de estas formas), y un motivo accionable si no lo es.
 */
function clasificarEnlaceNoVideo(url) {
  const str = (url || "").toString().trim();
  if (!str) return null;

  if (!/^https?:\/\//i.test(str)) {
    return "Esto no es una URL. La celda debe llevar el enlace del video, no una nota.";
  }
  if (/[?&]list=/i.test(str) && !/[?&]v=/i.test(str)) {
    return "Es una lista de reproducción, no un video. Usa «Importar lista de reproducción» para traer sus videos.";
  }
  if (/youtube\.com\/(@|c\/|channel\/|user\/)/i.test(str) || /youtube\.com\/?$/i.test(str)) {
    return "Es un canal de YouTube, no un video. Pega el enlace de un video concreto.";
  }
  if (/tiktok\.com\/@[\w.\-]+\/?$/i.test(str)) {
    return "Es un perfil de TikTok, no un video. Abre el video y copia su enlace.";
  }
  /* [6.22] El clip. Lo trajo el export del 11/9: una sola fila, pero era la
     única de las 4.997 que acababa sin motivo propio, y el mensaje genérico le
     decía a Andrés que «no se reconoce ninguna plataforma de video en
     twitch.tv» — que es falso y además confunde: Twitch sí está soportado, lo
     que no está es el clip, que en Helix se pide por /clips y no por /videos.
     Hasta que se pida, mejor nombrarlo. */
  if (/twitch\.tv\/[\w]+\/clip\/[\w\-]+/i.test(str) || /clips\.twitch\.tv\/[\w\-]+/i.test(str)) {
    return "Es un clip de Twitch, no un VOD. Los clips todavía no se ingieren: pega el video completo (twitch.tv/videos/…) o descarta la fila.";
  }
  /* [v2.6.13] El canal a secas ya se rechazaba; sus LISTADOS no. Y lo que la
     gente copia de Twitch es justo el listado: se abre el canal, se pulsa
     «Videos» y se copia la barra de direcciones — con /videos al final y a
     menudo con ?filter=all pegado detrás. Esas cuatro URLs se reintentaron
     cuatro veces cada una y acabaron aisladas como si fueran videos rotos. */
  if (/twitch\.tv\/[\w]+(\/(videos|clips|about|schedule|collections))?\/?(\?[^#]*)?$/i.test(str)
      && !/twitch\.tv\/videos\//i.test(str)) {
    return "Es un canal de Twitch, no un video guardado. Usa «Importar canal de Twitch» para traer sus VODs, o pega el enlace de uno (twitch.tv/videos/…).";
  }
  /* [v2.6.11] TED tiene varias páginas que se parecen a una charla y no lo son.
     Se nombran una por una en vez de rechazar «todo ted.com que no sea /talks/»:
     el mensaje útil es el que dice qué pegaste y qué se hace con ello, no el que
     dice que no vale. */
  if (/ted\.com\//i.test(str) && !/ted\.com\/talks\/[A-Za-z0-9_\-]+/i.test(str)) {
    if (/ted\.com\/playlists?\//i.test(str)) {
      return "Es una lista de TED, no una charla. Abre las charlas que te interesen y pega sus enlaces.";
    }
    if (/ted\.com\/(speakers|people)\//i.test(str)) {
      return "Es la ficha de un ponente de TED, no una charla. Pega el enlace de una charla concreta.";
    }
    if (/ted\.com\/(podcasts|series|read|about|attend|membership)/i.test(str)) {
      return "Es una sección de TED que no es una charla en video.";
    }
    return "Es una página de TED que no es una charla. El enlace de una charla es ted.com/talks/…";
  }
  /* [v2.6.12] Bilibili y Tencent: sus páginas de canal, lista y serie se parecen
     mucho a las de un video, y sin esto acabarían en la cola de fallos como si
     el video estuviera roto. */
  if (/bilibili\.com\/(space|bangumi|festival)\//i.test(str)) {
    return "Es un canal, serie o evento de Bilibili, no un video. Abre el video y copia su enlace (bilibili.com/video/BV…).";
  }
  if (/bilibili\.com\//i.test(str) && !/bilibili\.com\/video\//i.test(str)) {
    return "Es una página de Bilibili que no es un video. El enlace de un video lleva /video/BV… dentro.";
  }
  if (/v\.qq\.com\//i.test(str) && !/v\.qq\.com\/x\/(page|cover)\//i.test(str) && !/[?&]vid=/i.test(str)) {
    return "Es una página de Tencent Video que no es un video concreto. El enlace de un video lleva /x/page/… o /x/cover/…/….html";
  }
  if (/vimeo\.com\/[\w-]+\/[\w-]+/i.test(str) && !/vimeo\.com\/\d+/.test(str)) {
    return "Es una colección de Vimeo, no un video. Abre el video y copia su enlace.";
  }
  /* [v2.6.15] Las familias que de verdad hay en el catálogo. No son casos
     hipotéticos: 3.786 filas son fichas del app store de Odoo, 81 son repos de
     GitHub y unas cuantas son documentos de Drive. Nunca fueron videos, nunca
     lo van a ser, y hasta ahora entraban por la puerta de «URL no reconocida»,
     que reintenta. Se nombran por separado porque el mensaje útil es el que
     dice QUÉ pegaste — «es una ficha del app store» se entiende; «no
     reconocida por el parser universal» no le dice nada a nadie. */
  if (/apps\.odoo\.com/i.test(str)) {
    return "Es una ficha del app store de Odoo, no un video. Si querías guardar el módulo, va en otra hoja, no en la videoteca.";
  }
  if (/(^|\/\/)(www\.)?odoo\.com\/(documentation|slides|r\/)/i.test(str)) {
    return "Es documentación o una página de Odoo, no un video. Si es un curso de Odoo eLearning, pega el enlace del video concreto.";
  }
  if (/(github|gitlab)\.com|readthedocs\.io/i.test(str)) {
    return "Es un repositorio o documentación de código, no un video.";
  }
  if (/(drive|docs)\.google\.com/i.test(str)) {
    return "Es un archivo de Google Drive, no un video de una plataforma. Usa «Importar carpeta de Drive» si quieres traer videos alojados ahí.";
  }
  return null;
}

/**
 * [v2.6.15] El motivo para una URL que el parser no sabe abrir y que tampoco
 * cae en ninguna de las formas nombradas arriba.
 *
 * Que el parser no la reconozca es un hecho comprobado, no un fallo pasajero:
 * la lista de plataformas está en el propio código y no cambia entre un
 * intento y el siguiente. Reintentar tres veces era pura ceremonia. El mensaje
 * nombra el dominio porque es lo único que permite decidir qué hacer: si es una
 * plataforma que deberíamos soportar, se añade; si no, la fila se descarta.
 */
function motivoUrlNoIngerible(url) {
  const str = (url || "").toString().trim();
  let dominio = "";
  const m = str.match(/^https?:\/\/(?:www\.)?([^\/?#]+)/i);
  if (m) dominio = m[1];
  return dominio
    ? "No se reconoce ninguna plataforma de video en «" + dominio + "». Si es una plataforma que deberíamos soportar, dilo; si no, descarta la fila."
    : "No se reconoce ninguna plataforma de video en este enlace.";
}

function extraerIdPlaylist(urlOId) {
  if (!urlOId) return null;
  const texto = urlOId.toString().trim();
  const match = texto.match(/[?&]list=([a-zA-Z0-9_-]+)/i);
  if (match) return match[1];
  if (/^[a-zA-Z0-9_-]{18,42}$/.test(texto)) return texto;
  return null;
}

function convertirDuracionAMinutos(isoDuration) {
  if (!isoDuration) return 0;
  const match = isoDuration.toString().match(/PT(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?/);
  if (!match) return 0;
  const horas = parseInt(match[1] || 0, 10);
  const minutos = parseInt(match[2] || 0, 10);
  const segundos = parseInt(match[3] || 0, 10);
  return Number(((horas * 60) + minutos + (segundos / 60)).toFixed(2));
}

function traducirCategoriaYouTube(c) {
  const categorias = {
    "1": "Películas", "2": "Autos y vehículos", "10": "Música", "17": "Deportes",
    "19": "Viajes y eventos", "20": "Videojuegos", "22": "Blogs", "23": "Comedia",
    "24": "Entretenimiento", "25": "Noticias y política", "26": "Estilo y tutoriales",
    "27": "Educación", "28": "Ciencia y tecnología"
  };
  return categorias[c] || "Educación y Tecnología";
}

/**
 * Normaliza el resultado HTTP de cualquier proveedor externo.
 * [MEJORA 9] Nunca lanza excepción: devuelve el código para decidir aislamiento en DLQ.
 */
function ejecutarFetchSeguro(url, opciones, servicio) {
  exigirOrigenInterno("ejecutarFetchSeguro");
  const options = Object.assign({ muteHttpExceptions: true }, opciones || {});
  try {
    const res = UrlFetchApp.fetch(url, options);
    const codigo = res.getResponseCode();
    const cuerpo = res.getContentText();
    let cabeceras = {};
    try { cabeceras = res.getHeaders() || {}; } catch (e) { /* respuesta sin cabeceras */ }
    return { ok: codigo >= 200 && codigo < 300, codigo: codigo, cuerpo: cuerpo,
             cabeceras: cabeceras, servicio: servicio };
  } catch (e) {
    logWarn("HTTP", `Fallo de red en ${servicio}: ${e.message}`);
    return { ok: false, codigo: 0, cuerpo: "", cabeceras: {}, servicio: servicio, error: e.message };
  }
}

/**
 * Convierte un enlace corto de TikTok en el enlace completo del video.
 *
 * El oEmbed de TikTok NO acepta los enlaces `vm.tiktok.com`: responde 400. Y
 * 400 no es terminal, así que la fila se reintentaba tres veces y acababa en la
 * cola de fallos —cuatro entradas de «TikTok HTTP 400» en la DLQ eran justo
 * esto—. El enlace corto no está roto: solo hay que seguir su redirección y
 * pedir el oEmbed de la URL de verdad.
 *
 * Se siguen los saltos a mano (`followRedirects:false`) porque lo que hace
 * falta es la URL de destino, y siguiéndolos automáticamente no se puede leer.
 */
const TIKTOK_MAX_SALTOS = 4;

function resolverEnlaceCortoTikTok(url) {
  let actual = (url || "").toString().trim();
  if (!actual) return "";
  for (let i = 0; i < TIKTOK_MAX_SALTOS; i++) {
    const r = ejecutarFetchSeguro(actual, { method: "GET", followRedirects: false }, "TikTok redirección");
    if (r.codigo < 300 || r.codigo >= 400) break;
    const destino = r.cabeceras["Location"] || r.cabeceras["location"] || "";
    if (!destino) break;
    actual = destino.toString();
    if (obtenerIdTikTok(actual)) return actual.split("?")[0];
  }
  return obtenerIdTikTok(actual) ? actual.split("?")[0] : "";
}

/** Deduce el código HTTP a partir del texto de una excepción del servicio avanzado. */
function deducirCodigoHttpDesdeError(mensaje) {
  const txt = (mensaje || "").toString();
  /* [v2.6.20] Si el mensaje trae un código explícito, ese manda — cualquier
     4xx o 5xx, no solo los cinco que estaban enumerados. Antes, un 410 o un 503
     escritos en la excepción se colapsaban a 500, y el diagnóstico decía «error
     del servidor» sobre un recurso que el proveedor declaraba desaparecido.
     Se busca el código como palabra suelta para no confundirlo con un id o una
     fecha que lleve tres cifras dentro. */
  const explicito = txt.match(/(^|[^0-9])([45][0-9]{2})([^0-9]|$)/);
  if (explicito) return Number(explicito[2]);
  /* Sin código, se deduce del texto. Estos patrones son los que de verdad
     aparecen en los mensajes de las APIs que se consultan. */
  if (/quota|forbidden|permission/i.test(txt)) return 403;
  if (/not found/i.test(txt)) return 404;
  if (/rate|exhausted/i.test(txt)) return 429;
  return 500;
}

