/**
 * Buscador multi-criterio en tiempo real.
 *
 * Tenía los dos fallos del panel a la vez, y por eso no servía:
 *
 *  1. Las columnas del catálogo estaban escritas a mano DENTRO de la cadena de
 *     la fórmula (`B2:C`, `G2:G`, `U2:U`). Tras la reordenación del esquema esas
 *     letras apuntan a otra cosa: `G` es Tema y no Versión, `K` es Módulo y no
 *     Duración, `U` es Recursos y no Dificultad, y `R` es Likes y no el texto
 *     donde se buscaba. La fórmula seguía devolviendo filas —con las columnas
 *     equivocadas— sin dar ningún error, que es la forma más cara de fallar.
 *  2. Todas las comas eran literales. En una hoja cuyo separador de argumentos
 *     es «;» la fórmula ni siquiera se analiza, y encima las comas de dentro del
 *     array literal `{a,b}` son separadores de COLUMNA, que no es lo mismo.
 *
 * Ahora cada letra sale de IDX igual que en el panel, y los dos separadores se
 * escriben con los símbolos § (argumentos) y ¦ (columnas del array) que traduce
 * formulaLocal() al idioma real de la hoja.
 */
function generarPestanaBuscador() {
  exigirOrigenInterno("generarPestanaBuscador");
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const nombre = obtenerHojaDatos().getName();
  const bus = ss.getSheetByName("Buscador") || ss.insertSheet("Buscador", 1);
  bus.clear();
  bus.activate();

  const sep = separadorDeFormulas(bus);
  const col = function (indice) { return letraColumna(indice + 1); };
  const rango = function (indice) { return "'" + nombre + "'!" + col(indice) + "2:" + col(indice); };

  bus.getRange("A1:G1").merge().setValue("🔍 BUSCADOR MULTI-CRITERIO EN TIEMPO REAL")
    .setFontSize(14).setFontWeight("bold").setBackground("#1e3a8a").setFontColor("#ffffff");

  bus.getRange("A3").setValue("Texto / Tag:").setFontWeight("bold");
  bus.getRange("C3").setValue("Ecosistema:").setFontWeight("bold");
  bus.getRange("E3").setValue("Dificultad:").setFontWeight("bold");
  bus.getRange("B3").setValue("");
  bus.getRange("D3").setValue("");
  bus.getRange("F3").setValue("");

  const fc = obtenerFiltrosCache();
  // `dominios` es el alias histórico de `ecosistemas`; se prefiere el nombre actual.
  const ecosistemas = fc.ecosistemas || fc.dominios || [];
  if (ecosistemas.length > 0) {
    bus.getRange("D3").setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(ecosistemas, true).build());
  }
  bus.getRange("F3").setDataValidation(
    SpreadsheetApp.newDataValidation().requireValueInList(DIFICULTADES_ESTANDAR, true).build()
  );

  /* Los rótulos y el orden del array literal se generan de la MISMA lista, para
     que no puedan volver a discrepar: antes la cabecera decía «Duración» encima
     de la columna Módulo. */
  const COLUMNAS = [IDX.ID, IDX.TITULO, IDX.ECOSISTEMA, IDX.VERSION, IDX.DURACION, IDX.DIFICULTAD, IDX.URL];
  bus.getRange(5, 1, 1, COLUMNAS.length).setValues([COLUMNAS.map(i => CABECERAS_CATALOGO[i])])
    .setFontWeight("bold").setBackground("#374151").setFontColor("#ffffff");

  // El buscador de texto mira título, resumen y tags: es lo que promete el rótulo.
  const buscables = [IDX.TITULO, IDX.RESUMEN, IDX.TAGS];
  const formula =
    `=IFERROR(FILTER({${COLUMNAS.map(rango).join("¦ ")}}§ ` +
    `(${rango(IDX.ID)}<>"") * ` +
    `(IF(B3=""§ 1§ ` +
      buscables.map(i => `ISNUMBER(SEARCH(B3§ ${rango(i)}))`).join(" + ") + `)) * ` +
    `(IF(D3=""§ 1§ ${rango(IDX.ECOSISTEMA)}=D3)) * ` +
    `(IF(F3=""§ 1§ ${rango(IDX.DIFICULTAD)}=F3)))§ "Sin coincidencias")`;

  bus.getRange("A6").setFormula(formulaLocal(formula, sep));
  bus.autoResizeColumns(1, 7);
  notificarUsuario("Buscador listo para consultas.", "Buscador", 3);
}

function saltarAFilaDesdeBuscador() {
  exigirOrigenInterno("saltarAFilaDesdeBuscador");
  const bus = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Buscador");
  if (!bus) return;
  const fila = bus.getActiveCell().getRow();
  if (fila < 6) { notificarUsuario("Selecciona una fila de resultados.", "Buscador", 3); return; }

  const idVideo = bus.getRange(fila, 1).getValue().toString().trim();
  if (!idVideo) return;

  const hojaCat = obtenerHojaDatos();
  const ids = hojaCat.getRange(2, IDX.ID + 1, Math.max(1, hojaCat.getLastRow() - 1), 1).getValues().flat();
  const targetIdx = ids.indexOf(idVideo);
  if (targetIdx !== -1) {
    hojaCat.activate();
    hojaCat.setActiveRange(hojaCat.getRange(targetIdx + 2, 1));
  } else {
    notificarUsuario("Video no encontrado en la hoja principal.", "Aviso", 3);
  }
}

