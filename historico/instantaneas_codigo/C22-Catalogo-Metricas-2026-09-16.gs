    return false;
  }
}

/** Envía un evento a Google Analytics 4 mediante Measurement Protocol. */
function enviarEventoGA4(nombreEvento, parametros) {
  const props = PropertiesService.getScriptProperties();
  const mid = props.getProperty("GA4_MEASUREMENT_ID");
  const secret = props.getProperty("GA4_API_SECRET");
  if (!mid || !secret) return { exito: false };

  const r = ejecutarFetchSeguro(
    URL_GA4_COLLECT + "?measurement_id=" + encodeURIComponent(mid) + "&api_secret=" + encodeURIComponent(secret), {
      method: "POST",
      contentType: "application/json",
      payload: JSON.stringify({
        client_id: Utilities.getUuid(),
        events: [{ name: nombreEvento, params: parametros || {} }]
      })
    }, "GA4");
  return { exito: r.ok };
}

// -------------------------------------------------------------------------------------
// 10.X SIGUIENTE PASO, ESTADÍSTICAS Y RESUMEN LLANO DEL INFORME
//
//      Las tres responden a la misma idea: DECIDIR EN EL SERVIDOR.
//      El portal es una capa de pintado; si tuviera que deducir «¿puedo ya
//      presentar el examen?» a partir de siete campos sueltos, cada cambio de
//      política habría que replicarlo en el HTML y acabarían divergiendo lo que
//      el sistema permite y lo que la pantalla ofrece. Aquí se calcula una vez.
// -------------------------------------------------------------------------------------

/**
 * Prioridades del siguiente paso. Menor número = antes.
 * Viven en una constante y no como números sueltos porque el orden ES la regla
 * pedagógica: primero se repasa lo que ya se falló, y solo después se avanza.
 */
const PASO_PRIORIDAD = {
  refuerzo_pendiente: 1,
  examen_disponible: 2,
  seguir_viendo: 3,
  esperar_plazo: 4,
  todo_al_dia: 5
};

/**
 * Corte a partir del cual un área se considera dominada.
 *
 * No se inventa un 80 nuevo: se toma de ESCALA_DESEMPENO, la banda más baja que
 * todavía certifica. Si mañana la política sube el listón para certificar, «lo
 * que dominas» sube con ella y no queda un número huérfano contradiciéndola.
 */
function umbralAreaDominada() {
  let umbral = 100;
  ESCALA_DESEMPENO.forEach(function (banda) {
    if (banda.certifica && banda.min < umbral) umbral = banda.min;
  });
  return umbral;
}

/** Ruta del portal hacia los videos de un módulo concreto. */
function hashCatalogoModulo(moduloId) {
  return moduloId ? "#/catalogo?mod=" + encodeURIComponent(moduloId) : "#/catalogo";
}

/**
 * Qué debe hacer AHORA el colaborador, ya resuelto.
 *
 * Reutiliza las funciones que ya conocen cada mitad del problema
 * (obtenerTareasRefuerzoUsuario, obtenerModulosUsuario —que por dentro llama a
 * obtenerEstadoModuloUsuario por módulo— y buscarCalificacionesEstudiante) en
 * vez de releer las hojas: así el motivo del bloqueo que ve el colaborador es
 * exactamente el mismo que aplica el servidor al intentar abrir el examen.
 *
 * @return {{tipo:string, titulo:string, detalle:string, accion:string,
 *           moduloId:string, hash:string, prioridad:number, otros:Array}}
 */
function obtenerSiguientePaso(token) {
  validarTokenConScope(token, "read_only");

  // Cada candidato lleva un `peso` de desempate que NO viaja al portal: dos
  // pasos de la misma prioridad se ordenan por urgencia real (plazo más
  // cercano, menos videos por ver), no por el orden en que se leyó la hoja.
  const candidatos = [];
  const anadir = function (paso, peso) { candidatos.push({ paso: paso, peso: peso || 0 }); };

  let modulos = [];
  try { modulos = obtenerModulosUsuario(token) || []; } catch (e) { modulos = []; }

  // 1. Refuerzos pendientes, agrupados por módulo.
  //    Uno por tarea saturaría la lista con quince entradas del mismo módulo;
  //    lo accionable es «vuelve a ese módulo», no «mira este segundo exacto».
  try {
    const porModulo = {};
    (obtenerTareasRefuerzoUsuario(token) || []).forEach(function (tarea) {
      const mod = (tarea.modulo || "").toString().trim();
      if (!porModulo[mod]) porModulo[mod] = [];
      porModulo[mod].push(tarea);
    });
    Object.keys(porModulo).forEach(function (mod) {
      const tareas = porModulo[mod];
      const modulo = obtenerModulo(mod);
      const nombre = modulo ? modulo.nombre : (mod || "tu último examen");
      // El concepto se guardó como "Área: texto de la pregunta"; al colaborador
      // solo le sirve la parte de delante.
      const primerConcepto = (tareas[0].concepto || "").toString().split(":")[0].trim();
      anadir({
        tipo: "refuerzo_pendiente",
        titulo: tareas.length === 1
          ? "Repasa «" + (primerConcepto || "el punto que fallaste") + "» de " + nombre
          : "Tienes " + tareas.length + " repasos pendientes de " + nombre,
        detalle: "Cada repaso te lleva al minuto exacto del video donde se explica lo que fallaste" +
                 (tareas.length === 1 ? "." : ", y son " + tareas.length + " en total."),
        accion: "Ver los videos de repaso",
        moduloId: mod,
        hash: hashCatalogoModulo(mod),
        prioridad: PASO_PRIORIDAD.refuerzo_pendiente
      }, -tareas.length);   // más repasos acumulados, más urgente
    });
  } catch (e) { /* sin plan de refuerzo: no es motivo para dejar al portal sin respuesta */ }

  // 2..4. Un paso por módulo, según lo que el propio servidor ya decidió.
  modulos.forEach(function (m) {
    if (m.examenAprobado) return;   // certificado: no hay nada que pedirle

    if (m.puedeIniciar) {
      const abierto = Boolean(m.intentoEnCurso);
      anadir({
        tipo: "examen_disponible",
        titulo: abierto
          ? "Retoma el examen de " + m.nombre + ", lo dejaste a medias"
          : "Ya puedes presentar el examen de " + m.nombre,
        detalle: abierto
          ? "Tienes un intento abierto: si no lo entregas, caduca solo y consume el intento igual."
          : "Has visto " + m.videosVistos + " de " + m.videosRequeridos + " videos requeridos" +
            ". Te quedan " + Math.max(m.maxIntentos - m.intentosUsados, 0) +
            " de " + m.maxIntentos + " intentos.",
        accion: abierto ? "Continuar el examen" : "Presentar el examen",
        moduloId: m.moduloId,
        hash: "#/modulos",
        prioridad: PASO_PRIORIDAD.examen_disponible
      }, abierto ? -1 : pesoPorPlazo(m.deadline));
      return;
    }

    if (m.motivoBloqueo === "falta_visualizacion") {
      const faltan = Math.max(m.videosRequeridos - m.videosVistos, 1);
      anadir({
        tipo: "seguir_viendo",
        titulo: "Te falta" + (faltan === 1 ? " 1 video" : "n " + faltan + " videos") +
                " para abrir el examen de " + m.nombre,
        detalle: "Has visto " + m.videosVistos + " de " + m.videosRequeridos +
                 " videos requeridos (el módulo tiene " + m.totalVideos + ").",
        accion: "Seguir viendo",
        moduloId: m.moduloId,
        hash: hashCatalogoModulo(m.moduloId),
        prioridad: PASO_PRIORIDAD.seguir_viendo
      }, faltan);   // el que está más cerca de desbloquearse va primero
      return;
    }

    // Bloqueos que el colaborador NO puede resolver solo. Se muestran igual:
    // un módulo que desaparece de la lista sin explicación se lee como un fallo.
    if (m.motivoBloqueo === "plazo_vencido") {
      anadir({
        tipo: "esperar_plazo",
        titulo: "El plazo de " + m.nombre + " ya venció",
        detalle: "La fecha límite era el " + (m.deadline || "una fecha ya pasada") +
                 ". Pide a tu responsable de formación que lo reabra.",
        accion: "Ver el estado del módulo",
        moduloId: m.moduloId,
        hash: "#/modulos",
        prioridad: PASO_PRIORIDAD.esperar_plazo
      }, 0);
    } else if (m.motivoBloqueo === "intentos_agotados") {
      anadir({
        tipo: "esperar_plazo",
        titulo: "Agotaste los " + m.maxIntentos + " intentos de " + m.nombre,
        detalle: "Tu mejor resultado fue " + m.ultimoPorcentaje +
                 "%. Pide a tu responsable de formación un intento adicional.",
        accion: "Ver mis notas",
        moduloId: m.moduloId,
        hash: "#/notas",
        prioridad: PASO_PRIORIDAD.esperar_plazo
      }, 1);
    } else if (m.motivoBloqueo === "banco_incompleto") {
      anadir({
        tipo: "esperar_plazo",
        titulo: "El examen de " + m.nombre + " todavía no está listo",
        detalle: "Hay " + m.preguntasDisponibles + " preguntas preparadas de las " +
                 m.totalPreguntas + " que necesita. No depende de ti: mientras tanto puedes ir viendo los videos.",
        accion: "Ver los videos del módulo",
        moduloId: m.moduloId,
        hash: hashCatalogoModulo(m.moduloId),
        prioridad: PASO_PRIORIDAD.esperar_plazo
      }, 2);
    }
  });

  // 5. Nada pendiente. Se distingue «no tienes módulos» de «los tienes todos
  //    certificados»: al recién llegado no se le puede felicitar por un trabajo
  //    que no ha hecho, ni inventarle tareas que nadie le asignó.
  if (candidatos.length === 0) {
    if (modulos.length === 0) {
      return Object.assign(pasoSinModulos(), { otros: [] });
    }
    let resumen = { evaluaciones: 0, promedio: 0 };
    try {
      const cal = buscarCalificacionesEstudiante(token);
      if (cal && cal.resumen) resumen = cal.resumen;
    } catch (e) { /* sin historial: el mensaje funciona igual */ }

    return {
      tipo: "todo_al_dia",
      titulo: "Estás al día: no tienes nada pendiente",
      detalle: "Tienes certificados los " + modulos.length +
               (modulos.length === 1 ? " módulo asignado" : " módulos asignados") +
               (resumen.evaluaciones > 0
                 ? ", con un promedio de " + resumen.promedio + "% en " + resumen.evaluaciones +
                   (resumen.evaluaciones === 1 ? " evaluación." : " evaluaciones.")
                 : "."),
      accion: "Ver mis notas",
      moduloId: "",
      hash: "#/notas",
      prioridad: PASO_PRIORIDAD.todo_al_dia,
      otros: []
    };
  }

  candidatos.sort(function (a, b) {
    return (a.paso.prioridad - b.paso.prioridad) || (a.peso - b.peso);
  });

  const principal = candidatos[0].paso;
  return Object.assign({}, principal, {
    otros: candidatos.slice(1, 4).map(function (c) { return c.paso; })
  });
}

/** Paso de bienvenida cuando todavía no hay ningún módulo que hacer. */
function pasoSinModulos() {
  return {
    tipo: "todo_al_dia",
    titulo: "Todavía no tienes módulos asignados",
    detalle: "Cuando tu responsable de formación te asigne uno aparecerá aquí. " +
             "Mientras tanto puedes explorar el catálogo libremente.",
    accion: "Explorar el catálogo",
    moduloId: "",
    hash: "#/catalogo",
    prioridad: PASO_PRIORIDAD.todo_al_dia
  };
}

/**
 * Desempate por cercanía del plazo: días que faltan, y un valor alto cuando no
 * hay fecha. Un módulo que vence el viernes tiene que salir antes que uno sin
 * fecha aunque los dos estén igual de disponibles.
 */
function pesoPorPlazo(deadline) {
  if (!deadline) return 9999;
  const limite = new Date(deadline);
  if (isNaN(limite.getTime())) return 9999;
  return Math.round((limite.getTime() - Date.now()) / 86400000);
}

/**
 * Progreso acumulado del colaborador para la pantalla «Mis notas».
 *
 * Se apoya en buscarCalificacionesEstudiante, que ya deriva el correo del token
 * y nunca acepta uno ajeno; aquí solo se agrega. Todos los campos tienen valor
 * incluso sin un solo intento: una pantalla que recibe null tiene que decidir
 * qué pintar, y esa decisión ya la tomamos aquí.
 *
 * @return {{modulosTotales:number, modulosCertificados:number, modulosPendientes:number,
 *           promedioGeneral:number, mejorNota:number, ultimaNota:number,
 *           nivelGeneral:string, historial:Array, porModulo:Array}}
 */
function obtenerEstadisticasUsuario(token) {
  validarTokenConScope(token, "read_only");

  let modulos = [];
  try { modulos = obtenerModulosUsuario(token) || []; } catch (e) { modulos = []; }
  const nombresModulo = {};
  modulos.forEach(function (m) { nombresModulo[m.moduloId] = m.nombre; });

  let registros = [];
  try {
    const cal = buscarCalificacionesEstudiante(token);
    if (cal && cal.exito && cal.registros) registros = cal.registros;
  } catch (e) { registros = []; }

  const vacio = {
    modulosTotales: modulos.length,
    modulosCertificados: 0,
    modulosPendientes: modulos.length,
    promedioGeneral: 0,
    mejorNota: 0,
    ultimaNota: 0,
    // Cadena vacía, no "No aprobado": quien no se ha presentado no está
    // reprobado, y el portal necesita poder distinguir ambos casos.
    nivelGeneral: "",
    historial: [],
    porModulo: []
  };
  if (registros.length === 0) return vacio;

  // buscarCalificacionesEstudiante devuelve de más reciente a más antiguo; la
  // línea temporal se dibuja al revés, así que se ordena ascendente una vez.
  const orden = registros.slice().sort(function (a, b) {
    return (a.fecha || "").localeCompare(b.fecha || "");
  });

  const historial = orden.map(function (r) {
    return {
      fecha: r.fecha || "",
      moduloId: r.moduloId || "",
      modulo: nombresModulo[r.moduloId] || r.evaluacion || r.moduloId || "Evaluación",
      porcentaje: r.porcentaje || 0,
      nivel: r.nivel || resolverNivelDesempeno(r.porcentaje || 0).nivel
    };
  });

  // Agrupado por módulo. Las calificaciones antiguas de Google Forms no traen
  // Modulo_Id; se agrupan por el nombre de la evaluación en vez de descartarlas,
  // que para el colaborador siguen siendo notas suyas.
  const acumulado = {};
  const clavesOrdenadas = [];
  orden.forEach(function (r) {
    const clave = (r.moduloId || r.evaluacion || "otras").toString();
    if (!acumulado[clave]) {
      acumulado[clave] = {
        moduloId: r.moduloId || "",
        modulo: nombresModulo[r.moduloId] || r.evaluacion || r.moduloId || "Evaluación",
        intentos: 0, mejorPorcentaje: 0, ultimoPorcentaje: 0
      };
      clavesOrdenadas.push(clave);
    }
    const acc = acumulado[clave];
    acc.intentos++;
    if ((r.porcentaje || 0) > acc.mejorPorcentaje) acc.mejorPorcentaje = r.porcentaje || 0;
    acc.ultimoPorcentaje = r.porcentaje || 0;   // el recorrido es ascendente: gana el último
  });

  const porModulo = clavesOrdenadas.map(function (clave) {
    const acc = acumulado[clave];
    // El nivel del módulo se lee del MEJOR intento, que es el que certifica:
    // un tercer intento peor no puede quitar lo que el segundo ya acreditó.
    const escala = resolverNivelDesempeno(acc.mejorPorcentaje);
    return {
      moduloId: acc.moduloId,
      modulo: acc.modulo,
      intentos: acc.intentos,
      mejorPorcentaje: acc.mejorPorcentaje,
      ultimoPorcentaje: acc.ultimoPorcentaje,
      nivel: escala.nivel,
      certificado: escala.certifica
    };
  });

  let suma = 0;
  let mejor = 0;
  registros.forEach(function (r) {
    suma += r.porcentaje || 0;
    if ((r.porcentaje || 0) > mejor) mejor = r.porcentaje || 0;
  });
  const promedio = parseFloat((suma / registros.length).toFixed(1));
  const certificados = porModulo.filter(function (p) { return p.certificado; }).length;

  return {
    modulosTotales: Math.max(modulos.length, porModulo.length),
    modulosCertificados: certificados,
    modulosPendientes: Math.max(Math.max(modulos.length, porModulo.length) - certificados, 0),
    promedioGeneral: promedio,
    mejorNota: mejor,
    ultimaNota: orden[orden.length - 1].porcentaje || 0,
    nivelGeneral: resolverNivelDesempeno(promedio).nivel,
    historial: historial,
    porModulo: porModulo
  };
}

/**
 * Traduce el informe de auditoría a lenguaje de persona.
 *
 * El informe está escrito para quien audita: causa raíz, riesgo operativo,
 * severidad, índice forense. Eso es imprescindible para el responsable de
 * formación e inútil —cuando no desmoralizante— para quien acaba de examinarse.
 * Esta función no resume con IA a propósito: se calcula de los propios datos del
 * informe, así que funciona sin API Key, sin cuota y sin latencia, y dice
 * siempre lo mismo ante el mismo intento.
 *
 * @param {Object} informe el que devuelve obtenerInformeIntento
 * @return {{titular:string, dominas:Array<string>, repasar:Array<{area:string,cuantas:number}>, consejo:string}}
 */
function resumirInformeParaColaborador(informe) {
  const vacio = {
    titular: "Todavía no hay un examen que resumir.",
    dominas: [],
    repasar: [],
    consejo: "Cuando presentes el examen aparecerá aquí qué te salió bien y qué conviene repasar."
  };
  if (!informe || typeof informe !== "object") return vacio;

  const porcentaje = Number(informe.porcentaje) || 0;
  const escala = resolverNivelDesempeno(porcentaje);
  const nivel = informe.nivel || escala.nivel;
  const modulo = informe.modulo || informe.moduloId || "el módulo";

  // Lo que domina: áreas por encima del corte que ya usa la escala para
  // certificar, de mejor a peor.
  const umbral = umbralAreaDominada();
  const areas = informe.desempenoAreas || {};
  const dominas = Object.keys(areas)
    .filter(function (a) { return (Number(areas[a]) || 0) >= umbral; })
    .sort(function (a, b) {
      return (Number(areas[b]) || 0) - (Number(areas[a]) || 0) || a.localeCompare(b);
    });

  // Lo que hay que repasar: se cuentan los fallos por área. Se cuenta sobre
  // `hallazgos` y no sobre el porcentaje del área porque «fallaste 3» es
  // accionable y «tienes un 40% en esta área» no le dice nada a nadie.
  const conteo = {};
  (informe.hallazgos || []).forEach(function (h) {
    const area = (h.concepto || "General").toString();
    conteo[area] = (conteo[area] || 0) + 1;
  });
  const repasar = Object.keys(conteo)
    .map(function (a) { return { area: a, cuantas: conteo[a] }; })
    .sort(function (a, b) { return (b.cuantas - a.cuantas) || a.area.localeCompare(b.area); });

  const titular = "Sacaste " + porcentaje + "% en " + modulo + ": " + nivel + ".";

  const intentosRestantes = Math.max(
    (Number(informe.maxIntentos) || MODULO_MAX_INTENTOS) - (Number(informe.numeroIntento) || 1), 0);
  const peor = repasar.length > 0 ? repasar[0].area : "";

  let consejo;
  if (escala.certifica) {
    consejo = repasar.length === 0
      ? "Módulo superado y sin nada pendiente: puedes descargar tu certificado."
      : "Módulo superado. Cuando tengas un rato, dale un repaso a " + peor +
        " para dejarlo redondo; no necesitas volver a examinarte.";
  } else if (intentosRestantes > 0) {
    consejo = "Repasa primero " + (peor || "los videos del módulo") + ", que es donde más se te escapó, y" +
              " vuelve a presentarlo: te queda" + (intentosRestantes === 1 ? " 1 intento." : "n " + intentosRestantes + " intentos.");
  } else {
    consejo = "Ya usaste todos tus intentos. Repasa " + (peor || "los videos del módulo") +
              " y pide a tu responsable de formación que te habilite uno nuevo.";
  }

  return { titular: titular, dominas: dominas, repasar: repasar, consejo: consejo };
}

// =====================================================================================
// 13. ALTA DE VIDEOS DESDE EL PORTAL Y BUZÓN DE SUGERENCIAS
// =====================================================================================
//
// Hasta ahora un video solo entraba al catálogo por la hoja o por una importación
// masiva: quien encontraba algo útil tenía que pedírselo a alguien con acceso al
// libro. Aquí se abren los dos caminos que faltaban, y se separan a propósito:
//
//   • Quien ya tiene scope "admin" añade directo, porque su token YA le permite
//     escribir en el catálogo por otras vías; obligarle a sugerirse a sí mismo
//     solo añadiría un paso vacío.
//   • Cualquier colaborador (scope "read_only") deja una sugerencia. No escribe
//     en el catálogo: escribe en una hoja aparte que alguien revisa. Así el
//     catálogo sigue teniendo un único responsable, que es lo que hace que los
//     módulos y los exámenes construidos sobre él signifiquen algo.
//
// Ninguno de los dos caminos llama a una API externa. Se guarda solo lo que se
// deduce de la propia URL y las columnas de clasificación quedan en
// SIN_CLASIFICAR: la Fase 1 (metadatos) y la Fase 2 (IA) las rellenan después,
// en su propio turno y con su propia cuota. Hacerlo aquí ataría el alta desde el
// portal a que YouTube responda, y una pantalla no puede quedarse esperando eso.

/**
 * Índices 0-based de la hoja `_Sugerencias`, igual que IDX para el catálogo y
 * CLAVE para el banco de preguntas. Mismo motivo: el día que se inserte una
 * columna, se cambia aquí y el resto del código sigue siendo cierto.
 */
const SUG = {
  ID: 0, CORREO: 1, NOMBRE: 2, URL: 3, TITULO: 4, MOTIVO: 5, FECHA: 6,
  ESTADO: 7, REVISOR: 8, FECHA_REVISION: 9, NOTA: 10, ID_VIDEO: 11
};

/** Ancho de la hoja de sugerencias, derivado de SUG para no poder desalinearse. */
const SUG_COLUMNAS = Object.keys(SUG).length;

/** Los tres únicos estados posibles de una sugerencia. */
const ESTADO_SUGERENCIA = {
  PENDIENTE: "Pendiente",
  APROBADA: "Aprobada",
  RECHAZADA: "Rechazada"
};

/**
 * Lo que parsearVideoUniversal() sabe reconocer, en el orden en que lo intenta.
 * Está aquí para poder DECÍRSELO a quien pega una URL que no encaja: un
 * "URL inválida" a secas obliga a adivinar, y la gente acaba pegando la misma
 * URL tres veces en vez de darse cuenta de que ese enlace no es de video.
 */
const PLATAFORMAS_ADMITIDAS = ["YouTube", "Vimeo", "TikTok", "Facebook", "Twitch", "Dailymotion"];

function obtenerHojaSugerencias() { return asegurarHojaSistema("_Sugerencias"); }

/** El mismo texto para los dos caminos: quien sugiere y quien da de alta leen lo mismo. */
function mensajeUrlNoReconocida(url) {
  return "No se reconoce «" + (url || "").toString().trim().slice(0, 120) +
    "» como un enlace de video. Se admiten: " + PLATAFORMAS_ADMITIDAS.join(", ") + ".";
}

/**
 * Fila (1-based, tal como se ve en la hoja) en la que ya está ese ID de video, o
 * 0 si no está. Se lee solo la columna del ID en vez del rango completo: en un
 * catálogo de cientos de filas, traer las 32 columnas para mirar una es tiempo que
 * el portal paga en cada alta.
 */
function buscarFilaDeVideoPorId(idVideo) {
  const buscado = (idVideo || "").toString().trim();
  if (!buscado) return 0;
  const hoja = obtenerHojaDatos();
  if (hoja.getLastRow() < 2) return 0;
  const ids = hoja.getRange(2, IDX.ID + 1, hoja.getLastRow() - 1, 1).getValues();
  for (let i = 0; i < ids.length; i++) {
    if ((ids[i][0] || "").toString().trim() === buscado) return i + 2;
  }
  return 0;
}

/**
 * Núcleo compartido del alta. Lo usan el alta directa del administrador y la
 * aprobación de una sugerencia: si cada una construyera su propia fila, tarde o
 * temprano una de las dos se olvidaría de poner SIN_CLASIFICAR o de invalidar la
 * caché, y el video aprobado se comportaría distinto al añadido a mano.
 *
 * No lanza excepción por una URL mala ni por un duplicado: son respuestas
 * normales que la pantalla tiene que poder mostrar, no fallos del sistema.
 *
 * @return {{exito:boolean, idVideo:string, fila:number, mensaje:string, duplicado?:boolean}}
 */
function anadirFilaCatalogoDesdeUrl(url, opciones) {
  exigirOrigenInterno("anadirFilaCatalogoDesdeUrl");
  const opts = opciones || {};
  const enlace = (url || "").toString().trim();
  const reconocido = parsearVideoUniversal(enlace);
  if (!reconocido) {
    return { exito: false, idVideo: "", fila: 0, mensaje: mensajeUrlNoReconocida(enlace) };
  }

  // El duplicado se decide por ID de video, no por texto de URL: el mismo video
  // llega con «youtu.be/x», con «watch?v=x&t=30» y con parámetros de campaña.
  const filaExistente = buscarFilaDeVideoPorId(reconocido.id);
  if (filaExistente) {
    return {
      exito: false, duplicado: true, idVideo: reconocido.id, fila: filaExistente,
      mensaje: "Ese video ya está en el catálogo, en la fila " + filaExistente + "."
    };
  }

  const hoja = obtenerHojaDatos();
  asegurarColumnas(hoja, TOTAL_COLUMNAS);

  const registro = new Array(TOTAL_COLUMNAS).fill("");
  registro[IDX.URL] = enlace;
  registro[IDX.ID] = reconocido.id;
  registro[IDX.TITULO] = (opts.titulo || "").toString().trim();
  registro[IDX.FUENTE] = deducirFuenteDesdeUrl(enlace);
  // Sin clasificar de forma explícita, no en blanco: una celda vacía parece un
  // dato que se perdió, y «Sin clasificar» dice que aún nadie lo ha mirado.
  registro[IDX.ECOSISTEMA] = SIN_CLASIFICAR;
  registro[IDX.AREA] = SIN_CLASIFICAR;
  registro[IDX.ESTADO] = "🟡 Pendiente";
  registro[IDX.DIFICULTAD] = "Principiante";

  const numeroFila = hoja.getLastRow() + 1;
  hoja.getRange(numeroFila, 1, 1, TOTAL_COLUMNAS).setValues([registro]);

  // El portal sirve el catálogo desde caché: sin esto, el video recién añadido
  // no aparece hasta que la caché caduque sola y quien lo añadió cree que falló.
  invalidarCacheAPI();

  return {
    exito: true, idVideo: reconocido.id, fila: numeroFila,
    mensaje: "Video añadido en la fila " + numeroFila +
      ". Queda pendiente de metadatos y clasificación."
  };
}

/**
 * Alta directa desde el portal. Solo administradores.
 * @param {string} token
 * @param {string} url
 * @param {{titulo?:string}} [opciones]
 * @return {{exito:boolean, idVideo:string, fila:number, mensaje:string, duplicado?:boolean}}
 */
function agregarVideoDirecto(token, url, opciones) {
  validarTokenConScope(token, "admin");
  const resultado = anadirFilaCatalogoDesdeUrl(url, opciones);
  if (resultado.exito) {
    logInfo("Alta directa", `Video ${resultado.idVideo} añadido al catálogo desde el portal.`);
  } else if (resultado.duplicado) {
    logWarn("Alta directa", `Duplicado rechazado: ${resultado.idVideo} ya está en la fila ${resultado.fila}.`);
  }
  return resultado;
}

/**
 * Sugerencia de un colaborador. No toca el catálogo.
 *
 * Se rechaza pronto —antes de escribir nada— en los dos casos en los que la
 * sugerencia no aportaría nada: el video ya está catalogado, o alguien ya lo
 * sugirió y está esperando revisión. Y se dice CUÁL de los dos es, porque de lo
 * contrario la persona vuelve a intentarlo pensando que se perdió su envío.
 *
 * @return {{exito:boolean, idSugerencia?:string, mensaje:string}}
 */
function sugerirVideo(token, url, titulo, motivo) {
  validarTokenConScope(token, "read_only");
  const datosToken = obtenerDatosToken_(token) || {};
  const enlace = (url || "").toString().trim();

  const reconocido = parsearVideoUniversal(enlace);
  if (!reconocido) return { exito: false, mensaje: mensajeUrlNoReconocida(enlace) };

  const filaCatalogo = buscarFilaDeVideoPorId(reconocido.id);
  if (filaCatalogo) {
    return {
      exito: false, yaEnCatalogo: true,
      mensaje: "Gracias, pero ese video ya está en el catálogo (fila " + filaCatalogo + ")."
    };
  }

  const hoja = obtenerHojaSugerencias();
  const pendiente = buscarSugerenciaPendienteDeVideo(hoja, reconocido.id);
  if (pendiente) {
    return {
      exito: false, yaSugerida: true, idSugerencia: pendiente,
      mensaje: "Ya hay una sugerencia pendiente con esa misma URL; está esperando revisión."
    };
  }

  const idSugerencia = nuevoId("sug");
  const registro = new Array(SUG_COLUMNAS).fill("");
  registro[SUG.ID] = idSugerencia;
  registro[SUG.CORREO] = (datosToken.email || "").toString().toLowerCase().trim();
  registro[SUG.NOMBRE] = (datosToken.client || "").toString().trim();
  registro[SUG.URL] = enlace;
  // Título y motivo los escribe un colaborador y los lee el administrador en su
  // panel: es exactamente el mismo camino que el de una incidencia, así que se
  // sanean igual. Ver `sanitizarTextoUsuario`.
  registro[SUG.TITULO] = sanitizarTextoUsuario(titulo).slice(0, 300);
  registro[SUG.MOTIVO] = sanitizarTextoUsuario(motivo).slice(0, 500);
  registro[SUG.FECHA] = new Date();
  registro[SUG.ESTADO] = ESTADO_SUGERENCIA.PENDIENTE;
  hoja.appendRow(registro);

  logInfo("Sugerencias", `Nueva sugerencia ${idSugerencia} de ${registro[SUG.CORREO] || "anónimo"}.`);
  return { exito: true, idSugerencia: idSugerencia, mensaje: "Sugerencia registrada. Queda pendiente de revisión." };
}

/**
 * Busca una sugerencia PENDIENTE cuyo video sea el mismo. Compara por ID de
 * video, no por cadena de URL, por la misma razón que el alta: dos enlaces
 * distintos del mismo video son la misma sugerencia.
 * @return {string} el ID de la sugerencia pendiente, o "" si no hay ninguna.
 */
function buscarSugerenciaPendienteDeVideo(hoja, idVideo) {
  if (!hoja || hoja.getLastRow() < 2) return "";
  const registros = hoja.getRange(2, 1, hoja.getLastRow() - 1, SUG_COLUMNAS).getValues();
  for (let i = 0; i < registros.length; i++) {
    if ((registros[i][SUG.ESTADO] || "").toString().trim() !== ESTADO_SUGERENCIA.PENDIENTE) continue;
    const otro = parsearVideoUniversal(registros[i][SUG.URL]);
    if (otro && otro.id === idVideo) return (registros[i][SUG.ID] || "").toString();
  }
  return "";
}

/**
 * Bandeja de revisión. Solo administradores.
 *
 * Devuelve objetos con nombres de campo legibles y las fechas ya formateadas:
 * lo que sale de aquí viaja a la pantalla, y un Date crudo no sobrevive a la
 * serialización de google.script.run (llega como null o como texto del navegador).
 *
 * @param {string} token
 * @param {string} [estado] filtro opcional: "Pendiente" | "Aprobada" | "Rechazada"
 * @return {Array<Object>} de más reciente a más antigua
 */
function listarSugerencias(token, estado) {
  validarTokenConScope(token, "admin");
  const hoja = obtenerHojaSugerencias();
  if (hoja.getLastRow() < 2) return [];

  const filtro = (estado || "").toString().trim().toLowerCase();
  const registros = hoja.getRange(2, 1, hoja.getLastRow() - 1, SUG_COLUMNAS).getValues();
  const salida = [];

  registros.forEach(function (r, i) {
    if (!r[SUG.ID]) return;
    if (filtro && (r[SUG.ESTADO] || "").toString().trim().toLowerCase() !== filtro) return;
    salida.push({
      id: (r[SUG.ID] || "").toString(),
      fila: i + 2,
      correo: (r[SUG.CORREO] || "").toString(),
      nombre: (r[SUG.NOMBRE] || "").toString(),
      url: (r[SUG.URL] || "").toString(),
      titulo: (r[SUG.TITULO] || "").toString(),
      motivo: (r[SUG.MOTIVO] || "").toString(),
      fecha: formatearFecha(r[SUG.FECHA]),
      estado: (r[SUG.ESTADO] || "").toString(),
      revisadoPor: (r[SUG.REVISOR] || "").toString(),
      fechaRevision: formatearFecha(r[SUG.FECHA_REVISION]),
      nota: (r[SUG.NOTA] || "").toString(),
      idVideoCreado: (r[SUG.ID_VIDEO] || "").toString()
    });
  });

  // El patrón de fecha es «yyyy-MM-dd HH:mm:ss», así que el orden alfabético ES
  // el cronológico. Cuando dos caen en el mismo segundo —pasa al importar varias
  // seguidas— desempata la fila, que respeta el orden real de llegada.
  salida.sort(function (a, b) {
    return b.fecha.localeCompare(a.fecha) || (b.fila - a.fila);
  });
  return salida;
}

/**
 * Aprueba o rechaza una sugerencia. Solo administradores.
 *
 * Es idempotente a propósito: la bandeja se abre en dos pestañas, se pulsa dos
 * veces, o llega un reintento de red. Una segunda llamada sobre una sugerencia
 * ya resuelta no crea una segunda fila en el catálogo ni pisa quién la revisó:
 * devuelve lo que ya se decidió, con `yaResuelta: true`.
 *
 * @return {{exito:boolean, estado?:string, idVideo?:string, fila?:number,
 *           yaResuelta?:boolean, mensaje:string}}
 */
function resolverSugerencia(token, idSugerencia, aprobar, nota) {
  validarTokenConScope(token, "admin");
  const datosToken = obtenerDatosToken_(token) || {};
  const hoja = obtenerHojaSugerencias();
  const buscada = (idSugerencia || "").toString().trim();
  if (!buscada) return { exito: false, mensaje: "Falta el identificador de la sugerencia." };
  if (hoja.getLastRow() < 2) return { exito: false, mensaje: "No hay ninguna sugerencia registrada." };

  const registros = hoja.getRange(2, 1, hoja.getLastRow() - 1, SUG_COLUMNAS).getValues();
  let indice = -1;
  for (let i = 0; i < registros.length; i++) {
    if ((registros[i][SUG.ID] || "").toString().trim() === buscada) { indice = i; break; }
  }
  if (indice === -1) return { exito: false, mensaje: "No existe la sugerencia " + buscada + "." };

  const registro = registros[indice];
  const numeroFila = indice + 2;
  const estadoActual = (registro[SUG.ESTADO] || "").toString().trim();

  if (estadoActual && estadoActual !== ESTADO_SUGERENCIA.PENDIENTE) {
    return {
      exito: true, yaResuelta: true, estado: estadoActual,
      idVideo: (registro[SUG.ID_VIDEO] || "").toString(), fila: 0,
      mensaje: "Esa sugerencia ya estaba " + estadoActual.toLowerCase() +
        " por " + ((registro[SUG.REVISOR] || "").toString() || "otra persona") + "."
    };
  }

  let idVideo = "";
  let filaVideo = 0;
  let detalle = "Sugerencia rechazada.";

  if (aprobar) {
    const alta = anadirFilaCatalogoDesdeUrl(registro[SUG.URL], { titulo: registro[SUG.TITULO] });
    // Un duplicado no impide aprobar: el video que se pedía YA está donde la
    // persona quería que estuviese. Lo que no se puede es dejar la sugerencia
    // pendiente para siempre por eso.
    if (!alta.exito && !alta.duplicado) {
      return { exito: false, mensaje: "No se pudo aprobar: " + alta.mensaje };
    }
    idVideo = alta.idVideo;
    filaVideo = alta.fila;
    detalle = alta.duplicado
      ? "Sugerencia aprobada; el video ya estaba en el catálogo (fila " + alta.fila + ")."
      : "Sugerencia aprobada y video añadido en la fila " + alta.fila + ".";
  }

  // Las cinco columnas de revisión son contiguas: se escriben de una sola vez
  // para que un fallo a mitad no deje la sugerencia marcada como resuelta pero
  // sin constar quién la resolvió. El ancho se deriva de SUG, no se escribe.
  const anchoRevision = SUG.ID_VIDEO - SUG.ESTADO + 1;
  hoja.getRange(numeroFila, SUG.ESTADO + 1, 1, anchoRevision).setValues([[
    aprobar ? ESTADO_SUGERENCIA.APROBADA : ESTADO_SUGERENCIA.RECHAZADA,
    (datosToken.email || datosToken.client || "").toString(),
    new Date(),
    (nota || "").toString().trim(),
    idVideo
  ]]);

  logInfo("Sugerencias", `Sugerencia ${buscada} ${aprobar ? "aprobada" : "rechazada"}.`);
  return {
    exito: true, estado: aprobar ? ESTADO_SUGERENCIA.APROBADA : ESTADO_SUGERENCIA.RECHAZADA,
    idVideo: idVideo, fila: filaVideo, mensaje: detalle
  };
}

/**
 * Cuántas sugerencias esperan revisión. Sin scope: es un número que el portal
 * pinta en la insignia del menú y que no revela nada de nadie.
 *
 * No usa asegurarHojaSistema() a propósito: contar no debe tener el efecto
 * secundario de crear una hoja en un libro donde nadie ha sugerido nada aún.
 */
function contarSugerenciasPendientes() {
  try {
    const hoja = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("_Sugerencias");
    if (!hoja || hoja.getLastRow() < 2) return 0;
    const estados = hoja.getRange(2, SUG.ESTADO + 1, hoja.getLastRow() - 1, 1).getValues();
    let total = 0;
    estados.forEach(function (e) {
      if ((e[0] || "").toString().trim() === ESTADO_SUGERENCIA.PENDIENTE) total++;
    });
    return total;
  } catch (e) {
    logWarn("Sugerencias", "No se pudo contar las pendientes: " + e.message);
    return 0;
  }
}

// =====================================================================================
// 14. FAVORITOS Y APUNTES PRIVADOS DE CADA COLABORADOR
// =====================================================================================
//
// El catálogo es de todos; lo que cada persona marca y escribe sobre él, no.
// Dos hojas separadas del catálogo (`_Favoritos` y `_Notas_Usuario`) porque el
// catálogo se reescribe entero en las fases de metadatos y de IA: guardar ahí
// una columna «mis notas» significaría perderla en la primera reclasificación,
// y además haría que la nota de una persona viajase en la misma fila que lee
// todo el mundo.
//
// REGLA QUE NO SE NEGOCIA: el correo NUNCA llega por parámetro. Sale siempre de
// obtenerDatosToken_(), es decir, del token con el que la persona entró. Si el
// correo pudiera pasarse desde el cliente, cualquiera con un token válido
// leería y borraría las notas de sus compañeros con solo cambiar una cadena en
// la llamada. Por eso todas las funciones de este bloque piden scope
// "read_only" (lo que tiene cualquier colaborador) y aun así solo alcanzan sus
// propias filas: el scope dice que puedes entrar, el correo dice qué es tuyo.

/**
 * Índices 0-based de `_Favoritos`, igual que IDX para el catálogo, CLAVE para el
 * banco de preguntas y SUG para las sugerencias. El día que se inserte una
 * columna se cambia aquí y el resto del código sigue siendo cierto.
 */
const FAV = { CORREO: 0, ID_VIDEO: 1, FECHA: 2 };

/** Ancho de `_Favoritos`, derivado de FAV para no poder desalinearse. */
const FAV_COLUMNAS = Object.keys(FAV).length;

/** Índices 0-based de `_Notas_Usuario`. */
const NOTA = { CORREO: 0, ID_VIDEO: 1, TEXTO: 2, FECHA_CREACION: 3, FECHA_MODIFICACION: 4 };

/** Ancho de `_Notas_Usuario`, derivado de NOTA. */
const NOTA_COLUMNAS = Object.keys(NOTA).length;

/**
 * Tope de una nota. No es una restricción de producto sino de almacén: una
 * celda de Sheets admite 50.000 caracteres, y una nota de ese tamaño convierte
 * cada lectura de la hoja en un bloque enorme de texto que hay que mover entero
 * para pintar una lista. 5.000 caracteres son unas dos páginas: de sobra para
 * un apunte sobre un video, y aún barato de leer en lote.
 */
const NOTA_MAX_CARACTERES = 5000;

/**
 * El correo de la persona que hizo la llamada, tomado del token y de ningún
 * otro sitio. Es la pieza que hace posible el aislamiento: si esto devolviera
 * algo que el cliente controla, todo lo demás de este bloque sería decorativo.
 *
 * Un token sin correo (los de integración desatendida, por ejemplo) no
 * identifica a una persona y por tanto no puede tener favoritos ni apuntes: se
 * falla con un mensaje explícito en vez de dejar que todos esos tokens
 * compartan en silencio el mismo cajón de correo vacío.
 */
function correoDelTokenPersonal(token) {
  const datos = obtenerDatosToken_(token) || {};
  const correo = (datos.email || "").toString().toLowerCase().trim();
  if (!correo) {
    throw new Error("Este token no está asociado a ningún correo, así que no puede tener favoritos ni apuntes personales.");
  }
  return correo;
}

/** Normaliza un ID de video para comparar siempre igual, venga de donde venga. */
function normalizarIdVideo(idVideo) {
  return (idVideo === null || idVideo === undefined) ? "" : idVideo.toString().trim();
}

/**
 * Filas de datos de una hoja personal, sin la cabecera. Devuelve [] si la hoja
 * todavía no existe: leer los favoritos de alguien que nunca marcó ninguno no
 * debe tener el efecto secundario de crear una hoja en el libro.
 */
function leerFilasHojaPersonal(nombreHoja, ancho) {
  const hoja = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(nombreHoja);
  if (!hoja || hoja.getLastRow() < 2) return { hoja: hoja, registros: [] };
  return { hoja: hoja, registros: hoja.getRange(2, 1, hoja.getLastRow() - 1, ancho).getValues() };
}

/**
 * Posición (0-based dentro de `registros`) de la fila de ESA persona para ESE
 * video, o -1. Las dos condiciones se comprueban juntas a propósito: buscar
 * primero por video y filtrar después por correo es el camino natural para
 * acabar devolviendo la fila de otro.
 */
function indiceFilaPersonal(registros, correo, idVideo, colCorreo, colVideo) {
  for (let i = 0; i < registros.length; i++) {
    const correoFila = (registros[i][colCorreo] || "").toString().toLowerCase().trim();
    const videoFila = normalizarIdVideo(registros[i][colVideo]);
    if (correoFila === correo && videoFila === idVideo) return i;
  }
  return -1;
}

/**
 * Borra varias filas de una hoja de una vez. Se ordena de mayor a menor porque
 * cada deleteRow desplaza hacia arriba todo lo que venía después: borrando de
 * arriba abajo, el segundo número de fila ya no señala lo que señalaba.
 */
function borrarFilasDescendente(hoja, numerosFila) {
  exigirOrigenInterno("borrarFilasDescendente");
  numerosFila.slice().sort(function (a, b) { return b - a; })
    .forEach(function (n) { hoja.deleteRow(n); });
}

// -------------------------------------------------------------------------------------
// 14.1 Favoritos
// -------------------------------------------------------------------------------------

/**
 * Marca o desmarca un video como favorito de quien llama. Un único punto de
 * entrada en lugar de añadir/quitar por separado: el portal pinta una estrella
 * cuyo estado puede haber cambiado en otra pestaña o en el móvil, y si pidiera
 * «añadir» algo que ya estaba marcado acabaríamos con dos filas iguales o con
 * un error que la pantalla no sabría explicar. Aquí el servidor decide, y el
 * cliente se limita a pintar lo que le devuelven.
 *
 * No se comprueba que el video exista en el catálogo: desmarcar tiene que
 * funcionar SIEMPRE, incluso sobre un video que ya se retiró, y los favoritos
 * huérfanos los limpia listarFavoritos() cuando toca pintarlos.
 *
 * @param {string} token
 * @param {string} idVideo
 * @return {{exito:boolean, favorito:boolean, idVideo:string, mensaje:string}}
 */
function alternarFavorito(token, idVideo) {
  validarTokenConScope(token, "read_only");
  const correo = correoDelTokenPersonal(token);
  const id = normalizarIdVideo(idVideo);
  if (!id) return { exito: false, favorito: false, idVideo: "", mensaje: "Falta el ID del video." };

  const hoja = asegurarHojaSistema("_Favoritos");
  const registros = hoja.getLastRow() < 2
    ? []
    : hoja.getRange(2, 1, hoja.getLastRow() - 1, FAV_COLUMNAS).getValues();

  const indice = indiceFilaPersonal(registros, correo, id, FAV.CORREO, FAV.ID_VIDEO);

  if (indice !== -1) {
    hoja.deleteRow(indice + 2);
    logInfo("Favoritos", "Favorito retirado.");
    return { exito: true, favorito: false, idVideo: id, mensaje: "Quitado de favoritos." };
  }

  const nuevoFavorito = new Array(FAV_COLUMNAS).fill("");
  nuevoFavorito[FAV.CORREO] = correo;
  nuevoFavorito[FAV.ID_VIDEO] = id;
  nuevoFavorito[FAV.FECHA] = new Date();
  hoja.appendRow(nuevoFavorito);
  logInfo("Favoritos", "Favorito añadido.");
  return { exito: true, favorito: true, idVideo: id, mensaje: "Añadido a favoritos." };
}

/**
 * Los favoritos de quien llama, ya enriquecidos con lo que el portal necesita
 * para pintar una tarjeta. Se devuelve el video entero y no solo el ID porque
 * si no, la pantalla tendría que pedir el catálogo completo y cruzarlo a mano
 * para enseñar cinco tarjetas.
 *
 * Un favorito que apunta a un video que ya no está en el catálogo NO se
 * devuelve y además se borra de la hoja: no hay forma de pintar esa tarjeta, y
 * dejarla ahí significa recorrer el catálogo buscándola en cada carga, para
 * siempre, sin encontrarla nunca.
 *
 * Orden: lo marcado más recientemente primero, que es lo que la persona está
 * buscando cuando abre la lista.
 *
 * @param {string} token
 * @return {Array<{idVideo:string, titulo:string, url:string, resumenCorto:string,
 *                 duracion:number, dificultad:string, ecosistema:string, area:string,
 *                 tieneFicha:boolean, fecha:string}>}
 */
function listarFavoritos(token) {
  validarTokenConScope(token, "read_only");
  const correo = correoDelTokenPersonal(token);

  const lectura = leerFilasHojaPersonal("_Favoritos", FAV_COLUMNAS);
  if (lectura.registros.length === 0) return [];

  // Solo lo mío. El resto de la hoja no se vuelve a mirar en toda la función.
  const mios = {};
  lectura.registros.forEach(function (registro, i) {
    if ((registro[FAV.CORREO] || "").toString().toLowerCase().trim() !== correo) return;
    const id = normalizarIdVideo(registro[FAV.ID_VIDEO]);
    if (!id) return;
    // Si por lo que sea hubiera dos filas del mismo video, gana la primera y la
    // segunda se trata como huérfana: la lista no puede tener dos veces lo mismo.
    if (mios[id]) { mios[id].duplicadas.push(i + 2); return; }
    mios[id] = { marcaTiempo: registro[FAV.FECHA], numeroFila: i + 2, duplicadas: [] };
  });

  const ids = Object.keys(mios);
  if (ids.length === 0) return [];

  const encontrados = {};
  const favoritos = [];
  iterarCatalogoPorBloques(function (datos) {
    datos.forEach(function (r) {
      const id = normalizarIdVideo(r[IDX.ID]);
      if (!id || !mios[id] || encontrados[id]) return;
      encontrados[id] = true;
      favoritos.push({
        idVideo: id,
        titulo: (r[IDX.TITULO] || "").toString(),
        url: (r[IDX.URL] || "").toString(),
        resumenCorto: (r[IDX.RESUMEN] || "").toString() || "Sin resumen.",
        duracion: parseFloat(r[IDX.DURACION]) || 0,
        dificultad: (r[IDX.DIFICULTAD] || "").toString() || "Principiante",
        ecosistema: (r[IDX.ECOSISTEMA] || "").toString() || SIN_CLASIFICAR,
        area: (r[IDX.AREA] || "").toString() || SIN_CLASIFICAR,
        tieneFicha: Boolean((r[IDX.DRIVE_RAG] || "").toString().trim()),
        fecha: formatearFecha(mios[id].marcaTiempo),
        // Se guarda aparte para ordenar; se quita antes de devolver, porque el
        // portal no debe recibir un Date crudo que no sabe serializar.
        _orden: mios[id].marcaTiempo ? new Date(mios[id].marcaTiempo).getTime() : 0
      });
    });
    return false;
  });

  // Limpieza de fantasmas: lo que quedó sin pareja en el catálogo, más las
  // filas repetidas. Se borra solo de las filas de esta persona.
  const aBorrar = [];
  ids.forEach(function (id) {
    if (!encontrados[id]) aBorrar.push(mios[id].numeroFila);
    mios[id].duplicadas.forEach(function (n) { aBorrar.push(n); });
  });
  if (aBorrar.length > 0 && lectura.hoja) {
    borrarFilasDescendente(lectura.hoja, aBorrar);
    logWarn("Favoritos", `Se limpiaron ${aBorrar.length} favoritos que ya no apuntaban a ningún video del catálogo.`);
  }

  favoritos.sort(function (a, b) { return b._orden - a._orden; });
  favoritos.forEach(function (v) { delete v._orden; });
  return favoritos;
}

// -------------------------------------------------------------------------------------
// 14.2 Apuntes privados sobre un video
// -------------------------------------------------------------------------------------

/**
 * El apunte de quien llama sobre un video. Si no hay nada escrito devuelve la
 * misma forma con el texto vacío en lugar de null: así la pantalla pinta
 * siempre el mismo cuadro de texto y no tiene que distinguir dos casos.
 *
 * @param {string} token
 * @param {string} idVideo
 * @return {{idVideo:string, texto:string, fechaModificacion:string}}
 */
function obtenerNotaVideo(token, idVideo) {
  validarTokenConScope(token, "read_only");
  const correo = correoDelTokenPersonal(token);
  const id = normalizarIdVideo(idVideo);
  const vacia = { idVideo: id, texto: "", fechaModificacion: "" };
  if (!id) return vacia;

  const lectura = leerFilasHojaPersonal("_Notas_Usuario", NOTA_COLUMNAS);
  const indice = indiceFilaPersonal(lectura.registros, correo, id, NOTA.CORREO, NOTA.ID_VIDEO);
  if (indice === -1) return vacia;

  const registro = lectura.registros[indice];
  return {
    idVideo: id,
    texto: (registro[NOTA.TEXTO] || "").toString(),
    fechaModificacion: formatearFecha(registro[NOTA.FECHA_MODIFICACION])
  };
}

/**
 * Crea o actualiza el apunte de quien llama sobre un video. Una sola función
 * para las dos cosas por el mismo motivo que alternarFavorito(): el cliente no
 * sabe con certeza si ya existía una nota, y si tuviera que elegir entre
 * «crear» y «actualizar» acabaría creando una segunda fila del mismo video.
 *
 * Un texto que queda vacío al recortarlo BORRA la fila. Una nota vacía no es un
 * dato: es basura que engorda la hoja y que luego aparece en «mis apuntes» como
 * una entrada sin contenido que nadie sabe por qué está ahí. Borrar el
 * contenido es la forma natural de decir «ya no quiero esta nota».
 *
 * @param {string} token
 * @param {string} idVideo
 * @param {string} texto
 * @return {{exito:boolean, borrada:boolean, truncada:boolean, idVideo:string,
 *           creada:boolean, longitud:number, fechaModificacion:string, mensaje:string}}
 */
function guardarNotaVideo(token, idVideo, texto) {
  validarTokenConScope(token, "read_only");
  const correo = correoDelTokenPersonal(token);
  const id = normalizarIdVideo(idVideo);
  if (!id) {
    return {
      exito: false, borrada: false, truncada: false, idVideo: "",
      creada: false, longitud: 0, fechaModificacion: "", mensaje: "Falta el ID del video."
    };
  }

  let contenido = (texto === null || texto === undefined) ? "" : texto.toString().trim();
  const truncada = contenido.length > NOTA_MAX_CARACTERES;
  if (truncada) contenido = contenido.slice(0, NOTA_MAX_CARACTERES);

  const hoja = asegurarHojaSistema("_Notas_Usuario");
  const registros = hoja.getLastRow() < 2
    ? []
    : hoja.getRange(2, 1, hoja.getLastRow() - 1, NOTA_COLUMNAS).getValues();
  const indice = indiceFilaPersonal(registros, correo, id, NOTA.CORREO, NOTA.ID_VIDEO);

  if (contenido === "") {
    if (indice === -1) {
      return {
        exito: true, borrada: false, truncada: false, idVideo: id,
        creada: false, longitud: 0, fechaModificacion: "",
        mensaje: "No había ninguna nota que borrar."
      };
    }
    hoja.deleteRow(indice + 2);
    logInfo("Notas", "Nota borrada al quedarse sin texto.");
    return {
      exito: true, borrada: true, truncada: false, idVideo: id,
      creada: false, longitud: 0, fechaModificacion: "", mensaje: "Nota borrada."
    };
  }

  const ahora = new Date();
  const mensaje = truncada
    ? "Nota guardada, recortada a " + NOTA_MAX_CARACTERES + " caracteres."
    : "Nota guardada.";

  if (indice === -1) {
    const nuevaNota = new Array(NOTA_COLUMNAS).fill("");
    nuevaNota[NOTA.CORREO] = correo;
    nuevaNota[NOTA.ID_VIDEO] = id;
    nuevaNota[NOTA.TEXTO] = contenido;
    nuevaNota[NOTA.FECHA_CREACION] = ahora;
    nuevaNota[NOTA.FECHA_MODIFICACION] = ahora;
    hoja.appendRow(nuevaNota);
    return {
      exito: true, borrada: false, truncada: truncada, idVideo: id,
      creada: true, longitud: contenido.length,
      fechaModificacion: formatearFecha(ahora), mensaje: mensaje
    };
  }

  // Actualizar en el sitio, sin borrar y volver a crear: la fecha de creación es
  // el único dato que no se puede reconstruir, y una nota que se reescribe sigue
  // siendo la misma nota. Las tres celdas se escriben de una vez y el ancho se
  // deriva de NOTA para que insertar una columna no descoloque la escritura.
  const anchoTexto = NOTA.FECHA_MODIFICACION - NOTA.TEXTO + 1;
  hoja.getRange(indice + 2, NOTA.TEXTO + 1, 1, anchoTexto).setValues([[
    contenido,
    registros[indice][NOTA.FECHA_CREACION] || ahora,
    ahora
  ]]);
  logInfo("Notas", "Nota actualizada.");
  return {
    exito: true, borrada: false, truncada: truncada, idVideo: id,
    creada: false, longitud: contenido.length,
    fechaModificacion: formatearFecha(ahora), mensaje: mensaje
  };
}

/**
 * Todos los apuntes de quien llama, con el título del video al lado, para poder
 * repasarlos juntos sin ir video por video. Ordenados por fecha de modificación
 * descendente: lo último que escribiste es lo que estabas pensando.
 *
 * A diferencia de los favoritos, una nota cuyo video ya no está en el catálogo
 * NO se borra. Un favorito es un puntero y sin destino no vale nada; una nota es
 * algo que esa persona escribió, y perderla porque alguien retiró un video sería
 * destruir trabajo ajeno. Se devuelve con `enCatalogo:false` para que el portal
 * la enseñe sin ofrecer un enlace que no lleva a ninguna parte.
 *
 * @param {string} token
 * @return {Array<{idVideo:string, titulo:string, texto:string, url:string,
 *                 enCatalogo:boolean, fechaCreacion:string, fechaModificacion:string}>}
 */
function listarNotasUsuario(token) {
  validarTokenConScope(token, "read_only");
  const correo = correoDelTokenPersonal(token);

  const lectura = leerFilasHojaPersonal("_Notas_Usuario", NOTA_COLUMNAS);
  if (lectura.registros.length === 0) return [];

  const notas = [];
  const porVideo = {};
  lectura.registros.forEach(function (registro) {
    if ((registro[NOTA.CORREO] || "").toString().toLowerCase().trim() !== correo) return;
    const id = normalizarIdVideo(registro[NOTA.ID_VIDEO]);
    if (!id) return;
    const ficha = {
      idVideo: id,
      titulo: "",
      url: "",
      enCatalogo: false,
      texto: (registro[NOTA.TEXTO] || "").toString(),
      fechaCreacion: formatearFecha(registro[NOTA.FECHA_CREACION]),
      fechaModificacion: formatearFecha(registro[NOTA.FECHA_MODIFICACION]),
      _orden: registro[NOTA.FECHA_MODIFICACION]
        ? new Date(registro[NOTA.FECHA_MODIFICACION]).getTime() : 0
    };
    notas.push(ficha);
    (porVideo[id] = porVideo[id] || []).push(ficha);
  });

  if (notas.length === 0) return [];

  // Un solo recorrido del catálogo para todas las notas: pedir el título video a
  // video convertiría una lista de veinte apuntes en veinte barridos de la hoja.
  iterarCatalogoPorBloques(function (datos) {
    datos.forEach(function (r) {
      const id = normalizarIdVideo(r[IDX.ID]);
      if (!id || !porVideo[id]) return;
      porVideo[id].forEach(function (ficha) {
        ficha.titulo = (r[IDX.TITULO] || "").toString();
        ficha.url = (r[IDX.URL] || "").toString();
        ficha.enCatalogo = true;
      });
    });
    return false;
  });

  notas.sort(function (a, b) { return b._orden - a._orden; });
  notas.forEach(function (n) { delete n._orden; });
  return notas;
}

