// 0.2 UTILIDADES TRANSVERSALES
// =====================================================================================

/** Limpia comillas, controles y saltos de línea de cualquier entrada externa. */
function sanitizarEntrada(texto) {
  if (texto === null || texto === undefined) return "";
  return texto.toString()
    .replace(/['"]/g, "")
    .replace(/[\x00-\x1F\x7F]/g, "")
    .replace(/\n/g, " ")
    .trim();
}

/**
 * Saneado para texto libre que ESCRIBE UNA PERSONA Y LEE OTRA: la descripción de
 * una incidencia, el motivo de una sugerencia. `sanitizarEntrada` quita comillas
 * y caracteres de control, pero deja pasar `<script>`; y esos textos aterrizan en
 * el panel del administrador, así que un colaborador podría dejarle ahí una
 * etiqueta preparada. El portal escapa al pintar, pero eso es una sola capa: si
 * mañana alguien pinta ese campo con innerHTML en otra pantalla, el fallo vuelve.
 * Aquí se quitan los ángulos de una vez, que en prosa no se pierde nada.
 *
 * No se usa para las notas privadas: esas solo las lee quien las escribe, y ahí
 * «a < b» es texto legítimo que nadie tiene por qué perder.
 */
function sanitizarTextoUsuario(texto) {
  return sanitizarEntrada(texto).replace(/[<>]/g, "");
}

/** Escapa metacaracteres antes de construir una expresión regular dinámica. */
function escapeRegExp(cadena) {
  return (cadena || "").toString().replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
}

/** Convierte "07:54" o "1:07:54" a segundos. Devuelve 0 si no reconoce el formato. */
function convertirTimestampASegundos(valor) {
  if (valor === null || valor === undefined || valor === "") return 0;
  if (typeof valor === "number") return Math.max(0, Math.floor(valor));
  const partes = valor.toString().trim().split(":").map(p => parseInt(p, 10));
  if (partes.some(isNaN)) {
    const n = parseInt(valor, 10);
    return isNaN(n) ? 0 : Math.max(0, n);
  }
  if (partes.length === 3) return partes[0] * 3600 + partes[1] * 60 + partes[2];
  if (partes.length === 2) return partes[0] * 60 + partes[1];
  return Math.max(0, partes[0] || 0);
}

/** Convierte segundos a "mm:ss" o "h:mm:ss". */
function formatearSegundos(segundos) {
  const s = Math.max(0, Math.floor(Number(segundos) || 0));
  const h = Math.floor(s / 3600);
  const m = Math.floor((s % 3600) / 60);
  const seg = s % 60;
  const dosDigitos = n => (n < 10 ? "0" + n : "" + n);
  return h > 0 ? `${h}:${dosDigitos(m)}:${dosDigitos(seg)}` : `${m}:${dosDigitos(seg)}`;
}

/** Enlace de YouTube con salto al segundo exacto. */
function construirEnlaceConSegundo(urlBase, segundo) {
  const seg = Math.max(0, Math.floor(Number(segundo) || 0));
  if (!urlBase) return "";
  if (seg === 0) return urlBase;
  const sep = urlBase.indexOf("?") === -1 ? "?" : "&";
  return urlBase + sep + "t=" + seg + "s";
}

/** Generador pseudoaleatorio determinista (mulberry32) para barajar de forma reproducible. */
function crearAleatorioConSemilla(semilla) {
  let a = 0;
  const s = (semilla || "0").toString();
  for (let i = 0; i < s.length; i++) a = (a + s.charCodeAt(i) * (i + 1)) >>> 0;
  return function () {
    a |= 0; a = (a + 0x6D2B79F5) | 0;
    let tt = Math.imul(a ^ (a >>> 15), 1 | a);
    tt = (tt + Math.imul(tt ^ (tt >>> 7), 61 | tt)) ^ tt;
    return ((tt ^ (tt >>> 14)) >>> 0) / 4294967296;
  };
}

/** Baraja una copia del arreglo con orden reproducible a partir de la semilla. */
function barajarConSemilla(arreglo, semilla) {
  const copia = arreglo.slice();
  const rnd = crearAleatorioConSemilla(semilla);
  for (let i = copia.length - 1; i > 0; i--) {
    const j = Math.floor(rnd() * (i + 1));
    const tmp = copia[i]; copia[i] = copia[j]; copia[j] = tmp;
  }
  return copia;
}

/** Devuelve el escalón de la escala de desempeño que corresponde a un porcentaje. */
function resolverNivelDesempeno(porcentaje) {
  const pct = Number(porcentaje) || 0;
  for (let i = 0; i < ESCALA_DESEMPENO.length; i++) {
    if (pct >= ESCALA_DESEMPENO[i].min) return ESCALA_DESEMPENO[i];
  }
  return ESCALA_DESEMPENO[ESCALA_DESEMPENO.length - 1];
}

/** Identificador corto y legible con prefijo. */
function nuevoId(prefijo) {
  return prefijo + "_" + Utilities.getUuid().replace(/-/g, "").slice(0, 12);
}

/** Fecha formateada de forma segura. */
function formatearFecha(valor, patron = "yyyy-MM-dd HH:mm:ss") {
  try {
    const d = valor instanceof Date ? valor : new Date(valor);
    if (isNaN(d.getTime())) return "";
    return Utilities.formatDate(d, obtenerZonaHoraria(), patron);
  } catch (e) {
    return "";
  }
}

/**
 * [OPT-4] Zona horaria única de todo el sistema.
 * El script y la hoja de cálculo pueden estar en husos distintos (pasa al copiar
 * un libro entre cuentas): eso desplaza deadlines de módulo y sellos de intento.
 * Aquí manda `APP_TIMEZONE` si está definida; si no, la del script.
 * Cacheada por ejecución para no golpear ScriptProperties dentro de bucles.
 */
let _CACHE_TZ = null;
function obtenerZonaHoraria() {
  if (_CACHE_TZ) return _CACHE_TZ;
  try {
    _CACHE_TZ = PropertiesService.getScriptProperties().getProperty("APP_TIMEZONE") ||
                Session.getScriptTimeZone();
  } catch (e) {
    _CACHE_TZ = "America/Bogota";
  }
  return _CACHE_TZ;
}

/** Configura la zona horaria del sistema desde el menú y avisa si difiere de la hoja. */
function configurarZonaHoraria() {
  exigirOrigenInterno("configurarZonaHoraria");
  const ui = SpreadsheetApp.getUi();
  const props = PropertiesService.getScriptProperties();
  let tzHoja = "";
  try { tzHoja = SpreadsheetApp.getActiveSpreadsheet().getSpreadsheetTimeZone(); } catch (e) { /* sin hoja */ }
  let tzScript = "";
  try { tzScript = Session.getScriptTimeZone(); } catch (e) { /* sin sesión */ }

  const aviso = (tzHoja && tzScript && tzHoja !== tzScript)
    ? `\n\n⚠️ La hoja está en ${tzHoja} y el script en ${tzScript}. Fija una para evitar desfases en plazos y sellos de intento.`
    : "";

  const resp = ui.prompt("🌎 Zona Horaria del Sistema",
    `Actual: ${obtenerZonaHoraria()}\nHoja: ${tzHoja || "?"} · Script: ${tzScript || "?"}` +
    aviso + "\n\nEscribe la zona (ej. America/Bogota) o deja vacío para usar la del script:",
    ui.ButtonSet.OK_CANCEL);
  if (resp.getSelectedButton() !== ui.Button.OK) return;

  const valor = resp.getResponseText().trim();
  if (valor) props.setProperty("APP_TIMEZONE", valor);
  else props.deleteProperty("APP_TIMEZONE");
  _CACHE_TZ = null;
  notificarUsuario("Zona horaria: " + obtenerZonaHoraria(), "Configuración", 4);
}

// -------------------------------------------------------------------------------------
// 0.3 [OPT-1] Agregados costosos con revisión de catálogo
// -------------------------------------------------------------------------------------

/**
 * Todo cálculo O(n) sobre el catálogo (filtros, estadísticas, panel de módulos)
 * pasa por aquí. El resultado se guarda en CacheService (rápido, hasta 6 h) y
 * ADEMÁS en ScriptProperties junto al número de revisión del catálogo.
 * Cuando el caché expira pero el catálogo no cambió, se sirve el respaldo sin
 * recorrer una sola fila: el recálculo ocurre solo tras una escritura real.
 */
function obtenerRevisionCatalogo() {
  try {
    return parseInt(PropertiesService.getScriptProperties().getProperty(PROP_REVISION_CATALOGO), 10) || 0;
  } catch (e) {
    return 0;
  }
}

/** La llama invalidarCacheAPI(): marca que el catálogo cambió. */
function incrementarRevisionCatalogo() {
  exigirOrigenInterno("incrementarRevisionCatalogo");
  try {
    const props = PropertiesService.getScriptProperties();
    const actual = parseInt(props.getProperty(PROP_REVISION_CATALOGO), 10) || 0;
    props.setProperty(PROP_REVISION_CATALOGO, String(actual + 1));
    return actual + 1;
  } catch (e) {
    return 0;
  }
}

/**
 * @param {string} clave       clave de caché canónica
 * @param {Function} calcular  función sin argumentos que produce el agregado
 * @param {number} segundos    TTL en CacheService
 * @param {boolean} forzar     ignora caché y respaldo, y recalcula
 */
function obtenerAgregadoConRevision(clave, calcular, segundos = 21600, forzar = false) {
  exigirOrigenInterno("obtenerAgregadoConRevision");
  const revision = obtenerRevisionCatalogo();
  const cache = CacheService.getScriptCache();

  if (!forzar) {
    // 1) Caché caliente.
    try {
      const enCache = cache.get(clave);
      if (enCache) {
        const obj = JSON.parse(enCache);
        if (obj && obj.__rev === revision) { obj.__origen = "cache"; return obj; }
      }
    } catch (e) { /* caché corrupta: se ignora */ }

    // 2) Respaldo persistente: sobrevive a la expiración del caché.
    try {
      const respaldo = PropertiesService.getScriptProperties().getProperty(PROP_RESPALDO_PREFIJO + clave);
      if (respaldo) {
        const obj = JSON.parse(respaldo);
        if (obj && obj.__rev === revision) {
          obj.__origen = "respaldo";
          try { cache.put(clave, respaldo, segundos); } catch (e2) { /* > 100 KB */ }
          return obj;
        }
      }
    } catch (e) { /* respaldo corrupto: se recalcula */ }
  }

  // 3) Recálculo real.
  const resultado = calcular() || {};
  resultado.__rev = revision;
  resultado.__origen = "calculado";
  const serializado = JSON.stringify(resultado);
  try { cache.put(clave, serializado, segundos); } catch (e) { /* > 100 KB */ }
  // ScriptProperties admite 9 KB por valor: solo respaldamos agregados compactos.
  if (serializado.length < 8500) {
    try { PropertiesService.getScriptProperties().setProperty(PROP_RESPALDO_PREFIJO + clave, serializado); }
    catch (e) { /* cuota de propiedades */ }
  }
  return resultado;
}

// =====================================================================================
// 1. LOGGING CENTRALIZADO MULTINIVEL, DEAD LETTER QUEUE Y MANTENIMIENTO — [MEJORAS 7, 9, 15]
// =====================================================================================

/**
 * [MEJORA 7] Punto único de auditoría. Sustituye a todos los Logger.log dispersos.
 * @param {string} accion   Categoría corta del evento (ej. "Ingesta", "LMS", "Seguridad").
 * @param {string} detalle  Descripción legible del evento.
 * @param {string} nivel    DEBUG | INFO | WARN | ERROR (por defecto INFO).
 */
function registrarLogActividad(accion, detalle, nivel = "INFO") {
  exigirOrigenInterno("registrarLogActividad");
  const severidad = NIVELES_LOG.indexOf(String(nivel).toUpperCase()) === -1 ? "INFO" : String(nivel).toUpperCase();
  const texto = (detalle === undefined || detalle === null) ? "" : detalle.toString();

  // Consola de Apps Script: siempre disponible, útil para depuración en Ejecuciones.
  try {
    // En el motor V8, console.log va a Cloud Logging (persistente y consultable).
    // Logger.log es el registro por ejecución que muestra el editor: se añade
    // para errores porque es lo primero que se abre al depurar un fallo.
    console.log("[" + severidad + "][" + accion + "] " + texto.slice(0, 900));
    if (severidad === "ERROR" || severidad === "WARN") {
      Logger.log("[" + severidad + "][" + accion + "] " + texto.slice(0, 900));
    }
  } catch (e) { /* entorno sin console */ }

  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    if (!ss) return;
    let log = ss.getSheetByName("_Log_Actividad");
    if (!log) {
      log = ss.insertSheet("_Log_Actividad");
      log.getRange("A1:E1").setValues([["Timestamp", "Nivel", "Usuario", "Acción", "Detalle"]])
        .setFontWeight("bold").setBackground("#1f2937").setFontColor("#ffffff");
      log.setFrozenRows(1);
      log.hideSheet();
    }
    // Migración transparente desde el formato de 4 columnas de v2026.3.5.
    if (log.getRange("B1").getValue() !== "Nivel") {
      log.insertColumnAfter(1);
      log.getRange("B1").setValue("Nivel").setFontWeight("bold").setBackground("#1f2937").setFontColor("#ffffff");
    }
    let usuario = "Sistema/Trigger";
    try { usuario = Session.getActiveUser().getEmail() || usuario; } catch (e) { /* sin permisos */ }

    log.appendRow([
      Utilities.formatDate(new Date(), obtenerZonaHoraria(), "yyyy-MM-dd HH:mm:ss"),
      severidad,
      usuario,
      accion,
      texto.slice(0, 2000)
    ]);
  } catch (e) { /* nunca debe interrumpir el flujo de negocio */ }
}

/** Atajos semánticos de logging. */
function logInfo(accion, detalle) { registrarLogActividad(accion, detalle, "INFO"); }
function logWarn(accion, detalle) { registrarLogActividad(accion, detalle, "WARN"); }
function logError(accion, detalle) { registrarLogActividad(accion, detalle, "ERROR"); }
function logDebug(accion, detalle) { registrarLogActividad(accion, detalle, "DEBUG"); }

/** Esquema de la Dead Letter Queue. Único sitio donde se declara su orden. */
const CABECERAS_DLQ = [
  "Fecha Aislamiento", "Fila Original", "URL Video", "Título",
  "Causa de Falla", "HTTP Code", "Intentos Fallidos", "Acción", "Stack Trace"
];

/**
 * Crea (si no existe) la hoja de la Dead Letter Queue con columna de código HTTP [MEJORA 9].
 */
function crearPestanaDeadLetterQueue() {
  exigirOrigenInterno("crearPestanaDeadLetterQueue");
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let dlq = ss.getSheetByName("_Dead_Letter_Queue");
  const col = CABECERAS_DLQ.indexOf("HTTP Code") + 1;
  if (!dlq) {
    dlq = ss.insertSheet("_Dead_Letter_Queue");
    dlq.getRange(1, 1, 1, CABECERAS_DLQ.length).setValues([CABECERAS_DLQ])
      .setFontWeight("bold").setBackground("#991b1b").setFontColor("#ffffff");
    dlq.setFrozenRows(1);
    dlq.hideSheet();
  } else if (dlq.getRange(1, col).getValue() !== "HTTP Code") {
    /* Migración desde el esquema de 8 columnas de v2026.3.5. Las posiciones
       salen de CABECERAS_DLQ y no de letras escritas a mano: «F1» dejaría de
       ser la columna correcta en cuanto alguien añadiera un campo antes. */
    dlq.insertColumnsAfter(col - 1, 1);
    dlq.getRange(1, col).setValue("HTTP Code")
      .setFontWeight("bold").setBackground("#991b1b").setFontColor("#ffffff");
  }
  return dlq;
}

/**
 * ¿Ya está esta fila en la cola? Devuelve su número de fila en la DLQ, o 0.
 *
 * Se compara por URL además de por número de fila porque el número solo no
 * basta: si alguien inserta o borra filas del catálogo, la 148 de ayer es otro
 * video hoy, y actualizar su entrada borraría el problema real.
 */
function buscarFilaEnDLQ(dlq, filaNum, url) {
  const ultima = dlq.getLastRow();
  if (ultima < 2) return 0;
  const valores = dlq.getRange(2, 2, ultima - 1, 2).getValues();   // Fila Original + URL
  const objetivo = (url || "").toString().trim();
  for (let i = 0; i < valores.length; i++) {
    if (Number(valores[i][0]) === Number(filaNum) &&
        (valores[i][1] || "").toString().trim() === objetivo) return i + 2;
  }
  return 0;
}

/**
 * [MEJORA 9] Aísla un registro fallido guardando además el código HTTP para diagnóstico.
 */
function registrarFallaEnDLQ(filaNum, url, titulo, causa, httpCode, stackTrace = "") {
  exigirOrigenInterno("registrarFallaEnDLQ");
  try {
    const dlq = crearPestanaDeadLetterQueue();
    const mensaje = (causa || "").toString().slice(0, 500);

    /* La misma fila NO se apunta dos veces.
       Antes se hacía appendRow sin mirar, y como el contador de intentos se
       borra al aislar, la siguiente pasada volvía a fallar tres veces y a
       aislar la MISMA fila otra vez. Una cola con ocho copias del mismo video
       no dice «ocho problemas»: dice el mismo problema ocho veces, y entierra
       los demás. Ahora se actualiza la entrada existente y se lleva la cuenta
       de cuántas veces ha vuelto a fallar. */
    const existente = buscarFilaEnDLQ(dlq, filaNum, url);
    if (existente > 0) {
      const previos = Number(dlq.getRange(existente, 7).getValue()) || 3;
      dlq.getRange(existente, 1, 1, CABECERAS_DLQ.length).setValues([[
        new Date(), filaNum || 0, url || "", titulo || "", mensaje,
        httpCode || 0, previos + 1, "Aislado en DLQ (reincidente)",
        (stackTrace || "").toString().slice(0, 500)
      ]]);
      logError("DLQ", `Fila ${filaNum} vuelve a fallar (${previos + 1} veces): ${causa}`);
      return;
    }

    dlq.appendRow([
      new Date(),
      filaNum || 0,
      url || "",
      titulo || "",
      mensaje,
      httpCode || 0,
      3,
      "Aislado en DLQ",
      (stackTrace || "").toString().slice(0, 500)
    ]);
    logError("DLQ", `Fila ${filaNum} aislada (HTTP ${httpCode || 0}): ${causa}`);
  } catch (e) {
    logError("DLQ", "No se pudo escribir en la DLQ: " + e.message);
  }
}

/**
 * Contabiliza fallas por fila y aísla en DLQ tras 3 intentos, o de inmediato
 * cuando el error es definitivo, según `esFalloDefinitivo()` [MEJORA 9].
 */
/* [v2.6.16] `filaMem` es la fila del bloque que la ingesta tiene en memoria.
 *
 * Sin esto había una carrera silenciosa: la ingesta lee 100 filas con
 * `getValues()`, y mientras las procesa estas funciones escribían el Estado y
 * el Error DIRECTAMENTE en la hoja. Al terminar, la ingesta volcaba su copia
 * —leída ANTES, sin esos cambios— con `setValues()`, y borraba lo que se
 * acababa de escribir. Solo pasaba si alguna otra fila del mismo bloque había
 * tenido éxito, que es lo que hace `setValues` correr, y por eso parecía
 * aleatorio: vimeo.com/1223276889 salía vacío en el catálogo y aislado en la
 * DLQ al mismo tiempo. Las dos cosas eran ciertas.
 *
 * Con `filaMem` se escribe en la copia que se va a volcar, no contra ella. Sin
 * `filaMem` —llamadas desde fuera de un bloque— se escribe en la hoja como
 * siempre. El registro en la DLQ y el contador de intentos no cambian: viven en
 * otra hoja y en propiedades, y ahí no hay conflicto. */
function escribirEnFila(filaNum, filaMem, columna, valor) {
  exigirOrigenInterno("escribirEnFila");
  if (filaMem) { filaMem[columna] = valor; return; }
  try { obtenerHojaDatos().getRange(filaNum, columna + 1).setValue(valor); }
  catch (e) { /* fila fuera de rango */ }
}

function gestionarErrorFila(filaNum, errorMsg, url = "", titulo = "", stackTrace = "", httpCode = 0, filaMem = null) {
  exigirOrigenInterno("gestionarErrorFila");
  const hoja = obtenerHojaDatos();
  const mensaje = (errorMsg || "Error desconocido").toString();
  /* Las columnas salen de IDX. Estaban escritas a mano —20 para el error, 15
     para el estado— y eran correctas en el esquema ANTERIOR. Tras la
     reordenación, la 20 pasó a ser Estado y la 15 Fecha de Publicación, así que
     este bloque escribía el mensaje de error dentro del Estado («Vimeo HTTP
     401» donde debía decir «🟡 Pendiente») y el «❌ Error» dentro de la fecha,
     borrándola. Dos columnas destrozadas cada vez que una API fallaba, sin que
     nada lo delatara. */
  escribirEnFila(filaNum, filaMem, IDX.ERROR, mensaje.slice(0, 255));

  /* 429 es «vuelve más tarde», no «este video está roto».
     Cinco filas de Vimeo acabaron aisladas por HTTP 429 —el límite de peticiones
     por minuto— cuando lo único que les pasaba es que iban demasiado rápido.
     Aislarlas obliga a rescatarlas a mano; el video estaba perfectamente. Se
     deja anotado el motivo y el Estado intacto, para que la siguiente pasada lo
     reintente sin que nadie tenga que hacer nada. */
  if (httpCode === 429) {
    anotarPendienteDeConfiguracion(filaNum,
      "El proveedor pidió esperar (HTTP 429). Se reintentará en la próxima pasada.", filaMem);
    return;
  }

  const props = PropertiesService.getUserProperties();
  const countKey = "FAIL_COUNT_" + filaNum;
  const count = parseInt(props.getProperty(countKey) || "0", 10) + 1;
  props.setProperty(countKey, count.toString());

  /* [v2.6.19] Una sola fuente de verdad. Esta línea se escribió antes que
     `esFalloDefinitivo` y se quedó con su propia lista, que incluía el 403 —
     justo el código que 6.13 declaró transitorio, porque significa «no tienes
     permiso», no «el video no está». Con la lista vieja, un 403 de Vimeo por
     una credencial caducada aislaba la fila en la cola al primer intento. */
  const terminal = esFalloDefinitivo(httpCode);
  if (count >= 3 || terminal) {
    escribirEnFila(filaNum, filaMem, IDX.ESTADO, "❌ Error");
    registrarFallaEnDLQ(filaNum, url, titulo, mensaje, httpCode, stackTrace);
    props.deleteProperty(countKey);
    notificarUsuario(t("toast_dlq_alerta"), "DLQ", 4);
  } else {
    logWarn("Fila con error", `Fila ${filaNum} (intento ${count}/3): ${mensaje}`);
  }
}

/**
 * Anota en una fila que falta configurar algo, sin contarla como fallo.
 *
 * «No tengo la credencial para leer este video» y «este video está roto» son
 * cosas distintas con soluciones distintas, y `gestionarErrorFila` las trataba
 * igual: tres pasadas y a la cola de fallos. Un video público de Twitch acababa
 * aislado por una clave que nadie había puesto. Aquí solo se deja escrito el
 * motivo; el Estado no se toca, así que la siguiente pasada lo vuelve a
 * intentar en cuanto la credencial exista.
 */
function anotarPendienteDeConfiguracion(filaNum, mensaje, filaMem = null) {
  escribirEnFila(filaNum, filaMem, IDX.ERROR,
    (mensaje || "Falta configuración").toString().slice(0, 255));
  logWarn("Configuración", `Fila ${filaNum} en espera: ${mensaje}`);
}

/**
 * Colapsa las entradas repetidas que ya están en la cola.
 *
 * Para las colas que crecieron antes de que `registrarFallaEnDLQ` supiera
 * actualizar en vez de añadir. Se conserva la entrada MÁS RECIENTE de cada
 * (fila, URL) —su causa es la vigente— y su contador de intentos pasa a ser la
 * suma de las copias, que es la información que las copias contenían.
 */
function depurarDuplicadosDLQ() {
  exigirOrigenInterno("depurarDuplicadosDLQ");
  const dlq = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("_Dead_Letter_Queue");
  if (!dlq || dlq.getLastRow() < 3) return { eliminadas: 0, restantes: dlq ? Math.max(dlq.getLastRow() - 1, 0) : 0 };

  const filas = dlq.getRange(2, 1, dlq.getLastRow() - 1, CABECERAS_DLQ.length).getValues();
  const porClave = {};
  const orden = [];
  filas.forEach(f => {
    const clave = Number(f[1]) + "|" + (f[2] || "").toString().trim();
    if (!porClave[clave]) { porClave[clave] = f.slice(); orden.push(clave); }
    else {
      const previo = porClave[clave];
      const intentos = (Number(previo[6]) || 0) + (Number(f[6]) || 0);
      // La más reciente manda; el conteo se acumula.
      const gana = (f[0] instanceof Date && previo[0] instanceof Date && f[0] > previo[0]) ? f.slice() : previo;
      gana[6] = intentos;
      porClave[clave] = gana;
    }
  });

  const unicas = orden.map(k => porClave[k]);
  const eliminadas = filas.length - unicas.length;
  if (eliminadas <= 0) return { eliminadas: 0, restantes: filas.length };

  dlq.getRange(2, 1, filas.length, CABECERAS_DLQ.length).clearContent();
  dlq.getRange(2, 1, unicas.length, CABECERAS_DLQ.length).setValues(unicas);
  logInfo("DLQ", `Depuradas ${eliminadas} entradas duplicadas; quedan ${unicas.length}.`);
  return { eliminadas: eliminadas, restantes: unicas.length };
}

function depurarDuplicadosDLQUI() {
  exigirOrigenInterno("depurarDuplicadosDLQUI");
  const r = depurarDuplicadosDLQ();
  alertarUsuario(r.eliminadas === 0
    ? `No hay entradas repetidas. La cola tiene ${r.restantes} registros.`
    : `Se colapsaron ${r.eliminadas} entradas repetidas. Quedan ${r.restantes} problemas distintos.`,
    "Dead Letter Queue");
  return r;
}

/**
 * Aparta una fila cuya URL no es un video, con el motivo escrito al lado.
 *
 * No es un fallo ni va a la cola: no hay nada que reintentar. Se marca
 * «⚪ Descartado» —un estado que ya existe y que la ingesta respeta— y el
 * motivo queda visible en la columna de error para que se pueda corregir la
 * URL y devolverla a «🟡 Pendiente» a mano.
 */
function marcarEnlaceNoProcesable(filaNum, motivo, filaMem = null) {
  exigirOrigenInterno("marcarEnlaceNoProcesable");
  escribirEnFila(filaNum, filaMem, IDX.ERROR, (motivo || "").toString().slice(0, 255));
  escribirEnFila(filaNum, filaMem, IDX.ESTADO, "⚪ Descartado");
  PropertiesService.getUserProperties().deleteProperty("FAIL_COUNT_" + filaNum);
  logWarn("Ingesta", `Fila ${filaNum} apartada: ${motivo}`);
}

/** Abre e inspecciona visualmente la DLQ. */
function abrirDeadLetterQueue() {
  const dlq = crearPestanaDeadLetterQueue();
  dlq.showSheet();
  dlq.activate();
  notificarUsuario("🚨 Inspecciona las filas aisladas y corrígelas antes de reprocesarlas.", "DLQ", 6);
}

/**
 * Devuelve las filas del catálogo aisladas en DLQ al estado "Pendiente" para reintento.
 */
function reprocesarRegistrosDLQ() {
  exigirOrigenInterno("reprocesarRegistrosDLQ");
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const dlq = ss.getSheetByName("_Dead_Letter_Queue");
  if (!dlq || dlq.getLastRow() < 2) {
    alertarUsuario("No hay registros en la Dead Letter Queue.", "DLQ");
    return 0;
  }
  const hoja = obtenerHojaDatos();
  const filas = dlq.getRange(2, 2, dlq.getLastRow() - 1, 1).getValues().flat();
  let restaurados = 0;
  filas.forEach(f => {
    const num = parseInt(f, 10);
    if (num >= 2 && num <= hoja.getLastRow()) {
      hoja.getRange(num, IDX.ESTADO + 1).setValue("🟡 Pendiente");
      hoja.getRange(num, IDX.ERROR + 1).setValue("");
      PropertiesService.getUserProperties().deleteProperty("FAIL_COUNT_" + num);
      restaurados++;
    }
  });
  logInfo("DLQ", `Reprocesados ${restaurados} registros aislados.`);
  alertarUsuario(`Se devolvieron ${restaurados} filas a la cola de procesamiento.`, "DLQ");
  return restaurados;
}

/** Restaura a "Pendiente" todas las filas marcadas con error en el catálogo. */
function reiniciarErroresCola() {
  exigirOrigenInterno("reiniciarErroresCola");
  const hoja = obtenerHojaDatos();
  const ultimaFila = hoja.getLastRow();
  if (ultimaFila < 2) {
    alertarUsuario(t("alert_catalogo_vacio"));
    return 0;
  }

  let restaurados = 0;
  iterarCatalogoPorBloques(function (datos, filaInicio) {
    let mutado = false;
    for (let i = 0; i < datos.length; i++) {
      if (datos[i][IDX.ESTADO] === "❌ Error" || datos[i][IDX.ERROR]) {
        datos[i][IDX.ESTADO] = "🟡 Pendiente";
        datos[i][IDX.ERROR] = "";
        PropertiesService.getUserProperties().deleteProperty("FAIL_COUNT_" + (filaInicio + i));
        restaurados++;
        mutado = true;
      }
    }
    return mutado;
  });

  if (restaurados > 0) {
    logInfo("Cola", `Se restauraron ${restaurados} registros fallidos.`);
    alertarUsuario("✅ Se restauraron " + restaurados + " registros marcados como fallidos.");
  } else {
    alertarUsuario("No se detectaron registros con error en la hoja.");
  }
  return restaurados;
}

/**
 * [MEJORA 15] Mantenimiento programado: purga DLQ, logs e históricos con más de
 * DIAS_RETENCION_HISTORICO días. Elimina rangos contiguos (eficiente y sin timeouts).
 */
function ejecutarMantenimientoSemanal_() {
  marcarOrigenConfiable();   // [SEC-1] entrada legítima del servidor
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const corte = new Date(Date.now() - (DIAS_RETENCION_HISTORICO * 24 * 60 * 60 * 1000));
  // Solo se purga bitácora. Ninguna hoja de ESTADO (progreso, intentos, respuestas,
  // refuerzo, calificaciones, bonos) entra aquí: de ellas dependen desbloqueos y certificados.
  const objetivo = HOJAS_PURGABLES;
  let purgados = 0;

  objetivo.forEach(nombre => {
    const sheet = ss.getSheetByName(nombre);
    if (!sheet || sheet.getLastRow() < 2) return;
    const fechas = sheet.getRange(2, 1, sheet.getLastRow() - 1, 1).getValues();

    // Elimina rangos contiguos desde el final hacia el inicio (una sola llamada por bloque).
    let bloqueTam = 0;
    for (let i = fechas.length - 1; i >= 0; i--) {
      const valor = fechas[i][0];
      const fecha = valor instanceof Date ? valor : new Date(valor);
      const vencida = !isNaN(fecha.getTime()) && fecha < corte;
      if (vencida) bloqueTam++;
      if ((!vencida || i === 0) && bloqueTam > 0) {
        const primeraFila = (vencida ? i : i + 1) + 2;
        sheet.deleteRows(primeraFila, bloqueTam);
        purgados += bloqueTam;
        bloqueTam = 0;
      }
    }
  });

  // Limpieza de contadores de fallas huérfanos.
  try {
    const userProps = PropertiesService.getUserProperties();
    const todas = userProps.getProperties();
    const ultima = obtenerHojaDatos().getLastRow();
    Object.keys(todas).forEach(k => {
      if (k.indexOf("FAIL_COUNT_") === 0) {
        const fila = parseInt(k.replace("FAIL_COUNT_", ""), 10);
        if (!fila || fila > ultima) userProps.deleteProperty(k);
      }
    });
  } catch (e) { /* opcional */ }

  limpiarTriggersHuerfanos();
  const caducados = caducarIntentosAbandonados();
  const tareasPurgadas = purgarTareasCompletadas();
  const tokensPurgados = purgarTokensCaducados();   // [OPT-16]

  // [OPT-1] Los respaldos de agregados de revisiones antiguas ocupan cuota de
  // ScriptProperties sin servir para nada: se retiran los que ya no coinciden.
  try {
    const props = PropertiesService.getScriptProperties();
    const revision = obtenerRevisionCatalogo();
    const todas = props.getProperties();
    Object.keys(todas).forEach(k => {
      if (k.indexOf(PROP_RESPALDO_PREFIJO) !== 0) return;
      try {
        const obj = JSON.parse(todas[k]);
        if (!obj || obj.__rev !== revision) props.deleteProperty(k);
      } catch (e) { props.deleteProperty(k); }
    });
  } catch (e) { /* opcional */ }

  logInfo("Mantenimiento", `Purga automatizada: ${purgados} filas eliminadas (> ${DIAS_RETENCION_HISTORICO} días); ` +
    `${caducados} intentos caducados; ${tareasPurgadas} tareas resueltas retiradas de la cola; ` +
    `${tokensPurgados} tokens caducados retirados.`);
  notificarUsuario(t("toast_mantenimiento", { purgados: purgados }), "Mantenimiento", 5);
  return purgados;
}

/** Ejecuta el mantenimiento bajo demanda desde el menú. */
function ejecutarMantenimientoManual() {
  exigirOrigenInterno("ejecutarMantenimientoManual");
  const purgados = ejecutarMantenimientoSemanal_();
  alertarUsuario(t("toast_mantenimiento", { purgados: purgados }), "Mantenimiento");
}

// =====================================================================================
// 2. GESTIÓN CENTRALIZADA Y SEGURA DE TRIGGERS — [MEJORA 2]
// =====================================================================================

/** Elimina todos los disparadores asociados a una función concreta. */
function limpiarTriggersPorFuncion(nombreFuncion) {
  let eliminados = 0;
  ScriptApp.getProjectTriggers().forEach(trg => {
    if (trg.getHandlerFunction() === nombreFuncion) {
      ScriptApp.deleteTrigger(trg);
      eliminados++;
    }
  });
  if (eliminados > 0) logDebug("Triggers", `Eliminados ${eliminados} triggers de ${nombreFuncion}.`);
  return eliminados;
}

/** Alias retrocompatible con nomenclaturas previas. */
function limpiarTriggersObsoletos(nombreFuncion) {
  return limpiarTriggersPorFuncion(nombreFuncion);
}

/** Compatibilidad con v2026.3.5: limpia los triggers encadenados de ingesta. */
function limpiarTriggersIngesta() {
  exigirOrigenInterno("limpiarTriggersIngesta");
  const eliminados = limpiarTriggersPorFuncion("procesarColaConAntiTimeout_");
  PropertiesService.getScriptProperties().deleteProperty("INGESTA_TRIGGER_ID");
  return eliminados;
}

/**
 * [MEJORA 2] Registro seguro: evita duplicados y respeta el tope de 19 triggers.
 * @param {TriggerBuilder} builder Constructor ya configurado (sin .create()).
 * @param {string} nombreFuncion   Función manejadora (para deduplicar).
 */
function registrarTriggerSeguro(builder, nombreFuncion) {
  limpiarTriggersPorFuncion(nombreFuncion);
  if (ScriptApp.getProjectTriggers().length >= LIMITE_TRIGGERS_SEGURO) {
    logWarn("Triggers", t("err_triggers_limite", { limite: LIMITE_TRIGGERS_SEGURO }));
    return null;
  }
  const trig = builder.create();
  logInfo("Triggers", `Trigger instalado: ${nombreFuncion}`);
  return trig;
}

/**
 * Elimina triggers cuya función manejadora ya no existe en el proyecto
 * o que apuntan a formularios eliminados.
 */
function limpiarTriggersHuerfanos() {
  let eliminados = 0;
  ScriptApp.getProjectTriggers().forEach(trg => {
    const fn = trg.getHandlerFunction();
    let existe = true;
    try {
      existe = typeof globalThis[fn] === "function";
    } catch (e) {
      existe = true; // ante la duda, no se elimina
    }
    if (!existe) {
      try { ScriptApp.deleteTrigger(trg); eliminados++; } catch (e) { /* ignora */ }
    }
  });
  if (eliminados > 0) logWarn("Triggers", `Eliminados ${eliminados} triggers huérfanos.`);
  return eliminados;
}

/**
 * [MEJORA 2] Panel de administración de triggers: inventario, uso de cuota y depuración.
 */
function auditarTriggersUI() {
  exigirOrigenInterno("auditarTriggersUI");
  const triggers = ScriptApp.getProjectTriggers();
  const resumen = {};
  triggers.forEach(trg => {
    const fn = trg.getHandlerFunction();
    resumen[fn] = (resumen[fn] || 0) + 1;
  });

  const detalle = Object.keys(resumen).sort().map(k => `• ${k} → ${resumen[k]}`).join("\n") || "(sin triggers activos)";
  const mensaje = `Triggers activos: ${triggers.length}/${LIMITE_TRIGGERS_SEGURO + 1}\n\n${detalle}\n\n` +
    `¿Deseas eliminar los duplicados y los triggers huérfanos?`;

  if (!hayInterfazDisponible()) {
    logInfo("Triggers", mensaje);
    return resumen;
  }

  const ui = SpreadsheetApp.getUi();
  const resp = ui.alert("🧭 Auditoría de Disparadores", mensaje, ui.ButtonSet.YES_NO);
  if (resp !== ui.Button.YES) return resumen;

  let eliminados = limpiarTriggersHuerfanos();
  const vistos = {};
  ScriptApp.getProjectTriggers().forEach(trg => {
    let origen = "";
    try { origen = trg.getTriggerSourceId() || ""; } catch (e) { origen = ""; }
    const clave = trg.getHandlerFunction() + "|" + trg.getEventType() + "|" + origen;
    if (vistos[clave]) {
      try { ScriptApp.deleteTrigger(trg); eliminados++; } catch (e) { /* ignora */ }
    } else {
      vistos[clave] = true;
    }
  });

  const activos = ScriptApp.getProjectTriggers().length;
  logInfo("Triggers", `Auditoría manual: ${activos} activos, ${eliminados} eliminados.`);
  notificarUsuario(t("toast_triggers_ok", { activos: activos, eliminados: eliminados }), "Triggers", 5);
  return resumen;
}

// -------------------------------------------------------------------------------------
// 2.bis [6.34] Migración de disparadores a los nombres privados
// -------------------------------------------------------------------------------------
/*
 * POR QUÉ ESTO NO ES UN BOTÓN QUE LO HAGA TODO.
 *
 * Un disparador guarda el nombre de su función como TEXTO. Cambiar el nombre en
 * el código no toca el disparador: sigue existiendo, se ejecuta a su hora y
 * falla, en silencio, porque no hay nadie delante. Y no se puede renombrar: hay
 * que borrarlo y crear otro, lo que significa que durante un instante puede no
 * haber ninguno, o haber dos.
 *
 * Por eso son DOS funciones y no una: primero se mira, se lee lo que dice, y
 * solo entonces se migra. Ninguna de las dos toca los disparadores de otra
 * cuenta, porque `getProjectTriggers()` solo ve los de quien ejecuta — si hay
 * más administradores, hay que preguntarles.
 */

/** Nombre viejo → nombre nuevo, para reconocer lo que hay que sustituir. */
const RENOMBRADOS_6_34 = {
  ejecutarMantenimientoSemanal: "ejecutarMantenimientoSemanal_",
  actualizarDashboardPeriodico: "actualizarDashboardPeriodico_",
  crearBackupAutomatico: "crearBackupAutomatico_",
  exportarCatalogoAJsonSilencioso: "exportarCatalogoAJsonSilencioso_",
  disparadorNocturnoFase2: "disparadorNocturnoFase2_",
  onEditControlMovilTrigger: "onEditControlMovilTrigger_",
  procesarColaTareasSilencioso: "procesarColaTareasSilencioso_",
  procesarColaConAntiTimeout: "procesarColaConAntiTimeout_",
  continuarEmbeddingsCatalogo: "continuarEmbeddingsCatalogo_",
  registrarRespuestaFormularioCentralizado: "registrarRespuestaFormularioCentralizado_"
};

/**
 * [6.35] Cada disparador se recrea SEGÚN LO QUE ES, no según si tengo una receta.
 *
 * La primera versión de esto daba por «temporal, ya lo recreará el código»
 * cualquier cosa sin horario declarado, y con eso borraba dos que no lo eran:
 * el de envío de formulario —que va atado a un formulario concreto y nadie lo
 * vuelve a crear solo— y la continuación de la ingesta, que es justo lo único
 * que iba a despertar al trabajo pendiente. Que el código sepa crear otra
 * continuación no significa que vaya a hacerlo después de borrar la única que
 * lo iba a llamar.
 *
 * Los tipos, y qué exige cada uno:
 *   · `periodico`    → horario fijo declarado aquí. Se recrea igual.
 *   · `evento`       → atado a un recurso (formulario, hoja). Se recrea PARA EL
 *                      MISMO recurso; sin recurso identificable no se toca.
 *   · `continuacion` → despierta un trabajo a medias. Se recrea como espera
 *                      corta, para no dejar el trabajo dormido.
 *   · `desconocido`  → no se toca y se informa. Lo que no sé clasificar no es
 *                      desechable: es pendiente de decidir.
 */
const RECETAS_DISPARADORES = {
  actualizarDashboardPeriodico_: { tipo: "periodico", descripcion: "cada hora",
    crear: () => ScriptApp.newTrigger("actualizarDashboardPeriodico_").timeBased().everyHours(1) },
  ejecutarMantenimientoSemanal_: { tipo: "periodico", descripcion: "domingos a las 03:00",
    crear: () => ScriptApp.newTrigger("ejecutarMantenimientoSemanal_")
      .timeBased().everyWeeks(1).onWeekDay(ScriptApp.WeekDay.SUNDAY).atHour(3) },
  crearBackupAutomatico_: { tipo: "periodico", descripcion: "domingos a las 23:00",
    crear: () => ScriptApp.newTrigger("crearBackupAutomatico_")
      .timeBased().everyWeeks(1).onWeekDay(ScriptApp.WeekDay.SUNDAY).atHour(23) },
  exportarCatalogoAJsonSilencioso_: { tipo: "periodico", descripcion: "cada 6 horas",
    crear: () => ScriptApp.newTrigger("exportarCatalogoAJsonSilencioso_").timeBased().everyHours(6) },
  disparadorNocturnoFase2_: { tipo: "periodico", descripcion: "todos los días a las 02:00",
    crear: () => ScriptApp.newTrigger("disparadorNocturnoFase2_").timeBased().everyDays(1).atHour(2) },
  procesarColaTareasSilencioso_: { tipo: "periodico", descripcion: "cada hora",
    crear: () => ScriptApp.newTrigger("procesarColaTareasSilencioso_").timeBased().everyHours(1) },

  /* [6.36] `exigeRecurso` se declara; NO se deduce de cuántos parámetros tiene
     la función. Deducirlo con `crear.length > 0` dejaba pasar sin recurso justo
     a la receta que no lo declaraba —la de la hoja— y esa usaba la hoja ACTIVA:
     un disparador de otra hoja se migraba a esta sin decir nada. Cambiar de
     recurso en silencio es peor que no migrar. */
  onEditControlMovilTrigger_: { tipo: "evento", exigeRecurso: true,
    descripcion: "al editar la hoja de origen",
    crear: (recurso) => {
      if (!recurso) throw new Error("Sin identificador de la hoja de origen: no se recrea.");
      /* Se abre POR ID, no se coge la activa: el disparador vuelve a la misma
         hoja a la que estaba atado, aunque no sea esta. */
      return ScriptApp.newTrigger("onEditControlMovilTrigger_")
        .forSpreadsheet(SpreadsheetApp.openById(recurso)).onEdit();
    } },
  registrarRespuestaFormularioCentralizado_: { tipo: "evento", exigeRecurso: true,
    descripcion: "al enviarse el formulario",
    /* El formulario NO se adivina: se toma del disparador que se sustituye. Sin
       ese identificador no hay forma de recrearlo bien, y crear uno apuntando a
       otro formulario sería peor que no hacer nada. */
    crear: (recurso) => {
      if (!recurso) throw new Error("Sin identificador del formulario: no se recrea.");
      return ScriptApp.newTrigger("registrarRespuestaFormularioCentralizado_")
        .forForm(FormApp.openById(recurso)).onFormSubmit();
    } },

  procesarColaConAntiTimeout_: { tipo: "continuacion",
    descripcion: "continuación de la ingesta, dentro de un minuto",
    crear: () => ScriptApp.newTrigger("procesarColaConAntiTimeout_").timeBased().after(60 * 1000) },
  continuarEmbeddingsCatalogo_: { tipo: "continuacion",
    descripcion: "continuación de los embeddings, dentro de un minuto",
    crear: () => ScriptApp.newTrigger("continuarEmbeddingsCatalogo_").timeBased().after(60 * 1000) }
};

/** Nombre real o renombrado → siempre el nuevo. Base de toda comparación. */
function normalizarNombreDisparador_(nombre) {
  return RENOMBRADOS_6_34[nombre] || nombre;
}

/**
 * Identidad de una TAREA, no de un nombre.
 *
 * Comparar por nombre literal decía que no había duplicados cuando estaban el
 * viejo y el nuevo del mismo trabajo —y el migrador creaba un tercero—. Y dos
 * formularios distintos con el mismo manejador son dos tareas legítimas, no un
 * duplicado. La identidad es el nombre normalizado más a qué está atado.
 */
function identidadDisparador_(t) {
  return [normalizarNombreDisparador_(t.funcion), t.origen, t.evento, t.recurso || ""].join("|");
}

/**
 * MIRAR. No cambia nada: dice qué hay, qué sobra y qué faltaría.
 */
function inventariarDisparadores() {
  exigirOrigenInterno("inventariarDisparadores");
  const existentes = ScriptApp.getProjectTriggers().map(trg => {
    let recurso = "";
    try { recurso = trg.getTriggerSourceId() || ""; } catch (e) { /* no todos lo tienen */ }
    return {
      id: trg.getUniqueId(),
      funcion: trg.getHandlerFunction(),
      origen: String(trg.getTriggerSource()),
      evento: String(trg.getEventType()),
      recurso: recurso
    };
  });

  const porIdentidad = {};
  existentes.forEach(t => {
    const k = identidadDisparador_(t);
    (porIdentidad[k] = porIdentidad[k] || []).push(t);
  });

  const conNombreViejo = existentes.filter(t => RENOMBRADOS_6_34[t.funcion]);
  /* [6.36] Contar solo los que ya tenían nombre nuevo dejaba fuera el caso que
     más duele: DOS viejos idénticos. Ninguno estaba «ya sustituido», así que el
     recorrido creaba un sustituto por cada uno y acababa con dos haciendo el
     mismo trabajo, sin un solo aviso.
     Un viejo y un nuevo sí es un estado recuperable —es un reintento a medias—;
     más de uno de cualquiera de los dos lados es una decisión humana: cuál se
     conserva no lo puede adivinar esto. */
  const duplicados = Object.keys(porIdentidad).filter(k => {
    const grupo = porIdentidad[k];
    const viejos = grupo.filter(t => Boolean(RENOMBRADOS_6_34[t.funcion])).length;
    return viejos > 1 || (grupo.length - viejos) > 1;
  });

  return {
    total: existentes.length,
    disparadores: existentes,
    conNombreViejo: conNombreViejo.map(t => {
      const nuevo = RENOMBRADOS_6_34[t.funcion];
      const receta = RECETAS_DISPARADORES[nuevo];
      /* ¿Ya existe el sustituto para ESTA misma tarea? Entonces no hay que
         crear nada: solo retirar el viejo. Es lo que hace que repetir la
         migración no multiplique disparadores. */
      const yaSustituido = (porIdentidad[identidadDisparador_(t)] || [])
        .some(o => o.funcion === nuevo);
      return {
        id: t.id, viejo: t.funcion, nuevo: nuevo,
        tipo: receta ? receta.tipo : "desconocido",
        horario: receta ? receta.descripcion : "(sin receta: no se toca)",
        recurso: t.recurso, yaSustituido: yaSustituido
      };
    }),
    duplicados: duplicados,
    noReconocidos: existentes
      .filter(t => !RENOMBRADOS_6_34[t.funcion] && !RECETAS_DISPARADORES[t.funcion])
      .map(t => t.funcion)
  };
}

/**
 * MIGRAR. Sustituye cada disparador con nombre viejo por el mismo con el nombre
 * nuevo, uno a uno, y solo cuando sabe recrearlo sin perder su trabajo.
 *
 * Se puede ejecutar dos veces sin miedo: si el sustituto ya existe para esa
 * misma tarea, no crea otro —solo retira el viejo—. Y si crear funciona pero
 * borrar falla, lo dice con esas palabras, para que el reintento sepa que ya
 * hay un sustituto y no vuelva a crearlo.
 *
 * @param {boolean} simular  true (por defecto) solo dice qué haría.
 */
function migrarDisparadoresANombresPrivados(simular = true) {
  exigirOrigenInterno("migrarDisparadoresANombresPrivados");
  /* [6.36] Leer el inventario y modificarlo son dos momentos, y entre uno y
     otro otra ejecución puede estar haciendo lo mismo: dos migraciones a la vez
     crean dos sustitutos de todo. El bloqueo se toma AQUÍ y no en la UI, porque
     mantenerlo mientras alguien lee un diálogo de confirmación es mantenerlo
     durante minutos. Simular no modifica nada, así que no lo necesita. */
  const cerrojo = simular ? null : LockService.getScriptLock();
  if (cerrojo) {
    try { cerrojo.waitLock(20000); }
    catch (e) {
      return { simulado: false, migrados: [], yaEstaban: [], intactos: [],
               fallos: ["Hay otra operación en curso sobre los disparadores. Inténtalo en un minuto."] };
    }
  }
  try {
  const inv = inventariarDisparadores();
  const parte = { simulado: simular, migrados: [], yaEstaban: [], intactos: [], fallos: [] };

  if (inv.duplicados.length) {
    parte.fallos.push("Hay tareas duplicadas (" + inv.duplicados.length +
      "). Resuélvelas antes de migrar: no se sabe cuál conservar.");
    return parte;
  }

  const borrarPorId = id => ScriptApp.getProjectTriggers()
    .filter(t => t.getUniqueId() === id)
    .forEach(t => ScriptApp.deleteTrigger(t));

  inv.conNombreViejo.forEach(d => {
    const receta = RECETAS_DISPARADORES[d.nuevo];

    /* Lo que no sé recrear, no lo toco. Conservar el viejo tampoco es gratis
       —su función ya no existe en el código, así que a su hora fallará— y por
       eso se informa con ese texto, no como si quedara resuelto. */
    if (!receta) {
      parte.intactos.push({ viejo: d.viejo, motivo:
        "sin receta de recreación; se deja instalado, pero su función ya no existe: " +
        "fallará a su hora hasta que se resuelva a mano" });
      return;
    }
    if (receta.exigeRecurso && !d.recurso) {
      parte.intactos.push({ viejo: d.viejo, motivo:
        "no se pudo identificar el recurso al que está atado; se deja como está" });
      return;
    }

    if (d.yaSustituido) {
      /* El sustituto ya está: esto es un reintento, o alguien lo creó a mano.
         Solo queda retirar el viejo. */
      if (!simular) {
        try { borrarPorId(d.id); }
        catch (e) { parte.fallos.push("no se pudo borrar " + d.viejo + ": " + e.message); return; }
      }
      parte.yaEstaban.push({ viejo: d.viejo, nuevo: d.nuevo });
      return;
    }

    if (simular) {
      parte.migrados.push({ viejo: d.viejo, nuevo: d.nuevo, tipo: receta.tipo,
                            horario: receta.descripcion });
      return;
    }

    let creado = false;
    try {
      receta.crear(d.recurso).create();     // primero el nuevo
      creado = true;
      borrarPorId(d.id);                     // y solo entonces el viejo
      parte.migrados.push({ viejo: d.viejo, nuevo: d.nuevo, tipo: receta.tipo,
                            horario: receta.descripcion });
      logInfo("Triggers", `Migrado ${d.viejo} → ${d.nuevo} (${receta.descripcion}).`);
    } catch (e) {
      if (creado) {
        /* El sustituto existe y el viejo también: los dos harán el mismo
           trabajo hasta que alguien borre el viejo. Se dice con todas las
           letras, porque es un estado que hay que cerrar a mano. */
        parte.fallos.push("SUSTITUTO CREADO pero el viejo sigue instalado (" + d.viejo +
          "): bórralo a mano en Apps Script → Activadores. Causa: " + e.message);
      } else {
        parte.fallos.push("no se pudo crear " + d.nuevo + ": " + e.message +
          " — el viejo sigue en su sitio, no se ha perdido nada.");
      }
      logError("Triggers", `Migración de ${d.viejo}: ${e.message}`);
    }
  });
  return parte;
  } finally {
    if (cerrojo) { try { cerrojo.releaseLock(); } catch (e) { /* ya liberado */ } }
  }
}

/** Enseña el inventario sin tocar nada. Es el paso que va antes de migrar. */
function inventariarDisparadoresUI() {
  exigirContextoHoja_("inventariarDisparadoresUI");
  marcarOrigenConfiable();
  const inv = inventariarDisparadores();
  let texto = "Disparadores instalados: " + inv.total + "\n\n";
  inv.disparadores.forEach(d => { texto += "• " + d.funcion + "\n"; });
  if (inv.conNombreViejo.length) {
    texto += "\nCon nombre anterior (hay que migrarlos): " + inv.conNombreViejo.length + "\n";
    inv.conNombreViejo.forEach(d => {
      texto += "• " + d.viejo + " → " + d.nuevo + "  [" + d.tipo + "]" +
        (d.yaSustituido ? " (sustituto ya creado)" : "") + "\n";
    });
  } else {
    texto += "\nNinguno con nombre anterior.";
  }
  if (inv.duplicados.length) texto += "\n⚠️ Tareas duplicadas: " + inv.duplicados.length;
  if (inv.noReconocidos.length) texto += "\nNo reconocidos: " + inv.noReconocidos.join(", ");
  texto += "\n\nEsta lista es la de TU cuenta. Los disparadores creados por otra " +
    "persona no se ven desde aquí.";
  alertarUsuario(texto, "🔁 Disparadores instalados");
}

/** Entrada desde el panel: enseña el inventario, pregunta, y migra de verdad. */
function migrarDisparadoresUI() {
  exigirContextoHoja_("migrarDisparadoresUI");
  marcarOrigenConfiable();
  const inv = inventariarDisparadores();

  if (inv.conNombreViejo.length === 0) {
    alertarUsuario(
      "No hay ningún disparador con nombre antiguo.\n\n" +
      "Instalados ahora mismo: " + inv.total +
      (inv.noReconocidos.length ? "\nNo reconocidos: " + inv.noReconocidos.join(", ") : ""),
      "🔁 Disparadores");
    return;
  }

  let texto = "Disparadores con el nombre anterior: " + inv.conNombreViejo.length + "\n\n";
  inv.conNombreViejo.forEach(d => {
    texto += "• " + d.viejo + " → " + d.nuevo + "\n   [" + d.tipo + "] " + d.horario +
      (d.yaSustituido ? "\n   (el sustituto YA existe: solo se retira el viejo)" : "") + "\n";
  });
  if (inv.duplicados.length) {
    alertarUsuario(texto + "\n⚠️ Hay tareas duplicadas (" + inv.duplicados.length +
      "). Resuélvelas a mano antes de migrar.", "🔁 Disparadores");
    return;
  }
  texto += "\nSe crea el nuevo ANTES de borrar el viejo, uno a uno.\n" +
    "Las continuaciones se recrean para no dejar dormido el trabajo a medias.\n" +
    "Lo que no se sepa recrear se deja intacto y se informa.\n\n¿Migrar ahora?";

  if (!preguntarUsuario("🔁 Migrar disparadores", texto, false)) return;

  const r = migrarDisparadoresANombresPrivados(false);
  let resumen = "Migrados: " + r.migrados.length + "\n";
  r.migrados.forEach(m => { resumen += "• " + m.nuevo + " (" + m.horario + ")\n"; });
  if (r.yaEstaban.length) {
    resumen += "\nYa tenían sustituto; solo se retiró el viejo:\n";
    r.yaEstaban.forEach(o => { resumen += "• " + o.viejo + "\n"; });
  }
  if (r.intactos.length) {
    resumen += "\n⚠️ SIN TOCAR, hay que resolverlos a mano:\n";
    r.intactos.forEach(o => { resumen += "• " + o.viejo + "\n   " + o.motivo + "\n"; });
  }
  if (r.fallos.length) resumen += "\n⚠️ Con problemas:\n" + r.fallos.join("\n");
  resumen += "\n\nCompruébalo en Apps Script → Activadores, y vigila la primera " +
    "ejecución automática de cada uno: que exista no prueba que corra.";
  alertarUsuario(resumen, "🔁 Disparadores");
}

