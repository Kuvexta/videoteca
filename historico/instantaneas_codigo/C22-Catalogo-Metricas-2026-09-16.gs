/** Construye la hoja «Módulos» con el avance de cada persona. */
function generarPanelModulos() {
  exigirOrigenInterno("generarPanelModulos");
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const hoja = ss.getSheetByName("Módulos") || ss.insertSheet("Módulos", 1);
  hoja.clear();
  hoja.activate();

  hoja.getRange("A1:H1").merge()
    .setValue("📚 MÓDULOS CERTIFICABLES — AVANCE POR COLABORADOR")
    .setFontSize(14).setFontWeight("bold").setBackground("#0f766e").setFontColor("#ffffff")
    .setHorizontalAlignment("center");

  const modulos = listarModulos();
  if (modulos.length === 0) {
    hoja.getRange("A3").setValue("Aún no hay módulos definidos. Créalos desde el menú «Módulos Certificables».");
    return;
  }

  hoja.getRange("A3:H3").setValues([["Módulo", "Videos", "Preguntas validadas", "Estado", "Colaborador", "Avance", "Última nota", "Nivel"]])
    .setFontWeight("bold").setBackground("#1f2937").setFontColor("#ffffff");

  const correos = obtenerCorreosConocidos();
  const filas = [];

  modulos.forEach(m => {
    const fuentes = listarFuentesModulo(m.id).length;
    const validadas = leerClavesExamen({ moduloId: m.id, soloValidadas: true }).length;
    if (correos.length === 0) {
      filas.push([m.nombre, fuentes, validadas, m.estado, "(sin colaboradores registrados)", "", "", ""]);
      return;
    }
    correos.forEach(c => {
      const est = obtenerEstadoModuloUsuario(c, m.id);
      if (!est) return;
      filas.push([
        m.nombre, fuentes, validadas, m.estado, c,
        `${est.videosVistos}/${est.totalVideos} (${est.porcentajeAvance}%)`,
        est.ultimoPorcentaje ? est.ultimoPorcentaje + "%" : "—",
        est.ultimoNivel || est.estado
      ]);
    });
  });

  if (filas.length > 0) hoja.getRange(4, 1, filas.length, 8).setValues(filas);
  hoja.autoResizeColumns(1, 8);
  notificarUsuario(`Panel de módulos generado (${filas.length} filas).`, "Módulos", 4);
}

/** Correos conocidos del sistema (miembros + tokens con correo). */
function obtenerCorreosConocidos() {
  exigirOrigenInterno("obtenerCorreosConocidos");
  const vistos = {};
  try {
    const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("_Miembros_Familia");
    if (sheet && sheet.getLastRow() >= 2) {
      sheet.getRange(2, 1, sheet.getLastRow() - 1, 1).getValues().forEach(f => {
        const c = (f[0] || "").toString().toLowerCase().trim();
        if (c) vistos[c] = true;
      });
    }
  } catch (e) { /* continúa */ }

  try {
    const mapa = obtenerMapaTokens_();
    Object.keys(mapa).forEach(k => {
      const c = (mapa[k].email || "").toString().toLowerCase().trim();
      if (c && c.indexOf("@") !== -1) vistos[c] = true;
    });
  } catch (e) { /* continúa */ }

  return Object.keys(vistos).sort();
}

/** [F2-3] Informe agregado de la organización por eje de competencia y riesgo. */
function generarInformeAgregadoOrganizacion() {
  exigirOrigenInterno("generarInformeAgregadoOrganizacion");
  const detalle = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("_Respuestas_Detalle");
  if (!detalle || detalle.getLastRow() < 2) {
    alertarUsuario("Aún no hay respuestas registradas para agregar.", "Informe");
    return null;
  }

  const datos = detalle.getRange(2, 1, detalle.getLastRow() - 1, DET_COLS).getValues();
  const porArea = {};
  const porModulo = {};
  let totalRespuestas = 0, totalAciertos = 0, totalOmisiones = 0;

  datos.forEach(f => {
    const area = (f[8] || "General").toString();
    const modulo = (f[2] || "").toString();
    const resultado = (f[6] || "").toString();
    if (!resultado) return;

    totalRespuestas++;
    if (!porArea[area]) porArea[area] = { total: 0, aciertos: 0, omisiones: 0 };
    if (!porModulo[modulo]) porModulo[modulo] = { total: 0, aciertos: 0 };
    porArea[area].total++;
    porModulo[modulo].total++;
    if (resultado === RESULTADO.ACIERTO) { porArea[area].aciertos++; porModulo[modulo].aciertos++; totalAciertos++; }
    if (resultado === RESULTADO.OMISION) { porArea[area].omisiones++; totalOmisiones++; }
  });

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const hoja = ss.getSheetByName("Informe Organización") || ss.insertSheet("Informe Organización", 2);
  hoja.clear();
  hoja.activate();

  hoja.getRange("A1:F1").merge()
    .setValue("🏢 INFORME AGREGADO DE COMPETENCIAS — " + formatearFecha(new Date(), "yyyy-MM-dd"))
    .setFontSize(14).setFontWeight("bold").setBackground("#1f2937").setFontColor("#ffffff");

  hoja.getRange("A3:B3").setValues([["Respuestas evaluadas", totalRespuestas]]);
  hoja.getRange("A4:B4").setValues([["Dominio global", totalRespuestas ? Math.round(totalAciertos / totalRespuestas * 100) + "%" : "—"]]);
  hoja.getRange("A5:B5").setValues([["Omisiones", totalOmisiones]]);

  hoja.getRange("A7:D7").setValues([["Eje de competencia", "Evaluadas", "Dominio", "Omisiones"]])
    .setFontWeight("bold").setBackground("#0f766e").setFontColor("#ffffff");
  const filasArea = Object.keys(porArea).sort().map(a => ([
    a, porArea[a].total, Math.round(porArea[a].aciertos / porArea[a].total * 100) + "%", porArea[a].omisiones
  ]));
  if (filasArea.length > 0) hoja.getRange(8, 1, filasArea.length, 4).setValues(filasArea);

  const inicioMod = 9 + filasArea.length;
  hoja.getRange(inicioMod, 1, 1, 3).setValues([["Módulo", "Evaluadas", "Dominio"]])
    .setFontWeight("bold").setBackground("#1e3a8a").setFontColor("#ffffff");
  const filasMod = Object.keys(porModulo).sort().map(m => ([
    m || "(sin módulo)", porModulo[m].total, Math.round(porModulo[m].aciertos / porModulo[m].total * 100) + "%"
  ]));
  if (filasMod.length > 0) hoja.getRange(inicioMod + 1, 1, filasMod.length, 3).setValues(filasMod);

  hoja.autoResizeColumns(1, 6);
  logInfo("Informe", "Informe agregado de la organización generado.");
  notificarUsuario("Informe agregado generado.", "Informe", 4);
  return { areas: filasArea.length, modulos: filasMod.length, respuestas: totalRespuestas };
}

// -------------------------------------------------------------------------------------
// 9B.10 [F2-5] Informe individual en PDF (vía Google Docs → PDF)
// -------------------------------------------------------------------------------------

/**
 * Genera el informe de auditoría de un intento como PDF descargable.
 * No usa plantilla de Slides (el certificado ya cubre ese caso): construye un
 * Google Doc estructurado y lo exporta, porque el informe es texto largo con
 * tablas variables y una diapositiva no lo sostiene.
 *
 * El bloque forense se incluye SOLO si `incluirForense` es verdadero, es decir,
 * cuando lo pide un administrador. El colaborador nunca ve su índice de presunción.
 */
function generarInformePDFIntento(intentoId, incluirForense = false) {
  exigirOrigenInterno("generarInformePDFIntento");
  let doc = null;
  try {
    const inf = obtenerInformeIntento(intentoId, incluirForense);
    const carpeta = obtenerSubcarpeta("Informes_Auditoria");

    doc = DocumentApp.create(`Temp_Informe_${intentoId}`);
    const cuerpo = doc.getBody();

    cuerpo.appendParagraph("INFORME DE AUDITORÍA TÉCNICA")
      .setHeading(DocumentApp.ParagraphHeading.TITLE);
    cuerpo.appendParagraph(inf.modulo).setHeading(DocumentApp.ParagraphHeading.SUBTITLE);

    cuerpo.appendTable([
      ["Colaborador", inf.colaborador || inf.correo],
      ["Correo", inf.correo],
      ["Fecha de presentación", inf.fecha],
      ["Intento", inf.numeroIntento + " de " + inf.maxIntentos],
      ["Resultado", `${inf.aciertos} aciertos · ${inf.errores} errores · ${inf.omisiones} omisiones (de ${inf.total})`],
      ["Calificación", inf.porcentaje + "%"],
      ["Nivel alcanzado", inf.nivel],
      ["Certifica el módulo", inf.certificado ? "SÍ" : "NO"],
      ["Tiempo empleado", formatearSegundos(inf.segundosTotales)]
    ]).setBorderWidth(1);

    // ---- Desempeño por eje de competencia ----
    const areas = Object.keys(inf.desempenoAreas || {});
    if (areas.length > 0) {
      cuerpo.appendParagraph("1. Desempeño por eje de competencia")
        .setHeading(DocumentApp.ParagraphHeading.HEADING1);
      const tablaAreas = [["Eje de competencia", "Dominio"]];
      areas.sort((a, b) => inf.desempenoAreas[b] - inf.desempenoAreas[a])
        .forEach(a => tablaAreas.push([a, inf.desempenoAreas[a] + "%"]));
      cuerpo.appendTable(tablaAreas).setBorderWidth(1);
    }

    // ---- Falencias detectadas ----
    cuerpo.appendParagraph("2. Falencias detectadas y riesgo operativo")
      .setHeading(DocumentApp.ParagraphHeading.HEADING1);

    if (inf.hallazgos.length === 0) {
      cuerpo.appendParagraph("Sin falencias: el colaborador respondió correctamente todos los reactivos.");
    } else {
      inf.hallazgos.forEach((h, i) => {
        cuerpo.appendParagraph(`2.${i + 1} [${h.severidad}] ${h.concepto} — pregunta ${h.numero}`)
          .setHeading(DocumentApp.ParagraphHeading.HEADING3);
        cuerpo.appendTable([
          ["Pregunta", h.pregunta || ""],
          ["Estado", h.estado],
          ["Respuesta emitida", h.respuestaEmitida || ""],
          ["Respuesta correcta", h.respuestaCorrecta || ""],
          ["Qué se debe hacer", h.configuracionCorrecta || ""],
          ["Causa raíz", h.causaRaiz || ""],
          ["Riesgo operativo", h.riesgo || ""],
          ["Caso práctico", h.caso || ""],
          ["Evidencia en video", h.referenciaVideo || ""],
          ["Enlace al segundo exacto", h.urlConSegundo || ""]
        ]).setBorderWidth(1);
      });
    }

    // ---- Plan de refuerzo ----
    if (inf.planRefuerzo.length > 0) {
      cuerpo.appendParagraph("3. Plan de refuerzo asignado")
        .setHeading(DocumentApp.ParagraphHeading.HEADING1);
      inf.planRefuerzo.forEach(p => {
        cuerpo.appendListItem(`${p.concepto}: ${p.motivo} → ${p.referencia}`)
          .setGlyphType(DocumentApp.GlyphType.NUMBER);
      });
    }

    // ---- Bloque forense: exclusivo de administración ----
    if (incluirForense && inf.forense) {
      cuerpo.appendPageBreak();
      cuerpo.appendParagraph("ANEXO CONFIDENCIAL · Índice de presunción")
        .setHeading(DocumentApp.ParagraphHeading.HEADING1);
      cuerpo.appendParagraph(
        "Este anexo es una señal interna para revisión humana. No constituye por sí solo " +
        "una conclusión sobre la integridad del examen y no debe entregarse al colaborador."
      ).setItalic(true);
      cuerpo.appendTable([
        ["Índice", inf.forense.indice],
        ["Reactivos trampa presentados", String(inf.forense.trampasPresentadas)],
        ["Coincidencias con el cebo", String(inf.forense.trampasCaidas)],
        ["Tasa de coincidencia", inf.forense.tasa + "%"],
        ["Segundos por pregunta", String(inf.forense.segundosPorPregunta)]
      ]).setBorderWidth(1);
      if (inf.forense.dictamen) cuerpo.appendParagraph(inf.forense.dictamen);
    }

    cuerpo.appendHorizontalRule();
    cuerpo.appendParagraph(
      `Emitido automáticamente por ${VERSION_SCRIPT} el ` +
      formatearFecha(new Date(), "yyyy-MM-dd HH:mm") + ` · Intento ${intentoId}`
    ).setFontSize(8);

    doc.saveAndClose();

    const temporal = DriveApp.getFileById(doc.getId());
    const pdfBlob = temporal.getAs(MimeType.PDF);
    const nombre = `Informe_${(inf.colaborador || inf.correo || "colaborador").replace(/[^\w]+/g, "_")}` +
      `_${(inf.moduloId || "modulo")}_${intentoId}.pdf`;
    const pdf = carpeta.createFile(pdfBlob).setName(nombre);

    logInfo("Informe", `Informe PDF generado para ${inf.correo} (${inf.moduloId}).`);
    return { exito: true, url: pdf.getUrl(), nombre: nombre, blob: pdfBlob };
  } catch (e) {
    logError("Informe", "No se pudo generar el informe PDF: " + e.message);
    return { exito: false, mensaje: e.message };
  } finally {
    // El Doc intermedio nunca queda en Drive: solo sobrevive el PDF.
    if (doc) { try { DriveApp.getFileById(doc.getId()).setTrashed(true); } catch (e) { /* ignora */ } }
  }
}

/** Envía el informe PDF al colaborador por correo, sin el anexo forense. */
function enviarInformePDFAlColaborador(intentoId) {
  exigirOrigenInterno("enviarInformePDFAlColaborador");
  const res = generarInformePDFIntento(intentoId, false);
  if (!res.exito) return res;
  try {
    const inf = obtenerInformeIntento(intentoId, false);
    if (!inf.correo) return { exito: false, mensaje: "El intento no tiene correo asociado." };
    MailApp.sendEmail({
      to: inf.correo,
      subject: t("mail_informe_asunto", { modulo: inf.modulo }),
      htmlBody: t("mail_informe_cuerpo", {
        estudiante: inf.colaborador || inf.correo,
        modulo: inf.modulo,
        porcentaje: inf.porcentaje,
        nivel: inf.nivel,
        hallazgos: inf.hallazgos.length
      }),
      attachments: [res.blob.setName(res.nombre)]
    });
    logInfo("Informe", "Informe PDF enviado a " + inf.correo);
    return { exito: true, url: res.url, correo: inf.correo };
  } catch (e) {
    logWarn("Informe", "No se pudo enviar el informe: " + e.message);
    return { exito: false, mensaje: e.message, url: res.url };
  }
}

/** Genera el informe PDF del último intento de un colaborador, desde el menú. */
function generarInformePDFIntentoUI() {
  const ui = SpreadsheetApp.getUi();
  const resp = ui.prompt("Informe de Auditoría en PDF",
    "ID del intento (o deja vacío para usar el último intento entregado):", ui.ButtonSet.OK_CANCEL);
  if (resp.getSelectedButton() !== ui.Button.OK) return;

  let intentoId = resp.getResponseText().trim();
  if (!intentoId) {
    const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("_Intentos");
    if (!sheet || sheet.getLastRow() < 2) { ui.alert("Aún no hay intentos registrados."); return; }
    const filas = sheet.getRange(2, 1, sheet.getLastRow() - 1, INT_COLS).getValues()
      .filter(f => f[INT.ESTADO] === ESTADO_INTENTO.ENTREGADO)
      .sort((a, b) => new Date(b[INT.FIN]) - new Date(a[INT.FIN]));
    if (filas.length === 0) { ui.alert("Aún no hay intentos entregados."); return; }
    intentoId = filas[0][INT.ID];
  }

  const res = generarInformePDFIntento(intentoId, true);   // desde el menú siempre es administración
  alertarUsuario(res.exito
    ? "Informe generado (incluye el anexo forense):\n\n" + res.url
    : "Error: " + res.mensaje, "Informe de Auditoría");
}

// =====================================================================================
// 10. PORTAL: CATÁLOGO SERVER-SIDE, PROGRESO Y TELEMETRÍA DE USUARIO
// =====================================================================================

function obtenerCatalogoPublico(page = 1, pageSize = 9, token = null, filtros = {}) {
  try {
    let emailUsuario = "";
    if (token) {
      const datosToken = obtenerDatosToken_(token);
      if (datosToken) emailUsuario = (datosToken.email || "").toLowerCase();
    }

    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const mapaProgreso = {};
    const progSheet = ss.getSheetByName("_Progreso_Visualizacion");
    if (progSheet && progSheet.getLastRow() >= 2 && emailUsuario) {
      progSheet.getRange(2, 1, progSheet.getLastRow() - 1, 7).getValues().forEach(p => {
        if ((p[0] || "").toString().toLowerCase() === emailUsuario) {
          mapaProgreso[(p[1] || "").toString()] = {
            ultimoSegundo: p[2] || 0,
            porcentaje: parseFloat(p[4]) || 0,
            completado: p[6] === true || (p[6] || "").toString().toLowerCase() === "true"
          };
        }
      });
    }

    const hoja = obtenerHojaDatos();
    if (hoja.getLastRow() < 2) {
      return {
        data: [], total: 0, totalSinFiltrar: 0, page: 1, pageSize: pageSize, totalPages: 1,
        hoja: hoja.getName(), opcionesFiltros: obtenerFiltrosCache()
      };
    }

    const q = (filtros.texto || "").toString().toLowerCase().trim();
    // El árbol: ecosistema → área → tema. Versión y dificultad ya no cuelgan
    // de él —son facetas—, pero se siguen leyendo aquí igual. Se aceptan
    // los nombres antiguos (dominio/subcategoria) porque enlaces ya compartidos
    // los llevan en el hash y deben seguir funcionando.
    const eco = filtros.ecosistema || filtros.dominio || "";
    const area = filtros.area || filtros.subcategoria || "";
    const tema = filtros.tema || "";
    const ver = filtros.version || "";
    const dif = filtros.dificultad || "";
    const fuente = filtros.fuente || "";
    const idioma = (filtros.idioma || "").toString().trim();
    // [v2] Facetas. Son independientes entre sí y del árbol: se pueden combinar
    // «Odoo» + «Hotelería» + «Colombia» sin que ninguna anule a las otras.
    const herr = (filtros.herramienta || "").toString().trim();
    const indus = (filtros.industria || "").toString().trim();
    const juris = (filtros.jurisdiccion || "").toString().trim();
    const alcan = (filtros.alcance || "").toString().trim();
    const tipoC = (filtros.tipoContenido || "").toString().trim();
    const mod = (filtros.moduloId || "").toString().trim();
    const soloPendientes = filtros.soloPendientes === true || filtros.soloPendientes === "true";

    // Títulos de módulos, para etiquetar cada tarjeta sin releer la hoja por fila.
    const titulosModulo = {};
    try {
      listarModulos().forEach(m => { titulosModulo[m.id] = m.nombre; });
    } catch (eMod) { /* módulos aún no inicializados */ }

    // [MEJORA 1] Filtrado por bloques: nunca se carga todo el catálogo de golpe.
    // `totalSinFiltrar` es lo que permite al portal distinguir «el catálogo está
    // vacío» de «hay 40 videos pero ninguno pasa estos filtros». Sin ese dato,
    // ambos casos se ven igual y no hay forma de saber qué está pasando.
    const filtrados = [];
    let totalSinFiltrar = 0;
    iterarCatalogoPorBloques(function (datos) {
      datos.forEach(r => {
        if (!r[IDX.URL] || !r[IDX.TITULO]) return;
        totalSinFiltrar++;
        const matchQ = !q ||
          r[IDX.TITULO].toString().toLowerCase().indexOf(q) !== -1 ||
          (r[IDX.TAGS] || "").toString().toLowerCase().indexOf(q) !== -1 ||
          (r[IDX.RESUMEN] || "").toString().toLowerCase().indexOf(q) !== -1;
        if (!matchQ) return;
        if (eco && (r[IDX.ECOSISTEMA] || SIN_CLASIFICAR) !== eco) return;
        if (area && (r[IDX.AREA] || SIN_CLASIFICAR) !== area) return;
        if (tema && (r[IDX.TEMA] || "").toString().trim() !== tema) return;
        if (ver && r[IDX.VERSION] !== ver) return;
        if (dif && r[IDX.DIFICULTAD] !== dif) return;
        if (fuente && (r[IDX.FUENTE] || deducirFuenteDesdeUrl(r[IDX.URL])) !== fuente) return;
        /* Una fila sin idioma escrito se filtra como «Indeterminado», el mismo
           valor con el que aparece en el desplegable. Si aquí se tratara como
           «no coincide con nada», elegir «Indeterminado» devolvería cero
           resultados justo para las filas que hay que revisar. */
        if (idioma && ((r[IDX.IDIOMA] || "").toString().trim() || IDIOMA_INDETERMINADO) !== idioma) return;
        if (herr  && (r[IDX.HERRAMIENTA]  || "").toString().trim() !== herr)  return;
        if (indus && (r[IDX.INDUSTRIA]    || "").toString().trim() !== indus) return;
        if (juris && (r[IDX.JURISDICCION] || "").toString().trim() !== juris) return;
        if (alcan && (r[IDX.ALCANCE]      || "").toString().trim() !== alcan) return;
        if (tipoC && (r[IDX.TIPO_CONTENIDO]|| "").toString().trim() !== tipoC) return;
        if (mod && (r[IDX.MODULO] || "").toString().trim() !== mod) return;
        if (soloPendientes) {
          const pr = mapaProgreso[(r[IDX.ID] || "").toString()];
          if (pr && pr.completado) return;
        }
        filtrados.push(r);
      });
      return false;
    });

    const total = filtrados.length;
    const totalPages = Math.ceil(total / pageSize) || 1;
    const start = (page - 1) * pageSize;

    const data = filtrados.slice(start, start + pageSize).map(r => {
      const vidId = (r[IDX.ID] || "").toString().trim();
      const prog = mapaProgreso[vidId] || { ultimoSegundo: 0, porcentaje: 0, completado: false };
      return {
        url: r[IDX.URL],
        idVideo: vidId,
        titulo: r[IDX.TITULO],
        resumenCorto: r[IDX.RESUMEN] || "Sin resumen.",
        ecosistema: r[IDX.ECOSISTEMA] || SIN_CLASIFICAR,
        area: r[IDX.AREA] || SIN_CLASIFICAR,
        tema: (r[IDX.TEMA] || "").toString().trim(),
        fuente: r[IDX.FUENTE] || deducirFuenteDesdeUrl(r[IDX.URL]),
        // Nombres antiguos, para no romper lo que ya los leía.
        dominio: r[IDX.ECOSISTEMA] || SIN_CLASIFICAR,
        subcategoria: r[IDX.AREA] || SIN_CLASIFICAR,
        version: r[IDX.VERSION] || "General",
        idioma: (r[IDX.IDIOMA] || "").toString().trim() || IDIOMA_INDETERMINADO,
        idiomaNombre: nombreIdioma((r[IDX.IDIOMA] || "").toString().trim()),
        herramienta: (r[IDX.HERRAMIENTA] || "").toString().trim(),
        industria: (r[IDX.INDUSTRIA] || "").toString().trim(),
        jurisdiccion: (r[IDX.JURISDICCION] || "").toString().trim(),
        alcance: (r[IDX.ALCANCE] || "").toString().trim(),
        tipoContenido: (r[IDX.TIPO_CONTENIDO] || "").toString().trim(),
        canal: r[IDX.CANAL] || "",
        duracion: parseFloat(r[IDX.DURACION]) || 0,
        vistas: r[IDX.VISTAS] || 0,
        estado: r[IDX.ESTADO] || "🟡 Pendiente",
        tags: r[IDX.TAGS] || "",
        /* El id de Drive ya no sale al navegador: con él, un enlace reenviado
           abría el documento a cualquiera. El portal solo necesita saber SI hay
           material; el contenido lo pide por `ficha_video`. */
        tieneFicha: Boolean((r[IDX.DRIVE_RAG] || "").toString().trim()),
        dificultad: r[IDX.DIFICULTAD] || "Principiante",
        justificacionDificultad: r[IDX.JUSTIF_DIF] || "",
        urlExamen: r[IDX.URL_FORM] || "",
        formId: r[IDX.ID_FORM] || "",
        moduloId: (r[IDX.MODULO] || "").toString().trim(),
        moduloTitulo: titulosModulo[(r[IDX.MODULO] || "").toString().trim()] || "",
        // El portal necesita saberlo para no ofrecer examen sobre una canción.
        certificable: filaEsCertificable(r),
        progreso: prog.porcentaje,
        completado: prog.completado,
        visto: prog.porcentaje > 0,
        ultimoSegundo: prog.ultimoSegundo,
        enlaceReanudar: prog.ultimoSegundo > 5 ? construirEnlaceConSegundo(r[IDX.URL], prog.ultimoSegundo) : (r[IDX.URL] || "")
      };
    });

    return {
      data: data, total: total, totalSinFiltrar: totalSinFiltrar,
      page: page, pageSize: pageSize, totalPages: totalPages,
      hoja: hoja.getName(), filasHoja: hoja.getLastRow() - 1,
      opcionesFiltros: obtenerFiltrosCache(), version: VERSION_SCRIPT
    };
  } catch (e) {
    // El error se propaga: devolver una lista vacía haría que el portal mostrara
    // «ningún video coincide» ante un fallo real, y nadie sabría qué se rompió.
    logError("Portal", "Error construyendo catálogo público: " + e.message);
    throw e;
  }
}

/**
 * Guarda el punto de reproducción de un video. Hace *upsert* sobre
 * `_Progreso_Visualizacion` (una fila por correo+video), de modo que el portal
 * puede ofrecer "reanudar" y los módulos pueden exigir un umbral de
 * visualización antes de habilitar el examen certificable.
 * El progreso nunca retrocede: solo se conserva el segundo máximo alcanzado.
 */
function guardarProgresoVideo(token, idVideo, segundo, duracion, origen = "portal") {
  exigirOrigenInterno("guardarProgresoVideo");
  try {
    const data = obtenerDatosToken_(token);
    if (!data) return { exito: false, mensaje: t("err_sin_token") };

    const email = (data.email || "anonimo").toLowerCase().trim();
    const vid = (idVideo || "").toString().trim();
    if (!vid) return { exito: false, mensaje: t("err_video_vacio") };

    const prog = asegurarHojaSistema("_Progreso_Visualizacion");

    let sec = parseFloat(segundo) || 0;
    const dur = Math.max(parseFloat(duracion) || 1, 1);

    let fila = -1;
    let secPrevio = 0;
    if (prog.getLastRow() >= 2) {
      const rows = prog.getRange(2, 1, prog.getLastRow() - 1, 3).getValues();
      for (let i = 0; i < rows.length; i++) {
        if ((rows[i][0] || "").toString().toLowerCase().trim() === email &&
            (rows[i][1] || "").toString().trim() === vid) {
          fila = i + 2;
          secPrevio = parseFloat(rows[i][2]) || 0;
          break;
        }
      }
    }

    // El avance es monótono: un salto hacia atrás no debe borrar lo ya visto.
    if (sec < secPrevio) sec = secPrevio;
    const pct = parseFloat(Math.min((sec / dur) * 100, 100).toFixed(1));
    const comp = pct >= 95;

    if (fila !== -1) prog.getRange(fila, 3, 1, 6).setValues([[sec, dur, pct, new Date(), comp, origen]]);
    else prog.appendRow([email, vid, sec, dur, pct, new Date(), comp, origen]);
    limpiarMemoEjecucion();   // el progreso indexado quedó obsoleto

    return { exito: true, porcentaje: pct, completado: comp, ultimoSegundo: sec };
  } catch (e) {
    logWarn("Portal", "No se pudo guardar progreso: " + e.message);
    return { exito: false };
  }
}

/** Devuelve el progreso completo del usuario (mapa videoId → progreso). */
function obtenerProgresoUsuario(token) {
  try {
    validarTokenConScope(token, "read_only");
    const datos = obtenerDatosToken_(token) || {};
    const email = (datos.email || "").toLowerCase().trim();
    if (!email) return {};
    const prog = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("_Progreso_Visualizacion");
    if (!prog || prog.getLastRow() < 2) return {};
    const mapa = {};
    prog.getRange(2, 1, prog.getLastRow() - 1, 8).getValues().forEach(p => {
      if ((p[0] || "").toString().toLowerCase().trim() !== email) return;
      mapa[(p[1] || "").toString().trim()] = {
        ultimoSegundo: parseFloat(p[2]) || 0,
        duracion: parseFloat(p[3]) || 0,
        porcentaje: parseFloat(p[4]) || 0,
        completado: p[6] === true || (p[6] || "").toString().toLowerCase() === "true"
      };
    });
    return mapa;
  } catch (e) {
    return {};
  }
}

function registrarVisualizacionVideo(token, idVideo, titulo) {
  exigirOrigenInterno("registrarVisualizacionVideo");
  try {
    const data = obtenerDatosToken_(token) || { email: "anonimo", client: "Web User" };
    const hist = asegurarHojaSistema("_Historial_Visualizaciones");
    hist.appendRow([new Date(), data.email, data.client, idVideo, titulo, "portal"]);

    // R5: el historial mide aperturas del portal, no vistas del proveedor.
    // IDX.VISTAS pertenece a las métricas externas; incrementarlo aquí mezclaría
    // unidades y la siguiente sincronización lo sobrescribiría. La actividad
    // interna se consulta desde _Historial_Visualizaciones y el progreso.

    return { exito: true };
  } catch (e) {
    return { exito: false, error: e.message };
  }
}

function registrarAccesoDispositivo(token, ipCliente, userAgent, fingerprint) {
  exigirOrigenInterno("registrarAccesoDispositivo");
  try {
    const data = obtenerDatosToken_(token);
    if (!data) return { exito: false };

    const email = (data.email || "anonimo").toLowerCase().trim();
    const fp = fingerprint || Utilities.base64Encode(userAgent || "unknown").slice(0, 16);
    const dispSheet = asegurarHojaSistema("_Dispositivos_Conocidos");

    // Anonimiza el último octeto de la IP para cumplir buenas prácticas de privacidad.
    const ipAnon = (ipCliente || "0.0.0.0").toString().replace(/\.\d+$/, ".0");

    let fila = -1;
    if (dispSheet.getLastRow() >= 2) {
      const rows = dispSheet.getRange(2, 1, dispSheet.getLastRow() - 1, 2).getValues();
      for (let i = 0; i < rows.length; i++) {
        if ((rows[i][0] || "").toString().toLowerCase() === email && rows[i][1] === fp) { fila = i + 2; break; }
      }
    }

    if (fila !== -1) {
      const usos = parseInt(dispSheet.getRange(fila, 5).getValue(), 10) || 0;
      dispSheet.getRange(fila, 4, 1, 2).setValues([[new Date(), usos + 1]]);
    } else {
      dispSheet.appendRow([email, fp, new Date(), new Date(), 1, ipAnon, (userAgent || "").toString().slice(0, 300)]);
    }
    return { exito: true };
  } catch (err) {
    return { exito: false };
  }
}

function obtenerPreferenciasUsuario(token) {
  validarTokenConScope(token, "read_only");
  const datos = obtenerDatosToken_(token) || {};
  const key = "PREFS_" + Utilities.base64Encode(datos.email || "anon").slice(0, 40);
  const raw = PropertiesService.getScriptProperties().getProperty(key);
  if (raw) {
    try {
      const p = JSON.parse(raw);
      p.idioma = obtenerIdiomaDe(datos.email);
      return p;
    } catch (e) { /* valores por defecto */ }
  }
  return { emailActivo: true, telegramActivo: false, whatsappActivo: false, pushActivo: true,
           canalPreferido: "email", idioma: obtenerIdiomaDe(datos.email) };
}

function guardarPreferenciasUsuario(token, preferencias) {
  validarTokenConScope(token, "read_only");
  const datos = obtenerDatosToken_(token) || {};
  const prefs = preferencias || {};
  const key = "PREFS_" + Utilities.base64Encode(datos.email || "anon").slice(0, 40);
  PropertiesService.getScriptProperties().setProperty(key, JSON.stringify(prefs));

  /* El idioma se guarda ADEMÁS en su propia clave. Los correos y avisos los
     escriben disparadores que no tienen delante ni al usuario ni su token: solo
     conocen el correo del destinatario, y con él consultan esta clave. Meterlo
     únicamente dentro del JSON de preferencias obligaría a cada disparador a
     saber cómo está montado ese JSON. */
  if (prefs.idioma !== undefined) guardarIdiomaDe(datos.email, prefs.idioma);
  return { exito: true };
}

/**
 * Contrato unificado de notificaciones para el portal: SIEMPRE `{mensaje, link}`
 * más metadatos opcionales. El cliente puede pintar cualquier notificación sin
 * conocer su tipo. Agrega tres orígenes:
 *   1. Tareas de refuerzo asignadas tras un examen.
 *   2. Intentos de módulo abiertos (sin entregar) todavía vigentes.
 *   3. Módulos con banco validado y visualización completa, listos para certificar.
 */
function consultarNotificacionesPendientes(token) {
  const notificaciones = [];
  let email = "";
  try {
    validarTokenConScope(token, "read_only");
    email = ((obtenerDatosToken_(token) || {}).email || "").toLowerCase().trim();
  } catch (e) {
    return [];
  }

  // 1. Refuerzos pendientes.
  try {
    (obtenerTareasRefuerzoUsuario(token) || []).forEach(tarea => {
      notificaciones.push({
        tipo: "refuerzo",
        prioridad: 2,
        titulo: t("notif_refuerzo_titulo"),
        mensaje: t("notif_refuerzo_mensaje", { concepto: tarea.concepto || "un concepto pendiente" }),
        link: tarea.urlVideo || "",
        idTarea: tarea.idTarea,
        moduloId: tarea.moduloId || ""
      });
    });
  } catch (e) { /* sin refuerzos */ }

  // 2. Intentos abiertos y vigentes.
  try {
    if (email) {
      listarIntentosUsuario(email, null).forEach(reg => {
        const f = reg.datos;
        if ((f[INT.ESTADO] || "") !== ESTADO_INTENTO.EN_CURSO) return;
        const inicio = f[INT.INICIO] ? new Date(f[INT.INICIO]).getTime() : 0;
        const vence = inicio + INTENTO_VIGENCIA_HORAS * 3600000;
        if (!inicio || Date.now() > vence) return;
        const moduloId = (f[INT.MODULO] || "").toString();
        const mod = obtenerModulo(moduloId);
        notificaciones.push({
          tipo: "intento_abierto",
          prioridad: 1,
          titulo: t("notif_intento_titulo"),
          mensaje: t("notif_intento_mensaje", {
            modulo: mod ? mod.nombre : moduloId,
            horas: Math.max(Math.round((vence - Date.now()) / 3600000), 1)
          }),
          link: "?vista=modulo&modulo=" + encodeURIComponent(moduloId) +
                "&intento=" + encodeURIComponent(f[INT.ID]),
          intentoId: f[INT.ID],
          moduloId: moduloId
        });
      });
    }
  } catch (e) { /* sin intentos */ }

  // 3. Módulos listos para certificar.
  try {
    if (email) {
      (obtenerModulosUsuario(token) || []).forEach(m => {
        if (!m.habilitadoExamen || m.examenAprobado) return;
        if (m.intentosUsados >= m.maxIntentos) return;
        notificaciones.push({
          tipo: "modulo_listo",
          prioridad: 3,
          titulo: t("notif_modulo_titulo"),
          mensaje: t("notif_modulo_mensaje", { modulo: m.nombre }),
          link: "?vista=modulo&modulo=" + encodeURIComponent(m.moduloId),
          moduloId: m.moduloId
        });
      });
    }
  } catch (e) { /* sin módulos */ }

  notificaciones.sort((a, b) => (a.prioridad || 9) - (b.prioridad || 9));
  return notificaciones;
}

/**
 * Historial de calificaciones del usuario autenticado.
 * [SEGURIDAD] El correo NUNCA se acepta como parámetro libre: se deriva del
 * token. Solo un token con scope `admin` puede consultar a un tercero.
 */
function consultarResultadosSupervision(token, opciones) {
  validarTokenConScope(token, "supervisor");
  const o = opciones || {};
  const correo = String(o.correo || "").trim().toLowerCase();
  const pagina = Math.max(1, Math.min(100000, parseInt(o.pagina, 10) || 1));
  const tamano = 50;
  const hoja = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("_Historial_Calificaciones");
  if (!hoja || hoja.getLastRow() < 2) return { registros: [], total: 0, pagina: 1, paginas: 1 };
  const filas = hoja.getRange(2, 1, hoja.getLastRow() - 1, 12).getValues().filter(function(f) {
    return !correo || String(f[2] || "").trim().toLowerCase() === correo;
  }).reverse();
  const paginas = Math.max(1, Math.ceil(filas.length / tamano));
  const actual = Math.min(pagina, paginas);
  const tz = obtenerZonaHoraria();
  const registros = filas.slice((actual - 1) * tamano, actual * tamano).map(function(f) {
    const nota = parseFloat(f[7]);
    return {
      fecha: f[0] ? Utilities.formatDate(new Date(f[0]), tz, "yyyy-MM-dd HH:mm") : "",
      estudiante: String(f[1] || ""), correo: String(f[2] || ""), evaluacion: String(f[3] || ""),
      aciertos: Number(f[5]) || 0, total: Number(f[6]) || 0,
      porcentaje: isNaN(nota) ? null : Math.round(nota * 1000) / 10,
      estado: String(f[8] || "")
    };
  });
  return { registros: registros, total: filas.length, pagina: actual, paginas: paginas };
}

function buscarCalificacionesEstudiante(token, correoObjetivo = null) {
  try {
    validarTokenConScope(token, "read_only");
    const datos = obtenerDatosToken_(token) || {};
    const esAdmin = (datos.scope || "") === "admin";
    const propio = (datos.email || "").toLowerCase().trim();
    const objetivo = (correoObjetivo && esAdmin)
      ? correoObjetivo.toString().toLowerCase().trim()
      : propio;

    if (!objetivo) return { exito: false, mensaje: t("err_sin_token"), registros: [] };
    if (correoObjetivo && !esAdmin &&
        correoObjetivo.toString().toLowerCase().trim() !== propio) {
      logWarn("Seguridad", "Intento de leer calificaciones ajenas bloqueado para " + propio);
      return { exito: false, mensaje: t("err_scope_insuficiente"), registros: [] };
    }

    const hist = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("_Historial_Calificaciones");
    if (!hist || hist.getLastRow() < 2) {
      return { exito: true, correo: objetivo, registros: [], resumen: resumirCalificaciones([]) };
    }

    const tz = obtenerZonaHoraria();
    const registros = [];
    hist.getRange(2, 1, hist.getLastRow() - 1, 12).getValues().forEach(f => {
      if ((f[2] || "").toString().toLowerCase().trim() !== objetivo) return;
      const pct = parseFloat(f[7]);
      const porcentaje = isNaN(pct) ? 0 : parseFloat((pct * 100).toFixed(1));
      registros.push({
        fecha: f[0] ? Utilities.formatDate(new Date(f[0]), tz, "yyyy-MM-dd HH:mm") : "",
        estudiante: f[1] || "",
        evaluacion: f[3] || "",
        formId: f[4] || "",
        aciertos: f[5] || 0,
        total: f[6] || 0,
        porcentaje: porcentaje,
        nivel: resolverNivelDesempeno(porcentaje).nivel,
        estado: f[8] || "",
        urlCertificado: f[9] || "",
        moduloId: f[10] || "",
        intentoId: f[11] || ""
      });
    });

    registros.sort((a, b) => (b.fecha || "").localeCompare(a.fecha || ""));
    return { exito: true, correo: objetivo, registros: registros, resumen: resumirCalificaciones(registros) };
  } catch (e) {
    logError("Portal", "buscarCalificacionesEstudiante: " + e.message);
    return { exito: false, mensaje: e.message, registros: [] };
  }
}

/** Métricas agregadas de un conjunto de calificaciones (promedio, mejor, certificados). */
function resumirCalificaciones(registros) {
  if (!registros || registros.length === 0) {
    return { evaluaciones: 0, promedio: 0, mejor: 0, certificados: 0, modulosCertificados: [] };
  }
  let suma = 0;
  let mejor = 0;
  const certificados = {};
  registros.forEach(r => {
    suma += r.porcentaje || 0;
    if ((r.porcentaje || 0) > mejor) mejor = r.porcentaje;
    if ((r.porcentaje || 0) >= ESCALA_DESEMPENO[0].min && r.moduloId) certificados[r.moduloId] = true;
  });
  const modulos = Object.keys(certificados);
  return {
    evaluaciones: registros.length,
    promedio: parseFloat((suma / registros.length).toFixed(1)),
    mejor: mejor,
    certificados: modulos.length,
    modulosCertificados: modulos
  };
}

/**
 * Estadísticas agregadas del catálogo, cacheadas 10 minutos.
 * Es la versión pública (sin scope admin) que alimenta la portada del portal;
 * `invalidarCacheAPI()` borra esta clave junto con el resto del caché.
 */
function servirStatsAgregadasConCache(forzar = false) {
  return obtenerAgregadoConRevision(CLAVE_CACHE_STATS, function () {
    const estados = {};
    const dificultades = {};
    const dominios = {};
    const porModulo = {};
    let total = 0, conExamen = 0, conRAG = 0, conModulo = 0, duracionTotal = 0;

    iterarCatalogoPorBloques(function (datos) {
      datos.forEach(f => {
        if (!f[IDX.URL] && !f[IDX.ID]) return;
        total++;
        const est = f[IDX.ESTADO] || "🟡 Pendiente";
        const dif = f[IDX.DIFICULTAD] || "Principiante";
        const dom = f[IDX.ECOSISTEMA] || "General";
        const mod = (f[IDX.MODULO] || "").toString().trim();
        estados[est] = (estados[est] || 0) + 1;
        dificultades[dif] = (dificultades[dif] || 0) + 1;
        dominios[dom] = (dominios[dom] || 0) + 1;
        duracionTotal += parseFloat(f[IDX.DURACION]) || 0;
        if (f[IDX.URL_FORM]) conExamen++;
        if (f[IDX.DRIVE_RAG]) conRAG++;
        if (mod) { conModulo++; porModulo[mod] = (porModulo[mod] || 0) + 1; }
      });
      return false;
    });

    let modulosPublicados = 0;
    try {
      modulosPublicados = listarModulos().filter(m => m.estado === "PUBLICADO").length;
    } catch (e) { /* módulos no inicializados */ }

    return {
      totalVideos: total,
      estados: estados,
      dificultades: dificultades,
      dominios: dominios,
      conExamen: conExamen,
      conDocumentoRAG: conRAG,
      conModulo: conModulo,
      videosPorModulo: porModulo,
      modulosPublicados: modulosPublicados,
      horasCatalogo: parseFloat((duracionTotal / 60).toFixed(1)),
      generadoEn: new Date().toISOString(),
      version: VERSION_SCRIPT
    };
  }, 600, forzar);
}

/** Vista de administración: las métricas cacheadas más cuotas y salud operativa. */
function obtenerEstadisticasSistema(token) {
  validarTokenConScope(token, "admin");
  const base = servirStatsAgregadasConCache();

  let intentosEnCurso = 0, intentosEntregados = 0;
  try {
    const hi = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("_Intentos");
    if (hi && hi.getLastRow() >= 2) {
      hi.getRange(2, INT.ESTADO + 1, hi.getLastRow() - 1, 1).getValues().forEach(f => {
        if (f[0] === ESTADO_INTENTO.EN_CURSO) intentosEnCurso++;
        else if (f[0] === ESTADO_INTENTO.ENTREGADO) intentosEntregados++;
      });
    }
  } catch (e) { /* aún sin intentos */ }

  base.intentosEnCurso = intentosEnCurso;
  base.intentosEntregados = intentosEntregados;
  base.cuotas = {
    youtube: consultarCuotaDisponible("YOUTUBE"),
    gemini: consultarCuotaDisponible("GEMINI")
  };
  try {
    base.triggersActivos = ScriptApp.getProjectTriggers().length;
    base.triggersLimite = LIMITE_TRIGGERS_SEGURO;
  } catch (e) { /* sin permisos de triggers */ }
  return base;
}

