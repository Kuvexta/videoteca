/**
 * [F0-7] Devuelve el texto plano de la transcripción (compatibilidad hacia atrás).
 * Para obtener las marcas de tiempo usa obtenerTranscripcionConTiempos().
 */
function obtenerTranscripcionYouTube(videoId) {
  const res = obtenerTranscripcionConTiempos(videoId);
  return res ? res.texto : null;
}

/**
 * [F0-7] Extrae la transcripción CONSERVANDO el segundo de inicio de cada frase.
 * El patrón antiguo descartaba el atributo start y con él toda posibilidad de
 * citar el minuto exacto en el informe de auditoría.
 * @return {{texto:string, segmentos:Array<{t:number,texto:string}>}|null}
 */
function obtenerTranscripcionConTiempos(videoId) {
  if (!videoId) return null;
  try {
    return obtenerTranscripcionYouTubeScraping(videoId);
  } catch (e) {
    logWarn("Transcripción", `Fallo al extraer subtítulos de ${videoId}: ${e.message}`);
    return null;
  }
}

function obtenerTranscripcionYouTubeScraping(videoId) {
  if (!videoId) return null;
  const r = ejecutarFetchSeguro("https://www.youtube.com/watch?v=" + videoId, {
    method: "GET",
    followRedirects: true,
    headers: { "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36" }
  }, "YouTube HTML");
  if (!r.ok) return null;

  const html = r.cuerpo;
  const captTracksMatch = html.match(/"captionTracks":\s*(\[[^\]]+\])/);
  if (!captTracksMatch) return null;

  let captionTracks = [];
  try { captionTracks = JSON.parse(captTracksMatch[1]); } catch (e) { return null; }
  if (!captionTracks || captionTracks.length === 0) return null;

  let track = captionTracks.find(c => c.languageCode === "es" || (c.vssId && c.vssId.indexOf(".es") !== -1));
  if (!track) track = captionTracks.find(c => c.languageCode === "en" || (c.vssId && c.vssId.indexOf(".en") !== -1));
  if (!track) track = captionTracks[0];
  if (!track || !track.baseUrl) return null;

  const resXml = ejecutarFetchSeguro(track.baseUrl, { method: "GET" }, "YouTube Captions");
  if (!resXml.ok) return null;

  // Captura el atributo start además del texto: <text start="474.12" dur="3.5">…</text>
  const segmentos = [];
  const lineas = [];
  const regexTextos = /<text([^>]*)>([\s\S]*?)<\/text>/gi;
  let match;
  while ((match = regexTextos.exec(resXml.cuerpo)) !== null) {
    const atributos = match[1] || "";
    const frase = match[2]
      .replace(/&amp;/g, "&").replace(/&lt;/g, "<").replace(/&gt;/g, ">")
      .replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/\n/g, " ").trim();
    if (!frase) continue;
    const mStart = atributos.match(/start="([\d.]+)"/i);
    const segundo = mStart ? Math.floor(parseFloat(mStart[1])) : 0;
    segmentos.push({ t: segundo, texto: frase });
    lineas.push(frase);
  }
  if (lineas.length === 0) return null;
  return { texto: lineas.join(" "), segmentos: segmentos };
}

/** Busca el segundo del segmento que mejor coincide con un texto dado. */
function ubicarSegundoEnSegmentos(segmentos, textoBuscado) {
  if (!segmentos || segmentos.length === 0 || !textoBuscado) return 0;
  const clave = textoBuscado.toString().toLowerCase().slice(0, 60);
  for (let i = 0; i < segmentos.length; i++) {
    if ((segmentos[i].texto || "").toString().toLowerCase().indexOf(clave) !== -1) return segmentos[i].t || 0;
  }
  return 0;
}

function extraerTranscripcionFilaActiva() {
  exigirOrigenInterno("extraerTranscripcionFilaActiva");
  const hoja = obtenerHojaDatos();
  const fila = hoja.getActiveRange().getRow();
  if (fila < 2) { alertarUsuario(t("alert_fila_invalida")); return; }

  const url = hoja.getRange(fila, IDX.URL + 1).getValue().toString().trim();
  const idVideo = hoja.getRange(fila, IDX.ID + 1).getValue().toString().trim();
  if (!url || url.indexOf("youtu") === -1) { alertarUsuario(t("alert_sin_youtube")); return; }

  /* Esta acción es manual y sobre una fila concreta, así que un musical no se
     bloquea: se pregunta. El lote sí lo respeta sin preguntar, porque ahí nadie
     está mirando fila por fila. */
  const datosFila = hoja.getRange(fila, 1, 1, TOTAL_COLUMNAS).getValues()[0];
  if (!filaAdmiteTranscripcion(datosFila)) {
    const ui = SpreadsheetApp.getUi();
    const r = ui.alert(
      "Video musical",
      "Este video está catalogado como musical y la extracción de letras está " +
      "desactivada.\n\nEn un musical los subtítulos son la letra de la canción. " +
      "¿Extraerla igualmente para esta fila?",
      ui.ButtonSet.YES_NO);
    if (r !== ui.Button.YES) return;
  }

  notificarUsuario("Extrayendo transcripción con marcas de tiempo…", "Transcripciones", 5);
  try {
    const res = obtenerTranscripcionConTiempos(idVideo || obtenerIdYouTube(url));
    if (!res || !res.texto) { alertarUsuario(t("alert_sin_transcripcion"), "Transcripciones"); return; }

    const driveId = persistirTextoPesado(idVideo || `yt_${fila}`, res.texto, res.segmentos);
    hoja.getRange(fila, IDX.DRIVE_RAG + 1).setValue(driveId);
    const palabras = res.texto.split(" ").length;
    logInfo("Transcripción", `Guardada para ${idVideo}: ${palabras} palabras, ${res.segmentos.length} segmentos.`);
    alertarUsuario(
      `Se extrajeron ${palabras} palabras en ${res.segmentos.length} segmentos con marca de tiempo.\n` +
      `Guardado en Drive (ID: ${driveId}).`, "✅ Transcripción Guardada");
  } catch (err) {
    logError("Transcripción", err.message);
    alertarUsuario("❌ Error al extraer transcripción: " + err.message);
  }
}

/** Cuántas transcripciones se piden como mucho en una pasada. */
const TRANSCRIPCION_LOTE_MAX = 20;

/**
 * Extrae transcripciones en lote.
 *
 * Antes esto solo miraba las filas marcadas «⭐ Esencial», y ese era el motivo
 * real de que casi ningún video tuviera transcripción: el catálogo entero nace
 * en «🟡 Pendiente», así que el lote no encontraba nada que hacer y no lo decía.
 * Ahora se recorre todo lo que no tenga documento, empezando por lo esencial,
 * que sigue siendo lo primero que interesa tener.
 *
 * @param {boolean} soloEsenciales  true reproduce el comportamiento antiguo.
 * @return {{procesados:number, sinSubtitulos:number, candidatos:number}}
 */
function extraerTranscripcionesEnLote(soloEsenciales) {
  let procesados = 0, sinSubtitulos = 0, candidatos = 0;

  // Dos pasadas: primero lo esencial, después el resto. Con una sola pasada, un
  // catálogo grande gasta el lote entero en las primeras filas de la hoja y lo
  // marcado como esencial no llega nunca.
  const rondas = soloEsenciales === true ? ["esencial"] : ["esencial", "resto"];

  rondas.forEach(function (ronda) {
    if (procesados >= TRANSCRIPCION_LOTE_MAX) return;
    iterarCatalogoPorBloques(function (datos) {
      let mutado = false;
      for (let i = 0; i < datos.length; i++) {
        if (procesados >= TRANSCRIPCION_LOTE_MAX) break;
        const url = (datos[i][IDX.URL] || "").toString().trim();
        const id = (datos[i][IDX.ID] || "").toString().trim();
        const estado = (datos[i][IDX.ESTADO] || "").toString();
        const driveId = (datos[i][IDX.DRIVE_RAG] || "").toString().trim();
        if (!url || !id || driveId) continue;
        // Solo YouTube tiene subtítulos que se puedan leer desde aquí.
        if (url.indexOf("youtu") === -1) continue;

        const esEsencial = estado.indexOf("Esencial") !== -1;
        if (ronda === "esencial" && !esEsencial) continue;
        if (ronda === "resto" && esEsencial) continue;

        /* En un musical los subtítulos son la letra cantada: solo se piden si
           está activado en «IA y Taxonomía → Letras de musicales». */
        if (!filaAdmiteTranscripcion(datos[i])) continue;
        candidatos++;

        notificarUsuario(`Extrayendo transcripción de ${id}…`, "Lote RAG", 3);
        try {
          const res = obtenerTranscripcionConTiempos(id);
          if (res && res.texto) {
            datos[i][IDX.DRIVE_RAG] = persistirTextoPesado(id, res.texto, res.segmentos, {
              // Queda dicho QUÉ es este texto. Sin esto, la letra de una canción
              // y la transcripción de una clase son indistinguibles al leerlas.
              tipoTexto: filaEsCertificable(datos[i]) ? "transcripcion" : "transcripcion_musical"
            });
            procesados++;
            mutado = true;
          } else {
            // No todos los videos tienen subtítulos. Contarlos es lo que
            // distingue «no hay nada que extraer» de «la extracción falló».
            sinSubtitulos++;
          }
        } catch (e) {
          logWarn("Transcripción", `Fallo en ${id}: ${e.message}`);
        }
        Utilities.sleep(800);
      }
      return mutado;
    });
  });

  logInfo("Transcripciones",
    `Lote: ${procesados} guardadas, ${sinSubtitulos} sin subtítulos, ${candidatos} candidatas.`);
  return { procesados: procesados, sinSubtitulos: sinSubtitulos, candidatos: candidatos };
}

/** Entrada de menú del lote. Recorre TODO lo que no tenga documento. */
function extraerTranscripcionesMasivasEsenciales() {
  exigirOrigenInterno("extraerTranscripcionesMasivasEsenciales");
  const r = extraerTranscripcionesEnLote(false);
  if (r.candidatos === 0) {
    alertarUsuario(
      "No quedan videos a los que pedirles transcripción.\n\n" +
      "O ya tienen documento, o no son de YouTube, o son musicales con las " +
      "letras desactivadas.", "Transcripciones");
    return 0;
  }
  alertarUsuario(
    `Transcripciones guardadas: ${r.procesados}\n` +
    `Sin subtítulos disponibles: ${r.sinSubtitulos}\n` +
    `Revisadas en esta pasada: ${r.candidatos}\n\n` +
    (r.procesados >= TRANSCRIPCION_LOTE_MAX
      ? "Se alcanzó el tope de la pasada. Vuelve a ejecutarlo para continuar."
      : "No quedan más pendientes."), "Transcripciones");
  return r.procesados;
}

