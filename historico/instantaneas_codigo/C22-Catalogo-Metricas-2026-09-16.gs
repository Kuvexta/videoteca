// =====================================================================================
// 2.4 [OPT-10] COLA DE TAREAS DIFERIDAS — reintentos con retroceso exponencial
// =====================================================================================
//
// La DLQ aísla filas del catálogo que fallaron al procesarse. Esta cola resuelve
// un problema distinto: TRABAJO que no se pudo hacer por una causa temporal
// —cuota diaria agotada, webhook caído, correo rechazado— y que se perdía en
// silencio con un logWarn. Aquí se persiste, se reintenta con espera creciente y,
// si tras COLA_MAX_INTENTOS sigue fallando, se marca AGOTADA para revisión humana
// en vez de reintentar para siempre.

function obtenerHojaCola() { return asegurarHojaSistema("_Tareas_Pendientes"); }

/** Índices 0-based de _Tareas_Pendientes. */
const COLA = {
  ID: 0, TIPO: 1, PAYLOAD: 2, MOTIVO: 3, INTENTOS: 4, MAX: 5,
  PROXIMO: 6, ESTADO: 7, ERROR: 8, CREADA: 9, ACTUALIZADA: 10
};
const COLA_COLS = 11;

/**
 * Aplaza una tarea. Idempotente por (tipo + payload): si ya hay una pendiente
 * equivalente, se actualiza el motivo en vez de duplicarla — importante porque
 * el mismo fallo de cuota puede dispararse muchas veces en una tanda.
 *
 * @param {string} tipo    identificador manejado por ejecutarTareaDiferida()
 * @param {Object} payload argumentos que necesita la tarea al reintentarse
 * @param {string} motivo  por qué se aplazó (cuota, HTTP 503, etc.)
 */
function encolarTareaDiferida(tipo, payload = {}, motivo = "") {
  exigirOrigenInterno("encolarTareaDiferida");
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(5000)) return { exito: false, mensaje: "Cola ocupada. No se confirmó la inserción." };
  try {
    const sheet = obtenerHojaCola();
    const huella = JSON.stringify(payload || {});

    if (sheet.getLastRow() >= 2) {
      const filas = sheet.getRange(2, 1, sheet.getLastRow() - 1, COLA_COLS).getValues();
      for (let i = 0; i < filas.length; i++) {
        if (![ESTADO_TAREA.PENDIENTE, "EN_PROCESO"].includes(filas[i][COLA.ESTADO])) continue;
        if (filas[i][COLA.TIPO] !== tipo) continue;
        if ((filas[i][COLA.PAYLOAD] || "").toString() !== huella) continue;
        sheet.getRange(i + 2, COLA.MOTIVO + 1).setValue(motivo);
        sheet.getRange(i + 2, COLA.ACTUALIZADA + 1).setValue(new Date());
        return { exito: true, duplicada: true, id: filas[i][COLA.ID] };
      }
    }

    const id = "tsk_" + Utilities.getUuid().replace(/-/g, "").slice(0, 12);
    const proximo = new Date(Date.now() + COLA_ESPERA_BASE_MIN * 60000);
    sheet.appendRow([id, tipo, huella, motivo, 0, COLA_MAX_INTENTOS, proximo,
      ESTADO_TAREA.PENDIENTE, "", new Date(), new Date()]);

    logInfo("Cola", `Tarea aplazada [${tipo}]: ${motivo}`);
    asegurarTriggerCola();
    return { exito: true, duplicada: false, id: id };
  } catch (e) {
    logError("Cola", "No se pudo encolar la tarea: " + e.message);
    return { exito: false, mensaje: e.message };
  } finally {
    lock.releaseLock();
  }
}

/**
 * Despacha una tarea según su tipo. Es el único punto donde se decide qué
 * significa cada `tipo`; añadir un tipo nuevo es añadir un caso aquí.
 * Debe lanzar si falla, para que la cola cuente el intento.
 */
function ejecutarTareaDiferida(tipo, payload) {
  exigirOrigenInterno("ejecutarTareaDiferida");
  const p = payload || {};
  switch (tipo) {
    case "embeddings_catalogo": {
      const token = obtenerTokenAdministrador_();
      if (!token) throw new Error("Sin ADMIN_TOKEN configurado.");
      const r = generarEmbeddingsCatalogo(token, true);
      if (!r.completado) throw new Error(`Aún quedan ${r.pendientes} pendientes.`);
      return r;
    }
    case "fase2_ia":
      return { procesados: ejecutarFase2Paralela(true) };

    case "chunks_catalogo":
      return { indexados: indexarFragmentosCatalogo(true) };

    case "webhook": {
      const res = enviarWebhookConReintento(p.url, p.payload || {});
      if (!res.success) throw new Error(res.error || "Webhook rechazado.");
      return res;
    }
    case "email": {
      MailApp.sendEmail({ to: p.to, subject: p.subject, htmlBody: p.htmlBody });
      return { enviado: true };
    }
    case "telegram": {
      const res = enviarMensajeTelegram(p.chatId || null, p.mensaje || "");
      if (!res.exito) throw new Error("Telegram rechazó el mensaje.");
      return res;
    }
    case "certificado": {
      const url = generarCertificadoAprobado(p);
      if (!url) throw new Error("El certificado no se pudo emitir.");
      if (p.correo && p.referencia) indexarCertificadoEnSheets(p.correo, p.referencia, url);
      return { url: url };
    }
    case "informe_pdf": {
      const r = generarInformePDFIntento(p.intentoId, false);
      if (!r.exito) throw new Error(r.mensaje || "Informe no generado.");
      return r;
    }
    default:
      throw new Error("Tipo de tarea desconocido: " + tipo);
  }
}

/**
 * Procesa las tareas vencidas. La llama el disparador horario y también el menú.
 * Respeta el presupuesto de ejecución: lo que no alcance queda para la vuelta
 * siguiente, con su próximo intento intacto.
 */
// R4: reserva exclusiva durante diez minutos. Una tarea interrumpida queda
// EN_PROCESO para revisión: no se repite automáticamente un envío incierto.
function reservarConsumidorCola_() {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(1000)) return null;
  try {
    const props = PropertiesService.getScriptProperties();
    const previo = JSON.parse(props.getProperty("COLA_CONSUMIDOR_R4") || "null");
    if (previo && previo.hasta > Date.now()) return null;
    const reserva = { id: Utilities.getUuid(), hasta: Date.now() + 10 * 60000 };
    props.setProperty("COLA_CONSUMIDOR_R4", JSON.stringify(reserva));
    return reserva;
  } finally { lock.releaseLock(); }
}

function liberarConsumidorCola_(reserva) {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(1000)) return; // caduca sola; no borrar otra reserva
  try {
    const props = PropertiesService.getScriptProperties();
    const actual = JSON.parse(props.getProperty("COLA_CONSUMIDOR_R4") || "null");
    if (actual && actual.id === reserva.id) props.deleteProperty("COLA_CONSUMIDOR_R4");
  } finally { lock.releaseLock(); }
}

function procesarColaTareas(silencioso = false) {
  exigirOrigenInterno("procesarColaTareas");
  const reserva = reservarConsumidorCola_();
  if (!reserva) return { exitosas: 0, fallidas: 0, agotadas: 0, ocupada: true };
  try {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("_Tareas_Pendientes");
  if (!sheet || sheet.getLastRow() < 2) {
    if (!silencioso) notificarUsuario(t("toast_cola_vacia"), "Cola", 4);
    return { exitosas: 0, fallidas: 0, agotadas: 0 };
  }

  const inicioMs = Date.now();
  const rango = sheet.getRange(2, 1, sheet.getLastRow() - 1, COLA_COLS);
  const filas = rango.getValues();
  const ahora = Date.now();

  let exitosas = 0, fallidas = 0, agotadas = 0, tocadas = 0;

  for (let i = 0; i < filas.length; i++) {
    if (tocadas >= COLA_LOTE_POR_EJECUCION) break;
    if (Date.now() - inicioMs > PRESUPUESTO_EJECUCION_MS) break;

    const f = filas[i];
    if (f[COLA.ESTADO] !== ESTADO_TAREA.PENDIENTE) continue;
    const proximo = f[COLA.PROXIMO] ? new Date(f[COLA.PROXIMO]).getTime() : 0;
    if (proximo > ahora) continue;      // aún no le toca

    tocadas++;
    let payload = {};
    try { payload = JSON.parse(f[COLA.PAYLOAD] || "{}"); } catch (e) { payload = {}; }

    // Persistir la reserva ANTES del efecto externo. Un corte deja evidencia.
    f[COLA.ESTADO] = "EN_PROCESO";
    f[COLA.ACTUALIZADA] = new Date();
    sheet.getRange(i + 2, 1, 1, COLA_COLS).setValues([f]);
    SpreadsheetApp.flush();
    try {
      ejecutarTareaDiferida(f[COLA.TIPO], payload);
      f[COLA.ESTADO] = ESTADO_TAREA.COMPLETADA;
      f[COLA.ERROR] = "";
      f[COLA.ACTUALIZADA] = new Date();
      exitosas++;
      logInfo("Cola", `Tarea completada [${f[COLA.TIPO]}] ${f[COLA.ID]}.`);
    } catch (err) {
      const intentos = (parseInt(f[COLA.INTENTOS], 10) || 0) + 1;
      const max = parseInt(f[COLA.MAX], 10) || COLA_MAX_INTENTOS;
      f[COLA.INTENTOS] = intentos;
      f[COLA.ERROR] = (err.message || "").toString().slice(0, 400);
      f[COLA.ACTUALIZADA] = new Date();

      if (intentos >= max) {
        f[COLA.ESTADO] = ESTADO_TAREA.AGOTADA;
        agotadas++;
        logError("Cola", `Tarea AGOTADA tras ${intentos} intentos [${f[COLA.TIPO]}]: ${f[COLA.ERROR]}`);
        notificarEvento("tarea_agotada", { tipo: f[COLA.TIPO], id: f[COLA.ID], error: f[COLA.ERROR] });
      } else {
        // Retroceso exponencial: 30 min, 1 h, 2 h, 4 h, 8 h.
        const esperaMin = COLA_ESPERA_BASE_MIN * Math.pow(2, intentos - 1);
        f[COLA.ESTADO] = ESTADO_TAREA.PENDIENTE;
        f[COLA.PROXIMO] = new Date(Date.now() + esperaMin * 60000);
        fallidas++;
        logWarn("Cola", `Reintento ${intentos}/${max} en ${esperaMin} min [${f[COLA.TIPO]}]: ${f[COLA.ERROR]}`);
      }
    }
    sheet.getRange(i + 2, 1, 1, COLA_COLS).setValues([f]);
    SpreadsheetApp.flush();
  }

  // Cada resultado se confirma por fila, sin sobrescribir toda la cola.
  if (!silencioso) {
    notificarUsuario(t("toast_cola_procesada", { exitosas: exitosas, fallidas: fallidas, agotadas: agotadas }), "Cola", 5);
  }
  return { exitosas: exitosas, fallidas: fallidas, agotadas: agotadas };
  } finally { liberarConsumidorCola_(reserva); }
}

/** Instala el disparador horario de la cola solo si aún no existe. */
function asegurarTriggerCola() {
  try {
    const yaExiste = ScriptApp.getProjectTriggers()
      .some(trg => trg.getHandlerFunction() === "procesarColaTareasSilencioso_");
    if (yaExiste) return true;
    return Boolean(registrarTriggerSeguro(
      ScriptApp.newTrigger("procesarColaTareasSilencioso_").timeBased().everyHours(1),
      "procesarColaTareasSilencioso_"
    ));
  } catch (e) {
    logWarn("Cola", "No se pudo instalar el disparador: " + e.message);
    return false;
  }
}

function procesarColaTareasSilencioso_() {
  marcarOrigenConfiable();   // [SEC-1] entrada legítima del servidor
  try {
    const r = procesarColaTareas(true);
    if (r.ocupada) return r;
    // Cuando no queda nada pendiente, el disparador se retira solo: no tiene
    // sentido ocupar uno de los 19 cupos para no hacer nada cada hora.
    const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("_Tareas_Pendientes");
    if (sheet && sheet.getLastRow() >= 2) {
      const estados = sheet.getRange(2, COLA.ESTADO + 1, sheet.getLastRow() - 1, 1).getValues();
      if (!estados.some(e => e[0] === ESTADO_TAREA.PENDIENTE)) {
        limpiarTriggersPorFuncion("procesarColaTareasSilencioso_");
        logInfo("Cola", "Cola vacía: disparador horario retirado.");
      }
    }
    return r;
  } catch (e) {
    logError("Cola", "Procesamiento automático fallido: " + e.message);
  }
}

/** Programa la cola desde el menú. */
function programarColaTareas() {
  exigirOrigenInterno("programarColaTareas");
  const ok = asegurarTriggerCola();
  alertarUsuario(ok
    ? "Reintentos programados: la cola se revisará cada hora y el disparador se retirará solo al vaciarse."
    : t("err_triggers_limite", { limite: LIMITE_TRIGGERS_SEGURO }), "Cola de Tareas");
}

/** Muestra el estado de la cola y ofrece limpiar lo ya resuelto. */
function verColaTareasUI() {
  exigirOrigenInterno("verColaTareasUI");
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName("_Tareas_Pendientes");
  if (!sheet || sheet.getLastRow() < 2) { alertarUsuario(t("toast_cola_vacia"), "Cola de Tareas"); return; }

  const filas = sheet.getRange(2, 1, sheet.getLastRow() - 1, COLA_COLS).getValues();
  const porEstado = {};
  const detalle = [];
  filas.forEach(f => {
    const est = f[COLA.ESTADO] || ESTADO_TAREA.PENDIENTE;
    porEstado[est] = (porEstado[est] || 0) + 1;
    if (est === ESTADO_TAREA.PENDIENTE || est === ESTADO_TAREA.AGOTADA) {
      detalle.push(`• [${est}] ${f[COLA.TIPO]} — intento ${f[COLA.INTENTOS]}/${f[COLA.MAX]}` +
        (f[COLA.ERROR] ? `\n    ${f[COLA.ERROR].toString().slice(0, 120)}` : "") +
        (est === ESTADO_TAREA.PENDIENTE && f[COLA.PROXIMO]
          ? `\n    próximo: ${formatearFecha(f[COLA.PROXIMO], "yyyy-MM-dd HH:mm")}` : ""));
    }
  });

  sheet.showSheet();
  sheet.activate();
  alertarUsuario(
    "Resumen: " + Object.keys(porEstado).map(k => `${k}=${porEstado[k]}`).join(" · ") +
    (detalle.length ? "\n\n" + detalle.slice(0, 15).join("\n") : "\n\nNada pendiente."),
    "Cola de Tareas Diferidas");
}

/** Elimina de la cola las tareas ya completadas. Se llama en el mantenimiento. */
function purgarTareasCompletadas() {
  exigirOrigenInterno("purgarTareasCompletadas");
  const reserva = reservarConsumidorCola_();
  if (!reserva) return 0;
  try {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("_Tareas_Pendientes");
  if (!sheet || sheet.getLastRow() < 2) return 0;
  const estados = sheet.getRange(2, COLA.ESTADO + 1, sheet.getLastRow() - 1, 1).getValues();
  let borradas = 0;
  for (let i = estados.length - 1; i >= 0; i--) {
    if (estados[i][0] === ESTADO_TAREA.COMPLETADA || estados[i][0] === ESTADO_TAREA.CANCELADA) {
      sheet.deleteRow(i + 2);
      borradas++;
    }
  }
  if (borradas > 0) logInfo("Cola", `Purgadas ${borradas} tareas resueltas.`);
  return borradas;
  } finally { liberarConsumidorCola_(reserva); }
}

// =====================================================================================
// 3. CRIPTOGRAFÍA HMAC-SHA256, SESIONES EFÍMERAS, RBAC Y RATE LIMITING — [MEJORA 3]
// =====================================================================================

/**
 * Sal criptográfica derivada, única por instalación. Se genera una sola vez.
 */
/* [6.23] LA REGLA QUE FALTABA, Y POR QUÉ.
 *
 * `google.script.run` expone TODAS las funciones globales del proyecto al
 * navegador: no solo las que la página llama, todas. Eso ya estaba escrito
 * arriba y por eso existen las guardas… pero se pusieron en las ENVOLTURAS y
 * no en las implementaciones. `cifrar_()` exigía origen interno y
 * `obtenerClaveMaestraSegura_()` —la que devuelve la clave con la que se sella—
 * no la exigía. `generarSesionCorta_()` la exigía y `emitirSesionInterna_()`, que
 * es donde de verdad se emite la sesión, tampoco.
 *
 * Un comentario que dice «no es alcanzable desde el cliente porque nadie la
 * expone» no es una guarda: en Apps Script lo único que hace privada a una
 * función es el guion bajo final, y ninguna de estas lo tiene. La regla, de
 * ahora en adelante: la guarda va en la función que toca el secreto, aunque su
 * envoltura ya la tenga. Es barata y no estorba —el menú y doPost marcan origen
 * confiable antes de empezar— y es la diferencia entre una defensa y un cartel.
 *
 * [6.24] Y por eso, además de la guarda, el guion bajo: estas funciones ya no
 * son globales visibles para `google.script.run`, así que la llamada ni siquiera
 * llega a la guarda. La guarda se queda como segunda línea, no como única.
 */
function obtenerSalDerivada_() {
  exigirOrigenInterno("obtenerSalDerivada_");
  const props = PropertiesService.getScriptProperties();
  let salt = props.getProperty("APP_CRYPTO_SALT");
  if (!salt) {
    salt = Utilities.getUuid().replace(/-/g, "") + Utilities.getUuid().replace(/-/g, "");
    props.setProperty("APP_CRYPTO_SALT", salt);
    logInfo("Seguridad", "Sal criptográfica generada por primera vez.");
  }
  return salt;
}

/**
 * Clave maestra HMAC derivada de (UUID + clave de usuario temporal + sal).
 * Nunca se expone al portal ni se envía por la API.
 */
function obtenerClaveMaestraSegura_() {
  exigirOrigenInterno("obtenerClaveMaestraSegura_");
  const props = PropertiesService.getScriptProperties();
  let master = props.getProperty("MASTER_SECRET_HMAC");
  if (!master) {
    let semillaUsuario = "";
    try { semillaUsuario = Session.getTemporaryActiveUserKey() || ""; } catch (e) { semillaUsuario = ""; }
    const base = Utilities.getUuid() + "|" + semillaUsuario + "|" + obtenerSalDerivada_();
    const hash = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, base, Utilities.Charset.UTF_8);
    master = Utilities.base64Encode(hash);
    props.setProperty("MASTER_SECRET_HMAC", master);
    logInfo("Seguridad", "Clave maestra HMAC-SHA256 inicializada.");
  }
  return master;
}

/** Clave heredada de v2026.3.5, conservada solo para descifrar secretos antiguos. */
function obtenerClaveMaestra_() {
  exigirOrigenInterno("obtenerClaveMaestra_");
  const props = PropertiesService.getScriptProperties();
  let key = props.getProperty("MASTER_KEY");
  if (!key) {
    key = Utilities.getUuid().replace(/-/g, "").slice(0, 24);
    props.setProperty("MASTER_KEY", key);
  }
  return key;
}

/**
 * [6.25] ESTO NO CIFRA. Sella, que es otra cosa.
 *
 * El formato es "v2.<firmaHMAC>.<textoEnBase64>", y Base64 no es cifrado: se
 * deshace sin ninguna clave. La firma HMAC detecta que alguien haya alterado
 * el valor; NO impide leerlo. El nombre de esta función es engañoso y se
 * conserva solo porque cambiarlo tocaría demasiados sitios a la vez —está en
 * la lista de deudas—, pero la propiedad real es la que está escrita aquí.
 *
 * Consecuencia práctica, que importa más que el nombre: cualquiera que pueda
 * leer las propiedades del proyecto puede leer las API Keys guardadas. Las
 * propiedades de script son datos compartidos del proyecto, no una caja
 * fuerte frente a quien edita su código. El control real es quién es editor
 * del proyecto.
 *
 * Lo que NO hay que hacer con esto: inventarse un cifrado a mano para
 * arreglarlo. Si hiciera falta confidencialidad de verdad frente a los
 * editores, es un almacén de secretos aparte, con sus permisos y su auditoría.
 */
function cifrar_(texto) {
  exigirOrigenInterno("cifrar_");
  if (!texto) return "";
  const plano = texto.toString();
  const secret = obtenerClaveMaestraSegura_();
  const firma = Utilities.computeHmacSha256Signature(plano, secret);
  return "v2." + Utilities.base64Encode(firma) + "." + Utilities.base64Encode(plano, Utilities.Charset.UTF_8);
}

/**
 * Abre el sello y comprueba su integridad —tampoco «descifra», ver arriba—.
 * Compatible hacia atrás con el formato v2026.3.5 ("base64(texto|MASTER_KEY)")
 * para no perder API Keys ya almacenadas.
 */
function descifrar_(cadenaCifrada) {
  exigirOrigenInterno("descifrar_");
  if (!cadenaCifrada) return "";
  const cadena = cadenaCifrada.toString();
  try {
    if (cadena.indexOf("v2.") === 0) {
      const partes = cadena.split(".");
      if (partes.length !== 3) return "";
      const plano = Utilities.newBlob(Utilities.base64Decode(partes[2])).getDataAsString();
      const firmaEsperada = Utilities.base64Encode(
        Utilities.computeHmacSha256Signature(plano, obtenerClaveMaestraSegura_())
      );
      return firmaEsperada === partes[1] ? plano : "";
    }
    // ---- Formato heredado v2026.3.5 ----
    const decoded = Utilities.newBlob(Utilities.base64Decode(cadena)).getDataAsString();
    const parts = decoded.split("|");
    return (parts.length === 2 && parts[1] === obtenerClaveMaestra_()) ? parts[0] : "";
  } catch (e) {
    return "";
  }
}

/** Guarda una API Key sellada. */
function guardarApiKey_(proveedor, clave) {
  exigirOrigenInterno("guardarApiKey_");
  PropertiesService.getScriptProperties().setProperty("API_KEY_" + proveedor, cifrar_(clave));
  /* «Sellada», no «cifrada»: el registro tampoco debe prometer lo que no hay. */
  logInfo("Seguridad", `API Key de ${proveedor} almacenada con sello HMAC (firmada, no cifrada).`);
}

/**
 * Recupera una API Key. Migra automáticamente claves guardadas en formatos previos.
 */
function obtenerApiKey_(proveedor) {
  exigirOrigenInterno("obtenerApiKey_");
  const props = PropertiesService.getScriptProperties();
  const desc = descifrar_(props.getProperty("API_KEY_" + proveedor));
  if (desc) return desc;

  const legacy = PropertiesService.getUserProperties().getProperty(proveedor + "_API_KEY") ||
                 props.getProperty(proveedor + "_API_KEY");
  if (legacy) {
    guardarApiKey_(proveedor, legacy);
    logWarn("Seguridad", `API Key heredada de ${proveedor} migrada al nuevo formato sellado.`);
    return legacy;
  }
  return "";
}

/** Alias histórico usado por el motor multi-LLM. */
function proveedorApiKey(proveedor) {
  return obtenerApiKey_(proveedor);
}

/** Elimina una API Key almacenada. */
function borrarApiKey(proveedor) {
  exigirOrigenInterno("borrarApiKey");
  const props = PropertiesService.getScriptProperties();
  props.deleteProperty("API_KEY_" + proveedor);
  props.deleteProperty(proveedor + "_API_KEY");
  logWarn("Seguridad", `API Key de ${proveedor} eliminada.`);
}

// -------------------------------------------------------------------------------------
// 3.1 Tokens permanentes (RBAC) y sesiones efímeras
// -------------------------------------------------------------------------------------

function obtenerMapaTokens_() {
  exigirOrigenInterno("obtenerMapaTokens_");
  const props = PropertiesService.getScriptProperties();
  const raw = props.getProperty("API_TOKENS_MAP");
  if (!raw) {
    const adminToken = "adm_" + Utilities.getUuid().replace(/-/g, "").slice(0, 20);
    const mapa = {};
    let email = "admin@corporativo.local";
    try { email = Session.getActiveUser().getEmail() || email; } catch (e) { /* sin permisos */ }
    mapa[adminToken] = { scope: "admin", client: "Master Administrator", email: email };
    props.setProperty("API_TOKENS_MAP", JSON.stringify(mapa));
    props.setProperty("ADMIN_TOKEN", adminToken);
    logInfo("Seguridad", "Token maestro de administración generado.");
    return mapa;
  }
  try {
    return JSON.parse(raw);
  } catch (e) {
    logError("Seguridad", "Mapa de tokens corrupto; se regenera.");
    props.deleteProperty("API_TOKENS_MAP");
    return obtenerMapaTokens_();
  }
}

/**
 * El token de administración con el que trabajan el menú y los disparadores.
 *
 * Antes esto era `getProperty("ADMIN_TOKEN")` a secas, repetido en once sitios,
 * y ahí estaba el fallo: `ADMIN_TOKEN` se escribe UNA sola vez, en el momento
 * en que se crea el mapa de tokens. Si el mapa ya existía —creado por una
 * versión anterior, o con el token maestro puesto a mano— esa propiedad nunca
 * se escribió, y el menú decía «no se encontró token de administrador» con tres
 * tokens de scope admin perfectamente válidos en la lista. Un mismo hecho
 * guardado en dos sitios que pueden discrepar.
 *
 * Ahora `ADMIN_TOKEN` es un atajo, no la verdad: la verdad es el mapa. Se
 * comprueba que el atajo siga siendo un token admin vigente —podría haberse
 * revocado o caducado, y antes nadie lo miraba— y, si no lo es, se elige otro
 * del mapa y se repara la propiedad. Solo si de verdad no hay ninguno se
 * devuelve cadena vacía.
 *
 * @return {string} token con scope admin, o "" si no existe ninguno.
 */
function obtenerTokenAdministrador_() {
  /* [6.23] Aquí había una degradación amable que era exactamente lo contrario.
     Decía: «si no se puede consultar el mapa porque el origen no es interno,
     devuelvo el atajo ADMIN_TOKEN tal cual». Es decir: al llamador AUTORIZADO
     le daba el token bueno tras comprobarlo, y al NO autorizado —el único que
     hace saltar la excepción— le entregaba el token maestro sin comprobar
     nada. La excepción de la guarda se había convertido en la puerta.
     Ahora la guarda es lo primero y no hay camino alternativo. */
  exigirOrigenInterno("obtenerTokenAdministrador_");
  const props = PropertiesService.getScriptProperties();
  const mapa = obtenerMapaTokens_();

  const ahora = Date.now();

  function sirve(token) {
    const d = token ? mapa[token] : null;
    if (!d || d.scope !== "admin") return false;
    return !d.expira || ahora <= Number(d.expira);
  }

  const atajo = props.getProperty("ADMIN_TOKEN");
  if (sirve(atajo)) return atajo;

  // Se prefiere el que no caduca: un token perpetuo es el que tiene sentido
  // para procesos de fondo que corren sin nadie delante para renovarlo.
  const candidatos = Object.keys(mapa).filter(sirve);
  if (candidatos.length === 0) return "";
  candidatos.sort(function (a, b) {
    const ea = mapa[a].expira ? Number(mapa[a].expira) : Infinity;
    const eb = mapa[b].expira ? Number(mapa[b].expira) : Infinity;
    return eb - ea;
  });

  props.setProperty("ADMIN_TOKEN", candidatos[0]);
  logInfo("Seguridad", atajo
    ? "ADMIN_TOKEN apuntaba a un token que ya no es admin válido; se reapunta al del mapa."
    : "ADMIN_TOKEN no estaba definido; se toma un token admin existente del mapa.");
  return candidatos[0];
}

function guardarMapaTokens_(mapa) {
  exigirOrigenInterno("guardarMapaTokens_");
  PropertiesService.getScriptProperties().setProperty("API_TOKENS_MAP", JSON.stringify(mapa));
}

/**
 * [MEJORA 3 y 4] Crea un token de sesión de corta duración almacenado SOLO en CacheService.
 * No persiste en ScriptProperties, por lo que expira automáticamente.
 */
/**
 * [SEC-4] Emisión de sesiones. SELLADA frente a llamadas del cliente.
 *
 * Sin esta guarda, cualquiera con el portal abierto podría ejecutar
 *   google.script.run.generarSesionCorta_("jefe@kuvexta.com", 360, "admin")
 * y obtener una sesión de administrador a nombre de otra persona, sin credencial
 * alguna. No es un escenario teórico: es la primera cosa que alguien probaría.
 *
 * Las rutas legítimas son dos, y ambas resuelven el correo desde una credencial
 * verificada antes de llegar aquí: `canjearTokenPorSesion` y el menú de administración.
 */
function generarSesionCorta_(email, duracionMinutos = SESION_DURACION_MIN_DEFAULT, scope = "read_only", nombreVisible = "") {
  exigirOrigenInterno("generarSesionCorta_");
  return emitirSesionInterna_(email, duracionMinutos, scope, nombreVisible);
}

/**
 * Implementación real. Lleva su PROPIA guarda: creer que bastaba con la de
 * `generarSesionCorta_` era el agujero. Sin esto,
 *   google.script.run.emitirSesionInterna_("jefe@kuvexta.com", 360, "admin")
 * devolvía una sesión de administrador a cualquiera con el portal abierto.
 */
/**
 * [6.24] Revisión de autenticación: el interruptor para echar a todo el mundo.
 *
 * Retirar el login compartido no invalida las sesiones que ya emitió: viven
 * hasta seis horas en CacheService y siguen valiendo. Cada sesión se emite con
 * la revisión vigente y se rechaza si no coincide, así que basta cambiar
 * `AUTH_REVISION` en las propiedades del proyecto para que todas caduquen a la
 * vez. No borra claves personales: obliga a volver a entrar con ellas.
 *
 * Se cambia a mano, desde el editor de Apps Script, y ninguna ruta pública debe
 * poder tocarla. Al usarlo, poner un valor NUEVO, nunca uno anterior.
 */
function obtenerRevisionAuth_() {
  return PropertiesService.getScriptProperties().getProperty("AUTH_REVISION") ||
         "revision-seguridad-1";
}

function emitirSesionInterna_(email, duracionMinutos = SESION_DURACION_MIN_DEFAULT, scope = "read_only", nombreVisible = "") {
  exigirOrigenInterno("emitirSesionInterna_");
  const minutos = Math.max(5, Math.min(parseInt(duracionMinutos, 10) || SESION_DURACION_MIN_DEFAULT, 360));
  const token = "sess_" + Utilities.getUuid().replace(/-/g, "");
  const correo = (email || "invitado").toString().toLowerCase().trim();
  // [F0-5] El nombre visible se resuelve del padrón: sin esto todo el historial diría "Sesión Web".
  const nombre = sanitizarEntrada(nombreVisible) || resolverNombreVisible(correo);
  const payload = {
    email: correo,
    nombre: nombre,
    scope: scope || "read_only",
    creado: new Date().getTime(),
    expira: new Date().getTime() + (minutos * 60 * 1000),
    revisionAuth: obtenerRevisionAuth_()
  };
  // CacheService admite hasta 6 horas (21600 s).
  CacheService.getScriptCache().put("SESSION_" + token, JSON.stringify(payload), minutos * 60);
  logInfo("Seguridad", `Sesión efímera emitida para ${payload.email} (${minutos} min, scope ${payload.scope}).`);
  return token;
}

/**
 * [F0-5] Resuelve el nombre visible de un correo consultando el padrón de miembros
 * y, como respaldo, el mapa de tokens permanentes.
 */
function resolverNombreVisible(email) {
  const correo = (email || "").toString().toLowerCase().trim();
  if (!correo) return "";
  try {
    const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("_Miembros_Familia");
    if (sheet && sheet.getLastRow() >= 2) {
      const datos = sheet.getRange(2, 1, sheet.getLastRow() - 1, 2).getValues();
      for (let i = 0; i < datos.length; i++) {
        if ((datos[i][0] || "").toString().toLowerCase().trim() === correo && datos[i][1]) {
          return datos[i][1].toString().trim();
        }
      }
    }
  } catch (e) { /* continúa con el respaldo */ }

  try {
    const mapa = obtenerMapaTokens_();
    const claves = Object.keys(mapa);
    for (let i = 0; i < claves.length; i++) {
      const d = mapa[claves[i]];
      if (d && (d.email || "").toString().toLowerCase().trim() === correo && d.client) return d.client;
    }
  } catch (e) { /* sin respaldo */ }

  return correo.split("@")[0];
}

/** Revoca una sesión efímera antes de su expiración natural. */
function revocarSesionCorta_(token) {
  if (!token) return { exito: false };
  CacheService.getScriptCache().remove("SESSION_" + token);
  logInfo("Seguridad", "Sesión efímera revocada manualmente.");
  return { exito: true };
}

/** Devuelve los datos asociados a un token (sesión o permanente) o null. */
function obtenerDatosToken_(token) {
  if (!token) return null;
  if (token.toString().indexOf("sess_") === 0) {
    const raw = CacheService.getScriptCache().get("SESSION_" + token);
    if (!raw) return null;
    try {
      const ses = JSON.parse(raw);
      if (new Date().getTime() > ses.expira) return null;
      /* Las sesiones emitidas antes de la 6.24 no llevan revisión y caen aquí:
         es exactamente lo que se quiere, porque son las que pudo emitir el
         login compartido. */
      if (ses.revisionAuth !== obtenerRevisionAuth_()) {
        logWarn("Seguridad", "Sesión de una revisión de autenticación anterior; se rechaza.");
        return null;
      }
      return {
        scope: ses.scope,
        client: ses.nombre || resolverNombreVisible(ses.email) || "Usuario",
        email: ses.email,
        efimero: true,
        expira: ses.expira
      };
    } catch (e) {
      return null;
    }
  }
  const data = obtenerMapaTokens_()[token];
  if (!data) return null;

  // [OPT-16] Los tokens permanentes ahora pueden caducar. Un token de
  // integración filtrado ya no vale para siempre: si tiene fecha y venció, se
  // comporta como inexistente. Los tokens antiguos sin campo `expira` siguen
  // siendo perpetuos, así que nada se rompe al actualizar.
  if (data.expira && new Date().getTime() > Number(data.expira)) {
    logWarn("Seguridad", `Token caducado rechazado (${data.client || "sin nombre"}).`);
    return null;
  }

  return {
    scope: data.scope,
    client: data.client,
    email: data.email,
    efimero: false,
    expira: data.expira || null,
    diasRestantes: data.expira
      ? Math.ceil((Number(data.expira) - new Date().getTime()) / 86400000)
      : null
  };
}

/**
 * [OPT-16] Renueva la caducidad de un token permanente sin cambiar su valor.
 * Rotar el token obliga a tocar cada integración; renovarlo no. Con 0 días el
 * token vuelve a ser perpetuo (útil para el ADMIN_TOKEN del propio script,
 * que usan los disparadores desatendidos y no puede caducar sin aviso).
 */
function renovarTokenPermanente(tokenAdmin, tokenObjetivo, dias) {
  validarTokenConScope(tokenAdmin, "admin");
  const mapa = obtenerMapaTokens_();
  if (!mapa[tokenObjetivo]) throw new Error(t("err_sin_token"));

  const numDias = parseInt(dias, 10);
  if (isNaN(numDias) || numDias < 0) throw new Error(t("err_dias_invalidos"));

  if (numDias === 0) delete mapa[tokenObjetivo].expira;
  else mapa[tokenObjetivo].expira = new Date().getTime() + numDias * 86400000;

  guardarMapaTokens_(mapa);
  logInfo("Seguridad", `Token ${mapa[tokenObjetivo].client || ""} renovado: ` +
    (numDias === 0 ? "sin caducidad" : `${numDias} días`));
  return {
    exito: true,
    expira: mapa[tokenObjetivo].expira || null,
    caduca: numDias === 0 ? "nunca" : formatearFecha(new Date(mapa[tokenObjetivo].expira), "yyyy-MM-dd HH:mm")
  };
}

/** Elimina del mapa los tokens permanentes ya caducados. Lo llama el mantenimiento. */
function purgarTokensCaducados() {
  const mapa = obtenerMapaTokens_();
  const ahora = new Date().getTime();
  let purgados = 0;
  Object.keys(mapa).forEach(tk => {
    if (mapa[tk].expira && ahora > Number(mapa[tk].expira)) { delete mapa[tk]; purgados++; }
  });
  if (purgados > 0) {
    guardarMapaTokens_(mapa);
    logInfo("Seguridad", `${purgados} tokens caducados retirados del mapa.`);
    notificarEvento("tokens_caducados", { cantidad: purgados });
  }
  return purgados;
}

/**
 * Validación RBAC unificada: sesiones efímeras + tokens permanentes + tokens de invitación
 * (con expiración y estado activo/inactivo).
 */
/**
 * [OPT-5] Comparación de privilegios por nivel, no por igualdad.
 * Antes la misma condición triple se repetía en dos ramas; cualquier scope nuevo
 * obligaba a tocar ambas. Ahora hay un solo orden: read_only < exam < append < admin.
 */
function scopeAlcanza(scopeToken, scopeRequerido) {
  // Supervisor es una capacidad separada: no hereda escritura ni administración.
  if (scopeRequerido === "acceso_portal") return SCOPES_VALIDOS.indexOf(scopeToken) !== -1;
  if (scopeRequerido === "supervisor") return scopeToken === "supervisor" || scopeToken === "admin";
  if (scopeToken === "supervisor") return false;
  const tiene = NIVEL_SCOPE[scopeToken];
  const pide = NIVEL_SCOPE[scopeRequerido];
  if (!pide) throw new Error(t("err_scope_desconocido", { scope: scopeRequerido, validos: SCOPES_VALIDOS.join(", ") }));
  return Boolean(tiene) && tiene >= pide;
}

/**
 * [OPT-6] Reglas de los tokens de invitación (modo familiar), extraídas de
 * validarTokenConScope. Antes vivían embebidas y su resultado se filtraba
 * comparando el prefijo "403" del mensaje traducido: si alguien editaba la
 * traducción, los tokens caducados dejaban de bloquearse en silencio.
 * Ahora devuelve un veredicto explícito que no depende de ningún texto.
 *
 * @return {{aplica:boolean, valido:boolean, motivo:string}}
 */
function validarTokenInvitacion(tokenRecibido) {
  try {
    const invSheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("_Tokens_Invitacion");
    if (!invSheet || invSheet.getLastRow() < 2) return { aplica: false, valido: true, motivo: "" };

    const filas = invSheet.getRange(2, 1, invSheet.getLastRow() - 1, 7).getValues();
    for (let i = 0; i < filas.length; i++) {
      if (filas[i][0] !== tokenRecibido) continue;

      const expiracion = filas[i][3];
      if (expiracion && new Date(expiracion) < new Date()) {
        return { aplica: true, valido: false, motivo: "err_token_expirado" };
      }
      if (filas[i][6] && filas[i][6].toString().toLowerCase() === "inactivo") {
        return { aplica: true, valido: false, motivo: "err_token_inactivo" };
      }
      const usosMax = parseInt(filas[i][4], 10);
      const usosActual = parseInt(filas[i][5], 10) || 0;
      if (usosMax > 0 && usosActual > usosMax) {
        return { aplica: true, valido: false, motivo: "err_token_inactivo" };
      }
      return { aplica: true, valido: true, motivo: "" };
    }
    return { aplica: false, valido: true, motivo: "" };
  } catch (e) {
    // Un fallo al LEER la hoja no debe bloquear: se registra y se deja pasar al
    // control de scope, que sigue siendo obligatorio.
    logWarn("Seguridad", "No se pudo verificar el token de invitación: " + e.message);
    return { aplica: false, valido: true, motivo: "" };
  }
}

function validarTokenConScope(tokenRecibido, scopeRequerido) {
  if (!tokenRecibido) throw new Error(t("err_sin_token"));

  // 1) Sesiones efímeras.
  if (tokenRecibido.toString().indexOf("sess_") === 0) {
    const datos = obtenerDatosToken_(tokenRecibido);
    if (!datos) throw new Error(t("err_token_expirado"));
    if (scopeAlcanza(datos.scope, scopeRequerido)) return true;
    throw new Error(t("err_scope_insuficiente", { scope: scopeRequerido }));
  }

  /* 2) Tokens permanentes.
        [6.23] Antes esto leía el mapa a pelo y miraba solo el scope, mientras
        `obtenerDatosToken_` —la otra puerta, la que usan las consultas— sí
        comprobaba la caducidad. Resultado: el mismo token vencido era inválido
        por un camino y válido por el otro, y el que autorizaba operaciones era
        justo el que no miraba la fecha. Un token de integración filtrado
        seguía sirviendo para siempre por esta ruta. Ahora hay UNA sola función
        que decide si un token está vivo, y las dos rutas la usan. */
  const data = obtenerDatosToken_(tokenRecibido);
  if (!data) throw new Error(t("err_sin_token"));

  // 3) Reglas adicionales del modo familiar, con veredicto explícito.
  const invitacion = validarTokenInvitacion(tokenRecibido);
  if (invitacion.aplica && !invitacion.valido) throw new Error(t(invitacion.motivo));

  if (scopeAlcanza(data.scope, scopeRequerido)) return true;
  throw new Error(t("err_scope_insuficiente", { scope: scopeRequerido }));
}

/** Verificación de salud del token para el portal. */
function verificarToken(token) {
  validarTokenConScope(token, "read_only");
  const data = obtenerDatosToken_(token) || {};
  const modo = PropertiesService.getScriptProperties().getProperty("APP_MODE") || "corporate";
  return {
    status: "operativo",
    client: data.client || "",
    email: data.email || "",
    scope: data.scope || "read_only",
    efimero: Boolean(data.efimero),
    modo: modo,
    version: VERSION_SCRIPT,
    timestamp: Utilities.formatDate(new Date(), obtenerZonaHoraria(), "yyyy-MM-dd HH:mm:ss")
  };
}

/**
 * [MEJORA 3] Rate limiting por identificador (IP declarada, token o "anon"),
 * con ventana deslizante simple sobre CacheService.
 */
function verificarRateLimit(identificador) {
  try {
    const cache = CacheService.getScriptCache();
    const key = "RATE_LIMIT_" + (identificador || "anon").toString().replace(/[^a-zA-Z0-9]/g, "_").slice(0, 80);
    const actual = parseInt(cache.get(key) || "0", 10);
    if (actual >= RATE_LIMIT_MAX_REQUESTS) {
      logWarn("Rate Limit", `Exceso de llamadas del identificador: ${identificador}`);
      return false;
    }
    cache.put(key, (actual + 1).toString(), RATE_LIMIT_VENTANA_SEG);
    return true;
  } catch (e) {
    return true; // el rate limiting nunca debe bloquear por fallo de caché
  }
}

/**
 * Comparación de secretos en tiempo constante.
 * `a === b` corta en el primer carácter distinto: el tiempo de respuesta filtra
 * cuántos caracteres del prefijo eran correctos. Con muchísimas peticiones eso
 * permite reconstruir la contraseña carácter a carácter. Aquí siempre se
 * recorre la longitud completa y se acumula la diferencia bit a bit.
 */
function compararEnTiempoConstante(a, b) {
  const sa = (a === null || a === undefined) ? "" : a.toString();
  const sb = (b === null || b === undefined) ? "" : b.toString();
  const largo = Math.max(sa.length, sb.length);
  let diferencia = sa.length ^ sb.length;
  for (let i = 0; i < largo; i++) {
    diferencia |= (sa.charCodeAt(i) || 0) ^ (sb.charCodeAt(i) || 0);
  }
  return diferencia === 0;
}

/**
 * [OPT-2] Control de fuerza bruta específico del login.
 * El rate limit general (60 req/60 s) es demasiado permisivo para un formulario
 * de contraseña: permitiría 3.600 pruebas por hora. Aquí la ventana es de 15 min,
 * el umbral de 5 fallos, y cada fallo añade un retardo creciente que encarece el
 * barrido sin castigar al usuario que se equivoca una vez.
 *
 * @return {{permitido:boolean, fallos:number, minutosRestantes:number}}
 */
function estadoIntentosLogin(identificador) {
  try {
    const cache = CacheService.getScriptCache();
    const key = "LOGIN_FAIL_" + (identificador || "anon").toString().replace(/[^a-zA-Z0-9]/g, "_").slice(0, 60);
    const fallos = parseInt(cache.get(key) || "0", 10);
    return {
      permitido: fallos < LOGIN_MAX_INTENTOS,
      fallos: fallos,
      minutosRestantes: Math.ceil(LOGIN_BLOQUEO_SEG / 60),
      clave: key
    };
  } catch (e) {
    return { permitido: true, fallos: 0, minutosRestantes: 0, clave: null };
  }
}

/** Registra un intento fallido y aplica el retardo progresivo. */
function registrarFalloLogin(identificador) {
  const estado = estadoIntentosLogin(identificador);
  if (!estado.clave) return estado;
  try {
    const cache = CacheService.getScriptCache();
    const nuevos = estado.fallos + 1;
    // Al superar el umbral, la entrada se sostiene el tiempo completo de bloqueo.
    cache.put(estado.clave, String(nuevos),
      nuevos >= LOGIN_MAX_INTENTOS ? LOGIN_BLOQUEO_SEG : LOGIN_VENTANA_SEG);

    // Retardo progresivo: 250 ms, 500, 1000, 2000, 4000. Tope de 5 s para no
    // agotar el tiempo de ejecución del propio doPost.
    const retardo = Math.min(LOGIN_RETARDO_BASE_MS * Math.pow(2, nuevos - 1), 5000);
    Utilities.sleep(retardo);

    if (nuevos >= LOGIN_MAX_INTENTOS) {
      logWarn("Seguridad", `Login bloqueado por ${LOGIN_BLOQUEO_SEG / 60} min tras ${nuevos} fallos: ${identificador}`);
      notificarEvento("login_bloqueado", { identificador: identificador, fallos: nuevos });
    }
    return { permitido: nuevos < LOGIN_MAX_INTENTOS, fallos: nuevos, minutosRestantes: Math.ceil(LOGIN_BLOQUEO_SEG / 60) };
  } catch (e) {
    return estado;
  }
}

/** Limpia el contador tras un login correcto. */
function limpiarFallosLogin(identificador) {
  try {
    const estado = estadoIntentosLogin(identificador);
    if (estado.clave) CacheService.getScriptCache().remove(estado.clave);
  } catch (e) { /* best-effort */ }
}

/**
 * [OPT-7] Validación de forma de los payloads de la API.
 * `JSON.parse` acepta cualquier cosa; sin esto, un campo con el tipo equivocado
 * viaja hasta el fondo y revienta con un mensaje sin contexto (o peor, escribe
 * basura en la hoja). Aquí se rechaza en la puerta y se dice qué campo falla.
 *
 * @param {Object} payload  cuerpo ya parseado
 * @param {string} accion   nombre de la acción, para el mensaje de error
 * @param {Object} esquema  { campo: "string"|"number"|"boolean"|"array"|"object" }
 *                          Un tipo con "?" al final marca el campo como opcional.
 */
function validarPayload(payload, accion, esquema) {
  const datos = payload || {};
  Object.keys(esquema).forEach(campo => {
    let tipo = esquema[campo];
    const opcional = tipo.slice(-1) === "?";
    if (opcional) tipo = tipo.slice(0, -1);

    // [OPT-17] Ruta anidada: "modulo.nombre" valida DENTRO del objeto. Sin esto,
    // `{modulo:{}}` pasaba la validación de "object" y el módulo se guardaba sin
    // nombre, quedando invisible en el panel y en la matriz.
    const ruta = campo.split(".");
    let valor = datos;
    for (let i = 0; i < ruta.length && valor !== undefined && valor !== null; i++) {
      valor = valor[ruta[i]];
    }

    // Una cadena de solo espacios es tan vacía como "".
    const ausente = valor === undefined || valor === null ||
      (typeof valor === "string" && valor.trim() === "");
    if (ausente) {
      if (opcional) return;
      throw new Error(t("err_payload_invalido", { accion: accion, campo: campo }));
    }

    let ok;
    switch (tipo) {
      // Un arreglo vacío es VÁLIDO: entregar un examen sin responder nada es un
      // caso real del sistema (todas las preguntas cuentan como OMISION). Exigir
      // longitud > 0 aquí habría bloqueado esa entrega legítima.
      case "array":   ok = Array.isArray(valor); break;
      case "object":  ok = typeof valor === "object" && !Array.isArray(valor); break;
      case "number":
        ok = (typeof valor === "number" && Number.isFinite(valor)) ||
          (typeof valor === "string" && /^[+-]?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][+-]?\d+)?$/.test(valor.trim()) && Number.isFinite(Number(valor)));
        break;
      case "boolean": ok = typeof valor === "boolean" || valor === "true" || valor === "false"; break;
      default:        ok = typeof valor === "string" || typeof valor === "number";
    }
    if (!ok) throw new Error(t("err_payload_invalido", { accion: accion, campo: campo }));
  });
  return true;
}

// -------------------------------------------------------------------------------------
// 3.2 Administración de tokens (UI y API)
// -------------------------------------------------------------------------------------

function administrarTokensUI() {
  exigirOrigenInterno("administrarTokensUI");
  const ui = SpreadsheetApp.getUi();
  const mapa = obtenerMapaTokens_();
  const lista = Object.keys(mapa)
    .map(k => "• " + k.slice(0, 10) + "… | scope: " + mapa[k].scope + " | " + mapa[k].client)
    .join("\n") || "(sin tokens)";

  const opt = ui.alert("🔑 Gestión de Tokens y Scopes",
    "Tokens actuales:\n" + lista + "\n\n¿Generar un nuevo token de acceso?", ui.ButtonSet.YES_NO);
  if (opt !== ui.Button.YES) return;

  // [F0-5] El nombre visible es obligatorio; el correo se pide explícitamente
  // en vez de heredar el del administrador que ejecuta el menú.
  const clientResp = ui.prompt("Nuevo Token", "Nombre completo de la persona, o identificador del sistema:", ui.ButtonSet.OK_CANCEL);
  if (clientResp.getSelectedButton() !== ui.Button.OK) return;
  const client = sanitizarEntrada(clientResp.getResponseText());
  if (!client) { ui.alert("El nombre visible es obligatorio."); return; }

  const emailResp = ui.prompt("Correo", "Correo del titular. Déjalo vacío solo para integraciones máquina a máquina:", ui.ButtonSet.OK_CANCEL);
  if (emailResp.getSelectedButton() !== ui.Button.OK) return;
  const email = emailResp.getResponseText().trim().toLowerCase();
  if (email && email.indexOf("@") === -1) { ui.alert("El correo no parece válido."); return; }

  const scopeResp = ui.prompt("Scope",
    "read_only  → solo consultar el catálogo\n" +
    "exam       → consultar y presentar exámenes certificables\n" +
    "append     → además, dar de alta videos por API\n" +
    "supervisor → consultar resultados de todos, sin administrar\n" +
    "admin      → control total\n\nEscribe el scope:", ui.ButtonSet.OK_CANCEL);
  if (scopeResp.getSelectedButton() !== ui.Button.OK) return;
  const scope = scopeResp.getResponseText().trim().toLowerCase();
  if (SCOPES_VALIDOS.indexOf(scope) === -1) {
    ui.alert(t("alert_scope_invalido"));
    return;
  }

  // [OPT-16] Caducidad opcional. Un token de integración que vive para siempre
  // es una llave sin dueño: si se filtra en un repositorio o un log, nadie se
  // entera. Se sugiere 365 días; 0 mantiene el comportamiento perpetuo anterior.
  const diasResp = ui.prompt("Caducidad",
    "¿Cuántos días debe ser válido este token?\n\n" +
    "Sugerido: 365 · Escribe 0 para que no caduque (solo para automatizaciones internas).",
    ui.ButtonSet.OK_CANCEL);
  if (diasResp.getSelectedButton() !== ui.Button.OK) return;
  const dias = parseInt(diasResp.getResponseText().trim(), 10);
  const diasValidos = isNaN(dias) || dias < 0 ? 365 : dias;

  const token = (scope === "admin" ? "adm_" : "tkn_") + Utilities.getUuid().replace(/-/g, "").slice(0, 20);
  mapa[token] = { scope: scope, client: client, email: email };
  if (diasValidos > 0) mapa[token].expira = new Date().getTime() + diasValidos * 86400000;
  guardarMapaTokens_(mapa);

  const caduca = diasValidos > 0
    ? formatearFecha(new Date(mapa[token].expira), "yyyy-MM-dd")
    : "nunca";
  logInfo("Seguridad", `Token ${scope} generado para ${client}${email ? " (" + email + ")" : " (M2M)"}; caduca: ${caduca}.`);
  ui.alert("Token Generado",
    token + "\n\nScope: " + scope + "\nCaduca: " + caduca +
    "\n\nGuárdalo en un lugar seguro: no volverá a mostrarse completo.", ui.ButtonSet.OK);
}

/** [OPT-16] Renovar o revisar la caducidad de un token desde el menú. */
function renovarTokenUI() {
  exigirOrigenInterno("renovarTokenUI");
  const ui = SpreadsheetApp.getUi();
  const admin = obtenerTokenAdministrador_();
  if (!admin) { ui.alert(t("alert_sin_admin_token")); return; }

  const mapa = obtenerMapaTokens_();
  const ahora = new Date().getTime();
  const inventario = Object.keys(mapa).map(k => {
    const d = mapa[k];
    const estado = !d.expira ? "sin caducidad"
      : (ahora > Number(d.expira)
          ? "CADUCADO"
          : Math.ceil((Number(d.expira) - ahora) / 86400000) + " días");
    return `• ${k.slice(0, 12)}… [${d.scope}] ${d.client || "sin nombre"} → ${estado}`;
  });

  const resp = ui.prompt("🔑 Renovar Token",
    (inventario.length ? inventario.join("\n") : "No hay tokens registrados.") +
    "\n\nPega el token completo a renovar:", ui.ButtonSet.OK_CANCEL);
  if (resp.getSelectedButton() !== ui.Button.OK || !resp.getResponseText().trim()) return;

  const diasResp = ui.prompt("Nueva caducidad", "Días de validez (0 = sin caducidad):", ui.ButtonSet.OK_CANCEL);
  if (diasResp.getSelectedButton() !== ui.Button.OK) return;

  try {
    const r = renovarTokenPermanente(admin, resp.getResponseText().trim(), diasResp.getResponseText().trim());
    ui.alert("Token renovado", "Nueva caducidad: " + r.caduca, ui.ButtonSet.OK);
  } catch (e) {
    ui.alert("Error", e.message, ui.ButtonSet.OK);
  }
}

function listarTokens(token) {
  validarTokenConScope(token, "admin");
  const mapa = obtenerMapaTokens_();
  const ahora = new Date().getTime();
  return Object.keys(mapa).map(k => ({
    tokenHash: k.slice(0, 8) + "...",
    tokenCompleto: k,
    scope: mapa[k].scope,
    client: mapa[k].client,
    email: mapa[k].email,
    expira: mapa[k].expira || null,
    caduca: mapa[k].expira ? formatearFecha(new Date(mapa[k].expira), "yyyy-MM-dd") : "nunca",
    diasRestantes: mapa[k].expira ? Math.ceil((Number(mapa[k].expira) - ahora) / 86400000) : null,
    caducado: Boolean(mapa[k].expira && ahora > Number(mapa[k].expira))
  }));
}

function generarTokenAdmin(tokenMaster, client, scope, email, diasValidez = 365) {
  validarTokenConScope(tokenMaster, "admin");
  if (scope && SCOPES_VALIDOS.indexOf(scope) === -1) {
    throw new Error(t("err_scope_desconocido", { scope: scope, validos: SCOPES_VALIDOS.join(", ") }));
  }
  const mapa = obtenerMapaTokens_();
  const nuevo = (scope === "admin" ? "adm_" : "tkn_") + Utilities.getUuid().replace(/-/g, "").slice(0, 20);
  mapa[nuevo] = { scope: scope || "read_only", client: (client || "Cliente API").trim(), email: (email || "").trim() };

  // [OPT-16] Por API la caducidad es obligatoria por defecto: quien crea tokens
  // de forma programática es justo quien tiende a olvidarlos.
  const dias = parseInt(diasValidez, 10);
  if (!isNaN(dias) && dias > 0) mapa[nuevo].expira = new Date().getTime() + dias * 86400000;

  guardarMapaTokens_(mapa);
  logInfo("Seguridad", `Token API creado vía endpoint para ${client} (${dias > 0 ? dias + " días" : "sin caducidad"}).`);
  return nuevo;
}

function revocarTokenAdmin(tokenMaster, targetToken) {
  validarTokenConScope(tokenMaster, "admin");
  const mapa = obtenerMapaTokens_();
  delete mapa[targetToken];
  guardarMapaTokens_(mapa);
  logWarn("Seguridad", "Token revocado por administrador.");
  return { exito: true };
}

/*
 * [6.34] ROTAR UN TOKEN QUE SE FILTRÓ.
 *
 * `renovarTokenPermanente` cambia la fecha de caducidad, que no sirve de nada
 * cuando lo que se filtró es el VALOR: el token sigue siendo el mismo y quien
 * lo tenga lo sigue teniendo. Rotar es otra cosa — emitir uno nuevo y retirar
 * el viejo— y tiene un problema de orden que no se puede esquivar:
 *
 *   · si se revoca primero, las integraciones que usan el viejo dejan de
 *     funcionar en ese instante y nadie sabe cuáles eran;
 *   · si no se revoca nunca, la rotación no ha servido para nada.
 *
 * Así que son dos pasos separados, con el estado en medio guardado y visible:
 * se emite el nuevo, se actualizan las integraciones con calma, y solo entonces
 * se revoca el viejo. Mientras tanto el panel avisa de que hay una rotación a
 * medias, porque una rotación a medias que nadie recuerda terminar es
 * exactamente lo que se quería evitar.
 */
const PROP_ROTACION_PENDIENTE = "TOKEN_ROTACION_PENDIENTE";

/** Paso 1: emite el sustituto y deja constancia de que falta revocar el viejo. */
function rotarTokenExpuestoUI() {
  exigirContextoHoja_("rotarTokenExpuestoUI");
  marcarOrigenConfiable();
  const ui = SpreadsheetApp.getUi();
  const admin = obtenerTokenAdministrador_();
  if (!admin) { ui.alert(t("alert_sin_admin_token")); return; }

  const props = PropertiesService.getScriptProperties();
  if (props.getProperty(PROP_ROTACION_PENDIENTE)) {
    ui.alert("Rotación a medias",
      "Ya hay una rotación empezada y sin terminar. Acábala antes de empezar otra:\n" +
      "«Revocar el token ya sustituido», en este mismo panel.", ui.ButtonSet.OK);
    return;
  }

  const mapa = obtenerMapaTokens_();
  const inventario = Object.keys(mapa).map(k =>
    "• " + k.slice(0, 12) + "… [" + mapa[k].scope + "] " + (mapa[k].client || "sin nombre"));

  const resp = ui.prompt("🔄 Rotar un token expuesto",
    (inventario.length ? inventario.join("\n") : "No hay tokens.") +
    "\n\nPega ENTERO el token que quieres sustituir:", ui.ButtonSet.OK_CANCEL);
  if (resp.getSelectedButton() !== ui.Button.OK) return;
  const viejo = resp.getResponseText().trim();
  const datos = mapa[viejo];
  if (!datos) { ui.alert("Ese token no está en el mapa."); return; }

  /* [6.35] Un token ya vencido no se rota: se emite uno nuevo y se borra el
     viejo, que es otra decisión y con otras consecuencias. Rotarlo aquí le
     regalaría vigencia a algo que ya había caducado. */
  if (datos.expira && Date.now() > Number(datos.expira)) {
    ui.alert("Ese token ya está caducado",
      "No hace falta rotarlo: ya no autoriza nada. Si quieres uno nuevo para ese " +
      "titular, emítelo desde «Tokens de acceso» y borra este.", ui.ButtonSet.OK);
    return;
  }

  let nuevoToken;
  try {
    /* Mismo scope, mismo titular y misma caducidad: se sustituye el valor, no
       los permisos. Cambiar las dos cosas a la vez hace imposible saber cuál de
       las dos rompió una integración.
       [6.35] `generarTokenAdmin` devuelve una CADENA, no un objeto: tratarlo
       como `{token}` hacía que la rotación reventara justo después de haber
       emitido el sustituto —dejándolo huérfano, sin enseñarlo y sin registrar
       que faltaba revocar el viejo—. Era el peor momento posible para fallar. */
    nuevoToken = generarTokenAdmin(admin, datos.client || "Rotado", datos.scope,
                                   datos.email || "", 0);
    if (typeof nuevoToken !== "string" || !nuevoToken) {
      throw new Error("El generador no devolvió un token válido.");
    }
  } catch (e) {
    ui.alert("No se pudo emitir el sustituto", e.message, ui.ButtonSet.OK);
    return;
  }

  /* A partir de aquí el sustituto YA EXISTE. Si algo falla, se deshace: un
     token emitido que nadie conoce es un secreto vivo que nadie va a revocar. */
  try {
    const mapaTrasEmitir = obtenerMapaTokens_();
    /* La caducidad se copia como INSTANTE, no como días: convertir a días y
       redondear hacia arriba alargaba el plazo, y con `Math.max(1, …)` hasta
       revivía uno caducado. */
    if (datos.expira) mapaTrasEmitir[nuevoToken].expira = datos.expira;
    else delete mapaTrasEmitir[nuevoToken].expira;
    guardarMapaTokens_(mapaTrasEmitir);

    if (props.getProperty("ADMIN_TOKEN") === viejo && datos.scope === "admin") {
      props.setProperty("ADMIN_TOKEN", nuevoToken);
    }
    props.setProperty(PROP_ROTACION_PENDIENTE, JSON.stringify({
      viejo: viejo, nuevoPrefijo: nuevoToken.slice(0, 12),
      client: datos.client || "", scope: datos.scope,
      cuando: new Date().toISOString()
    }));
  } catch (e) {
    try {
      const deshacer = obtenerMapaTokens_();
      delete deshacer[nuevoToken];
      guardarMapaTokens_(deshacer);
      if (props.getProperty("ADMIN_TOKEN") === nuevoToken) props.setProperty("ADMIN_TOKEN", viejo);
      props.deleteProperty(PROP_ROTACION_PENDIENTE);
      ui.alert("No se pudo completar la rotación",
        "El sustituto se retiró y todo quedó como estaba. Causa: " + e.message, ui.ButtonSet.OK);
    } catch (e2) {
      ui.alert("⚠️ Rotación a medias",
        "Se emitió un token que empieza por " + nuevoToken.slice(0, 12) +
        "… y no se pudo dejar registrado ni deshacer.\n\nRevísalo en «Tokens de acceso» " +
        "y bórralo si no lo vas a usar. Causa: " + e.message, ui.ButtonSet.OK);
    }
    return;
  }

  /* El valor NO va al registro. Se enseña aquí una vez y se copia de aquí. */
  logInfo("Seguridad", "Rotación iniciada para un token de scope " + datos.scope +
    "; falta revocar el anterior.");

  ui.alert("🔄 Token sustituto emitido",
    "NUEVO TOKEN (cópialo ahora; no se vuelve a mostrar):\n\n" + nuevoToken +
    "\n\nLos DOS son válidos ahora mismo. Actualiza con este las integraciones que " +
    "usaban el anterior y, cuando estén todas, vuelve al panel y usa\n" +
    "«Revocar el token ya sustituido».\n\n" +
    "Hasta que lo hagas, el token filtrado sigue funcionando.", ui.ButtonSet.OK);
}

/** Paso 2: retira el viejo. Es el que de verdad cierra la fuga. */
function revocarTokenRotadoUI() {
  exigirContextoHoja_("revocarTokenRotadoUI");
  marcarOrigenConfiable();
  const props = PropertiesService.getScriptProperties();
  const crudo = props.getProperty(PROP_ROTACION_PENDIENTE);
  if (!crudo) {
    alertarUsuario("No hay ninguna rotación pendiente.", "🔄 Rotación");
    return;
  }
  const pendiente = JSON.parse(crudo);
  if (!preguntarUsuario("🔄 Revocar el token sustituido",
      "Se va a retirar el token anterior de «" + (pendiente.client || "sin nombre") +
      "» [" + pendiente.scope + "].\n\n" +
      "Si alguna integración sigue usándolo, dejará de funcionar AHORA.\n\n" +
      "¿Están todas actualizadas con el token nuevo (" + pendiente.nuevoPrefijo + "…)?", false)) return;

  try {
    revocarTokenAdmin(obtenerTokenAdministrador_(), pendiente.viejo);
    props.deleteProperty(PROP_ROTACION_PENDIENTE);
    logWarn("Seguridad", "Token anterior revocado: rotación completada.");
    alertarUsuario("Token anterior revocado. La rotación está completa.", "🔄 Rotación");
  } catch (e) {
    alertarUsuario("No se pudo revocar: " + e.message +
      "\n\nLa rotación sigue pendiente.", "❌ Rotación");
  }
}

/** Texto de la fila del panel cuando queda una rotación a medias. */
function estadoRotacionPendiente_() {
  try {
    const d = JSON.parse(PropertiesService.getScriptProperties().getProperty(PROP_ROTACION_PENDIENTE) || "{}");
    const cuando = d.cuando ? formatearFecha(new Date(d.cuando), "yyyy-MM-dd HH:mm") : "";
    return "Token sin revocar de «" + (d.client || "sin nombre") + "»" + (cuando ? " (" + cuando + ")" : "");
  } catch (e) {
    return "Hay una rotación de token sin terminar";
  }
}

function cambiarModoAplicacion(tokenMaster, modo) {
  validarTokenConScope(tokenMaster, "admin");
  PropertiesService.getScriptProperties().setProperty("APP_MODE", modo);
  logInfo("Seguridad", "Modo de aplicación cambiado a: " + modo);
  return { exito: true, modo: modo };
}

/**
 * [6.24] La contraseña del portal ya no abre nada: el login compartido se
 * retiró. La función sigue existiendo —estaba en el menú desde la 6.12 y
 * borrarla dejaría un hueco silencioso— pero ahora hace lo contrario de lo que
 * hacía: explica por qué no sirve y ofrece borrar la que quedó guardada, que es
 * la única tarea pendiente que tiene sentido con esa propiedad.
 */
function configurarPasswordPortal() {
  exigirOrigenInterno("configurarPasswordPortal");
  const props = PropertiesService.getScriptProperties();
  const existe = Boolean(props.getProperty("PORTAL_PASSWORD_ENC"));
  if (!existe) {
    alertarUsuario(
      "El acceso por contraseña compartida se retiró en la v6.24 y no queda ninguna guardada.\n\n" +
      "Cada persona entra con su clave personal: emítelas desde «Administrar tokens».",
      "🔐 Contraseña del portal");
    return;
  }
  const borrar = preguntarUsuario("🔐 Contraseña del portal",
    "El acceso por contraseña compartida se retiró: esa contraseña ya no deja entrar a nadie, " +
    "solo sigue guardada en las propiedades del proyecto.\n\n¿La borro?", false);
  if (!borrar) return;
  props.deleteProperty("PORTAL_PASSWORD_ENC");
  logInfo("Seguridad", "Contraseña compartida del portal eliminada tras retirar ese acceso.");
  notificarUsuario("Contraseña compartida eliminada.", "Seguridad", 4);
}

// =====================================================================================
// 3.4 [SEC-2] PUERTA ÚNICA DEL PORTAL — lista blanca de acciones
// =====================================================================================
//
// El portal web NO invoca funciones del proyecto directamente: todo pasa por aquí.
// Esto convierte una superficie de 451 funciones en una de 24 acciones declaradas,
// cada una con su scope mínimo y su validación de token.
//
// Complementa —no sustituye— a exigirOrigenInterno(): esa guarda protege lo que el
// portal nunca debe tocar; esta lista define lo único que sí puede tocar.

/**
 * Contrato de las acciones del portal.
 *   scope   → privilegio mínimo. "publico" = sin token (solo el canje de acceso).
 *   fn      → recibe (datos, sesion) y devuelve el payload de respuesta.
 *   esquema → validación de forma del cuerpo, opcional.
 */
function obtenerRutasPortal() {
  return {

    // ---------- Acceso ----------
    canjear_token: {
      scope: "publico",
      esquema: { tokenPersonal: "string" },
      fn: function (d) { return canjearTokenPorSesion(d.tokenPersonal); }
    },
    sesion_actual: {
      scope: "acceso_portal",
      fn: function (d, s) {
        return { email: s.email, nombre: s.client, scope: s.scope, expira: s.expira };
      }
    },
    logout: {
      scope: "acceso_portal",
      fn: function (d, s, token) { return revocarSesionCorta_(token); }
    },

    // ---------- Identidad del portal ----------
    // La lee cualquiera con sesión: el nombre y el logo se pintan en la cabecera
    // antes que nada. Cambiarla es cosa del administrador.
    marca: { scope: "acceso_portal", fn: function () { return obtenerMarcaPortal(); } },
    supervision_resultados: {
      scope: "supervisor",
      fn: function(d, s, tk) { return consultarResultadosSupervision(tk, d); }
    },
    marca_set: {
      scope: "admin",
      esquema: { marca: "object" },
      fn: function (d, s, tk) { return guardarMarcaPortal(tk, d.marca); }
    },

    // ---------- Inicio ----------
    notifications:   { scope: "read_only", fn: function (d, s, tk) { return consultarNotificacionesPendientes(tk); } },
    stats_publicas:  { scope: "read_only", fn: function () { return servirStatsAgregadasConCache(); } },

    // ---------- Catálogo y reproductor ----------
    catalogo: {
      scope: "read_only",
      fn: function (d, s, tk) {
        return obtenerCatalogoPublico(
          parseInt(d.page, 10) || 1,
          Math.min(parseInt(d.pageSize, 10) || 9, 48),
          tk, d.filtros || {});
      }
    },
    filtros: { scope: "read_only", fn: function () { return obtenerFiltrosCache(); } },
    search: {
      scope: "read_only",
      esquema: { query: "string" },
      // Los filtros activos viajan con la consulta: buscar "factura" con el
      // dominio Odoo puesto no puede devolver videos de otro dominio, o el
      // filtro de la pantalla y el resultado dicen cosas distintas.
      fn: function (d, s, tk) { return buscarSemanticoWeb(tk, d.query, d.filtros || null); }
    },
    register_view: {
      scope: "read_only",
      esquema: { idVideo: "string" },
      fn: function (d, s, tk) { return registrarVisualizacionVideo(tk, d.idVideo, d.titulo || ""); }
    },
    save_progress: {
      scope: "read_only",
      esquema: { idVideo: "string", segundo: "number", duracion: "number" },
      fn: function (d, s, tk) { return guardarProgresoVideo(tk, d.idVideo, d.segundo, d.duracion); }
    },
    progreso: { scope: "read_only", fn: function (d, s, tk) { return obtenerProgresoUsuario(tk); } },

    // ---------- Módulos ----------
    modulos_list: { scope: "read_only", fn: function (d, s, tk) { return obtenerModulosUsuario(tk); } },
    modulo_estado: {
      scope: "read_only",
      esquema: { moduloId: "string" },
      fn: function (d, s) {
        // El correo sale de la sesión, jamás del cuerpo: sin esto se podría
        // consultar el avance de cualquier compañero pasando su dirección.
        const est = obtenerEstadoModuloUsuario(s.email, d.moduloId);
        if (!est) throw new Error(t("err_modulo_no_existe", { modulo: d.moduloId }));
        return est;
      }
    },

    // ---------- Examen certificable ----------
    intento_iniciar: {
      scope: "read_only",
      esquema: { moduloId: "string" },
      fn: function (d, s, tk) { return iniciarIntentoModulo(tk, d.moduloId); }
    },
    intento_guardar: {
      scope: "read_only",
      esquema: { intentoId: "string", respuesta: "object", "respuesta.numeroPregunta": "number" },
      fn: function (d, s, tk) { return guardarAvanceIntento(tk, d.intentoId, d.respuesta); }
    },
    intento_entregar: {
      scope: "read_only",
      esquema: { intentoId: "string", respuestas: "array" },
      fn: function (d, s, tk) { return entregarIntentoModulo(tk, d.intentoId, d.respuestas || []); }
    },

    // ---------- Informes ----------
    informe_intento: {
      scope: "read_only",
      esquema: { intentoId: "string" },
      fn: function (d, s) {
        const informe = informeIntentoDeSesion(d.intentoId, s);
        informe.resumenUsuario = resumirInformeParaColaborador(informe);
        return informe;
      }
    },
    informe_pdf: {
      scope: "read_only",
      esquema: { intentoId: "string" },
      fn: function (d, s) {
        informeIntentoDeSesion(d.intentoId, s);          // valida propiedad antes de generar
        const r = generarInformePDFIntento(d.intentoId, s.scope === "admin");
        if (!r.exito) throw new Error(r.mensaje || "No se pudo generar el informe.");
        return { url: r.url, nombre: r.nombre };
      }
    },

    // ---------- Notas y refuerzo ----------
    notas:    { scope: "read_only", fn: function (d, s, tk) { return buscarCalificacionesEstudiante(tk); } },
    // El servidor decide qué toca hacer ahora; el portal solo lo pinta. Si esa
    // decisión viviera en el navegador, cada pantalla podría contradecir a otra.
    siguiente_paso: { scope: "read_only", fn: function (d, s, tk) { return obtenerSiguientePaso(tk); } },
    estadisticas_usuario: { scope: "read_only", fn: function (d, s, tk) { return obtenerEstadisticasUsuario(tk); } },

    // ---------- Favoritos y notas personales ----------
    // Todo lo de aquí es del USUARIO de la sesión: ninguna ruta acepta un correo
    // en el cuerpo, así que nadie puede leer ni escribir las notas de otro.
    favoritos_list: { scope: "read_only", fn: function (d, s, tk) { return listarFavoritos(tk); } },
    favorito_toggle: {
      scope: "read_only",
      esquema: { idVideo: "string" },
      fn: function (d, s, tk) { return alternarFavorito(tk, d.idVideo); }
    },
    nota_get: {
      scope: "read_only",
      esquema: { idVideo: "string" },
      fn: function (d, s, tk) { return obtenerNotaVideo(tk, d.idVideo); }
    },
    nota_set: {
      scope: "read_only",
      esquema: { idVideo: "string", texto: "string" },
      fn: function (d, s, tk) { return guardarNotaVideo(tk, d.idVideo, d.texto); }
    },
    notas_list: { scope: "read_only", fn: function (d, s, tk) { return listarNotasUsuario(tk); } },

    // ---------- Incidencias ----------
    // Reportar lo puede hacer cualquiera —es el canal para decir "este video no
    // carga" o "esta pregunta está mal"—; listar y cerrar es del administrador.
    reportar_incidencia: {
      scope: "read_only",
      esquema: { tipo: "string", descripcion: "string" },
      fn: function (d, s, tk) {
        return reportarIncidencia(tk, d.tipo, d.descripcion, d.contexto || "", d.referencia || "");
      }
    },

    // ---------- Ficha de estudio del video ----------
    // Devuelve el CONTENIDO del documento de Drive, no su id: el reproductor no
    // tiene por qué saber dónde vive el archivo para poder enseñarlo.
    ficha_video: {
      scope: "read_only",
      esquema: { idVideo: "string" },
      fn: function (d, s, tk) { return obtenerFichaVideo(tk, d.idVideo); }
    },

    // ---------- Documento maestro ----------
    documento_maestro: {
      scope: "read_only",
      esquema: { moduloId: "string" },
      fn: function (d, s, tk) { return obtenerDocumentoMaestro(tk, d.moduloId); }
    },

    // Cualquiera puede PROPONER un video; solo el administrador lo aprueba.
    sugerir_video: {
      scope: "read_only",
      esquema: { url: "string" },
      fn: function (d, s, tk) { return sugerirVideo(tk, d.url, d.titulo || "", d.motivo || ""); }
    },

    // ---------- Administración ----------
    // Todo lo de abajo exige scope admin. La comprobación la hace la pasarela
    // ANTES de invocar la función, y cada función la repite por su cuenta: una
    // sola capa de defensa es una capa de menos de la que hace falta.
    panel_admin: { scope: "admin", fn: function (d, s, tk) { return obtenerPanelAdministracion(tk); } },
    actividad: {
      scope: "admin",
      fn: function (d, s, tk) { return obtenerActividadReciente(tk, d.minutos); }
    },
    dispositivos_usuario: {
      scope: "admin",
      esquema: { correo: "string" },
      fn: function (d, s, tk) { return obtenerDispositivosUsuario(tk, d.correo); }
    },
    agregar_video: {
      scope: "admin",
      esquema: { url: "string" },
      fn: function (d, s, tk) { return agregarVideoDirecto(tk, d.url, { titulo: d.titulo || "" }); }
    },
    sugerencias_list: {
      scope: "admin",
      fn: function (d, s, tk) { return listarSugerencias(tk, d.estado || ""); }
    },
    sugerencia_resolver: {
      scope: "admin",
      esquema: { idSugerencia: "string" },
      fn: function (d, s, tk) {
        return resolverSugerencia(tk, d.idSugerencia, d.aprobar === true, d.nota || "");
      }
    },
    // Asignación masiva de videos a un módulo. Va en dos pasos —simular y
    // aplicar— por la misma ruta: si fueran dos rutas distintas, nada obligaría
    // a que la vista previa y la escritura usaran el mismo criterio.
    asignar_modulo_masivo: {
      scope: "admin",
      esquema: { moduloId: "string" },
      fn: function (d, s, tk) {
        return asignarVideosPorFiltros(tk, d.moduloId, d.filtros || {}, {
          simular: d.simular === true,
          reemplazar: d.reemplazar === true
        });
      }
    },
    incidencias_list: {
      scope: "admin",
      fn: function (d, s, tk) { return listarIncidencias(tk, d.estado || ""); }
    },
    incidencia_cerrar: {
      scope: "admin",
      esquema: { idIncidencia: "string" },
      fn: function (d, s, tk) { return cerrarIncidencia(tk, d.idIncidencia, d.respuesta || ""); }
    },
    refuerzo: { scope: "read_only", fn: function (d, s, tk) { return obtenerTareasRefuerzoUsuario(tk); } },
    mark_task: {
      scope: "read_only",
      esquema: { idTarea: "string" },
      fn: function (d, s, tk) { return marcarTareaRefuerzoVista(tk, d.idTarea); }
    },
    check_reevaluation: {
      scope: "read_only",
      esquema: { referencia: "string" },
      fn: function (d, s, tk) { return verificarDesbloqueoReevaluacion(tk, d.referencia); }
    },
    agendar_recordatorio: {
      scope: "read_only",
      fn: function (d, s, tk) { return agendarRecordatorioEnCalendar(tk, d.opciones || {}); }
    },

    // ---------- Preferencias ----------
    preferences_get: { scope: "read_only", fn: function (d, s, tk) { return obtenerPreferenciasUsuario(tk); } },
    preferences_set: {
      scope: "read_only",
      esquema: { preferencias: "object" },
      fn: function (d, s, tk) { return guardarPreferenciasUsuario(tk, d.preferencias); }
    },
    register_device: {
      scope: "read_only",
      fn: function (d, s, tk) {
        return registrarAccesoDispositivo(tk, d.ip || "", d.userAgent || "", d.fingerprint || "");
      }
    },

    /**
     * [SEC-7] Diagnóstico del portal. Es la única forma de que alguien pueda
     * decir QUÉ está fallando sin acceso a la hoja ni al registro de ejecuciones.
     * No expone datos: solo cuenta filas, nombra hojas y dice si falta configurar.
     */
    diagnostico: {
      scope: "read_only",
      fn: function (d, s, tk) {
        const ss = SpreadsheetApp.getActiveSpreadsheet();
        const inicio = Date.now();
        const r = {
          version: VERSION_SCRIPT,
          // Cuántas acciones expone la pasarela. Es el número que dice, sin
          // abrir el editor, si el Codigo.gs desplegado trae las rutas que el
          // portal está pidiendo: un portal nuevo contra un backend viejo se
          // ve exactamente aquí, y no en ningún otro sitio.
          rutasPortal: Object.keys(obtenerRutasPortal()).length,
          sesion: { email: s.email, scope: s.scope, expiraEn: Math.round((s.expira - Date.now()) / 60000) + " min" },
          hojaDatos: "", filasCatalogo: 0, columnas: 0, columnasEsperadas: TOTAL_COLUMNAS,
          hojasFaltantes: [], modulos: 0, preguntasValidadas: 0,
          apiGemini: Boolean(proveedorApiKey("GEMINI")),
          indiceSemantico: 0, zonaHoraria: obtenerZonaHoraria(), errores: []
        };

        try {
          const hoja = obtenerHojaDatos();
          r.hojaDatos = hoja.getName();
          r.filasCatalogo = Math.max(0, hoja.getLastRow() - 1);
          r.columnas = hoja.getMaxColumns();
        } catch (e) { r.errores.push("Hoja de datos: " + e.message); }

        try { r.hojasFaltantes = HOJAS_SISTEMA.filter(function (n) { return !ss.getSheetByName(n); }); }
        catch (e) { r.errores.push("Hojas de sistema: " + e.message); }

        try { r.modulos = listarModulos().length; } catch (e) { r.errores.push("Módulos: " + e.message); }

        try {
          const cl = ss.getSheetByName("_Claves_Examenes");
          if (cl && cl.getLastRow() >= 2) {
            r.preguntasValidadas = cl.getRange(2, CLAVE.VALIDACION + 1, cl.getLastRow() - 1, 1)
              .getValues().filter(function (f) { return f[0] === VALIDACION.VALIDADA; }).length;
          }
        } catch (e) { r.errores.push("Banco: " + e.message); }

        try {
          const ch = ss.getSheetByName("_Embeddings_Chunks");
          r.indiceSemantico = ch ? Math.max(0, ch.getLastRow() - 1) : 0;
        } catch (e) { /* opcional */ }

        // Cuánto tarda de verdad una pasada del catálogo: es el número que
        // explica una carga lenta, y el que nadie puede medir desde fuera.
        try {
          const t0 = Date.now();
          let n = 0;
          iterarCatalogoPorBloques(function (datos) { n += datos.length; return false; });
          r.msPasadaCatalogo = Date.now() - t0;
        } catch (e) { r.errores.push("Recorrido del catálogo: " + e.message); }

        r.msTotal = Date.now() - inicio;
        return r;
      }
    },

    // ---------- Administración ----------
    stats: { scope: "admin", fn: function (d, s, tk) { return obtenerEstadisticasSistema(tk); } },
    informe_auditoria: {
      scope: "admin",
      esquema: { moduloId: "string" },
      fn: function (d, s, tk) { return obtenerInformeAuditoria(tk, d.moduloId); }
    }
  };
}

/**
 * Informe de un intento con comprobación de propiedad.
 * `obtenerInformeIntento` no distingue de quién es el intento —dentro del servidor
 * eso está bien—, así que la frontera se pone aquí: solo el dueño o un admin.
 * El anexo forense se incluye ÚNICAMENTE para admin: es una señal para revisión
 * humana, no algo que se le entregue a quien presentó el examen.
 */
function informeIntentoDeSesion(intentoId, sesion) {
  /* [6.24] `sesion` tiene que venir de `obtenerDatosToken_`, nunca del cuerpo
     de la petición: un {email, scope} que manda el navegador no acredita nada,
     y aquí es lo único que separa tu informe del de otra persona. */
  exigirOrigenInterno("informeIntentoDeSesion");
  if (!sesion || !sesion.email) throw new Error(t("err_sin_token"));

  const reg = leerIntento(intentoId);
  if (!reg) throw new Error(t("err_intento_no_existe"));

  const esAdmin = sesion.scope === "admin";
  const duenio = (reg.datos[INT.EMAIL] || "").toString().toLowerCase().trim();
  if (!esAdmin && duenio !== (sesion.email || "").toLowerCase().trim()) {
    logWarn("Seguridad", `Intento de leer un informe ajeno: ${sesion.email} → ${intentoId}`);
    throw new Error(t("err_intento_ajeno"));
  }
  /* Doble comprobación a propósito: aquí se decide QUIÉN puede pedirlo y en el
     generador QUÉ se puede explicar. Son dos responsabilidades y ninguna de las
     dos debe depender de que la otra siga en su sitio. Ni siquiera un
     administrador ve el solucionario de un examen en curso: para seguir uno
     abierto hace falta una vista que no devuelva respuestas. */
  exigirIntentoEntregado_(reg);
  return obtenerInformeIntento(intentoId, esAdmin);
}

/**
 * ÚNICO punto de entrada del portal web.
 *
 * Devuelve siempre la misma forma —{ok, data} o {ok:false, error, codigo}— para que
 * el cliente no tenga que distinguir entre una excepción y un fallo de negocio.
 *
 * @param {string} accion  clave de obtenerRutasPortal()
 * @param {Object} datos   cuerpo de la petición; `token` viaja aquí
 */
function apiPortal(accion, datos) {
  marcarOrigenConfiable();
  const d = datos || {};
  const token = (d.token || "").toString();

  try {
    const ruta = obtenerRutasPortal()[accion];
    if (!ruta) {
      logWarn("Portal", `Acción fuera de la lista blanca: ${accion}`);
      return { ok: false, codigo: 403, error: t("err_accion_no_permitida", { accion: accion || "(vacía)" }) };
    }

    // [MEJORA 3] El límite de peticiones también aquí: google.script.run no pasa
    // por doGet ni doPost, así que sin esto una sesión podría martillear sin freno.
    const identificador = token || "portal_anonimo";
    if (!verificarRateLimit(identificador)) {
      return { ok: false, codigo: 429, error: t("toast_rate_limit") };
    }

    if (ruta.esquema) validarPayload(d, accion, ruta.esquema);

    // Acción pública: solo el canje de acceso.
    if (ruta.scope === "publico") {
      return { ok: true, data: ruta.fn(d, null, token) };
    }

    validarTokenConScope(token, ruta.scope);
    const sesion = obtenerDatosToken_(token);
    if (!sesion) return { ok: false, codigo: 401, error: t("err_sin_token") };

    return { ok: true, data: ruta.fn(d, sesion, token) };

  } catch (e) {
    const mensaje = (e && e.message) ? e.message : "Error desconocido.";
    const codigo = /^401/.test(mensaje) ? 401 : (/^403/.test(mensaje) ? 403 : 400);
    if (codigo !== 400) logWarn("Portal", `${accion} → ${mensaje}`);
    else logError("Portal", `${accion} → ${mensaje}`);
    return { ok: false, codigo: codigo, error: mensaje };
  }
}

/**
 * [SEC-3] Canjea el token personal del colaborador por una sesión efímera.
 *
 * Sustituye al login por contraseña. El correo y el scope NO se piden: vienen
 * grabados en el token, así que la identidad es verificada y no declarada. Es lo
 * que hace que un certificado documente algo.
 *
 * El token personal solo viaja en este canje; a partir de aquí todo usa la sesión.
 */
function canjearTokenPorSesion(tokenPersonal) {
  const tk = (tokenPersonal || "").toString().trim();
  if (!tk) throw new Error(t("err_token_personal_invalido"));

  // Una sesión no se canjea por otra sesión.
  if (tk.indexOf("sess_") === 0) throw new Error(t("err_token_personal_invalido"));

  // validarTokenConScope ya comprueba existencia, caducidad, revocación y estado.
  try {
    validarTokenConScope(tk, "acceso_portal");
  } catch (e) {
    logWarn("Portal", "Canje rechazado: " + e.message);
    throw new Error(t("err_token_personal_invalido"));
  }

  const datos = obtenerDatosToken_(tk);
  if (!datos || !datos.email) throw new Error(t("err_token_personal_invalido"));

  const sesion = emitirSesionInterna_(datos.email, SESION_DURACION_MIN_DEFAULT, datos.scope, datos.client);
  registrarUsoTokenPersonal(tk);

  logInfo("Portal", `Acceso por token personal: ${datos.email} (scope ${datos.scope}).`);
  return {
    token: sesion,
    email: datos.email,
    nombre: datos.client || resolverNombreVisible(datos.email),
    scope: datos.scope,
    expiraMinutos: SESION_DURACION_MIN_DEFAULT
  };
}

/** Telemetría de uso del token personal. Cuenta accesos; nunca los limita. */
function registrarUsoTokenPersonal(token) {
  exigirOrigenInterno("registrarUsoTokenPersonal");
  try {
    const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("_Tokens_Invitacion");
    if (!sheet || sheet.getLastRow() < 2) return;
    const tokens = sheet.getRange(2, 1, sheet.getLastRow() - 1, 1).getValues();
    for (let i = 0; i < tokens.length; i++) {
      if ((tokens[i][0] || "").toString() !== token) continue;
      const usos = parseInt(sheet.getRange(i + 2, 6).getValue(), 10) || 0;
      sheet.getRange(i + 2, 6).setValue(usos + 1);
      return;
    }
  } catch (e) { /* la telemetría nunca bloquea el acceso */ }
}

// =====================================================================================
// 4. AUTORIDAD ÚNICA DE ESQUEMA, CATÁLOGO DE 32 COLUMNAS Y ALMACENAMIENTO RAG
//    [F0-2] [F0-3] [F0-4] [F1-1]
//    Este bloque es el ÚNICO lugar donde se definen las hojas del sistema.
//    Cualquier otro script (inicializadores externos) debe delegar aquí.
// =====================================================================================

/**
 * Cabeceras del catálogo maestro (32 columnas), EN EL MISMO ORDEN QUE IDX.
 * La correspondencia se comprueba al arrancar en verificarCoherenciaEsquema():
 * una cabecera desplazada respecto a IDX renombra columnas sin mover datos, que
 * es exactamente el fallo que dejó la hoja de taxonomía inservible.
 */
const CABECERAS_CATALOGO = [
  "URL Video", "ID Video", "Título", "Resumen Ejecutivo",
  "Ecosistema", "Área", "Tema", "Versión", "Dificultad",
  "Justificación Dificultad", "Módulo", "Fuente",
  "Canal", "Idioma", "Fecha Publicación", "Duración (min)", "Vistas", "Likes",
  "Categoría YouTube",
  "Estado", "Recursos / Enlaces", "Fecha Estudio", "Tags",
  "Resumen Ampliado IA (Drive ID)", "URL Formulario", "ID Formulario", "Error",
  /* [v2] Las cinco facetas. verificarCoherenciaEsquema() compara esta lista con
     IDX: si una columna se añade en un sitio y no en el otro, la inicialización
     falla a propósito antes de escribir nada en la hoja. */
  "Herramienta", "Industria", "Jurisdicción", "Alcance", "Tipo Contenido"
];

/**
 * Comprueba que IDX y CABECERAS_CATALOGO describen la misma hoja. Se ejecuta al
 * inicializar: si alguien añade una columna en un sitio y olvida el otro, salta
 * aquí y no seis meses después con los datos ya corridos.
 */
function verificarCoherenciaEsquema() {
  const problemas = [];
  if (CABECERAS_CATALOGO.length !== TOTAL_COLUMNAS) {
    problemas.push(`CABECERAS_CATALOGO tiene ${CABECERAS_CATALOGO.length} entradas y TOTAL_COLUMNAS dice ${TOTAL_COLUMNAS}.`);
  }
  const ocupadas = {};
  Object.keys(IDX).forEach(nombre => {
    const i = IDX[nombre];
    if (i < 0 || i >= TOTAL_COLUMNAS) problemas.push(`IDX.${nombre} = ${i} está fuera de rango.`);
    (ocupadas[i] = ocupadas[i] || []).push(nombre);
  });
  // Solo se permite compartir índice a los alias declarados.
  const ALIAS = { DOMINIO: "ECOSISTEMA", SUBCATEGORIA: "AREA" };
  Object.keys(ocupadas).forEach(i => {
    const nombres = ocupadas[i];
    if (nombres.length === 1) return;
    const inesperados = nombres.filter(n => !ALIAS[n] && !Object.values(ALIAS).includes(n));
    if (inesperados.length > 1) {
      problemas.push(`La columna ${i} la reclaman varios nombres: ${nombres.join(", ")}.`);
    }
  });
  for (let i = 0; i < TOTAL_COLUMNAS; i++) {
    if (!ocupadas[i]) problemas.push(`La columna ${i} («${CABECERAS_CATALOGO[i]}») no tiene ninguna entrada en IDX.`);
  }
  if (problemas.length) {
    const detalle = problemas.join("\n");
    logError("Esquema", "Incoherencia entre IDX y las cabeceras:\n" + detalle);
    throw new Error("El esquema del catálogo es incoherente:\n" + detalle);
  }
  return true;
}

