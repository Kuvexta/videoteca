/** Reintentos con backoff exponencial ante 429 / cuotas agotadas. */
function ejecutarConBackoff(operacion, maxIntentos = 3) {
  let espera = 2000;
  let ultimoError = null;
  for (let i = 0; i < maxIntentos; i++) {
    try {
      return operacion();
    } catch (e) {
      ultimoError = e;
      const recuperable = /429|RESOURCE_EXHAUSTED|rate.?limit|overloaded|503/i.test(e.message || "");
      if (recuperable && i < maxIntentos - 1) {
        logWarn("IA", `Reintento ${i + 1}/${maxIntentos} tras error recuperable: ${e.message}`);
        Utilities.sleep(espera);
        espera *= 2;
      } else {
        throw e;
      }
    }
  }
  throw ultimoError;
}

