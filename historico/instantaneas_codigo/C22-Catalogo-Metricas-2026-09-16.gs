       "faire", "être", "français", "francais", "gratuit", "débutant", "cours",
       "notre", "votre", "au", "aux", "en", "par", "mais", "où", "quand", "tous",
       "toute", "peut", "faut", "votre", "leur", "bien", "deux", "même"],
  DE: ["der", "die", "das", "und", "ist", "mit", "für", "fur", "ein", "eine", "einen",
       "nicht", "auf", "von", "zu", "im", "wie", "was", "oder", "sich", "werden",
       "deutsch", "kostenlos", "anleitung", "einfach", "kurs", "man", "auch", "aber",
       "durch", "über", "uber", "bei", "nach", "beim", "wir", "sie", "den", "dem",
       "zum", "zur", "noch", "nur", "alle", "mehr", "kann", "haben", "sein", "schon",
       "immer", "ohne", "unter", "wenn", "dann", "hier", "sehr"],
  IT: ["il", "lo", "gli", "le", "di", "che", "è", "per", "con", "come", "non", "sono",
       "questo", "questa", "italiano", "gratuito", "più", "perché", "anche", "della",
       "delle", "dei", "nel", "nella", "sul", "una", "un", "fare", "tutto", "molto",
       "guida", "corso", "cosa", "quando", "dove", "senza", "primo", "adesso", "solo",
       "tra", "prima", "dopo", "sempre", "mai", "ma", "si", "ci", "da", "alla", "ogni",
       "essere", "puoi", "questi", "sua", "suo"]
};

/**
 * Letras que casi solo existen en un idioma. Valen más que una palabra suelta
 * porque no se pueden colar por casualidad: una «ñ» en un título es español, y
 * un «ß» es alemán, aunque el resto del título sea un nombre de producto.
 */
const LETRAS_IDIOMA = [
  { re: /ñ/, lang: "ES", peso: 3 },
  { re: /¿|¡/, lang: "ES", peso: 3 },
  { re: /[ãõ]/, lang: "PT", peso: 4 },
  { re: /ß/, lang: "DE", peso: 4 },
  { re: /[äöü]/, lang: "DE", peso: 2 },
  { re: /[èêëîïôûœ]/, lang: "FR", peso: 2 },
  { re: /ç/, lang: "FR", peso: 1 },
  { re: /[ìò]/, lang: "IT", peso: 2 },
  /* Terminaciones. Una sola palabra basta para decidir, porque la MISMA idea
     se escribe distinto en cada idioma: instalación / instalação /
     installazione / Installierung. Es la señal que rescata los títulos cortos,
     donde no hay artículos ni preposiciones que contar. */
  { re: /(ción|ciones|sión|siones|ía|ías)\b/, lang: "ES", peso: 2 },
  { re: /(ção|ções|dade|dades)\b/, lang: "PT", peso: 3 },
  { re: /(zione|zioni|mento)\b/, lang: "IT", peso: 2 },
  { re: /(ung|ungen|keit|heit)\b/, lang: "DE", peso: 2 },
  { re: /(tion|tions)\b/, lang: "FR", peso: 1 },
  { re: /(ing|tion|ed)\b/, lang: "EN", peso: 1 },
  /* Tilde aguda sobre a/i/o/u sin ninguna marca de otro idioma: eso solo pasa
     en español y en portugués, y el portugués ya suma por su lado con ã/õ/ç. */
  { re: /[áíóú]/, lang: "ES", peso: 2 }
];

/** Lo que se escribe cuando el título no da para decidir. Es una respuesta. */
const IDIOMA_INDETERMINADO = "Indeterminado";

/**
 * Idiomas en que puede estar el CONTENIDO del catálogo, en el orden en que se
 * ofrecen. Nada que ver con `IDIOMAS_SOPORTADOS`, que es el idioma de la
 * INTERFAZ (ES/EN): el menú puede estar en español y el video en alemán.
 */
const IDIOMAS_CONTENIDO = ["ES", "EN", "PT", "FR", "DE", "IT", IDIOMA_INDETERMINADO];

/** Nombre legible de un código de idioma, para el portal y los informes. */
function nombreIdioma(codigo) {
  const M = { ES: "Español", EN: "Inglés", PT: "Portugués", FR: "Francés",
              DE: "Alemán", IT: "Italiano" };
  const c = (codigo || "").toString().trim().toUpperCase();
  return M[c] || IDIOMA_INDETERMINADO;
}

/**
 * Normaliza lo que declara la plataforma («es-419», "en-US", "pt-BR") al código
 * corto. Es la señal BUENA: la pone quien subió el video, no la adivinamos.
 */
function idiomaDesdeCodigoPlataforma(codigo) {
  const c = (codigo || "").toString().trim().toLowerCase();
  if (!c) return "";
  const base = c.split(/[-_]/)[0];
  const M = { es: "ES", en: "EN", pt: "PT", fr: "FR", de: "DE", it: "IT" };
  return M[base] || "";
}

/**
 * ¿En qué idioma está este video?
 *
 * Sustituye a una versión que miraba siete palabras y, si no encontraba
 * ninguna, respondía «ES». Con medio catálogo en inglés eso significaba que la
 * columna decía «ES» en casi todas las filas: no se podía filtrar por idioma
 * porque no había nada que filtrar, y además arrastraba a la clasificación
 * —«tutorial» contaba como inglés aunque en español se diga igual—.
 *
 * Ahora se vota. Cada palabra funcional encontrada suma un punto para su
 * idioma; las letras exclusivas (ñ, ã, ß) suman más porque no se cuelan por
 * casualidad. Gana quien saque más puntos, y SOLO si le saca ventaja al
 * segundo: dos idiomas empatados significan que el título no da para decidir.
 *
 * Cuando no hay señal suficiente devuelve «Indeterminado» en vez de inventarse
 * «ES». Un dato que dice «no lo sé» se puede filtrar, revisar y corregir; uno
 * que miente no se nota nunca.
 *
 * @param {string} titulo
 * @param {string} defaultLang  lo que declara la plataforma, si lo declara
 * @param {string} [descripcion] texto adicional: más palabras, mejor voto
 */
function detectarIdioma(titulo, defaultLang, descripcion) {
  const declarado = idiomaDesdeCodigoPlataforma(defaultLang);
  if (declarado) return declarado;

  /* De la descripción se toma solo el principio. El pie de una descripción de
     YouTube es casi siempre enlaces, hashtags y créditos en inglés, y con eso
     dentro cualquier video en español acababa votado como inglés. */
  const desc = (descripcion || "").toString().slice(0, 400);
  const texto = normalizarParaIdioma((titulo || "") + " " + desc);
  if (!texto) return IDIOMA_INDETERMINADO;
  const conEspacios = " " + texto + " ";

  const puntos = { ES: 0, EN: 0, PT: 0, FR: 0, DE: 0, IT: 0 };

  Object.keys(MARCADORES_IDIOMA).forEach(lang => {
    MARCADORES_IDIOMA[lang].forEach(m => {
      /* Palabra completa. Sin esto, «no» dentro de «node» y «el» dentro de
         «shell» votaban español en cualquier título técnico en inglés. */
      if (conEspacios.indexOf(" " + m + " ") !== -1) puntos[lang]++;
    });
  });

  const bruto = normalizarParaIdioma(titulo) + " " + desc.toLowerCase();
  LETRAS_IDIOMA.forEach(s => { if (s.re.test(bruto)) puntos[s.lang] += s.peso; });

  const orden = Object.keys(puntos).sort((a, b) => puntos[b] - puntos[a]);
  const mejor = orden[0], segundo = orden[1];

  /* Dos umbrales, no uno. El primero pide señal suficiente —con un solo
     marcador acierta por casualidad tan a menudo como falla—. El segundo pide
     VENTAJA: español y portugués comparten media lista, así que un empate
     técnico entre los dos no es una respuesta, es la falta de una. */
  /* Un único marcador basta SI ningún otro idioma tiene nada. «Excel pivot
     tables full course» solo aporta «full», pero no aporta ni una señal de
     español, portugués ni italiano: llamarlo indeterminado sería fingir una
     duda que no existe. Lo que no vale es un marcador contra otro. */
  if (puntos[mejor] === 1 && puntos[segundo] === 0) return mejor;
  if (puntos[mejor] < 2) return IDIOMA_INDETERMINADO;
  if (puntos[mejor] - puntos[segundo] < 1) return IDIOMA_INDETERMINADO;
  return mejor;
}

function generarTags(titulo, desc, dominio, version) {
  const tags = {};
  if (version && version !== "General") tags["#" + version.toString().toLowerCase().replace(/[^a-z0-9]/g, "")] = true;
  if (dominio) tags["#" + dominio.toString().toLowerCase().replace(/[^a-z0-9]/g, "")] = true;
  const base = ((titulo || "") + " " + (desc || "")).toString();
  if (/\bdian\b/i.test(base)) tags["#dian"] = true;
  if (/\bodoo\b/i.test(base)) tags["#odoo"] = true;
  if (/\bdocker\b/i.test(base)) tags["#docker"] = true;
  if (/\b(ia|ai|llm|gpt|gemini|claude)\b/i.test(base)) tags["#ia"] = true;
  return Object.keys(tags).slice(0, 6).join(" ");
}

/**
 * ¿Coincide una palabra clave con el texto de un video?
 *
 * No es un `indexOf`, y esa es la diferencia entre que la taxonomía sirva o no.
 * Comparar literalmente hace que la regla «inventario odoo» NO reconozca
 * «Ajuste de inventario en Odoo 19» —por la preposición— ni «conteo ciclico»
 * reconozca «conteos cíclicos» —por el plural—, y esos videos acaban cayendo en
 * la regla comodín. Nadie revisa por qué; simplemente el filtro no discrimina.
 *
 * Así que una clave de varias palabras coincide si TODAS sus palabras aparecen,
 * en cualquier orden y con cualquier cosa en medio. Las palabras de 4 letras o
 * más admiten sufijo (plural, conjugación); las cortas exigen palabra completa,
 * porque si no «pos» encontraría «posible» y «ia» encontraría media hoja.
 */
function palabraClaveCoincide(textoNormalizado, clave) {
  const partes = normalizarBusqueda(clave).split(" ").filter(Boolean);
  if (partes.length === 0) return false;
  return partes.every(function (p) {
    const patron = p.length >= 4
      ? "(^| )" + p + "[a-z0-9ñ]{0,4}( |$)"   // sufijo corto: plural o conjugación
      : "(^| )" + p + "( |$)";
    return new RegExp(patron).test(textoNormalizado);
  });
}

/**
 * Palabras que aparecen en la descripción de casi cualquier video y que, por
 * tanto, no distinguen nada.
 *
 * Esta lista existe por un fallo concreto y caro: la regla semilla de
 * «Certificados y proxy» traía la palabra clave «https». Toda descripción de
 * YouTube lleva enlaces —«Suscríbete: https://…»—, así que «https» coincidía en
 * el catálogo ENTERO. Y como esa regla aporta Tema y las rivales («prompt»,
 * «hotel») no, ganaba el desempate: cursos de Prompt Engineering, clases de
 * guitarra, música country y capacitaciones de hotelería acabaron todos en
 * «Infraestructura y Servidores / Linux y Despliegue / Certificados y proxy».
 * Cientos de videos con la misma etiqueta falsa, y ningún error a la vista.
 *
 * Una sola palabra mal elegida basta para arrasar la clasificación completa, y
 * el administrador puede escribirla sin saberlo. Por eso se descartan aquí, al
 * leer la configuración, y no se confía en que nadie las escriba.
 */
const CLAVES_NO_DISCRIMINAN = {
  https: 1, http: 1, www: 1, com: 1, net: 1, org: 1, html: 1, url: 1, link: 1,
  enlace: 1, enlaces: 1, video: 1, videos: 1, canal: 1, youtube: 1, youtu: 1,
  suscribete: 1, suscribirse: 1, suscripcion: 1, sigueme: 1, comparte: 1,
  like: 1, likes: 1, comenta: 1, gracias: 1, hola: 1, aqui: 1, mas: 1, todo: 1,
  nuevo: 1, mejor: 1, curso: 1, tutorial: 1, clase: 1, parte: 1, capitulo: 1,
  gratis: 1, completo: 1, español: 1, espanol: 1, ingles: 1, redes: 1,
  instagram: 1, facebook: 1, tiktok: 1, twitter: 1, whatsapp: 1, telegram: 1,
  /* Medio catálogo está en inglés. Sin estas, «Proponer reglas» acaba
     ofreciendo «with», «you», «this» o «best» como si fueran temas, y una
     regla nacida de ahí repetiría exactamente el desastre de «https». */
  with: 1, you: 1, your: 1, this: 1, that: 1, from: 1, have: 1, has: 1,
  how: 1, what: 1, why: 1, when: 1, who: 1, will: 1, can: 1, just: 1,
  best: 1, new: 1, top: 1, full: 1, free: 1, live: 1, watch: 1, video: 1,
  official: 1, channel: 1, subscribe: 1, guide: 1, course: 1, lesson: 1,
  beginners: 1, beginner: 1, everything: 1, about: 1, into: 1, over: 1,
  make: 1, made: 1, get: 1, got: 1, use: 1, using: 1, need: 1, want: 1,
  now: 1, here: 1, out: 1, all: 1, one: 1, two: 1, day: 1, days: 1,
  minutes: 1, minute: 1, hour: 1, hours: 1, week: 1, year: 1, part: 1,
  update: 1, updates: 1, review: 1, demo: 1, intro: 1, overview: 1,
  step: 1, steps: 1, tips: 1, explained: 1, tutorial: 1, tutorials: 1
};

/**
 * ¿Sirve esta palabra clave para distinguir un tema de otro?
 *
 * Una clave de varias palabras («video institucional») sí discrimina aunque
 * contenga una palabra vacía: lo que se descarta es la clave que consiste
 * ÚNICAMENTE en ruido.
 */
function esClaveDiscriminante(clave) {
  const norm = normalizarBusqueda(clave);
  if (!norm) return false;
  const partes = norm.split(" ").filter(Boolean);
  if (partes.length > 1) return true;
  if (partes[0].length < 2) return false;
  return !CLAVES_NO_DISCRIMINAN[partes[0]];
}

/** Cuánta descripción se mira para clasificar. */
const DESCRIPCION_MAX_CLASIFICAR = 600;

/**
 * Deja el texto en condiciones de ser clasificado.
 *
 * Tres decisiones, todas por la misma razón —que el pie de la descripción no
 * decide el tema del video—:
 *
 *  1. Se borran URLs, arrobas y correos ANTES de normalizar. Si no, cada
 *     enlace deja regados en el texto trozos como «https», «www», «com» o el
 *     nombre del dominio, y esos trozos compiten con el título.
 *  2. Se recorta la descripción. Las descripciones de YouTube arrastran
 *     patrocinios, listas de capítulos y créditos que hablan de cualquier cosa
 *     menos del contenido; lo que describe el video está siempre al principio.
 *  3. El título va entero y sin recortar, porque es la señal buena.
 *
 * [v2.6.8] La cuarta decisión, que era un error: las etiquetas y las menciones
 * se BORRABAN enteras. `.replace(/[@#]\w+/g, " ")` no quitaba el símbolo, se
 * llevaba también la palabra. En un catálogo de YouTube eso es tirar a la basura
 * la mejor señal que existe: de los 53 títulos pendientes que hablan de Odoo,
 * los 53 lo dicen únicamente dentro de «#Odoo», «#odoo18», «#OdooApps» o
 * «@Odoo». La regla «odoo» no podía coincidir con un texto del que se había
 * borrado la palabra «odoo», así que quedaban «Sin clasificar» y de ahí pasaban
 * a la Fase 2, a gastar IA para averiguar algo que estaba escrito en el título.
 *
 * Ahora se cae el símbolo y se conserva la palabra, y además se parte la
 * etiqueta por sus costuras —mayúscula interior y frontera letra/número— porque
 * las etiquetas van pegadas: «#OdooApps» da «odoo apps» sin dejar de dar
 * «odooapps». Se emiten las dos formas, la entera y la troceada, y decide la
 * regla. Esto NO abre la clasificación: el vocabulario sigue cerrado y
 * CLAVES_NO_DISCRIMINAN sigue filtrando el ruido. Lo único que cambia es que el
 * ruido ahora tiene que ser descartado en vez de no llegar nunca.
 */
function textoParaClasificar(titulo, descripcion) {
  const trocear = (coincidencia, etiqueta) => {
    const partido = etiqueta
      .replace(/([a-záéíóúüñ])([A-ZÁÉÍÓÚÜÑ])/g, "$1 $2")
      .replace(/([A-Za-zÁÉÍÓÚÜÑáéíóúüñ])([0-9])/g, "$1 $2")
      .replace(/([0-9])([A-Za-zÁÉÍÓÚÜÑáéíóúüñ])/g, "$1 $2");
    return partido === etiqueta ? " " + etiqueta + " " : " " + etiqueta + " " + partido + " ";
  };
  const limpia = txt => (txt || "").toString()
    .replace(/https?:\/\/\S+/gi, " ")
    .replace(/www\.\S+/gi, " ")
    .replace(/\S+@\S+\.\S+/g, " ")
    .replace(/[@#]([A-Za-z0-9ÁÉÍÓÚÜÑáéíóúüñ_]+)/g, trocear);
  const desc = limpia(descripcion).slice(0, DESCRIPCION_MAX_CLASIFICAR);
  return normalizarBusqueda(limpia(titulo) + " " + desc);
}

/**
 * Clasifica un video en los tres niveles de la jerarquía.
 *
 * Antes esta función devolvía el ecosistema bajo la clave `plataforma`, y la
 * ingesta —que también tenía una `plataforma` de verdad, la del alojamiento—
 * escribía esa otra encima. Resultado: el catálogo entero con «YouTube» como
 * dominio y la clasificación real calculada y tirada a la basura. La clave se
 * llama ahora `ecosistema` justamente para que no vuelva a confundirse.
 *
 * Sin coincidencia NO se inventa un ecosistema plausible: se marca «Sin
 * clasificar», que es visible y se puede corregir. Un valor por defecto creíble
 * se queda ahí para siempre porque nadie nota que está mal.
 */
/**
 * ¿Es un video musical? Se decide con lo que ya tenemos, en este orden:
 *
 *  1. La CATEGORÍA que devolvió YouTube. Es la señal buena: la pone la propia
 *     plataforma y no depende de cómo esté escrito el título. Ya se guardaba en
 *     la hoja sin usarse para nada.
 *  2. Marcas inequívocas del título, para los videos que aún no tienen categoría
 *     —los recién pegados a mano— o los que vienen de otra plataforma.
 *
 * Deliberadamente NO se usa la palabra suelta «música»: un video titulado
 * «Cómo poner música de fondo en el punto de venta» es de POS, no un musical.
 * Ante la duda, no es musical: marcarlo mal lo saca de la capacitación.
 *
 * @param {string} titulo
 * @param {string} categoriaYouTube  el valor de la columna «Categoría YouTube»
 */
function pareceVideoMusical(titulo, categoriaYouTube) {
  const cat = (categoriaYouTube || "").toString().trim();
  if (cat && CATEGORIAS_YT_MUSICA.indexOf(cat) !== -1) return true;

  const t = normalizarBusqueda(titulo);
  if (!t) return false;
  const MARCAS = [
    "video oficial", "official video", "official music video", "audio oficial",
    "official audio", "lyric video", "video lyric", "letra oficial",
    "videoclip", "en vivo concierto", "live session", "cover acustico"
  ];
  if (MARCAS.some(m => t.indexOf(m) !== -1)) return true;
  /* Los canales de VEVO se escriben pegados al nombre del artista
     («ShakiraVEVO»), así que aquí no vale el límite de palabra. «vevo» es una
     cadena lo bastante rara como para no aparecer por accidente. */
  return t.indexOf("vevo") !== -1;
}

/**
 * ¿Esta fila del catálogo es contenido CERTIFICABLE?
 *
 * Gobierna módulos, exámenes y Fase 2. Esto NO es configurable a propósito: un
 * examen sobre la letra de una canción no certifica ninguna competencia, y el
 * certificado que salga de ahí no significa nada. Lo que sí se puede activar es
 * la extracción de la letra —ver filaAdmiteTranscripcion()—, que es otra cosa.
 */
function filaEsCertificable(r) {
  if (!r) return false;

  /* [v2] La faceta manda. Es la única respuesta a «¿sirve para formar?», y es
     independiente de «¿de qué trata?»: un video de astronomía puede estar
     perfectamente clasificado en Ciencia y Tecnología / Astronomía y aun así
     no entrar en ningún examen. */
  const alcance = alcanceDeFila(r);
  if (alcance) return alcance === ALCANCE_CERTIFICABLE;

  /* Sin faceta = fila anterior a la migración. Se mantiene el criterio viejo
     para que un catálogo a medio migrar no empiece a generar exámenes sobre
     canciones mientras se termina. */
  const eco = (r[IDX.ECOSISTEMA] || "").toString().trim();
  if (ECOSISTEMAS_NO_CERTIFICABLES.indexOf(eco) !== -1) return false;
  // Aún sin clasificar: se mira la señal directa, para no depender del orden en
  // que se hayan ejecutado las fases.
  if (!eco || eco === SIN_CLASIFICAR) {
    return !pareceVideoMusical(r[IDX.TITULO], r[IDX.CATEGORIA_YT]);
  }
  return true;
}

/**
 * [v2.6.8] ¿Puede la Fase 2 (IA) trabajar sobre esta fila?
 *
 * Es una pregunta DISTINTA de «¿certifica?», y confundirlas dejaba la Fase 2
 * inservible justo donde hacía falta. La Fase 2 se filtraba con
 * filaEsCertificable(), que desde la v2 responde `true` únicamente cuando el
 * Alcance ya dice «Certificable». Pero el Alcance solo se sabe DESPUÉS de
 * clasificar: una fila recién migrada está en «Pendiente de revisión», que es
 * precisamente lo que la Fase 2 venía a resolver. Resultado: las 518 filas
 * pendientes se saltaban en silencio y la Fase 2 informaba «al día».
 *
 * El único alcance que excluye de verdad es «No certificable»: sobre una canción
 * o una boda no hay resumen de capacitación que escribir y gastar una llamada de
 * IA en ello es tirar cuota. «Referencia» sí entra —divulgación bien clasificada
 * también quiere su resumen y su indexación— y «Pendiente» entra por definición.
 */
function filaAdmiteFase2(r) {
  if (!r) return false;

  const alcance = alcanceDeFila(r);
  if (alcance) return alcance !== ALCANCE_NO_CERTIFICABLE;

  /* Sin faceta = fila anterior a la migración. Se conserva el criterio viejo,
     igual que hace filaEsCertificable(), para que un catálogo a medio migrar no
     empiece a mandar canciones al modelo. */
  const eco = (r[IDX.ECOSISTEMA] || "").toString().trim();
  if (ECOSISTEMAS_NO_CERTIFICABLES.indexOf(eco) !== -1) return false;
  if (!eco || eco === SIN_CLASIFICAR) {
    return !pareceVideoMusical(r[IDX.TITULO], r[IDX.CATEGORIA_YT]);
  }
  return true;
}

/**
 * ¿Esta fila es contenido MUSICAL?
 *
 * Existe porque hasta la v2 esto se deducía de `!filaEsCertificable()`, y con
 * la faceta Referencia esa deducción dejó de ser cierta: un documental sobre
 * reactores no certifica y no es una canción. Son dos preguntas distintas y
 * ahora cada una tiene su función.
 */
function esFilaMusical(r) {
  if (!r) return false;
  const eco = (r[IDX.ECOSISTEMA] || "").toString().trim();
  const area = (r[IDX.AREA] || "").toString().trim();
  if (eco === ECOSISTEMA_MUSICA) return true;                       // legado
  if (area === AREA_MUSICA_FUERA_ALCANCE) return true;
  if (area === "Instrumentos Musicales") return true;
  return pareceVideoMusical(r[IDX.TITULO], r[IDX.CATEGORIA_YT]);
}

/** ¿Está activada la extracción de letras de los videos musicales? */
function letrasMusicalesActivadas() {
  return PropertiesService.getScriptProperties().getProperty("EXTRAER_LETRAS_MUSICALES") === "true";
}

/**
 * ¿Se le extraen subtítulos y se indexa para búsqueda?
 *
 * Separado de «certificable» porque son decisiones distintas. Un musical nunca
 * entra en un examen, pero SÍ puede querer tenerse su letra indexada para poder
 * encontrar la canción por lo que dice. Ese caso lo decide el interruptor, que
 * viene apagado: extraer letras llena el Drive de obra ajena y consume cuota de
 * indexación, así que se activa a propósito y no por descuido.
 */
function filaAdmiteTranscripcion(r) {
  if (!r) return false;
  if (filaEsCertificable(r)) return true;
  /* [v2] «Referencia» es exactamente el caso que antes no se podía expresar:
     contenido que SÍ queremos indexado y buscable, pero que no evalúa nada. */
  if (alcanceDeFila(r) === ALCANCE_REFERENCIA) return true;
  /* Se mira también el ÁREA: desde que la heurística musical aterriza en
     «Fuera de Alcance», el ecosistema ya no basta para distinguir una canción
     —que puede querer su letra indexada— de un partido de fútbol o una boda,
     que no. Sin esto, activar «extraer letras» no habría extraído ninguna. */
  return esFilaMusical(r) ? letrasMusicalesActivadas() : false;
}

// -------------------------------------------------------------------------------------
// 5.0d [v2.6.8] Facetas derivadas de la RUTA, no del modelo
// -------------------------------------------------------------------------------------

/**
 * Las cinco facetas que le corresponden a una ruta «Ecosistema / Área».
 *
 * Se leen de las propias reglas de la taxonomía, que ya las traen escritas. Esa
 * es la única fuente que no se puede desincronizar: si mañana alguien decide que
 * «Idiomas» pasa a ser Certificable, lo cambia en la hoja de reglas y esto lo
 * sigue solo.
 *
 * El matiz que hace que esto sea correcto y no una copia optimista: una ruta
 * puede tener VARIAS reglas —«Odoo ERP / Industrias y Verticales» tiene una por
 * industria— y entonces la faceta no es la de la primera regla que aparezca. Si
 * las reglas de una ruta no coinciden en una faceta, esa faceta se devuelve
 * VACÍA: no hay consenso, luego no hay respuesta. Copiar la primera pondría
 * «Construcción» en un video de hoteles nada más porque la regla de construcción
 * está más arriba en la hoja, y eso es peor que dejarla en «Transversal», porque
 * parece un dato y es un accidente de orden.
 *
 * @return {?{herramienta:string, industria:string, jurisdiccion:string,
 *            alcance:string, tipoContenido:string, resumen:string, reglas:number}}
 */
let _facetasPorRutaCache = null;
function facetasDeRutaV2(eco, area) {
  if (!_facetasPorRutaCache) {
    _facetasPorRutaCache = {};
    try {
      obtenerTaxonomiaConfig().forEach(r => {
        if (!r.ecosistema || r.ecosistema === SIN_CLASIFICAR) return;
        const k = r.ecosistema + "||" + (r.area || "General");
        const a = _facetasPorRutaCache[k] || (_facetasPorRutaCache[k] = { n: 0 });
        const unir = (campo, valor) => {
          if (a.n === 0) a[campo] = valor;
          else if (a[campo] !== valor) a[campo] = "";   // sin consenso
        };
        unir("herramienta",   r.herramienta || "");
        unir("industria",     r.industria || INDUSTRIA_TRANSVERSAL);
        unir("jurisdiccion",  r.jurisdiccion || JURISDICCION_GLOBAL);
        unir("alcance",       r.alcance || ALCANCE_CERTIFICABLE);
        unir("tipoContenido", r.tipoContenido || "Tutorial");
        unir("resumen",       r.resumenSugerido || "");
        a.n++;
      });
    } catch (e) { /* sin hoja de taxonomía: se devuelve null y mandan los valores por defecto */ }
  }
  const a = _facetasPorRutaCache[(eco || "") + "||" + (area || "")];
  if (!a) return null;
  return {
    herramienta:   a.herramienta || "",
    industria:     a.industria || "",
    jurisdiccion:  a.jurisdiccion || "",
    alcance:       a.alcance || "",
    tipoContenido: a.tipoContenido || "",
    resumen:       a.resumen || "",
    reglas:        a.n
  };
}

/**
 * [v2.6.9] Valores que son a la vez válidos y provisionales.
 *
 * Son los que el reclasificador escribe cuando NINGUNA regla reconoció la fila:
 * ver `ponerFaceta()` en reclasificarCatalogo(), que usa exactamente estos tres
 * como «por defecto». Están en el vocabulario cerrado, así que validar no los
 * detecta; pero en una fila que acaba de salir de «Sin clasificar» no son una
 * decisión de nadie, son el relleno que se puso mientras no se sabía.
 *
 * Distinguirlos importa: sin esto, una fila que la IA coloca en «Hotelería y
 * Hospitalidad / Operaciones» se queda con Industria = «Transversal» aunque su
 * regla diga «Hotelería», una fiscal se queda en «Global» cuando su ruta dice
 * «Colombia», y «Instrumentos Musicales» se queda en «Tutorial» cuando su regla
 * dice «Curso». Tres columnas que parecen rellenas y no dicen nada.
 */
const FACETAS_PROVISIONALES = {};
FACETAS_PROVISIONALES[IDX.INDUSTRIA]      = INDUSTRIA_TRANSVERSAL;
FACETAS_PROVISIONALES[IDX.JURISDICCION]   = JURISDICCION_GLOBAL;
FACETAS_PROVISIONALES[IDX.TIPO_CONTENIDO] = "Tutorial";

/**
 * Deja las cinco facetas de una fila YA clasificada en un estado válido.
 *
 * Existe porque clasificar y facetar se habían separado sin querer. La Fase 2
 * escribía ecosistema, área, tema, resumen y versión, y ahí se paraba: una fila
 * podía acabar perfectamente colocada en «Odoo ERP / POS y Retail» y seguir con
 * el Alcance en «Pendiente de revisión», es decir, fuera de los módulos y de los
 * exámenes. Clasificada y a la vez invisible. Con la v2 la clasificación no
 * termina en el Tema: termina cuando las cinco facetas tienen valor.
 *
 * Dos reglas de convivencia:
 *   · No pisa lo que ya hay, salvo que no sea un valor válido del vocabulario
 *     cerrado. Una corrección a mano vale más que una deducción.
 *   · El Alcance sí se resuelve cuando está vacío o en «Pendiente», porque
 *     «Pendiente» no es una decisión: es la ausencia de una.
 *
 * @param {Array} r
 * @param {{recienClasificada:boolean}=} opciones  `recienClasificada` cuando la
 *   fila ACABA de salir de «Sin clasificar» en esta misma pasada. Solo entonces
 *   los valores de FACETAS_PROVISIONALES se tratan como reemplazables: en
 *   cualquier otra fila «Transversal» puede ser una decisión de una persona, y
 *   ahí no se toca. La distinción es lo que separa completar de pisar.
 * @return {boolean} true si cambió algo.
 */
function resolverFacetasDeFila(r, opciones) {
  if (!r) return false;
  const recienClasificada = Boolean(opciones && opciones.recienClasificada);
  const eco  = (r[IDX.ECOSISTEMA] || "").toString().trim();
  const area = (r[IDX.AREA] || "").toString().trim();
  /* Sin ruta no hay nada que deducir: inventar facetas para una fila que nadie
     ha sabido clasificar es exactamente el error que la v2 vino a quitar. */
  if (!eco || eco === SIN_CLASIFICAR || !area || area === SIN_CLASIFICAR) return false;

  const f = facetasDeRutaV2(eco, area);
  let cambiada = false;

  const escribir = (col, valor) => {
    if (!valor) return;
    if ((r[col] || "").toString().trim() === valor) return;
    r[col] = valor;
    cambiada = true;
  };
  /* «Vigente» = tiene valor, ese valor pertenece al vocabulario cerrado, y no es
     un relleno provisional de una fila que acaba de clasificarse. Lo que no esté
     en la lista no se respeta: es basura de una importación o una variante
     inventada por un modelo, y respetarla parte el filtro en dos. */
  const vigente = (col, permitidos) => {
    const v = (r[col] || "").toString().trim();
    if (!v) return "";
    if (permitidos && permitidos.indexOf(v) === -1) return "";
    if (recienClasificada && FACETAS_PROVISIONALES[col] === v) return "";
    return v;
  };

  // 1. Herramienta. Vocabulario abierto a propósito, así que solo se rellena.
  if (!(r[IDX.HERRAMIENTA] || "").toString().trim()) {
    escribir(IDX.HERRAMIENTA, (f && f.herramienta) || (eco === "Odoo ERP" ? "Odoo" : ""));
  }

  // 2. Industria.
  if (!vigente(IDX.INDUSTRIA, INDUSTRIAS)) {
    escribir(IDX.INDUSTRIA, (f && f.industria) || INDUSTRIA_TRANSVERSAL);
  }

  /* 3. Jurisdicción. El país lo dice el CONTENIDO, no la rama en la que cayó:
        el mismo criterio que aplica el motor. Si el título nombra un país
        concreto, ese pisa lo que hubiera. */
  const juri = detectarJurisdiccion(r[IDX.TITULO], "");
  if (juri && juri !== JURISDICCION_GLOBAL) {
    escribir(IDX.JURISDICCION, juri);
  } else if (!vigente(IDX.JURISDICCION, JURISDICCIONES)) {
    escribir(IDX.JURISDICCION, (f && f.jurisdiccion) || JURISDICCION_GLOBAL);
  }

  // 4. Tipo de contenido.
  if (!vigente(IDX.TIPO_CONTENIDO, TIPOS_CONTENIDO)) {
    escribir(IDX.TIPO_CONTENIDO, (f && f.tipoContenido) || "Tutorial");
  }

  /* 5. Alcance. La faceta de la que cuelgan módulos y exámenes, y por eso la
        única que se atreve a pisar «Pendiente»: si sigue pendiente, la fila no
        entra en ningún sitio y el trabajo de clasificarla no ha servido de nada.
        Las tablas por ecosistema y por área mandan sobre la regla porque cubren
        también las rutas que alguien añadió a mano y que ninguna regla describe. */
  const alcActual = vigente(IDX.ALCANCE, ALCANCES);
  if (!alcActual || alcActual === ALCANCE_PENDIENTE) {
    /* [v2.6.9] El orden es ÁREA excepcional → ECOSISTEMA → regla, el mismo que
       usa migrarCatalogoAV2(). Estaba invertido, y la inversión no era inocua:
       AREAS_REFERENCIA_V2 existe precisamente para las excepciones DENTRO de un
       ecosistema, así que preguntar primero por el ecosistema se las come todas.
       «Cultura y Entretenimiento / Instrumentos Musicales» acababa en «No
       certificable» —fuera de la indexación— cuando su propia regla en la
       semilla dice «Referencia / Curso»: una clase de piano deja de poder
       buscarse. Una excepción que se evalúa después de la regla general no es
       una excepción. */
    let destino = "";
    if (AREAS_REFERENCIA_V2[area]) destino = ALCANCE_REFERENCIA;
    else if (ALCANCE_POR_ECOSISTEMA_V2[eco]) destino = ALCANCE_POR_ECOSISTEMA_V2[eco];
    else if (f && f.alcance) destino = f.alcance;
    /* Sin ruta conocida NO se sube a Certificable. Contenido que nadie ha mirado
       entrando en exámenes es el peor final posible de esta función. */
    escribir(IDX.ALCANCE, destino || ALCANCE_PENDIENTE);
  }

  return cambiada;
}

// -------------------------------------------------------------------------------------
// 5.0e [v2.6.8] El empate Odoo + MCP
// -------------------------------------------------------------------------------------

/** Dónde va un video que habla de Odoo y de MCP a la vez. */
const RUTA_ODOO_MCP = { ecosistema: "Odoo ERP", area: "IA en Odoo" };

/**
 * ¿Es este uno de esos videos?
 *
 * El caso concreto: «How to Connect Claude to Odoo Data — Full Odoo MCP Server
 * Demo». Dos reglas lo reclaman con razón —«mcp» desde «Agentes y Sistemas
 * Agénticos» y «odoo mcp server» desde «IA en Odoo»— y el desempate por
 * especificidad puede caer de cualquiera de los dos lados según cómo esté
 * escrito el título. La política de Kuvexta no es ambigua: si el video enseña a
 * usar IA DENTRO de Odoo, es material de Odoo, porque quien lo busca lo busca
 * por Odoo. Así que aquí no se desempata por longitud de la clave, se decide.
 *
 * Solo el TÍTULO. Un «odoo» suelto en el pie de la descripción de un canal que
 * habla de Odoo no convierte en material de Odoo un video sobre MCP genérico, y
 * el pie de la descripción está en todos los videos del canal.
 */
function esCasoOdooMCP(titulo) {
  const t = textoParaClasificar(titulo, "");
  if (!t) return false;
  return palabraClaveCoincide(t, "mcp") && palabraClaveCoincide(t, "odoo");
}

/**
 * Ordena dos reglas candidatas. Positivo si `a` es mejor que `b`.
 *
 * Está aparte para que el diagnóstico de cobertura explique el resultado con el
 * MISMO criterio con el que se decidió, y no con una copia que se desincronice.
 */
function compararCandidatosTaxonomia(a, b) {
  if (a.enTitulo !== b.enTitulo) return a.enTitulo - b.enTitulo;
  if (a.palabras !== b.palabras) return a.palabras - b.palabras;
  if (a.conTema !== b.conTema) return a.conTema - b.conTema;
  if (a.largo !== b.largo) return a.largo - b.largo;
  return b.indice - a.indice;   // a igualdad total, la regla más arriba en la hoja
}

/* Marcadores de jurisdicción. Cada país por su nombre, su gentilicio y la
   autoridad o el formato que lo delata: quien escribe «CFDI» o «SAT» está
   hablando de México aunque no lo diga. */
const MARCADORES_JURISDICCION = [
  /* [v2.6.18] Los marcadores de SST no son decorativos: en «Normativa y
     Cumplimiento SST» conviven reglas de cuatro países, así que la jurisdicción
     de ruta queda sin consenso —vacía— y la del título es la ÚNICA que puede
     recuperar el país. Sin «resolucion 0312» aquí, una fila cuya regla dice
     Colombia acabaría en Global.
     No se añade «português → Portugal»: una capacitación en portugués es
     brasileña la mayoría de las veces. Idioma y jurisdicción son cosas
     distintas y aquí se mantienen separadas a propósito. */
  ["Colombia",       ["colombia", "colombiana", "colombiano", "dian", "cufe", "cune", "rips", "reteica", "retefuente", "muisca", "exogena",
                      "decreto 1072", "resolucion 0312", "res 0312", "gtc 45", "copasst", "ley 1562", "sena", "posipedia"]],
  ["Panamá",         ["panama", "panamena", "panameno", "itbms", "dgi panama"]],
  ["México",         ["mexico", "mexicana", "mexicano", "cfdi", "sat mexico", "complemento de pago"]],
  ["Chile",          ["chile", "chilena", "chileno", "sii chile", "dte chile"]],
  ["Argentina",      ["argentina", "argentino", "afip", "arca argentina"]],
  ["Perú",           ["peru", "peruana", "peruano", "sunat", "ley 29783",
                      "ds 005 2012 tr", "d s 005 2012 tr", "decreto supremo 005 2012 tr"]],
  ["Ecuador",        ["ecuador", "ecuatoriana", "ecuatoriano", "sri ecuador"]],
  ["España",         ["espana", "espanola", "espanol de espana", "aeat", "verifactu", "ticketbai", "sii espana"]],
  ["Estados Unidos", ["estados unidos", "irs", "sales tax usa", "osha 300"]],
  ["Brasil",         ["brasil", "brasileiro", "brasileira", "esocial", "e social",
                      "nr 1", "nr 01", "s 2210", "s 2220", "s 2240"]],
  ["Portugal",       ["portugal", "act portugal"]]
];

/**
 * ¿A qué país corresponde este contenido?
 *
 * Es una FACETA, no una rama del árbol: se decide mirando el contenido, no la
 * regla que ganó. Sin esto, «Localización Panameña para Odoo» heredaba la
 * jurisdicción de la regla de facturación electrónica —Colombia— y quedaba
 * archivado bajo la normativa equivocada. Devuelve "" si nada lo delata, y
 * entonces manda el valor por defecto de la regla.
 */
function detectarJurisdiccion(titulo, descripcion) {
  const texto = normalizarBusqueda((titulo || "") + " " + (descripcion || ""));
  if (!texto) return "";
  let encontrada = "";
  for (let i = 0; i < MARCADORES_JURISDICCION.length; i++) {
    const pais = MARCADORES_JURISDICCION[i][0];
    const marcas = MARCADORES_JURISDICCION[i][1];
    for (let j = 0; j < marcas.length; j++) {
      if (!palabraClaveCoincide(texto, marcas[j])) continue;
      /* Dos países nombrados en el mismo título («de Colombia a Panamá») no se
         puede resolver sin leerlo: mejor no inventar y dejar que mande la regla. */
      /* Dos países en el mismo título («Colombia vs Panamá») no se puede
         resolver sin leerlo. Se devuelve Global EXPLÍCITAMENTE en vez de
         cadena vacía: con la cadena vacía volvía a mandar la jurisdicción por
         defecto de la regla, que es justo el error que esto venía a evitar. */
      if (encontrada && encontrada !== pais) return JURISDICCION_GLOBAL;
      encontrada = pais;
      break;
    }
  }
  return encontrada;
}

function motorClasificacionUniversal(titulo, descripcion, categoriaYouTube) {
  const texto = textoParaClasificar(titulo, descripcion);
  const textoTitulo = textoParaClasificar(titulo, "");
  const pareceMusical = pareceVideoMusical(titulo, categoriaYouTube);
  let ecosistema = SIN_CLASIFICAR;
  let area = SIN_CLASIFICAR;
  let tema = "";
  let resumen = "Guía y recopilación de contenido técnico.";

  /* Gana la regla MÁS ESPECÍFICA, no la que esté más arriba en la hoja.
     Con «primera que coincide», una regla vieja y genérica («odoo») se lleva
     todos los videos antes de que se evalúe «conteo ciclico», y el catálogo
     entero acaba en el área «General». Eso obligaría a ordenar la hoja a mano
     —y a reordenarla cada vez que se añade una regla—, que es justo lo que nadie
     hace. Criterios, en orden: cuántas palabras tiene la clave que coincidió, si
     la regla aporta tema, la longitud de la clave, y por último su posición.

     Antes del recuento de palabras manda DÓNDE coincidió: una regla que
     reconoce el título le gana a una que solo aparece en la descripción. El
     título dice de qué trata el video; la descripción arrastra patrocinios,
     créditos y menciones que hablan de otra cosa. Sin este criterio, una clave
     que aparezca de pasada en el pie de la descripción se lleva el video
     aunque el título diga claramente otra cosa. */
  let mejor = null;
  obtenerTaxonomiaConfig().forEach((regla, indice) => {
    let mejorClave = null;
    (regla.keywords || []).forEach(k => {
      if (!palabraClaveCoincide(texto, k)) return;
      const norm = normalizarBusqueda(k);
      const palabras = norm.split(" ").filter(Boolean).length;
      const enTitulo = palabraClaveCoincide(textoTitulo, k) ? 1 : 0;
      if (!mejorClave || enTitulo > mejorClave.enTitulo ||
          (enTitulo === mejorClave.enTitulo && palabras > mejorClave.palabras) ||
          (enTitulo === mejorClave.enTitulo && palabras === mejorClave.palabras &&
           norm.length > mejorClave.largo)) {
        mejorClave = { palabras: palabras, largo: norm.length, enTitulo: enTitulo, texto: norm };
      }
    });
    if (!mejorClave) return;

    const candidato = {
      regla: regla, indice: indice,
      enTitulo: mejorClave.enTitulo,
      palabras: mejorClave.palabras,
      conTema: regla.tema ? 1 : 0,
      largo: mejorClave.largo,
      clave: mejorClave.texto
    };
    if (!mejor || compararCandidatosTaxonomia(candidato, mejor) > 0) mejor = candidato;
  });

  /* La heurística musical se aplica DESPUÉS de las reglas, no antes.
     Antes se aplicaba primero y devolvía sin mirar nada más, con lo cual una
     canción quedaba en «Música y Cultura» aunque el administrador hubiera
     escrito una regla que la reclamaba. Eso deja fuera un uso real: una canción
     con letra ES material de estudio cuando lo que se estudia es el idioma, y
     el administrador no tenía forma de decirlo — cada vez que reclasificaba el
     catálogo, su decisión se deshacía sola.
     Ahora manda la configuración: si una regla coincide, gana la regla, y con
     ella el video deja de ser «musical» y pasa a admitir transcripción y a
     poder formar parte de un módulo. Si NINGUNA regla lo reclama, sigue siendo
     un musical y se aparta igual que antes. */
  if (!mejor && pareceMusical) {
    /* Cae en «Fuera de Alcance / Música y Espectáculos», la MISMA rama a la que
       llevan las reglas. Antes abría un ecosistema propio, «Música y Cultura»,
       con lo que el árbol de filtros mostraba dos ramas para lo mismo: las
       canciones que reconocía una regla en una, y las que solo reconocía esta
       heurística en otra. Quien filtraba por una no veía las de la otra. */
    /* [v2] Cae en el ecosistema TEMÁTICO, no en el desaparecido «Fuera de
       Alcance». Si devolviera el viejo, bastaría importar una canción que
       ninguna regla reclame para que el ecosistema que acabamos de eliminar
       reapareciera en el árbol, y la migración quedaría deshecha sola. */
    return {
      ecosistema: ECOSISTEMA_CULTURA,
      area: AREA_MUSICA_FUERA_ALCANCE,
      tema: "",
      resumen: "Música y espectáculos. Contenido ajeno a la capacitación certificable de Kuvexta.",
      version: "",
      idioma: detectarIdioma(titulo, null, descripcion),
      subcategoria: AREA_MUSICA_FUERA_ALCANCE,
      noCertificable: true,
      herramienta: "",
      industria: INDUSTRIA_TRANSVERSAL,
      jurisdiccion: detectarJurisdiccion(titulo, descripcion) || JURISDICCION_GLOBAL,
      alcance: ALCANCE_NO_CERTIFICABLE,
      tipoContenido: "Entretenimiento"
    };
  }

  let herramienta = "", industria = INDUSTRIA_TRANSVERSAL;
  let jurisdiccion = JURISDICCION_GLOBAL, alcance = ALCANCE_CERTIFICABLE, tipoContenido = "Tutorial";

  if (mejor) {
    ecosistema = mejor.regla.ecosistema;
    area = mejor.regla.area;
    tema = mejor.regla.tema || "";
    resumen = mejor.regla.resumenSugerido;
    // [v2] Las facetas vienen de la regla que ganó, salvo las que se detectan.
    herramienta   = mejor.regla.herramienta || "";
    industria     = mejor.regla.industria || INDUSTRIA_TRANSVERSAL;
    jurisdiccion  = mejor.regla.jurisdiccion || JURISDICCION_GLOBAL;
    alcance       = mejor.regla.alcance || ALCANCE_CERTIFICABLE;
    tipoContenido = mejor.regla.tipoContenido || "Tutorial";
  } else {
    // Nada reconocido: no se afirma que sea certificable, se marca para revisar.
    alcance = ALCANCE_PENDIENTE;
  }

  /* [v2.6.8] El empate Odoo + MCP se decide por política, no por desempate.
     Va DESPUÉS de las reglas y ANTES de devolver: si alguna regla ya lo había
     puesto en su sitio, esto no hace nada; si ganó «Agentes y Sistemas
     Agénticos» —que también tiene razón— se corrige. Las facetas se toman de la
     regla de destino, no se dejan las de la regla que perdió: heredar el resumen
     de «agentes autónomos» en una ficha de Odoo es exactamente el tipo de
     incoherencia que nadie revisa porque la ruta ya se ve bien. */
  if (esCasoOdooMCP(titulo) &&
      !(ecosistema === RUTA_ODOO_MCP.ecosistema && area === RUTA_ODOO_MCP.area)) {
    ecosistema = RUTA_ODOO_MCP.ecosistema;
    area       = RUTA_ODOO_MCP.area;
    tema       = "";
    const fMcp = facetasDeRutaV2(ecosistema, area);
    if (fMcp) {
      if (fMcp.resumen) resumen = fMcp.resumen;
      herramienta   = fMcp.herramienta || "Odoo";
      industria     = fMcp.industria || INDUSTRIA_TRANSVERSAL;
      jurisdiccion  = fMcp.jurisdiccion || JURISDICCION_GLOBAL;
      alcance       = fMcp.alcance || ALCANCE_CERTIFICABLE;
      tipoContenido = fMcp.tipoContenido || "Tutorial";
    } else {
      /* La regla «IA en Odoo» no está en la hoja —alguien la borró—. Se coloca
         igual, pero sin afirmar que certifica: eso lo decide una persona. */
      herramienta = "Odoo";
      alcance = ALCANCE_PENDIENTE;
    }
  }

  /* La jurisdicción detectada en el texto PISA la de la regla: el país lo dice
     el contenido, no la rama en la que cayó. */
  const juriDetectada = detectarJurisdiccion(titulo, descripcion);
  if (juriDetectada) jurisdiccion = juriDetectada;

  return {
    ecosistema: ecosistema,
    area: area,
    tema: tema,
    resumen: resumen,
    version: detectarVersion(texto),
    idioma: detectarIdioma(titulo, null, descripcion),
    // Alias de compatibilidad: había llamadas que leían `.subcategoria`.
    subcategoria: area,
    /* Para el diagnóstico: qué palabra clave ganó y si fue por el título. No se
       escribe en la hoja; sirve para poder explicar una clasificación rara sin
       tener que adivinar. */
    claveGanadora: mejor ? mejor.clave : "",
    coincidioEnTitulo: mejor ? mejor.enTitulo === 1 : false,
    // [v2] Facetas
    herramienta: herramienta,
    industria: industria,
    jurisdiccion: jurisdiccion,
    alcance: alcance,
    tipoContenido: tipoContenido
  };
}

// -------------------------------------------------------------------------------------
// 5.1b Diagnóstico de la clasificación y sugerencia de reglas
// -------------------------------------------------------------------------------------

/**
 * Borra de la hoja las palabras clave que no distinguen nada.
 *
 * El lector ya las ignora, así que el catálogo se clasifica bien sin tocar
 * nada. Esto es para que la hoja no siga MOSTRANDO una palabra que no hace
 * nada: si «https» sigue escrita ahí, la próxima persona que mire la
 * configuración creerá que esa regla cubre los enlaces.
 *
 * Idempotente: pasarla dos veces no cambia nada la segunda vez.
 */
function limpiarClavesNoDiscriminantes() {
  exigirOrigenInterno("limpiarClavesNoDiscriminantes");
  const hoja = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("_Config_Taxonomia");
  if (!hoja || hoja.getLastRow() < 2) return { filas: 0, quitadas: [] };

  const filas = hoja.getLastRow() - 1;
  /* La columna sale de las cabeceras declaradas, no de un 4 escrito a mano: si
     algún día se inserta un campo en _Config_Taxonomia, esto sigue apuntando a
     las palabras clave en vez de vaciar la columna de al lado. */
  const columnaClaves = CABECERAS_TAXONOMIA.findIndex(c => /palabras clave/i.test(c)) + 1;
  if (columnaClaves < 1) return { filas: 0, quitadas: [] };
  const rango = hoja.getRange(2, columnaClaves, filas, 1);
  const valores = rango.getValues();
  const quitadas = [];
  let tocadas = 0;

  for (let i = 0; i < valores.length; i++) {
    const original = (valores[i][0] || "").toString();
    if (!original.trim()) continue;
    const claves = original.split(",").map(k => k.trim()).filter(Boolean);
    const utiles = claves.filter(k => {
      if (esClaveDiscriminante(k)) return true;
      quitadas.push(k);
      return false;
    });
    if (utiles.length !== claves.length) {
      valores[i][0] = utiles.join(", ");
      tocadas++;
    }
  }
  if (tocadas > 0) {
    rango.setValues(valores);
    invalidarCacheTaxonomia();
    logInfo("Taxonomía", `Limpiadas ${quitadas.length} palabras clave inútiles en ${tocadas} reglas.`);
  }
  return { filas: tocadas, quitadas: quitadas.filter((k, i, a) => a.indexOf(k) === i) };
}

function limpiarClavesNoDiscriminantesUI() {
  exigirOrigenInterno("limpiarClavesNoDiscriminantesUI");
  const r = limpiarClavesNoDiscriminantes();
  alertarUsuario(r.quitadas.length === 0
    ? "Ninguna regla tiene palabras clave inútiles. Nada que hacer."
    : `Quitadas ${r.quitadas.length} palabras clave de ${r.filas} reglas:\n\n   ` +
      r.quitadas.join(", ") +
      "\n\nEstas palabras aparecen en casi cualquier descripción, así que su regla se llevaba videos que no le tocaban.",
    "Taxonomía");
  return r;
}

/**
 * Cuenta cuántos videos se lleva cada regla y delata a las que se lo llevan todo.
 *
 * Es la herramienta que faltaba. Una regla mal escrita no produce ningún error:
 * produce un catálogo entero etiquetado con una ruta plausible y falsa, y eso
 * solo se ve contando. Si una sola regla reclama más de una cuarta parte del
 * catálogo, casi siempre es una palabra clave demasiado común, no un acierto.
 */
const TAXONOMIA_UMBRAL_DOMINANTE = 0.25;

function diagnosticarCoberturaTaxonomia() {
  const hoja = obtenerHojaDatos();
  const ultima = hoja.getLastRow();
  if (ultima < 2) return { total: 0, sinClasificar: 0, reglas: [], dominantes: [] };

  const datos = hoja.getRange(2, 1, ultima - 1, TOTAL_COLUMNAS).getValues();
  const conteo = {};
  let total = 0, sinClasificar = 0;

  datos.forEach(fila => {
    const titulo = (fila[IDX.TITULO] || "").toString();
    if (!titulo.trim()) return;
    total++;
    const c = motorClasificacionUniversal(titulo, descripcionFiableDeFila(fila), fila[IDX.CATEGORIA_YT]);
    if (c.ecosistema === SIN_CLASIFICAR) { sinClasificar++; return; }
    const ruta = c.ecosistema + " / " + c.area + (c.tema ? " / " + c.tema : "");
    if (!conteo[ruta]) conteo[ruta] = { ruta: ruta, videos: 0, claves: {}, ejemplos: [] };
    conteo[ruta].videos++;
    if (c.claveGanadora) conteo[ruta].claves[c.claveGanadora] = (conteo[ruta].claves[c.claveGanadora] || 0) + 1;
    if (conteo[ruta].ejemplos.length < 3) conteo[ruta].ejemplos.push(titulo.slice(0, 70));
  });

  const reglas = Object.keys(conteo).map(k => {
    const r = conteo[k];
    const claves = Object.keys(r.claves).sort((a, b) => r.claves[b] - r.claves[a]);
    return {
      ruta: r.ruta,
      videos: r.videos,
      porcentaje: total > 0 ? Math.round((r.videos / total) * 100) : 0,
      claveMasUsada: claves[0] || "",
      ejemplos: r.ejemplos
    };
  }).sort((a, b) => b.videos - a.videos);

  return {
    total: total,
    sinClasificar: sinClasificar,
    reglas: reglas,
    dominantes: reglas.filter(r => total > 0 && r.videos / total > TAXONOMIA_UMBRAL_DOMINANTE)
  };
}

/**
 * ¿Por qué ESTA fila quedó donde quedó?
 *
 * Existe porque la pregunta «¿por qué este video de cocina está en
 * Infraestructura?» no se puede contestar mirando la hoja: hay que saber qué
 * texto se clasificó —que no es el título tal cual—, qué reglas coincidieron y
 * cuál ganó el desempate. Sin esto, la única salida era adivinar; y adivinar
 * sobre las reglas de otro no funciona, porque cada quien añade las suyas.
 *
 * Devuelve el detalle; la versión UI lo muestra.
 */
function explicarClasificacionFila(filaNum) {
  const hoja = obtenerHojaDatos();
  const n = parseInt(filaNum, 10);
  if (!n || n < 2 || n > hoja.getLastRow()) {
    return { error: "La fila " + filaNum + " no existe en el catálogo." };
  }
  const fila = hoja.getRange(n, 1, 1, TOTAL_COLUMNAS).getValues()[0];
  const titulo = (fila[IDX.TITULO] || "").toString();
  if (!titulo) return { error: "La fila " + n + " no tiene título todavía." };

  const texto = textoParaClasificar(titulo, descripcionFiableDeFila(fila));
  const textoTitulo = textoParaClasificar(titulo, "");
  const coincidencias = [];

  obtenerTaxonomiaConfig().forEach((regla, indice) => {
    (regla.keywords || []).forEach(k => {
      if (!palabraClaveCoincide(texto, k)) return;
      const norm = normalizarBusqueda(k);
      coincidencias.push({
        clave: norm,
        ruta: regla.ecosistema + " / " + regla.area + (regla.tema ? " / " + regla.tema : ""),
        enTitulo: palabraClaveCoincide(textoTitulo, k),
        palabras: norm.split(" ").filter(Boolean).length,
        indice: indice + 2   // fila real en _Config_Taxonomia
      });
    });
  });

  const calc = motorClasificacionUniversal(titulo, descripcionFiableDeFila(fila), fila[IDX.CATEGORIA_YT]);
  return {
    fila: n,
    titulo: titulo,
    textoClasificado: texto,
    enHoja: (fila[IDX.ECOSISTEMA] || SIN_CLASIFICAR) + " / " + (fila[IDX.AREA] || SIN_CLASIFICAR) +
            (fila[IDX.TEMA] ? " / " + fila[IDX.TEMA] : ""),
    calculado: calc.ecosistema + " / " + calc.area + (calc.tema ? " / " + calc.tema : ""),
    coincidencias: coincidencias.sort((a, b) =>
      (b.enTitulo - a.enTitulo) || (b.palabras - a.palabras) || (b.clave.length - a.clave.length))
  };
}

function explicarClasificacionFilaUI() {
  exigirOrigenInterno("explicarClasificacionFilaUI");
  const ui = SpreadsheetApp.getUi();
  let sugerida = "";
  try { sugerida = String(SpreadsheetApp.getActiveSpreadsheet().getActiveCell().getRow()); } catch (e) { /* sin selección */ }

  const r = ui.prompt("¿Por qué quedó ahí?",
    "Número de fila del catálogo a explicar" + (sugerida ? " (la seleccionada es la " + sugerida + ")" : "") + ":",
    ui.ButtonSet.OK_CANCEL);
  if (r.getSelectedButton() !== ui.Button.OK) return;
  const pedida = (r.getResponseText() || "").trim() || sugerida;

  const d = explicarClasificacionFila(pedida);
  if (d.error) { alertarUsuario(d.error, "Explicación"); return; }

  let msg = "Título: " + d.titulo + "\n\n" +
            "En la hoja:  " + d.enHoja + "\n" +
            "Las reglas dicen:  " + d.calculado + "\n\n" +
            "Texto que se clasifica (sin enlaces ni arrobas):\n«" + d.textoClasificado.slice(0, 200) + "»\n\n";

  if (!d.coincidencias.length) {
    msg += "Ninguna palabra clave coincide. Si en la hoja aparece clasificado, " +
           "esa etiqueta la puso una versión anterior o una corrección a mano: " +
           "«Reclasificar catálogo» → Sí la reemplaza por «" + SIN_CLASIFICAR + "».";
  } else {
    msg += d.coincidencias.length + " coincidencia(s), la primera es la que gana:\n";
    d.coincidencias.slice(0, 8).forEach((c, i) => {
      msg += (i === 0 ? "  ▶ " : "    ") + "«" + c.clave + "» " +
             (c.enTitulo ? "(en el título)" : "(solo en el resumen)") +
             " → " + c.ruta + "   [_Config_Taxonomia fila " + c.indice + "]\n";
    });
    if (d.coincidencias.length > 8) msg += "    …y " + (d.coincidencias.length - 8) + " más.\n";
    msg += "\nSi la que gana no debería ganar, quita esa palabra clave de la fila " +
           d.coincidencias[0].indice + " de «Configurar Taxonomía» y reclasifica.";
  }
  alertarUsuario(msg, "Explicación de la clasificación");
  return d;
}

function diagnosticarCoberturaTaxonomiaUI() {
  exigirOrigenInterno("diagnosticarCoberturaTaxonomiaUI");
  const d = diagnosticarCoberturaTaxonomia();
  if (d.total === 0) { alertarUsuario("El catálogo está vacío.", "Taxonomía"); return d; }

  const lineas = [
    `Videos con título: ${d.total}`,
    `Sin clasificar: ${d.sinClasificar} (${Math.round((d.sinClasificar / d.total) * 100)} %)`,
    ""
  ];
  if (d.dominantes.length > 0) {
    lineas.push("⚠️ Reglas que se llevan demasiado catálogo — revisa sus palabras clave:");
    d.dominantes.forEach(r => {
      lineas.push(`   • ${r.ruta}: ${r.videos} videos (${r.porcentaje} %) por «${r.claveMasUsada}»`);
      r.ejemplos.forEach(e => lineas.push(`        p.ej. ${e}`));
    });
    lineas.push("");
  }
  lineas.push("Reparto (10 primeras):");
  d.reglas.slice(0, 10).forEach(r => {
    lineas.push(`   ${String(r.videos).padStart(4)}  ${r.ruta}` + (r.claveMasUsada ? `  ← «${r.claveMasUsada}»` : ""));
  });
  alertarUsuario(lineas.join("\n"), "Cobertura de la taxonomía");
  return d;
}

/** Cabeceras de la hoja de sugerencias de reglas. */
const CABECERAS_SUGERENCIAS_TAXONOMIA = [
  "Aprobar", "Palabra clave", "Videos que cubriría", "Ejemplos",
  "Ecosistema", "Área", "Tema", "Resumen sugerido"
];

/** Mínimos para proponer una regla: por debajo de esto es ruido. */
const SUGERENCIA_MIN_UNA_PALABRA = 4;
const SUGERENCIA_MIN_DOS_PALABRAS = 3;
const SUGERENCIA_MAX_PROPUESTAS = 60;

/**
 * Propone reglas de taxonomía a partir de lo que el catálogo ya tiene sin clasificar.
 *
 * El sistema viene con reglas semilla de Odoo, DIAN, hotelería y ferretería
 * porque es de lo que trata el sistema de origen; un catálogo real habla de
 * otras cosas —IA, agentes, AutoCAD, marketing, música— y esas quedan sin
 * clasificar hasta que alguien escriba las reglas a mano, una por una. Aquí se
 * hace al revés: se leen los títulos que nadie reclama, se agrupan las palabras
 * que se repiten y se propone una regla por grupo, con cuántos videos cubriría
 * y ejemplos para poder decidir de un vistazo.
 *
 * NO clasifica nada por su cuenta. Escribe propuestas en una hoja aparte y
 * espera aprobación: inventar rutas de ecosistema sin que nadie las mire es
 * exactamente el error que produce un catálogo lleno de etiquetas falsas.
 */
function sugerirReglasTaxonomia() {
  exigirOrigenInterno("sugerirReglasTaxonomia");
  const hoja = obtenerHojaDatos();
  const ultima = hoja.getLastRow();
  if (ultima < 2) return { propuestas: 0, analizados: 0 };

  const datos = hoja.getRange(2, 1, ultima - 1, TOTAL_COLUMNAS).getValues();
  const grupos = {};   // clave → { videos:Set de títulos, ejemplos:[] }
  let analizados = 0;

  datos.forEach(fila => {
    const titulo = (fila[IDX.TITULO] || "").toString().trim();
    if (!titulo) return;
    const c = motorClasificacionUniversal(titulo, descripcionFiableDeFila(fila), fila[IDX.CATEGORIA_YT]);
    if (c.ecosistema !== SIN_CLASIFICAR) return;   // ya tiene quien lo reclame
    analizados++;

    /* Solo el título. La descripción mete palabras del patrocinador y del canal,
       y una regla nacida de ahí sería tan mala como la que causó el desastre. */
    const palabras = textoParaClasificar(titulo, "").split(" ")
      .filter(p => p.length >= 3 && !VACIAS_BUSQUEDA[p] && !CLAVES_NO_DISCRIMINAN[p] && !/^\d+$/.test(p));

    const candidatas = {};
    palabras.forEach((p, i) => {
      candidatas[p] = 1;
      if (i + 1 < palabras.length) candidatas[p + " " + palabras[i + 1]] = 1;
    });
    Object.keys(candidatas).forEach(k => {
      if (!grupos[k]) grupos[k] = { clave: k, videos: 0, ejemplos: [] };
      grupos[k].videos++;
      if (grupos[k].ejemplos.length < 3) grupos[k].ejemplos.push(titulo.slice(0, 60));
    });
  });

  let propuestas = Object.keys(grupos).map(k => grupos[k]).filter(g => {
    const palabras = g.clave.split(" ").length;
    return g.videos >= (palabras > 1 ? SUGERENCIA_MIN_DOS_PALABRAS : SUGERENCIA_MIN_UNA_PALABRA);
  }).sort((a, b) => b.videos - a.videos || b.clave.length - a.clave.length);

  /* Una palabra suelta que no cubre más que la pareja de la que forma parte no
     aporta nada y sí multiplica el riesgo de sobre-emparejar: se descarta. */
  const parejas = propuestas.filter(p => p.clave.indexOf(" ") !== -1);
  propuestas = propuestas.filter(p => {
    if (p.clave.indexOf(" ") !== -1) return true;
    return !parejas.some(par => par.clave.split(" ").indexOf(p.clave) !== -1 && par.videos >= p.videos);
  }).slice(0, SUGERENCIA_MAX_PROPUESTAS);

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let destino = ss.getSheetByName("_Sugerencias_Taxonomia");
  if (!destino) destino = ss.insertSheet("_Sugerencias_Taxonomia", ss.getSheets().length);
  destino.clear();
  destino.getRange(1, 1, 1, CABECERAS_SUGERENCIAS_TAXONOMIA.length)
    .setValues([CABECERAS_SUGERENCIAS_TAXONOMIA])
    .setFontWeight("bold").setBackground("#1e293b").setFontColor("#ffffff");

  if (propuestas.length > 0) {
    const filas = propuestas.map(p => [
      false, p.clave, p.videos, p.ejemplos.join(" · "), "", "", "",
      "Contenido sobre " + p.clave + "."
    ]);
    destino.getRange(2, 1, filas.length, CABECERAS_SUGERENCIAS_TAXONOMIA.length).setValues(filas);
    try { destino.getRange(2, 1, filas.length, 1).insertCheckboxes(); } catch (e) { /* sin casillas */ }
  }
  try { destino.setFrozenRows(1); } catch (e) { /* hoja mínima */ }
  destino.showSheet();

  logInfo("Taxonomía", `${propuestas.length} reglas propuestas a partir de ${analizados} videos sin clasificar.`);
  return { propuestas: propuestas.length, analizados: analizados, claves: propuestas.map(p => p.clave) };
}

function sugerirReglasTaxonomiaUI() {
  exigirOrigenInterno("sugerirReglasTaxonomiaUI");
  const r = sugerirReglasTaxonomia();
  if (r.propuestas === 0) {
    alertarUsuario(r.analizados === 0
      ? "No hay videos sin clasificar: no hay nada que proponer."
      : `Hay ${r.analizados} videos sin clasificar, pero ninguna palabra se repite lo suficiente como para proponer una regla fiable.`,
      "Sugerencias de taxonomía");
    return r;
  }
  try { SpreadsheetApp.getActiveSpreadsheet().getSheetByName("_Sugerencias_Taxonomia").activate(); } catch (e) { /* sin UI */ }
  alertarUsuario(
    `${r.propuestas} reglas propuestas a partir de ${r.analizados} videos sin clasificar.\n\n` +
    "En la hoja «_Sugerencias_Taxonomia»:\n" +
    "  1. Escribe el Ecosistema y el Área de las que te sirvan (el Tema es opcional).\n" +
    "  2. Marca «Aprobar».\n" +
    "  3. Vuelve al menú y usa «Aplicar sugerencias aprobadas».\n\n" +
    "Nada se clasifica hasta que apruebes.",
    "Sugerencias de taxonomía");
  return r;
}

/** ¿Está marcada la casilla? Acepta casilla real o texto escrito a mano. */
function sugerenciaAprobada(valor) {
  if (valor === true) return true;
  const s = (valor || "").toString().trim().toLowerCase();
  return s === "si" || s === "sí" || s === "x" || s === "true" || s === "verdadero";
}

/**
 * Pasa a _Config_Taxonomia las sugerencias aprobadas y las quita de la hoja.
 *
 * Exige Ecosistema y Área: una regla sin ellos escribiría «General / General»
 * sobre un montón de videos, que es peor que dejarlos sin clasificar —lo
 * segundo se ve, lo primero no—. Las aprobadas sin rellenar se informan y se
 * quedan donde están.
 */
function aplicarSugerenciasTaxonomia() {
  exigirOrigenInterno("aplicarSugerenciasTaxonomia");
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const hoja = ss.getSheetByName("_Sugerencias_Taxonomia");
  if (!hoja || hoja.getLastRow() < 2) return { aplicadas: 0, incompletas: 0 };

  const filas = hoja.getRange(2, 1, hoja.getLastRow() - 1, CABECERAS_SUGERENCIAS_TAXONOMIA.length).getValues();
  const nuevas = [];
  const incompletas = [];
  const restantes = [];

  filas.forEach(f => {
    const clave = (f[1] || "").toString().trim();
    if (!clave) return;
    if (!sugerenciaAprobada(f[0])) { restantes.push(f); return; }
    const eco = (f[4] || "").toString().trim();
    const area = (f[5] || "").toString().trim();
    if (!eco || !area) { incompletas.push(clave); restantes.push(f); return; }
    /* Una regla nacida de una sugerencia no puede declararse certificable sola:
       la aprueba una persona que dijo el ecosistema y el área, no el alcance.
       Queda pendiente de revisión hasta que alguien lo decida a propósito. */
    nuevas.push([eco, area, (f[6] || "").toString().trim(), clave,
      (f[7] || "").toString().trim() || ("Contenido sobre " + clave + "."),
      "", INDUSTRIA_TRANSVERSAL, JURISDICCION_GLOBAL, ALCANCE_PENDIENTE, "Tutorial"]);
  });

  if (nuevas.length > 0) {
    const config = ss.getSheetByName("_Config_Taxonomia") || crearPestanaConfigTaxonomia();
    config.getRange(config.getLastRow() + 1, 1, nuevas.length, ANCHO_TAXONOMIA).setValues(nuevas);
    invalidarCacheTaxonomia();
    logInfo("Taxonomía", `${nuevas.length} reglas nuevas aprobadas desde sugerencias.`);

    hoja.clear();
    hoja.getRange(1, 1, 1, CABECERAS_SUGERENCIAS_TAXONOMIA.length)
      .setValues([CABECERAS_SUGERENCIAS_TAXONOMIA])
      .setFontWeight("bold").setBackground("#1e293b").setFontColor("#ffffff");
    if (restantes.length > 0) {
      hoja.getRange(2, 1, restantes.length, CABECERAS_SUGERENCIAS_TAXONOMIA.length).setValues(restantes);
      try { hoja.getRange(2, 1, restantes.length, 1).insertCheckboxes(); } catch (e) { /* sin casillas */ }
    }
  }
  return { aplicadas: nuevas.length, incompletas: incompletas.length, faltantes: incompletas };
}

function aplicarSugerenciasTaxonomiaUI() {
  exigirOrigenInterno("aplicarSugerenciasTaxonomiaUI");
  const r = aplicarSugerenciasTaxonomia();
  if (r.aplicadas === 0 && r.incompletas === 0) {
    alertarUsuario("No hay sugerencias aprobadas. Marca «Aprobar» en las que quieras usar.", "Sugerencias de taxonomía");
    return r;
  }
  let msg = `${r.aplicadas} reglas añadidas a la taxonomía.`;
  if (r.incompletas > 0) {
    msg += `\n\n${r.incompletas} aprobadas se quedaron sin aplicar por faltarles Ecosistema o Área:\n   ` +
      r.faltantes.slice(0, 10).join(", ");
  }
  if (r.aplicadas > 0) msg += "\n\nAhora usa «Reclasificar catálogo» para aplicarlas a los videos.";
  alertarUsuario(msg, "Sugerencias de taxonomía");
  return r;
}

