/**
 * Vuelca a Drive el estado de certificación de toda la organización: un JSON con
 * una entrada por (persona, módulo). Es la fuente que consume RR. HH. o el ERP
 * para liquidar bonos sin abrir la hoja de cálculo.
 */
function exportarCertificacionesAJson() {
  exigirOrigenInterno("exportarCertificacionesAJson");
  limpiarMemoEjecucion();   // [OPT-15] datos frescos al arrancar el barrido
  const modulos = listarModulos().filter(m => m.estado !== "ARCHIVADO");
  const correos = obtenerCorreosConocidos();
  const registros = [];

  correos.forEach(correo => {
    modulos.forEach(m => {
      const estado = obtenerEstadoModuloUsuario(correo, m.id);
      if (!estado) return;
      if (estado.videosVistos === 0 && estado.intentosUsados === 0) return;  // sin actividad: no ensucia el reporte
      registros.push({
        correo: correo,
        moduloId: m.id,
        modulo: m.nombre,
        rol: m.rol,
        videosVistos: estado.videosVistos,
        totalVideos: estado.totalVideos,
        avanceVisualizacion: estado.porcentajeAvance,
        intentosUsados: estado.intentosUsados,
        maxIntentos: estado.maxIntentos,
        ultimoPorcentaje: estado.ultimoPorcentaje,
        nivel: estado.ultimoNivel,
        certificado: estado.examenAprobado,
        estado: estado.estado
      });
    });
  });

  const payload = {
    generadoEn: new Date().toISOString(),
    version: VERSION_SCRIPT,
    totalPersonas: correos.length,
    totalModulos: modulos.length,
    registros: registros
  };

  const raiz = obtenerCarpetaRaiz();
  const nombre = "certificaciones.json";
  const contenido = JSON.stringify(payload, null, 2);
  const existentes = raiz.getFilesByName(nombre);
  if (existentes.hasNext()) existentes.next().setContent(contenido);
  else raiz.createFile(nombre, contenido, MimeType.PLAIN_TEXT);

  logInfo("Exportación", `Certificaciones exportadas (${registros.length} registros).`);
  return registros.length;
}

function exportarCertificacionesUI() {
  try {
    const n = exportarCertificacionesAJson();
    alertarUsuario(`Se exportaron ${n} registros de certificación a Drive (certificaciones.json).`, "Certificaciones");
  } catch (e) {
    alertarUsuario("Error exportando certificaciones: " + e.message, "Certificaciones");
  }
}

/**
 * Pestaña «Certificaciones»: matriz persona × módulo con formato condicional.
 * Es la vista que se proyecta en un comité: verde certifica, ámbar aprueba con
 * reservas, rojo requiere refuerzo, gris sin actividad.
 */
function generarPestanaCertificaciones() {
  exigirOrigenInterno("generarPestanaCertificaciones");
  limpiarMemoEjecucion();   // [OPT-15] datos frescos al arrancar el barrido
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const modulos = listarModulos().filter(m => m.estado !== "ARCHIVADO");
  if (modulos.length === 0) { alertarUsuario(t("alert_sin_modulos"), "Certificaciones"); return; }

  const correos = obtenerCorreosConocidos();
  const hoja = ss.getSheetByName("Certificaciones") || ss.insertSheet("Certificaciones", 3);
  hoja.clear();
  hoja.getCharts().forEach(g => hoja.removeChart(g));
  hoja.activate();

  hoja.getRange(1, 1, 1, modulos.length + 3).merge()
    .setValue("🎓 MATRIZ DE CERTIFICACIÓN POR MÓDULO — " + VERSION_SCRIPT)
    .setFontSize(14).setFontWeight("bold").setBackground("#4c1d95").setFontColor("#ffffff")
    .setHorizontalAlignment("center");

  const cabecera = ["Colaborador"].concat(modulos.map(m => m.nombre)).concat(["Módulos certificados", "Promedio %"]);
  hoja.getRange(3, 1, 1, cabecera.length).setValues([cabecera])
    .setFontWeight("bold").setBackground("#1f2937").setFontColor("#ffffff").setWrap(true);

  const filas = [];
  const colores = [];
  correos.forEach(correo => {
    const fila = [correo];
    const colorFila = ["#ffffff"];
    let certificados = 0, suma = 0, evaluados = 0;

    modulos.forEach(m => {
      const est = obtenerEstadoModuloUsuario(correo, m.id);
      if (!est || !est.examenCompletado) {
        fila.push(est && est.videosVistos > 0 ? est.porcentajeAvance + "% visto" : "—");
        colorFila.push(est && est.videosVistos > 0 ? "#e0f2fe" : "#f3f4f6");
        return;
      }
      const pct = est.ultimoPorcentaje;
      suma += pct; evaluados++;
      if (est.examenAprobado) certificados++;
      fila.push(pct + "% · " + est.ultimoNivel);
      colorFila.push(pct >= 90 ? "#bbf7d0" : (pct >= 80 ? "#d9f99d" : (pct >= 60 ? "#fef08a" : "#fecaca")));
    });

    fila.push(certificados + " / " + modulos.length);
    fila.push(evaluados > 0 ? parseFloat((suma / evaluados).toFixed(1)) : 0);
    colorFila.push("#e5e7eb", "#e5e7eb");
    filas.push(fila);
    colores.push(colorFila);
  });

  if (filas.length === 0) {
    hoja.getRange(4, 1).setValue("Aún no hay actividad registrada de colaboradores.");
    return;
  }

  const rango = hoja.getRange(4, 1, filas.length, cabecera.length);
  rango.setValues(filas);
  rango.setBackgrounds(colores);
  hoja.setFrozenRows(3);
  hoja.setFrozenColumns(1);
  hoja.setColumnWidth(1, 240);
  for (let c = 2; c <= cabecera.length; c++) hoja.setColumnWidth(c, 150);

  logInfo("Certificaciones", `Matriz generada: ${filas.length} colaboradores × ${modulos.length} módulos.`);
  notificarUsuario("Matriz de certificación actualizada.", "Certificaciones", 4);
}

/**
 * Expediente individual en Google Docs: notas, módulos, brechas y refuerzos.
 * Sirve como soporte formal de la evaluación de desempeño.
 */
function generarExpedienteColaborador(correo) {
  exigirOrigenInterno("generarExpedienteColaborador");
  const email = (correo || "").toString().toLowerCase().trim();
  if (!email) throw new Error("Se requiere el correo del colaborador.");

  limpiarMemoEjecucion();
  const doc = DocumentApp.create("Expediente de Certificación — " + email);
  const cuerpo = doc.getBody();
  cuerpo.appendParagraph("EXPEDIENTE DE CERTIFICACIÓN TÉCNICA").setHeading(DocumentApp.ParagraphHeading.TITLE);
  cuerpo.appendParagraph("Colaborador: " + email);
  cuerpo.appendParagraph("Emitido: " + Utilities.formatDate(new Date(), obtenerZonaHoraria(), "yyyy-MM-dd HH:mm"));
  cuerpo.appendParagraph("Sistema: " + VERSION_SCRIPT);
  cuerpo.appendHorizontalRule();

  const modulos = listarModulos().filter(m => m.estado !== "ARCHIVADO");
  let certificados = 0;

  modulos.forEach(m => {
    const est = obtenerEstadoModuloUsuario(email, m.id);
    if (!est || (est.videosVistos === 0 && est.intentosUsados === 0)) return;
    if (est.examenAprobado) certificados++;

    cuerpo.appendParagraph(m.nombre).setHeading(DocumentApp.ParagraphHeading.HEADING2);
    const tabla = [
      ["Avance de visualización", est.videosVistos + " / " + est.totalVideos + " (" + est.porcentajeAvance + "%)"],
      ["Intentos usados", est.intentosUsados + " de " + est.maxIntentos],
      ["Última calificación", est.examenCompletado ? est.ultimoPorcentaje + "%" : "Sin presentar"],
      ["Nivel alcanzado", est.ultimoNivel || "—"],
      ["Estado", est.estado]
    ];
    cuerpo.appendTable(tabla).setBorderWidth(1);

    if (est.ultimoIntentoId) {
      try {
        const informe = obtenerInformeIntento(est.ultimoIntentoId, true);
        if (informe && informe.hallazgos && informe.hallazgos.length > 0) {
          cuerpo.appendParagraph("Brechas detectadas y riesgo operativo:")
            .setHeading(DocumentApp.ParagraphHeading.HEADING4);
          informe.hallazgos.slice(0, 8).forEach(h => {
            cuerpo.appendListItem(
              "[" + (h.severidad || "BAJO") + "] " + (h.concepto || "General") + " — " +
              (h.causaRaiz || "") + (h.riesgo ? " · Riesgo: " + h.riesgo : "")
            ).setGlyphType(DocumentApp.GlyphType.BULLET);
          });
        }
        if (informe && informe.forense && informe.forense.indice !== "NO_APLICA") {
          cuerpo.appendParagraph("Índice forense del último intento: " + informe.forense.indice +
            " (" + informe.forense.trampasCaidas + "/" + informe.forense.trampasPresentadas +
            " trampas, " + informe.forense.segundosPorPregunta + " s por pregunta).");
        }
      } catch (e) { /* el informe es opcional en el expediente */ }
    }
  });

  cuerpo.appendHorizontalRule();
  cuerpo.appendParagraph("Módulos certificados: " + certificados + " de " + modulos.length)
    .setHeading(DocumentApp.ParagraphHeading.HEADING3);

  doc.saveAndClose();
  const archivo = DriveApp.getFileById(doc.getId());
  obtenerSubcarpeta("Expedientes").addFile(archivo);
  try { DriveApp.getRootFolder().removeFile(archivo); } catch (e) { /* ya movido */ }

  logInfo("Certificaciones", "Expediente generado para " + email);
  return archivo.getUrl();
}

function generarExpedienteColaboradorUI() {
  exigirOrigenInterno("generarExpedienteColaboradorUI");
  const ui = SpreadsheetApp.getUi();
  const correos = obtenerCorreosConocidos();
  const resp = ui.prompt("Expediente de Certificación",
    "Correo del colaborador:\n\nConocidos: " + (correos.slice(0, 15).join(", ") || "ninguno todavía"),
    ui.ButtonSet.OK_CANCEL);
