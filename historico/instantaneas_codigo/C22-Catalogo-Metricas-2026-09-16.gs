function generarEmbedding(texto) {
  const apiKey = proveedorApiKey("GEMINI");
  if (!apiKey) throw new Error(t("err_api_key", { proveedor: "Gemini" }));

  const url = URL_GEMINI_BASE + "text-embedding-004:embedContent?key=" + apiKey;
  const r = ejecutarFetchSeguro(url, {
    method: "POST",
    contentType: "application/json",
    payload: JSON.stringify({ content: { parts: [{ text: (texto || "").toString().slice(0, 8000) }] } })
  }, "Gemini Embeddings");

  if (!r.ok) throw new Error(t("err_api_http", { codigo: r.codigo, servicio: "Gemini Embeddings", detalle: r.cuerpo.slice(0, 200) }));
  const json = JSON.parse(r.cuerpo);
  if (json.embedding && json.embedding.values) return json.embedding.values;
  throw new Error("Fallo embedding: " + (json.error ? json.error.message : "Sin respuesta"));
}

/** Alias usado por el módulo de chunking. */
function generarEmbeddingVectorial(texto) {
  return generarEmbedding(texto);
}

/**
 * [OPT-3] Vectorización POR LOTE con `batchEmbedContents`.
 * Antes cada fragmento costaba una llamada HTTP más 200 ms de espera: indexar
 * un documento de 60 fragmentos tardaba ~40 s y consumía 60 unidades de cuota.
 * Gemini admite hasta 100 textos por petición, así que ese mismo documento se
 * resuelve en UNA llamada. Es la diferencia entre indexar el catálogo entero o
 * chocar contra el límite de 6 minutos a la tercera decena de videos.
 *
 * Degrada con elegancia: si el endpoint por lote falla (404 en despliegues
 * antiguos, o un modelo sin soporte), cae a la vía unitaria sin perder trabajo.
 *
 * @param  {string[]} textos
 * @return {Array<number[]|null>} vectores en el MISMO orden; null donde falló
 */
function generarEmbeddingsLote(textos) {
  const lista = (textos || []).map(x => (x || "").toString().slice(0, 8000));
  if (lista.length === 0) return [];

  const apiKey = proveedorApiKey("GEMINI");
  if (!apiKey) throw new Error(t("err_api_key", { proveedor: "Gemini" }));

  const salida = new Array(lista.length).fill(null);

  for (let inicio = 0; inicio < lista.length; inicio += LOTE_MAX_EMBED_BATCH) {
    const tanda = lista.slice(inicio, inicio + LOTE_MAX_EMBED_BATCH);
    verificarCuotaDisponible(1, "GEMINI");   // una petición = una unidad, no una por texto

    const url = URL_GEMINI_BASE + "text-embedding-004:batchEmbedContents?key=" + apiKey;
    const r = ejecutarFetchSeguro(url, {
      method: "POST",
      contentType: "application/json",
      payload: JSON.stringify({
        requests: tanda.map(texto => ({
          model: "models/text-embedding-004",
          content: { parts: [{ text: texto }] }
        }))
      })
    }, "Gemini Batch Embeddings");

    if (r.ok) {
      try {
        const json = JSON.parse(r.cuerpo);
        const vectores = json.embeddings || [];
        for (let i = 0; i < tanda.length; i++) {
          if (vectores[i] && vectores[i].values) salida[inicio + i] = vectores[i].values;
        }
        continue;
      } catch (e) {
        logWarn("Embeddings", "Respuesta por lote ilegible; se recurre a la vía unitaria.");
      }
    } else {
      logWarn("Embeddings", `Lote HTTP ${r.codigo}; se recurre a la vía unitaria para ${tanda.length} textos.`);
    }

    // Repliegue unitario: lento, pero no se pierde el trabajo de la tanda.
    for (let i = 0; i < tanda.length; i++) {
      try {
        salida[inicio + i] = generarEmbedding(tanda[i]);
        Utilities.sleep(150);
      } catch (e2) {
        logWarn("Embeddings", `Fallo unitario en el texto ${inicio + i}: ${e2.message}`);
      }
    }
  }

  return salida;
}

/**
 * Embedding de una consulta de búsqueda, cacheado 30 minutos.
 * Las consultas del portal se repiten mucho ("odoo inventario", "facturación
 * DIAN"): vectorizarlas de nuevo en cada búsqueda es una llamada de red y una
 * unidad de cuota regaladas.
 */
function generarEmbeddingConsulta(query) {
  const texto = (query || "").toString().trim().toLowerCase();
  if (!texto) return [];
  const clave = CLAVE_CACHE_EMB_QUERY +
    Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.MD5, texto)).slice(0, 40);

  const cache = CacheService.getScriptCache();
  try {
    const guardado = cache.get(clave);
    if (guardado) return JSON.parse(guardado);
  } catch (e) { /* caché corrupta */ }

  const vector = generarEmbedding(texto);
  try { cache.put(clave, JSON.stringify(vector), 1800); } catch (e) { /* > 100 KB */ }
  return vector;
}

function cosenoSimilitud(vecA, vecB) {
  if (!vecA || !vecB || vecA.length !== vecB.length) return 0;
  let dot = 0, normA = 0, normB = 0;
  for (let i = 0; i < vecA.length; i++) {
    dot += vecA[i] * vecB[i];
    normA += vecA[i] * vecA[i];
    normB += vecB[i] * vecB[i];
  }
  return (normA === 0 || normB === 0) ? 0 : dot / (Math.sqrt(normA) * Math.sqrt(normB));
}

/** Alias histórico. */
function calcularCoseno(a, b) {
  return cosenoSimilitud(a, b);
}

function obtenerHojaEmbeddings() {
  /* [6.24] Guarda de efecto real. No es una acción de panel ni una ruta de la
     API: es una pieza interna que escribe, crea archivos, manda correo o sale a
     la red. Y en Apps Script una pieza interna pública es una ruta más. Pasa
     desde cualquier entrada legítima —menú, paneles, doGet, doPost,
     disparadores—, porque todas marcan origen antes de trabajar. */
  exigirOrigenInterno("obtenerHojaEmbeddings");
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sheet = ss.getSheetByName("_Embeddings");
  if (!sheet) {
    sheet = ss.insertSheet("_Embeddings");
    sheet.appendRow(["ID Video", "Embedding (JSON)", "Timestamp"]);
    sheet.setFrozenRows(1);
    sheet.hideSheet();
  }
  return sheet;
}

function generarEmbeddingVideo(tokenAdmin, idVideo) {
  validarTokenConScope(tokenAdmin, "admin");
  if (!idVideo) throw new Error("ID de video no especificado.");

  let encontrado = null;
  iterarCatalogoPorBloques(function (datos) {
    for (let i = 0; i < datos.length; i++) {
      if ((datos[i][IDX.ID] || "").toString().trim() === idVideo) { encontrado = datos[i]; return false; }
    }
    return false;
  });
  if (!encontrado) throw new Error("El video no existe en el catálogo maestro.");

  const textoVector = `${encontrado[IDX.TITULO] || ""}. ${encontrado[IDX.RESUMEN] || ""} ${encontrado[IDX.TAGS] || ""}`;
  const vector = generarEmbedding(textoVector);
  const embSheet = obtenerHojaEmbeddings();

  let filaIndex = -1;
  if (embSheet.getLastRow() >= 2) {
    const ids = embSheet.getRange(2, 1, embSheet.getLastRow() - 1, 1).getValues().flat();
    const idx = ids.indexOf(idVideo);
    if (idx !== -1) filaIndex = idx + 2;
  }

  if (filaIndex !== -1) embSheet.getRange(filaIndex, 2, 1, 2).setValues([[JSON.stringify(vector), new Date()]]);
  else embSheet.appendRow([idVideo, JSON.stringify(vector), new Date()]);

  logInfo("Embeddings", `Vector actualizado para ${idVideo}.`);
  return { status: "success", idVideo: idVideo };
}

/**
 * [OPT-3][OPT-8] Vectoriza el catálogo por lotes y con presupuesto de tiempo.
 * Dos cambios frente a la versión anterior:
 *   · una petición por cada 100 videos en vez de una por video (sin sleeps);
 *   · si se agota el presupuesto de ejecución, guarda checkpoint y se reanuda
 *     sola con un disparador, en lugar de morir por timeout perdiendo el lote.
 */
function generarEmbeddingsCatalogo(tokenAdmin, silencioso = false) {
  validarTokenConScope(tokenAdmin, "admin");
  const embSheet = obtenerHojaEmbeddings();
  const inicioMs = Date.now();

  const indexados = {};
  if (embSheet.getLastRow() >= 2) {
    embSheet.getRange(2, 1, embSheet.getLastRow() - 1, 1).getValues().forEach(r => {
      if (r[0]) indexados[r[0].toString().trim()] = true;
    });
  }

  // Recolecta primero: la red no se toca dentro del recorrido de la hoja.
  const cola = [];
  let pendientes = 0;
  iterarCatalogoPorBloques(function (datos) {
    for (let i = 0; i < datos.length; i++) {
      const id = (datos[i][IDX.ID] || "").toString().trim();
      const tit = (datos[i][IDX.TITULO] || "").toString().trim();
      if (!id || !tit || indexados[id]) continue;
      // Lo no certificable no se vectoriza salvo que se haya activado: gasta
      // cuota y, si no lo quieres buscable, ensucia la búsqueda por significado.
      if (!filaAdmiteTranscripcion(datos[i])) continue;
      if (cola.length >= LOTE_MAX_EMBEDDINGS) { pendientes++; continue; }
      cola.push({ id: id, texto: `${tit}. ${datos[i][IDX.RESUMEN] || ""} ${datos[i][IDX.TAGS] || ""}` });
      indexados[id] = true;
    }
    return false;
  });

  if (cola.length === 0) {
    PropertiesService.getScriptProperties().deleteProperty("EMBEDDINGS_CHECKPOINT");
    limpiarTriggersPorFuncion("continuarEmbeddingsCatalogo_");
    return { status: "success", generados: 0, pendientes: 0, completado: true };
  }

  const nuevos = [];
  let generados = 0;
  let agotoTiempo = false;

  for (let inicio = 0; inicio < cola.length; inicio += LOTE_MAX_EMBED_BATCH) {
    if (Date.now() - inicioMs > PRESUPUESTO_EJECUCION_MS) {
      agotoTiempo = true;
      pendientes += cola.length - inicio;
      break;
    }
    const tanda = cola.slice(inicio, inicio + LOTE_MAX_EMBED_BATCH);
    let vectores;
    try {
      vectores = generarEmbeddingsLote(tanda.map(x => x.texto));
    } catch (err) {
      // Cuota agotada u otro fallo duro: se encola para reintentar mañana.
      logWarn("Embeddings", `Tanda abortada: ${err.message}`);
      encolarTareaDiferida("embeddings_catalogo", {}, err.message);
      pendientes += cola.length - inicio;
      break;
    }
    tanda.forEach((item, i) => {
      if (!vectores[i]) return;
      nuevos.push([item.id, JSON.stringify(vectores[i]), new Date()]);
      generados++;
    });
  }

  if (nuevos.length > 0) embSheet.getRange(embSheet.getLastRow() + 1, 1, nuevos.length, 3).setValues(nuevos);

  // Checkpoint: quedan videos sin vector, se reanuda automáticamente.
  const props = PropertiesService.getScriptProperties();
  if (pendientes > 0) {
    props.setProperty("EMBEDDINGS_CHECKPOINT", JSON.stringify({ pendientes: pendientes, fecha: new Date().toISOString() }));
    if (agotoTiempo) programarContinuacionEmbeddings();
  } else {
    props.deleteProperty("EMBEDDINGS_CHECKPOINT");
    limpiarTriggersPorFuncion("continuarEmbeddingsCatalogo_");
  }

  logInfo("Embeddings", `Generados ${generados}; pendientes ${pendientes}${agotoTiempo ? " (presupuesto agotado)" : ""}.`);
  if (!silencioso && pendientes > 0 && agotoTiempo) {
    notificarUsuario(`Se vectorizaron ${generados}. Quedan ${pendientes}: continuará sola en 1 minuto.`, "Embeddings", 6);
  }
  return { status: "success", generados: generados, pendientes: pendientes, completado: pendientes === 0 };
}

/** Encadena la siguiente tanda de embeddings tras agotar el presupuesto. */
function programarContinuacionEmbeddings() {
  limpiarTriggersPorFuncion("continuarEmbeddingsCatalogo_");
  registrarTriggerSeguro(
    ScriptApp.newTrigger("continuarEmbeddingsCatalogo_").timeBased().after(60 * 1000),
    "continuarEmbeddingsCatalogo_"
  );
}

/** Reanudación automática, sin interfaz. */
function continuarEmbeddingsCatalogo_() {
  marcarOrigenConfiable();   // [SEC-1] entrada legítima del servidor
  try {
    const token = obtenerTokenAdministrador_();
    if (!token) { logWarn("Embeddings", "Sin ADMIN_TOKEN: no se puede continuar."); return; }
    const res = generarEmbeddingsCatalogo(token, true);
    logInfo("Embeddings", `Continuación: ${res.generados} generados, ${res.pendientes} pendientes.`);
  } catch (e) {
    logError("Embeddings", "Continuación fallida: " + e.message);
  }
}

function generarEmbeddingsParaCatalogo() {
  exigirOrigenInterno("generarEmbeddingsParaCatalogo");
  const token = obtenerTokenAdministrador_();
  if (!token) { alertarUsuario(t("alert_sin_admin_token")); return; }
  const res = generarEmbeddingsCatalogo(token);
  notificarUsuario(t("toast_embeddings", { generados: res.generados, pendientes: res.pendientes }), "Embeddings", 5);
}

/**
 * [OPT-9] Búsqueda por similitud en el catálogo, con prefiltro opcional.
 * Calcular el coseno contra todos los vectores es O(n) e inevitable sin índice
 * vectorial. Lo que SÍ se puede es reducir n antes de calcular: si la consulta
 * viene acotada por dominio, subcategoría o módulo, los vectores fuera de ese
 * conjunto ni se parsean, que es donde se va el tiempo (JSON.parse de 768 floats).
 */
function buscarPorSimilitudCoseno(query, topN = 10, prefiltro = null, umbral = null) {
  const queryEmb = generarEmbeddingConsulta(query);
  const minSim = resolverUmbralSimilitud(umbral, "UMBRAL_SIM_CATALOGO", UMBRAL_SIMILITUD_CATALOGO);
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const embSheet = ss.getSheetByName("_Embeddings");
  if (!embSheet || embSheet.getLastRow() < 2) return [];

  const f = prefiltro || {};
  const catMap = {};
  iterarCatalogoPorBloques(function (datos) {
    datos.forEach(r => {
      if (!r[IDX.ID]) return;
      if (!filaPasaPrefiltro(r, f)) return;
      catMap[r[IDX.ID].toString().trim()] = r;
    });
    return false;
  });
  // Con prefiltro vacío no hay candidatos: se evita recorrer los embeddings.
  if (Object.keys(catMap).length === 0) return [];

  const resultados = [];
  const total = embSheet.getLastRow() - 1;
  for (let inicio = 2; inicio <= total + 1; inicio += BATCH_TAMANO_BLOQUE) {
    const num = Math.min(BATCH_TAMANO_BLOQUE, total + 1 - inicio + 1);
    if (num <= 0) break;
    const embDatos = embSheet.getRange(inicio, 1, num, 2).getValues();
    embDatos.forEach(f => {
      const id = f[0] ? f[0].toString().trim() : "";
      if (!id || !catMap[id]) return;
      try {
        const sim = cosenoSimilitud(queryEmb, JSON.parse(f[1]));
        if (sim > minSim) {
          const r = catMap[id];
          resultados.push({
            id: id, titulo: r[IDX.TITULO], resumen: r[IDX.RESUMEN], url: r[IDX.URL],
            duracion: r[IDX.DURACION] || 0, dificultad: r[IDX.DIFICULTAD] || "Principiante",
            driveIdText: r[IDX.DRIVE_RAG] || "", similitud: Number(sim.toFixed(4)), origen: "catalogo"
          });
        }
      } catch (e) { /* vector corrupto */ }
    });
  }
  return resultados.sort((a, b) => b.similitud - a.similitud).slice(0, topN);
}

// -------------------------------------------------------------------------------------
// 7.1b Búsqueda léxica — el piso que NO depende de la IA
// -------------------------------------------------------------------------------------

/**
 * Normaliza para comparar: sin acentos, sin mayúsculas, sin signos. Buscar
 * "instalacion" tiene que encontrar "Instalación", y en un catálogo escrito por
 * varias personas eso pasa todo el rato.
 */
function normalizarBusqueda(texto) {
  return (texto || "").toString()
    /* [v2.6.18] NFKD, no NFD. La l\u00ednea siguiente tira todo lo que no sea
       a-z0-9\u00f1, as\u00ed que un car\u00e1cter que no se descomponga a ASCII desaparece \u2014y
       con NFD no se descomponen las letras matem\u00e1ticas de Unicode. En el
       cat\u00e1logo hay un curso titulado \u00ab\ud835\udc12\ud835\udc06-\ud835\udc12\ud835\udc12\ud835\udc13 \u2026\u00bb: con NFD se normalizaba a
       \u00absistema de gestion\u00bb, sin la sigla, y ninguna regla de SST pod\u00eda
       reconocerlo. Con NFKD queda \u00absg sst sistema de gestion\u00bb.
       De regalo arregla las ligaduras: \u00ab\ufb01brocemento\u00bb se normalizaba a
       \u00abbrocemento\u00bb \u2014una f que se perd\u00eda sin que nada lo dijera\u2014.
       Lo que NFKD NO hace es transliterar: los t\u00edtulos en cir\u00edlico siguen sin
       dar se\u00f1ales al motor determinista, y eso es lo correcto. Esas filas deben
       ir a Fase 2, no provocar reglas gen\u00e9ricas que se lleven medio cat\u00e1logo. */
    .normalize("NFKD").replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .replace(/[^a-z0-9ñ\s]/g, " ")
    .replace(/\s+/g, " ")
    .trim();
}

/** Palabras que no discriminan nada: si se exigen, hunden consultas normales. */
const VACIAS_BUSQUEDA = {
  de: 1, la: 1, el: 1, los: 1, las: 1, un: 1, una: 1, unos: 1, unas: 1, y: 1, o: 1,
  en: 1, con: 1, por: 1, para: 1, del: 1, al: 1, que: 1, se: 1, su: 1, sus: 1,
  como: 1, mas: 1, the: 1, of: 1, to: 1, and: 1, in: 1, for: 1, a: 1
};

function terminosDeBusqueda(query) {
  const crudos = normalizarBusqueda(query).split(" ").filter(Boolean);
  const utiles = crudos.filter(p => p.length >= 2 && !VACIAS_BUSQUEDA[p]);
  // Si la consulta era toda palabras vacías ("de la"), se respeta lo que escribió
  // en vez de devolver el catálogo entero.
  return utiles.length ? utiles : crudos;
}

/**
 * Recorta un pasaje alrededor de la primera coincidencia, para que la tarjeta
 * muestre POR QUÉ salió ese video y no un resumen genérico idéntico en todas.
 */
function fragmentoDestacado(texto, terminos, largo = 180) {
  const original = (texto || "").toString();
  if (!original) return "";
  const plano = normalizarBusqueda(original);
  let pos = -1;
  for (let i = 0; i < terminos.length && pos === -1; i++) pos = plano.indexOf(terminos[i]);
  if (pos === -1) return original.slice(0, largo);

  // El índice del texto normalizado no coincide con el original cuando hay
  // signos; se aproxima por proporción y se corta en un espacio.
  const razon = original.length / Math.max(plano.length, 1);
  let inicio = Math.max(0, Math.round(pos * razon) - Math.round(largo / 3));
  if (inicio > 0) {
    const esp = original.indexOf(" ", inicio);
    if (esp !== -1 && esp - inicio < 20) inicio = esp + 1;
  }
  const trozo = original.slice(inicio, inicio + largo).trim();
  return (inicio > 0 ? "…" : "") + trozo + (inicio + largo < original.length ? "…" : "");
}

/**
 * Un solo sitio decide si una fila pasa los filtros activos, para que la
 * búsqueda literal, la semántica y el listado del catálogo no puedan discrepar.
 * Acepta los nombres antiguos (dominio/subcategoria) porque siguen viajando en
 * enlaces compartidos.
 */
function filaPasaPrefiltro(r, filtros) {
  const f = filtros || {};
  const eco = f.ecosistema || f.dominio || "";
  const area = f.area || f.subcategoria || "";
  if (eco && ((r[IDX.ECOSISTEMA] || SIN_CLASIFICAR).toString().trim() !== eco)) return false;
  if (area && ((r[IDX.AREA] || SIN_CLASIFICAR).toString().trim() !== area)) return false;
  if (f.tema && (r[IDX.TEMA] || "").toString().trim() !== f.tema) return false;
  if (f.version && (r[IDX.VERSION] || "").toString().trim() !== f.version) return false;
  if (f.dificultad && (r[IDX.DIFICULTAD] || "").toString().trim() !== f.dificultad) return false;
  if (f.fuente && (r[IDX.FUENTE] || deducirFuenteDesdeUrl(r[IDX.URL])) !== f.fuente) return false;
  if (f.moduloId && (r[IDX.MODULO] || "").toString().trim() !== f.moduloId) return false;
  /* [v2] Las facetas TAMBIÉN aquí. Sin esto el portal filtra bien mientras la
     caja de búsqueda está vacía y deja de filtrar en cuanto se escriben tres
     letras, porque a partir de ahí manda este prefiltro y no el del catálogo.
     El usuario ve cómo sus filtros se evaporan al buscar y no entiende por qué. */
  if (f.herramienta && (r[IDX.HERRAMIENTA] || "").toString().trim() !== f.herramienta) return false;
  if (f.industria && (r[IDX.INDUSTRIA] || "").toString().trim() !== f.industria) return false;
  if (f.jurisdiccion && (r[IDX.JURISDICCION] || "").toString().trim() !== f.jurisdiccion) return false;
  if (f.alcance && (r[IDX.ALCANCE] || "").toString().trim() !== f.alcance) return false;
  if (f.tipoContenido && (r[IDX.TIPO_CONTENIDO] || "").toString().trim() !== f.tipoContenido) return false;
  return true;
}

/**
 * Búsqueda literal sobre el catálogo. Sin API Key, sin índice vectorial, sin
 * cuota: solo la hoja. Es el modo básico y siempre está disponible.
 *
 * No es un `indexOf` sobre el título: pondera por campo (un término en el título
 * vale más que en el resumen), exige que aparezcan la mayoría de los términos —
 * si no, "odoo inventario" devolvería los 200 videos que dicen "odoo" — y premia
 * la frase exacta.
 *
 * @param {string} query     texto escrito por la persona
 * @param {number} topN      máximo de resultados
 * @param {Object} prefiltro dominio/subcategoria/version/dificultad/moduloId
 * @return {Array<Object>}   resultados con `score` y `fragmentoRelevante`
 */
function buscarLexicoCatalogo(query, topN = 10, prefiltro = null) {
  const terminos = terminosDeBusqueda(query);
  if (terminos.length === 0) return [];
  const frase = normalizarBusqueda(query);
  const f = prefiltro || {};

  // Peso por campo: dónde aparece el término importa más que cuántas veces.
  const CAMPOS = [
    { idx: IDX.TITULO,     peso: 5.0 },
    { idx: IDX.TAGS,       peso: 2.5 },
    { idx: IDX.RESUMEN,    peso: 2.0 },
    { idx: IDX.TEMA,       peso: 1.6 },   // el nivel más específico de la jerarquía
    { idx: IDX.AREA,       peso: 1.2 },
    { idx: IDX.ECOSISTEMA, peso: 1.0 },
    { idx: IDX.CANAL,      peso: 0.6 },
    { idx: IDX.JUSTIF_DIF, peso: 0.5 }
  ];
  const pesoTotal = CAMPOS.reduce((s, c) => s + c.peso, 0);
  // Se exige la mayoría de los términos, no todos: quien escribe cinco palabras
  // rara vez acierta las cinco que están en la ficha.
  const minTerminos = terminos.length <= 2 ? terminos.length : Math.ceil(terminos.length * 0.6);

  const resultados = [];
  iterarCatalogoPorBloques(function (datos) {
    datos.forEach(r => {
      if (!r[IDX.URL] || !r[IDX.TITULO]) return;
      if (!filaPasaPrefiltro(r, f)) return;

      const planos = CAMPOS.map(c => normalizarBusqueda(r[c.idx]));
      let puntos = 0;
      let encontrados = 0;

      terminos.forEach(term => {
        let mejor = 0;
        for (let i = 0; i < CAMPOS.length; i++) {
          const campo = planos[i];
          if (!campo) continue;
          if (campo.indexOf(term) === -1) continue;
          // Palabra completa vale más que coincidencia dentro de otra palabra:
          // "factura" no debería puntuar igual en "facturación" que en "prefactura".
          const completa = new RegExp("(^| )" + term + "( |$)").test(campo);
          mejor = Math.max(mejor, CAMPOS[i].peso * (completa ? 1 : 0.55));
        }
        if (mejor > 0) { encontrados++; puntos += mejor; }
      });

      if (encontrados < minTerminos) return;

      // La frase completa en el título es la señal más fuerte que existe.
      if (terminos.length > 1) {
        if (planos[0].indexOf(frase) !== -1) puntos += 6;
        else if (planos[2].indexOf(frase) !== -1) puntos += 2.5;
      }
      // Cobertura: haber encontrado 3 de 3 pesa más que 3 de 5.
      puntos *= (encontrados / terminos.length);

      resultados.push({
        id: (r[IDX.ID] || "").toString().trim(),
        titulo: r[IDX.TITULO],
        resumen: r[IDX.RESUMEN] || "",
        url: r[IDX.URL],
        duracion: parseFloat(r[IDX.DURACION]) || 0,
        dificultad: r[IDX.DIFICULTAD] || "Principiante",
        driveIdText: r[IDX.DRIVE_RAG] || "",
        ecosistema: r[IDX.ECOSISTEMA] || SIN_CLASIFICAR,
        area: r[IDX.AREA] || SIN_CLASIFICAR,
        tema: (r[IDX.TEMA] || "").toString().trim(),
        fuente: r[IDX.FUENTE] || deducirFuenteDesdeUrl(r[IDX.URL]),
        dominio: r[IDX.ECOSISTEMA] || "",
        moduloId: (r[IDX.MODULO] || "").toString().trim(),
        fragmentoRelevante: fragmentoDestacado(r[IDX.RESUMEN] || r[IDX.TAGS], terminos),
        // Normalizado a 0-1 para poder mezclarlo con la similitud del coseno.
        score: Number(Math.min(1, puntos / (pesoTotal * 0.8)).toFixed(4)),
        origen: "literal"
      });
    });
    return false;
  });

  return resultados.sort((a, b) => b.score - a.score).slice(0, topN);
}

/**
 * Búsqueda para el portal, en DOS NIVELES:
 *
 *   básico    — literal sobre la hoja. Siempre funciona: no necesita API Key,
 *               ni índice vectorial, ni cuota. Es el piso garantizado.
 *   avanzado  — semántica híbrida (catálogo + fragmentos RAG) cuando hay API Key
 *               de Gemini y contenido indexado. Encuentra por significado.
 *
 * Los dos se combinan cuando ambos están: lo que aparece por las dos vías sube,
 * y lo que solo encontró una vía sigue apareciendo. Que falte la IA nunca deja
 * a nadie sin buscar — antes devolvía un error y la persona se quedaba mirando
 * un catálogo que sí contenía lo que buscaba.
 */
function buscarSemanticoWeb(token, query, filtros) {
  validarTokenConScope(token, "read_only");

  const texto = (query || "").toString().trim();
  const prefiltro = filtros || null;
  if (texto.length === 0) {
    return { status: "success", modo: "literal", query: texto, results: [], total: 0 };
  }

  // Nivel básico. Se ejecuta siempre y primero: si la parte de IA falla o tarda,
  // ya hay resultados que devolver.
  let literales = [];
  try {
    literales = buscarLexicoCatalogo(texto, 12, prefiltro);
  } catch (e) {
    logError("Búsqueda", "Fallo la búsqueda literal: " + e.message);
  }

  // ¿Está disponible el nivel avanzado?
  let motivoSinIA = "";
  if (!proveedorApiKey("GEMINI")) {
    motivoSinIA = t("err_busqueda_sin_ia");
  } else {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const emb = ss.getSheetByName("_Embeddings");
    const chunks = ss.getSheetByName("_Embeddings_Chunks");
    const hayIndice = (emb && emb.getLastRow() >= 2) || (chunks && chunks.getLastRow() >= 2);
    if (!hayIndice) motivoSinIA = t("err_busqueda_sin_indice");
  }

  if (motivoSinIA) {
    return {
      status: "success", modo: "literal", query: texto,
      results: literales, total: literales.length,
      avisoIA: motivoSinIA
    };
  }

  let semanticos = [];
  try {
    semanticos = busquedaSemanticaHibrida(texto, 12, prefiltro);
  } catch (e) {
    // La IA cayó (cuota, red, clave revocada). No es motivo para no buscar: se
    // devuelve el nivel básico y se dice por qué no hubo significado.
    logError("Búsqueda", "Semántica no disponible: " + e.message);
    return {
      status: "success", modo: "literal", query: texto,
      results: literales, total: literales.length,
      avisoIA: t("err_busqueda_degradada", { detalle: e.message })
    };
  }

  return {
    status: "success", modo: "mixta", query: texto,
    results: fusionarResultadosBusqueda(literales, semanticos, 12),
    total: null
  };
}

/**
 * Mezcla los dos niveles en una sola lista. El puntaje literal y la similitud del
 * coseno no son la misma escala, así que no se suman a ciegas: cada lista aporta
 * su posición relativa y coincidir en ambas es lo que de verdad promociona.
 */
function fusionarResultadosBusqueda(literales, semanticos, topN = 12) {
  const indice = {};

  semanticos.forEach(r => {
    const id = (r.id || "").toString();
    if (!id) return;
    indice[id] = Object.assign({}, r, {
      origen: "semantica",
      scoreFinal: (r.score || r.similitudCatalogo || 0) * 0.62
    });
  });

  literales.forEach(r => {
    const id = (r.id || "").toString();
    if (!id) return;
    if (indice[id]) {
      indice[id].origen = "ambas";
      indice[id].scoreFinal += r.score * 0.38 + 0.12;   // aparecer en las dos es la mejor señal
      if (!indice[id].fragmentoRelevante) indice[id].fragmentoRelevante = r.fragmentoRelevante;
    } else {
      indice[id] = Object.assign({}, r, { scoreFinal: r.score * 0.38 });
    }
  });

  return Object.keys(indice)
    .map(k => indice[k])
    .sort((a, b) => b.scoreFinal - a.scoreFinal)
    .slice(0, topN)
    .map(r => Object.assign({}, r, { score: Number((r.scoreFinal || 0).toFixed(4)) }));
}

// -------------------------------------------------------------------------------------
// 7.2 [MEJORA 14] Chunking semántico vectorial de documentos RAG
// -------------------------------------------------------------------------------------

function obtenerHojaChunks() {
  return asegurarHojaSistema("_Embeddings_Chunks");
}

/**
 * [F0-7] Fragmenta un documento en ventanas solapadas y genera un embedding por fragmento.
 * Ventana 250 palabras / paso 200 (solapamiento de 50). Cada fragmento hereda el segundo
 * de inicio de su primera palabra, lo que permite citar el minuto exacto más adelante.
 */
function indexarDocumentoPorFragmentos(videoId, textoCompleto, driveIdOrigen = "", segmentos = null) {
  exigirOrigenInterno("indexarDocumentoPorFragmentos");
  if (!textoCompleto || !textoCompleto.toString().trim()) return 0;
  const sheet = obtenerHojaChunks();
  eliminarChunksDeVideo(videoId, sheet);

  // Índice palabra → segundo, construido a partir de los segmentos con tiempo.
  const segs = Array.isArray(segmentos) ? segmentos : [];
  const tiempoPorPalabra = [];
  if (segs.length > 0) {
    segs.forEach(s => {
      const n = (s.texto || "").split(/\s+/).filter(Boolean).length;
      for (let k = 0; k < n; k++) tiempoPorPalabra.push(s.t || 0);
    });
  }

  // 1) Se trocea primero, sin tocar la red.
  const words = textoCompleto.toString().split(/\s+/).filter(Boolean);
  const fragmentos = [];
  for (let i = 0; i < words.length; i += CHUNK_PASO_PALABRAS) {
    const chunkText = words.slice(i, i + CHUNK_VENTANA_PALABRAS).join(" ");
    if (chunkText.length < CHUNK_MIN_CARACTERES) continue;
    fragmentos.push({ texto: chunkText, segundo: tiempoPorPalabra.length > i ? tiempoPorPalabra[i] : 0 });
  }
  if (fragmentos.length === 0) return 0;

  // 2) [OPT-3] Todos los vectores en una sola petición por cada 100 fragmentos.
  let vectores;
  try {
    vectores = generarEmbeddingsLote(fragmentos.map(f => f.texto));
  } catch (e) {
    logWarn("Chunking", `No se pudo vectorizar ${videoId}: ${e.message}`);
    return 0;
  }

  // 3) Escritura en bloques de 50 filas.
  const filas = [];
  let numChunk = 0;
  let fallidos = 0;

  fragmentos.forEach((f, i) => {
    if (!vectores[i]) { fallidos++; return; }
    filas.push([videoId, numChunk, f.texto.slice(0, 900), JSON.stringify(vectores[i]),
      driveIdOrigen, f.segundo, new Date()]);
    numChunk++;
    if (filas.length >= 50) {
      sheet.getRange(sheet.getLastRow() + 1, 1, filas.length, 7).setValues(filas);
      filas.length = 0;
    }
  });

  if (filas.length > 0) sheet.getRange(sheet.getLastRow() + 1, 1, filas.length, 7).setValues(filas);
  logInfo("Chunking", `Documento ${videoId} indexado en ${numChunk} fragmentos` +
    `${segs.length ? " con marcas de tiempo" : ""}${fallidos ? ` (${fallidos} sin vector)` : ""}.`);
  return numChunk;
}

/**
 * Devuelve los fragmentos de un video con su segundo, listos para alimentar
 * al generador de preguntas del módulo.
 */
function obtenerFragmentosConTiempo(videoId, maxFragmentos = 40) {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("_Embeddings_Chunks");
  if (!sheet || sheet.getLastRow() < 2) return [];
  const datos = sheet.getRange(2, 1, sheet.getLastRow() - 1, 6).getValues();
  return datos
    .filter(f => (f[0] || "").toString().trim() === (videoId || "").toString().trim())
    .slice(0, maxFragmentos)
    .map(f => ({ chunk: f[1], texto: f[2], segundo: Number(f[5]) || 0 }));
}

function eliminarChunksDeVideo(videoId, sheetOpcional) {
  exigirOrigenInterno("eliminarChunksDeVideo");
  const sheet = sheetOpcional || obtenerHojaChunks();
  if (sheet.getLastRow() < 2) return 0;
  const ids = sheet.getRange(2, 1, sheet.getLastRow() - 1, 1).getValues();
  let eliminados = 0;
  for (let i = ids.length - 1; i >= 0; i--) {
    if ((ids[i][0] || "").toString().trim() === videoId) {
      sheet.deleteRow(i + 2);
      eliminados++;
    }
  }
  return eliminados;
}

/**
 * Indexa por fragmentos los documentos RAG pendientes del catálogo (lote controlado).
 */
function indexarFragmentosCatalogo(silencioso = false) {
  /* [6.24] Guarda de acción de panel. El puente comprueba que el nombre esté en
     su lista, pero la lista no impide llamar a la función POR SU NOMBRE: en Apps
     Script toda función global es alcanzable desde `google.script.run`, tenga o
     no un botón. Proteger solo el puente dejaba las 121 acciones abiertas de par
     en par. Pasa desde el menú y desde los paneles (hay hoja delante) y desde
     los disparadores (marcan origen); no pasa desde el portal. */
  exigirOrigenInterno("indexarFragmentosCatalogo");
  const sheet = obtenerHojaChunks();
  const inicioMs = Date.now();
  const yaIndexados = {};
  if (sheet.getLastRow() >= 2) {
    sheet.getRange(2, 1, sheet.getLastRow() - 1, 1).getValues().forEach(r => {
      if (r[0]) yaIndexados[r[0].toString().trim()] = true;
    });
  }

  let docs = 0;
  let chunks = 0;
  let restantes = 0;
  let fallo = "";

  iterarCatalogoPorBloques(function (datos) {
    for (let i = 0; i < datos.length; i++) {
      const id = (datos[i][IDX.ID] || "").toString().trim();
      const driveId = (datos[i][IDX.DRIVE_RAG] || "").toString().trim();
      if (!id || !driveId || yaIndexados[id]) continue;
      if (!filaAdmiteTranscripcion(datos[i])) continue;

      // [OPT-8] Corte por lote Y por presupuesto: lo que sobra se cuenta, no se pierde.
      if (docs >= LOTE_MAX_CHUNKS_DOCS || Date.now() - inicioMs > PRESUPUESTO_EJECUCION_MS || fallo) {
        restantes++;
        continue;
      }

      const texto = recuperarTextoPesado_(driveId);
      if (!texto || texto.indexOf("[Error al leer archivo RAG") === 0) continue;

      try {
        chunks += indexarDocumentoPorFragmentos(id, texto, driveId, recuperarSegmentosRAG_(driveId));
        yaIndexados[id] = true;
        docs++;
      } catch (e) {
        // Cuota agotada o API caída: se corta limpio y se difiere el resto.
        fallo = e.message;
        restantes++;
        logWarn("Chunking", `Indexado interrumpido en ${id}: ${e.message}`);
      }
    }
    return false;
  });

  if (fallo) encolarTareaDiferida("chunks_catalogo", {}, fallo);

  if (!silencioso) notificarUsuario(t("toast_chunks", { chunks: chunks, docs: docs }), "RAG", 5);
  return { docs: docs, chunks: chunks, restantes: restantes };
}

/** Búsqueda sobre fragmentos RAG (alta precisión dentro del contenido). */
function busquedaSemanticaPorFragmentos(query, topK = 5, idsPermitidos = null, umbral = null) {
  const minSim = resolverUmbralSimilitud(umbral, "UMBRAL_SIM_FRAGMENTO", UMBRAL_SIMILITUD_FRAGMENTO);
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("_Embeddings_Chunks");
  if (!sheet || sheet.getLastRow() < 2) return [];

  // [OPT-9] Conjunto de videos admisibles: descarta fragmentos antes de parsear el vector.
  const permitidos = Array.isArray(idsPermitidos) && idsPermitidos.length > 0
    ? idsPermitidos.reduce((acc, id) => { acc[id.toString().trim()] = true; return acc; }, {})
    : null;

  const queryEmb = generarEmbeddingConsulta(query);
  const resultados = [];
  const totalFilas = sheet.getLastRow() - 1;

  for (let inicio = 2; inicio <= totalFilas + 1; inicio += BATCH_TAMANO_BLOQUE) {
    const num = Math.min(BATCH_TAMANO_BLOQUE, totalFilas + 1 - inicio + 1);
    if (num <= 0) break;
    const bloque = sheet.getRange(inicio, 1, num, 6).getValues();
    bloque.forEach(f => {
      const vid = (f[0] || "").toString().trim();
      if (permitidos && !permitidos[vid]) return;
      try {
        const sim = cosenoSimilitud(queryEmb, JSON.parse(f[3]));
        if (sim > minSim) {
          resultados.push({
            id: f[0], chunk: f[1], fragmento: f[2], driveId: f[4] || "",
            segundo: Number(f[5]) || 0,
            similitud: Number(sim.toFixed(4)), origen: "fragmento"
          });
        }
      } catch (e) { /* vector corrupto */ }
    });
  }
  return resultados.sort((a, b) => b.similitud - a.similitud).slice(0, topK);
}

/**
 * [MEJORA 14] Búsqueda híbrida: combina similitud de catálogo (títulos/resúmenes/tags)
 * con la similitud de fragmentos RAG, enriqueciendo cada resultado con su mejor pasaje.
 */
/**
 * [OPT-18] Resuelve el umbral efectivo: parámetro explícito > ScriptProperty >
 * constante. En catálogos grandes, un 0.10 fijo deja pasar resultados que solo
 * comparten vocabulario genérico; poder subirlo sin editar el código importa.
 */
function resolverUmbralSimilitud(explicito, propiedad, porDefecto) {
  const dado = parseFloat(explicito);
  if (!isNaN(dado) && dado >= 0 && dado <= 1) return dado;
  try {
    const guardado = parseFloat(PropertiesService.getScriptProperties().getProperty(propiedad));
    if (!isNaN(guardado) && guardado >= 0 && guardado <= 1) return guardado;
  } catch (e) { /* sin propiedades */ }
  return porDefecto;
}

/** Ajusta los umbrales de búsqueda desde el menú. */
function configurarUmbralesBusqueda() {
  exigirOrigenInterno("configurarUmbralesBusqueda");
  const ui = SpreadsheetApp.getUi();
  const props = PropertiesService.getScriptProperties();
  const actualCat = resolverUmbralSimilitud(null, "UMBRAL_SIM_CATALOGO", UMBRAL_SIMILITUD_CATALOGO);
  const actualFrag = resolverUmbralSimilitud(null, "UMBRAL_SIM_FRAGMENTO", UMBRAL_SIMILITUD_FRAGMENTO);

  const rCat = ui.prompt("Umbral de similitud · Catálogo",
    `Actual: ${actualCat}\n\nEntre 0 y 1. Más alto = menos resultados pero más pertinentes.\n` +
    "Vacío restablece el valor por defecto (" + UMBRAL_SIMILITUD_CATALOGO + "):", ui.ButtonSet.OK_CANCEL);
  if (rCat.getSelectedButton() !== ui.Button.OK) return;
  const vCat = rCat.getResponseText().trim();
  if (vCat) props.setProperty("UMBRAL_SIM_CATALOGO", vCat); else props.deleteProperty("UMBRAL_SIM_CATALOGO");

  const rFrag = ui.prompt("Umbral de similitud · Fragmentos RAG",
    `Actual: ${actualFrag}\n\nVacío restablece el valor por defecto (${UMBRAL_SIMILITUD_FRAGMENTO}):`,
    ui.ButtonSet.OK_CANCEL);
  if (rFrag.getSelectedButton() === ui.Button.OK) {
    const vFrag = rFrag.getResponseText().trim();
    if (vFrag) props.setProperty("UMBRAL_SIM_FRAGMENTO", vFrag); else props.deleteProperty("UMBRAL_SIM_FRAGMENTO");
  }

  notificarUsuario(
    `Umbrales: catálogo ${resolverUmbralSimilitud(null, "UMBRAL_SIM_CATALOGO", UMBRAL_SIMILITUD_CATALOGO)} · ` +
    `fragmentos ${resolverUmbralSimilitud(null, "UMBRAL_SIM_FRAGMENTO", UMBRAL_SIMILITUD_FRAGMENTO)}`, "Búsqueda", 5);
}

function busquedaSemanticaHibrida(query, topN = 10, prefiltro = null, umbral = null) {
  const porCatalogo = buscarPorSimilitudCoseno(query, topN * 2, prefiltro, umbral);
  let porFragmentos = [];
  try {
    // [OPT-9] Los fragmentos se restringen a los videos que sobrevivieron al
    // prefiltro: sin esto, acotar por dominio no ahorraba nada en la mitad cara.
    const ids = prefiltro ? porCatalogo.map(r => r.id) : null;
    porFragmentos = busquedaSemanticaPorFragmentos(query, topN * 2, ids, umbral);
  } catch (e) {
    logWarn("Búsqueda", "Fragmentos no disponibles: " + e.message);
  }

  const mejorFragmento = {};
  porFragmentos.forEach(f => {
    const id = (f.id || "").toString();
    if (!mejorFragmento[id] || f.similitud > mejorFragmento[id].similitud) mejorFragmento[id] = f;
  });

  const indice = {};
  porCatalogo.forEach(r => {
    const frag = mejorFragmento[r.id];
    indice[r.id] = {
      id: r.id, titulo: r.titulo, resumen: r.resumen, url: r.url,
      duracion: r.duracion, dificultad: r.dificultad, driveIdText: r.driveIdText,
      similitudCatalogo: r.similitud,
      similitudFragmento: frag ? frag.similitud : 0,
      fragmentoRelevante: frag ? frag.fragmento : "",
      segundo: frag ? (frag.segundo || 0) : 0,
      urlConSegundo: frag && frag.segundo ? construirEnlaceConSegundo(r.url, frag.segundo) : r.url,
      score: Number((r.similitud * 0.55 + (frag ? frag.similitud : 0) * 0.45).toFixed(4))
    };
  });

  // Fragmentos cuyo video no salió en la búsqueda de catálogo.
  Object.keys(mejorFragmento).forEach(id => {
    if (indice[id]) return;
    const frag = mejorFragmento[id];
    indice[id] = {
      id: id, titulo: "(Contenido RAG " + id + ")", resumen: frag.fragmento.slice(0, 180),
      url: "", duracion: 0, dificultad: "", driveIdText: frag.driveId,
      similitudCatalogo: 0, similitudFragmento: frag.similitud,
      fragmentoRelevante: frag.fragmento, score: Number((frag.similitud * 0.45).toFixed(4))
    };
  });

  return Object.keys(indice).map(k => indice[k]).sort((a, b) => b.score - a.score).slice(0, topN);
}

/** Búsqueda semántica desde el menú, con diálogo de resultados. */
function buscarSemanticoUI() {
  exigirOrigenInterno("buscarSemanticoUI");
  const ui = SpreadsheetApp.getUi();
  const resp = ui.prompt("🔎 Búsqueda Semántica Híbrida", "Escribe tu consulta técnica:", ui.ButtonSet.OK_CANCEL);
  if (resp.getSelectedButton() !== ui.Button.OK) return;
  const query = resp.getResponseText().trim();
  if (!query) return;

  try {
    const res = busquedaSemanticaHibrida(query, 8);
    if (res.length === 0) { ui.alert("Sin coincidencias semánticas. Genera embeddings del catálogo primero."); return; }
    const texto = res.map((r, i) =>
      `${i + 1}. [${r.score}] ${r.titulo}\n   ${(r.fragmentoRelevante || r.resumen || "").toString().slice(0, 160)}…`
    ).join("\n\n");
    ui.alert("Resultados para: " + query, texto, ui.ButtonSet.OK);
  } catch (e) {
    ui.alert("Error de búsqueda", e.message, ui.ButtonSet.OK);
  }
}

