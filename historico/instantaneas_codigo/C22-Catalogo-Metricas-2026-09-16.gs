  ejecutar(() => assertIgual(detectarVersion("Implementación en Odoo 20 DIAN 2026"), "v20", "Detección de versión"));
  ejecutar(() => assertIgual(convertirDuracionAMinutos("PT1H30M30S"), 90.5, "Conversión ISO 8601 → minutos"));

  ejecutar(function () {
