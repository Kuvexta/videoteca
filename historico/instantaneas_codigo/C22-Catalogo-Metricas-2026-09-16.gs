// 9B.2 Generación y validación del banco certificable
// -------------------------------------------------------------------------------------

/** Reúne el contenido de estudio del módulo con marcas de tiempo cuando existan. */
function construirContextoModulo(moduloId, maxCaracteres = 18000) {
  const fuentes = listarFuentesModulo(moduloId);
  const bloques = [];
  const descripcionFuentes = [];

  fuentes.forEach(f => {
    const cat = buscarFilaCatalogoPorId(f.videoId);
    const titulo = cat ? (cat.fila[IDX.TITULO] || "").toString() : f.videoId;
    const driveId = cat ? (cat.fila[IDX.DRIVE_RAG] || "").toString().trim() : "";
    descripcionFuentes.push(`- ${f.identificador} · ${f.tema || titulo} · ${f.preguntas} preguntas` +
      (f.alcance ? ` · alcance ${f.alcance}` : ""));

    const fragmentos = obtenerFragmentosConTiempo(f.videoId, 30);
    if (fragmentos.length > 0) {
      bloques.push(`### ${f.identificador} — ${titulo}\n` +
        fragmentos.map(fr => `[${formatearSegundos(fr.segundo)} = ${fr.segundo}s] ${fr.texto}`).join("\n"));
      return;
    }

    const segs = driveId ? recuperarSegmentosRAG_(driveId) : [];
    if (segs.length > 0) {
      const muestra = [];
      for (let i = 0; i < segs.length; i += Math.max(1, Math.floor(segs.length / 40))) {
        muestra.push(`[${formatearSegundos(segs[i].t)} = ${segs[i].t}s] ${segs[i].texto}`);
      }
      bloques.push(`### ${f.identificador} — ${titulo}\n` + muestra.join("\n"));
      return;
    }

    const texto = driveId ? recuperarTextoPesado_(driveId) : "";
    bloques.push(`### ${f.identificador} — ${titulo}\n` +
      (texto && texto.indexOf("[Error al leer") !== 0 ? texto.slice(0, 6000) : (cat ? (cat.fila[IDX.RESUMEN] || "") : "")));
  });

  return {
    fuentes: descripcionFuentes.join("\n"),
    texto: bloques.join("\n\n").slice(0, maxCaracteres),
    totalFuentes: fuentes.length
  };
}

/**
 * [F2-1] Validación dura del banco generado. Devuelve {ok, motivos[]}.
 * El generador antiguo aceptaba cualquier JSON con un arreglo no vacío.
 */
function validarBancoGenerado(preguntas, modulo) {
  const motivos = [];
  if (!Array.isArray(preguntas) || preguntas.length === 0) {
    return { ok: false, motivos: ["no se devolvió ninguna pregunta"] };
  }

  const prohibidas = ["todas las anteriores", "ninguna de las anteriores", "todas las opciones", "ninguna de las opciones"];
  let trampas = 0;
  const fuentesValidas = {};
  listarFuentesModulo(modulo.id).forEach(f => { fuentesValidas[f.identificador] = f; });

  preguntas.forEach((p, i) => {
    const n = i + 1;
    const ops = Array.isArray(p.opciones) ? p.opciones : [];
    if (ops.length !== 4) motivos.push(`pregunta ${n}: ${ops.length} opciones (deben ser 4)`);
    ops.forEach(o => {
      const txt = (o || "").toString().toLowerCase();
      if (prohibidas.some(pr => txt.indexOf(pr) !== -1)) motivos.push(`pregunta ${n}: usa un comodín prohibido`);
    });
    const correcta = parseInt(p.correcta, 10);
    if (isNaN(correcta) || correcta < 0 || correcta >= ops.length) motivos.push(`pregunta ${n}: índice correcto inválido`);
    if (!p.causa_raiz) motivos.push(`pregunta ${n}: falta causa_raiz`);
    if (!p.riesgo_operativo) motivos.push(`pregunta ${n}: falta riesgo_operativo`);
    if (!p.configuracion_correcta) motivos.push(`pregunta ${n}: falta configuracion_correcta`);

    if (p.es_trampa_ia) {
      const cebo = parseInt(p.indice_cebo_ia, 10);
      if (isNaN(cebo) || cebo < 0 || cebo >= ops.length) motivos.push(`pregunta ${n}: cebo de IA inválido`);
      else if (cebo === correcta) motivos.push(`pregunta ${n}: el cebo coincide con la respuesta correcta`);
      if (TIPOS_TRAMPA.indexOf((p.tipo_trampa || "").toString()) === -1) motivos.push(`pregunta ${n}: tipo_trampa desconocido`);

      // [OPT-14] El ratio mínimo cuenta trampas UTILIZABLES, no reactivos que
      // dicen serlo. Antes, un banco donde la IA marcaba es_trampa_ia sin cebo
      // válido podía superar el umbral del 35% con trampas inertes.
      if (resolverTrampa(true, p.indice_cebo_ia, correcta, ops, p.tipo || "multiple", p.tipo_trampa).esTrampa) {
        trampas++;
      }
    }

    // El segundo citado debe caber dentro del alcance declarado de su fuente.
    const f = fuentesValidas[(p.fuente || "").toString()];
    const seg = convertirTimestampASegundos(p.video_segundo);
    if (f && f.alcance && seg > 0) {
      const partes = f.alcance.split("-");
      if (partes.length === 2) {
        const fin = convertirTimestampASegundos(partes[1]);
        if (fin > 0 && seg > fin + 30) motivos.push(`pregunta ${n}: el segundo ${seg} excede el alcance de ${f.identificador}`);
      }
    }
  });

  const ratio = trampas / preguntas.length;
  if (ratio < (modulo.ratioTrampas || MODULO_RATIO_MIN_TRAMPAS)) {
    motivos.push(`solo ${(ratio * 100).toFixed(0)}% de trampas anti-IA utilizables ` +
      `(mínimo ${((modulo.ratioTrampas || MODULO_RATIO_MIN_TRAMPAS) * 100).toFixed(0)}%)`);
  }

  return { ok: motivos.length === 0, motivos: motivos, trampas: trampas };
}

/**
 * Genera el banco certificable del módulo. Las preguntas entran como
 * GENERADA / BORRADOR: una persona debe validarlas antes de que certifiquen.
 */
function generarBancoModulo(moduloId, reemplazar = true) {
  exigirOrigenInterno("generarBancoModulo");
  const modulo = obtenerModulo(moduloId);
  if (!modulo) throw new Error(t("err_modulo_no_existe", { modulo: moduloId }));

  const fuentes = listarFuentesModulo(moduloId);
  if (fuentes.length === 0) throw new Error(t("alert_modulo_sin_videos", { modulo: moduloId }));

  const ctx = construirContextoModulo(moduloId);
  const prompt = obtenerPrompt("evaluacion_modulo", {
    modulo: modulo.nombre,
    rol: modulo.rol || "Personal técnico",
    fuentes: ctx.fuentes,
    texto: ctx.texto,
    cantidad: modulo.totalPreguntas,
    porcentaje_trampas: Math.round((modulo.ratioTrampas || MODULO_RATIO_MIN_TRAMPAS) * 100)
  });

  const raw = llamarModeloIA(prompt, obtenerConfigIA().proveedor, 6000);
  const parsed = extraerJsonDesdeTexto(raw);
  if (!parsed || !parsed.preguntas) throw new Error(t("err_json_invalido"));

  const validacion = validarBancoGenerado(parsed.preguntas, modulo);
  if (!validacion.ok) {
    logWarn("Banco", `Validación con observaciones: ${validacion.motivos.slice(0, 5).join("; ")}`);
  }

  if (reemplazar) eliminarClavesDeExamen("mod_" + moduloId);

  const examenId = "mod_" + moduloId;
  const normalizadas = parsed.preguntas.map((p, i) => normalizarPregunta(p, {
    examenId: examenId,
    moduloId: moduloId,
    numero: i + 1,
    fuente: p.fuente || (fuentes[0] ? fuentes[0].identificador : ""),
    videoId: (function () {
      const f = fuentes.filter(x => x.identificador === (p.fuente || "").toString());
      return f.length > 0 ? f[0].videoId : (fuentes[0] ? fuentes[0].videoId : "");
    })(),
    procedencia: PROCEDENCIA.GENERADA,
    validacion: VALIDACION.BORRADOR
  }));

  guardarClavesEnSheet(examenId, "", normalizadas);
  logInfo("Banco", `Banco del módulo ${moduloId}: ${normalizadas.length} preguntas en BORRADOR.`);
  return { preguntas: normalizadas.length, validacion: validacion };
}

function generarBancoModuloUI() {
  const modulos = listarModulos();
  if (modulos.length === 0) { alertarUsuario(t("alert_sin_modulos")); return; }
  const moduloId = solicitarTexto("Generar banco", "Identificador del módulo:\n\n" + modulos.map(m => "• " + m.id).join("\n"));
  if (!moduloId) return;

  try {
    notificarUsuario("Generando banco de preguntas… puede tardar un minuto.", "Banco", 8);
    const res = generarBancoModulo(moduloId, true);
    let msg = t("toast_banco_generado", { preguntas: res.preguntas });
    if (!res.validacion.ok) {
      msg += "\n\n⚠️ Observaciones de validación:\n• " + res.validacion.motivos.slice(0, 8).join("\n• ") +
        "\n\nRevísalas antes de validar el banco.";
    }
    alertarUsuario(msg, "Banco de Preguntas");
  } catch (e) {
    logError("Banco", e.message);
    alertarUsuario("No se pudo generar el banco: " + e.message, "Banco");
  }
}

/** Abre el banco de un módulo para revisión manual y permite promoverlo a VALIDADA. */
function revisarBancoModuloUI() {
  const modulos = listarModulos();
  if (modulos.length === 0) { alertarUsuario(t("alert_sin_modulos")); return; }
  const moduloId = solicitarTexto("Validar banco", "Identificador del módulo:\n\n" + modulos.map(m => "• " + m.id).join("\n"));
  if (!moduloId) return;

  const sheet = obtenerHojaClaves();
  sheet.showSheet();
  sheet.activate();

  const preguntas = leerClavesExamen({ moduloId: moduloId });
  const borradores = preguntas.filter(p => p.validacion === VALIDACION.BORRADOR).length;
  const conTrampa = preguntas.filter(p => p.esTrampa).length;
  const sinSegundo = preguntas.filter(p => !p.segundo).length;

  const resumen =
    `Módulo: ${moduloId}\n` +
    `• Preguntas: ${preguntas.length}\n` +
    `• En borrador: ${borradores}\n` +
    `• Con trampa anti-IA: ${conTrampa} (${preguntas.length ? Math.round(conTrampa / preguntas.length * 100) : 0}%)\n` +
    `• Sin segundo citado: ${sinSegundo}\n\n` +
    `Revisa en la hoja la causa raíz, el riesgo operativo y el caso práctico de cada pregunta.\n\n` +
    `¿Promover TODAS las preguntas de este módulo a VALIDADA?`;

  if (!preguntarUsuario("Validación del banco", resumen, false)) return;

  const validadas = promoverBancoAValidado(moduloId);
  notificarUsuario(t("toast_banco_validado", { validadas: validadas }), "Banco", 5);
}

/** Marca como VALIDADA y CURADA todas las preguntas de un módulo. */
function promoverBancoAValidado(moduloId) {
  exigirOrigenInterno("promoverBancoAValidado");
  const sheet = obtenerHojaClaves();
  if (sheet.getLastRow() < 2) return 0;
  const rango = sheet.getRange(2, 1, sheet.getLastRow() - 1, CABECERAS_CLAVES.length);
  const datos = rango.getValues();
  let validadas = 0;
  for (let i = 0; i < datos.length; i++) {
    if ((datos[i][CLAVE.MODULO] || "").toString().trim() !== moduloId) continue;
    if ((datos[i][CLAVE.VALIDACION] || "").toString() === VALIDACION.RETIRADA) continue;
    datos[i][CLAVE.VALIDACION] = VALIDACION.VALIDADA;
    datos[i][CLAVE.PROCEDENCIA] = PROCEDENCIA.CURADA;
    validadas++;
  }
  if (validadas > 0) {
    rango.setValues(datos);
    invalidarCacheBanco(moduloId);   // el banco cacheado ya no refleja la hoja
    limpiarMemoEjecucion();
  }
  logInfo("Banco", `${validadas} preguntas del módulo ${moduloId} promovidas a VALIDADA.`);
  return validadas;
}

