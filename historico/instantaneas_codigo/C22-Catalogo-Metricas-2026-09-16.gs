function sincronizarCarpetaDriveVideos(tokenAdmin, folderIdPersonalizado = null) {
  validarTokenConScope(tokenAdmin, "admin");
  const props = PropertiesService.getScriptProperties();
  const folderId = folderIdPersonalizado || props.getProperty("CARPETA_RAIZ_ID");
  if (!folderId) throw new Error(t("err_carpeta_no_config"));

  const carpeta = DriveApp.getFolderById(folderId);
  const archivos = carpeta.getFiles();
  const mimesValidos = ["video/mp4", "video/webm", "video/quicktime", "video/x-matroska"];

  const hoja = obtenerHojaDatos();
  const urlsExistentes = {};
  if (hoja.getLastRow() >= 2) {
    hoja.getRange(2, IDX.URL + 1, hoja.getLastRow() - 1, 1).getValues().forEach(r => {
      if (r[0]) urlsExistentes[r[0].toString().trim()] = true;
    });
  }

  const nuevasFilas = [];
  while (archivos.hasNext()) {
    const arch = archivos.next();
    if (mimesValidos.indexOf(arch.getMimeType()) === -1) continue;
    const urlDrive = arch.getUrl();
    if (urlsExistentes[urlDrive]) continue;

    const fila = new Array(TOTAL_COLUMNAS).fill("");
    fila[IDX.URL] = urlDrive;
    fila[IDX.ID] = "drv_" + arch.getId().slice(0, 10);
    fila[IDX.TITULO] = arch.getName().replace(/\.[^/.]+$/, "");
    fila[IDX.RESUMEN] = "Video local en Google Drive.";
    fila[IDX.FUENTE] = "Drive";
    fila[IDX.ECOSISTEMA] = SIN_CLASIFICAR;
    fila[IDX.AREA] = SIN_CLASIFICAR;
    fila[IDX.IDIOMA] = "ES";
    fila[IDX.ESTADO] = "🟡 Pendiente";
    fila[IDX.DIFICULTAD] = "Principiante";
    nuevasFilas.push(fila);
    urlsExistentes[urlDrive] = true;
  }

  if (nuevasFilas.length > 0) {
    hoja.getRange(hoja.getLastRow() + 1, 1, nuevasFilas.length, TOTAL_COLUMNAS).setValues(nuevasFilas);
    logInfo("Drive Sync", `Se incorporaron ${nuevasFilas.length} videos locales.`);
    invalidarCacheAPI();
  }
  return { sincronizados: nuevasFilas.length };
}

function sincronizarDropboxVideos(tokenAdmin, dropboxAccessToken, folderPath = "") {
  validarTokenConScope(tokenAdmin, "admin");
  if (!dropboxAccessToken) throw new Error(t("err_token_proveedor", { proveedor: "Dropbox" }));

  const r = ejecutarFetchSeguro(URL_DROPBOX_LIST, {
    method: "POST",
    headers: { "Authorization": "Bearer " + dropboxAccessToken, "Content-Type": "application/json" },
    payload: JSON.stringify({ path: folderPath === "/" ? "" : folderPath })
  }, "Dropbox");
  if (!r.ok) throw new Error(t("err_api_http", { codigo: r.codigo, servicio: "Dropbox", detalle: r.cuerpo.slice(0, 200) }));

  const json = JSON.parse(r.cuerpo);
  const hoja = obtenerHojaDatos();
  const nuevasFilas = [];

  (json.entries || []).forEach(entry => {
    if (entry[".tag"] !== "file") return;
    if (!/\.(mp4|mov|mkv|webm|avi)$/i.test(entry.name || "")) return;
    const fila = new Array(TOTAL_COLUMNAS).fill("");
    fila[IDX.URL] = "https://www.dropbox.com/home" + entry.path_display;
    fila[IDX.ID] = "dbx_" + entry.id.replace(/[^a-zA-Z0-9]/g, "").slice(-12);
    fila[IDX.TITULO] = entry.name.replace(/\.[^/.]+$/, "");
    fila[IDX.RESUMEN] = "Video alojado en Dropbox.";
    fila[IDX.FUENTE] = "Dropbox";
    fila[IDX.ECOSISTEMA] = SIN_CLASIFICAR;
    fila[IDX.AREA] = SIN_CLASIFICAR;
    fila[IDX.ESTADO] = "🟡 Pendiente";
    fila[IDX.DIFICULTAD] = "Principiante";
    nuevasFilas.push(fila);
  });

  if (nuevasFilas.length > 0) {
    hoja.getRange(hoja.getLastRow() + 1, 1, nuevasFilas.length, TOTAL_COLUMNAS).setValues(nuevasFilas);
    logInfo("Dropbox Sync", `Importados ${nuevasFilas.length} videos.`);
  }
  return { sincronizados: nuevasFilas.length };
}

function sincronizarOneDriveVideos(tokenAdmin, graphAccessToken, folderId = "root") {
