function clasificarDificultadConIA(texto, titulo) {
  const prompt = obtenerPrompt("dificultad", { titulo: titulo, texto: (texto || "").toString().slice(0, 10000) });
  const parsed = extraerJsonDesdeTexto(llamarModeloIA(prompt, obtenerConfigIA().proveedor, 800));
  if (!parsed || !parsed.nivel || !parsed.justificacion) throw new Error(t("err_json_invalido"));
  const niveles = ["Principiante", "Intermedio", "Avanzado"];
  return {
    nivel: niveles.indexOf(parsed.nivel) !== -1 ? parsed.nivel : "Intermedio",
    justificacion: parsed.justificacion.toString().slice(0, 200)
  };
}

function clasificarDificultadLocal(texto, titulo) {
  const contenido = ((texto || "") + " " + (titulo || "")).toString().toLowerCase();
  const avanzadas = ["arquitectura", "desarrollo", "código", "backend", "api", "json", "postgresql", "token", "servidor", "vlan", "docker", "nginx", "programación", "script", "uuid", "mcp", "endpoint", "oauth", "circuit breaker", "concurrencia", "kubernetes", "xml-rpc"];
  const intermedias = ["configurar", "personalizar", "importar", "exportar", "módulo", "plantilla", "filtro", "fórmula", "automatizar", "flujo", "intermedio", "auditar", "proceso", "validación", "parámetro", "reporte"];
  const principiantes = ["introducción", "qué es", "básico", "principiante", "primeros pasos", "conocer", "navegación", "interfaz", "cómo empezar", "bienvenida", "menú", "guardar", "tutorial inicial"];

  let pA = 0, pI = 0, pP = 0;
  avanzadas.forEach(p => { const m = contenido.match(new RegExp("\\b" + escapeRegExp(p) + "\\b", "g")); if (m) pA += m.length * 3; });
  intermedias.forEach(p => { const m = contenido.match(new RegExp("\\b" + escapeRegExp(p) + "\\b", "g")); if (m) pI += m.length * 2; });
  principiantes.forEach(p => { const m = contenido.match(new RegExp("\\b" + escapeRegExp(p) + "\\b", "g")); if (m) pP += m.length * 1; });

  let nivel = "Principiante";
  let justificacion = "Clasificación heurística local: contenido conceptual introductorio.";
  if (pA > pI && pA > pP) {
    nivel = "Avanzado";
    justificacion = `Algoritmo heurístico: alta densidad técnica (${pA} pts).`;
  } else if (pI >= pA && pI > pP) {
    nivel = "Intermedio";
    justificacion = `Algoritmo heurístico: enfoque funcional y de configuración (${pI} pts).`;
  } else if (pP > 0) {
    justificacion = `Algoritmo heurístico: terminología elemental (${pP} pts).`;
  }
  return { nivel: nivel, justificacion: justificacion };
}

function determinarNivelDificultadYJustificacion(transcripcion, titulo) {
  const texto = `${titulo || ""}\n\n${transcripcion || ""}`;
  try {
    return clasificarDificultadConIA(texto, titulo);
  } catch (error) {
    logWarn("Pedagogía", `IA no disponible para dificultad; heurística local: ${error.message}`);
    return clasificarDificultadLocal(texto, titulo);
  }
}

function actualizarDificultadCatalogo() {
  exigirOrigenInterno("actualizarDificultadCatalogo");
  const hoja = obtenerHojaDatos();
  if (hoja.getLastRow() < 2) { alertarUsuario(t("alert_catalogo_vacio")); return 0; }

  let actualizados = 0;
  iterarCatalogoPorBloques(function (datos) {
    let mutado = false;
    for (let i = 0; i < datos.length; i++) {
      const url = (datos[i][IDX.URL] || "").toString().trim();
      const titulo = (datos[i][IDX.TITULO] || "").toString().trim();
      const idDrive = (datos[i][IDX.DRIVE_RAG] || "").toString().trim();
      const nivelActual = (datos[i][IDX.DIFICULTAD] || "").toString().trim();
      if (!url || (nivelActual && nivelActual !== "🟡 Pendiente")) continue;

      let transcripcion = "";
      if (idDrive) { try { transcripcion = recuperarTextoPesado_(idDrive); } catch (e) { /* sigue */ } }

      const ev = determinarNivelDificultadYJustificacion(transcripcion, titulo);
      datos[i][IDX.DIFICULTAD] = ev.nivel;
      datos[i][IDX.JUSTIF_DIF] = ev.justificacion;
      actualizados++;
      mutado = true;
    }
    return mutado;
  });

  if (actualizados > 0) {
    logInfo("Pedagogía", `Dificultad evaluada en ${actualizados} contenidos.`);
    alertarUsuario(`Se categorizó pedagógicamente el nivel de ${actualizados} videos.`, "✅ Evaluación Completa");
  } else {
    alertarUsuario("Todos los videos cuentan con nivel pedagógico asignado.", "Información");
  }
  return actualizados;
}

