function obtenerCarpetaRaiz() {
  exigirOrigenInterno("obtenerCarpetaRaiz");
  const props = PropertiesService.getScriptProperties();
  const folderId = props.getProperty("CARPETA_RAIZ_ID");
  if (folderId) {
    try { return DriveApp.getFolderById(folderId); } catch (e) {
      logWarn("Drive", "La carpeta raíz configurada no es accesible; se usa la de por defecto.");
    }
  }
  const iter = DriveApp.getFoldersByName("Wiki_Capacitaciones");
  const carpeta = iter.hasNext() ? iter.next() : DriveApp.createFolder("Wiki_Capacitaciones");
  props.setProperty("CARPETA_RAIZ_ID", carpeta.getId());
  return carpeta;
}

function obtenerSubcarpeta(nombre) {
  exigirOrigenInterno("obtenerSubcarpeta");
  const raiz = obtenerCarpetaRaiz();
  const iter = raiz.getFoldersByName(nombre);
  return iter.hasNext() ? iter.next() : raiz.createFolder(nombre);
}

/**
 * Extrae el ID de una carpeta de Drive de lo que sea que haya pegado la persona.
 *
 * El patrón anterior era `[-\w]{25,}`: exigía 25 caracteres seguidos, y eso deja
 * fuera formas legítimas —el ID de una unidad compartida es más corto, y una URL
 * copiada del móvil llega con parámetros o acortada—. Además cualquier tramo
 * largo de la URL podía ganar antes que el ID: en
 * `.../drive/folders/ID?usp=drive_link&authuser=…` el trozo que gana no siempre
 * es el que se busca.
 *
 * Se mira primero dónde DEBE estar el ID —después de `/folders/`, de `/drive/u/N/folders/`
 * o de `id=`— y solo si no aparece se cae al patrón general.
 *
 * @return {string} el ID, o "" si no se reconoce nada.
 */
function extraerIdCarpetaDrive(texto) {
  const bruto = (texto || "").toString().trim();
  if (!bruto) return "";

  const patrones = [
    /\/folders\/([-\w]+)/,          // .../drive/folders/ID  y  .../drive/u/0/folders/ID
    /\/drive\/([-\w]{15,})/,        // enlaces de unidad compartida
    /[?&]id=([-\w]+)/,              // .../open?id=ID
    /^([-\w]{15,})$/                // el ID pegado a secas
  ];
  for (let i = 0; i < patrones.length; i++) {
    const m = bruto.match(patrones[i]);
    if (m && m[1]) return m[1];
  }
  const suelto = bruto.match(/[-\w]{25,}/);
  return suelto ? suelto[0] : "";
}

/**
 * Configura la carpeta raíz de Drive.
 *
 * Guardar el ID sin abrir la carpeta era peor que no guardarlo: `obtenerCarpetaRaiz`
 * atrapa el fallo y se va en silencio a `Wiki_Capacitaciones`, así que los
 * archivos acababan en otro sitio y el mensaje decía que todo había ido bien.
 * Por eso aquí se abre la carpeta ANTES de guardar y se enseña su nombre: es la
 * única confirmación de que es la carpeta que la persona tenía en mente.
 */
function configurarCarpetaRaiz() {
  exigirOrigenInterno("configurarCarpetaRaiz");
  const texto = solicitarTexto("📁 Carpeta Raíz",
    "Pega el ID o la URL de la carpeta de Drive.\n\n" +
    "Sirve el enlace completo (drive.google.com/drive/folders/…) o solo el ID.");
  if (!texto) return;

  const id = extraerIdCarpetaDrive(texto);
  if (!id) {
    alertarUsuario(
      "No se reconoció ningún ID de carpeta en lo que pegaste.\n\n" +
      "Recibí: «" + texto.slice(0, 120) + "»\n\n" +
      "Abre la carpeta en Drive y copia la dirección de la barra del navegador; " +
      "es la parte que va después de /folders/.", "Drive");
    return;
  }

  let carpeta;
  try {
    carpeta = DriveApp.getFolderById(id);
    carpeta.getName();                     // fuerza la lectura: sin esto el fallo llega después
  } catch (e) {
    alertarUsuario(
      "El ID se reconoció, pero esa carpeta no se puede abrir con esta cuenta.\n\n" +
      "ID: " + id + "\n\n" +
      "Comprueba que la carpeta exista y que " +
      "la cuenta que ejecuta el script tenga acceso de edición.", "Drive");
    return;
  }

  PropertiesService.getScriptProperties().setProperty("CARPETA_RAIZ_ID", id);
  logInfo("Drive", "Carpeta raíz configurada: " + id + " (" + carpeta.getName() + ")");
  alertarUsuario("Carpeta raíz guardada:\n\n📁 " + carpeta.getName(), "Drive");
}

/**
 * [F0-7] Persiste texto denso en Drive. Admite segmentos con marca de tiempo:
 * segmentos = [{t: 474, texto: "..."}] habilita citar el minuto exacto.
 */
/**
 * Documento de estudio completo de un video, o null si no hay ninguno.
 *
 * Un video puede tener varias piezas de texto y NO son la misma cosa:
 *
 *   · transcripción → lo que se OYE, reconocido automáticamente por YouTube.
 *     Lleva marcas de tiempo, y también muletillas y errores de dicción.
 *   · letra         → el texto OFICIAL de una canción, en versos y estribillos,
 *     sin errores de reconocimiento porque no se reconoció nada: es el original.
 *
 * En un musical hacen falta las dos y dicen cosas distintas: la transcripción
 * sirve para saltar al minuto exacto, la letra para leerla. Guardarlas en el
 * mismo campo obligaba a elegir una y perder la otra.
 *
 * Las dos viven en el MISMO archivo de Drive, no en columnas nuevas de la hoja:
 * el catálogo describe el video, no su contenido, y añadir una columna por cada
 * clase de texto acabaría con una hoja imposible de mirar.
 */
/* [6.25] LOS CUATRO LECTORES RAG.
 *
 * Leen un archivo de Drive por su ID y devuelven lo que hay dentro: el JSON
 * entero, el campo `contenido`, los segmentos con marca de tiempo. Eran
 * globales y sin guarda, así que conocer un ID —y un ID viaja en la columna
 * del catálogo, en una URL, en un registro— bastaba para leer el texto
 * completo de una transcripción desde el navegador.
 *
 * Conocer un identificador no es una autorización. Ahora son privadas y con
 * guarda; y la ruta pública que las usa (`fetch_drive_id`) comprueba además que
 * el documento pedido sea de una ficha del catálogo, en vez de leer Drive
 * primero «a ver qué hay».
 */
function recuperarDocumentoRAG_(archivoId) {
  exigirOrigenInterno("recuperarDocumentoRAG_");
  if (!archivoId || !archivoId.toString().trim()) return null;
  try {
    const archivo = DriveApp.getFileById(archivoId.toString().trim());
    return JSON.parse(archivo.getBlob().getDataAsString());
  } catch (e) {
    logWarn("Drive RAG", `No se pudo leer el documento ${archivoId}: ${e.message}`);
    return null;
  }
}

/**
 * Guarda texto denso en Drive, un archivo por video.
 *
 * `extras` se funde en el documento sin tocar lo que ya hubiera: así se puede
 * añadir la letra de una canción sin borrar su transcripción, y al revés. Sin
 * esto, extraer una de las dos pisaba la otra —el archivo se reescribía entero
 * cada vez— y nadie se enteraba hasta ir a buscar la que faltaba.
 *
 * @param {string} videoId
 * @param {string} textoContenido  transcripción (o "" para no tocarla)
 * @param {Array}  segmentos       [{t, texto}] de la transcripción
 * @param {Object} extras          p. ej. {letra, letraFuente, resumenAmpliado}
 */
function persistirTextoPesado(videoId, textoContenido, segmentos = null, extras = null) {
  exigirOrigenInterno("persistirTextoPesado");
  const texto = (textoContenido === null || textoContenido === undefined)
    ? "" : textoContenido.toString();
  const hayExtras = extras && Object.keys(extras).length > 0;
  if (!texto.trim() && !hayExtras) return "";

  const carpetaTextos = obtenerSubcarpeta("Textos_RAG");
  const nombreArchivo = `doc_${videoId}.json`;
  const archivos = carpetaTextos.getFilesByName(nombreArchivo);

  let previo = null;
  let archivo = null;
  if (archivos.hasNext()) {
    archivo = archivos.next();
    try { previo = JSON.parse(archivo.getBlob().getDataAsString()); }
    catch (e) { previo = null; }      // documento corrupto: se reescribe entero
  }

  const payload = previo && typeof previo === "object" ? previo : {};
  payload.id = videoId;
  payload.version = VERSION_SCRIPT;
  payload.timestamp = formatearFecha(new Date());
  // Solo se pisa la transcripción si llega una nueva: guardar la letra no puede
  // vaciar el campo que usa la búsqueda semántica.
  if (texto.trim()) payload.contenido = texto;
  if (Array.isArray(segmentos) && segmentos.length) payload.segmentos = segmentos;
  if (!payload.contenido) payload.contenido = "";
  if (!Array.isArray(payload.segmentos)) payload.segmentos = [];
  if (hayExtras) {
    Object.keys(extras).forEach(function (k) { payload[k] = extras[k]; });
  }

  const cuerpo = JSON.stringify(payload, null, 2);
  if (archivo) { archivo.setContent(cuerpo); return archivo.getId(); }
  return carpetaTextos.createFile(nombreArchivo, cuerpo, MimeType.PLAIN_TEXT).getId();
}

/**
 * Guarda la letra oficial de un video musical junto a su transcripción.
 *
 * La letra NO se descarga: el panel de letras de YouTube viene de proveedores
 * con licencia (Musixmatch, LyricFind) y no está en los datos de la página
 * como sí lo están los subtítulos. Se pega a mano, que además es lo correcto:
 * quien la pega sabe de dónde la sacó, y eso queda registrado en `letraFuente`.
 */
function guardarLetraVideo(videoId, letra, fuente) {
  const texto = (letra || "").toString().trim();
  if (!videoId || !texto) return "";
  return persistirTextoPesado(videoId, "", null, {
    letra: texto.slice(0, 40000),
    letraFuente: (fuente || "").toString().trim().slice(0, 120),
    letraFecha: formatearFecha(new Date())
  });
}

function recuperarTextoPesado_(archivoId) {
  exigirOrigenInterno("recuperarTextoPesado_");
  if (!archivoId || !archivoId.toString().trim()) return "";
  try {
    const archivo = DriveApp.getFileById(archivoId.toString().trim());
    const data = JSON.parse(archivo.getBlob().getDataAsString());
    return data.contenido || "";
  } catch (e) {
    logWarn("Drive RAG", `No se pudo leer el documento ${archivoId}: ${e.message}`);
    return "[Error al leer archivo RAG de Drive: " + e.message + "]";
  }
}

/** [F0-7] Devuelve los segmentos con tiempo de un documento RAG, o [] si no los tiene. */
function recuperarSegmentosRAG_(archivoId) {
  exigirOrigenInterno("recuperarSegmentosRAG_");
  if (!archivoId || !archivoId.toString().trim()) return [];
  try {
    const archivo = DriveApp.getFileById(archivoId.toString().trim());
    const data = JSON.parse(archivo.getBlob().getDataAsString());
    return Array.isArray(data.segmentos) ? data.segmentos : [];
  } catch (e) {
    return [];
  }
}

function consultarTextoDesacopladoDeDrive_(driveId) {
  exigirOrigenInterno("consultarTextoDesacopladoDeDrive_");
  return recuperarTextoPesado_(driveId);
}

/** Guarda o actualiza un archivo por nombre dentro de una carpeta (recuperado de v2026.0.0). */
/**
 * [6.25] ¿Este documento RAG pertenece a una ficha del catálogo?
 *
 * La comprobación se hace ANTES de tocar Drive y a propósito: leer primero
 * «para ver si existe» ya es la lectura que se quiere impedir, y además la
 * diferencia entre «no existe» y «no es tuyo» le cuenta a quien pregunta si
 * ese ID es real.
 *
 * Lo que NO decide esta función: si esa persona puede ver ESA ficha. Hoy el
 * catálogo es común a todo el que tiene sesión, así que pertenencia al
 * catálogo es la política. El día que haya fichas restringidas por persona o
 * por módulo, el filtro va aquí y no en cada ruta.
 */
function documentoRAGDelCatalogo_(driveId) {
  const id = (driveId || "").toString().trim();
  if (!id) return false;
  let encontrado = false;
  iterarCatalogoPorBloques(function (datos) {
    for (let i = 0; i < datos.length; i++) {
      if ((datos[i][IDX.DRIVE_RAG] || "").toString().trim() === id) { encontrado = true; return true; }
    }
    return false;
  });
  return encontrado;
}

function guardarOActualizarArchivo(carpeta, nombre, contenido, mime = MimeType.PLAIN_TEXT) {
  exigirOrigenInterno("guardarOActualizarArchivo");
  const existentes = carpeta.getFilesByName(nombre);
  if (existentes.hasNext()) {
    const arch = existentes.next();
    arch.setContent(contenido);
    return arch;
  }
  return carpeta.createFile(nombre, contenido, mime);
}

