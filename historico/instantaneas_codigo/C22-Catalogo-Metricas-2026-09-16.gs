// -------------------------------------------------------------------------------------
// 4.1 Acceso al catálogo y recorrido por bloques
// -------------------------------------------------------------------------------------

function obtenerHojaDatos() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  return ss.getSheetByName(NOMBRE_HOJA_DATOS) || ss.getSheets()[0];
}

function asegurarColumnas(hoja, cantidad = TOTAL_COLUMNAS) {
  if (hoja.getMaxColumns() < cantidad) {
    hoja.insertColumnsAfter(hoja.getMaxColumns(), cantidad - hoja.getMaxColumns());
  }
  return hoja;
}

/**
 * [v2.6.10] Deja la fila 1 del catálogo con el filtro de Sheets en las 32
 * columnas, congelada y con su formato.
 *
 * La regla que gobierna esta función: **no se recrea un filtro que ya cubre lo
 * que tiene que cubrir**. Rehacerlo borra los criterios activos, y esto se llama
 * en cada `onOpen`: un filtro que se reconstruye solo cada vez que abres la hoja
 * te tira el «Alcance = Pendiente» que acababas de poner, cada vez, sin decir
 * nada. Así que primero se compara el rango y solo se toca si de verdad se
 * quedó corto —porque se añadieron filas nuevas al importar, que es justo cuando
 * el filtro deja de alcanzar y nadie se da cuenta.
 *
 * @param {Sheet} hojaOpcional
 * @param {boolean} rehacer  true = quitarlo y volver a crearlo aunque cuadre
 *                           (lo usa el comando del menú; pierde los criterios).
 * @return {{estado:string, filas:number}} estado: creado | ampliado | intacto |
 *                                         sin_datos | error
 */
function asegurarFiltroCatalogo(hojaOpcional = null, rehacer = false) {
  const hoja = hojaOpcional || obtenerHojaDatos();
  asegurarColumnas(hoja, TOTAL_COLUMNAS);

  /* La cabecera se corrige SOLO si difiere. Dos razones para comparar antes de
     escribir: esto se llama en cada `onOpen`, y una escritura por apertura es
     latencia que se paga siempre para no arreglar nada; y porque el historial de
     versiones de la hoja se llenaría de cambios fantasma.
     Cuando sí difiere se reescribe entera, no «se rellena lo que falte»: el
     resto del script localiza las columnas por índice, así que un nombre
     cambiado a mano deja la hoja diciendo una cosa y el código leyendo otra. */
  const ultima = hoja.getLastRow();
  if (ultima < 1) return { estado: "sin_datos", filas: 0 };

  /* Todo lo que toca la hoja va DENTRO del try, cabecera y congelado incluidos.
     Estaban fuera y bastaba con que fallara cualquiera de esas llamadas —una
     hoja protegida ya lo consigue— para que la función entera reventara en vez
     de devolver `error`: quien la llama desde el menú se comía una excepción
     cruda, y lo que se quería era un aviso explicando qué pasa. */
  try {
    /* Esta función NO toca los nombres de la cabecera, y esa es una decisión
       deliberada que costó descubrir.
       La versión anterior los reescribía «si diferían», y como esto corre en
       cada onOpen, el resultado sobre una hoja con las columnas descolocadas
       —exactamente el caso que existe reordenarColumnasCatalogo() para
       arreglar— era el peor posible: los nombres pasaban a ser los canónicos y
       los datos se quedaban donde estaban. Cada columna quedaba etiquetada con
       algo que no era, sin un solo error a la vista, y encima se destruía la
       ÚNICA prueba de qué contenía cada una: sus nombres viejos. Después de eso
       ni la herramienta de reparación ni una persona pueden reconstruirlo.
       Poner un filtro es cosmética; recolocar columnas es cirugía sobre los
       datos. Que lo segundo ocurra como efecto secundario de pedir lo primero
       es la clase de sorpresa que no debe existir. Aquí se avisa y nada más;
       reparar lo pide una persona, desde su propio comando. */
    const cabeceraActual = hoja.getRange(1, 1, 1, TOTAL_COLUMNAS).getValues()[0];
    const difiere = CABECERAS_CATALOGO.some(
      (nombre, i) => (cabeceraActual[i] || "").toString().trim() !== nombre);
    if (difiere) {
      logWarn("Filtro", "La cabecera del catálogo no coincide con la esperada. " +
        "El filtro se aplica igual, pero NO se ha tocado ningún nombre: si las " +
        "columnas están descolocadas, usa «Reordenar columnas del catálogo».");
    }
    if (hoja.getFrozenRows() < 1) hoja.setFrozenRows(1);

    const filtro = hoja.getFilter();
    if (filtro) {
      const r = filtro.getRange();
      const cubreTodo = r.getRow() === 1 && r.getColumn() === 1 &&
                        r.getNumColumns() >= TOTAL_COLUMNAS &&
                        r.getLastRow() >= ultima;
      if (cubreTodo && !rehacer) return { estado: "intacto", filas: ultima - 1 };
      filtro.remove();
      hoja.getRange(1, 1, ultima, TOTAL_COLUMNAS).createFilter();
      return { estado: rehacer ? "creado" : "ampliado", filas: ultima - 1 };
    }
    hoja.getRange(1, 1, ultima, TOTAL_COLUMNAS).createFilter();
    return { estado: "creado", filas: ultima - 1 };
  } catch (e) {
    /* Motivos reales y no exóticos: la hoja está protegida, o hay una VISTA de
       filtro abierta (no es lo mismo que un filtro y las dos no conviven). No se
       interrumpe nada por esto —el catálogo funciona igual sin filtro—, pero
       queda dicho en el registro para que no parezca que el comando no hizo
       nada. */
    logWarn("Filtro", "No se pudo aplicar el filtro al catálogo: " + e.message);
    return { estado: "error", filas: ultima - 1 };
  }
}

/** Comando de menú: aplica el filtro, o lo rehace si ya estaba. */
function asegurarFiltroCatalogoUI() {
  exigirOrigenInterno("asegurarFiltroCatalogoUI");
  const r = asegurarFiltroCatalogo();
  const mensajes = {
    creado:    "Filtro aplicado a la fila 1, en las 32 columnas.",
    ampliado:  "El filtro se quedaba corto —había filas nuevas— y se amplió hasta el final.",
    intacto:   "El filtro ya cubría las 32 columnas y todas las filas: no se tocó nada.\n\n" +
               "Se deja como está a propósito: rehacerlo borraría los criterios que tengas puestos.",
    sin_datos: "El catálogo está vacío: no hay nada que filtrar todavía.",
    error:     "No se pudo aplicar el filtro.\n\n" +
               "Suele ser porque la hoja está protegida o porque hay una VISTA de filtro " +
               "abierta —una vista y un filtro no conviven—. Cierra la vista y vuelve a intentarlo.\n\n" +
               "El detalle exacto está en el registro."
  };
  alertarUsuario((mensajes[r.estado] || "") +
    (r.filas ? `\n\nFilas de datos: ${r.filas}` : ""), "Filtro del catálogo");
}

/**
 * Recorre el catálogo en bloques para limitar el consumo de memoria.
 * callback(datos, filaInicioReal, hoja) devuelve true si mutó el bloque.
 */
/* [v2.6.10] Ventana de filas activa, o null.
   Existe para poder decir «haz esto, pero solo del renglón 500 en adelante» sin
   añadirle un parámetro a cada una de las funciones que recorren el catálogo —y
   sin que cada una lo interprete a su manera—. Se pone y se quita en
   conVentanaDeFilas(); nadie más debería tocarla. */
let _ventanaFilas = null;

/**
 * Límites reales de un recorrido, teniendo en cuenta la ventana si la hay.
 * Punto único: si esto se calculara en cada sitio, un día uno de ellos aplicaría
 * la ventana y otro no, y el recorrido «desde la fila 500» tocaría la 2.
 */
function limitesRecorridoCatalogo(ultFilaReal) {
  const desde = _ventanaFilas ? Math.max(2, _ventanaFilas.desde) : 2;
  const hasta = _ventanaFilas && _ventanaFilas.hasta
    ? Math.min(ultFilaReal, _ventanaFilas.hasta)
    : ultFilaReal;
  return { desde: desde, hasta: hasta };
}

/**
 * Ejecuta `fn` con el catálogo acotado a un rango de filas.
 *
 * El `finally` NO es una precaución de estilo: si la ventana se quedara puesta
 * al fallar algo, todo lo que se ejecutara después en esa misma invocación
 * —incluido un recorrido que cree que está mirando el catálogo entero— vería
 * solo un trozo, y no habría ningún error a la vista. Un filtro global que se
 * escapa es de los fallos más caros que existen: los números salen, y salen mal.
 *
 * @param {number} desde  primera fila de datos (mínimo 2)
 * @param {number} hasta  última fila, o 0 / null para llegar hasta el final
 */
function conVentanaDeFilas(desde, hasta, fn) {
  const previa = _ventanaFilas;
  _ventanaFilas = { desde: Math.max(2, parseInt(desde, 10) || 2),
                    hasta: parseInt(hasta, 10) || 0 };
  try {
    return fn();
  } finally {
    _ventanaFilas = previa;
  }
}

function iterarCatalogoPorBloques(callback, tamanoBloque = BATCH_TAMANO_BLOQUE, hojaOpcional = null) {
  exigirOrigenInterno("iterarCatalogoPorBloques");
  const hoja = hojaOpcional || obtenerHojaDatos();
  asegurarColumnas(hoja, TOTAL_COLUMNAS);
  const ultFilaReal = hoja.getLastRow();
  if (ultFilaReal < 2) return { bloques: 0, filas: 0 };

  /* La ventana solo se aplica al catálogo. Cuando se pasa `hojaOpcional` esto
     está recorriendo otra hoja —una de respaldo, una de configuración— y acotar
     ahí por los números de fila del catálogo no significaría nada. */
  const lim = hojaOpcional ? { desde: 2, hasta: ultFilaReal } : limitesRecorridoCatalogo(ultFilaReal);
  const ultFila = lim.hasta;
  if (lim.desde > ultFila) return { bloques: 0, filas: 0 };

  let bloques = 0;
  let filas = 0;
  for (let inicio = lim.desde; inicio <= ultFila; inicio += tamanoBloque) {
    const numFilas = Math.min(tamanoBloque, ultFila - inicio + 1);
    const rango = hoja.getRange(inicio, 1, numFilas, TOTAL_COLUMNAS);
    const datos = rango.getValues();
    let mutado = false;
    try {
      mutado = callback(datos, inicio, hoja) === true;
    } catch (e) {
      logError("Bloques", `Fallo procesando bloque ${inicio}-${inicio + numFilas - 1}: ${e.message}`);
    }
    if (mutado) {
      rango.setValues(datos);
      // flush() solo tras escribir. Antes se llamaba en CADA bloque, incluso en
      // recorridos de solo lectura como el del catálogo: con 500 videos son
      // cinco vaciados de búfer que no sirven para nada y que el portal paga
      // como espera en cada carga.
      SpreadsheetApp.flush();
    }
    bloques++;
    filas += numFilas;
  }
  return { bloques: bloques, filas: filas };
}

/** Devuelve la fila completa del catálogo para un ID de video, o null. */
function buscarFilaCatalogoPorId(idVideo) {
  if (!idVideo) return null;
  let encontrada = null;
  let numeroFila = -1;
  iterarCatalogoPorBloques(function (datos, inicio) {
    for (let i = 0; i < datos.length; i++) {
      if ((datos[i][IDX.ID] || "").toString().trim() === idVideo.toString().trim()) {
        encontrada = datos[i];
        numeroFila = inicio + i;
        return false;
      }
    }
    return false;
  });
  return encontrada ? { fila: encontrada, numeroFila: numeroFila } : null;
}

