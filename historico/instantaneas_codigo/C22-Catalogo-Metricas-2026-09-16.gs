/** Construye el prompt de enriquecimiento con el vocabulario cerrado del momento. */
function construirPromptEnriquecimiento(titulo, descripcion) {
  const v = vocabularioTaxonomia();
  return obtenerPrompt("enriquecimiento", {
    titulo: titulo,
    descripcion: (descripcion || "Sin descripción").toString().slice(0, 2500),
    vocabulario: v.pares.length ? v.pares.join("\n") : "(ninguna configurada)",
    temas: v.temas.length ? v.temas.join(", ") : "(ninguno todavía)",
    sin_clasificar: SIN_CLASIFICAR
  });
}

/**
 * Interpreta la respuesta del modelo y la VALIDA contra el vocabulario.
 *
 * Un modelo devuelve con frecuencia algo parecido pero no idéntico: «Odoo ERP >
 * Inventario», «odoo erp › inventario y almacen». Se acepta si normaliza igual
 * que un par real; si no coincide con ninguno, se descarta la clasificación y la
 * fila queda «Sin clasificar». Escribir una variante inventada es peor que no
 * escribir nada: rompe el árbol de filtros y nadie se entera.
 */
function interpretarEnriquecimiento(textoModelo) {
  const salida = { resumen: "", ecosistema: "", area: "", tema: "", version: "" };
  if (!textoModelo) return salida;

  let json = null;
  try {
    const limpio = textoModelo.toString()
      .replace(/```json/gi, "").replace(/```/g, "").trim();
    const i = limpio.indexOf("{");
    const j = limpio.lastIndexOf("}");
    if (i === -1 || j === -1) return salida;
    json = JSON.parse(limpio.slice(i, j + 1));
  } catch (e) {
    logWarn("Enriquecimiento", "Respuesta no era JSON: " + textoModelo.toString().slice(0, 120));
    return salida;
  }

  salida.resumen = (json.resumen || "").toString().trim();
  salida.tema = (json.tema || "").toString().trim().slice(0, 60);
  salida.version = (json.version || "").toString().trim().slice(0, 20);

  const propuesta = (json.clasificacion || "").toString().trim();
  if (!propuesta || propuesta === SIN_CLASIFICAR) return salida;

  const pares = vocabularioTaxonomia().pares;
  const clave = normalizarBusqueda(propuesta.replace(/[›>|/]+/g, " "));
  for (let k = 0; k < pares.length; k++) {
    if (normalizarBusqueda(pares[k].replace(/[›>|/]+/g, " ")) !== clave) continue;
    const partes = pares[k].split("›");
    salida.ecosistema = partes[0].trim();
    salida.area = (partes[1] || "General").trim();
    break;
  }
  if (!salida.ecosistema) {
    logWarn("Enriquecimiento", `Clasificación fuera del vocabulario, descartada: «${propuesta}».`);
  }
  return salida;
}

/**
 * Aplica el enriquecimiento a una fila EN MEMORIA. Devuelve qué escribió, para
 * poder contarlo y para que quien llama decida si hubo cambio que persistir.
 */
function aplicarEnriquecimientoAFila(r, resultado) {
  const cambios = { resumen: false, clasificacion: false, tema: false, version: false, facetas: false };
  if (!resultado) return cambios;

  if (resultado.resumen && esResumenProvisional(r[IDX.RESUMEN])) {
    r[IDX.RESUMEN] = resultado.resumen;
    cambios.resumen = true;
  }
  // La IA solo rellena lo que las reglas no supieron: si una persona ya lo
  // clasificó, o una regla acertó, eso manda.
  const sinClasificar = !r[IDX.ECOSISTEMA] ||
    r[IDX.ECOSISTEMA] === SIN_CLASIFICAR || r[IDX.AREA] === SIN_CLASIFICAR;
  if (resultado.ecosistema && sinClasificar) {
    r[IDX.ECOSISTEMA] = resultado.ecosistema;
    r[IDX.AREA] = resultado.area;
    cambios.clasificacion = true;
  }
  if (resultado.tema && !r[IDX.TEMA]) { r[IDX.TEMA] = resultado.tema; cambios.tema = true; }
  if (resultado.version && !r[IDX.VERSION]) { r[IDX.VERSION] = resultado.version; cambios.version = true; }

  /* [v2.6.8] Clasificar es responder a las CINCO facetas, no solo al árbol.
     Hasta aquí esta función escribía ecosistema, área, tema, resumen y versión y
     se daba por satisfecha: una fila salía de la Fase 2 colocada en «Odoo ERP /
     POS y Retail» y con el Alcance todavía en «Pendiente de revisión», o sea,
     fuera de los módulos y de los exámenes. Bien clasificada e igual de
     invisible que antes de gastar la llamada.

     Las facetas NO se le piden al modelo. Salen de la ruta que quedó escrita, y
     la ruta pertenece al vocabulario cerrado —interpretarEnriquecimiento()
     descarta cualquier clasificación que no sea una línea permitida—, así que
     las facetas heredan esa garantía. Pedírselas al modelo habría abierto cinco
     puertas nuevas a valores inventados justo donde la v2 acababa de cerrarlas.

     Se ejecuta aunque el modelo no haya reclasificado: una fila que ya tenía
     ruta y estaba en «Pendiente» se arregla aquí sin gastar nada.

     [v2.6.9] `recienClasificada` distingue los dos casos, y no es un detalle.
     Si la fila ACABA de salir de «Sin clasificar», sus facetas son el relleno
     que puso el reclasificador al no reconocerla —«Transversal», «Global»,
     «Tutorial»—, no decisiones: hay que sustituirlas por las de la ruta, o una
     fila hotelera se queda como transversal y una fiscal colombiana como
     global, con la columna llena y sin información. Si la fila ya venía
     clasificada, esos mismos valores pueden ser de una persona y no se tocan. */
  if (resolverFacetasDeFila(r, { recienClasificada: cambios.clasificacion })) {
    cambios.facetas = true;
  }

  return cambios;
}

/**
 * ¿Sirvió de algo la llamada al modelo?
 *
 * Está en una función y no escrito dos veces porque los dos caminos de la Fase 2
 * —el secuencial del menú y el paralelo— tienen que contar lo mismo. El
 * secuencial contaba `procesados++` pasara lo que pasara, así que podía informar
 * de «100 procesados» con filas que seguían «Sin clasificar»: el número decía
 * cuántas veces se llamó al modelo, no cuántas sirvió, y son cosas distintas
 * justo cuando importa saberlo.
 */
function enriquecimientoFueUtil(cambios) {
  if (!cambios) return false;
  return Boolean(cambios.resumen || cambios.clasificacion || cambios.tema ||
                 cambios.version || cambios.facetas);
}

/** Enriquecimiento de un video: una llamada, resumen y clasificación. */
function enriquecerVideoConIA(titulo, descripcion) {
