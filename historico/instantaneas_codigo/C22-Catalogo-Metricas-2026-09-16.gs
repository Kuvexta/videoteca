/**
 * [NOTA DE PLATAFORMA] Sobre autenticar por cabecera `Authorization: Bearer`.
 * No es posible en Apps Script: el objeto de evento que reciben doGet/doPost
 * expone únicamente parameter, parameters, pathInfo, contextPath, queryString,
 * contentLength y postData. Las cabeceras HTTP entrantes NO se exponen, y
 * tampoco hay acceso a cookies. Es un límite del runtime, no una omisión.
 *
 * La mitigación real, ya aplicada, es doble:
 *   1. Toda acción sensible viaja por POST, donde el token va en el cuerpo y no
 *      queda en logs de servidor, historial ni cabeceras Referer.
 *   2. El portal nunca usa el token maestro: hace login y opera con una sesión
 *      efímera (`sess_…`) de duración acotada y revocable.
 * En GET solo deberían usarse tokens de sesión o de lectura, jamás uno de admin.
 */
/**
 * [OPT-19] Documentación viva de la API, servida en ?docs=true.
 * No es Swagger: es una página autocontenida generada desde las MISMAS
 * constantes del script, así que no puede quedar desincronizada del código como
 * sí le pasa a un README en Drive. Pública a propósito: describe el contrato,
 * no expone datos ni acepta tokens.
 */
function paginaDocumentacionAPI() {
  const get = [
    ["health=true", "Estado del servicio y versión", "read_only"],
    ["whoami=true", "Identidad y scope del token", "read_only"],
    ["q={texto}&modo=hibrido|catalogo|fragmentos", "Búsqueda semántica. Acepta dominio, subcategoria, dificultad, moduloId como prefiltro", "read_only"],
    ["fetch_drive_id={id}", "Contenido del documento RAG en Drive", "read_only"],
    ["page=1&pageSize=9", "Catálogo paginado. Filtros: texto, dominio, subcategoria, version, dificultad, moduloId, soloPendientes", "read_only"],
    ["filtros=true", "Opciones de filtro disponibles", "read_only"],
    ["modulos=true", "Módulos certificables con el avance del usuario", "read_only"],
    ["modulo={id}", "Estado detallado de un módulo para el usuario", "read_only"],
    ["notas=true", "Historial de calificaciones propio", "read_only"],
    ["progreso=true", "Progreso de visualización propio", "read_only"],
    ["auditoria={moduloId}", "Informe forense del último intento", "read_only"],
    ["informe_intento={id}", "Informe completo de un intento (forense solo si admin)", "read_only"],
    ["refuerzo=true", "Tareas de refuerzo pendientes", "read_only"],
    ["notificaciones=true", "Notificaciones unificadas {mensaje, link}", "read_only"],
    ["stats_publicas=true", "Métricas agregadas del catálogo", "read_only"],
    ["stats=true", "Métricas del sistema con cuotas y triggers", "admin"],
    ["mcp=true", "Descubrimiento para agentes (protocolo MCP)", "read_only"],
    ["docs=true", "Esta página", "público"]
  ];

  const post = [
    ["login", '{"email":"…","password":"…"}', "Devuelve una sesión efímera (sess_…)", "público"],
    ["logout", '{"token":"sess_…"}', "Revoca la sesión", "read_only"],
    ["modulos_list", '{"token":"…"}', "Módulos con avance", "read_only"],
    ["modulo_estado", '{"token":"…","moduloId":"…"}', "Estado de un módulo", "read_only"],
    ["intento_iniciar", '{"token":"…","moduloId":"…"}', "Abre o reanuda un intento. Devuelve preguntas SIN clave", "read_only"],
    ["intento_guardar", '{"token":"…","intentoId":"…","respuesta":{"numeroPregunta":1,"indiceElegido":2}}', "Guarda avance parcial", "read_only"],
    ["intento_entregar", '{"token":"…","intentoId":"…","respuestas":[…]}', "Califica y devuelve el informe", "read_only"],
    ["informe_intento", '{"token":"…","intentoId":"…"}', "Informe de un intento propio", "read_only"],
    ["informe_pdf", '{"token":"…","intentoId":"…"}', "Genera el informe en PDF", "read_only"],
    ["informe_auditoria", '{"token":"…","moduloId":"…"}', "Informe forense del módulo", "read_only"],
    ["notas", '{"token":"…"}', "Calificaciones propias. El correo ajeno exige admin", "read_only"],
    ["progreso", '{"token":"…"}', "Progreso de visualización", "read_only"],
    ["save_progress", '{"token":"…","idVideo":"…","segundo":0,"duracion":0}', "Guarda el punto de reproducción", "read_only"],
    ["register_view", '{"token":"…","idVideo":"…","titulo":"…"}', "Registra una visualización", "read_only"],
    ["agendar_recordatorio", '{"token":"…","opciones":{…}}', "Crea un recordatorio en Calendar", "read_only"],
    ["search", '{"token":"…","query":"…"}', "Búsqueda semántica", "read_only"],
    ["append", '{"token":"…","url":"…"}', "Da de alta un video en el catálogo", "append"],
    ["modulo_guardar", '{"token":"…","modulo":{…}}', "Crea o actualiza un módulo", "admin"],
    ["modulo_banco_generar", '{"token":"…","moduloId":"…"}', "Genera el banco con IA", "admin"],
    ["modulo_banco_validar", '{"token":"…","moduloId":"…"}', "Promueve el banco a VALIDADA", "admin"],
    ["certificaciones_export", '{"token":"…"}', "Exporta certificaciones a Drive", "admin"],
    ["token_create", '{"token":"…","client":"…","scope":"…","diasValidez":365}', "Emite un token de integración", "admin"]
  ];

  const esc = function (x) {
    return (x || "").toString()
      .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  };
  const pill = function (scope) {
    const color = scope === "admin" ? "#7f1d1d" : (scope === "append" ? "#78350f"
      : (scope === "público" ? "#065f46" : "#1e3a8a"));
    return `<span class="pill" style="background:${color}">${esc(scope)}</span>`;
  };

  const filasGet = get.map(r =>
    `<tr><td><code>?token=TOKEN&amp;${esc(r[0])}</code></td><td>${esc(r[1])}</td><td>${pill(r[2])}</td></tr>`).join("");
  const filasPost = post.map(r =>
    `<tr><td><code>${esc(r[0])}</code></td><td><code class="sm">${esc(r[1])}</code></td><td>${esc(r[2])}</td><td>${pill(r[3])}</td></tr>`).join("");
  const filasEscala = ESCALA_DESEMPENO.map(e =>
    `<tr><td>≥ ${e.min}%</td><td>${esc(e.nivel)}</td><td>${e.certifica ? "Sí" : "No"}</td><td>${e.bono ? "Sí" : "No"}</td></tr>`).join("");

  const html = `<!DOCTYPE html><html lang="es"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>API · Videoteca Certificable</title>
<style>
:root{--bg:#0f172a;--panel:#1e293b;--line:#334155;--tx:#e2e8f0;--mut:#94a3b8;--ac:#38bdf8}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--tx);font:15px/1.6 system-ui,-apple-system,Segoe UI,Roboto,sans-serif}
.wrap{max-width:1080px;margin:0 auto;padding:32px 20px 64px}
h1{font-size:26px;margin:0 0 6px}h2{font-size:19px;margin:38px 0 12px;color:var(--ac)}
.sub{color:var(--mut);margin:0 0 26px}
table{width:100%;border-collapse:collapse;background:var(--panel);border-radius:10px;overflow:hidden;margin-bottom:14px;display:block;overflow-x:auto}
th{background:#0b1220;text-align:left;padding:10px 12px;font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:var(--mut);white-space:nowrap}
td{padding:10px 12px;border-top:1px solid var(--line);vertical-align:top}
code{background:#0b1220;padding:2px 6px;border-radius:5px;font:13px ui-monospace,SFMono-Regular,Menlo,monospace;color:#7dd3fc;white-space:nowrap}
code.sm{font-size:11.5px;white-space:normal;word-break:break-all;color:#a5b4fc}
.pill{display:inline-block;padding:2px 9px;border-radius:99px;font-size:11px;font-weight:600;color:#fff;white-space:nowrap}
