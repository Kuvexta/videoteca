// 4.0.bis Reconstrucción del libro desde cero
// -------------------------------------------------------------------------------------

/* [6.22] Borrar TODAS las hojas y volver a levantarlas.
 *
 * `forzarInicializacionEstructura` repara lo que falta, pero no arregla una
 * hoja que existe y está mal por dentro: una cabecera renombrada a mano, un
 * formato condicional que alguien pegó encima, una hoja de sistema con columnas
 * corridas. Para eso hace falta borrar y volver a crear, y eso es peligroso, así
 * que aquí va todo lo que evita perder datos:
 *
 *   1. Copia completa del libro en Drive ANTES de tocar nada, con su enlace.
 *   2. El catálogo se duplica DENTRO del mismo libro (_Respaldo_Reconstruccion)
 *      y esa hoja es la única que no se borra. Si la ejecución se corta a los
 *      seis minutos —el límite de Apps Script— los videos siguen en el libro,
 *      no en una variable que ya no existe.
 *   3. Confirmación doble: sí/no y escribir BORRAR.
 *
 * Las claves, los tokens y los disparadores NO se tocan: viven en las
 * propiedades del script, no en las hojas. */
const HOJA_RESPALDO_RECONSTRUCCION = "_Respaldo_Reconstruccion";

/* Hojas cuyo contenido no se puede volver a calcular: si se borran, se pierde.
   Se cuentan antes de preguntar para que el aviso diga cuántas filas hay en
   juego en vez de un genérico «se perderán datos». */
const HOJAS_DATOS_IRRECUPERABLES = [
  "_Intentos", "_Respuestas_Detalle", "_Historial_Calificaciones",
  "_Progreso_Refuerzo", "_Progreso_Visualizacion", "_Historial_Visualizaciones",
  "_Miembros_Familia", "_Datos_Privados_Usuarios", "_Favoritos", "_Notas_Usuario",
  "_Incidencias", "_Sugerencias", "_Historial_Bonos", "_Claves_Examenes",
  "_Modulos", "_Modulos_Fuentes", "_Embeddings", "_Embeddings_Chunks"
];

/** Filas con contenido (sin contar la cabecera) de cada hoja que las tenga. */
function inventarioFilasIrrecuperables() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const conDatos = [];
  HOJAS_DATOS_IRRECUPERABLES.forEach(nombre => {
    const h = ss.getSheetByName(nombre);
    if (!h) return;
    const filas = h.getLastRow() - 1;
    if (filas > 0) conDatos.push({ hoja: nombre, filas: filas });
  });
  return conDatos;
}

/**
 * Entrada desde el panel de herramientas. Avisa, enseña qué se pierde, pide que
 * se escriba BORRAR y solo entonces llama al motor.
 */
function reconstruirLibroDesdeCeroUI() {
  exigirOrigenInterno("reconstruirLibroDesdeCeroUI");
  marcarOrigenConfiable();
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const catalogo = ss.getSheetByName(NOMBRE_HOJA_DATOS);
  const videos = catalogo ? Math.max(0, catalogo.getLastRow() - 1) : 0;
  const perdidas = inventarioFilasIrrecuperables();

  let aviso =
    "Se van a BORRAR todas las hojas de este libro y a crearlas de nuevo, vacías.\n\n" +
    "SE CONSERVA:\n" +
    "• El catálogo: " + videos + " videos se copian y se vuelven a escribir al final.\n" +
    "• Las claves de API, los tokens y los disparadores (no viven en las hojas).\n" +
    "• Las carpetas y los archivos de Drive.\n\n";

  if (perdidas.length) {
    aviso += "SE PIERDE (no se puede recalcular):\n";
    perdidas.forEach(p => { aviso += "• " + p.hoja + ": " + p.filas + " filas\n"; });
    aviso += "\n";
  } else {
    aviso += "No hay historial de exámenes ni datos de personas que perder.\n\n";
  }
  aviso += "Antes de borrar se guarda una copia completa del libro en Drive.\n\n¿Continuar?";

  if (!preguntarUsuario("⚠️ Reconstruir el libro desde cero", aviso, false)) return;

  const palabra = solicitarTexto("Confirmación final",
    "Esto no se puede deshacer desde aquí; solo abriendo la copia de Drive.\n\n" +
    "Escribe BORRAR (en mayúsculas) para continuar:");
  if (palabra !== "BORRAR") {
    notificarUsuario("Cancelado: no se escribió BORRAR.", "Reconstrucción", 5);
    return;
  }

  try {
    const r = reconstruirLibroDesdeCero();
    let resumen =
      "✅ LIBRO RECONSTRUIDO\n\n" +
      "• Hojas borradas: " + r.borradas + "\n" +
      "• Hojas creadas: " + r.creadas + "\n" +
      "• Videos restaurados: " + r.filasRestauradas + " de " + r.filasRespaldadas + "\n";
    if (r.columnasDescartadas.length) {
      resumen += "• Columnas del respaldo sin sitio en el esquema nuevo: " +
        r.columnasDescartadas.join(", ") + "\n";
    }
    if (r.pendientes.length) {
      resumen += "\n⏳ No dio tiempo a regenerar: " + r.pendientes.join(", ") +
        ".\nCréalas desde el panel de herramientas cuando quieras.\n";
    }
    if (r.fallos.length) {
      resumen += "\n⚠️ Con errores: " + r.fallos.join(" · ") + "\n";
    }
    resumen +=
      "\n📦 Copia previa en Drive:\n" + r.backupUrl + "\n\n" +
      "La hoja «" + HOJA_RESPALDO_RECONSTRUCCION + "» queda oculta con el catálogo " +
      "anterior. Bórrala a mano cuando compruebes que todo está bien.";
    alertarUsuario(resumen, "🎉 Reconstrucción completa");
  } catch (error) {
    logError("Reconstrucción", error.message);
    alertarUsuario(
      "Se detuvo la reconstrucción: " + error.message + "\n\n" +
      "El catálogo está en la hoja «" + HOJA_RESPALDO_RECONSTRUCCION + "» de este mismo " +
      "libro, y hay una copia completa en la carpeta Backups de Drive.",
      "❌ Error");
  }
}

/**
 * El motor. No pregunta nada: se le llama desde la UI de arriba, que ya avisó.
 * Devuelve el parte de lo que hizo.
 */
function reconstruirLibroDesdeCero() {
  /* [6.23] Esta función borra todas las hojas del libro y es global, así que
     `google.script.run.reconstruirLibroDesdeCero()` desde el portal la
     ejecutaba entera: la doble confirmación vive en la envoltura …UI y
     saltársela era escribir el nombre de la otra. Mismo fallo que el de las
     sesiones, cometido de nuevo el día después de encontrarlo. */
  exigirOrigenInterno("reconstruirLibroDesdeCero");
  const arranque = Date.now();
  /* Apps Script corta a los 6 minutos. Se reserva minuto y medio para que lo
     importante —restaurar el catálogo— nunca quede a medias por generar una
     pestaña de adorno. */
  const TOPE_MS = 4.5 * 60 * 1000;
  const quedaTiempo = () => (Date.now() - arranque) < TOPE_MS;

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const parte = {
    backupUrl: "", borradas: 0, creadas: 0, filasRespaldadas: 0,
    filasRestauradas: 0, columnasDescartadas: [], pendientes: [], fallos: []
  };

  // 1. La copia de Drive. Si esto falla no se sigue: es la única vuelta atrás.
  parte.backupUrl = crearBackupAutomatico_();

  // 2. El catálogo, duplicado dentro del libro.
  const anterior = ss.getSheetByName(HOJA_RESPALDO_RECONSTRUCCION);
  if (anterior) ss.deleteSheet(anterior);
  const catalogo = ss.getSheetByName(NOMBRE_HOJA_DATOS);
  if (!catalogo) throw new Error("No existe la hoja «" + NOMBRE_HOJA_DATOS + "»; no hay nada que reconstruir.");
  const respaldo = catalogo.copyTo(ss).setName(HOJA_RESPALDO_RECONSTRUCCION);
  parte.filasRespaldadas = Math.max(0, respaldo.getLastRow() - 1);

  /* 3. Borrar todo lo demás. El respaldo se queda: siempre hay una hoja viva.
        El .slice() no es adorno: se está borrando de la misma colección que se
        recorre, y si el recorrido fuera sobre la lista viva, cada borrado
        correría los índices y se saltaría una hoja de cada dos. */
  ss.getSheets().slice().forEach(h => {
    if (h.getSheetId() === respaldo.getSheetId()) return;
    try { ss.deleteSheet(h); parte.borradas++; }
    catch (e) { parte.fallos.push("no se pudo borrar " + h.getName()); }
  });

  // 4. Que el inicializador no crea que ya está hecho.
  const props = PropertiesService.getScriptProperties();
  props.deleteProperty("ESTRUCTURA_INICIALIZADA");
  props.deleteProperty("INIT_OK");
  /* Las cachés apuntan a hojas que ya no existen. Cada una en su try: que
     falte una no puede impedir que se levante la estructura. */
  try { invalidarCacheTaxonomia(); } catch (e) { /* la caché no es crítica */ }
  try { invalidarCacheFiltros(); } catch (e) { /* íd. */ }
  try { limpiarCacheManual(); } catch (e) { /* íd. */ }

  // 5. Levantar la estructura: catálogo, cabeceras y las hojas del esquema.
  const antes = ss.getSheets().length;
  inicializarEstructuraHoja(true);
  verificarYEstructurarHojasConfig(true);
  parte.creadas = ss.getSheets().length - antes;

  // 6. Devolver los videos, mapeando por NOMBRE de cabecera y no por posición:
  //    si el respaldo viene de un esquema con las columnas en otro orden, cada
  //    dato acaba donde le toca en vez de correrse una columna entera.
  restaurarCatalogoDesdeRespaldo(respaldo, parte);

  // 7. Formato, validaciones y filtro sobre la hoja ya poblada.
  [["validación de URLs", aplicarValidacionURLs],
   ["formato y desplegables", aplicarTodasLasConfiguraciones],
   ["vista móvil", optimizarVistaMovil]
  ].forEach(par => {
    try { par[1](); } catch (e) { parte.fallos.push(par[0] + ": " + e.message); }
  });
  try { asegurarFiltroCatalogo(null, true); } catch (e) { parte.fallos.push("filtro: " + e.message); }

  // 8. Las pestañas que se calculan a partir del catálogo. Van las últimas y
  //    solo si queda tiempo: ninguna guarda datos, todas se rehacen con un clic.
  [["Dashboard", () => crearDashboardTiempoReal()],
   ["Buscador", () => generarPestanaBuscador()],
   ["Estadísticas", () => generarPestanaEstadisticasUso()],
   ["Certificaciones", () => generarPestanaCertificaciones()],
   ["Acciones Movil", () => crearHojaControlMovil()],
   ["Instrucciones", () => generarHojaInstrucciones()]
  ].forEach(par => {
    if (!quedaTiempo()) { parte.pendientes.push(par[0]); return; }
    try { par[1](); } catch (e) { parte.fallos.push(par[0] + ": " + e.message); }
  });

  try { respaldo.hideSheet(); } catch (e) { /* si fuera la única visible, da igual */ }
  logInfo("Reconstrucción",
    `Libro reconstruido: ${parte.borradas} hojas borradas, ${parte.filasRestauradas} videos restaurados.`);
  return parte;
}

/**
 * Copia las filas del respaldo al catálogo recién creado, por bloques para no
 * cargar 5.000 filas de golpe en memoria, y casando las columnas por su nombre.
 */
function restaurarCatalogoDesdeRespaldo(respaldo, parte) {
  exigirOrigenInterno("restaurarCatalogoDesdeRespaldo");
  const total = Math.max(0, respaldo.getLastRow() - 1);
  if (total === 0) return;

  const anchoOrigen = Math.max(1, respaldo.getLastColumn());
  const cabOrigen = respaldo.getRange(1, 1, 1, anchoOrigen).getValues()[0]
    .map(v => (v === null || v === undefined ? "" : v.toString().trim()));
  let mapa = cabOrigen.map(nombre => CABECERAS_CATALOGO.indexOf(nombre));
  /* Si el respaldo no trae cabeceras reconocibles —alguien las renombró—, se
     cae a la correspondencia posicional, que es lo que había antes de que
     existieran los nombres. Vale más una copia posicional que ninguna. */
  if (mapa.every(i => i === -1)) {
    mapa = cabOrigen.map((_, i) => (i < TOTAL_COLUMNAS ? i : -1));
    parte.fallos.push("cabeceras del respaldo irreconocibles: se restauró por posición");
  } else {
    cabOrigen.forEach((nombre, i) => {
      if (mapa[i] === -1 && nombre) parte.columnasDescartadas.push(nombre);
    });
  }

  const destino = obtenerHojaDatos();
  const filasNecesarias = total + 1;
  if (destino.getMaxRows() < filasNecesarias) {
    destino.insertRowsAfter(destino.getMaxRows(), filasNecesarias - destino.getMaxRows());
  }
  asegurarColumnas(destino, TOTAL_COLUMNAS);

  const BLOQUE = 1000;
  for (let inicio = 0; inicio < total; inicio += BLOQUE) {
    const cuantas = Math.min(BLOQUE, total - inicio);
    const origen = respaldo.getRange(inicio + 2, 1, cuantas, anchoOrigen).getValues();
    const salida = origen.map(fila => {
      const nueva = new Array(TOTAL_COLUMNAS).fill("");
      for (let c = 0; c < mapa.length; c++) {
        if (mapa[c] >= 0) nueva[mapa[c]] = fila[c];
      }
      return nueva;
    });
    destino.getRange(inicio + 2, 1, cuantas, TOTAL_COLUMNAS).setValues(salida);
    parte.filasRestauradas += cuantas;
    SpreadsheetApp.flush();
  }
}

/**
 * [F0-3] Punto de entrada equivalente al inicializador externo de la v2026.2.0.
 * Se conserva el nombre para no romper accesos directos, pero delega en la autoridad única.
 */
function inicializarSistemaCompleto() {
  const confirmar = preguntarUsuario(
    "⚠️ Inicialización completa",
    "Se crearán o repararán todas las hojas del sistema, las carpetas de Drive y las claves maestras.\n" +
    "No se borran datos existentes: solo se reparan columnas faltantes.\n\n¿Continuar?", true);
  if (!confirmar) return;

  try {
    inicializarEstructuraHoja(true);
    const carpetas = crearCarpetasDrive();
    // Un token cualquiera del mapa no vale: el primero podría ser de solo
    // lectura y el resumen anunciaría un token de administración que no lo es.
    const tokenAdmin = obtenerTokenAdministrador_();
    aplicarValidacionURLs();
    optimizarVistaMovil();

    const resumen =
      "✅ ECOSISTEMA INICIALIZADO\n\n" +
      "• Hojas del sistema: " + Object.keys(ESQUEMAS_HOJAS).length + "\n" +
      "• Columnas del catálogo: " + TOTAL_COLUMNAS + "\n" +
      "• Carpetas en Drive: " + carpetas.length + "\n\n" +
      "🔑 TOKEN DE ADMINISTRADOR:\n" + tokenAdmin + "\n\n" +
      "Guárdalo: es el que te autentica en el portal web.";
    alertarUsuario(resumen, "🎉 Inicialización Completa");
    logInfo("Inicialización", "Sistema completo inicializado.");
  } catch (error) {
    logError("Inicialización", error.message);
    alertarUsuario("Error durante la inicialización: " + error.message, "❌ Error");
  }
}

/** Crea las subcarpetas estándar en Drive y devuelve sus nombres. */
function crearCarpetasDrive() {
  const subcarpetas = [
    "Textos_RAG", "Certificados", "Exportaciones_PDF", "Mapas_Mentales",
    "Snapshots_Historicos", "Backups", "Logs_Efectividad", "Documentos_Modulo", "Informes_Auditoria"
  ];
