function onOpen() {
  marcarOrigenConfiable();   // [SEC-1] entrada legítima del servidor
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const props = PropertiesService.getScriptProperties();

  // [MEJORA 8] Autodiagnóstico y reparación silenciosa al abrir el libro.
  try {
    if (props.getProperty("ESTRUCTURA_INICIALIZADA") !== "true") {
      if (ss.getSheets().length === 1 && ss.getSheets()[0].getLastRow() <= 1) {
        inicializarEstructuraHoja(false);
      }
    }
    verificarYEstructurarHojasConfig(true);
  } catch (e) {
    logWarn("onOpen", "Autoreparación parcial: " + e.message);
  }

  const ui = SpreadsheetApp.getUi();
  const iaEstado = obtenerEstadoIA() ? "✅ ON" : "❌ OFF";
  const keyEstado = obtenerApiKey_("GEMINI") ? t("keyOk") : t("keyFail");

  /* [v2.6.14] El menú se ordena por FRECUENCIA DE USO, no por dificultad.
   *
   * Tenía 145 items en 10 submenús, y de esos 145 había 39 que se ejecutan una
   * sola vez en la vida del libro: 15 de credenciales, 9 de instalar
   * disparadores, 8 de migrar o reparar, 7 de pruebas. «Configurar Claude Key»
   * no es una función difícil — es un ajuste del primer día, y estaba a la misma
   * altura visual que «Cargar videos», que se usa cada semana. Ese era el ruido.
   *
   * Las credenciales y los disparadores ya no son items: viven en el panel de
   * Configuración, que es el único sitio donde se puede VER si están puestos o
   * no. Un item de menú no puede decir «Twitch ❌ sin configurar»; un panel sí.
   *
   * El interruptor de abajo tiene dos estados, no tres, y a propósito: pedirle a
   * alguien que se declare «intermedio» es pedirle que adivine, y quien se
   * equivoca por prudencia luego no encuentra lo que necesita y cree que el
   * sistema no lo tiene. «Enséñame el resto» sí es una pregunta que cualquiera
   * sabe contestar, y se puede cambiar de opinión en un clic. */
  const avanzado = menuAvanzadoActivo();
  const menu = ui.createMenu(t("menuTitle"));

  // ---------- Lo que se hace cada semana: primer nivel, un solo clic ----------
  menu
    .addItem(t("cargarFase1"), "ejecutarFase1Rapida")
    .addItem(t("continuarIngesta"), "continuarIngestaDesdeCheckpoint")
    .addItem(t("cargarFase2"), "ejecutarFase2Profunda")
    .addItem(t("actualizarTodo"), "actualizarTodo")
    .addSeparator()
    .addItem(t("dashboard"), "crearDashboardTiempoReal")
    .addItem(t("buscador"), "generarPestanaBuscador")
    .addItem(t("importarPlaylist"), "importarVideosDesdePlaylistUI")
    .addSeparator()
    /* La cola de fallos sube al primer nivel: es donde aparece el trabajo que
       el sistema no pudo hacer solo, y esconderla no hace que desaparezca. */
    .addItem(t("procesarDLQ"), "abrirDeadLetterQueue")
    .addSeparator()
    .addItem(t("panelConfig"), "abrirPanelConfiguracion");

  // ---------- Submenús que cualquiera acaba necesitando ----------
  menu.addSubMenu(ui.createMenu(t("subModulos"))
    .addItem(t("crearModulo"), "crearModuloUI")
    .addItem(t("asignarModulo"), "asignarVideosModuloUI")
    .addSeparator()
    .addItem(t("generarBancoModulo"), "generarBancoModuloUI")
    .addItem(t("validarBanco"), "revisarBancoModuloUI")
    .addSeparator()
    .addItem(t("documentoMaestro"), "generarDocumentoMaestroUI")
    .addItem(t("panelModulos"), "generarPanelModulos")
    .addItem(t("matrizCertificacion"), "generarPestanaCertificaciones")
    .addItem(t("informePDF"), "generarInformePDFIntentoUI")
    .addItem(t("exportarCertificaciones"), "exportarCertificacionesUI"));

  menu.addSubMenu(ui.createMenu(t("subExport"))
    .addItem(t("exportExcel"), "exportarCatalogoAExcel")
    .addItem(t("exportarPDF"), "exportarVistaAPDF")
    .addItem(t("exportJSON"), "exportarCatalogoAJson")
    .addItem(t("exportCSVPlano"), "exportarCatalogoACSVPlano")
    .addSeparator()
    .addItem(t("exportarSlides"), "exportarResumenAGoogleSlides")
    .addItem(t("fichaDoc"), "crearFichaGoogleDoc")
    .addItem(t("exportarMermaid"), "exportarMapaMentalMermaidFilaActiva"));

  // ---------- Todo lo demás, solo si se pide ver ----------
  /* [v2.6.21] Lo avanzado dejó de ser ocho submenús y pasó a ser un panel.
   *
   * 6.14 acortó el menú corto, pero dejó el largo con diez submenús y 109 items
   * dentro, y eso no cabe: un menú de Google Sheets tiene unas 26 filas útiles
   * desde su borde superior, y un submenú abierto en la fila p solo dispone de
   * las (26 − p) que quedan por debajo. Con diez submenús, nueve se salían de la
   * pantalla — «Administración», el último, tenía tres filas para dieciocho.
   *
   * No es un problema que se arregle recortando: la aritmética no da mientras
   * el contenedor sea un menú. Un panel HTML sí, porque hace scroll, porque
   * puede agrupar con títulos y porque puede explicar cada acción en una línea,
   * que es justo lo que un item de menú nunca pudo hacer. Es la misma decisión
   * que ya funcionó con las credenciales. */
  if (avanzado) {
    menu.addSeparator();
    menu.addItem(t("panelHerramientas"), "abrirPanelHerramientas");
  }

  menu.addSeparator();
  menu.addItem(t(avanzado ? "menuAvanzadoOn" : "menuAvanzadoOff"), "alternarMenuAvanzado");
  menu.addToUi();
}

