/** Lista cerrada del panel de herramientas, derivada de la tabla de arriba. */
const ACCIONES_PANEL_HERRAMIENTAS = HERRAMIENTAS_AVANZADAS
  .reduce((a, s) => a.concat(s.filas.map(f => f[0])), []);

function abrirPanelHerramientas() {
  exigirContextoHoja_("abrirPanelHerramientas");
  marcarOrigenConfiable();
  const ui = SpreadsheetApp.getUi();

  const fila = f => `<div class="f">
      <span class="e"><b>${f[1]}</b>${f[3] ? ' <span class="av">cambia muchas filas</span>' : ""}
        <span class="n">${f[2]}</span></span>
      <button onclick="lanzar('${f[0]}')">Ejecutar</button>
    </div>`;

  const html = `
    <div class="wrap">
      <p class="cab">Todo lo que no se usa cada semana. Nada de esto se ha eliminado del
        sistema: vivía en submenús que no cabían en la pantalla.</p>
      <input id="q" placeholder="Filtrar… (por ejemplo: duplicados, taxonomía, backup)" autocomplete="off">
      ${HERRAMIENTAS_AVANZADAS.map(s =>
        `<section data-sec><h4>${s.titulo}</h4>${s.filas.map(fila).join("")}</section>`).join("")}
      <p class="pie">Cada botón ejecuta la misma acción que antes estaba en el menú.</p>
    </div>
    <style>
      body { margin:0; }
      .wrap { font-family: Arial, Helvetica, sans-serif; padding:14px 16px; color:#0f172a; }
      .cab { font-size:12px; background:#f1f5f9; border-left:3px solid #0f766e;
             padding:8px 10px; margin:0 0 12px 0; border-radius:0 4px 4px 0; }
      #q { width:100%; box-sizing:border-box; padding:7px 9px; font-size:12px;
           border:1px solid #cbd5e1; border-radius:4px; margin-bottom:4px; }
      h4 { font-size:12px; text-transform:uppercase; letter-spacing:.04em;
           color:#0f766e; margin:18px 0 6px 0; }
      .f { display:flex; align-items:flex-start; gap:8px; padding:6px 0;
           border-bottom:1px solid #f1f5f9; }
      .e { flex:1; font-size:12px; line-height:1.45; }
      .e b { font-weight:600; }
      .n { display:block; color:#64748b; font-size:11px; margin-top:2px; }
      .av { background:#fef3c7; color:#92400e; font-size:10px; padding:1px 5px;
            border-radius:3px; white-space:nowrap; }
      button { flex:none; background:#fff; color:#0f766e; border:1px solid #0f766e;
               border-radius:4px; padding:3px 10px; font-size:11px; cursor:pointer; }
      button:hover { background:#0f766e; color:#fff; }
      .pie { color:#64748b; font-size:11px; margin-top:18px; }
    </style>
    <script>
      /* El filtro es la mitad del valor de un panel: con setenta acciones,
         buscar «duplicados» es más rápido que recorrer once secciones. */
      document.getElementById('q').addEventListener('input', function () {
        var q = this.value.toLowerCase().trim();
        document.querySelectorAll('[data-sec]').forEach(function (sec) {
          var vistos = 0;
          sec.querySelectorAll('.f').forEach(function (f) {
            var hay = !q || f.textContent.toLowerCase().indexOf(q) !== -1;
            f.style.display = hay ? '' : 'none';
            if (hay) vistos++;
          });
          sec.style.display = vistos ? '' : 'none';
        });
      });
      function lanzar(fn) {
        google.script.run.withFailureHandler(function (e) { alert(e.message); })
          .lanzarAccionHerramienta(fn);
      }
    </script>`;

  ui.showModalDialog(
    HtmlService.createHtmlOutput(html).setWidth(520).setHeight(600),
    t("panelHerramientas").replace("…", ""));
}

/** Puente del panel de herramientas. Lista cerrada, igual que el de configuración. */
function lanzarAccionHerramienta(nombre) {
  exigirContextoHoja_("lanzarAccionHerramienta");
  if (typeof nombre !== "string" || ACCIONES_PANEL_HERRAMIENTAS.indexOf(nombre) === -1) {
    logWarn("Herramientas", "Acción no permitida desde el panel: " + nombre);
    throw new Error("Esa acción no está disponible desde el panel.");
  }
  marcarOrigenConfiable();
  return this[nombre]();
}

