// 9B.6 [F1-5] Informe de auditoría
// -------------------------------------------------------------------------------------

/**
 * Devuelve el informe completo de un intento.
 * El índice forense se incluye SOLO para scope admin (parámetro incluirForense).
 */
/**
 * [6.24] La invariante del informe: solo se explica un examen ENTREGADO.
 *
 * El informe se construye con `respuestaCorrecta` y `justificacion` de cada
 * pregunta, y las respuestas se guardan una a una MIENTRAS se hace el examen.
 * Sin esta comprobación, el ciclo era: contesto la 1, pido mi informe, veo si
 * acerté, la corrijo, contesto la 2… El examen se convertía en un juego de
 * adivinar con el solucionario al lado. Subir `audit_exam` a admin cerró una
 * puerta; esta era la otra, y por esta se entraba con la sesión propia y sin
 * hacer nada raro.
 *
 * Va en el generador y no solo en las rutas: portal, GET, POST y PDF llaman
 * todos aquí, y una regla repetida en cuatro sitios es una regla que algún día
 * estará en tres.
 */
function exigirIntentoEntregado_(registro) {
  if (!registro || !Array.isArray(registro.datos)) {
    throw new Error(t("err_intento_no_existe"));
  }
  if (registro.datos[INT.ESTADO] !== ESTADO_INTENTO.ENTREGADO) {
    throw new Error(t("err_informe_sin_entregar"));
  }
  return true;
}

function obtenerInformeIntento(intentoId, incluirForense = false) {
  exigirOrigenInterno("obtenerInformeIntento");
  const registro = leerIntento(intentoId);
  if (!registro) throw new Error(t("err_intento_no_existe"));
  /* ANTES de leer el banco, las respuestas y el catálogo: si no toca dar
     informe, no se llega ni a construir el solucionario. */
  exigirIntentoEntregado_(registro);

  const d = registro.datos;
  const moduloId = (d[INT.MODULO] || "").toString();
  const modulo = obtenerModulo(moduloId);
  const claves = leerClavesExamen({ moduloId: moduloId, soloValidadas: true });
  const porNumero = {};
  claves.forEach(q => { porNumero[q.numero] = q; });

  const respuestas = leerRespuestasIntento(intentoId);
  const mapaUrls = {};
  iterarCatalogoPorBloques(function (datos) {
    datos.forEach(r => { if (r[IDX.ID]) mapaUrls[r[IDX.ID].toString().trim()] = r[IDX.URL]; });
    return false;
  });

  const hallazgos = [];
  const porArea = {};
  respuestas.forEach(r => {
    const q = porNumero[r.numero];
    if (!q) return;
    const area = q.area || "General";
    if (!porArea[area]) porArea[area] = { total: 0, aciertos: 0 };
    porArea[area].total++;
    if (r.resultado === RESULTADO.ACIERTO) porArea[area].aciertos++;
    if (r.resultado === RESULTADO.ACIERTO) return;

    const urlBase = mapaUrls[q.videoId] || "";
    hallazgos.push({
      numero: q.numero,
      concepto: q.area || "General",
      pregunta: q.texto,
      estado: r.resultado === RESULTADO.OMISION ? "Omisión" : "Error",
      respuestaEmitida: r.resultado === RESULTADO.OMISION
        ? "En blanco (no respondida)"
        : (q.opciones[r.indiceElegido] !== undefined ? q.opciones[r.indiceElegido] : r.textoRespuesta),
      respuestaCorrecta: q.opciones[q.correcta] !== undefined ? q.opciones[q.correcta] : q.respuestaTexto,
      configuracionCorrecta: q.configuracionCorrecta,
      causaRaiz: q.causaRaiz || (r.resultado === RESULTADO.OMISION
        ? "Omisión: evasión, distracción o visualización incompleta del contenido" : "Brecha conceptual"),
      riesgo: q.riesgo,
      severidad: q.severidad || "BAJO",
      caso: q.caso,
      referenciaVideo: `${q.fuente || q.videoId} — ${formatearSegundos(q.segundo)}`,
      videoId: q.videoId,
      segundo: q.segundo,
      urlConSegundo: construirEnlaceConSegundo(urlBase, q.segundo)
    });
  });

  const desempenoAreas = {};
  Object.keys(porArea).forEach(a => {
    desempenoAreas[a] = Math.round((porArea[a].aciertos / porArea[a].total) * 100);
  });

  const informe = {
    intentoId: intentoId,
    moduloId: moduloId,
    modulo: modulo ? modulo.nombre : moduloId,
    colaborador: d[INT.NOMBRE],
    correo: d[INT.EMAIL],
    fecha: formatearFecha(d[INT.FIN] || d[INT.INICIO], "yyyy-MM-dd HH:mm"),
    total: Number(d[INT.TOTAL]) || 0,
    aciertos: Number(d[INT.ACIERTOS]) || 0,
    errores: Number(d[INT.ERRORES]) || 0,
    omisiones: Number(d[INT.OMISIONES]) || 0,
    porcentaje: Number(d[INT.PORCENTAJE]) || 0,
    nivel: (d[INT.NIVEL] || "").toString(),
    numeroIntento: Number(d[INT.NUMERO]) || 1,
    maxIntentos: modulo ? modulo.maxIntentos : MODULO_MAX_INTENTOS,
    segundosTotales: Number(d[INT.SEGUNDOS]) || 0,
    desempenoAreas: desempenoAreas,
    hallazgos: hallazgos.sort((a, b) => SEVERIDADES_RIESGO.indexOf(a.severidad) - SEVERIDADES_RIESGO.indexOf(b.severidad)),
    planRefuerzo: hallazgos.map(h => ({
      concepto: h.concepto, motivo: h.causaRaiz,
      referencia: h.referenciaVideo, url: h.urlConSegundo
    })),
    recomendaciones: obtenerRecomendacionesEstudio(intentoId, moduloId),
    certificado: resolverNivelDesempeno(Number(d[INT.PORCENTAJE]) || 0).certifica
  };

  if (incluirForense) {
    informe.forense = {
      indice: (d[INT.FORENSE] || "NO_APLICA").toString(),
      trampasPresentadas: Number(d[INT.TRAMPAS]) || 0,
      trampasCaidas: Number(d[INT.CAIDAS]) || 0,
      tasa: Number(d[INT.TRAMPAS]) ? parseFloat(((Number(d[INT.CAIDAS]) / Number(d[INT.TRAMPAS])) * 100).toFixed(1)) : 0,
      segundosPorPregunta: Number(d[INT.TOTAL]) ? Math.round(Number(d[INT.SEGUNDOS]) / Number(d[INT.TOTAL])) : 0
    };
  }
  return informe;
}

/** Informe del último intento de un módulo para el usuario autenticado. */
function obtenerInformeAuditoria(token, moduloId) {
  validarTokenConScope(token, "read_only");
  const datosToken = obtenerDatosToken_(token);
  if (!datosToken) throw new Error(t("err_sin_token"));

  const esAdmin = datosToken.scope === "admin";
  const intentos = listarIntentosUsuario(datosToken.email, moduloId)
    .filter(r => r.datos[INT.ESTADO] === ESTADO_INTENTO.ENTREGADO);
  if (intentos.length === 0) return { error: "Aún no has presentado el examen de este módulo." };

  return obtenerInformeIntento(intentos[0].datos[INT.ID], esAdmin);
}

