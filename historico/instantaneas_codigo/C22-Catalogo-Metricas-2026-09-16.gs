// -------------------------------------------------------------------------------------
// 8.0.1 [F0-8] INFERENCIA EN LOTE PARALELA — recuperada de la v2026.0.0
// UrlFetchApp.fetchAll envía N peticiones a la vez. La diferencia con el bucle
// secuencial es de un orden de magnitud en tiempo de pared.
// -------------------------------------------------------------------------------------

/**
 * Envía varios prompts en paralelo al proveedor indicado.
 * @param {Array<{prompt:string}>} solicitudes
 * @return {Array<{ok:boolean, texto:string, error:string}>} en el mismo orden de entrada
 */
function ejecutarInferenciaLoteFetchAll(solicitudes, proveedor, maxTokens = 1200) {
  exigirOrigenInterno("ejecutarInferenciaLoteFetchAll");
  if (!solicitudes || solicitudes.length === 0) return [];
  if (!obtenerEstadoIA()) throw new Error("El motor de IA está desactivado (menú IA Multi-Modelo).");

  const prov = (proveedor || obtenerConfigIA().proveedor || "GEMINI").toString().toUpperCase();
  const cfg = obtenerConfigIA();
  const apiKey = proveedorApiKey(prov);
  if (prov !== "LOCAL_OLLAMA" && !apiKey) throw new Error(t("err_api_key", { proveedor: prov }));

  verificarCuotaDisponible(solicitudes.length, prov === "LOCAL_OLLAMA" ? "GEMINI" : prov);

  const requests = solicitudes.map(item => {
    const texto = item.prompt;
    if (prov === "OPENAI") {
      return {
        url: URL_OPENAI_COMPLETIONS, method: "post", contentType: "application/json",
        headers: { Authorization: "Bearer " + apiKey },
        payload: JSON.stringify({ model: cfg.modeloOpenAI, messages: [{ role: "user", content: texto }], max_tokens: maxTokens }),
        muteHttpExceptions: true
      };
    }
    if (prov === "CLAUDE") {
      return {
        url: URL_CLAUDE_MESSAGES, method: "post", contentType: "application/json",
        headers: { "x-api-key": apiKey, "anthropic-version": "2023-06-01" },
        payload: JSON.stringify({ model: cfg.modeloClaude, max_tokens: maxTokens, messages: [{ role: "user", content: texto }] }),
        muteHttpExceptions: true
      };
    }
    if (prov === "LOCAL_OLLAMA") {
      const base = (PropertiesService.getScriptProperties().getProperty("OLLAMA_ENDPOINT") || "http://localhost:11434").replace(/\/$/, "");
      return {
        url: base + "/api/generate", method: "post", contentType: "application/json",
        payload: JSON.stringify({ model: cfg.modeloOllama, prompt: texto, stream: false, options: { num_predict: maxTokens, temperature: 0.2 } }),
        muteHttpExceptions: true
      };
    }
    return {
      url: URL_GEMINI_BASE + cfg.modeloGemini + ":generateContent?key=" + apiKey,
      method: "post", contentType: "application/json",
      payload: JSON.stringify({
        contents: [{ parts: [{ text: texto }] }],
        generationConfig: { temperature: 0.2, maxOutputTokens: maxTokens }
      }),
      muteHttpExceptions: true
    };
  });

  let respuestas;
  try {
    respuestas = UrlFetchApp.fetchAll(requests);
  } catch (e) {
    logError("IA lote", "fetchAll falló: " + e.message);
    return solicitudes.map(() => ({ ok: false, texto: "", error: e.message }));
  }

  return respuestas.map((res, idx) => {
    try {
      const code = res.getResponseCode();
      const cuerpo = res.getContentText();
      if (code < 200 || code >= 300) {
        return { ok: false, texto: "", error: `HTTP ${code}: ${cuerpo.slice(0, 160)}` };
      }
      const json = JSON.parse(cuerpo);
      if (prov === "OPENAI") return { ok: true, texto: json.choices[0].message.content.trim(), error: "" };
      if (prov === "CLAUDE") return { ok: true, texto: json.content[0].text.trim(), error: "" };
      if (prov === "LOCAL_OLLAMA") return { ok: true, texto: (json.response || "").trim(), error: "" };
      return { ok: true, texto: json.candidates[0].content.parts[0].text.trim(), error: "" };
    } catch (e) {
      return { ok: false, texto: "", error: `Respuesta ${idx} ilegible: ${e.message}` };
    }
  });
}

/** Extrae JSON robusto desde respuestas del modelo (tolera ```json, texto previo, etc.). */
function extraerJsonDesdeTexto(raw) {
  if (!raw) return null;
  let texto = raw.toString().trim();
  texto = texto.replace(/^```(?:json)?\s*/i, "").replace(/```\s*$/i, "").trim();

  const firstBrace = texto.indexOf("{");
  const lastBrace = texto.lastIndexOf("}");
  if (firstBrace !== -1 && lastBrace !== -1 && lastBrace > firstBrace) {
    const candidato = texto.substring(firstBrace, lastBrace + 1);
    try { return JSON.parse(candidato); } catch (e) { /* intenta el texto completo */ }
  }
  const firstBracket = texto.indexOf("[");
  const lastBracket = texto.lastIndexOf("]");
  if (firstBracket !== -1 && lastBracket !== -1 && lastBracket > firstBracket) {
    try { return JSON.parse(texto.substring(firstBracket, lastBracket + 1)); } catch (e) { /* continúa */ }
  }
  try { return JSON.parse(texto); } catch (e) { return null; }
}

// -------------------------------------------------------------------------------------
// 8.1 Fase 2: enriquecimiento con IA por bloques
// -------------------------------------------------------------------------------------

/**
 * Comprobación previa de la Fase 2. Sin esto, el motor apagado o una API Key
 * ausente se manifestaban como un error por fila en la columna T —o como nada en
 * absoluto—, y desde fuera parecía que «la IA no hace el resumen» sin decir por qué.
 * @return {string} motivo por el que no se puede ejecutar, o "" si todo está listo
 */
function motivoIANoDisponible() {
  if (!obtenerEstadoIA()) return t("err_ia_apagada");
  const prov = (obtenerConfigIA().proveedor || "GEMINI").toString().toUpperCase();
  if (prov !== "LOCAL_OLLAMA" && !proveedorApiKey(prov)) {
    return t("err_api_key", { proveedor: prov });
  }
  return "";
}

function ejecutarFase2Profunda() {
  let procesados = 0;

  const impedimento = motivoIANoDisponible();
  if (impedimento) {
    logWarn("Fase 2", "No se ejecutó: " + impedimento);
    alertarUsuario(
      impedimento + "\n\nLa Fase 2 es la que escribe el resumen y clasifica lo que las " +
      "palabras clave no reconocieron. Actívala en el menú «IA Multi-Modelo» y vuelve a intentarlo.",
      "Fase 2 no ejecutada");
    return 0;
  }

  iterarCatalogoPorBloques(function (datos, filaInicio) {
    let mutado = false;
    for (let i = 0; i < datos.length; i++) {
      if (procesados >= LOTE_MAX_FASE2) break;

      const filaNum = filaInicio + i;
      const url = datos[i][IDX.URL];
      const idVideo = (datos[i][IDX.ID] || "").toString().trim();
      const titulo = (datos[i][IDX.TITULO] || "").toString().trim();
      const resumenActual = (datos[i][IDX.RESUMEN] || "").toString().trim();
      const estado = (datos[i][IDX.ESTADO] || "").toString().trim();
      let driveId = (datos[i][IDX.DRIVE_RAG] || "").toString().trim();

      /* Antes esto era `!resumenActual`, y la Fase 1 ya había puesto el texto
         genérico de la regla en esa celda: la condición nunca se cumplía y el
         catálogo entero se quedaba sin resumen mientras la Fase 2 decía «al día».
         También entra la fila que quedó sin clasificar, aunque tenga resumen. */
      const sinClasificar = !datos[i][IDX.ECOSISTEMA] ||
        datos[i][IDX.ECOSISTEMA] === SIN_CLASIFICAR || datos[i][IDX.AREA] === SIN_CLASIFICAR;
      const requiere = url && idVideo && titulo &&
        (esResumenProvisional(resumenActual) || sinClasificar || estado.indexOf("Esencial") !== -1);
      if (!requiere) continue;
      /* Un musical no se manda al modelo: ya está clasificado por su categoría y
         no hay resumen de capacitación que escribir sobre una canción.
         [v2.6.8] El filtro era filaEsCertificable(), que desde la v2 exige
         Alcance = «Certificable». Como el Alcance se decide DESPUÉS de
         clasificar, toda fila recién migrada llega en «Pendiente de revisión» y
         se saltaba en silencio: la Fase 2 informaba «al día» sin haber mirado
         ninguna de las que tenía que mirar. Ahora excluye solo lo que de verdad
         no tiene nada que hacer aquí — ver filaAdmiteFase2(). */
      if (!filaAdmiteFase2(datos[i])) continue;

      try {
        notificarUsuario(`Procesando IA: ${titulo.slice(0, 28)}…`, "Fase 2", 3);
        // Una sola llamada trae resumen y clasificación: pedirlos por separado
        // cuesta el doble de cuota y las dos respuestas pueden contradecirse.
        const cambios = aplicarEnriquecimientoAFila(datos[i], enriquecerVideoConIA(titulo, resumenActual));
        let util = enriquecimientoFueUtil(cambios);
        if (estado.indexOf("Esencial") !== -1 && !driveId) {
          driveId = generarResumenRAGIA(idVideo, titulo, datos[i][IDX.RESUMEN]);
          datos[i][IDX.DRIVE_RAG] = driveId;
          util = true;
        }
        /* La llamada no falló, así que un error anterior deja de ser cierto. Va
           antes del descarte y aparte de él: limpiar el error es un cambio que
           merece guardarse aunque el modelo no haya aportado nada. */
        if ((datos[i][IDX.ERROR] || "").toString()) { datos[i][IDX.ERROR] = ""; mutado = true; }
        /* [v2.6.9] Contar solo lo que sirvió, igual que el camino paralelo. */
        if (!util) { logWarn("Fase 2", `Sin cambios útiles para ${idVideo}.`); continue; }
        procesados++;
        mutado = true;
      } catch (err) {
        gestionarErrorFila(filaNum, `Error en Fase 2 IA: ${err.message}`, url, titulo, err.stack, deducirCodigoHttpDesdeError(err.message));
      }
    }
    return mutado;
  });

  if (procesados > 0) {
    invalidarCacheAPI();
    logInfo("Fase 2", `${procesados} videos enriquecidos con IA.`);
    notificarUsuario(t("toast_fase2_ok", { procesados: procesados }), "Completado", 4);
  } else {
    notificarUsuario(t("toast_fase2_aldia"), "Al día", 3);
  }
  return procesados;
}

/**
 * [F0-8] Fase 2 en paralelo: agrupa los pendientes en tandas de LOTE_MAX_FETCHALL
 * y resuelve cada tanda con una sola llamada a fetchAll.
 */
function ejecutarFase2Paralela(silencioso = false) {
  const impedimento = motivoIANoDisponible();
  if (impedimento) {
    logWarn("Fase 2 paralela", "No se ejecutó: " + impedimento);
    if (!silencioso) alertarUsuario(impedimento, "Fase 2 no ejecutada");
    return 0;
  }

  const cfg = obtenerConfigIA();
  const inicio = new Date().getTime();
  let procesados = 0;

  iterarCatalogoPorBloques(function (datos, filaInicio) {
    if (procesados >= LOTE_MAX_FASE2) return false;
    if ((new Date().getTime() - inicio) > PRESUPUESTO_EJECUCION_MS) return false;

    // 1) Recolectar los pendientes del bloque.
    const pendientes = [];
    for (let i = 0; i < datos.length; i++) {
      const url = datos[i][IDX.URL];
      const idVideo = (datos[i][IDX.ID] || "").toString().trim();
      const titulo = (datos[i][IDX.TITULO] || "").toString().trim();
      const resumenActual = (datos[i][IDX.RESUMEN] || "").toString().trim();
      const estado = (datos[i][IDX.ESTADO] || "").toString().trim();
      if (!url || !idVideo || !titulo) continue;
      const sinClasificar = !datos[i][IDX.ECOSISTEMA] ||
        datos[i][IDX.ECOSISTEMA] === SIN_CLASIFICAR || datos[i][IDX.AREA] === SIN_CLASIFICAR;
      const requiere = esResumenProvisional(resumenActual) || sinClasificar ||
        estado.indexOf("Esencial") !== -1;
      // [v2.6.8] Mismo cambio que en la versión secuencial: ver filaAdmiteFase2().
      if (requiere && filaAdmiteFase2(datos[i])) {
        pendientes.push({ i: i, fila: filaInicio + i, id: idVideo, titulo: titulo,
                          estado: estado, resumen: resumenActual });
      }
      if (pendientes.length + procesados >= LOTE_MAX_FASE2) break;
    }
    if (pendientes.length === 0) return false;

    // 2) Resolver en tandas paralelas.
    let mutado = false;
    for (let k = 0; k < pendientes.length; k += LOTE_MAX_FETCHALL) {
      const tanda = pendientes.slice(k, k + LOTE_MAX_FETCHALL);
      const prompts = tanda.map(p => ({
        prompt: construirPromptEnriquecimiento(p.titulo, p.resumen)
      }));

      let resultados;
      try {
        resultados = ejecutarInferenciaLoteFetchAll(prompts, cfg.proveedor, 600);
      } catch (e) {
        logError("Fase 2 paralela", e.message);
        // [OPT-10] Cuota agotada o proveedor caído: el resto del catálogo no se
        // pierde, se reintenta solo cuando la cuota se renueve.
        encolarTareaDiferida("fase2_ia", {}, e.message);
        return mutado;
      }

      resultados.forEach((r, idx) => {
        const p = tanda[idx];
        if (!r.ok || !r.texto) {
          gestionarErrorFila(p.fila, "Fase 2 IA: " + (r.error || "sin respuesta"), datos[p.i][IDX.URL], p.titulo, "", 500);
          return;
        }
        const cambios = aplicarEnriquecimientoAFila(datos[p.i], interpretarEnriquecimiento(r.texto));

        /* [v2.6.10] Limpiar el error va ANTES del descarte, igual que en el
           camino secuencial. La llamada funcionó, así que un error apuntado en
           una pasada anterior ya no es cierto, aporte o no aporte contenido el
           modelo. Estando después del `return`, una fila con error viejo que
           volvía a responder sin novedades se quedaba marcada como fallida para
           siempre: la única forma de limpiarla era que el modelo cambiara de
           opinión, que es justo lo que no iba a pasar. Las dos rutas de la Fase
           2 tienen que dejar la fila en el mismo estado; si no, cuál se ejecutó
           se nota en los datos. */
        if ((datos[p.i][IDX.ERROR] || "").toString()) { datos[p.i][IDX.ERROR] = ""; mutado = true; }

        // [v2.6.8] Resolver el Alcance de una fila pendiente también es un
        // resultado útil: es lo que la saca del limbo y la mete en el temario.
        // [v2.6.9] El criterio es ahora compartido con el camino secuencial.
        if (!enriquecimientoFueUtil(cambios)) {
          // El modelo respondió pero no sirvió: no se cuenta como procesado, o
          // la fila desaparecería de los pendientes sin haberse arreglado.
          logWarn("Fase 2", `Sin cambios útiles para ${p.id}.`);
          return;
        }
        procesados++;
        mutado = true;
      });
      SpreadsheetApp.flush();
    }

    // 3) Los esenciales sin documento RAG se procesan aparte (prompt largo, uno a uno).
    tandaEsenciales(datos, filaInicio);
    return mutado;
  });

  if (procesados > 0) {
    invalidarCacheAPI();
    logInfo("Fase 2", `${procesados} videos enriquecidos en paralelo.`);
    if (!silencioso) notificarUsuario(t("toast_fase2_ok", { procesados: procesados }), "Completado", 4);
  } else if (!silencioso) {
    notificarUsuario(t("toast_fase2_aldia"), "Al día", 3);
  }
  return procesados;
}

/** Genera el documento RAG de los esenciales del bloque que aún no lo tienen. */
function tandaEsenciales(datos, filaInicio) {
  let generados = 0;
  for (let i = 0; i < datos.length; i++) {
    if (generados >= 3) break;
    const estado = (datos[i][IDX.ESTADO] || "").toString();
    const idVideo = (datos[i][IDX.ID] || "").toString().trim();
    const titulo = (datos[i][IDX.TITULO] || "").toString().trim();
    if (estado.indexOf("Esencial") === -1 || !idVideo || !titulo) continue;
    if ((datos[i][IDX.DRIVE_RAG] || "").toString().trim()) continue;
    if (!filaEsCertificable(datos[i])) continue;
    try {
      datos[i][IDX.DRIVE_RAG] = generarResumenRAGIA(idVideo, titulo, datos[i][IDX.RESUMEN] || titulo);
      generados++;
    } catch (e) {
      logWarn("Fase 2", `RAG fallido para ${idVideo}: ${e.message}`);
    }
  }
  return generados;
}

function generarResumenAmpliadoConIA() {
  exigirOrigenInterno("generarResumenAmpliadoConIA");
  const sheet = obtenerHojaDatos();
  const row = sheet.getActiveRange().getRow();
  if (row < 2) { alertarUsuario(t("alert_fila_invalida")); return; }

  const videoId = sheet.getRange(row, IDX.ID + 1).getValue().toString().trim();
  const titulo = sheet.getRange(row, IDX.TITULO + 1).getValue().toString().trim();
  const idDriveDoc = sheet.getRange(row, IDX.DRIVE_RAG + 1).getValue().toString().trim();
  const cfg = obtenerConfigIA();

  let textoParaAnalizar = "";
  if (idDriveDoc) {
    try { textoParaAnalizar = recuperarTextoPesado_(idDriveDoc); } catch (e) { /* continúa */ }
  }
  if (!textoParaAnalizar) textoParaAnalizar = "Título: " + titulo + ". Análisis de inferencia técnica.";

  try {
    const resumen = llamarModeloIA(obtenerPrompt("ampliado", { titulo: titulo, texto: textoParaAnalizar }), cfg.proveedor, cfg.maxTokens);
    const driveId = persistirTextoPesado(videoId || "row_" + row, resumen);
    sheet.getRange(row, IDX.DRIVE_RAG + 1).setValue(driveId);
    logInfo("IA", `Documento RAG generado para la fila ${row}.`);
    notificarUsuario("Documento RAG guardado en Drive.", "IA", 3);
  } catch (e) {
    logError("IA", e.message);
    notificarUsuario("Error: " + e.message, "Error", 5);
  }
}

function generarResumenParaFilasSeleccionadas() {
  exigirOrigenInterno("generarResumenParaFilasSeleccionadas");
  const sheet = obtenerHojaDatos();
  const range = sheet.getActiveRange();
  const filas = range.getNumRows();
  const startRow = range.getRow();
  if (filas === 0 || startRow < 2) { alertarUsuario(t("alert_fila_invalida")); return; }

  const cfg = obtenerConfigIA();
  const titulos = sheet.getRange(startRow, IDX.TITULO + 1, filas, 1).getValues();
  const cambiosResumen = [];
  const cambiosEstado = [];
  let proc = 0;

  for (let i = 0; i < filas; i++) {
    const titulo = titulos[i][0];
    if (!titulo) { cambiosResumen.push([""]); cambiosEstado.push(["🟡 Pendiente"]); continue; }
    try {
      const resumen = llamarModeloIA(obtenerPrompt("ejecutivo", { titulo: titulo, descripcion: "" }), cfg.proveedor, cfg.maxTokens);
      cambiosResumen.push([resumen]);
      cambiosEstado.push(["🟢 Estudiado / Aplicado"]);
      proc++;
    } catch (e) {
      logWarn("IA", `Fila ${startRow + i}: ${e.message}`);
      cambiosResumen.push([""]);
      cambiosEstado.push(["🟡 Pendiente"]);
    }
  }

  if (proc > 0) {
    sheet.getRange(startRow, IDX.RESUMEN + 1, filas, 1).setValues(cambiosResumen);
    sheet.getRange(startRow, IDX.ESTADO + 1, filas, 1).setValues(cambiosEstado);
    notificarUsuario("Generados " + proc + " resúmenes.", "IA", 3);
  }
}

