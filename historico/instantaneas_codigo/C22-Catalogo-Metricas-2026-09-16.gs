</style></head><body><div class="wrap">
<h1>API · Videoteca Certificable</h1>
<p class="sub">${esc(VERSION_SCRIPT)} · generado desde el propio script el ${esc(formatearFecha(new Date(), "yyyy-MM-dd HH:mm"))}</p>

<div class="note"><b>Autenticación.</b> Apps Script no expone cabeceras HTTP entrantes, así que no existe
<code>Authorization: Bearer</code>. Autentícate con <code>login</code> por POST y usa la sesión efímera
(<code>sess_…</code>) que devuelve. Nunca envíes un token <code>adm_…</code> por GET: queda en el historial
del navegador y en los logs de cualquier proxy intermedio.</div>

<h2>GET</h2>
<table><thead><tr><th>Parámetros</th><th>Devuelve</th><th>Scope</th></tr></thead><tbody>${filasGet}</tbody></table>

<h2>POST</h2>
<p class="sub">Cuerpo JSON con <code>action</code> y los campos indicados.</p>
<table><thead><tr><th>action</th><th>Cuerpo</th><th>Descripción</th><th>Scope</th></tr></thead><tbody>${filasPost}</tbody></table>

<h2>Scopes</h2>
<p class="sub">Jerarquía: <code>read_only &lt; exam &lt; append &lt; admin</code>. Un scope superior cubre a los inferiores.</p>

<h2>Escala de desempeño</h2>
<table><thead><tr><th>Desde</th><th>Nivel</th><th>Certifica</th><th>Bono</th></tr></thead><tbody>${filasEscala}</tbody></table>

<div class="note"><b>El servidor nunca envía la clave.</b> Mientras un intento está abierto, la respuesta de
<code>intento_iniciar</code> no incluye el índice correcto, la justificación, el cebo anti-IA ni el segundo del
video. Todo eso llega únicamente en el informe posterior a la entrega.</div>

<div class="note"><b>Límites.</b> ${RATE_LIMIT_MAX_REQUESTS} peticiones por ${RATE_LIMIT_VENTANA_SEG} s por identificador.
El login tiene su propio control: ${LOGIN_MAX_INTENTOS} fallos bloquean ${Math.round(LOGIN_BLOQUEO_SEG / 60)} minutos.</div>

<footer>Kuvexta SAS · Grupo Empresarial SuBienes — esta página se regenera con el script, no se mantiene aparte.</footer>
</div></body></html>`;

  return HtmlService.createHtmlOutput(html)
    .setTitle("API · Videoteca Certificable")
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

/** Página de cierre del flujo OAuth: el usuario acaba aquí tras autorizar. */
function paginaResultadoOAuth(proveedor, resultado) {
  const ok = resultado && resultado.exito;
  const html =
    '<!DOCTYPE html><html lang="es"><head><meta charset="utf-8">' +
    '<meta name="viewport" content="width=device-width,initial-scale=1">' +
    "<title>" + proveedor + "</title></head>" +
    '<body style="font-family:system-ui,Arial,sans-serif;background:#0f172a;color:#e2e8f0;margin:0;' +
    'display:flex;min-height:100vh;align-items:center;justify-content:center">' +
    '<div style="max-width:460px;padding:32px;text-align:center">' +
    '<div style="font-size:42px;margin-bottom:10px">' + (ok ? "✅" : "⚠️") + "</div>" +
    '<h1 style="font-size:20px;margin:0 0 12px">' +
    (ok ? proveedor + " conectado" : "No se pudo conectar " + proveedor) + "</h1>" +
    '<p style="line-height:1.6;color:#94a3b8">' +
    ((resultado && resultado.mensaje) ? resultado.mensaje : "") + "</p>" +
    (ok ? '<p style="line-height:1.6;color:#94a3b8">Ya puedes cerrar esta pestaña y volver a la hoja de cálculo.</p>'
        : '<p style="line-height:1.6;color:#94a3b8">Vuelve a iniciar la autorización desde el menú.</p>') +
    "</div></body></html>";
  return HtmlService.createHtmlOutput(html).setTitle(proveedor);
}

function doGet(e) {
  marcarOrigenConfiable();   // [SEC-1] entrada legítima del servidor
  const params = (e && e.parameter) ? e.parameter : {};

  // La documentación es pública: describe el contrato, no expone datos.
  if (params.docs === "true") return paginaDocumentacionAPI();

  // [TT-1] Retorno de la autorización de TikTok. Llega sin token propio: la
  // legitimidad la da el parámetro `state`, de un solo uso y con caducidad.
  if (params.code && params.state && params.scopes !== undefined) {
    const res = completarAutorizacionTikTok(params.code, params.state);
    return paginaResultadoOAuth("TikTok", res);
  }
  const identificador = params.token || params.ip || "web_anonimo";

  // Un token de administrador por la barra de direcciones es un incidente:
  // queda en el historial y en los logs del proxy. Se avisa, no se bloquea,
  // para no romper integraciones existentes.
  if (params.token && params.token.toString().indexOf("adm_") === 0) {
    logWarn("Seguridad", "Token de administrador recibido por GET: usa POST o una sesión efímera.");
  }

  // [MEJORA 3] Rate limiting antes de cualquier trabajo costoso.
  if (!verificarRateLimit(identificador)) {
    return respuestaJson({ error: true, codigo: 429, mensaje: t("toast_rate_limit") });
  }

  // [SEC-6] Enrutado portal vs API.
  //
  // Antes bastaba con que hubiera `token` para irse por la rama de API. Eso rompía
  // justo el caso principal del portal: el enlace personal del colaborador
  // (`?token=inv_…`) devolvía JSON en vez de la página. Ahora se decide por la
  // presencia de un parámetro de API explícito, no por el token.
  const esLlamadaApi = PARAMS_API_GET.some(p => params[p] !== undefined);

  if (!esLlamadaApi || params.view === "portal") {
    if (!validarExistenciaIndexHtml()) {
      logWarn("Portal", "Index.html ausente: se sirvió la página de mantenimiento.");
      return paginaMantenimientoPortal();
    }
    try {
      const plantilla = HtmlService.createTemplateFromFile("Index");
      // El token del enlace se inyecta desde el servidor: dentro del iframe de
      // HtmlService, `window.location.search` no ve los parámetros del padre.
      // Se sanea a caracteres de token para que no pueda escapar al script.
      const crudo = (params.token || "").toString();
      plantilla.tokenUrl = /^[A-Za-z0-9_-]{1,64}$/.test(crudo) ? crudo : "";
      plantilla.version = VERSION_SCRIPT;
      /* [v2.6.17] El crédito del pie viaja EN la plantilla, no por la API.
         La identidad del portal (`cargarMarca`) solo se pide una vez hay
         sesión, y esta línea vive en la pantalla de acceso — es decir, antes de
         que haya nada que pedir. Inyectarla aquí evita tener que abrir un
         endpoint sin autenticar solo para esto, y de paso se ve desde el primer
         pintado, sin el parpadeo de aparecer medio segundo después. */
      let credito = "";
      try { credito = (obtenerMarcaPortal().pie || "").toString(); } catch (e) { credito = ""; }
      plantilla.credito = credito.slice(0, MARCA_MAX_TEXTO);
      return plantilla.evaluate()
        .setTitle("Videoteca Certificable")
        .setSandboxMode(HtmlService.SandboxMode.IFRAME)
        .addMetaTag("viewport", "width=device-width, initial-scale=1, viewport-fit=cover")
        .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
    } catch (err) {
      logError("Portal", "Fallo renderizando Index.html: " + err.message);
      return paginaMantenimientoPortal();
    }
  }

  try {
    validarTokenConScope(params.token, "read_only");

    if (params.health === "true") {
      return respuestaJson({
        status: "operativo", version: VERSION_SCRIPT,
        portal: validarExistenciaIndexHtml() ? "disponible" : "mantenimiento",
        timestamp: new Date().toISOString()
      });
    }

    if (params.whoami === "true") return respuestaJson(verificarToken(params.token));

    if (params.fetch_drive_id) {
      /* [6.25] El token daba acceso a CUALQUIER ID que la cuenta del proyecto
         pudiera abrir, no solo a los del catálogo. Ahora se comprueba la
         pertenencia antes de leer nada, y el rechazo no distingue entre «no
         existe» y «no es del catálogo»: esa distinción sería un buscador de
         identificadores válidos. */
      if (!documentoRAGDelCatalogo_(params.fetch_drive_id)) {
        logWarn("Drive RAG", "Documento pedido que no está en el catálogo; no se lee.");
        throw new Error(t("err_documento_no_autorizado"));
      }
      return respuestaJson({
        status: "success",
        driveId: params.fetch_drive_id,
        contenido: recuperarTextoPesado_(params.fetch_drive_id)
      });
    }

    if (params.q) {
      const modo = (params.modo || "hibrido").toLowerCase();
      const topK = parseInt(params.topK, 10) || 10;
      // [OPT-9] Prefiltro: reduce el conjunto ANTES de calcular similitudes.
      const pre = {};
      if (params.dominio) pre.dominio = params.dominio;
      if (params.subcategoria) pre.subcategoria = params.subcategoria;
      if (params.dificultad) pre.dificultad = params.dificultad;
      if (params.moduloId) pre.moduloId = params.moduloId;
      const prefiltro = Object.keys(pre).length > 0 ? pre : null;

      let resultados;
      if (modo === "fragmentos") resultados = busquedaSemanticaPorFragmentos(params.q, topK);
      else if (modo === "catalogo") resultados = buscarPorSimilitudCoseno(params.q, topK, prefiltro);
      else resultados = busquedaSemanticaHibrida(params.q, topK, prefiltro);
      return respuestaJson({
        status: "success", query: params.q, modo: modo,
        prefiltro: prefiltro || {}, results: resultados
      });
    }

    if (params.mcp === "true") {
      return respuestaJson({
        server: "GAS-Master-Knowledge-Server",
        version: VERSION_SCRIPT,
        protocol: "mcp-v1",
        capabilities: ["search_semantic_chunks", "search_hybrid", "fetch_rag_drive", "list_catalog",
          "append_video", "list_modules", "module_state", "native_quiz", "forensic_report", "grades"],
        tools: ["consultar_catalogo", "recuperar_documento_rag", "registrar_video",
          "listar_modulos", "estado_modulo", "informe_auditoria", "consultar_notas"],
        resources: ["catalogo_conocimiento_ia.json", "schema_catalogo.json", "certificaciones.json"],
        escalaDesempeno: ESCALA_DESEMPENO.map(e => ({ desde: e.min, nivel: e.nivel, certifica: e.certifica })),
        rateLimit: { ventanaSegundos: RATE_LIMIT_VENTANA_SEG, maxSolicitudes: RATE_LIMIT_MAX_REQUESTS }
      });
    }

    if (params.stats === "true") return respuestaJson(obtenerEstadisticasSistema(params.token));
    if (params.stats_publicas === "true") return respuestaJson(servirStatsAgregadasConCache());
    if (params.filtros === "true") return respuestaJson(obtenerFiltrosCache());
    if (params.refuerzo === "true") return respuestaJson({ status: "success", tareas: obtenerTareasRefuerzoUsuario(params.token) });
    if (params.notificaciones === "true") {
      return respuestaJson({ status: "success", data: consultarNotificacionesPendientes(params.token) });
    }

    // ---- [F1-1] Módulos certificables ----
    if (params.modulos === "true") {
      return respuestaJson({ status: "success", data: obtenerModulosUsuario(params.token) });
    }
    if (params.modulo) {
      const datosTok = obtenerDatosToken_(params.token) || {};
      const estado = obtenerEstadoModuloUsuario((datosTok.email || "").toLowerCase().trim(), params.modulo);
      if (!estado) throw new Error(t("err_modulo_no_existe", { modulo: params.modulo }));
      return respuestaJson({ status: "success", data: estado });
    }
    if (params.notas === "true") {
      return respuestaJson(buscarCalificacionesEstudiante(params.token, params.correo || null));
    }
    if (params.progreso === "true") {
      return respuestaJson({ status: "success", data: obtenerProgresoUsuario(params.token) });
    }
    if (params.auditoria) {
      return respuestaJson({ status: "success", data: obtenerInformeAuditoria(params.token, params.auditoria) });
    }
    if (params.informe_intento) {
      /* [6.24] Las tres rutas —esta, el POST y el PDF— repetían la misma regla
         de propiedad, cada una con sus propias variables. Tres copias de una
         regla son tres sitios donde arreglarla y dos donde olvidarse: ahora las
         tres delegan en `informeIntentoDeSesion`, que decide quién puede verlo
         y exige que el examen esté entregado. */
      return respuestaJson({
        status: "success",
        data: informeIntentoDeSesion(params.informe_intento, obtenerDatosToken_(params.token))
      });
    }

    const filtros = {};
    if (params.texto) filtros.texto = params.texto;
    if (params.dominio) filtros.dominio = params.dominio;
    if (params.subcategoria) filtros.subcategoria = params.subcategoria;
    if (params.version) filtros.version = params.version;
    if (params.dificultad) filtros.dificultad = params.dificultad;
    if (params.moduloId) filtros.moduloId = params.moduloId;
    if (params.soloPendientes === "true") filtros.soloPendientes = true;

    return respuestaJson(obtenerCatalogoPublico(
      parseInt(params.page, 10) || 1,
      parseInt(params.pageSize, 10) || 9,
      params.token,
      filtros
    ));
  } catch (err) {
    logWarn("API GET", err.message);
    return respuestaJson({ error: true, mensaje: err.message });
  }
}

function doPost(e) {
  marcarOrigenConfiable();   // [SEC-1] entrada legítima del servidor
  try {
    const payload = JSON.parse((e && e.postData) ? e.postData.contents : "{}");
    const identificador = payload.token || payload.email || "post_anonimo";

    if (!verificarRateLimit(identificador)) {
      return respuestaJson({ error: true, codigo: 429, mensaje: t("toast_rate_limit") });
    }

    const action = payload.action || "";

    /* ---- Login por contraseña compartida: RETIRADO [6.24] ----
       Una contraseña común demuestra que quien la escribe la conoce, y nada
       más. El correo lo ponía el cliente, así que cualquiera que la supiera
       —y la sabe todo el que ha entrado alguna vez— podía presentarse como
       otra persona, hacer su examen y llevarse su certificado. Limitar el
       scope a «exam» quitó la escalada a administrador pero no la
       suplantación, que en una videoteca certificable es justo el daño que
       importa.

       No queda una bandera para reactivarlo: una bandera es la forma de que
       esto vuelva a estar encendido dentro de seis meses sin que nadie lo
       decida. La entrada es el canje de clave personal, que sí acredita quién
       eres. `PORTAL_PASSWORD_ENC` puede borrarse cuando la migración esté
       confirmada; este rechazo no depende de que exista. */
    if (action === "login") {
      logWarn("Portal", `Intento de login por contraseña compartida (${(payload.email || "sin correo")}): retirado.`);
      return respuestaJson({
        exito: false, error: true, codigo: 403,
        mensaje: t("err_login_compartido_retirado")
      });
    }

    if (action === "logout") return respuestaJson(revocarSesionCorta_(payload.token));

    if (action === "save_progress") {
      validarPayload(payload, "save_progress", { token: "string", idVideo: "string", segundo: "number", duracion: "number" });
      validarTokenConScope(payload.token, "read_only");
      return respuestaJson(guardarProgresoVideo(payload.token, payload.idVideo, payload.segundo, payload.duracion));
    }

    if (action === "register_view") {
      validarTokenConScope(payload.token, "read_only");
      return respuestaJson(registrarVisualizacionVideo(payload.token, payload.idVideo, payload.titulo));
    }

    if (action === "register_device") {
      validarTokenConScope(payload.token, "read_only");
      return respuestaJson(registrarAccesoDispositivo(payload.token, payload.ip, payload.userAgent, payload.fingerprint));
    }

    if (action === "assistant_command") {
      /* [6.24] Esta rama no validaba token ninguno y se creía el correo del
         cuerpo: contaba pendientes ajenos y disparaba búsquedas que gastan IA,
         sin credencial. El correo del cliente ahora se ignora; se usa el que
         resuelve el servidor a partir del token. */
      validarPayload(payload, "assistant_command", { token: "string", command: "string" });
      validarTokenConScope(payload.token, "read_only");
      const sesionAsist = obtenerDatosToken_(payload.token);
      if (!sesionAsist || !sesionAsist.email) throw new Error(t("err_sin_token"));
      const comando = (payload.command || "").toString().trim();
      if (!comando) throw new Error(t("err_comando_vacio"));
      if (comando.length > LIMITE_COMANDO_ASISTENTE) {
        throw new Error(t("err_comando_largo", { max: LIMITE_COMANDO_ASISTENTE }));
      }
      return respuestaJson(procesarComandoVoz(comando, sesionAsist.email));
    }

    if (action === "audit_exam") {
      /* [6.23] Pedía «read_only» y devolvía una calificación cuyo detalle trae
         `respuestaCorrecta`, `justificacion`, `esTrampa` y `tipoTrampa` de cada
         pregunta. Con una lista de respuestas vacía y el moduloId, cualquier
         alumno con sesión se descargaba el solucionario entero ANTES de
         presentar el examen; y no hacía falta ni adivinar la ruta, basta el
         nombre de la acción. El portal no usa esta acción —para ver su informe
         llama a `informe_intento`, que exige que el intento sea suyo y esté
         entregado—, así que aquí queda como lo que de verdad es: una
         herramienta de auditoría, y la audita quien administra. */
      validarTokenConScope(payload.token, "admin");
      return respuestaJson({
        status: "success",
        data: calcularAuditoriaForense(payload.formId, payload.respuestas || [], payload.moduloId || "")
      });
    }

    if (action === "mark_task") {
      return respuestaJson(marcarTareaRefuerzoVista(payload.token, payload.idTarea));
    }

    if (action === "check_reevaluation") {
      return respuestaJson({ status: "success", data: verificarDesbloqueoReevaluacion(payload.token, payload.formId) });
    }

    if (action === "request_reevaluation") {
      return respuestaJson({ status: "success", data: generarFormularioReevaluacionFocalizada(payload.token, payload.formId) });
    }

    if (action === "search") {
      validarTokenConScope(payload.token, "read_only");
      return respuestaJson(buscarSemanticoWeb(payload.token, payload.query));
    }

    // ---- [F1-2] Quiz nativo: las tres acciones del examen certificable ----
    if (action === "modulos_list") {
      return respuestaJson({ status: "success", data: obtenerModulosUsuario(payload.token) });
    }

    if (action === "modulo_estado") {
      validarTokenConScope(payload.token, "read_only");
      const dt = obtenerDatosToken_(payload.token) || {};
      const estado = obtenerEstadoModuloUsuario((dt.email || "").toLowerCase().trim(), payload.moduloId);
      if (!estado) throw new Error(t("err_modulo_no_existe", { modulo: payload.moduloId }));
      return respuestaJson({ status: "success", data: estado });
    }

    if (action === "intento_iniciar") {
      validarPayload(payload, "intento_iniciar", { token: "string", moduloId: "string" });
      return respuestaJson({ status: "success", data: iniciarIntentoModulo(payload.token, payload.moduloId) });
    }

    if (action === "intento_guardar") {
      validarPayload(payload, "intento_guardar", {
        token: "string", intentoId: "string", respuesta: "object",
        "respuesta.numeroPregunta": "number"
      });
      return respuestaJson(guardarAvanceIntento(payload.token, payload.intentoId, payload.respuesta));
    }

    if (action === "intento_entregar") {
      validarPayload(payload, "intento_entregar", { token: "string", intentoId: "string", respuestas: "array" });
      return respuestaJson({
        status: "success",
        data: entregarIntentoModulo(payload.token, payload.intentoId, payload.respuestas || [])
      });
    }

    if (action === "informe_auditoria") {
      return respuestaJson({ status: "success", data: obtenerInformeAuditoria(payload.token, payload.moduloId) });
    }

    if (action === "informe_intento") {
      validarPayload(payload, "informe_intento", { token: "string", intentoId: "string" });
      validarTokenConScope(payload.token, "read_only");
      return respuestaJson({
        status: "success",
        data: informeIntentoDeSesion(payload.intentoId, obtenerDatosToken_(payload.token))
      });
    }

    if (action === "informe_pdf") {
      validarPayload(payload, "informe_pdf", { token: "string", intentoId: "string" });
      validarTokenConScope(payload.token, "read_only");
      const dtp = obtenerDatosToken_(payload.token) || {};
      const esAdminPdf = dtp.scope === "admin";
      /* La misma puerta que el informe en pantalla, y ANTES de crear ningún
         documento: un PDF rechazado que ya existe en Drive no es un rechazo. */
      informeIntentoDeSesion(payload.intentoId, dtp);
      const pdf = generarInformePDFIntento(payload.intentoId, esAdminPdf);
      return respuestaJson({ status: pdf.exito ? "success" : "error", url: pdf.url || "", mensaje: pdf.mensaje || "" });
    }

    if (action === "notas") {
      return respuestaJson(buscarCalificacionesEstudiante(payload.token, payload.correo || null));
    }

    if (action === "progreso") {
      return respuestaJson({ status: "success", data: obtenerProgresoUsuario(payload.token) });
    }

    if (action === "agendar_recordatorio") {
      return respuestaJson(agendarRecordatorioEnCalendar(payload.token, payload.opciones || payload));
    }

    if (action === "preferences_get") return respuestaJson(obtenerPreferenciasUsuario(payload.token));
    if (action === "preferences_set") return respuestaJson(guardarPreferenciasUsuario(payload.token, payload.preferencias));
    if (action === "notifications") return respuestaJson({ status: "success", data: consultarNotificacionesPendientes(payload.token) });

    // ---- Modo familiar / colecciones ----
    if (action === "list_create") return respuestaJson(crearListaFamiliar(payload.token, payload.nombre, payload.descripcion));
    if (action === "list_get") return respuestaJson({ status: "success", data: obtenerListasUsuario(payload.token) });
    if (action === "list_videos") return respuestaJson({ status: "success", data: obtenerVideosDeLista(payload.token, payload.idLista) });
    if (action === "list_add_video") return respuestaJson(añadirVideoALista(payload.token, payload.idLista, payload.idVideo));
    if (action === "list_remove_video") return respuestaJson(eliminarVideoDeLista(payload.token, payload.idLista, payload.idVideo));
    if (action === "list_delete") return respuestaJson(eliminarListaFamiliar(payload.token, payload.idLista));
    if (action === "calendar_event") {
      return respuestaJson(crearEventoCalendarioFamilia(payload.token, payload.idLista, payload.fechaHoraIso, payload.duracionMin, payload.invitados));
    }
    if (action === "invite_member") {
      return respuestaJson(invitarMiembroFamilia(payload.token, payload.correo, payload.nombre, payload.rol || "member"));
    }

    // ---- Administración ----
    if (action === "sync_cloud") {
      validarTokenConScope(payload.token, "admin");
      let resultado = {};
      if (payload.provider === "dropbox") resultado = sincronizarDropboxVideos(payload.token, payload.accessToken, payload.folderPath || "");
      else if (payload.provider === "onedrive") resultado = sincronizarOneDriveVideos(payload.token, payload.accessToken, payload.folderId || "root");
      else if (payload.provider === "drive") resultado = sincronizarCarpetaDriveVideos(payload.token, payload.folderId);
      else throw new Error(t("err_proveedor_nube", { proveedor: payload.provider }));
      return respuestaJson({ status: "success", data: resultado });
    }

    if (action === "modulo_guardar") {
      validarPayload(payload, "modulo_guardar",
        { token: "string", modulo: "object", "modulo.id": "string", "modulo.nombre": "string" });
      validarTokenConScope(payload.token, "admin");
      return respuestaJson({ status: "success", data: guardarModulo(payload.modulo || {}) });
    }
    if (action === "modulo_fuentes") {
      validarTokenConScope(payload.token, "admin");
      return respuestaJson({ status: "success", data: guardarFuentesModulo(payload.moduloId, payload.fuentes || []) });
    }
    if (action === "modulo_banco_generar") {
      validarTokenConScope(payload.token, "admin");
      return respuestaJson({ status: "success", data: generarBancoModulo(payload.moduloId, payload.reemplazar !== false) });
    }
    if (action === "modulo_banco_validar") {
      validarTokenConScope(payload.token, "admin");
      return respuestaJson({ status: "success", validadas: promoverBancoAValidado(payload.moduloId) });
    }
    if (action === "certificaciones_export") {
      validarTokenConScope(payload.token, "admin");
      return respuestaJson({ status: "success", registros: exportarCertificacionesAJson() });
    }
    if (action === "informe_organizacion") {
      validarTokenConScope(payload.token, "admin");
      return respuestaJson({ status: "success", data: generarInformeAgregadoOrganizacion() });
    }

    if (action === "token_create") {
      validarPayload(payload, "token_create", { token: "string", client: "string", scope: "string" });
      return respuestaJson({
        status: "success",
        token: generarTokenAdmin(payload.token, payload.client, payload.scope, payload.email,
          payload.diasValidez === undefined ? 365 : payload.diasValidez)
      });
    }
    if (action === "token_renew") {
      validarPayload(payload, "token_renew", { token: "string", targetToken: "string", dias: "number" });
      return respuestaJson(renovarTokenPermanente(payload.token, payload.targetToken, payload.dias));
    }
    if (action === "token_revoke") return respuestaJson(revocarTokenAdmin(payload.token, payload.targetToken));
    if (action === "token_list") return respuestaJson({ status: "success", data: listarTokens(payload.token) });
    if (action === "set_mode") return respuestaJson(cambiarModoAplicacion(payload.token, payload.modo));

    // ---- Ingesta desde agentes externos ----
    if (action === "append") {
      validarPayload(payload, "append", { token: "string", url: "string", titulo: "string?", idVideo: "string?" });
      validarTokenConScope(payload.token, "append");
      const hoja = obtenerHojaDatos();
      asegurarColumnas(hoja, TOTAL_COLUMNAS);
      const parseado = parsearVideoUniversal(payload.url || "");

      const nueva = new Array(TOTAL_COLUMNAS).fill("");
      nueva[IDX.URL] = payload.url || "";
      nueva[IDX.ID] = payload.idVideo || (parseado ? parseado.id : "id_" + Date.now());
      nueva[IDX.TITULO] = payload.titulo || "Video Agregado";
      nueva[IDX.FUENTE] = parseado ? parseado.plataforma : "";
      nueva[IDX.ECOSISTEMA] = SIN_CLASIFICAR;
      nueva[IDX.AREA] = SIN_CLASIFICAR;
      nueva[IDX.ESTADO] = "🟡 Pendiente";
      nueva[IDX.DIFICULTAD] = "Principiante";
      hoja.appendRow(nueva);

      invalidarCacheAPI();
      logInfo("API", `Video agregado vía API: ${payload.url}`);
      return respuestaJson({ status: "success", row: hoja.getLastRow(), plataforma: nueva[IDX.FUENTE] });
    }

    throw new Error(t("err_accion_post", { accion: action || "(vacía)" }));
  } catch (err) {
    logWarn("API POST", err.message);
    return respuestaJson({ status: "error", message: err.message });
  }
}

/** Asistente conversacional mínimo para comandos de voz del portal. */
function procesarComandoVoz(comandoTexto, emailUsuario) {
  /* Proteger solo la rama de doPost dejaría esta función global como ruta
     alternativa: el mismo error que ya se cometió con las sesiones. */
  exigirOrigenInterno("procesarComandoVoz");
  const comando = (comandoTexto || "").toString().toLowerCase().trim();

  try {
    if (comando.indexOf("pendiente") !== -1) {
      let pendientes = 0;
      iterarCatalogoPorBloques(function (datos) {
        datos.forEach(r => { if ((r[IDX.ESTADO] || "").toString().indexOf("Pendiente") !== -1) pendientes++; });
        return false;
      });
      return { speech: `Tienes ${pendientes} videos pendientes por revisar en el catálogo corporativo.`, datos: { pendientes: pendientes } };
    }

    if (comando.indexOf("busca") !== -1 || comando.indexOf("encuentra") !== -1) {
      const query = comando.replace(/^(busca|encuentra)\s*/i, "");
      const res = busquedaSemanticaHibrida(query, 3);
      if (res.length === 0) return { speech: "No encontré contenidos relacionados con esa consulta." };
      return { speech: "Encontré: " + res.map(x => x.titulo).join("; "), datos: res };
    }

    if (comando.indexOf("estado") !== -1 || comando.indexOf("resumen") !== -1) {
      const hoja = obtenerHojaDatos();
      return { speech: `El catálogo tiene ${Math.max(0, hoja.getLastRow() - 1)} registros. Sistema ${VERSION_SCRIPT} operativo.` };
    }
  } catch (e) {
    logWarn("Asistente", e.message);
  }
  return { speech: "Comando recibido en el Sistema Maestro IA." };
}

/** Permite incluir parciales HTML desde Index.html (<?!= include('archivo') ?>). */
function include(nombreArchivo) {
  return HtmlService.createHtmlOutputFromFile(nombreArchivo).getContent();
}

