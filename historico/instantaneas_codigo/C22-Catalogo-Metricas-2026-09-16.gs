// 9B.7 [F1-6] Mensaje pedagógico
// -------------------------------------------------------------------------------------

function enviarMensajePedagogico(correo, nombre, modulo, resultado, escala) {
  exigirOrigenInterno("enviarMensajePedagogico");
  if (!correo || correo.indexOf("@") === -1) return false;

  const fortalezas = Object.keys(resultado.desempenoAreas)
    .filter(a => resultado.desempenoAreas[a] >= 80).slice(0, 3).join(", ") || "los fundamentos del módulo";
  const brechas = resultado.detalle
    .filter(d => d.resultado !== RESULTADO.ACIERTO)
    .slice(0, 3)
    .map((d, i) => `${i + 1}. ${d.concepto || d.area}: ${(d.configuracionCorrecta || d.causaRaiz || "").toString().slice(0, 140)}`)
    .join("\n");

  let cuerpo;
  try {
    cuerpo = llamarModeloIA(obtenerPrompt("mensaje_pedagogico", {
      estudiante: nombre, porcentaje: resultado.porcentaje, nivel: escala.nivel,
      modulo: modulo ? modulo.nombre : "", fortalezas: fortalezas, brechas: brechas || "ninguna"
    }), obtenerConfigIA().proveedor, 500);
  } catch (e) {
    // Plantilla sin IA: la estructura es fija, así que no depende del modelo.
    cuerpo =
      `Hola ${nombre}, revisamos tu evaluación de ${modulo ? modulo.nombre : "el módulo"}.\n` +
      `Obtuviste ${resultado.porcentaje}% (${escala.nivel}), con buen dominio de ${fortalezas}.\n` +
      (brechas ? `Para llegar al 100% te sugerimos repasar:\n${brechas}\n` : "") +
      `¡Buen trabajo, vas por buen camino!`;
  }

  try {
    MailApp.sendEmail({
      to: correo,
      subject: t("mail_pedagogico_asunto", { curso: modulo ? modulo.nombre : "Evaluación" }),
      htmlBody: "<div style='font-family:Arial,sans-serif;font-size:14px;line-height:1.6'>" +
        cuerpo.replace(/\n/g, "<br>") + "</div>"
    });
  } catch (e) {
    logWarn("Correo", "Mensaje pedagógico no enviado: " + e.message);
  }

  // El mismo mensaje por Telegram o WhatsApp si están configurados.
  const props = PropertiesService.getScriptProperties();
  if (props.getProperty("ALERTAS_TELEGRAM_ACTIVO") === "true") {
    enviarMensajeTelegram(null, cuerpo.slice(0, 900));
  }
  return true;
}

