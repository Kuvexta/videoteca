/** Impide escribir datos personales en una carpeta compartida. No cambia permisos existentes. */
function exigirDestinoCertificadosPrivado_(carpeta) {
  exigirOrigenInterno("exigirDestinoCertificadosPrivado_");
  const propietario = carpeta.getOwner();
  const ejecutor = (Session.getEffectiveUser().getEmail() || "").toLowerCase();
  if (!propietario || !ejecutor || propietario.getEmail().toLowerCase() !== ejecutor ||
      carpeta.getSharingAccess() !== DriveApp.Access.PRIVATE ||
      carpeta.getEditors().length || carpeta.getViewers().length) {
    throw new Error("Certificados: se requiere una carpeta privada del propietario, sin colaboradores. No se emitió el certificado.");
  }
}

function generarCertificadoAprobado(datos) {
  exigirOrigenInterno("generarCertificadoAprobado");
  let copiaSlide = null;
  try {
    const props = PropertiesService.getScriptProperties();
    const templateId = props.getProperty("CERTIFICADO_TEMPLATE_ID");
    if (props.getProperty("CERTIFICADOS_ACTIVOS") === "false" || !templateId) return "";

    // Comprobar la raíz antes de crear la subcarpeta y antes de copiar datos personales.
    exigirDestinoCertificadosPrivado_(obtenerCarpetaRaiz());
    const carpetaCerts = obtenerSubcarpeta("Certificados");
    exigirDestinoCertificadosPrivado_(carpetaCerts);
    const nombreCurso = (datos.tituloExamen || "Módulo")
      .replace(/^(Evaluación|Práctica|Examen)[:\s]*/i, "")
      .replace(/\s*\((Principiante|Intermedio|Avanzado)\)$/i, "").trim();
    const fechaEmision = formatearFecha(new Date(), "dd 'de' MMMM 'de' yyyy");

    copiaSlide = DriveApp.getFileById(templateId).makeCopy(`Temp_Cert_${Date.now()}`, carpetaCerts);
    const pres = SlidesApp.openById(copiaSlide.getId());
    const slide = pres.getSlides()[0];
    slide.replaceAllText("{{Nombre}}", datos.estudiante);
    slide.replaceAllText("{{Curso}}", nombreCurso);
    slide.replaceAllText("{{Fecha}}", fechaEmision);
    slide.replaceAllText("{{Nota}}", `${datos.notaPorcentaje}%`);
    slide.replaceAllText("{{Nivel}}", datos.nivel || "");
    pres.saveAndClose();

    const pdfBlob = copiaSlide.getAs(MimeType.PDF);
    const nombrePDF = `Certificado_${(datos.estudiante || "Alumno").replace(/\s+/g, "_")}_${nombreCurso.replace(/\s+/g, "_")}.pdf`;
    const pdfFile = carpetaCerts.createFile(pdfBlob).setName(nombrePDF);
    // El PDF conserva el acceso privado de la carpeta. El alumno recibe el adjunto
    // por el canal existente; no se publica el nombre ni la nota mediante un enlace.

    enviarEmailDiplomaEstudiante(datos.correo, datos.estudiante, nombreCurso, datos.notaPorcentaje, datos.nivel, pdfBlob);
    logInfo("Certificados", `Diploma emitido a ${datos.estudiante} (${datos.notaPorcentaje}%).`);
    return pdfFile.getUrl();
  } catch (err) {
    logError("Certificados", "Error generando diploma: " + err.message);
    // [OPT-10] Un fallo transitorio de Drive/Slides no debe costarle el diploma
    // a quien ya aprobó: se reintenta después con los mismos datos.
    if (!datos.__reintento) {
      encolarTareaDiferida("certificado", Object.assign({}, datos, { __reintento: true }),
        "Emisión de certificado fallida: " + err.message);
    }
    return "";
  } finally {
    if (copiaSlide) { try { copiaSlide.setTrashed(true); } catch (e) { /* ignora */ } }
  }
}

function enviarEmailDiplomaEstudiante(correo, estudiante, curso, nota, nivel, pdfBlob) {
  exigirOrigenInterno("enviarEmailDiplomaEstudiante");
  if (!correo) return false;
  try {
    MailApp.sendEmail({
      to: correo,
      subject: t("mail_diploma_asunto", { curso: curso }),
      htmlBody: t("mail_diploma_cuerpo", { estudiante: estudiante, curso: curso, nota: nota, nivel: nivel || "" }),
      attachments: [pdfBlob.setName(`Certificado_${curso}.pdf`)]
    });
    return true;
  } catch (err) {
    logWarn("Correo", "No se pudo enviar el diploma: " + err.message);
    return false;
  }
}

