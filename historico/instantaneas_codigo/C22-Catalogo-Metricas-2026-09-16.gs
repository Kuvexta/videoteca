function solicitarYGuardarClave(titulo, mensaje, proveedor) {
  exigirOrigenInterno("solicitarYGuardarClave");   // cubre los ocho configuradores de una línea
  const ui = SpreadsheetApp.getUi();
  const resp = ui.prompt(titulo, mensaje, ui.ButtonSet.OK_CANCEL);
  if (resp.getSelectedButton() !== ui.Button.OK) return false;
  const valor = resp.getResponseText().trim();
  if (!valor) return false;
  guardarApiKey_(proveedor, valor);
  notificarUsuario("Credencial de " + proveedor + " guardada de forma segura.", "Seguridad", 3);
  return true;
}

