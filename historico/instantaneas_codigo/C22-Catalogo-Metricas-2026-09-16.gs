  "Ofimática y Productividad||Hojas de Cálculo":  ["Datos y Analítica", "Excel y Hojas de Cálculo", null],
  "Ofimática y Productividad||Documentación":    ["Automatización y Productividad", "Documentación", null],
  "Ofimática y Productividad||Gestión y Método": ["Automatización y Productividad", "Gestión de Proyectos", null],

  "Hotelería||Recepción y Reservas":         ["Hotelería y Hospitalidad", "Recepción y Reservas", null],
  "Hotelería||Housekeeping y Mantenimiento": ["Hotelería y Hospitalidad", "Housekeeping", null],
  "Hotelería||Alimentos y Bebidas":          ["Hotelería y Hospitalidad", "Alimentos y Bebidas", null],
  "Hotelería||Distribución y Revenue":       ["Hotelería y Hospitalidad", "Revenue y Distribución", null],
  "Hotelería||General":                      ["Hotelería y Hospitalidad", "Operaciones", null],

  "Retail y Ferretería||Operación de Tienda": ["Retail, Ferretería y Comercio", "Operación de Tienda", null],
  "Retail y Ferretería||Abastecimiento":      ["Retail, Ferretería y Comercio", "Compras y Proveedores", null],
  "Retail y Ferretería||Producto Técnico":    ["Retail, Ferretería y Comercio", "Producto Técnico", null],

  // «Fuera de Alcance» deja de ser un ecosistema. Cada área se va a su
  // ecosistema TEMÁTICO de verdad, y lo que la aparta del temario pasa a ser
  // la faceta Alcance. El tercer elemento de estas entradas es el alcance.
  "Fuera de Alcance||Música y Espectáculos":      ["Cultura y Entretenimiento", "Música y Espectáculos", null],
  "Fuera de Alcance||Eventos y Festivales":       ["Cultura y Entretenimiento", "Eventos y Festivales", null],
  "Fuera de Alcance||Bodas y Celebraciones":      ["Cultura y Entretenimiento", "Bodas y Celebraciones", null],
  "Fuera de Alcance||Entretenimiento y Cine":     ["Cultura y Entretenimiento", "Cine y Videojuegos", null],
  "Fuera de Alcance||Noticias y Comunidad Local": ["Cultura y Entretenimiento", "Noticias Locales", null],
  "Fuera de Alcance||Deportes":                   ["Cultura y Entretenimiento", "Deportes", null],
  "Fuera de Alcance||Religioso y Comunitario":    ["Cultura y Entretenimiento", "Religioso y Comunitario", null],
  "Fuera de Alcance||Instrumentos Musicales":     ["Cultura y Entretenimiento", "Instrumentos Musicales", null],
  "Fuera de Alcance||Idiomas":                    ["Idiomas", "Aprendizaje de Idiomas", null],
  "Fuera de Alcance||Ciencia y Divulgación":      ["Ciencia y Tecnología", "Divulgación Científica", null],
  "Fuera de Alcance||Diseño 3D y Animación":      ["Diseño y Creatividad", "Diseño 3D y Animación", null],
  "Fuera de Alcance||Inmobiliaria y Ventas":      ["Contenido Comercial", "Anuncios Inmobiliarios", null],
  // El ecosistema legado de la heurística musical, antes de que se unificara.
  "Música y Cultura||*":                          ["Cultura y Entretenimiento", "Música y Espectáculos", null]
};

/** Alcance que le corresponde a cada ecosistema v2 no certificable. */
const ALCANCE_POR_ECOSISTEMA_V2 = {
  "Cultura y Entretenimiento": ALCANCE_NO_CERTIFICABLE,
  "Contenido Comercial": ALCANCE_NO_CERTIFICABLE,
  "Ciencia y Tecnología": ALCANCE_REFERENCIA,
  "Idiomas": ALCANCE_REFERENCIA,
  "Diseño y Creatividad": ALCANCE_REFERENCIA
};
/** Excepción: las clases de instrumento sí se indexan, no son entretenimiento. */
/* Áreas que son Referencia aunque su ecosistema sea Certificable.
 * [v2.6.18] Entran las dos de SST que la especificación fija como Referencia.
 * No es opcional: `migrarCatalogoAV2` decide el Alcance por ÁREA excepcional →
 * ECOSISTEMA → regla, mientras que `resolverFacetasDeFila` lo toma del consenso
 * de la ruta. Sin registrarlas aquí, las dos funciones daban resultados
 * distintos para la misma fila —Certificable la una, Referencia la otra— según
 * por dónde hubiera entrado. probe_69 existe justamente para que esa divergencia
 * no pase inadvertida, y fue quien la encontró. */
const AREAS_REFERENCIA_V2 = {
  "Instrumentos Musicales": 1,
  "Normativa y Cumplimiento SST": 1,
  "Tecnología y Software SST": 1
};

/**
 * Migra el catálogo entero a la taxonomía v2.
 *
 * Qué hace y qué NO hace, porque la diferencia importa:
 *   SÍ  traduce nombres de ecosistema y área según MAPA_MIGRACION_V2.
 *   SÍ  rellena las cinco facetas nuevas cuando están vacías.
 *   NO  reclasifica: no mira el título ni ejecuta el motor. Una fila que
 *       alguien corrigió a mano conserva su corrección, solo que con el nombre
 *       nuevo. Reclasificar es otro botón, y va DESPUÉS.
 *
 * Idempotente: pasarla dos veces no cambia nada la segunda vez, porque los
 * nombres v2 ya no están en el mapa como origen.
 *
 * [v2.6.8] La comprobación de rutas fuera de la v2 se hace AQUÍ, justo antes de
 * escribir, y no en el menú. Si `sinMapa` trae algo y no hay excepción activa,
 * no se escribe nada y se devuelve `bloqueada: true`.
 *
 * @param {boolean} soloSimular  Si es true, cuenta pero no escribe.
 * @return {{filas:number, tocadas:number, sinMapa:Object, respaldo:string, bloqueada:boolean}}
 */
function migrarCatalogoAV2(soloSimular = false) {
  exigirOrigenInterno("migrarCatalogoAV2");
  const hoja = obtenerHojaDatos();
  asegurarColumnas(hoja, TOTAL_COLUMNAS);
  const ultima = hoja.getLastRow();
  if (ultima < 2) return { filas: 0, tocadas: 0, sinMapa: {}, respaldo: "", bloqueada: false };

  /* El respaldo se decide DESPUÉS de saber si hay algo que cambiar. Antes se
     creaba siempre, así que reejecutar la migración —que no toca ni una fila la
     segunda vez— dejaba una hoja de respaldo nueva cada vez, y dos ejecuciones
     dentro del mismo minuto chocaban por el nombre. Idempotente de verdad
     significa que la segunda pasada no deja rastro. */
  let respaldo = "";
  const crearRespaldo = () => {
    if (respaldo) return respaldo;
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const base = "_Respaldo_v1_" + Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "yyyyMMdd_HHmm");
    let nombre = base, n = 2;
    while (ss.getSheetByName(nombre)) { nombre = base + "_" + n; n++; }
    hoja.copyTo(ss).setName(nombre).hideSheet();
    respaldo = nombre;
    return nombre;
  };

  const rango = hoja.getRange(2, 1, ultima - 1, TOTAL_COLUMNAS);
  const datos = rango.getValues();
  const sinMapa = {};
  let tocadas = 0;

  for (let i = 0; i < datos.length; i++) {
    const fila = datos[i];
    const ecoV1  = (fila[IDX.ECOSISTEMA] || "").toString().trim();
    const areaV1 = (fila[IDX.AREA] || "").toString().trim();
    if (!ecoV1 && !areaV1) continue;

    let cambiada = false;

    /* Sin clasificar NO se traduce: sigue significando «todavía no lo sé».
       Lo único que se le pone es el alcance pendiente, que es exactamente eso
       dicho en la faceta correcta. */
    if (ecoV1 && ecoV1 !== SIN_CLASIFICAR) {
      const destino = MAPA_MIGRACION_V2[ecoV1 + "||" + areaV1] ||
                      MAPA_MIGRACION_V2[ecoV1 + "||*"];
      if (destino) {
        if (destino[0] && destino[0] !== ecoV1) { fila[IDX.ECOSISTEMA] = destino[0]; cambiada = true; }
        if (destino[1] && destino[1] !== areaV1) { fila[IDX.AREA] = destino[1]; cambiada = true; }
        if (destino[2] && !(fila[IDX.JURISDICCION] || "").toString().trim()) {
          fila[IDX.JURISDICCION] = destino[2]; cambiada = true;
        }
      }

      /* La comprobación va DESPUÉS de traducir y mira la ruta RESULTANTE, exista
         o no una entrada en el mapa. Comprobarla solo cuando no había destino
         dejaba un segundo agujero: un comodín como «...DIAN||*» sí encuentra
         destino, traduce el ecosistema y conserva el área vieja, con lo que
         producía una ruta inválida sin que `sinMapa` se enterara. El primer
         falso «todo traducido» venía del origen; este venía del destino. Así un
         mapa defectuoso tampoco puede engañar a la simulación. */
      const ecoTrasMapa  = (fila[IDX.ECOSISTEMA] || "").toString().trim();
      const areaTrasMapa = (fila[IDX.AREA] || "").toString().trim();
      if (!rutasV2Conocidas()[ecoTrasMapa + "||" + areaTrasMapa]) {
        const etiqueta = destino
          ? (ecoV1 + " / " + areaV1 + "  →  " + ecoTrasMapa + " / " + areaTrasMapa + "  (destino inválido)")
          : (ecoV1 + " / " + areaV1 + "  (sin entrada en el mapa)");
        sinMapa[etiqueta] = (sinMapa[etiqueta] || 0) + 1;
      }
    }

    // ---- Facetas: solo se rellenan las vacías ----
    const ecoFinal  = (fila[IDX.ECOSISTEMA] || "").toString().trim();
    const areaFinal = (fila[IDX.AREA] || "").toString().trim();

    const rutaReconocida = Boolean(ecoFinal) && ecoFinal !== SIN_CLASIFICAR &&
      Boolean(rutasV2Conocidas()[ecoFinal + "||" + areaFinal]);

    let alcDeseado;
    if (!ecoFinal || ecoFinal === SIN_CLASIFICAR) alcDeseado = ALCANCE_PENDIENTE;
    else if (AREAS_REFERENCIA_V2[areaFinal]) alcDeseado = ALCANCE_REFERENCIA;
    else if (ALCANCE_POR_ECOSISTEMA_V2[ecoFinal]) alcDeseado = ALCANCE_POR_ECOSISTEMA_V2[ecoFinal];
    else if (!rutaReconocida) {
      /* Ruta que ni se pudo traducir ni la semilla v2 puede producir: es
         exactamente una de las que salen en `sinMapa`. Certificable por defecto
         sería lo peor posible —contenido que nadie ha mirado entrando en
         exámenes—, así que queda pendiente hasta que una persona decida. */
      alcDeseado = ALCANCE_PENDIENTE;
    }
    else alcDeseado = ALCANCE_CERTIFICABLE;

    const alcActual = (fila[IDX.ALCANCE] || "").toString().trim();
    if (!alcActual) {
      fila[IDX.ALCANCE] = alcDeseado; cambiada = true;
    } else if (!rutaReconocida && alcActual === ALCANCE_CERTIFICABLE) {
      /* Repara una migración anterior. Una versión previa ponía Certificable a
         las rutas desconocidas, y como todo el relleno de facetas solo actuaba
         sobre celdas VACÍAS, volver a migrar no lo corregía: la fila se quedaba
         certificable para siempre. Solo se pisa este caso —ruta desconocida y
         valor exactamente Certificable—; cualquier alcance que alguien haya
         puesto a mano sobre una ruta válida se respeta. */
      fila[IDX.ALCANCE] = ALCANCE_PENDIENTE; cambiada = true;
    }
    if (!(fila[IDX.INDUSTRIA] || "").toString().trim()) {
      fila[IDX.INDUSTRIA] = INDUSTRIA_TRANSVERSAL; cambiada = true;
    }
    if (!(fila[IDX.JURISDICCION] || "").toString().trim()) {
      /* Se mira el título por si delata un país: es la faceta que más se va a
         consultar y dejarla en «Global» para un video de la DIAN sería mentir. */
      fila[IDX.JURISDICCION] = detectarJurisdiccion(fila[IDX.TITULO], "") || JURISDICCION_GLOBAL;
      cambiada = true;
    }
    if (!(fila[IDX.HERRAMIENTA] || "").toString().trim() && ecoFinal === "Odoo ERP") {
      fila[IDX.HERRAMIENTA] = "Odoo"; cambiada = true;
    }
    if (!(fila[IDX.TIPO_CONTENIDO] || "").toString().trim()) {
      fila[IDX.TIPO_CONTENIDO] = ALCANCE_POR_ECOSISTEMA_V2[ecoFinal] === ALCANCE_NO_CERTIFICABLE
        ? "Entretenimiento" : "Tutorial";
      cambiada = true;
    }

    if (cambiada) tocadas++;
  }

  /* [v2.6.8] EL GATE VIVE AQUÍ, no en el menú.
     Hasta la 6.7 la comprobación estaba en migrarCatalogoAV2UI(): calculaba
     `sinMapa` con una simulación, y si había rutas fuera de la v2 no ofrecía el
     botón. Funcionaba, pero protegía la RUTA, no la ESCRITURA, y eso deja dos
     agujeros que ninguna advertencia cierra:

       a) Cualquiera que llame a migrarCatalogoAV2(false) directamente —una
          función futura, un trigger, un agente— escribía sin pasar por el menú.
          Una protección que depende de que todos los llamadores usen la puerta
          correcta es una convención, no una protección.
       b) Entre la simulación y el clic hay una ventana. Si el catálogo cambia
          en medio, la segunda pasada recalculaba `sinMapa` correctamente… y
          escribía igual, porque ya nadie volvía a mirarlo. Es un TOCTOU de
          manual: se comprueba una cosa y se usa otra.

     La regla de seguridad tiene que estar pegada al setValues(). El menú
     conserva su precheck porque mejora la experiencia —informa antes de
     preguntar—, pero ha pasado a ser una comodidad: si desapareciera, la
     migración seguiría estando protegida. */
  let bloqueada = false;
  if (!soloSimular && Object.keys(sinMapa).length > 0) {
    const props = PropertiesService.getScriptProperties();
    const aceptar = props.getProperty("MIGRACION_V2_ACEPTAR_RUTAS") === "true";

    if (!aceptar) {
      logWarn("Migración v2",
        `Escritura bloqueada: ${Object.keys(sinMapa).length} rutas fuera de la taxonomía v2. ` +
        resumenRutasSinMapa(sinMapa));
      return { filas: datos.length, tocadas: tocadas, sinMapa: sinMapa, respaldo: "", bloqueada: true };
    }

    /* La excepción se CONSUME. Antes la propiedad se leía y no se borraba nunca:
       activarla una vez para aceptar tres filas raras la dejaba activa para
       siempre, y seis meses después una ruta problemática completamente distinta
       quedaba autorizada sola. Habría un aviso en el registro, sí, pero ninguna
       decisión humana nueva detrás. Borrándola aquí, cada excepción cuesta una
       decisión nueva y explícita. */
    props.deleteProperty("MIGRACION_V2_ACEPTAR_RUTAS");
    /* Y se registra QUÉ se aceptó, no solo que se aceptó algo. «Continuando con
       rutas fuera de la v2» no permite auditar nada tres meses después: no dice
       si lo autorizado fueron tres filas de un área vieja o media taxonomía. */
    logWarn("Migración v2",
      "Excepción CONSUMIDA (MIGRACION_V2_ACEPTAR_RUTAS, un solo uso). Rutas aceptadas: " +
      resumenRutasSinMapa(sinMapa));
    bloqueada = false;
  }

  if (!soloSimular && tocadas > 0) {
    crearRespaldo();
    rango.setValues(datos);
    SpreadsheetApp.flush();
    invalidarCacheAPI();
  }
  logInfo("Migración v2", `${datos.length} filas revisadas, ${tocadas} actualizadas` +
    (respaldo ? `, respaldo en «${respaldo}»` : " (simulación)"));
  return { filas: datos.length, tocadas: tocadas, sinMapa: sinMapa, respaldo: respaldo, bloqueada: bloqueada };
}

/**
 * Resumen de una línea de las rutas fuera de la v2, para el registro.
 *
 * Va con el número de filas de cada una porque es lo que decide si una excepción
 * era razonable: «3 filas de un área que ya no existe» y «800 filas» son dos
 * decisiones muy distintas escritas con las mismas palabras.
 */
function resumenRutasSinMapa(sinMapa) {
  const claves = Object.keys(sinMapa || {});
  if (!claves.length) return "(ninguna)";
  const texto = claves.slice(0, 8).map(k => `«${k}» ×${sinMapa[k]}`).join(" | ");
  return texto + (claves.length > 8 ? ` | … y ${claves.length - 8} más` : "");
}

/**
 * Rutas «Ecosistema||Área» que la semilla v2 puede producir.
 *
 * Validar solo el ECOSISTEMA no basta y por poco cuesta caro: «Odoo ERP» e
 * «Inteligencia Artificial» conservan su nombre entre la v1 y la v2, pero casi
 * todas sus áreas cambiaron. Una fila como «Odoo ERP / Área vieja que no está en
 * el mapa» no encontraba destino y, como su ecosistema sí era conocido, tampoco
 * entraba en `sinMapa`: el diálogo decía «todas las filas tienen traducción»
 * cuando no era verdad, y eso es justo la comprobación de la que depende decidir
 * si se ejecuta la migración.
 *
 * Se construye una vez, a partir de la propia semilla, para que no pueda
 * desincronizarse de la semilla.
 */
let _rutasV2Cache = null;
function rutasV2Conocidas() {
  if (_rutasV2Cache) return _rutasV2Cache;
  _rutasV2Cache = {};
  for (let i = 0; i < SEMILLA_TAXONOMIA.length; i++) {
    _rutasV2Cache[SEMILLA_TAXONOMIA[i][0] + "||" + SEMILLA_TAXONOMIA[i][1]] = 1;
  }
  return _rutasV2Cache;
}


/** Migración v2 desde el menú, con simulación previa obligatoria. */
function migrarCatalogoAV2UI() {
  exigirOrigenInterno("migrarCatalogoAV2UI");
  const ui = SpreadsheetApp.getUi();
  const previo = migrarCatalogoAV2(true);
  const pendientes = Object.keys(previo.sinMapa);

  /* Si alguna ruta no pertenece a la taxonomía v2, la migración NO se ofrece:
     se informa y se sale. No es un aviso más fuerte, es que no hay botón que
     pulsar. Un diálogo Sí/No con una advertencia encima se salta pulsando Sí, y
     eso es exactamente lo que no debe poder hacerse aquí — ni por prisa ni por
     un agente automatizando clics. Cada ruta que aparezca es o una entrada que
     falta en el mapa, o filas de la hoja con nombres que la taxonomía nunca
     tuvo; las dos cosas se arreglan antes, no después.

     La salida de emergencia es deliberada y deja rastro: hay que poner a mano la
     propiedad de script MIGRACION_V2_ACEPTAR_RUTAS = "true". No está en ningún
     menú a propósito, y desde la 6.8 se gasta al usarla: vale para UNA
     migración, no para siempre.

     [v2.6.8] Este bloque ya NO es la protección, es el aviso. La protección de
     verdad está dentro de migrarCatalogoAV2(), pegada al setValues(). Aquí solo
     se lee la propiedad —leer no la consume; quien la consume es el mutador—
     para poder explicar antes de preguntar. */
  const aceptarRutas = PropertiesService.getScriptProperties()
    .getProperty("MIGRACION_V2_ACEPTAR_RUTAS") === "true";

  if (pendientes.length && !aceptarRutas) {
    logWarn("Migración v2", `Bloqueada: ${pendientes.length} rutas fuera de la taxonomía v2.`);
    alertarUsuario(
      `Filas en el catálogo: ${previo.filas}\n` +
      `Rutas que NO pertenecen a la taxonomía v2: ${pendientes.length}\n\n` +
      pendientes.slice(0, 12).map(k => "  • " + k + "   (" + previo.sinMapa[k] + " filas)").join("\n") +
      (pendientes.length > 12 ? `\n  … y ${pendientes.length - 12} más (ver el registro)` : "") +
      "\n\nLa migración NO se ha ejecutado y no se ha tocado nada.\n\n" +
      "«sin entrada en el mapa» → falta traducir esa ruta.\n" +
      "«destino inválido» → el mapa la traduce a algo que la semilla no produce.\n\n" +
      "Migrar con estas rutas dejaría esas filas con nombres que ninguna regla\n" +
      "reconoce, y el reclasificado forzado posterior las mandaría a «" + SIN_CLASIFICAR + "».",
      "Migración v2 detenida");
    return;
  }
  if (pendientes.length && aceptarRutas) {
    logWarn("Migración v2", "Continuando con rutas fuera de la v2 por MIGRACION_V2_ACEPTAR_RUTAS.");
  }

  const r = ui.alert("Migrar a la taxonomía v2",
    `Filas en el catálogo: ${previo.filas}\n` +
    `Filas que cambiarían: ${previo.tocadas}\n\n` +
    (pendientes.length
      ? `⚠️ ${pendientes.length} rutas fuera de la taxonomía v2, aceptadas a propósito.\n\n`
      : "✅ Todas las rutas resultantes pertenecen a la taxonomía v2.\n\n") +
    "Esto NO reclasifica: solo traduce los nombres viejos a los nuevos y rellena\n" +
    "las cinco facetas. Las correcciones que hayas hecho a mano se conservan.\n\n" +
    (previo.tocadas > 0
      ? "Se guarda un respaldo oculto del catálogo antes de escribir.\n\n"
      : "Nada que cambiar: no se creará respaldo ni se tocará la hoja.\n\n") +
    "¿Continuar?", ui.ButtonSet.YES_NO);
  if (r !== ui.Button.YES) return;

  const res = migrarCatalogoAV2(false);

  /* [v2.6.8] La ventana entre la simulación y este clic. El catálogo puede haber
     cambiado mientras el diálogo estaba abierto —otra pestaña, un trigger, una
     importación—, así que el mutador vuelve a mirar y puede negarse aunque el
     precheck de arriba viniera limpio. Cuando eso pasa NO se ha tocado nada. */
  if (res.bloqueada) {
    const rutas = Object.keys(res.sinMapa);
    alertarUsuario(
      `Filas en el catálogo: ${res.filas}\n` +
      `Rutas que NO pertenecen a la taxonomía v2: ${rutas.length}\n\n` +
      rutas.slice(0, 12).map(k => "  • " + k + "   (" + res.sinMapa[k] + " filas)").join("\n") +
      (rutas.length > 12 ? `\n  … y ${rutas.length - 12} más (ver el registro)` : "") +
      "\n\nLa migración NO se ha ejecutado y no se ha tocado nada.\n\n" +
      "Esto ha aparecido DESPUÉS de la simulación: el catálogo cambió mientras\n" +
      "el diálogo estaba abierto. Vuelve a lanzar la migración para ver el\n" +
      "estado actual.",
      "Migración v2 detenida");
    return;
  }

  alertarUsuario(
    `Migración terminada.\n\n` +
    `Filas revisadas: ${res.filas}\n` +
    `Filas actualizadas: ${res.tocadas}\n` +
    (res.respaldo ? `Respaldo: «${res.respaldo}» (hoja oculta)\n\n` : "Sin cambios: no hizo falta respaldo.\n\n") +
    "OJO: el paso siguiente, «Reclasificar → Sí (forzar)», SÍ sustituye las\n" +
    "correcciones manuales por el resultado de las reglas. Es lo que se quiere\n" +
    "para fijar una línea base, pero conviene saberlo antes de darle.\n\n" +
    "Ahora: «Reponer reglas de fábrica» → SÍ, y después «Reclasificar catálogo» → Sí (forzar).",
    "Taxonomía v2");
}

// -------------------------------------------------------------------------------------
// 4.10 Verificación posterior a la migración v2
// -------------------------------------------------------------------------------------

/**
 * Revisa el catálogo YA migrado y reclasificado, y escribe las anomalías en una
 * hoja aparte para poder pinchar fila por fila.
 *
 * Existe porque «revisar una muestra» sobre 4.000 filas a ojo no es una
 * revisión: es mirar las primeras veinte y confiar. Esto busca exactamente los
 * cinco sitios donde la v2 puede haberse equivocado en silencio, y no toca nada
 * — solo señala. Es de sola lectura a propósito: el criterio de qué hacer con
 * cada anomalía es de quien conoce el contenido, no del script. No toca el
 * catálogo: lo único que escribe es la hoja «_Verificacion_V2».
 *
 * @return {{filas:number, anomalias:number, resumen:Object}}
 */
function verificarMigracionV2() {
  exigirOrigenInterno("verificarMigracionV2");
  const hoja = obtenerHojaDatos();
  const ultima = hoja.getLastRow();
  if (ultima < 2) return { filas: 0, anomalias: 0, resumen: {} };

  const datos = hoja.getRange(2, 1, ultima - 1, TOTAL_COLUMNAS).getValues();
  const hallazgos = [];   // [motivo, fila, titulo, eco, area, alcance, detalle]
  const resumen = {
    porEcosistema: {}, porAlcance: {}, sinFacetas: 0,
    ecosistemasV1: {}, sinClasificar: 0, pendientes: 0,
    // [v2.6.16] Se cuentan aparte; ver el comentario del bucle.
    enError: 0, descartadas: 0, sinMetadatos: 0, noDisponibles: 0
  };

  for (let i = 0; i < datos.length; i++) {
    const r = datos[i];
    const nFila = i + 2;
    const titulo = (r[IDX.TITULO] || "").toString().trim();
    if (!titulo && !(r[IDX.URL] || "").toString().trim()) continue;

    const eco  = (r[IDX.ECOSISTEMA] || "").toString().trim();
    const area = (r[IDX.AREA] || "").toString().trim();
    const alc  = (r[IDX.ALCANCE] || "").toString().trim();
    const jur  = (r[IDX.JURISDICCION] || "").toString().trim();
    const ind  = (r[IDX.INDUSTRIA] || "").toString().trim();
    const est  = (r[IDX.ESTADO] || "").toString().trim();

    /* [v2.6.16] Una fila en «❌ Error» o «⚪ Descartado» no tiene título porque
     * nunca se pudo leer el video, o porque su URL no era un video. Que no esté
     * clasificada no es un fallo de la taxonomía: no hay nada que clasificar.
     *
     * Contarlas como «Sin clasificar» + «Sin Alcance» hacía dos daños a la vez.
     * Inflaba el informe con ruido —desde 6.15 son casi 4.000 filas, que habrían
     * enterrado las anomalías de verdad— y sugería la solución equivocada:
     * escribir reglas nuevas para un enlace roto no arregla el enlace. Se
     * cuentan aparte, como lo que son: trabajo operativo, no taxonómico. */
    if (est === "❌ Error" || est === "⚪ Descartado") {
      if (est === "❌ Error") resumen.enError++; else resumen.descartadas++;
      continue;
    }
    /* [v2.6.19] El tercer estado operacional, que 6.13 creó y este verificador
       todavía no conocía: la fila degradada. Sigue en «🟡 Pendiente» —es una
       fila viva— pero no tiene título porque la plataforma no lo publica o el
       video ya no está. Contarla como «Sin clasificar» + «Sin Alcance» vuelve a
       sugerir la solución equivocada: no faltan reglas, falta el texto que las
       reglas leerían. Se arregla escribiendo el título a mano. */
    if (!titulo) {
      /* [v2.6.20] Las dos clases se cuentan por separado porque piden acciones
         distintas: una se arregla escribiendo el título, la otra cambiando el
         enlace. Juntarlas hacía que el informe recomendara titular videos
         borrados. */
      const clase = claseDeFilaDegradada(r[IDX.ERROR]);
      if (clase === "titulo") { resumen.sinMetadatos++; continue; }
      if (clase === "no-disponible") { resumen.noDisponibles++; continue; }
    }

    resumen.porEcosistema[eco || "(vacío)"] = (resumen.porEcosistema[eco || "(vacío)"] || 0) + 1;
    resumen.porAlcance[alc || "(vacío)"] = (resumen.porAlcance[alc || "(vacío)"] || 0) + 1;

    const meter = (motivo, detalle) => hallazgos.push([motivo, nFila, titulo.slice(0, 90), eco, area, alc, detalle]);

    // --- 0. Restos de la v1 que la migración no supo traducir ---------------
    // Se compara la RUTA completa, no solo el ecosistema: «Odoo ERP» sobrevive
    // de la v1 a la v2, pero casi todas sus áreas cambiaron de nombre.
    if (eco && eco !== SIN_CLASIFICAR && !rutasV2Conocidas()[eco + "||" + area]) {
      resumen.ecosistemasV1[eco + " / " + area] = (resumen.ecosistemasV1[eco + " / " + area] || 0) + 1;
      meter("Ruta no es de la v2", "Quedó «" + eco + " / " + area + "»: falta una entrada en MAPA_MIGRACION_V2");
    }
    /* Sin clasificar y Pendiente de revisión NO son errores, pero sí trabajo
       por hacer, y esta hoja existe para que ese trabajo sea visible. Dejarlos
       fuera —como estaban— significaba que el reclasificado forzado podía dejar
       cientos de filas en el limbo y el informe salir «limpio». */
    if (eco === SIN_CLASIFICAR || area === SIN_CLASIFICAR || !eco) {
      resumen.sinClasificar++;
      meter("Sin clasificar", "Ninguna de las " + SEMILLA_TAXONOMIA.length +
        " reglas la reconoció: necesita regla nueva o descarte");
    }
    if (alc === ALCANCE_PENDIENTE) {
      resumen.pendientes++;
      meter("Pendiente de revisión", "Alcance sin decidir: no entra en módulos ni exámenes hasta resolverlo");
    }
    // --- Faceta obligatoria sin valor ---------------------------------------
    if (!alc) { resumen.sinFacetas++; meter("Sin Alcance", "Ninguna fila debería quedar sin alcance tras migrar"); }

    // --- 1. Música que ninguna regla reclamó ---------------------------------
    if (esFilaMusical(r) && alc === ALCANCE_CERTIFICABLE) {
      meter("Musical marcado certificable",
        "Parece música y está como certificable: entraría en exámenes");
    }
    if (esFilaMusical(r) && eco !== ECOSISTEMA_CULTURA && eco !== SIN_CLASIFICAR && eco) {
      meter("Musical fuera de Cultura", "Parece música pero quedó en «" + eco + "»");
    }

    // --- 2. La frontera Referencia / No certificable -------------------------
    if (eco === "Ciencia y Tecnología" && alc !== ALCANCE_REFERENCIA) {
      meter("Ciencia con alcance inesperado", "Se esperaba «" + ALCANCE_REFERENCIA + "», hay «" + alc + "»");
    }
    if (ALCANCE_POR_ECOSISTEMA_V2[eco] && alc === ALCANCE_CERTIFICABLE) {
      meter("No certificable marcado certificable",
        "«" + eco + "» nunca debería certificar");
    }

    // --- 3. Fiscal multinacional --------------------------------------------
    if (eco === "Cumplimiento Electrónico y Fiscal") {
      const detectada = detectarJurisdiccion(titulo, "");
      if (!jur) {
        meter("Fiscal sin país", "Normativa siempre es de alguien: revisar jurisdicción");
      } else if (jur === JURISDICCION_GLOBAL && detectada === JURISDICCION_GLOBAL) {
        /* El detector devuelve Global cuando el título nombra DOS países. Eso es
           una decisión deliberada —contenido multinacional—, no un dato que
           falte. Se informa igual, pero con su propio motivo: mezclarlo con los
           que sí les falta el país convertía la lista en ruido. */
        meter("Fiscal multinacional (Global)", "El título nombra varios países: Global es correcto, confirmar");
      } else if (jur === JURISDICCION_GLOBAL) {
        meter("Fiscal sin país", "Quedó en Global y el título no delata ningún país: revisar");
      } else if (detectada && detectada !== JURISDICCION_GLOBAL && detectada !== jur) {
        meter("Fiscal con país discrepante",
          "El título sugiere «" + detectada + "» y la fila dice «" + jur + "»");
      }
    }

    /* --- 4. Odoo + MCP: el empate que costó arreglar -------------------------
       [v2.6.8] El criterio ya no está escrito aquí: lo decide esCasoOdooMCP(),
       la MISMA función que usa el motor para desempatar. Tenerlo dos veces era
       garantizar que un día dijeran cosas distintas y el verificador señalara
       como error justo lo que el motor acababa de hacer bien. */
    if (esCasoOdooMCP(titulo) &&
        !(eco === RUTA_ODOO_MCP.ecosistema && area === RUTA_ODOO_MCP.area)) {
      meter("Odoo + MCP mal ubicado",
        "Se esperaba «" + RUTA_ODOO_MCP.ecosistema + " / " + RUTA_ODOO_MCP.area +
        "», hay «" + eco + " / " + area + "»");
    }

    // --- 5. Verticales: la industria vive ahora en su columna ---------------
    if (eco === "Odoo ERP" && area === "Industrias y Verticales" &&
        (!ind || ind === INDUSTRIA_TRANSVERSAL)) {
      meter("Vertical sin industria", "Un vertical sin industria no se puede filtrar por industria");
    }
    if (eco === "Odoo ERP" && (r[IDX.HERRAMIENTA] || "").toString().trim() !== "Odoo") {
      meter("Odoo sin herramienta", "Toda fila de Odoo debería llevar Herramienta = Odoo");
    }
  }

  // --- Volcado a su propia hoja ---------------------------------------------
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let destino = ss.getSheetByName("_Verificacion_V2");
  if (!destino) destino = ss.insertSheet("_Verificacion_V2", ss.getSheets().length);
  destino.clear();
  const cab = ["Motivo", "Fila", "Título", "Ecosistema", "Área", "Alcance", "Detalle"];
  destino.getRange(1, 1, 1, cab.length).setValues([cab])
    .setFontWeight("bold").setBackground("#1e293b").setFontColor("#ffffff");
  if (hallazgos.length > 0) {
    /* Ordenadas por motivo: revisar veinte «Fiscal sin país» seguidas es una
       decisión que se toma una vez; salteadas entre otros motivos son veinte. */
    hallazgos.sort((a, b) => a[0] < b[0] ? -1 : (a[0] > b[0] ? 1 : a[1] - b[1]));
    destino.getRange(2, 1, hallazgos.length, cab.length).setValues(hallazgos);
  } else {
    destino.getRange(2, 1).setValue("Sin anomalías: la migración quedó limpia.");
  }
  destino.setFrozenRows(1);
  destino.autoResizeColumns(1, cab.length);

  logInfo("Verificación v2", `${datos.length} filas revisadas, ${hallazgos.length} anomalías.`);
  return { filas: datos.length, anomalias: hallazgos.length, resumen: resumen };
}

/** Verificación posterior a la migración, desde el menú. */
function verificarMigracionV2UI() {
  exigirOrigenInterno("verificarMigracionV2UI");
  const res = verificarMigracionV2();
  if (!res.filas) { alertarUsuario("El catálogo está vacío.", "Verificación v2"); return; }

  const top = o => Object.keys(o).sort((a, b) => o[b] - o[a]).slice(0, 6)
    .map(k => "  " + k + ": " + o[k]).join("\n");
  const v1 = Object.keys(res.resumen.ecosistemasV1);

  alertarUsuario(
    `Filas revisadas: ${res.filas}\n` +
    `Anomalías encontradas: ${res.anomalias}\n\n` +
    "Por alcance:\n" + top(res.resumen.porAlcance) + "\n\n" +
    "Ecosistemas con más contenido:\n" + top(res.resumen.porEcosistema) + "\n\n" +
    (v1.length
      ? "⚠️ Quedan rutas que la semilla v2 no puede producir:\n  " + v1.slice(0, 10).join("\n  ") +
        "\n\nEsas filas necesitan una entrada nueva en el mapa de migración.\n\n"
      : "✅ Todas las rutas resultantes pertenecen a la taxonomía v2.\n\n") +
    `Sin clasificar: ${res.resumen.sinClasificar}   ·   Pendientes de revisión: ${res.resumen.pendientes}\n\n` +
    /* [v2.6.16] Separadas del recuento de anomalías: son filas sin video que
       leer, no filas que la taxonomía no supo clasificar. Se enseñan igual,
       porque son trabajo pendiente, pero de otra clase y con otra solución. */
    "Aparte, sin texto que clasificar:\n" +
    `  ❌ Con error ............... ${res.resumen.enError}\n` +
    `  ⚪ Descartadas ............. ${res.resumen.descartadas}\n` +
    `  📝 Requieren título manual . ${res.resumen.sinMetadatos}   → escribir el título\n` +
    `  🔗 Video no disponible ..... ${res.resumen.noDisponibles}   → cambiar el enlace o descartar\n\n` +
    "El detalle está en la hoja «_Verificacion_V2», ordenado por motivo.\n" +
    "Esta revisión NO modifica el catálogo; solo genera o actualiza esa hoja.",
    "Verificación de la migración v2");
  try { SpreadsheetApp.getActiveSpreadsheet().getSheetByName("_Verificacion_V2").activate(); } catch (e) { /* sin UI */ }
}

// =====================================================================================
// 5. PROMPTS DINÁMICOS, TAXONOMÍA, CACHÉS Y CONTROL DE CUOTAS
// =====================================================================================

/**
 * [F2-1] Contrato estricto para el banco certificable de un módulo.
 * Traslada al generador las reglas del "Prompt para Cuestionarios": 4 opciones,
 * sin comodines, trampas anti-IA tipificadas y diagnóstico completo por reactivo.
 */
const PROMPT_EVALUACION_MODULO =
`Actúas como Arquitecto Senior de Soluciones ERP y Auditor Forense de Capacitación.
Construye el BANCO MAESTRO DE PREGUNTAS del módulo "{modulo}" ({rol}).

FUENTES (respeta la cuota de preguntas de cada una):
{fuentes}

CONTENIDO DE ESTUDIO (fragmentos con su segundo de inicio cuando está disponible):
{texto}

REGLAS INQUEBRANTABLES
1. Genera exactamente {cantidad} reactivos de SELECCIÓN ÚNICA con 4 opciones cada uno.
2. Prohibido usar "Todas las anteriores" o "Ninguna de las anteriores".
3. Los 3 distractores deben ser errores operativos verosímiles, no absurdos.
4. Al menos el {porcentaje_trampas}% de los reactivos debe ser una trampa anti-IA marcada,
   repartida entre estos tipos:
   • teoria_vs_empirico → la teoría del manual dice una cosa, pero la respuesta correcta es
     lo que ocurrió en pantalla durante el video.
   • version_legacy → distractores válidos en versiones antiguas que cambiaron en la actual.
   • cebo_hipertecnico → opción con jerga rimbombante frente a la correcta, que es simple.
5. Cada reactivo cita el segundo exacto del contenido donde se evidencia (campo video_segundo,
   entero, en segundos). Si no puedes ubicarlo con certeza, usa 0: NO inventes un minuto.
6. Cada reactivo declara su fuente con el identificador exacto de la lista de fuentes.

Devuelve ÚNICAMENTE un JSON con esta forma, sin texto adicional:
{"preguntas":[{
 "pregunta":"...",
 "opciones":["A","B","C","D"],
 "correcta":0,
 "configuracion_correcta":"Enunciado prescriptivo de lo que se debe hacer en el sistema",
 "justificacion":"Por qué la correcta es correcta",
 "causa_raiz":"Qué desconocimiento operativo produce el error",
 "riesgo_operativo":"Consecuencia real en la operación si se equivoca",
 "severidad_riesgo":"CRITICO|MODERADO|BAJO",
 "caso_practico":"Ejemplo aplicado con su solución",
 "area":"Eje de competencia",
 "fuente":"Identificador de la fuente",
 "video_segundo":0,
 "es_trampa_ia":false,
 "indice_cebo_ia":-1,
 "tipo_trampa":""
}]}`;

/** [F1-7] Documento Maestro del Módulo: síntesis comparativa de sus fuentes. */
const PROMPT_DOCUMENTO_MAESTRO =
`Actúas como Arquitecto Senior de Soluciones ERP. Redacta el INFORME TÉCNICO COMPARATIVO
del módulo "{modulo}" a partir de las siguientes fuentes:

{fuentes}

CONTENIDO:
{texto}

ESTRUCTURA OBLIGATORIA (Markdown):
# INFORME TÉCNICO COMPARATIVO: {modulo}
## 1. Caracterización técnica de las fuentes analizadas
Describe cada método o enfoque con sus módulos base, tipos de dato y disparadores reales.
## 2. Matriz técnica comparativa
Tabla por dimensión técnica: módulos, precisión de costeo, control de operación,
comunicación entre áreas, disparador de descuento, flexibilidad y carga operativa.
## 3. Fortalezas y debilidades de cada enfoque
## 4. Criterios de selección: cuándo usar cada uno y por qué ninguno basta solo
## 5. Arquitectura híbrida recomendada
Topología integral paso a paso, del frente de operación al backend logístico y de compras.

Sé concreto y operativo. Nombra los módulos, campos y pantallas reales. Nada de generalidades.`;

/** [F1-6] Mensaje breve para WhatsApp o correo tras una evaluación. */
const PROMPT_MENSAJE_PEDAGOGICO =
`Redacta un mensaje breve, motivador y profesional para {estudiante}, que obtuvo {porcentaje}%
({nivel}) en el módulo "{modulo}".

Estructura obligatoria, en 6 líneas como máximo:
