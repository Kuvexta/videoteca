}

/**
 * Migración del catálogo de 25 a 27 columnas (histórica; la de 27 a 32, que
 * añade las facetas de la v2, la hace migrarCatalogoAV2()).
 *
 * Es idempotente: se puede ejecutar mil veces. Ensancha la hoja si hace falta,
 * reescribe la fila de cabeceras y mueve a «Fuente» las plataformas que la
 * ingesta antigua había escrito encima de «Ecosistema» — que es lo que dejaba
 * el catálogo entero clasificado como «YouTube».
 *
 * NO inventa clasificación: la fila cuyo ecosistema era una plataforma queda
 * marcada como «Sin clasificar», visible, para reclasificarla con las reglas.
 */
/**
 * Nombres que ha tenido cada columna a lo largo de las versiones. La migración
 * de orden reconoce la hoja POR SU CABECERA, así que necesita saber que
 * «Dominio / Ecosistema» y «Ecosistema» son la misma cosa.
 */
const ALIAS_CABECERAS = {
  URL: ["URL Video", "URL"],
  ID: ["ID Video", "ID"],
  TITULO: ["Título", "Titulo"],
  RESUMEN: ["Resumen Ejecutivo", "Resumen"],
  ECOSISTEMA: ["Ecosistema", "Dominio / Ecosistema", "Dominio / Plataforma", "Dominio"],
  AREA: ["Área", "Area", "Subcategoría", "Subcategoria"],
  TEMA: ["Tema"],
  VERSION: ["Versión", "Version"],
  DIFICULTAD: ["Dificultad"],
  JUSTIF_DIF: ["Justificación Dificultad", "Justificacion Dificultad"],
  MODULO: ["Módulo", "Modulo", "Modulo_Id"],
  FUENTE: ["Fuente", "Fuente / Plataforma", "Plataforma"],
  CANAL: ["Canal"],
  IDIOMA: ["Idioma"],
  FECHA_PUB: ["Fecha Publicación", "Fecha Publicacion"],
  DURACION: ["Duración (min)", "Duracion (min)", "Duración"],
  VISTAS: ["Vistas"],
  LIKES: ["Likes"],
  CATEGORIA_YT: ["Categoría YouTube", "Categoria YouTube"],
  ESTADO: ["Estado"],
  RECURSOS: ["Recursos / Enlaces", "Recursos"],
  FECHA_ESTUDIO: ["Fecha Estudio"],
  TAGS: ["Tags"],
  DRIVE_RAG: ["Resumen Ampliado IA (Drive ID)", "Drive ID", "Resumen Ampliado IA"],
  URL_FORM: ["URL Formulario"],
  ID_FORM: ["ID Formulario"],
  ERROR: ["Error"]
};

/**
 * Reordena una hoja existente al orden actual de IDX.
 *
 * Lee la CABECERA de la hoja para saber dónde está hoy cada campo y reconstruye
 * cada fila en el orden nuevo. Nunca supone que la hoja está en el orden viejo
 * concreto: si ya está bien, no toca nada; si le faltan columnas, las deja
 * vacías; y si tiene columnas que no reconoce, las conserva al final en vez de
 * tirarlas — perder una columna que alguien añadió a mano es inaceptable.
 */
function migrarOrdenColumnas() {
  exigirOrigenInterno("migrarOrdenColumnas");
  const hoja = obtenerHojaDatos();
  const ultimaFila = hoja.getLastRow();
  const anchoActual = Math.max(hoja.getLastColumn(), 1);
  if (ultimaFila < 1) return { movidas: 0, motivo: "hoja vacía" };

  // La hoja tiene que ser al menos tan ancha como lo que se va a leer.
  asegurarColumnas(hoja, anchoActual);
  const cabeceraVieja = hoja.getRange(1, 1, 1, anchoActual).getValues()[0]
    .map(c => (c || "").toString().trim());

  // ¿Dónde está hoy cada campo? Se busca por nombre, con los alias históricos.
  const origen = {};
  Object.keys(ALIAS_CABECERAS).forEach(campo => {
    const nombres = ALIAS_CABECERAS[campo].map(n => normalizarBusqueda(n));
    for (let c = 0; c < cabeceraVieja.length; c++) {
      if (nombres.indexOf(normalizarBusqueda(cabeceraVieja[c])) === -1) continue;
      if (origen[campo] === undefined) origen[campo] = c;
    }
  });

  const reconocidas = Object.keys(origen).length;
  if (reconocidas < 4) {
    // Una hoja sin cabeceras reconocibles no se toca: reordenar a ciegas 600
    // filas por posición sería destruir datos con una corazonada.
    logWarn("Migración", `Solo se reconocieron ${reconocidas} cabeceras; no se reordena.`);
    return { movidas: 0, motivo: "cabecera no reconocida", reconocidas: reconocidas };
  }

  /* ¿Ya está en el orden bueno? Si cada campo reconocido está en su índice y la
     hoja es al menos tan ancha como el esquema, no hay nada que mover: las
     columnas ajenas quedan por fuerza detrás de la 32, porque IDX ocupa de la 0
     a la 31 sin huecos. Comparar el ancho con la igualdad estricta haría que una
     hoja con una columna propia se reordenara en cada pasada, para nada. */
  const yaOrdenada = Object.keys(origen).every(campo => origen[campo] === IDX[campo]);
  if (yaOrdenada && anchoActual >= TOTAL_COLUMNAS && reconocidas === Object.keys(ALIAS_CABECERAS).length) {
    return { movidas: 0, motivo: "ya estaba en orden", reconocidas: reconocidas };
  }

  // Columnas que la hoja tiene y el esquema no conoce: se conservan al final.
  const usadas = {};
  Object.keys(origen).forEach(campo => { usadas[origen[campo]] = true; });
  const extras = [];
  for (let c = 0; c < cabeceraVieja.length; c++) {
    if (!usadas[c] && cabeceraVieja[c]) extras.push(c);
  }

  const filas = ultimaFila - 1;
  const anchoNuevo = TOTAL_COLUMNAS + extras.length;
  asegurarColumnas(hoja, anchoNuevo);

  if (filas > 0) {
    const datos = hoja.getRange(2, 1, filas, anchoActual).getValues();
    const reordenadas = datos.map(fila => {
      const nueva = new Array(anchoNuevo).fill("");
      Object.keys(origen).forEach(campo => { nueva[IDX[campo]] = fila[origen[campo]]; });
      extras.forEach((c, k) => { nueva[TOTAL_COLUMNAS + k] = fila[c]; });
      return nueva;
    });
    hoja.getRange(2, 1, filas, anchoNuevo).setValues(reordenadas);
  }

  const cabeceraNueva = CABECERAS_CATALOGO.concat(extras.map(c => cabeceraVieja[c]));
  hoja.getRange(1, 1, 1, anchoNuevo).setValues([cabeceraNueva])
    .setFontWeight("bold").setBackground("#1f2937").setFontColor("#ffffff")
    .setHorizontalAlignment("center");
  hoja.setFrozenRows(1);
  SpreadsheetApp.flush();

  invalidarCacheAPI();
  logInfo("Migración",
    `Catálogo reordenado: ${filas} filas, ${reconocidas} columnas reconocidas` +
    (extras.length ? `, ${extras.length} columnas ajenas conservadas al final` : "") + ".");
  return {
    movidas: filas, motivo: "reordenada",
    reconocidas: reconocidas, extras: extras.length
  };
}

function migrarEsquemaCatalogo() {
  exigirOrigenInterno("migrarEsquemaCatalogo");
  verificarCoherenciaEsquema();
  // El orden va primero: mover la plataforma de sitio exige que las columnas
  // Ecosistema y Fuente ya estén donde IDX dice que están.
  const orden = migrarOrdenColumnas();

  const hoja = obtenerHojaDatos();
  asegurarColumnas(hoja, TOTAL_COLUMNAS);
  if (orden.motivo !== "reordenada") {
    hoja.getRange(1, 1, 1, TOTAL_COLUMNAS).setValues([CABECERAS_CATALOGO])
      .setFontWeight("bold").setBackground("#1f2937").setFontColor("#ffffff")
      .setHorizontalAlignment("center");
  }
  hoja.setFrozenRows(1);

  /* En el modelo antiguo la fila quedaba corrida un nivel: la plataforma ocupaba
     «Ecosistema» y el ecosistema de verdad («Odoo ERP») estaba en «Subcategoría».
     Así que la migración no borra: DESPLAZA. La plataforma va a Fuente, la vieja
     subcategoría sube a Ecosistema —que es donde debía estar— y el Área queda
     pendiente de reclasificar, porque en el modelo viejo no existía. */
  let movidas = 0;
  iterarCatalogoPorBloques(function (datos) {
    let mutado = false;
    datos.forEach(r => {
      if (!r[IDX.URL]) return;
      const eco = (r[IDX.ECOSISTEMA] || "").toString().trim();
      if (!eco) return;
      const esPlataforma = FUENTES_CONOCIDAS.some(p => p.toLowerCase() === eco.toLowerCase());
      if (!esPlataforma) return;

      if (!r[IDX.FUENTE]) r[IDX.FUENTE] = eco;
      const subcatVieja = (r[IDX.AREA] || "").toString().trim();
      r[IDX.ECOSISTEMA] = subcatVieja && subcatVieja !== "General" ? subcatVieja : SIN_CLASIFICAR;
      r[IDX.AREA] = SIN_CLASIFICAR;
      movidas++;
      mutado = true;
    });
    return mutado;
  }, BATCH_TAMANO_BLOQUE, hoja);

  // La fuente que falte se deduce de la URL: es información que ya estaba ahí.
  let deducidas = 0;
  iterarCatalogoPorBloques(function (datos) {
    let mutado = false;
    datos.forEach(r => {
      if (!r[IDX.URL] || r[IDX.FUENTE]) return;
      r[IDX.FUENTE] = deducirFuenteDesdeUrl(r[IDX.URL]);
      deducidas++;
      mutado = true;
    });
    return mutado;
  }, BATCH_TAMANO_BLOQUE, hoja);

  invalidarCacheAPI();
  logInfo("Migración", `Esquema a ${TOTAL_COLUMNAS} columnas. ` +
    `${movidas} filas con la plataforma en Ecosistema corregidas, ${deducidas} fuentes deducidas.`);
  return { columnas: TOTAL_COLUMNAS, movidas: movidas, deducidas: deducidas, orden: orden };
}

/** Versión con diálogo, para el menú de la hoja. */
function migrarEsquemaCatalogoUI() {
  exigirOrigenInterno("migrarEsquemaCatalogoUI");
  const r = migrarEsquemaCatalogo();
  const o = r.orden || {};
  const lineas = [`Catálogo a ${r.columnas} columnas.`, ""];

  if (o.motivo === "reordenada") {
    lineas.push(`· ${o.movidas} filas reordenadas al esquema nuevo. Cada campo se movió`);
    lineas.push(`  siguiendo el NOMBRE de su columna, no la posición: ${o.reconocidas} reconocidas.`);
    if (o.extras) lineas.push(`  ${o.extras} columnas tuyas que el esquema no conoce se conservaron al final.`);
  } else if (o.motivo === "cabecera no reconocida") {
    lineas.push("· NO se reordenó: la fila 1 no tiene cabeceras reconocibles.");
    lineas.push("  Reordenar por posición a ciegas destruiría los datos, así que no se hizo.");
  } else {
    lineas.push("· El orden de las columnas ya era correcto.");
  }

  lineas.push("");
  if (r.movidas > 0) {
    lineas.push(`· ${r.movidas} filas tenían la plataforma escrita en «Ecosistema»: se movió`);
    lineas.push(`  a «Fuente» y quedaron como «${SIN_CLASIFICAR}».`);
  }
  if (r.deducidas > 0) lineas.push(`· ${r.deducidas} filas recibieron su fuente deducida de la URL.`);

  lineas.push("");
  lineas.push(r.movidas > 0 || o.motivo === "reordenada"
    ? "Ejecuta ahora «Reclasificar taxonomía» para asignar ecosistema, área y tema."
    : "No hizo falta corregir ninguna clasificación.");

  alertarUsuario(lineas.join("\n"), "Migración de esquema");
}

/**
 * De la URL se saca la plataforma sin llamar a ninguna API. Es lo que rellena
 * la columna Fuente en las filas antiguas y en las que se pegan a mano.
 */
function deducirFuenteDesdeUrl(url) {
  const u = (url || "").toString().toLowerCase();
  if (!u) return "";
  if (u.indexOf("youtu") !== -1) return "YouTube";
  if (u.indexOf("tiktok") !== -1) return "TikTok";
  if (u.indexOf("vimeo") !== -1) return "Vimeo";
  if (u.indexOf("drive.google") !== -1 || u.indexOf("docs.google") !== -1) return "Drive";
  if (u.indexOf("instagram") !== -1) return "Instagram";
  if (u.indexOf("facebook") !== -1 || u.indexOf("fb.watch") !== -1) return "Facebook";
  if (u.indexOf("twitch") !== -1) return "Twitch";
  if (u.indexOf("dropbox") !== -1) return "Dropbox";
  if (u.indexOf("1drv.ms") !== -1 || u.indexOf("onedrive") !== -1) return "OneDrive";
  if (u.indexOf("ted.com") !== -1) return "TED";
  if (u.indexOf("bilibili.com") !== -1 || u.indexOf("b23.tv") !== -1) return "Bilibili";
  if (u.indexOf("v.qq.com") !== -1) return "Tencent Video";
  return "Otro";
}

/**
 * Rango «B2:B» de una columna del catálogo, calculado desde su índice.
 * Escribir la letra a mano ata el código a un orden concreto: al mover una
 * columna, la validación de datos se queda aplicada sobre la columna de al lado
 * y nadie lo nota hasta que alguien no puede escribir en su propia hoja.
 */
function rangoColumna(indice, desdeFila = 2) {
  return letraColumna(indice + 1) + desdeFila + ":" + letraColumna(indice + 1);
}

/** Número de columna 1-based → letra de hoja de cálculo (1 → A, 27 → AA). */
function letraColumna(numero) {
  let n = Math.max(1, Math.floor(numero));
  let letra = "";
  while (n > 0) {
    const resto = (n - 1) % 26;
    letra = String.fromCharCode(65 + resto) + letra;
    n = Math.floor((n - 1) / 26);
  }
  return letra;
}


/**
 * Repara las filas donde un mensaje de error acabó dentro de la columna Estado
 * y un «❌ Error» dentro de la Fecha de Publicación.
 *
 * `gestionarErrorFila` escribía en las columnas 20 y 15 a mano. Eran las
 * correctas en el esquema anterior; después de la reordenación pasaron a ser
 * Estado y Fecha de Publicación. El resultado: cada vez que una API fallaba, la
 * fila quedaba con «Vimeo HTTP 401» en el Estado y la fecha machacada. Arreglar
 * la escritura no deshace lo ya escrito, y esto es lo que lo deshace.
 *
 * Solo toca lo que es reconociblemente daño de ese fallo: un Estado que no está
 * en la lista de estados válidos, y una fecha cuyo contenido es literalmente
 * «❌ Error». Un Estado escrito a mano por una persona no se toca.
 *
 * @return {{revisadas:number, estados:number, fechas:number}}
 */
function repararColumnasDeError() {
  exigirOrigenInterno("repararColumnasDeError");
  let revisadas = 0, estados = 0, fechas = 0;

  iterarCatalogoPorBloques(function (datos) {
    let mutado = false;
    for (let i = 0; i < datos.length; i++) {
      if (!(datos[i][IDX.URL] || "").toString().trim()) continue;
      revisadas++;

      const estado = (datos[i][IDX.ESTADO] || "").toString().trim();
      if (estado && ESTADOS_CATALOGO.indexOf(estado) === -1) {
        // El mensaje se conserva: es la única pista de por qué falló la fila.
        // Se antepone al error existente en vez de pisarlo.
        const errorPrevio = (datos[i][IDX.ERROR] || "").toString().trim();
        datos[i][IDX.ERROR] = errorPrevio && errorPrevio !== estado
          ? (estado + " · " + errorPrevio).slice(0, 255)
          : estado.slice(0, 255);
        datos[i][IDX.ESTADO] = "🟡 Pendiente";
        estados++;
        mutado = true;
      }

      const fecha = (datos[i][IDX.FECHA_PUB] || "").toString().trim();
      if (fecha === "❌ Error") {
        // No se puede recuperar la fecha real desde aquí: se vacía para que la
        // Fase 1 la vuelva a pedir. Dejar «❌ Error» ahí es peor que no tener
        // fecha, porque nada la reintenta.
        datos[i][IDX.FECHA_PUB] = "";
        fechas++;
        mutado = true;
      }
    }
    return mutado;
  });

  logInfo("Reparación",
    `${estados} estado(s) y ${fechas} fecha(s) reparados sobre ${revisadas} filas.`);
  return { revisadas: revisadas, estados: estados, fechas: fechas };
}

/** Entrada de menú de la reparación anterior. */
function repararColumnasDeErrorUI() {
  exigirOrigenInterno("repararColumnasDeErrorUI");
  marcarOrigenConfiable();
  const r = repararColumnasDeError();
  if (r.estados === 0 && r.fechas === 0) {
    alertarUsuario("Nada que reparar: ningún Estado ni ninguna fecha traen un mensaje de error.\n\n" +
      "Filas revisadas: " + r.revisadas + ".", "Reparación");
    return;
  }
  alertarUsuario(
    "Reparación terminada.\n\n" +
    "• Estados devueltos a «🟡 Pendiente»: " + r.estados + "\n" +
    "• Fechas de publicación liberadas: " + r.fechas + "\n" +
    "• Filas revisadas: " + r.revisadas + "\n\n" +
    "Los mensajes de error se conservaron en la columna «Error». " +
    "Vuelve a ejecutar la Fase 1 para recuperar las fechas.", "Reparación");
}

/**
 * Recorre el catálogo apartando lo que nunca fue un video.
 *
 * Para lo que ya está mal: listas, canales, colecciones y notas escritas en la
 * celda de la URL que llevan meses reintentándose y llenando la cola de fallos.
 * Solo mira filas sin ID o sin título —las que la ingesta seguiría intentando—
 * y no toca las que ya están descartadas. Idempotente.
 */
function apartarEnlacesNoVideo() {
  /* Escribe a través de `marcarEnlaceNoProcesable`, así que el efecto ya estaba
     bloqueado un nivel más abajo; la guarda va aquí para que falle ANTES de
     recorrer las 5.000 filas del catálogo. */
  exigirOrigenInterno("apartarEnlacesNoVideo");
  const hoja = obtenerHojaDatos();
  const ultima = hoja.getLastRow();
  if (ultima < 2) return { apartadas: 0, revisadas: 0, motivos: [] };

  const datos = hoja.getRange(2, 1, ultima - 1, TOTAL_COLUMNAS).getValues();
  const motivos = [];
  let apartadas = 0;

  for (let i = 0; i < datos.length; i++) {
    const url = (datos[i][IDX.URL] || "").toString().trim();
    if (!url) continue;
    const id = (datos[i][IDX.ID] || "").toString().trim();
    const tit = (datos[i][IDX.TITULO] || "").toString().trim();
    if (id && tit) continue;
    if ((datos[i][IDX.ESTADO] || "").toString().trim() === "⚪ Descartado") continue;
    if (parsearVideoUniversal(url)) continue;

    const motivo = clasificarEnlaceNoVideo(url);
    if (!motivo) continue;
    marcarEnlaceNoProcesable(i + 2, motivo);
    motivos.push(url.slice(0, 60) + " → " + motivo);
    apartadas++;
  }
  return { apartadas: apartadas, revisadas: datos.length, motivos: motivos };
}

