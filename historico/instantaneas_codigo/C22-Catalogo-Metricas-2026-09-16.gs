}

/** Vuelve a lanzar la ingesta desde donde quedó, y borra el aviso si arranca. */
function reanudarIngestaDetenidaUI() {
  exigirContextoHoja_("reanudarIngestaDetenidaUI");
  const props = PropertiesService.getScriptProperties();
  if (!props.getProperty("INGESTA_DETENIDA")) {
    alertarUsuario("La ingesta no está detenida.", "Ingesta");
    return;
  }
  if (!preguntarUsuario("▶️ Reanudar la ingesta",
      estadoIngestaDetenida_() + "\n\nSe retoma desde la última fila guardada. " +
      "Si la hoja sigue sin aceptar escrituras, volverá a pararse.\n\n¿Continuar?", true)) return;
  /* El contador se pone a cero a mano: es una decisión de la persona, no una
     escritura correcta, así que no se confunde con la limpieza automática. */
  props.deleteProperty("INGESTA_FALLOS_ESCRITURA");
  marcarOrigenConfiable();
  const r = procesarColaConAntiTimeout_(false);
  if (!r.falloPersistencia) props.deleteProperty("INGESTA_DETENIDA");
}

