      catalogo.push({
        id: r[IDX.ID], url: r[IDX.URL], titulo: r[IDX.TITULO], resumen: r[IDX.RESUMEN], plataforma: r[IDX.ECOSISTEMA],
        subcategoria: r[IDX.AREA], version: r[IDX.VERSION], idioma: r[IDX.IDIOMA], duracion: r[IDX.DURACION] || 0,
        estado: r[IDX.ESTADO], tags: r[IDX.TAGS] || "", driveRAG: r[IDX.DRIVE_RAG] || "",
        dificultad: r[IDX.DIFICULTAD] || "Principiante", urlExamen: r[IDX.URL_FORM] || "",
        moduloId: (r[IDX.MODULO] || "").toString().trim()
      });
    });
    return false;
  });

