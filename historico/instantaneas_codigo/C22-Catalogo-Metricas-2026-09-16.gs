/** Caché de idioma por ejecución: evita golpear ScriptProperties dentro de bucles. */
let _CACHE_IDIOMA = null;

/** Idioma forzado para el bloque en curso. Ver `conIdiomaDe()`. */
let _IDIOMA_FORZADO = null;

const IDIOMAS_SOPORTADOS = ["ES", "EN"];

function normalizarIdioma(valor) {
  const v = (valor || "").toString().trim().toUpperCase().slice(0, 2);
  return IDIOMAS_SOPORTADOS.indexOf(v) !== -1 ? v : "";
}

/** Clave donde vive la preferencia de idioma de una persona. */
function claveIdiomaDe(email) {
  return "LANG_" + Utilities.base64Encode((email || "").toString().toLowerCase()).slice(0, 40);
}

/**
 * Idioma en el que hay que escribir AHORA MISMO.
 *
 * Tres niveles, de más específico a más general:
 *   1. El que haya forzado `conIdiomaDe()` — un correo dirigido a alguien
 *      concreto se escribe en SU idioma, no en el de quien lanzó el proceso.
 *   2. La preferencia guardada de esa persona, si se pasa su correo.
 *   3. El idioma del script, que es el del menú de la hoja.
 */
function obtenerIdiomaUsuario(email) {
  if (_IDIOMA_FORZADO) return _IDIOMA_FORZADO;

  if (email) {
    try {
      const propio = normalizarIdioma(
        PropertiesService.getScriptProperties().getProperty(claveIdiomaDe(email)));
      if (propio) return propio;
    } catch (e) { /* se sigue al idioma del script */ }
  }

  if (_CACHE_IDIOMA) return _CACHE_IDIOMA;
  try {
    _CACHE_IDIOMA = normalizarIdioma(
      PropertiesService.getScriptProperties().getProperty("APP_LANG")) || "ES";
  } catch (e) {
    _CACHE_IDIOMA = "ES";
  }
  return _CACHE_IDIOMA;
}

/** Guarda el idioma preferido de una persona. Vacío = seguir al del script. */
function guardarIdiomaDe(email, idioma) {
  exigirOrigenInterno("guardarIdiomaDe");
  const correo = (email || "").toString().toLowerCase().trim();
  if (!correo) return false;
  const props = PropertiesService.getScriptProperties();
  const lang = normalizarIdioma(idioma);
  if (lang) props.setProperty(claveIdiomaDe(correo), lang);
  else props.deleteProperty(claveIdiomaDe(correo));
  return true;
}

/**
 * Ejecuta un bloque escribiendo en el idioma de una persona concreta.
 *
 * Es lo que hace utilizable el idioma por usuario en la práctica. Un disparador
 * que avisa a diez personas corre en UNA sola ejecución: sin esto, `t()` usaría
 * el mismo idioma para las diez —el del script— y la preferencia individual no
 * serviría de nada. El idioma anterior se restaura siempre, incluso si el bloque
 * lanza, porque dejarlo cambiado teñiría el resto de la ejecución.
 *
 * @example
 *   destinatarios.forEach(p => conIdiomaDe(p.email, () => enviarAviso(p)));
 */
function conIdiomaDe(email, fn) {
  const previo = _IDIOMA_FORZADO;
  try {
    _IDIOMA_FORZADO = obtenerIdiomaDe(email);
    return fn();
  } finally {
    _IDIOMA_FORZADO = previo;
  }
}

/** Idioma preferido de alguien, sin forzar nada. */
function obtenerIdiomaDe(email) {
  const correo = (email || "").toString().toLowerCase().trim();
  if (!correo) return obtenerIdiomaUsuario();
  try {
    const propio = normalizarIdioma(
      PropertiesService.getScriptProperties().getProperty(claveIdiomaDe(correo)));
    if (propio) return propio;
  } catch (e) { /* se cae al del script */ }
  return obtenerIdiomaUsuario();
}

/** Alias retrocompatible. */
function obtenerIdiomaActual() {
  return obtenerIdiomaUsuario();
}

/** Traductor universal con interpolación: t("err_cuota", {tipo:"GEMINI", usadas:5, limite:10}) */
function t(clave, variables = {}) {
  const dic = I18N[obtenerIdiomaUsuario()] || I18N.ES;
  let texto = dic[clave];
  if (texto === undefined) texto = I18N.ES[clave];
  if (texto === undefined) texto = clave;
  for (const campo in variables) {
    if (!Object.prototype.hasOwnProperty.call(variables, campo)) continue;
    texto = texto.split("{" + campo + "}").join(String(variables[campo]));
  }
  return texto;
}

function cambiarIdiomaInterfaz() {
  exigirOrigenInterno("cambiarIdiomaInterfaz");
  const nuevo = obtenerIdiomaUsuario() === "ES" ? "EN" : "ES";
  PropertiesService.getScriptProperties().setProperty("APP_LANG", nuevo);
  _CACHE_IDIOMA = nuevo;
  onOpen();
  notificarUsuario(nuevo === "ES" ? "Idioma: Español" : "Language: English", "i18n", 3);
}

/** Toast seguro: no rompe ejecuciones headless (triggers, webapp). */
function notificarUsuario(mensaje, titulo = "Videoteca", segundos = 4) {
  try {
    SpreadsheetApp.getActiveSpreadsheet().toast(mensaje, titulo, segundos);
  } catch (e) {
    registrarLogActividad("Toast", mensaje, "DEBUG");
  }
}

/** Alerta segura: degrada a log si no hay interfaz disponible. */
function alertarUsuario(mensaje, titulo = "Videoteca") {
  try {
    const ui = SpreadsheetApp.getUi();
    ui.alert(titulo, mensaje, ui.ButtonSet.OK);
  } catch (e) {
    registrarLogActividad("Alerta", titulo + " :: " + mensaje, "INFO");
  }
}

function hayInterfazDisponible() {
  try { SpreadsheetApp.getUi(); return true; } catch (e) { return false; }
}

// -------------------------------------------------------------------------------------
// 0.4 [SEC-1] Frontera de confianza frente a google.script.run
// -------------------------------------------------------------------------------------
/**
 * EL PROBLEMA QUE RESUELVE ESTO
 *
 * `google.script.run` expone TODAS las funciones globales del proyecto al navegador,
 * no solo las que la página usa. Con el portal publicado, cualquiera podría abrir la
 * consola y ejecutar:
 *
 *     google.script.run.leerClavesExamen({moduloId:"MOD_X"})   → las respuestas correctas
 *     google.script.run.obtenerMapaTokens_()                    → el token de administrador
 *     google.script.run.obtenerApiKey_("GEMINI")                → las claves de las IA
 *
 * Ninguna de esas funciones valida token: nunca fueron pensadas como superficie pública.
 *
 * CÓMO SE CIERRA
 *
 * Una llamada es de origen interno si se cumple una de dos condiciones:
 *   1. Hay interfaz de hoja de cálculo → viene del menú, de un diálogo o de la barra
 *      lateral. `SpreadsheetApp.getUi()` LANZA en el contexto de una aplicación web,
 *      así que esta comprobación por sí sola ya separa los dos mundos.
 *   2. Un punto de entrada legítimo del servidor marcó la ejecución como confiable:
 *      doGet, doPost, apiPortal y los manejadores de disparador.
 *
 * Una llamada directa desde `google.script.run` no cumple ninguna: no tiene interfaz y
 * nadie marcó la ejecución. Se rechaza.
 *
 * Esto es la segunda capa. La primera es que el portal solo invoca `apiPortal`, que
 * trabaja con una lista blanca explícita de acciones.
 */
let _ORIGEN_CONFIABLE = false;

/** La invocan doGet, doPost, apiPortal y cada manejador de disparador. */
function marcarOrigenConfiable() {
  _ORIGEN_CONFIABLE = true;
  return true;
}

/** Devuelve el marcador a su estado inicial. Solo lo usan las pruebas. */
function limpiarOrigenConfiable() {
  _ORIGEN_CONFIABLE = false;
}

function esOrigenInterno() {
  return _ORIGEN_CONFIABLE || hayInterfazDisponible();
}

/**
 * Guarda para funciones que jamás deben ser alcanzables desde el navegador.
 * Se coloca en la PRIMERA línea de la función protegida.
 */
function exigirOrigenInterno(nombreFuncion) {
  if (esOrigenInterno()) return true;
  logWarn("Seguridad", `Llamada directa bloqueada desde el cliente: ${nombreFuncion}()`);
  throw new Error(t("err_funcion_interna", { funcion: nombreFuncion }));
}

/**
 * [6.24] Contexto de hoja, que no es lo mismo que origen confiable.
 *
 * `marcarOrigenConfiable()` es una variable de ejecución: dice «esta ejecución
 * empezó por una puerta legítima». Los dos puentes de los paneles la ponían
 * ELLOS MISMOS, así que la puerta se abría sola: comprobaban que el nombre
 * estuviera en su lista —lo cual impide inventarse una acción, no impide
 * llamarlas— y acto seguido declaraban confiable la ejecución y ejecutaban.
 * Desde el portal, `google.script.run.lanzarAccionHerramienta("generarEnlacePublicoJSON")`
 * publicaba el catálogo en Drive para cualquiera con el enlace, y solo fallaba
 * DESPUÉS, al intentar enseñar el aviso que no tenía dónde pintarse.
 *
 * Esto pregunta otra cosa: ¿hay una hoja de cálculo delante? Una app web no la
 * tiene, y es la única frontera que Apps Script ofrece sin montar un login
 * propio. Va ANTES de marcar confianza y ANTES de ejecutar nada.
 *
 * Lo que asume: que quien puede editar el libro puede usar sus herramientas de
 * administración. Si algún día eso deja de ser cierto, esta comprobación no
 * basta y habrá que autorizar por persona.
 */
function exigirContextoHoja_(quien) {
  if (hayInterfazDisponible()) return true;
  logWarn("Seguridad", "Operación de hoja llamada sin hoja delante: " + (quien || "(sin nombre)"));
  throw new Error("Esta operación solo está disponible desde la hoja de cálculo.");
}

/** Pregunta sí/no degradando a un valor por defecto sin interfaz. */
function preguntarUsuario(titulo, mensaje, porDefecto = false) {
  if (!hayInterfazDisponible()) return porDefecto;
  const ui = SpreadsheetApp.getUi();
  return ui.alert(titulo, mensaje, ui.ButtonSet.YES_NO) === ui.Button.YES;
}

/** Pide un texto; devuelve "" si se cancela o no hay interfaz. */
function solicitarTexto(titulo, mensaje, porDefecto = "") {
  if (!hayInterfazDisponible()) return porDefecto;
  const ui = SpreadsheetApp.getUi();
  const resp = ui.prompt(titulo, mensaje, ui.ButtonSet.OK_CANCEL);
  return resp.getSelectedButton() === ui.Button.OK ? resp.getResponseText().trim() : "";
}

