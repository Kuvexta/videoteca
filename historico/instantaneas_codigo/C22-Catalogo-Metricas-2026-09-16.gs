const PROP_MENU_AVANZADO = "MENU_AVANZADO";

function menuAvanzadoActivo() {
  try {
    return PropertiesService.getScriptProperties().getProperty(PROP_MENU_AVANZADO) === "true";
  } catch (e) {
    return false;   // ante la duda, el menú corto
  }
}

/** Solo el estado. Separado del clic para poder comprobarlo sin abrir un libro. */
function establecerMenuAvanzado(activo) {
  exigirOrigenInterno("establecerMenuAvanzado");
  PropertiesService.getScriptProperties()
    .setProperty(PROP_MENU_AVANZADO, activo ? "true" : "false");
  logInfo("Menú", "Funciones avanzadas: " + (activo ? "visibles" : "ocultas"));
  return activo;
}

function alternarMenuAvanzado() {
  const nuevo = establecerMenuAvanzado(!menuAvanzadoActivo());
  /* Se redibuja en el acto: sin esto habría que cerrar y abrir el libro para
     ver el cambio, y nadie relacionaría una cosa con la otra. */
  try { onOpen(); } catch (e) { logWarn("Menú", "No se pudo redibujar: " + e.message); }
  notificarUsuario(
    nuevo ? t("menuAvanzadoAviso_on") : t("menuAvanzadoAviso_off"),
    t("menuTitle"), 5);
}

