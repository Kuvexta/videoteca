function abrirPanelConfiguracion() {
  exigirContextoHoja_("abrirPanelConfiguracion");
  marcarOrigenConfiable();
  const ui = SpreadsheetApp.getUi();
  /* El panel abre vacío y pide su contenido: así hay UN solo camino para
     obtener el estado —el mismo que usa el refresco— y ninguno que meta datos
     dentro del HTML. La cuenta de lo que falta se hace en el cliente. */

  /* [6.33] El panel se pinta en el cliente, no en el servidor.
     Salió de la validación en Apps Script: al reanudar la ingesta, el panel que
     ya estaba abierto seguía enseñando el aviso de parada —había que cerrarlo y
     abrirlo para ver el estado de verdad—. Con el HTML cocido en el servidor no
     había forma de refrescarlo; ahora las secciones viajan como datos y se
     vuelven a pedir cuando una acción termina. */
  const html = `
    <div class="wrap">
      <p class="cab" id="cab">Cargando el estado…</p>
      <div id="cuerpo"></div>
      <p class="pie">Cada botón abre el mismo asistente que antes estaba en el menú.
        Nada se ha eliminado.</p>
    </div>
    <style>
      body { margin:0; }
      .wrap { font-family: Arial, Helvetica, sans-serif; padding:14px 16px; color:#0f172a; }
      .cab { font-size:12px; background:#f1f5f9; border-left:3px solid #0f766e;
             padding:8px 10px; margin:0 0 14px 0; border-radius:0 4px 4px 0; }
      h4 { font-size:12px; text-transform:uppercase; letter-spacing:.04em;
           color:#0f766e; margin:18px 0 6px 0; }
      .f { display:flex; align-items:flex-start; gap:8px; padding:6px 0;
           border-bottom:1px solid #f1f5f9; }
      .m { width:16px; flex:none; font-size:12px; line-height:1.5; }
      .e { flex:1; font-size:12px; line-height:1.45; }
      .v { color:#475569; background:#f1f5f9; padding:1px 5px; border-radius:3px;
           font-size:11px; }
      .n { display:block; color:#64748b; font-size:11px; margin-top:2px; }
      button { flex:none; background:#fff; color:#0f766e; border:1px solid #0f766e;
               border-radius:4px; padding:3px 10px; font-size:11px; cursor:pointer; }
      button:hover { background:#0f766e; color:#fff; }
      button[disabled] { opacity:.5; cursor:default; }
      .pie { color:#64748b; font-size:11px; margin-top:18px; }
    </style>
    <script>
      /* [6.35] Los datos NO se interpolan en el HTML.
         Antes, las secciones se serializaban a JSON y se pegaban dentro de este
         mismo bloque de script. Ahi la funcion de escapado no llega: llega
         despues, al pintar. Un titular de token que contuviera un cierre de
         script cerraba el bloque, y lo que fuera detras entraba como marcado.
         No es que alguien pueda escribir ahi desde fuera —esos textos salen de
         la hoja y de las propiedades— pero el sitio donde se insertaban es
         inseguro, y eso se arregla no insertandolos: se piden al servidor como
         datos, por el mismo camino que usa el refresco. */
      var SECCIONES = [];

      function esc(t) {
        return String(t == null ? "" : t)
          .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
      }

      function filaHTML(f) {
        var marca, color;
        if (f.neutro) { marca = "·"; color = "#94a3b8"; }
        else if (f.ok) { marca = "✅"; color = "#0f766e"; }
        else if (f.opcional) { marca = "○"; color = "#94a3b8"; }
        else { marca = "❌"; color = "#b91c1c"; }
        /* La etiqueta del botón: la que declare la fila, y si no, la de siempre.
           «Configurar» en el aviso de ingesta detenida no decía lo que hacía. */
        var etiqueta = f.accion || (f.ok ? "Cambiar" : "Configurar");
        return '<div class="f">' +
          '<span class="m" style="color:' + color + '">' + marca + '</span>' +
          '<span class="e">' + esc(f.et) +
            (f.valor ? ' <span class="v">' + esc(f.valor) + '</span>' : "") +
            (f.nota ? '<span class="n">' + esc(f.nota) + '</span>' : "") +
          '</span>' +
          '<button data-fn="' + esc(f.fn) + '">' + esc(etiqueta) + '</button>' +
        '</div>';
      }

      function pintar(secciones) {
        SECCIONES = secciones;
        var pendientes = 0;
        secciones.forEach(function (s) {
          s.filas.forEach(function (f) { if (!f.neutro && !f.opcional && !f.ok) pendientes++; });
        });
        document.getElementById("cab").innerHTML = pendientes === 0
          ? "Todo lo necesario está configurado. Lo marcado con ○ es opcional."
          : "Falta configurar <b>" + pendientes + "</b> " + (pendientes === 1 ? "cosa" : "cosas") +
            " para que el sistema funcione solo. Lo marcado con ○ es opcional.";
        document.getElementById("cuerpo").innerHTML = secciones.map(function (s) {
          return "<h4>" + esc(s.titulo) + "</h4>" + s.filas.map(filaHTML).join("");
        }).join("");
        document.querySelectorAll("[data-fn]").forEach(function (b) {
          b.addEventListener("click", function () { lanzar(b, b.getAttribute("data-fn")); });
        });
      }

      function refrescar() {
        google.script.run
          .withSuccessHandler(pintar)
          .withFailureHandler(function () { /* si no se puede refrescar, se queda como está */ })
          .estadoConfiguracion();
      }

      function lanzar(boton, fn) {
        /* No se cierra la ventana desde aquí: la acción abre su propio diálogo,
           que sustituye a este. Cerrar antes cortaría la llamada a medias. */
        var textoPrevio = boton.textContent;
        boton.disabled = true;
        boton.textContent = "…";
        google.script.run
          .withSuccessHandler(function () {
            boton.textContent = textoPrevio;
            /* Se repinta con el estado de después: era lo que obligaba a cerrar
               y reabrir el panel para saber si algo había cambiado. */
            refrescar();
          })
          .withFailureHandler(function (e) {
            boton.disabled = false;
            boton.textContent = textoPrevio;
            alert(e.message);
          })
          .lanzarAccionConfig(fn);
      }

      function error(msg) {
        document.getElementById("cab").textContent =
          "No se pudo leer el estado: " + msg + " — cierra y vuelve a abrir el panel.";
      }

      google.script.run
        .withSuccessHandler(pintar)
        .withFailureHandler(function (e) { error(e && e.message ? e.message : "error desconocido"); })
        .estadoConfiguracion();
    </script>`;

  ui.showModalDialog(
    HtmlService.createHtmlOutput(html).setWidth(470).setHeight(560),
    t("panelConfig").replace("…", ""));
}

/** Puente cliente → servidor del panel. Solo nombres de la lista cerrada. */
function lanzarAccionConfig(nombre) {
  exigirContextoHoja_("lanzarAccionConfig");
  if (typeof nombre !== "string" || ACCIONES_PANEL_CONFIG.indexOf(nombre) === -1) {
    logWarn("Config", "Acción no permitida desde el panel: " + nombre);
    throw new Error("Esa acción no está disponible desde el panel.");
  }
  marcarOrigenConfiable();
  return this[nombre]();
}

