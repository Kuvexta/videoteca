/** Aserción formal: lanza un error descriptivo si la condición no se cumple. */
function assert(condicion, prueba, detalle = "condición falsa") {
  if (!condicion) throw new Error(t("test_fallo", { prueba: prueba, detalle: detalle }));
  return t("test_exito", { prueba: prueba });
}

function assertIgual(obtenido, esperado, prueba) {
  return assert(obtenido === esperado, prueba, `esperado "${esperado}", obtenido "${obtenido}"`);
}

/**
