// 14. DASHBOARD REACTIVO, BUSCADOR, ESTADÍSTICAS Y REPORTES — [MEJORA 12]
// =====================================================================================

/**
 * Separador de argumentos que acepta ESTA hoja.
 *
 * `setFormula` no traduce: interpreta la cadena en el idioma del documento. En
 * una hoja en español de Colombia la coma es el separador DECIMAL, y el de
 * argumentos es el punto y coma; escribir `COUNTIF(A:A,"x")` produce un
 * `#ERROR!` de análisis que ni siquiera IFERROR puede rescatar, porque falla
 * antes de evaluarse. Eso explica que en el panel se vieran bien justo las tres
 * fórmulas de un solo argumento —COUNTA— y ninguna de las demás.
 *
 * No se deduce de una lista de idiomas: se PRUEBA. Se escribe una fórmula
 * trivial en una celda de sobra y se mira si dio 2. Una lista de locales se
 * queda desactualizada sin que nadie se entere; esto no.
 */
function separadorDeFormulas(hoja) {
  exigirOrigenInterno("separadorDeFormulas");
  const props = PropertiesService.getScriptProperties();
  const guardado = props.getProperty("SEPARADOR_FORMULAS");
  if (guardado === "," || guardado === ";") return guardado;

  let separador = ",";
  let concluyo = false;
  try {
    const celda = hoja.getRange(hoja.getMaxRows(), hoja.getMaxColumns());
    const contenidoPrevio = celda.getFormula() || celda.getValue();
    celda.setFormula("=SUM(1,1)");
    SpreadsheetApp.flush();
    if (celda.getValue() !== 2) separador = ";";
    concluyo = true;
    // La celda se devuelve como estaba: la prueba no puede dejar rastro.
    if (contenidoPrevio === "" || contenidoPrevio === null) celda.clearContent();
    else celda.setValue(contenidoPrevio);
  } catch (e) {
    logWarn("Dashboard", "No se pudo detectar el separador de fórmulas: " + e.message);
  }
  // Solo se recuerda un resultado que de verdad se midió. Guardar la coma por
  // defecto tras una prueba fallida dejaría el panel roto para siempre sin que
  // ningún intento posterior volviera a mirarlo.
  if (concluyo) props.setProperty("SEPARADOR_FORMULAS", separador);
  logInfo("Dashboard", "Separador de fórmulas de esta hoja: «" + separador + "».");
  return separador;
}

/**
 * Convierte una plantilla de fórmula al idioma de la hoja.
 *
 * Dos símbolos, porque hay DOS separadores distintos y confundirlos rompe la
 * fórmula en silencio:
 *   §  separador de ARGUMENTOS   → «,» o «;» según el idioma de la hoja
 *   ¦  separador de COLUMNAS de un array literal `{a¦b}` → «,» o «\»
 * En una hoja con «;» de argumentos, `{a;b}` NO son dos columnas: son dos
 * FILAS, y un FILTER escrito así devuelve algo distinto de lo que se pidió sin
 * dar ningún error.
 *
 * Se usan símbolos propios en vez de reemplazar comas a ciegas porque dentro de
 * las fórmulas hay comas que NO son separadores —las de `"🟢 Estudiado /
 * Aplicado"` o las de la consulta de un QUERY— y cambiarlas rompería
 * exactamente lo que se intenta arreglar.
 */
function formulaLocal(plantilla, separador) {
  const columnaArray = separador === ";" ? "\\" : ",";
  return plantilla.split("§").join(separador).split("¦").join(columnaArray);
}

/**
 * [MEJORA 12] Dashboard en tiempo real: en lugar de volcar valores estáticos,
 * inserta fórmulas nativas (COUNTA/COUNTIF/QUERY/FILTER) que se recalculan solas
 * cada vez que cambian los datos del catálogo.
 *
 * Todas las referencias a columnas del catálogo se derivan de `IDX`. Estaban
 * escritas a mano —`O2:O` para Estado, `U2:U` para Dificultad— y la
 * reordenación del esquema las dejó apuntando a columnas distintas: el panel
 * seguía calculando, pero sobre los datos equivocados, que es peor que no
 * calcular.
 */
function crearDashboardTiempoReal() {
  exigirOrigenInterno("crearDashboardTiempoReal");
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const nombre = obtenerHojaDatos().getName();
  const dash = ss.getSheetByName("Dashboard") || ss.insertSheet("Dashboard", 0);
  dash.clear();
  dash.activate();

  const sep = separadorDeFormulas(dash);
  /* Cada letra sale de IDX, nunca escrita a mano. `col(IDX.ESTADO)` devuelve la
     columna donde HOY está el Estado; si mañana el esquema se reordena, estas
     fórmulas se mueven con él en vez de quedarse apuntando a otra cosa. */
  const col = function (indice) { return letraColumna(indice + 1); };
  const rango = function (indice) { return "'" + nombre + "'!" + col(indice) + "2:" + col(indice); };
  const poner = function (celda, plantilla) { dash.getRange(celda).setFormula(formulaLocal(plantilla, sep)); };

  dash.getRange("A1:H1").merge()
    .setValue("📊 PANEL DE CONTROL EJECUTIVO Y ACADÉMICO — TIEMPO REAL (" + VERSION_SCRIPT + ")")
    .setFontSize(14).setFontWeight("bold").setBackground("#111827").setFontColor("#ffffff")
    .setHorizontalAlignment("center");

  // ---- KPIs principales (fórmulas vivas) ----
  const kpis = [
    ["Total videos catalogados", `=COUNTA(${rango(IDX.ID)})`],
    ["Con documento RAG en Drive", `=COUNTA(${rango(IDX.DRIVE_RAG)})`],
    ["Con examen generado", `=COUNTA(${rango(IDX.ID_FORM)})`],
    ["Con error registrado", `=COUNTIF(${rango(IDX.ESTADO)}§"❌ Error")`],
    ["Duración total (horas)", `=IFERROR(ROUND(SUM(${rango(IDX.DURACION)})/60§1)§0)`],
    ["Vistas acumuladas", `=IFERROR(SUM(${rango(IDX.VISTAS)})§0)`],
    ["% de avance (estudiados)",
      `=IFERROR(ROUND(COUNTIF(${rango(IDX.ESTADO)}§"🟢 Estudiado / Aplicado")/COUNTA(${rango(IDX.ID)})*100§1)§0)`]
  ];
  dash.getRange("A3").setValue("KPIs Generales").setFontWeight("bold").setBackground("#e5e7eb");
  dash.getRange(4, 1, kpis.length, 2).setValues(kpis.map(k => [k[0], ""]));
  kpis.forEach((k, i) => dash.getRange(4 + i, 2).setFormula(formulaLocal(k[1], sep)));

  // ---- Distribución por estado ----
  dash.getRange("D3").setValue("Distribución por Estado").setFontWeight("bold").setBackground("#e5e7eb");
  ESTADOS_CATALOGO.forEach((estado, i) => {
    dash.getRange(4 + i, 4).setValue(estado);
    dash.getRange(4 + i, 5).setFormula(formulaLocal(`=COUNTIF(${rango(IDX.ESTADO)}§"${estado}")`, sep));
  });

  // ---- Distribución pedagógica ----
  dash.getRange("G3").setValue("Dificultad Pedagógica").setFontWeight("bold").setBackground("#e5e7eb");
  DIFICULTADES_ESTANDAR.forEach((niv, i) => {
    dash.getRange(4 + i, 7).setValue(niv);
    dash.getRange(4 + i, 8).setFormula(formulaLocal(`=COUNTIF(${rango(IDX.DIFICULTAD)}§"${niv}")`, sep));
  });

  /* ---- Ranking dinámico por vistas (QUERY) ----
     El rango del QUERY empieza en la primera columna que se necesita y termina
     en la última, y las letras de dentro son las de la HOJA, no las del rango.
     Se calculan igual que las demás, desde IDX. */
  dash.getRange("A13").setValue("🏆 Top 10 contenidos por vistas (dinámico)")
    .setFontWeight("bold").setBackground("#1e3a8a").setFontColor("#ffffff");
  poner("A14",
    `=IFERROR(QUERY('${nombre}'!${col(IDX.ID)}2:${col(IDX.VISTAS)}§ ` +
    `"SELECT ${col(IDX.ID)}, ${col(IDX.TITULO)}, ${col(IDX.ECOSISTEMA)}, ${col(IDX.DURACION)}, ${col(IDX.VISTAS)}, ${col(IDX.DIFICULTAD)} ` +
    `WHERE ${col(IDX.ID)} IS NOT NULL AND ${col(IDX.VISTAS)} > 0 ORDER BY ${col(IDX.VISTAS)} DESC LIMIT 10 ` +
    `LABEL ${col(IDX.ID)} 'ID', ${col(IDX.TITULO)} 'Título', ${col(IDX.ECOSISTEMA)} 'Ecosistema', ` +
    `${col(IDX.DURACION)} 'Duración', ${col(IDX.VISTAS)} 'Vistas', ${col(IDX.DIFICULTAD)} 'Dificultad'"§ 0)§ "Sin datos suficientes")`);

  // ---- Agrupación por ecosistema (QUERY) ----
  dash.getRange("A27").setValue("📚 Contenidos por ecosistema (dinámico)")
    .setFontWeight("bold").setBackground("#0f766e").setFontColor("#ffffff");
  poner("A28",
    `=IFERROR(QUERY(${rango(IDX.ECOSISTEMA)}§ ` +
    `"SELECT ${col(IDX.ECOSISTEMA)}, COUNT(${col(IDX.ECOSISTEMA)}) WHERE ${col(IDX.ECOSISTEMA)} IS NOT NULL ` +
    `GROUP BY ${col(IDX.ECOSISTEMA)} ORDER BY COUNT(${col(IDX.ECOSISTEMA)}) DESC ` +
    `LABEL ${col(IDX.ECOSISTEMA)} 'Ecosistema', COUNT(${col(IDX.ECOSISTEMA)}) 'Total'"§ 0)§ "Sin datos")`);

  // ---- Pendientes accionables (FILTER) ----
  dash.getRange("E27").setValue("⏳ Pendientes de procesar (dinámico)")
    .setFontWeight("bold").setBackground("#92400e").setFontColor("#ffffff");
  poner("E28",
    `=IFERROR(FILTER({${rango(IDX.TITULO)}¦ ${rango(IDX.ESTADO)}}§ ` +
    `(${rango(IDX.ESTADO)}="🟡 Pendiente")*(${rango(IDX.TITULO)}<>""))§ "Sin pendientes")`);

  // ---- [F1-1] Bloque de certificación por módulos ----
  asegurarHojaSistema("_Modulos");
  asegurarHojaSistema("_Intentos");

  dash.getRange("A42").setValue("🎓 CERTIFICACIÓN POR MÓDULOS (en vivo)")
    .setFontWeight("bold").setBackground("#4c1d95").setFontColor("#ffffff");

  /* Las hojas del LMS tienen sus propios índices —INT para _Intentos, CLAVE
     para _Claves_Examenes—, así que sus letras también se derivan de ahí. Hoy
     coinciden con las que estaban escritas a mano; el día que alguien añada una
     columna al principio de _Intentos, estas fórmulas se moverán solas. */
  const cI = function (indice) { return letraColumna(indice + 1); };
  const MOD_ESTADO = "N";                     // _Modulos: estado, 14ª columna

  const kpisModulo = [
    ["Módulos definidos", "=COUNTA(_Modulos!A2:A)"],
    ["Módulos publicados", `=COUNTIF(_Modulos!${MOD_ESTADO}2:${MOD_ESTADO}§"PUBLICADO")`],
    ["Videos con módulo asignado", `=COUNTA(${rango(IDX.MODULO)})`],
    ["Preguntas validadas en banco",
      `=COUNTIF(_Claves_Examenes!${cI(CLAVE.VALIDACION)}2:${cI(CLAVE.VALIDACION)}§"VALIDADA")`],
    ["Intentos entregados", `=COUNTIF(_Intentos!${cI(INT.ESTADO)}2:${cI(INT.ESTADO)}§"ENTREGADO")`],
    ["Intentos en curso", `=COUNTIF(_Intentos!${cI(INT.ESTADO)}2:${cI(INT.ESTADO)}§"EN_CURSO")`],
    ["Certificados emitidos (≥90%)",
      `=COUNTIFS(_Intentos!${cI(INT.ESTADO)}2:${cI(INT.ESTADO)}§"ENTREGADO"§` +
      `_Intentos!${cI(INT.PORCENTAJE)}2:${cI(INT.PORCENTAJE)}§">=90")`],
    ["Promedio general de intentos (%)",
      `=IFERROR(ROUND(AVERAGEIF(_Intentos!${cI(INT.ESTADO)}2:${cI(INT.ESTADO)}§"ENTREGADO"§` +
      `_Intentos!${cI(INT.PORCENTAJE)}2:${cI(INT.PORCENTAJE)})§1)§0)`],
    ["Intentos con riesgo forense alto", `=COUNTIF(_Intentos!${cI(INT.FORENSE)}2:${cI(INT.FORENSE)}§"ALTO")`]
  ];
  dash.getRange(43, 1, kpisModulo.length, 1).setValues(kpisModulo.map(k => [k[0]]));
  kpisModulo.forEach((k, i) => dash.getRange(43 + i, 2).setFormula(formulaLocal(k[1], sep)));

  dash.getRange("D42").setValue("Desempeño por módulo").setFontWeight("bold").setBackground("#e5e7eb");
  poner("D43",
    `=IFERROR(QUERY(_Intentos!A2:${cI(INT.PREGUNTAS)}§ ` +
    `"SELECT ${cI(INT.MODULO)}, COUNT(${cI(INT.ID)}), AVG(${cI(INT.PORCENTAJE)}) ` +
    `WHERE ${cI(INT.ESTADO)} = 'ENTREGADO' GROUP BY ${cI(INT.MODULO)} ORDER BY AVG(${cI(INT.PORCENTAJE)}) DESC ` +
    `LABEL ${cI(INT.MODULO)} 'Módulo', COUNT(${cI(INT.ID)}) 'Intentos', AVG(${cI(INT.PORCENTAJE)}) 'Promedio %'"§ 0)§ ` +
    `"Aún sin intentos entregados")`);

  dash.setColumnWidth(1, 260);
  dash.setColumnWidth(2, 130);
  dash.setColumnWidth(3, 40);
  dash.setColumnWidth(4, 200);
  logInfo("Dashboard", "Dashboard reactivo reconstruido con fórmulas QUERY/FILTER.");
  notificarUsuario("Dashboard dinámico creado: se actualiza solo.", "Dashboard", 4);
}

